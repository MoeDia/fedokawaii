#!/usr/bin/env bash
# busctl for the pictures: udisks' answer for the drives the lsblk stand-in lists — the USB
# stick and the external disk are not the system's own (HintSystem false), the NVMe disk is.
# Anything else goes to the real busctl.
if [[ $1 == --system && $2 == get-property && $3 == org.freedesktop.UDisks2 && $6 == HintSystem ]]; then
  case ${4##*/} in
    sda|sdb) echo "b false"; exit 0 ;;
    nvme0n1) echo "b true"; exit 0 ;;
  esac
fi
exec /usr/bin/busctl "$@"
