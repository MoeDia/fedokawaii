#!/usr/bin/env bash
# stub pw-dump (shoot.sh): the real pw-dump, and what its null devices standing in for the
# owner's ALSA cards lack — the cards themselves (PipeWire:Interface:Device) with the routes in
# use, the ports a real card reports (Line Out, Rear Microphone, HDMI / DisplayPort), and each
# node's device.id naming its card. Everything else passes through as the real one prints it.
self=$(cd "$(dirname "$0")" && pwd)
real=$(PATH=$(tr ':' '\n' <<<"$PATH" | grep -vxF "$self" | paste -sd:) command -v pw-dump) || exit 127
"$real" "$@" | jq '
  {"alsa_output.pci-0000_15_00.6.analog-stereo": 9001, "alsa_input.pci-0000_15_00.6.analog-stereo": 9001,
   "alsa_output.pci-0000_03_00.1.hdmi-stereo": 9002} as $card
  | map(if .type == "PipeWire:Interface:Node" and $card[.info.props["node.name"] // ""]
        then .info.props["device.id"] = $card[.info.props["node.name"]] else . end)
  + [{"id": 9001, "type": "PipeWire:Interface:Device", "version": 3,
      "info": {"props": {"device.description": "Ryzen HD Audio Controller", "device.api": "alsa", "media.class": "Audio/Device"},
               "params": {"Route": [
                 {"index": 4, "direction": "Output", "device": 4, "name": "analog-output-lineout", "description": "Line Out", "available": "yes"},
                 {"index": 1, "direction": "Input", "device": 3, "name": "analog-input-rear-mic", "description": "Rear Microphone", "available": "yes"}]}}},
     {"id": 9002, "type": "PipeWire:Interface:Device", "version": 3,
      "info": {"props": {"device.description": "Navi 48 HDMI/DP Audio Controller", "device.api": "alsa", "media.class": "Audio/Device"},
               "params": {"Route": [
                 {"index": 0, "direction": "Output", "device": 3, "name": "hdmi-output-0", "description": "HDMI / DisplayPort", "available": "yes"}]}}}]'
