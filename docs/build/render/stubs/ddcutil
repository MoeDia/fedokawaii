#!/usr/bin/env bash
# stub ddcutil (shoot.sh): one DDC/CI monitor on /dev/i2c-5; brightness (VCP 10) kept in
# $STUB_STATE/ddc-brightness (default 70, max 100)
f=${STUB_STATE:-/tmp}/ddc-brightness
cur=$(cat "$f" 2>/dev/null); [[ $cur =~ ^[0-9]+$ ]] || cur=70
args=" $* "
case $args in
  *" detect "*)
    cat <<'EOF'
Display 1
   I2C bus:  /dev/i2c-5
   DRM_connector:           card1-DP-1
   Monitor:                 DEL:DELL S2721DGF:4KVCR83
   VCP version:         2.1

EOF
  ;;
  *" getvcp 10 "*) echo "VCP 10 C $cur 100" ;;
  *" setvcp 10 "*)
    set -- $args; while [[ $1 != setvcp ]]; do shift; done
    v=$3; [[ $v =~ ^[0-9]+$ ]] && echo "$v" >"$f" ;;
  *) echo "ddcutil stub: $*" >&2; exit 1 ;;
esac
