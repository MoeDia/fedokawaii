diff --git a/notification.c b/notification.c
index b556c1d..e9c0823 100644
--- a/notification.c
+++ b/notification.c
@@ -278,6 +278,31 @@ char *format_notif_text(char variable, bool *markup, void *data) {
 	case 'i':
 		return mako_asprintf("%d", notif->id);
 	case 's':
+		// fedokawaii: a summary that opens with one of the desktop's pixel icons (Sumi Icons,
+		// U+FE000–U+FEFFF: F3 BE xx xx in UTF-8) — the icon in its own ink, its words 8 px on
+		// (the grid's gap: of the two spaces the desktop's notices put after it, one), the
+		// rest as ever
+		if (notif->style.spec.colors.summary_icon) {
+			const unsigned char *u = (const unsigned char *)notif->summary;
+			if (u[0] == 0xf3 && u[1] == 0xbe && (u[2] & 0xc0) == 0x80 && (u[3] & 0xc0) == 0x80) {
+				const char *after = notif->summary + 4;
+				if (after[0] == ' ' && after[1] == ' ') {
+					after++;
+				}
+				char *rest = malloc(escape_markup(after, NULL) + 1);
+				char *out = NULL;
+				if (rest != NULL) {
+					escape_markup(after, rest);
+					out = mako_asprintf("<span foreground=\"#%06x\">%.4s</span>%s",
+						(unsigned)(notif->style.colors.summary_icon >> 8), notif->summary, rest);
+					free(rest);
+				}
+				if (out != NULL) {
+					*markup = true;
+					return out;
+				}
+			}
+		}
 		return strdup(notif->summary);
 	case 'b':
 		*markup = notif->style.markup;
diff --git a/render.c b/render.c
index 8fed6d8..9b4926e 100644
--- a/render.c
+++ b/render.c
@@ -161,6 +161,34 @@ static int render_notification(cairo_t *cairo, struct mako_state *state, struct
 	pango_layout_set_font_description(layout, desc);
 	pango_font_description_free(desc);
 
+	// fedokawaii: a hanging indent — the first line (the title, its icon) at the edge, every
+	// other line under its words: the summary and the body made one paragraph (their line
+	// breaks Unicode's LINE SEPARATOR, which Pango breaks at without a new paragraph), the
+	// indent negative; and never "…": whole lines, what does not fit cut at a line's end
+	char *joined = NULL;
+	bool hang = style->spec.hanging_indent && style->hanging_indent > 0;
+	if (hang) {
+		size_t n = 0;
+		for (const char *c = text; *c; c++) {
+			n += *c == '\n' ? 3 : 1;
+		}
+		joined = malloc(n + 1);
+		if (joined != NULL) {
+			char *o = joined;
+			for (const char *c = text; *c; c++) {
+				if (*c == '\n') {
+					*o++ = (char)0xe2; *o++ = (char)0x80; *o++ = (char)0xa8;
+				} else {
+					*o++ = *c;
+				}
+			}
+			*o = '\0';
+			text = joined;
+		}
+		pango_layout_set_indent(layout, -style->hanging_indent * scale * PANGO_SCALE);
+		pango_layout_set_ellipsize(layout, PANGO_ELLIPSIZE_NONE);
+	}
+
 	PangoAttrList *attrs = NULL;
 	GError *error = NULL;
 	char *buf = NULL;
@@ -271,6 +299,31 @@ static int render_notification(cairo_t *cairo, struct mako_state *state, struct
 
 	cairo_path_destroy(border_path);
 
+	// fedokawaii (docs/design-system.md §4): with a shadow set, the frame of everything that
+	// floats — its four corner pixels left out, and the shadow, light from the top left, two
+	// rows under it (the first from a pixel in to under the right hairline, the second a pixel
+	// further right) and a column at its right from its second row down: drawn into the
+	// margin beside it (render() keeps two rows under the last one)
+	if (style->spec.colors.shadow) {
+		double x = offset_x, y = offset_y, w = notif_width, h = notif_height, b = style->border_size;
+		cairo_save(cairo);
+		cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+		cairo_set_source_rgba(cairo, 0, 0, 0, 0);
+		cairo_rectangle(cairo, x * scale, y * scale, b * scale, b * scale);
+		cairo_rectangle(cairo, (x + w - b) * scale, y * scale, b * scale, b * scale);
+		cairo_rectangle(cairo, x * scale, (y + h - b) * scale, b * scale, b * scale);
+		cairo_rectangle(cairo, (x + w - b) * scale, (y + h - b) * scale, b * scale, b * scale);
+		cairo_fill(cairo);
+		set_source_u32(cairo, style->colors.shadow[0]);
+		cairo_rectangle(cairo, (x + 1) * scale, (y + h) * scale, (w - 1) * scale, scale);
+		cairo_fill(cairo);
+		set_source_u32(cairo, style->colors.shadow[1]);
+		cairo_rectangle(cairo, (x + 2) * scale, (y + h + 1) * scale, (w - 1) * scale, scale);
+		cairo_rectangle(cairo, (x + w) * scale, (y + 2) * scale, scale, (h - 2) * scale);
+		cairo_fill(cairo);
+		cairo_restore(cairo);
+	}
+
 	if (icon != NULL) {
 		// Render icon
 		double xpos = -1;
@@ -316,6 +369,13 @@ static int render_notification(cairo_t *cairo, struct mako_state *state, struct
 	}
 
 	// Render text
+	cairo_save(cairo);
+	if (hang) {   // (fedokawaii: the lines that do not fit cut off at the text's box, whole)
+		cairo_rectangle(cairo, (offset_x + style->border_size + text_x) * scale,
+			(offset_y + style->border_size + text_y) * scale,
+			text_layout_width * scale, text_height * scale);
+		cairo_clip(cairo);
+	}
 	set_source_u32(cairo, style->colors.text);
 	move_to(cairo,
 		offset_x + style->border_size + text_x,
@@ -323,6 +383,8 @@ static int render_notification(cairo_t *cairo, struct mako_state *state, struct
 		scale);
 	pango_cairo_update_layout(cairo, layout);
 	pango_cairo_show_layout(cairo, layout);
+	cairo_restore(cairo);
+	free(joined);
 
 	// Update hotspot with calculated location
 	if (hotspot != NULL) {
@@ -480,5 +542,6 @@ void render(struct mako_surface *surface, struct pool_buffer *buffer, int scale,
 	}
 
 	*rendered_width = max_width;
-	*rendered_height = total_height;
+	// fedokawaii: the last notice's shadow, two rows under it, inside the surface
