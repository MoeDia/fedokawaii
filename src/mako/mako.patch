+		target->colors.shadow[1] = style->colors.shadow[1];
+		target->spec.colors.shadow = true;
+	}
+
 	if (style->spec.colors.border) {
 		target->colors.border = style->colors.border;
 		target->spec.colors.border = true;
@@ -583,8 +599,27 @@ static bool apply_style_option(struct mako_style *style, const char *name,
 		return spec->padding;
 	} else if (strcmp(name, "border-size") == 0) {
 		return spec->border_size = parse_int_ge(value, &style->border_size, 0);
+	} else if (strcmp(name, "hanging-indent") == 0) {
+		return spec->hanging_indent = parse_int_ge(value, &style->hanging_indent, 0);
 	} else if (strcmp(name, "border-color") == 0) {
 		return spec->colors.border = parse_color(value, &style->colors.border);
+	} else if (strcmp(name, "summary-icon-color") == 0) {
+		return spec->colors.summary_icon = parse_color(value, &style->colors.summary_icon);
+	} else if (strcmp(name, "shadow-color") == 0) {
+		// fedokawaii: "#RRGGBBAA #RRGGBBAA", the shadow's first row and its second row and
+		// column; set, the frame's four corner pixels are left out too
+		char *copy = strdup(value), *second = copy ? strchr(copy, ' ') : NULL;
+		bool ok = false;
+		if (second) {
+			*second++ = '\0';
+			while (*second == ' ') {
+				second++;
+			}
+			ok = parse_color(copy, &style->colors.shadow[0]) &&
+				parse_color(second, &style->colors.shadow[1]);
+		}
+		free(copy);
+		return spec->colors.shadow = ok;
 	} else if (strcmp(name, "progress-color") == 0) {
 		return spec->colors.progress = parse_mako_color(value, &style->colors.progress);
 	} else if (strcmp(name, "icons") == 0) {
@@ -906,6 +941,9 @@ int parse_config_arguments(struct mako_config *config, int argc, char **argv) {
