@@ -278,6 +278,31 @@ char *format_notif_text(char variable, bool *markup, void *data) {
 	case 'i':
 		return mako_asprintf("%d", notif->id);
 	case 's':
+		// fedokawaii: a summary that opens with one of the desktop's pixel icons (Sumi Icons,
+		// U+FE000–U+FEFFF: F3 BE xx xx in UTF-8) — the icon in its own ink, its words 8 px on
+		// (the grid's gap: of the two spaces the desktop's notices put after it, one), the
+		// rest as ever
+		if (notif->style.spec.colors.summary_icon) {
+			const unsigned char *u = (const unsigned char *)notif->summary;
+			if (u[0] == 0xf3 && u[1] == 0xbe && (u[2] & 0xc0) == 0x80 && (u[3] & 0xc0) == 0x80) {
+				const char *after = notif->summary + 4;
+				if (after[0] == ' ' && after[1] == ' ') {
+					after++;
+				}
+				char *rest = malloc(escape_markup(after, NULL) + 1);
+				char *out = NULL;
+				if (rest != NULL) {
+					escape_markup(after, rest);
+					out = mako_asprintf("<span foreground=\"#%06x\">%.4s</span>%s",
+						(unsigned)(notif->style.colors.summary_icon >> 8), notif->summary, rest);
+					free(rest);
+				}
+				if (out != NULL) {
+					*markup = true;
+					return out;
+				}
+			}
+		}
 		return strdup(notif->summary);
 	case 'b':
 		*markup = notif->style.markup;
