 from syncplay.vendor.python_mpv_jsonipc.python_mpv_jsonipc import MPV
 
+_CRASH_SEEN = threading.Lock()                # (fedokawaii) _sayCrash's once-only guard
+
 class MpvPlayer(BasePlayer):
     RE_VERSION = re.compile(r'.*mpv v?(\d+)\.(\d+)\.\d+.*')
     osdMessageSeparator = "\\n"
@@ -643,6 +646,33 @@ class MpvPlayer(BasePlayer):
             #self.mpvpipe.show_text("HELLO WORLD!", 1000)
             threading.Thread.__init__(self, name="MPV Listener")
 
+        def _sayCrash(self):
+            # (fedokawaii) mpv ended by a crash — a fault, an abort, the out-of-memory killer —,
+            # not closed: a notice says so, in kawa-together's words ($KAWA_TOGETHER_CRASH, the
+            # title); a close, a quit or a signal to end it says nothing
+            title = os.environ.get("KAWA_TOGETHER_CRASH")
+            proc = getattr(getattr(self.mpvpipe, "mpv_process", None), "process", None)
+            with _CRASH_SEEN:                  # (once: the socket's thread and the reactor's both stop it)
+                if not title or proc is None or getattr(self, "_crashSeen", False):
+                    return
+                self._crashSeen = True
+            try:                               # (mpv's end awaited only off the reactor's thread)
+                rc = proc.wait(timeout=1) if threading.current_thread() is not threading.main_thread() else proc.poll()
+            except subprocess.TimeoutExpired:
+                return
+            if rc is None:
+                return
+            if rc in (0, 4) or -rc in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
+                return
+            why = signal.strsignal(-rc).lower() if rc < 0 else "an error, exit {}".format(rc)
+            try:
+                subprocess.Popen(["notify-send", "-a", "together", "--", title,
+                                  "mpv crashed ({}): you left the room".format(why)],
+                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+                                 start_new_session=True)
+            except OSError:
+                pass
+
         def _get_ipc_socket(self):
             if isWindows():
                 # On Windows, mpv expects a named pipe identifier (not a path)
@@ -752,6 +782,7 @@ class MpvPlayer(BasePlayer):
 
         def stop_client(self):
             self.readyToSend = False
+            self._sayCrash()
             try:
                 self.mpvpipe.terminate()
             except: #When mpv is already closed
