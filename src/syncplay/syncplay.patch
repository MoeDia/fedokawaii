diff --git a/syncplay/ep_client.py b/syncplay/ep_client.py
index f93793b..9bae36b 100644
--- a/syncplay/ep_client.py
+++ b/syncplay/ep_client.py
@@ -1,11 +1,33 @@
+import os
+import shutil
+import signal
 import sys
 
 from syncplay.clientManager import SyncplayClientManager
-from syncplay.utils import blackholeStdoutForFrozenWindow
+from syncplay.utils import blackholeStdoutForFrozenWindow, getRuntimeDir
+
+def _hangup(signum, frame):
+    # (fedokawaii) the window closed (its terminal hung up): the same stop as a quit, and silent —
+    # there is nothing left to print to
+    devnull = os.open(os.devnull, os.O_WRONLY)
+    os.dup2(devnull, 1)
+    os.dup2(devnull, 2)
+    from twisted.internet import reactor
+    reactor.callFromThread(reactor.stop)
 
 def main():
     blackholeStdoutForFrozenWindow()
+    signal.signal(signal.SIGHUP, _hangup)
     SyncplayClientManager().run()
+    # (fedokawaii) the client has stopped (mpv closed, a quit, Ctrl+C, the window closed): end the
+    # process now, and the terminal window with it — the console's thread, waiting in input() for a
+    # line, would hold Python's own exit until one is typed. The runtime folder Syncplay made first
+    # (its atexit cleanup does not run past os._exit)
+    sys.stdout.flush()
+    made = getattr(getRuntimeDir, "cachedPath", None)
+    if made:
+        shutil.rmtree(made, ignore_errors=True)
+    os._exit(0)
 
 if __name__ == "__main__":
     main()
