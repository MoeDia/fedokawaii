+/* spiral: the golden spiral, kept to sizes a window is useful at (spiralplace()). Should
+ * it not fit n windows at the smallest size, the even grid that comes nearest */
+void
+spiral(Monitor *m)
+{
+	struct wlr_box a, *b, *g;
+	int n = tiled(m, &a);
+	if (n == 0 || !(b = calloc((size_t)n, sizeof(*b))))
+		return;
