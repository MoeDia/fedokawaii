+struct wlr_tablet_v2_tablet_tool *
+pentool(struct wlr_tablet_tool *tool)
+{
+	/* the pen as windows see it: made the first time it comes near */
+	struct wlr_tablet_v2_tablet_tool *t = tool->data;
+	if (!t) {
+		tool->data = t = wlr_tablet_tool_create(tablet_mgr, seat, tool);
+		LISTEN_STATIC(&t->events.set_cursor, pencursor);
+		LISTEN_STATIC(&tool->events.destroy, pengone);
+	}
+	return t;
+}
+
+void
+pengone(struct wl_listener *listener, void *data)
+{
+	/* the tablet unplugged: its pen is gone */
+	struct wlr_tablet_tool *tool = data;
+	if (pen.tool == tool->data)
+		memset(&pen, 0, sizeof(pen));
+	wl_list_remove(&listener->link);
+	free(listener);
+}
+
+void
+penmove(struct wlr_tablet *tablet, struct wlr_tablet_tool *tool, uint32_t time,
+		bool hasx, bool hasy, double x, double y)
+{
+	struct wlr_tablet_v2_tablet_tool *t = pentool(tool);
+	struct wlr_tablet_v2_tablet *tab = tablet->data;
+	struct wlr_surface *surface = NULL;
+	Client *c = NULL;
+	LayerSurface *l = NULL;
+	struct wlr_box box;
+	double dx, dy, sx, sy, wide;
+
+	pen.tool = t;
+	/* the pad keeps the screen's proportions (a circle drawn is a circle on screen):
+	 * its area is cut to the screen's shape from its top-left corner, and the part
+	 * past that reaches the screen's edge */
+	wlr_output_layout_get_box(output_layout, NULL, &box);
+	if (tablet->width_mm > 0 && tablet->height_mm > 0 && box.width > 0 && box.height > 0) {
+		wide = (tablet->width_mm / tablet->height_mm) / ((double)box.width / box.height);
+		if (wide > 1)
+			x = MIN(x * wide, 1);
+		else
+			y = MIN(y / wide, 1);
+	}
+	dx = hasx ? box.x + x * box.width - cursor->x : 0;
+	dy = hasy ? box.y + y * box.height - cursor->y : 0;
+
+	if (cursor_mode == CurPressed && pen.surface) {
+		/* the tip or a button held down in a window that reads pens: the stroke
+		 * stays with that window, past its edge */
+		wlr_cursor_move(cursor, &tablet->base, dx, dy);
+		wlr_idle_notifier_v1_notify_activity(idle_notifier, seat);
+		wlr_tablet_v2_tablet_tool_notify_motion(t, cursor->x - pen.ox, cursor->y - pen.oy);
+		return;
+	}
+	if (cursor_mode == CurNormal) {
+		xytonode(cursor->x + dx, cursor->y + dy, &surface, &c, &l, &sx, &sy);
+		if (surface && (!tab || !wlr_surface_accepts_tablet_v2(surface, tab)))
+			surface = NULL;
+	}
+	if (surface != pen.surface && pen.surface)
+		wlr_tablet_v2_tablet_tool_notify_proximity_out(t);
+	if (!surface) {
+		/* anything else — the bar, the wallpaper, a window that does not read pens, a
+		 * window carried with Super: the pen is the mouse */
+		pen.surface = NULL;
+		motionnotify(time, &tablet->base, dx, dy, dx, dy);
+		wlr_seat_pointer_notify_frame(seat);
+		return;
+	}
+	/* a window that reads pens: the pen alone (the mouse is not there) */
+	wlr_cursor_move(cursor, &tablet->base, dx, dy);
+	wlr_idle_notifier_v1_notify_activity(idle_notifier, seat);
+	if (sloppyfocus)
+		selmon = xytomon(cursor->x, cursor->y);
+	if (surface != pen.surface) {
+		focusfollow(c, l);
+		wlr_seat_pointer_notify_clear_focus(seat);
+		wlr_tablet_v2_tablet_tool_notify_proximity_in(t, tab, surface);
+		pen.surface = surface;
+	}
+	pen.ox = cursor->x - sx;
+	pen.oy = cursor->y - sy;
+	wlr_tablet_v2_tablet_tool_notify_motion(t, sx, sy);
+}
+
+void
+pencursor(struct wl_listener *listener, void *data)
+{
+	/* the cursor a window shows for the pen over it (only the window the pen is over) */
+	struct wlr_tablet_v2_event_cursor *event = data;
+	if (!pen.tool || !pen.tool->focused_surface || !event->seat_client
+			|| event->seat_client->client != wl_resource_get_client(pen.tool->focused_surface->resource))
+		return;
+	wlr_cursor_set_surface(cursor, event->surface, event->hotspot_x, event->hotspot_y);
+}
+
+void
+penpress(uint32_t button, enum wl_pointer_button_state state)
+{
+	/* the pen's tip and its side buttons, to a window that reads the pen: the tip as
+	 * the tip (its pressure goes with the motion), the buttons as the pen's own */
+	int down = state == WL_POINTER_BUTTON_STATE_PRESSED;
+	switch (button) {
+	case BTN_LEFT:
+		if (down)
+			wlr_tablet_v2_tablet_tool_notify_down(pen.tool);
+		else
+			wlr_tablet_v2_tablet_tool_notify_up(pen.tool);
+		break;
+	default:
+		wlr_tablet_v2_tablet_tool_notify_button(pen.tool,
+				button == BTN_RIGHT ? BTN_STYLUS : BTN_STYLUS2,
+				down ? ZWP_TABLET_PAD_V2_BUTTON_STATE_PRESSED
+					: ZWP_TABLET_PAD_V2_BUTTON_STATE_RELEASED);
+		break;
+	}
+	/* held down, the pen stays with that window until it is let go */
+	wlr_tablet_tool_v2_start_implicit_grab(pen.tool);
+}
+
+void
+tabletaxis(struct wl_listener *listener, void *data)
+{
+	struct wlr_tablet_tool_axis_event *event = data;
+	struct wlr_tablet_v2_tablet_tool *t = pentool(event->tool);
+	uint32_t a = event->updated_axes;
+
+	penmove(event->tablet, event->tool, event->time_msec,
+			a & WLR_TABLET_TOOL_AXIS_X, a & WLR_TABLET_TOOL_AXIS_Y, event->x, event->y);
+	if (!pen.surface)
+		return;
+	if (a & WLR_TABLET_TOOL_AXIS_PRESSURE)
+		wlr_tablet_v2_tablet_tool_notify_pressure(t, event->pressure);
+	if (a & WLR_TABLET_TOOL_AXIS_DISTANCE)
+		wlr_tablet_v2_tablet_tool_notify_distance(t, event->distance);
+	if (a & (WLR_TABLET_TOOL_AXIS_TILT_X | WLR_TABLET_TOOL_AXIS_TILT_Y))
+		wlr_tablet_v2_tablet_tool_notify_tilt(t, event->tilt_x, event->tilt_y);
+	if (a & WLR_TABLET_TOOL_AXIS_ROTATION)
+		wlr_tablet_v2_tablet_tool_notify_rotation(t, event->rotation);
+	if (a & WLR_TABLET_TOOL_AXIS_SLIDER)
+		wlr_tablet_v2_tablet_tool_notify_slider(t, event->slider);
+	if (a & WLR_TABLET_TOOL_AXIS_WHEEL)
+		wlr_tablet_v2_tablet_tool_notify_wheel(t, event->wheel_delta, 0);
+}
+
+void
+tabletbutton(struct wl_listener *listener, void *data)
+{
+	/* the pen's side buttons: over a window that reads pens, the pen's own; over
+	 * anything else the mouse's right and middle buttons (so Super+the lower one
+	 * resizes a window, as Super+right-click does) */
+	struct wlr_tablet_tool_button_event *event = data;
+	struct wlr_pointer_button_event ev = {
+		.time_msec = event->time_msec,
+		.button = event->button == BTN_STYLUS ? BTN_RIGHT : BTN_MIDDLE,
+		.state = event->state == WLR_BUTTON_PRESSED
+			? WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED,
+	};
+	pen.tool = pentool(event->tool);
+	buttonpress(NULL, &ev);
+	wlr_seat_pointer_notify_frame(seat);
+}
+
+void
+tabletproximity(struct wl_listener *listener, void *data)
+{
+	struct wlr_tablet_tool_proximity_event *event = data;
+	if (event->state == WLR_TABLET_TOOL_PROXIMITY_IN) {
+		penmove(event->tablet, event->tool, event->time_msec, true, true, event->x, event->y);
+		return;
+	}
+	/* the pen lifted away from the pad */
+	if (pen.surface)
+		wlr_tablet_v2_tablet_tool_notify_proximity_out(pentool(event->tool));
+	pen.surface = NULL;
+}
+
+void
+tablettip(struct wl_listener *listener, void *data)
+{
+	/* the tip on the pad: a left click to the desktop (a window focused, Super+tip
+	 * moves it, a menu closes), then the tip to the window — the pen's own down to a
+	 * window that reads pens, a left button to anything else */
+	struct wlr_tablet_tool_tip_event *event = data;
+	struct wlr_pointer_button_event ev = {
+		.time_msec = event->time_msec,
+		.button = BTN_LEFT,
+		.state = event->state == WLR_TABLET_TOOL_TIP_DOWN
+			? WL_POINTER_BUTTON_STATE_PRESSED : WL_POINTER_BUTTON_STATE_RELEASED,
+	};
+	penmove(event->tablet, event->tool, event->time_msec, true, true, event->x, event->y);
+	buttonpress(NULL, &ev);
+	wlr_seat_pointer_notify_frame(seat);
+}
