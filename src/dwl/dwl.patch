+ * under load (a browser starting, a terminal reflowing 200 000 lines) one slow window froze
+ * the whole screen for a quarter of a second, held again by the next change — 340 ms
+ * stalls in a stress test, a playing video frozen with it each time a browser opened. Now
+ * 60 ms for a layout change (a terminal redraws in 10-20 ms) and 50 ms for a new window
+ * (one slower than that — a browser starting — simply appears a little later, rising in,
+ * while everything else goes on)
+ * (the times: HOLD_RESIZE_MS, HOLD_MAP_MS, with holdmon's declaration) */
+void
+holdmon(Monitor *m, int ms)
+{
+	if (m->holding || !m->wlr_output->enabled)
+		return;
+	m->holding = 1;
+	m->holdover = 0;
+	wl_event_source_timer_update(m->hold, ms);
+}
