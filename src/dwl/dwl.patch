+int
+warmfifo(int fd, uint32_t mask, void *data)
+{
+	static char buf[256];
+	static size_t len;
+	ssize_t n;
+	char *nl;
+	size_t used;
+	while ((n = read(fd, buf + len, sizeof(buf) - 1 - len)) > 0) {
+		len += (size_t)n;
+		buf[len] = '\0';
+		while ((nl = strchr(buf, '\n'))) {
+			*nl = '\0';
+			used = (size_t)(nl + 1 - buf);
+			warmcmd(buf);
+			memmove(buf, nl + 1, len - used + 1);
+			len -= used;
+		}
+		if (len == sizeof(buf) - 1)   /* (a line longer than any command: dropped) */
+			len = 0;
+	}
+	return 0;
+}
