+{
+	Client *c;
+	if (!strncmp(line, "toggle ", 7) && warmname(line + 7))
+		warm(&(Arg){.v = line + 7});
+	else if (!strncmp(line, "hide ", 5) && warmname(line + 5) && (c = warmclient(line + 5)))
+		warmhide(c, 1);
