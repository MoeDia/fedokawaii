+ * A line that is not one of them is passed over (its comment); without the file, the
+ * colours compiled in (config.h: the dark theme's) stay. */
+void
+loadcolours(void)
+{
+	char path[PATH_MAX], key[16], val[16], line[256];
+	unsigned int hex;
+	const char *home = getenv("HOME");
+	float (*to)[4], (*all[3])[4] = { focuscolor, bordercolor, urgentcolor }, a;
+	FILE *f;
+	Client *c;
+	int i, k;
+
+	if (!home || snprintf(path, sizeof(path), "%s/.config/fedokawaii/current/dwl.colors", home)
+			>= (int)sizeof(path) || !(f = fopen(path, "r")))
+		return;
+	/* "KEY RRGGBB[AA]": focus, border, urgent — each state's hairline; shadow1, shadow2 — the
+	 * shadow's two inks, every state's. Kept premultiplied, as the scene draws them */
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%15s %15s", key, val) != 2 || (strlen(val) != 6 && strlen(val) != 8)
