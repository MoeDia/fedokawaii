+/* ── animations ──────────────────────────────────────────────────────────────────────
+ * A new window fades in, rising the last few pixels to its place; a closed one fades
+ * away, sinking as much; a workspace switch fades the windows out as they drift a little
+ * to one side, and the next ones in from the other. No edge ever sweeps across the
+ * screen (a moving cut reads as a tear). Drawn at the screen's own pace — a new position for
+ * every frame the screen shows (144 a second here), for the moment that frame will be on the
+ * glass (presentmon, rendermon), the movement eased out (quick at first, settling: animease)
+ * and the fade on a smootherstep (no pop at either end: fadeease), over anim_open_ms,
+ * anim_close_ms or anim_tag_ms (config.h; animations = 0: none).
+ * Only the picture moves — focus, the keyboard and the layout are where they end at once.
+ * While its monitor is held (holdmon: a window there has yet to draw its new size) an
+ * animation waits, its clock moved on, so no part of it is lost to a frame never shown.
+ * Never animated: a full-screen window, or any while one is full screen; a warm window; an
+ * X11 window's opening (it never says when it has drawn: shown at once), an unmanaged one;
+ * the lock */
+int
+animok(Client *c)
+{
+	Client *top;
+	return animations && !locked && c && c->mon && !c->isfullscreen
+			&& !iswarm(c) && !client_is_unmanaged(c)
+			&& !((top = focustop(c->mon)) && top->isfullscreen);
+}
