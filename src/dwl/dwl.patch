+/* the movement: ease-out (cubic) — fast away, a soft landing, nothing overshoots */
+double
+animease(double p)
+{
+	p = p < 0 ? 0 : p > 1 ? 1 : p;
+	return 1.0 - (1.0 - p) * (1.0 - p) * (1.0 - p);
+}
+
+/* the opacity: smootherstep — it starts and ends without a jolt, so a window neither pops
+ * in nor snaps out at either end of its fade */
+double
+fadeease(double p)
+{
+	p = p < 0 ? 0 : p > 1 ? 1 : p;
+	return p * p * p * (p * (p * 6 - 15) + 10);
+}
