+/* one line per value for the status reader: control characters (a newline in a title)
+ * become spaces, and bytes that are not UTF-8 (an X11 title in Latin-1) become '?', so
+ * a window's title can neither start a line of its own nor break the bar's JSON */
+static void
+printclean(const char *mon, const char *key, const char *s)
+{
+	const unsigned char *p = (const unsigned char *)s;
+	printf("%s %s ", mon, key);
+	while (p && *p) {
+		int n = *p < 0x80 ? 0 : *p >= 0xc2 && *p <= 0xdf ? 1
+			: (*p & 0xf0) == 0xe0 ? 2 : *p >= 0xf0 && *p <= 0xf4 ? 3 : -1;
+		int i = 1;
+		while (i <= n && (p[i] & 0xc0) == 0x80)
+			i++;
+		if (n < 0 || i <= n) {         /* a stray, overlong or cut-off sequence */
+			putchar('?');
+			p++;
+		} else if (n == 0) {
+			putchar(*p < 0x20 || *p == 0x7f ? ' ' : *p);
+			p++;
+		} else {
+			fwrite(p, 1, (size_t)n + 1, stdout);
+			p += n + 1;
+		}
+	}
+	putchar('\n');
+}
