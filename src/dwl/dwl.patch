+			>= (int)sizeof(path) || !(f = fopen(path, "r")))
+		return;
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%15s %6x", key, &hex) != 2)
+			continue;
+		to = !strcmp(key, "focus") ? focuscolor : !strcmp(key, "border") ? bordercolor
+			: !strcmp(key, "urgent") ? urgentcolor : NULL;
+		if (!to)
+			continue;
+		for (i = 0; i < 3; i++) {
+			to[i][0] = ((hex >> 16) & 0xff) / 255.0f;
+			to[i][1] = ((hex >> 8) & 0xff) / 255.0f;
