+/* The screensaver over the lock. kawa-saver --idle locks the desktop as it starts (gtklock,
+ * kawa-lock) and stays over the lock screen: the first key or move then fades the cloth away
+ * from over a lock already up — no wait for a lock to start, no frame held meanwhile. A layer
+ * surface is the saver only when it asks for that name and its program is the user's own
+ * kawa-saver (/proc/PID/exe): no other program can draw over the lock. Should the saver hang,
+ * the first input still reaches the lock within SAVER_GUARD_MS (savergone) */
+#define SAVER_GUARD_MS 1500
+static int
+issaver(struct wlr_layer_surface_v1 *ls)
+{
+	char link[64], exe[PATH_MAX];
+	const char *b;
+	pid_t pid;
+	uid_t uid;
+	gid_t gid;
+	ssize_t n;
+
+	if (!ls->namespace || strcmp(ls->namespace, "kawa-saver")
+			|| ls->pending.layer != ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY)
+		return 0;
+	wl_client_get_credentials(wl_resource_get_client(ls->resource), &pid, &uid, &gid);
+	if (uid != getuid())
+		return 0;
+	snprintf(link, sizeof(link), "/proc/%d/exe", (int)pid);
+	if ((n = readlink(link, exe, sizeof(exe) - 1)) <= 0)
+		return 0;
+	exe[n] = 0;
+	b = strrchr(exe, '/');
+	return b && !strcmp(b + 1, "kawa-saver");
