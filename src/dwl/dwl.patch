+				k = (int)roundf((float)(a.height + gap) * f) - gap;
+				b.y = a.y + a.height - k; b.height = k;
+				a.height -= k + gap;
+				break;
+			}
 		}
+		resize(c, b, 0);
 		i++;
 	}
 }
 
+/* ── popups ───────────────────────────────────────────────────────────────────────
+ * A popup is a menu in a window of its own (app-id "float": kawa-float's — the system
+ * menu, notes, the clipboard, btop…). It lasts while it has the focus: another window
+ * taking it, a click outside it, another workspace close it. Exempt: the dialogs that may
+ * open over one — the file dialog (app-id kawa-dialog) and the password prompt — and
+ * windows that take no focus (X11 menus and tooltips). */
+int
+ispopup(Client *c)
+{
+	return c && !client_is_unmanaged(c) && !strcmp(client_get_appid(c), "float");
+}
+
+int
+popupexempt(Client *c)
+{
+	const char *id = client_get_appid(c);
+	return !strcmp(id, "kawa-dialog") || !strcmp(id, "lxqt-policykit-agent");
+}
+
+void
+closepopups(Client *keep)
+{
+	Client *c;
+	wl_list_for_each(c, &clients, link)
+		if (c != keep && ispopup(c))
+			client_send_close(c);
+}
+
+/* a menu — a layer surface holding the keyboard to itself: fuzzel, the quick settings —
+ * gives the keyboard back, and closes as on Esc (both close when they lose it). A click
+ * outside it and a workspace switch do this; the caller focuses what comes next.
+ * Returns whether a menu had the keyboard */
+int
+dropmenu(void)
+{
+	LayerSurface *fl = NULL;
+	if (toplevel_from_wlr_surface(seat->keyboard_state.focused_surface, NULL, &fl) != LayerShell
+			|| !fl || fl->layer_surface->current.keyboard_interactive
+				!= ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_EXCLUSIVE)
+		return 0;
+	if (exclusive_focus == fl)
+		exclusive_focus = NULL;
+	wlr_seat_keyboard_notify_clear_focus(seat);
+	return 1;
+}
+
+/* a new window's first frame is ready (or it never answered within 250 ms: shown as it is,
+ * cut to its place — never drawn over its neighbours) */
+void
+showclient(Client *c)
+{
+	if (!c->awaitmap && c->scene && c->scene->node.enabled)
+		return;
+	c->awaitmap = 0;
+	if (c->mapwait)
+		wl_event_source_remove(c->mapwait);
+	c->mapwait = NULL;
+	if (!c->mon)
+		return;
+	wlr_scene_node_set_enabled(&c->scene->node, VISIBLEON(c, c->mon));
+	motionnotify(0, NULL, 0, 0, 0, 0);
+}
+
+int
+mapwaitdone(void *data)
+{
+	showclient(data);
+	return 0;
+}
+
+void
+heldframedone(struct wlr_surface *surface, int sx, int sy, void *data)
+{
+	wlr_surface_send_frame_done(surface, data);
+}
+
+/* FreeSync (adaptive sync): ~/.config/fedokawaii/vrr says when — "games" (the default:
+ * while a window is full screen on that monitor), "always" or "off"; read again when it
+ * changes (arrange(), and SIGUSR1: the quick settings' switch takes effect at once). A
+ * monitor that cannot do it is left alone. Each change is one line in dwl's log —
+ * "vrr: NAME on" / "off", or once "vrr: NAME has no adaptive sync" — for the health report */
+void
+updatevrr(Monitor *m)
+{
+	static char path[512];
+	static struct timespec seen;
+	static int mode = 1; /* 0 off, 1 games, 2 always */
+	struct stat st;
+	struct wlr_output_state state;
+	Client *c;
+	int want;
+
+	if (!path[0]) {
+		const char *home = getenv("HOME");
+		snprintf(path, sizeof(path), "%s/.config/fedokawaii/vrr", home ? home : "");
+	}
+	if (stat(path, &st) == 0 && (st.st_mtim.tv_sec != seen.tv_sec || st.st_mtim.tv_nsec != seen.tv_nsec)) {
+		char buf[16] = {0};
+		FILE *f = fopen(path, "r");
+		seen = st.st_mtim;
+		if (f) {
+			if (fgets(buf, sizeof(buf), f))
+				mode = !strncmp(buf, "off", 3) ? 0 : !strncmp(buf, "always", 6) ? 2 : 1;
+			fclose(f);
+		}
+	}
+	if (!m->wlr_output->enabled)
+		return;
+	if (!m->wlr_output->adaptive_sync_supported) {
+		if (m->vrr != -2)
+			fprintf(stderr, "vrr: %s has no adaptive sync\n", m->wlr_output->name);
+		m->vrr = -2;
+		return;
+	}
+	want = mode == 2 || (mode == 1 && (c = focustop(m)) && c->isfullscreen);
+	if (want == m->vrr)
+		return;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_adaptive_sync_enabled(&state, want);
+	if (wlr_output_commit_state(m->wlr_output, &state)) {
+		m->vrr = want;
+		fprintf(stderr, "vrr: %s %s\n", m->wlr_output->name, want ? "on" : "off");
+	}
+	wlr_output_state_finish(&state);
+}
