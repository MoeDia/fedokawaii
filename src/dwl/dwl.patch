+		a = (hex & 0xff) / 255.0f;
+		i = !strcmp(key, "shadow1") ? 1 : !strcmp(key, "shadow2") ? 2 : 0;
+		to = !strcmp(key, "focus") ? focuscolor : !strcmp(key, "border") ? bordercolor
