+	fn home_as_tilde(path: &str) -> String {
+		match std::env::var("HOME").ok().and_then(|h| path.strip_prefix(&h).map(str::to_owned)) {
+			Some(rest) if rest.is_empty() || rest.starts_with('/') => format!("~{rest}"),
+			_ => path.to_owned(),
+		}
+	}
+
+	fn parent(f: &File) -> Option<String> {
+		f.url.to_strand().into_string_lossy().rsplit_once('/').map(|(dir, _)| dir.to_owned())
+	}
+
+	fn same_folder(files: &[File]) -> bool {
+		let first = files.first().and_then(Self::parent);
+		first.is_some() && files.iter().all(|f| Self::parent(f) == first)
+	}
+
+	fn folder_of(files: &[File]) -> Option<Text<'static>> {
+		if !Self::same_folder(files) {
+			return None;
+		}
+		let dir = files.first().and_then(Self::parent)?;
+		Some(Text::raw(if dir.is_empty() { "/".to_owned() } else { Self::home_as_tilde(&dir) }))
+	}
 }
