diff --git a/yazi-fm/src/frame.rs b/yazi-fm/src/frame.rs
new file mode 100644
index 0000000..7d562b3
--- /dev/null
+++ b/yazi-fm/src/frame.rs
@@ -0,0 +1,124 @@
+// The desktop's pop-ups (fedokawaii, docs/design-system.md §4, §7): one frame for all of them, nothing in its
+// rule. The ring is §4's hairline drawn in whole terminal cells of Sumi Icons Term (tools/build-icons.py, CELLS):
+// square, its corners left out, 16 px clear of the content on every side. Inside it §7's heading — the icon in
+// accent_text, two columns, the name in strong, a space, the rule in edge2 — and a row of paper.
+// The inks are foot's slots past the sixteen (tools/build-themes.py), so a pop-up follows a theme switch.
+use ratatui_core::{buffer::Buffer, layout::Rect, style::{Color, Style}, text::{Line, Span}, widgets::Widget};
+use ratatui_widgets::block::Block;
+use yazi_binding::elements::RING;
+use yazi_widgets::clear::Clear;
+
+const fn ink(slot: u8) -> Style { Style::new().fg(Color::Indexed(slot)) }
+
+pub(crate) const RULE: Style = ink(19);
+pub(crate) const ICON: Style = ink(20);
+pub(crate) const MUTED: Style = ink(21);
+pub(crate) const FAINT: Style = ink(22);
+pub(crate) const STRONG: Style = ink(23);
+pub(crate) const EDGE: Style = ink(16);
+
+// Sumi Icons, as icons.sh names them (an icon's place never moves: tools/build-icons.py)
+pub(crate) const I_CHEVRON: &str = "\u{FE027}";
+pub(crate) const I_WINDOW: &str = "\u{FE02E}";
+pub(crate) const I_TERMINAL: &str = "\u{FE02F}";
+pub(crate) const I_HOURGLASS: &str = "\u{FE030}";
+pub(crate) const I_FOLDER: &str = "\u{FE031}";
+pub(crate) const I_FILE: &str = "\u{FE03D}";
+pub(crate) const I_DOOR: &str = "\u{FE021}";
+pub(crate) const I_KEYCAP: &str = "\u{FE084}";
+pub(crate) const I_PEN: &str = "\u{FE098}";
+pub(crate) const I_SEARCH: &str = "\u{FE0BA}";
+pub(crate) const I_TRASH: &str = "\u{FF00B}";
+
+/// The ring only: its inside, one row in and three columns in.
+pub(crate) fn ring(area: Rect, buf: &mut Buffer, style: Style) -> Rect {
+	Clear::default().render(area, buf);
+	Block::bordered().border_set(RING).border_style(style).render(area, buf);
+	Rect {
+		x:      area.x.saturating_add(3),
+		y:      area.y.saturating_add(1),
+		width:  area.width.saturating_sub(6),
+		height: area.height.saturating_sub(2),
+	}
+}
+
+/// The ring and the heading: the area under the heading and its row of paper.
+pub(crate) fn frame<'a>(area: Rect, buf: &mut Buffer, style: Style, icon: &'a str, name: Line<'a>) -> Rect {
+	let inner = ring(area, buf, style);
+	heading(inner, buf, icon, name);
+	Rect {
+		y: inner.y.saturating_add(2),
+		height: inner.height.saturating_sub(2),
+		..inner
+	}
+}
+
+fn heading<'a>(area: Rect, buf: &mut Buffer, icon: &'a str, name: Line<'a>) {
+	if area.height == 0 {
+		return;
+	}
+	let used = 3 + name.width() + 1;
+	let rule = (area.width as usize).saturating_sub(used);
+	let mut spans = vec![Span::styled(icon, ICON), Span::raw("  ")];
+	spans.extend(name.spans.into_iter().map(|s| Span::styled(s.content, STRONG.patch(s.style))));
+	spans.push(Span::raw(" "));
+	spans.push(Span::styled("─".repeat(rule), RULE));
+	Line::from(spans).render(Rect { height: 1, ..area }, buf);
+}
+
+/// A row of the content, the keys' row, cut to the content's own width (never into the ring).
+pub(crate) fn row(area: Rect, y: u16) -> Rect { Rect { y: area.y.saturating_add(y), height: 1, ..area } }
+
+/// A key as §7 draws it: a tile of whole cells (U+FF000 + its ASCII code, its two ends) in the ink it is given.
+pub(crate) fn keycap(word: &str) -> String {
+	let mut s = String::with_capacity(word.len() * 4 + 8);
+	s.push('\u{FF001}');
+	for c in word.chars() {
+		s.push(if c.is_ascii() && !c.is_ascii_control() { char::from_u32(0xFF000 + c as u32).unwrap_or(c) } else { c });
+	}
+	s.push('\u{FF002}');
+	s
+}
+
+/// What yazi calls a key ("<C-q>", "<Enter>", "<S-Tab>", "g") in the desktop's words ("ctrl+q", "enter", "shift+tab", "g").
+pub(crate) fn key_word(key: &str) -> String {
+	let Some(mut rest) = key.strip_prefix('<').and_then(|s| s.strip_suffix('>')) else {
+		return key.to_owned();
+	};
+	let mut out = String::new();
+	loop {
+		let (word, tail) = match rest.split_at_checked(2) {
+			Some(("C-", t)) => ("ctrl+", t),
+			Some(("A-", t)) => ("alt+", t),
+			Some(("S-", t)) => ("shift+", t),
+			Some(("D-", t)) => ("super+", t),
+			_ => break,
+		};
+		out.push_str(word);
+		rest = tail;
+	}
+	out.push_str(&rest.to_lowercase());
+	out
+}
+
+/// A word to be read starts lower case (§2), a name of two capitals stays as it is ("Open" → "open", "PDF" → "PDF").
+pub(crate) fn lower_first(s: &str) -> String {
+	let mut it = s.chars();
+	match (it.next(), it.next()) {
+		(Some(a), Some(b)) if a.is_uppercase() && !b.is_uppercase() => a.to_lowercase().chain([b]).chain(it).collect(),
+		_ => s.to_owned(),
+	}
+}
+
+/// The keys of a choice: "[y]  trash    [n]  keep".
+pub(crate) fn keys_line(pairs: &[(&str, &str)]) -> Line<'static> {
+	let mut spans = Vec::with_capacity(pairs.len() * 3);
+	for (i, (key, what)) in pairs.iter().enumerate() {
+		if i > 0 {
+			spans.push(Span::raw("    "));
+		}
+		spans.push(Span::raw(keycap(key)));
+		spans.push(Span::styled(format!(" {what}"), MUTED));
+	}
+	Line::from(spans)
+}
