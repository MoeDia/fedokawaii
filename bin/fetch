#!/usr/bin/env bash
# fetch — a small, cute system summary in the spirit of pfetch and nerdfetch: one of
# ten pixel pictures drawn for this desktop, beside one icon line per fact.
#
#   fetch            a picture chosen at random
#   fetch NAME       that one: neko (beckoning cat), daruma, torii (sunset over the
#                    sea), pc (a beige computer showing Mt Fuji), fuji (dawn over the
#                    mountain), onigiri, chochin (a paper lantern), cassette, kitsune
#                    (a fox mask) or ramen
#
# The pictures are real pixel art: two pixels per character cell, drawn with half
# blocks in 24-bit colour, which foot renders gap-free. Every colour in them is one of
# the desktop's own (tools/build-themes.py), and each has an ink outline or its own
# background, so it reads on the dark and the light theme alike. The icons are the
# desktop's own (Sumi Icons); the text uses the terminal's 16 colours.
# Pure bash reading /proc and /etc: nothing to install, prints in a few milliseconds.
set -u

# ── the pictures: 20 × 16 pixels, one letter per pixel ('.' = transparent); the first
#    entry of each is its palette, letter=colour ─────────────────────────────────────
# shellcheck disable=SC2034  # read through the nameref in picture()
