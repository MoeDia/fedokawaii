NAMES=(neko daruma torii pc fuji onigiri chochin cassette kitsune ramen)

rgb() { printf -v "$1" '%d;%d;%d' "0x${2:0:2}" "0x${2:2:2}" "0x${2:4:2}"; }

LOGO=()
picture() {   # picture NAME — two pixel rows → one line of ▀ / ▄ cells (fg = upper, bg = lower)
  local -n art="ART_$1"
  local -A pal=()
  local kv y x top bot t b line
  for kv in ${art[0]}; do pal[${kv%%=*}]=${kv#*=}; done
  for ((y = 1; y < ${#art[@]}; y += 2)); do
    line=""
    for ((x = 0; x < ${#art[y]}; x++)); do
      top=${art[y]:x:1} bot=${art[y + 1]:x:1}
      if [[ $top == . && $bot == . ]]; then line+=$'\e[0m '
      elif [[ $bot == . ]]; then rgb t "${pal[$top]}"; line+=$'\e[0;38;2;'"${t}m▀"
      elif [[ $top == . ]]; then rgb b "${pal[$bot]}"; line+=$'\e[0;38;2;'"${b}m▄"
      else rgb t "${pal[$top]}"; rgb b "${pal[$bot]}"; line+=$'\e[38;2;'"${t};48;2;${b}m▀"; fi
    done
    LOGO+=("$line"$'\e[0m')
  done
}

# ── the facts ────────────────────────────────────────────────────────────────
name="Linux" ver=""                               # (os-release(5): NAME's own default; VERSION_ID may be absent)
while IFS='=' read -r k v; do
  v=${v#[\"\']}; v=${v%[\"\']}                    # (either quote is allowed)
  case $k in NAME) name=${v% Linux} ;; VERSION_ID) ver=$v ;; esac
done </etc/os-release
read -r kernel </proc/sys/kernel/osrelease; kernel=${kernel%%-*}
read -r host </proc/sys/kernel/hostname
read -r up _ </proc/uptime; up=${up%.*}
d=$((up / 86400)) h=$((up / 3600 % 24)) m=$((up / 60 % 60))
uptime="${m}m"; ((h)) && uptime="${h}h $uptime"; ((d)) && uptime="${d}d $uptime"
total=0 avail=0
while read -r k v _; do
  case $k in MemTotal:) total=$v ;; MemAvailable:) avail=$v; break ;; esac
done </proc/meminfo
gib() { local t=$(( $2 * 10 / 1048576 )); printf -v "$1" '%d.%d' $((t / 10)) $((t % 10)); }
mu="" mt=""; gib mu $((total - avail)); gib mt "$total"

R=$'\e[0m'
c() { printf -v "$1" '\e[38;5;%sm' "$2"; }          # palette colour (foot's 16)
c V 7; c K 8; c B 15; c I1 9; c I2 12; c I3 7; c I4 10; c I5 11; c I6 13; c I7 14
dots=""; for i in 9 3 2 6 4 5 7 15; do c d "$i"; dots+="$d● "; done

# icons: the desktop's own in foot (the terminal with the icon font), none anywhere else
ICON_USER="" ICON_HAT="" ICON_CPU="" ICON_HOURGLASS="" ICON_WINDOW="" ICON_TERMINAL="" ICON_MEMORY=""
# shellcheck source=/dev/null
[[ $TERM == foot* ]] && . ~/.config/fedokawaii/icons.sh
INFO=(
  "$I1$ICON_USER $R ${B}${USER:-?}${K}@${B}${host}$R"
  "$I2$ICON_HAT $R ${V}${name,,}${ver:+ $ver}$R"
  "$I3$ICON_CPU $R ${V}${kernel}$R"
  "$I4$ICON_HOURGLASS $R ${V}${uptime}$R"
  "$I5$ICON_WINDOW $R ${V}${XDG_SESSION_DESKTOP:-tty}${K} · ${V}${TERM_PROGRAM:-${TERM:-?}}$R"
  "$I6$ICON_TERMINAL $R ${V}bash ${BASH_VERSION%%(*}$R"
  "$I7$ICON_MEMORY $R ${V}${mu} ${K}/${V} ${mt} GiB$R"
  "${dots% }$R"
)

# ── print: the picture on the left when the terminal shows 24-bit colour ──────
[[ ${1:-} == @(-h|--help) ]] && { sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0; }
pick=${1:-${NAMES[RANDOM % ${#NAMES[@]}]}}
[[ " ${NAMES[*]} " == *" $pick "* && $# -le 1 ]] || { echo "fetch: pictures are: ${NAMES[*]}" >&2; exit 2; }
[[ $TERM == foot* || ${COLORTERM:-} == truecolor || ${COLORTERM:-} == 24bit ]] && picture "$pick"
# the picture only where its lines fit (2 + 20 + 3 columns before the facts): in a narrower
# terminal the facts would wrap into the picture's next row — so then the facts alone.
# The width: bash looks it up (on stderr's terminal) after a child process ends —
# checkwinsize, here a subshell; not known (stderr elsewhere), the picture stays
if ((${#LOGO[@]})) && [[ -t 1 ]]; then
  shopt -s checkwinsize extglob; (:)
  w=0
  for i in "${INFO[@]}"; do
    i=${i//$'\e'\[*([0-9;])m/}; ((${#i} + 1 > w)) && w=$((${#i} + 1))   # (+1: the icon is two wide)
  done
  ((${COLUMNS:-0} > 0 && 25 + w > COLUMNS)) && LOGO=()
fi
echo
for i in "${!INFO[@]}"; do
  if ((${#LOGO[@]})); then printf '  %s   %s\n' "${LOGO[i]}" "${INFO[i]}"
  else printf '  %s\n' "${INFO[i]}"; fi
done
