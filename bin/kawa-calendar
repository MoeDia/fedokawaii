#!/usr/bin/env bash
# kawa-calendar — click the date (or Super+C): this month as a dropdown, a grid of the panel's
# (kawa-menu; docs/design-system.md): 暦 and the month, the weekdays, six weeks of days —
# today stamped, the days of the months either side dim — and three keys under it: previous,
# next, today. Paging keeps the cursor on the key that paged; Esc or a click elsewhere closes
# it. Weeks start on Monday. No arguments (--help: this text).
set -u
case ${1:-} in
  "") ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-calendar   (no arguments: this month)" >&2; exit 2 ;;
esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
export LC_TIME=C                        # English month names whatever the system locale
off=0                                   # months away from the current one
sel=()                                  # (opened clean; after paging, on the key that paged)
while :; do
  # today read once: at midnight a second reading could be the next day (the 1st marked
  # in the month just ending, or no day marked at all)
  now=$(date +%Y-%m-%d) || exit 1
  first=$(date -d "${now%-*}-01 $off month" +%F) || exit 1
  # the month short and in English, like every date on the desktop: "Oct 2026"
  read -r year month mname lead <<<"$(LC_ALL=C date -d "$first" '+%Y %m %b %u')"
  days=$(date -d "$first +1 month -1 day" +%d)
  before=$(date -d "$first -1 day" +%d)          # (the last day of the month before)
  today=""; [[ ${now%-*} == "$year-$month" ]] && today=$((10#${now##*-}))

  rows=()
  line() { local IFS=$'\t'; rows+=("$*"); }
  line part 暦 "$mname $year"
  for w in Mo Tu We Th Fr Sa Su; do line cell "$w" head; done
  # six weeks always (the grid never changes height as it pages): the month before's last
  # days, this month's, then the next one's first, those two dim
  for ((d = 10#$before - lead + 2; d <= 10#$before; d++)); do line cell "$d" dim; done
  for ((d = 1; d <= 10#$days; d++)); do
    if [[ $d == "$today" ]]; then line cell "$d" today; else line cell "$d"; fi
  done
  for ((d = 1; ${#rows[@]} < 1 + 7 + 42; d++)); do line cell "$d" dim; done
  k=${#rows[@]}                                   # (the keys' lines: previous, next, today)
  line key "$ICON_CHEVRON_LEFT" previous
  line key "$ICON_CHEVRON_RIGHT" next
  line key "$ICON_CALENDAR" today

  i=$(printf '%s\n' "${rows[@]}" | kawa-menu --drop --index "${sel[@]}") || exit 0
  case $((i - k)) in
    0) off=$((off - 1)) sel=(--select "$i") ;;
    1) off=$((off + 1)) sel=(--select "$i") ;;
    2) off=0 sel=(--select "$i") ;;
    *) exit 0 ;;
  esac
done
