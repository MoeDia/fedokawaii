#!/usr/bin/env bash
# kawa-pick — the file dialog. Brave's "Upload" and "Save as…" and the Open/Save dialogs of
# GTK programs ask the file chooser portal; ~/.config/xdg-desktop-portal/wlroots-portals.conf
# sends that to xdg-desktop-portal-termfilechooser (built by setup.sh), which runs this:
# yazi in a small floating terminal (foot, app-id "float"), in the desktop's colours.
#
#   open     Enter takes the file under the cursor (Space marks several first, where the
#            app takes several) · Enter on a folder goes into it
#   folder   Enter on a folder takes it · q takes the folder you are in
#   save     the file is already there, under the name the app suggests, with a note in
#            it (the portal makes it; kawa-pick words it): Enter saves it · r renames it first · Enter on a
#            folder takes it into that folder · Enter on another file replaces that one,
#            after a question; cancelling removes the file made for saving again
#   Esc      first undoes what yazi's Esc undoes (marks, a filter, a search), then cancels —
#            as Esc closes every other popup
#
# It looks like the other popups: the title in a rule along the top, the keys along the
# bottom (~/.config/yazi/init.lua dresses yazi so when KAWA_PICK names the mode).
#
# The portal's wrapper contract (xdg-desktop-portal-termfilechooser(5), modelled on its
# yazi-wrapper.sh):   kawa-pick MULTIPLE DIRECTORY SAVE PATH OUT [DEBUG]
#   MULTIPLE DIRECTORY SAVE  0 or 1 · PATH  where to start: a folder, or the file to save
#   OUT  the answer, one path per line; left empty = cancelled · DEBUG  1 = trace (journal)
# The portal waits for this to return and hands the app what OUT holds. An app asking for
# one file gets exactly one line (Chromium hangs on more), never a folder; a folder dialog
# never gets a file. Inside the window it runs itself again: kawa-pick --inside MODE PATH WORK.
set -u
PATH="$HOME/.local/bin:$PATH"                       # (the portal starts it with systemd's PATH)

# what the portal writes into the file it makes for saving (its first line) — and what
# kawa-pick writes there instead, in the dialog's own words, since yazi shows that file's
# text beside it (the portal's instructions are for another way of saving)
NOTE='* xdg-desktop-portal-termfilechooser instructions *'
KNOTE='the file being saved'
KNOTE_TEXT="$KNOTE

This stands in for it, under the
name the program suggests, until
you choose where it goes. Enter
saves it here; the keys below say
the rest. Cancelling removes it.
"
is_note() {   # is_note FILE — the stand-in for the file being saved (only its first line is read)
  local h
  [[ -f $1 && ! -L $1 ]] || return 1
  h=$(head -c 64 -- "$1" 2>/dev/null); h=${h%%$'\n'*}
  [[ $h == "$NOTE" || $h == "$KNOTE" ]]
}

say() { printf '\n  %s\n' "$1"; read -rsn1 -t 3 || true; }          # a word between two pickers
ask() { local a=""; printf '\n  %s  [y/N] ' "$1"; read -rsn1 a; printf '\n'; [[ $a == [yY] ]]; }

# ── inside the window ─────────────────────────────────────────────────────────
# yazi, again until MODE has its answer (WORK/answer) or there is none (cancelled).
# Saving: WORK/note-at lists every place kawa-pick moved the file to.
inside() {
  local mode=$1 here=$2 work=$3 chosen=() keep=() args=() f to p
  local -A seen=()
  # the dialog's yazi: yours (theme, init.lua, yazi.toml, plugins, flavors) with the dialog's
  # keys from ~/.config/fedokawaii/yazi-pick (Enter goes into folders, Esc cancels)
  local y=$work/yazi c=$HOME/.config/yazi d=$HOME/.config/fedokawaii/yazi-pick
  mkdir -p "$y/plugins"
  for p in theme.toml init.lua yazi.toml package.toml flavors; do [[ -e $c/$p ]] && ln -s "$c/$p" "$y/$p"; done
  for p in "$c"/plugins/*/; do [[ -d $p ]] && ln -s "${p%/}" "$y/plugins/"; done
  ln -s "$d/keymap.toml" "$y/keymap.toml"
  ln -sfn "$d/kawa-pick.yazi" "$y/plugins/kawa-pick.yazi"
  while :; do
    rm -f "$work/chosen" "$work/cwd"
    args=(--chooser-file="$work/chosen")
    [[ $mode == folder* ]] && args+=(--cwd-file="$work/cwd")
    KAWA_PICK=$mode YAZI_CONFIG_HOME=$y yazi "${args[@]}" -- "$here"
    chosen=() keep=()
    [[ -s $work/chosen ]] && mapfile -t chosen <"$work/chosen"
    case $mode in
      open1|openN)
        for f in "${chosen[@]}"; do [[ -d $f ]] || keep+=("$f"); done
        if ((${#keep[@]} == 0)); then
          ((${#chosen[@]})) || return 0             # Esc: cancelled
          here=${chosen[0]}; continue               # Enter on a folder: into it
        fi
        [[ $mode == open1 ]] && keep=("${keep[0]}") ;;
      folder1|folderN)
        for f in "${chosen[@]}"; do
          [[ -d $f ]] || f=$(dirname -- "$f")       # Enter on a file: the folder it is in
          [[ -n ${seen[$f]:-} ]] || keep+=("$f"); seen[$f]=1
        done
        ((${#keep[@]})) || { [[ -s $work/cwd ]] && keep=("$(<"$work/cwd")"); }   # q: where you are
        ((${#keep[@]})) || return 0                 # Esc: cancelled
        [[ $mode == folder1 ]] && keep=("${keep[0]}") ;;
      save)
        ((${#chosen[@]})) || return 0               # Esc: cancelled
        if ((${#chosen[@]} > 1)); then say "one file to save — unmark the others"; continue; fi
        f=${chosen[0]}
        if [[ -d $f ]]; then                        # Enter on a folder: the file goes in there
          [[ $f == "$(dirname -- "$here")" ]] && continue
          is_note "$here" || { say "the file to save is no longer where it was — pick it where you put it"; continue; }
          to=$f/${here##*/}
          while [[ -e $to || -L $to ]]; do to+=_; done   # (as the portal does: never over a file)
          if mv -n -- "$here" "$to" 2>/dev/null && [[ -e $to ]]; then
            here=$to; printf '%s\n' "$to" >>"$work/note-at"
          else
            say "cannot save in ${f/#"$HOME"/\~}"
          fi
          continue
        fi
        if [[ -e $f ]] && ! is_note "$f" && ! ask "replace ${f##*/}?"; then continue; fi
        keep=("$f") ;;
    esac
    printf '%s\n' "${keep[@]}" >"$work/answer"
    return 0
  done
}

case ${1:-} in
  --inside) shift; (($# == 3)) || exit 2; inside "$@"; exit 0 ;;
esac

# ── called by the portal ──────────────────────────────────────────────────────
if (($# < 5)); then
  echo "usage: kawa-pick MULTIPLE DIRECTORY SAVE PATH OUT [DEBUG]   (xdg-desktop-portal-termfilechooser runs it)" >&2
  exit 2
fi
multiple=$1 directory=$2 save=$3 path=${4:-$HOME} out=$5
[[ ${6:-0} == 1 ]] && set -x
if [[ $save == 1 ]]; then mode=save title="save file"
elif [[ $directory == 1 ]]; then mode=folder1 title="open folder"; [[ $multiple == 1 ]] && mode=folderN title="open folders"
else mode=open1 title="open file"; [[ $multiple == 1 ]] && mode=openN title="open files"
fi
: >"$out" || exit 1                                 # empty = cancelled, until there is an answer
if ! command -v yazi >/dev/null; then
  notify-send -a desktop -u critical "File picker" "yazi is missing — run update or repair" 2>/dev/null
  exit 1
fi

work=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/kawa-pick.XXXXXX") || exit 1
trap 'rm -rf "$work"' EXIT
: >"$work/start"                                    # what changes from here on is this pick's
if [[ $mode == save ]] && is_note "$path"; then
  printf '%s' "$KNOTE_TEXT" >"$path" 2>/dev/null || true
  cp -- "$path" "$work/note"
fi

# 100 × 31 (an even width, an odd height: centred to the pixel). The title stays put (yazi
# would write its folder there), so the bar says what the window is for.
kawa-float --locked-title "$title" 100x31 -- "$0" --inside "$mode" "$path" "$work" \
  || notify-send -a desktop -u critical "File picker" "no terminal window opened (foot)" 2>/dev/null

[[ -s $work/answer ]] && cat -- "$work/answer" >"$out"

# Saving: the file the portal made goes again unless it is the answer — from where it was
# made, from wherever kawa-pick took it, and under any name it got in yazi (the same note,
# changed during this pick). (The portal removes it from where it made it, too.)
if [[ -s $work/note ]]; then
  answer=$(head -n1 -- "$work/answer" 2>/dev/null)
  spots=("$path") dirs=("$(dirname -- "$path")")
  if [[ -s $work/note-at ]]; then
    mapfile -t moved <"$work/note-at"
    for f in "${moved[@]}"; do spots+=("$f"); dirs+=("$(dirname -- "$f")"); done
  fi
  while IFS= read -r f; do
    [[ $f != "$answer" && -f $f && ! -L $f ]] && cmp -s -- "$f" "$work/note" && rm -f -- "$f"
  done < <({ printf '%s\n' "${spots[@]}"
             find "${dirs[@]}" -maxdepth 1 -type f -cnewer "$work/start" -size -4k 2>/dev/null; } | sort -u)
fi
exit 0
