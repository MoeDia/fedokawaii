#!/usr/bin/env bash
# kawa-theme — the desktop's two themes: dark (sumi ink) and light (washi paper).
#
#   kawa-theme               switch to the other one (also: quick settings → theme)
#   kawa-theme dark|light    switch to that one
#   kawa-theme get           print the current one
#   kawa-theme apply         re-apply the current one (login, after theme.sh)
#   kawa-theme settings      only the GTK/portal settings (theme.sh, outside a session)
#
# Every app reads its colours through one link, ~/.config/fedokawaii/current →
# themes/dark or themes/light (fuzzel and foot by include, waybar and GTK by @import,
# gtklock by -s, btop/qt6ct by path, mpv by include, imv/qt6ct/wiremix through links).
# Switching re-points that link, then tells whatever is running to look again:
#   foot (every window)  SIGUSR1/SIGUSR2 to the server — neovim inside follows by itself
#   waybar               SIGUSR2 (reload)        mako      makoctl reload
#   btop                 SIGUSR2 (reload)        zathura   SourceConfig over D-Bus
#   GTK, libadwaita,     gsettings: color-scheme, gtk-theme (live; icon-theme Adwaita) —
#   Brave                Brave in GTK mode (theme.sh) takes its frame, toolbar and menus
#                        from the GTK theme, and web pages their dark/light from the portal
#   Qt (qt6ct)           its config link is replaced, which qt6ct watches (≈3 s)
#   mpv (every player)   load-config-file over its socket (scripts/kawa-ipc.lua; Syncplay's own)
#   wallpaper            each theme remembers its own picture (kawa-wallpaper)
#   dwl                  SIGUSR1 (src/dwl/dwl.patch): the window borders take the theme's
#                        colours (current/dwl.colors), and the pointers their theme —
#   pointers             ~/.local/share/icons/default → /usr/share/icons/Sumi-dark or -light,
#                        loaded again by dwl, and every window under the pointer asks anew — Wayland programs that ask dwl for a pointer by
#                        name (GTK 4, foot, Qt, Brave) change at once; GTK 3 by gsettings
#                        cursor-theme; programs drawing their own from XCURSOR_THEME
#                        (XWayland ones, some games) take the new one when next started
#   the login screen     /var/lib/fedokawaii-greeter/theme (yours; kawa-greet reads it)
# GTK 3 apps follow at once too (their theme is a named one).
#
# A switch you make is drawn as a transition (kawa-veil): the screen holds still while
# everything changes underneath, then the new theme arrives as a row of seigaiha wave
# crests — rising from the bottom like dawn for the light theme, falling from the top
# like nightfall for the dark one.
#
# Exit: 0 done (also a press dropped while a switch runs) · 1 could not · 2 wrong use.
set -u
DIR=$HOME/.config/fedokawaii
LINK=$DIR/current
POINTERS=$HOME/.local/share/icons/default

get() {
  local t
  t=$(readlink "$LINK" 2>/dev/null) || t=""
  t=${t%/}                                       # (a link made by hand: themes/light/)
  case ${t##*/} in light) echo light ;; *) echo dark ;; esac
}

usable() {   # usable MODE — can the link be pointed at MODE? Said before anything changes
  [[ -d $DIR/themes/$1 ]] || { echo "kawa-theme: no theme '$1' in $DIR/themes (run theme.sh)" >&2; return 1; }
  # a real folder there (a backup or sync tool copied the link's contents): the apps read
  # that, whatever the link would say — theme.sh puts the link back
  [[ -L $LINK || ! -e $LINK ]] || { echo "kawa-theme: $LINK is a folder, not a link (run theme.sh to repair it)" >&2; return 1; }
}

relink() {   # relink TARGET LINK — replace a link in one step (rename), so readers
  local tmp="$2.new.$$"   # never see it missing and folder watchers see one change
  ln -sfn "$1" "$tmp" 2>/dev/null && mv -fT "$tmp" "$2" 2>/dev/null && return 0
  rm -f "$tmp"; return 1
}

settings() {   # settings MODE — GTK 3 theme, GTK 4/libadwaita/portal colour scheme, icons, pointers
  local m=$1 gtk=Fedokawaii kv pids=() pid ok=0   # (the GTK 3 themes: adw-gtk3 + the palette)
  [[ $m == dark ]] && gtk=Fedokawaii-dark
  command -v gsettings >/dev/null || return 1
  # the four at once (each gsettings is a process of its own: one after the other they
  # held a switch up); one already right is not written again (no app told to look again)
  # (icons: GTK's own Adwaita in both, each app's own icon beneath it — no icon pack; set
  # here too, so an icon pack an older version chose goes at the next switch)
  for kv in "color-scheme=prefer-$m" "gtk-theme=$gtk" "icon-theme=Adwaita" "cursor-theme=Sumi-$m"; do
    { [[ $(gsettings get org.gnome.desktop.interface "${kv%%=*}" 2>/dev/null) == "'${kv#*=}'" ]] \
        || gsettings set org.gnome.desktop.interface "${kv%%=*}" "${kv#*=}" 2>/dev/null; } & pids+=($!)
  done
  for pid in "${pids[@]}"; do wait "$pid" || ok=1; done
  return "$ok"
}

declare -A RUNNING=()
scan() {   # RUNNING[NAME]="PID…" — the programs a switch tells, found with one pgrep (one for
  local pid name   # each held a switch up: a dozen processes, one after the other)
  RUNNING=()
  while read -r pid name; do RUNNING[$name]+="$pid "; done \
    < <(pgrep -lxu "$UID" 'foot|dwl|waybar|btop|mako|zathura')
}

signal() {   # signal USR1|USR2 NAME — only to processes that already catch it: until a
  local sig=$1 bit=9 pid k v   # program installs its handler, these signals terminate it
  [[ $sig == USR2 ]] && bit=11
  for pid in ${RUNNING[$2]:-}; do
    while read -r k v; do
      [[ $k == SigCgt: ]] || continue
      (( 16#$v >> bit & 1 )) && kill -s "$sig" "$pid"
      break
    done 2>/dev/null <"/proc/$pid/status"
  done
}

apply() {
  local m=$1 sig=USR1 pid s jobs=()
  usable "$m" || exit 1
  # (not switched: no app is told, so none shows a theme the others do not)
  relink "themes/$m" "$LINK" || { echo "kawa-theme: could not switch $LINK (is ~/.config writable?)" >&2; exit 1; }
  [[ $m == light ]] && sig=USR2
  # What takes a process of its own (the wallpaper, GTK's settings, each player, zathura) is
  # started first and all at once — one after the other they held the switch up (and the
  # veil with it) for their sum; the signals and links meanwhile take no time. The switch is
  # over when the slowest of them is
  # the theme's own wallpaper, without the switch locks (fds 7 and 9): the swaybg it starts
  # lives on. Under the veil it must be up before the reveal; otherwise it can come a moment later.
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    kawa-wallpaper --restore >/dev/null 2>&1 7>&- 9>&- &
    [[ -n ${KAWA_VEILED:-} ]] && jobs+=($!)
  fi
  scan
  signal "$sig" foot                                 # foot server: all windows + new ones
  settings "$m" >/dev/null 2>&1 & jobs+=($!)
  # mpv: every open player loads the new colours (its controller restyles itself at once);
  # scripts/kawa-ipc.lua gives each one a socket — one that refuses is a crashed mpv's.
  # A player Syncplay started answers on Syncplay's socket (left alone when it refuses)
  for s in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/mpv-*.sock "${XDG_RUNTIME_DIR:-/run/user/$UID}"/syncplay-*/mpv-socket; do
    [[ -S $s ]] || continue
    { python3 -I -c 'import json, socket, sys
c = socket.socket(socket.AF_UNIX); c.settimeout(1)
try:
    c.connect(sys.argv[1])
except (ConnectionRefusedError, FileNotFoundError):
    sys.exit(3)
c.sendall((json.dumps({"command": ["load-config-file", sys.argv[2]]}) + "\n").encode())' \
        "$s" "$DIR/themes/$m/mpv.conf" 2>/dev/null
      (($? == 3)) && [[ $s == */mpv-*.sock ]] && rm -f "$s"; } & jobs+=($!)
  done
  for pid in ${RUNNING[zathura]:-}; do
    busctl --user call "org.pwmt.zathura.PID-$pid" /org/pwmt/zathura org.pwmt.zathura SourceConfig >/dev/null 2>&1 & jobs+=($!)
  done
  [[ -n ${RUNNING[mako]:-} ]] && { makoctl reload >/dev/null 2>&1 & jobs+=($!); }   # (makoctl would start one)
  # the pointers: the default theme re-pointed (theme.sh made it a link); then dwl told to
  # take the borders' colours and the pointers again (signal: only a dwl that catches it —
  # an older build would end the session)
  if [[ -L $POINTERS && $(readlink "$POINTERS") != "/usr/share/icons/Sumi-$m" ]]; then
    relink "/usr/share/icons/Sumi-$m" "$POINTERS"
  fi
  signal USR1 dwl
  # the login screen (kawa-greet) wears the theme you last had (setup made the folder yours)
  [[ -w /var/lib/fedokawaii-greeter ]] && printf '%s\n' "$m" >/var/lib/fedokawaii-greeter/theme
  signal USR2 waybar
  signal USR2 btop
  [[ -L $HOME/.config/qt6ct/qt6ct.conf ]] && relink ../fedokawaii/current/qt6ct.conf "$HOME/.config/qt6ct/qt6ct.conf"
  ((${#jobs[@]})) && wait "${jobs[@]}"
  return 0
}

took() {   # took MODE — the switch's time, from the press, in the theme's log (fedokawaii-report
  # reads it): "kawa-theme: switched to light in 412 ms"
  local log=$HOME/.cache/kawa-theme.log t0=${KAWA_THEME_T0:-} ms
  [[ $t0 =~ ^[0-9]+[.,][0-9]{6}$ ]] || return 0
  ms=$(( (${EPOCHREALTIME//[.,]/} - ${t0//[.,]/}) / 1000 ))
  [[ -d ${log%/*} ]] || mkdir -p "${log%/*}" 2>/dev/null
  printf '%(%F %T)T kawa-theme: switched to %s in %d ms%s\n' -1 "$1" "$ms" "${KAWA_VEILED:+ (under the veil)}" >>"$log" 2>/dev/null
  # (kept short, the last 200 switches — on its own: the veil lifts when this run ends)
  { (($(wc -l <"$log") >= 400)) && tail -n 200 "$log" >"$log.$$" && mv -f "$log.$$" "$log"; } \
    </dev/null >/dev/null 2>&1 7>&- 9>&- &
  return 0
}

case ${1:-toggle} in
  get)      get ;;
  apply)    apply "$(get)" ;;
  settings) settings "$(get)" ;;
  dark|light|toggle)
    # the locks live in the session's runtime folder (also found from a shell without it)
    export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}
    [[ -d $XDG_RUNTIME_DIR && -w $XDG_RUNTIME_DIR ]] \
      || { echo "kawa-theme: no runtime folder $XDG_RUNTIME_DIR (not logged in to the desktop?)" >&2; exit 1; }
    # one switch at a time: a held key repeats ~35 times a second, and every extra press
    # while a switch (and its transition) runs is dropped. The veiled run below inherits
    # this lock, so it lasts until the transition is over.
    if [[ -z ${KAWA_VEILED:-} ]]; then
      exec 7>"$XDG_RUNTIME_DIR/kawa-theme.busy"
      flock -n 7 || exit 0
    fi
    export KAWA_THEME_T0=${KAWA_THEME_T0:-$EPOCHREALTIME}   # (the press: the veiled run keeps it)
    want=${1:-toggle} now=$(get)
    [[ $want == toggle ]] && { [[ $now == dark ]] && want=light || want=dark; }
    usable "$want" || exit 1                       # (said at once, not after a transition)
    # a visible change in a session: run the switch under the veil (dawn or nightfall)
    if [[ $want != "$now" && -z ${KAWA_VEILED:-} && -n ${WAYLAND_DISPLAY:-} ]]; then
      style=--rise; [[ $want == dark ]] && style=--fall
      KAWA_VEILED=1 exec kawa-veil "$style" -- "$0" "$want"
    fi
    exec 9>"$XDG_RUNTIME_DIR/kawa-theme.lock"
    flock -w 10 9 || { echo "kawa-theme: another switch is still running" >&2; exit 1; }
    apply "$want"
    took "$want"
    ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0" ;;
  *) echo "usage: kawa-theme [dark|light|toggle|get|apply|settings] (kawa-theme --help)" >&2; exit 2 ;;
esac
