#!/usr/bin/python3
"""kawa-torrents — torrents: found through Prowlarr, added from anywhere, played while they come.

  kawa-torrents                the window (the launcher's Torrents); where it is open, the torrent
                               given is added to it. A magnet link or a .torrent file opened anywhere
                               (the browser, yazi) comes here:
  kawa-torrents --open [LINK]  from the launcher and xdg-open: a window opened for it, or, when one is
                               open, LINK added there with a notice saying so
  kawa-torrents add LINK…      added, no window; each said on a line
  kawa-torrents magnet [FILE]  a .torrent file's magnet link, on the terminal and the clipboard
  kawa-torrents tend           Prowlarr's sites that fail for good rested, those back switched on
  kawa-torrents --check        the program, its files and libtorrent looked at: exit 1 says what is wrong
  kawa-torrents engine         the engine itself (kawa-torrents.service starts it)
  kawa-torrents inherit        an older program's list (torrra's) taken over (setup.sh, once)

LINK: a magnet link, a bare info hash, an http link or the path of a .torrent. Its programs live in
~/.local/lib/fedokawaii/kawa-torrents, its state in ~/.local/state/fedokawaii/torrents.
Exit: 0 · 1 it could not be done (said) · 2 wrong use.
"""
import os
import sys

HOME = os.path.expanduser("~")
LIB = os.environ.get("KAWA_TORRENTS_LIB") or os.path.join(HOME, ".local/lib/fedokawaii/kawa-torrents")
sys.path.insert(0, LIB)
# (compiled once, kept in the cache: nothing beside the installed files)
sys.pycache_prefix = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "kawa-torrents", "pyc")


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if not os.path.isfile(os.path.join(LIB, "common.py")):
        print(f"kawa-torrents: nothing at {LIB}: run the theme step (Super+U → the theme, anew)", file=sys.stderr)
        return 1
    if cmd == "engine" and len(argv) == 2:
        import engine
        return engine.main()
    import cli
    return cli.main(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
