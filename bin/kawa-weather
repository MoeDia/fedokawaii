#!/usr/bin/env bash
# kawa-weather — the weather where you are, from Open-Meteo (free, no API key): the place is
# NIGHT_LIGHT's latitude:longitude, its name WEATHER_CITY (~/.config/fedokawaii/env, from
# fedokawaii.conf). One forecast serves all three: kept in ~/.cache/kawa-weather.json and
# fetched again in the background once it is 30 minutes old, so nothing waits for the network.
#   kawa-weather          one line: "☼  Sharjah  31°  clear"
#   kawa-weather --bar    the bar's module (waybar JSON): the sky's icon and the temperature
#                         now ("☼ 31°"), the city and the sky in words as its tooltip
#   kawa-weather --menu   the week, as a dropdown under the bar (a click on the bar's): today
#                         and the six days after it — the sky, how the day feels, and its
#                         mean temperature. Choosing a day only closes it.
# Exit status: 0 done · 1 no city or place set · 2 misuse.
set -u
mode=line
case ${1:-} in
  "") ;;
  --bar) mode=bar ;;
  --menu) mode=menu ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-weather [--bar | --menu] (kawa-weather --help)" >&2; exit 2 ;;
esac
(($# <= 1)) || { echo "usage: kawa-weather [--bar | --menu] (kawa-weather --help)" >&2; exit 2; }
LC_ALL=C.UTF-8                           # English weekdays; widths count characters, not bytes
export LC_ALL
case :$PATH: in *":$HOME/.local/bin:"*) ;; *) PATH=$HOME/.local/bin:$PATH ;; esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env" || exit 1
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
if [[ -z ${WEATHER_CITY:-} || ! ${NIGHT_LIGHT:-} =~ ^-?[0-9]+(\.[0-9]+)?:-?[0-9]+(\.[0-9]+)?$ ]]; then
  [[ $mode == bar ]] && echo '{"text":""}'
  echo "kawa-weather: WEATHER_CITY and NIGHT_LIGHT (latitude:longitude) must be set in fedokawaii.conf" >&2
  exit 1
fi

# ── how a day feels ──────────────────────────────────────────────────────────
# One scale from cold to hot, set for a hot climate, read off the day's mean apparent
# temperature (Open-Meteo's apparent_temperature_mean: the air as the body takes it, the
# humidity and the wind in it), rounded to a whole degree. A day takes the first word whose
# bound it is under; past the last bound, the last word:
#   under 4 °C freezing · 4–13 cold · 14–19 cool · 20–25 mild · 26–31 warm · 32–37 hot · 38 and up scorching
FEEL=(4 freezing 14 cold 20 cool 26 mild 32 warm 38 hot - scorching)
feel() {   # feel DEGREES → $word
  local i
  for ((i = 0; i < ${#FEEL[@]}; i += 2)); do
    [[ ${FEEL[i]} == - ]] || (($1 < FEEL[i])) && { word=${FEEL[i + 1]}; return; }
  done
}

# ── the sky ──────────────────────────────────────────────────────────────────
sky() {    # sky CODE DAY → $icon and $words, for a WMO weather code (Open-Meteo's weather_code);
  local sun=$ICON_SUN                   # DAY 0 (night): the moon for a clear sky
  (($2)) || sun=$ICON_MOON
  case $1 in
    0)  icon=$sun words=clear ;;
    1)  icon=$sun words="mostly clear" ;;
    2)  icon=$ICON_CLOUD words="partly cloudy" ;;
    3)  icon=$ICON_CLOUD words=overcast ;;
    45) icon=$ICON_FOG words=fog ;;
    48) icon=$ICON_FOG words="rime fog" ;;
    51) icon=$ICON_RAIN words="light drizzle" ;;
    53) icon=$ICON_RAIN words=drizzle ;;
    55) icon=$ICON_RAIN words="heavy drizzle" ;;
    56|57) icon=$ICON_RAIN words="freezing drizzle" ;;
    61) icon=$ICON_RAIN words="light rain" ;;
    63) icon=$ICON_RAIN words=rain ;;
    65) icon=$ICON_RAIN words="heavy rain" ;;
    66|67) icon=$ICON_RAIN words="freezing rain" ;;
    80) icon=$ICON_RAIN words="light showers" ;;
    81) icon=$ICON_RAIN words=showers ;;
    82) icon=$ICON_RAIN words="heavy showers" ;;
    71) icon=$ICON_SNOW words="light snow" ;;
    73) icon=$ICON_SNOW words=snow ;;
    75) icon=$ICON_SNOW words="heavy snow" ;;
    77) icon=$ICON_SNOW words="snow grains" ;;
    85|86) icon=$ICON_SNOW words="snow showers" ;;
    95) icon=$ICON_STORM words=thunderstorm ;;
    96|99) icon=$ICON_STORM words="thunderstorm, hail" ;;
    *)  return 1 ;;                     # (not a WMO code: that day is not shown)
  esac
}

# ── the forecast, kept ───────────────────────────────────────────────────────
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/kawa-weather.json
FAILED=${CACHE%.json}.failed           # why the last fetch brought nothing: "offline", "Open-Meteo down"
FRESH=1800                              # seconds: older, it is fetched again (behind)
OLD=3600                                # seconds: older, it is shown with its age
API=https://api.open-meteo.com/v1/forecast
ASK="current=temperature_2m,weather_code,is_day&daily=weather_code,temperature_2m_mean,apparent_temperature_mean&timezone=auto&forecast_days=7"
# a forecast is this, nothing else: an error page, a captive portal's, a cut-off answer, a
# cache of another place (NIGHT_LIGHT changed) is never shown
VALID='def num: type == "number";
  (.current | (.temperature_2m | num) and (.weather_code | num) and (.is_day == 0 or .is_day == 1))
  and (.utc_offset_seconds | num)
  and (.daily | (.time | length) as $n | $n >= 1
       and all(.time[]; type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}$"))
       and all(.weather_code, .temperature_2m_mean, .apparent_temperature_mean; type == "array" and length == $n))'

refresh() {   # the forecast fetched and checked, then kept — or why not, in $FAILED
  local json r
  mkdir -p "${CACHE%/*}" || return 0
  exec 8>"$CACHE.lock" && flock -n 8 || return 0          # (the bar and the menu at once: one fetch)
  json=$(curl -fsS --proto '=https' --max-time 8 "$API?latitude=${NIGHT_LIGHT%:*}&longitude=${NIGHT_LIGHT#*:}&$ASK" 2>/dev/null); r=$?
  # (an HTTP error is Open-Meteo's own; no answer, or an answer that is no forecast — a hotel
  # Wi-Fi's login page, a cut-off line — is no way out to it: offline)
  if ((r == 22)); then echo "Open-Meteo down" >"$FAILED"; return 0; fi
  if ((r != 0)) || ! jq -e "$VALID" >/dev/null 2>&1 <<<"$json"; then echo offline >"$FAILED"; return 0; fi
  jq -c --arg p "$NIGHT_LIGHT" '{place: $p} + .' <<<"$json" >"$CACHE.tmp" 2>/dev/null \
    && mv -f "$CACHE.tmp" "$CACHE" && rm -f "$FAILED"
}

# what the cache says, for this place: "now TEMP CODE DAY", then "day WEEKDAY DATE CODE MEAN
# FEELS" for today (the place's own date: timezone=auto) and each day after it, whole degrees
# (a day Open-Meteo has no numbers for yet is left out)
read_cache() {
  [[ -s $CACHE ]] || return 0
  jq -r --arg p "$NIGHT_LIGHT" --argjson now "$EPOCHSECONDS" '
    def deg: . + 0.5 | floor;
    select(.place == $p and ('"$VALID"'))
    | ((($now + .utc_offset_seconds) | strftime("%Y-%m-%d"))) as $today
    | "now \(.current.temperature_2m | deg) \(.current.weather_code) \(.current.is_day)",
      (.daily | range(0; .time | length) as $i
       | select(.time[$i] >= $today)
       | select([.weather_code[$i], .temperature_2m_mean[$i], .apparent_temperature_mean[$i]] | all(type == "number"))
       | "day \(.time[$i] | strptime("%Y-%m-%d") | mktime | strftime("%a")) \(.time[$i][8:] | tonumber) \(.weather_code[$i]) \(.temperature_2m_mean[$i] | deg) \(.apparent_temperature_mean[$i] | deg)")
  ' "$CACHE" 2>/dev/null
}

now=() days=()
while read -r kind rest; do
  case $kind in now) read -ra now <<<"$rest" ;; day) days+=("$rest") ;; esac
done < <(read_cache)
age=0 failed=""
if ((${#now[@]})); then age=$((EPOCHSECONDS - $(stat -c %Y "$CACHE"))); fi
[[ -s $FAILED ]] && read -r failed <"$FAILED"   # (read before the next fetch can change it)
if ((${#now[@]} == 0 || age > FRESH)); then
  refresh &>/dev/null & disown
fi
old() {   # old SECONDS → $old: "45 min old", "3 h old", "1 day old", "4 days old"
  if (($1 < 3600)); then old="$(($1 / 60)) min old"
  elif (($1 < 86400)); then old="$(($1 / 3600)) h old"
  elif (($1 < 172800)); then old="1 day old"
  else old="$(($1 / 86400)) days old"; fi
}

# ── one line · the bar ───────────────────────────────────────────────────────
if [[ $mode != menu ]]; then
  icon="" words=""
  ((${#now[@]})) && sky "${now[1]}" "${now[2]}"
  if [[ $mode == bar ]]; then
    if [[ -z $icon ]]; then echo '{"text":""}'; exit 0; fi           # (nothing known yet: no module)
    tip="$WEATHER_CITY · $words" class='"sky"'
    if ((age > OLD)); then old "$age"; tip+=" · ${failed:+$failed · }$old"; class='["sky","stale"]'; fi
    # (its ICON_BAR_*, no space: exactly 6 px from the icon's ink to the value's)
    for n in SUN MOON CLOUD FOG RAIN SNOW STORM; do
      v=ICON_$n; [[ $icon == "${!v}" ]] && { v=ICON_BAR_$n; icon=${!v}; break; }
    done
    jq -cn --arg t "$icon${now[0]}°" --arg tip "$tip" --argjson c "$class" '{text: $t, tooltip: $tip, class: $c}'
  elif [[ -n $icon ]]; then
    printf '%s  %s  %s°  %s\n' "$icon" "$WEATHER_CITY" "${now[0]}" "$words"
  else
    printf '%s\n' "$WEATHER_CITY"
  fi
  exit 0
fi

# ── the menu ─────────────────────────────────────────────────────────────────
# A dropdown under the weather in the bar (kawa-menu --drop: lit while open, closed by the
# bar's click again), in the design system's parts (docs/design-system.md), one line each in
# kawa-menu's tab-separated format, laid out by it:
#   part  天  Sharjah                     the heading: 天 (ten, the sky — 天気, the weather), the city
#   row   ☼  Mon 19  scorching  31°      a day: the sky's glyph, the weekday and date, how the
#                                         day feels (a column of its own), its mean temperature
#                                         (the value, right-aligned)
#   off   ⊘  offline                      no days at all: why, faint, nothing to choose
# Days over an hour old say so in the quiet line above the heading (--title): why no newer
# came, and their age — "offline · 3 h old".
rows=()
line() { local IFS=$'\t'; rows+=("$*"); }
line part 天 "$WEATHER_CITY"
for d in "${days[@]}"; do
  read -r wd dd code mean feels <<<"$d"
  sky "$code" 1 || continue
  feel "$feels"
  line row "$icon" "$wd $dd" "$word" "$mean°"
done
title="" select=()
if ((${#rows[@]} == 1)); then
  case $failed in
    "") line off "$ICON_HOURGLASS" "the forecast is coming" ;;   # (the first fetch, still going)
    *)  line off "$ICON_OFFLINE" "$failed" ;;
  esac
else
  select=(--select 1)                    # (today: where the first key puts the cursor)
  if ((age > OLD)); then old "$age"; title="${failed:+$failed · }$old"; fi
fi
i=$(printf '%s\n' "${rows[@]}" | kawa-menu --drop --index "${select[@]}" --title "$title") || exit 0
# (the heading: the menu again, as every menu; a day: nothing to do but close)
((i == 0)) && exec "$0" --menu
exit 0
