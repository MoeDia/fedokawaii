#!/usr/bin/env bash
# kawa-weather — the weather of WEATHER_CITY (~/.config/fedokawaii/env), from wttr.in (no
# API key), from a cache refreshed in the background when older than 30 minutes, so it
# never holds the bar up:
#   kawa-weather              one line: "☼ Sharjah  31°C  Clear" (the icon drawn for the sky)
#   kawa-weather --bar        the bar's module: the sky's icon and the temperature ("☼ 31°"),
#                             the city and the sky's words as its tooltip (waybar JSON)
#   kawa-weather --forecast   the next days, hour by hour, in a window (a click on the bar's)
# Exit status: 0 printed · 1 no city set · 2 misuse.
set -u
mode=line
case ${1:-} in
  "") ;;
  --bar) mode=bar ;;
  --forecast) mode=forecast ;;
  --inside) mode=inside ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-weather [--bar | --forecast] (kawa-weather --help)" >&2; exit 2 ;;
esac
LC_ALL=C.UTF-8                           # wttr.in's words matched as English: in Turkish, I is no i
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env"
if [[ -z $WEATHER_CITY ]]; then [[ $mode == bar ]] && echo '{"text":""}'; exit 1; fi
if [[ $mode == forecast ]]; then
  exec kawa-float --once weather "weather · $WEATHER_CITY" 64x37 -- "$0" --inside
elif [[ $mode == inside ]]; then           # in the window: wttr.in's own forecast, narrow, quiet
  # Q (superquiet): no place name from wttr.in at all — neither its heading nor its "Location:"
  # line, the place as its geocoder spells it (often in Arabic letters here, which a terminal
  # draws unjoined and left to right). The window's title names the city, as you wrote it.
  city=$(jq -rn --arg c "$WEATHER_CITY" '$c | @uri')
  printf '\n'
  curl -fsS --proto '=https' --max-time 10 "https://wttr.in/$city?2nQFm" 2>/dev/null | sed 's/^/ /' \
    || printf '  the forecast did not come (offline, or wttr.in is busy) — try again in a while\n'
  printf '\n  any key closes this window '; read -rsn1 _; exit 0
fi
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
CACHE="$HOME/.cache/kawa-weather"
# "31°C  Partly cloudy": a temperature and the sky's words, nothing else. Whatever else comes
# back — wttr.in's "out of queries" notice with a whole report of another city, a captive
# portal's page, a cut-off answer — never becomes the title, and an old cache that is not
# like this is fetched again.
TEMP='[+-]?[0-9]{1,3}°[CF]' SKY='[[:alpha:]][[:alpha:] ,/-]{0,60}[[:alpha:]]'

refresh() {
  local line city
  city=$(jq -rn --arg c "$WEATHER_CITY" '$c | @uri')   # "Saint-Étienne", "St. John's": URL-encoded
  line=$(curl -fsS --proto '=https' --max-time 8 "https://wttr.in/$city?format=%t++%C&m" 2>/dev/null) || return 0
  [[ $line =~ ^($TEMP)[[:space:]]+($SKY)[[:space:]]*$ ]] || return 0
  mkdir -p "${CACHE%/*}"
  printf '%s  %s  %s\n' "$WEATHER_CITY" "${BASH_REMATCH[1]#+}" "${BASH_REMATCH[2]}" >"$CACHE.tmp" \
    && mv -f "$CACHE.tmp" "$CACHE"
}

cached=""
[[ -s $CACHE ]] && read -r cached <"$CACHE"
# kept for another city (the settings changed it), or not a weather line: not shown, only the
# city's name until the new one has come
[[ $cached == "$WEATHER_CITY  "* && ${cached#"$WEATHER_CITY  "} =~ ^$TEMP\ \ $SKY$ ]] || cached=""
if [[ -z $cached || -n $(find "$CACHE" -mmin +30 2>/dev/null) ]]; then
  refresh &>/dev/null & disown
fi
line=$WEATHER_CITY cond=""
[[ -n $cached ]] && line=$cached cond=${cached##*  }   # "City  31°C  Clear" → Clear
printf -v hour '%(%H)T' -1
sky=$ICON_SUN; ((10#$hour < 6 || 10#$hour >= 18)) && sky=$ICON_MOON
case ${cond,,} in                        # the sky only, never the city's name ("Nice")
  *thunder*|*storm*)                     icon=$ICON_STORM ;;
  *snow*|*sleet*|*blizzard*|*ice*)       icon=$ICON_SNOW ;;
  *rain*|*drizzle*|*shower*)             icon=$ICON_RAIN ;;
  *fog*|*mist*|*haze*|*dust*|*sand*)     icon=$ICON_FOG ;;
  *cloud*|*overcast*)                    icon=$ICON_CLOUD ;;
  *)                                     icon=$sky ;;
esac
if [[ $mode == bar ]]; then
  if [[ -z $cond ]]; then echo '{"text":""}'; exit 0; fi       # (nothing known yet: no module)
  t=${line#*  }; t=${t%%  *}; t=${t%C}; t=${t%F}               # "31°C" → "31°"
  jq -cn --arg t "$icon $t" --arg tip "$WEATHER_CITY · $cond" '{text: $t, tooltip: $tip, class: "sky"}'
  exit 0
fi
printf '%s  %s\n' "$icon" "$line"
