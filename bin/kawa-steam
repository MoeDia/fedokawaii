#!/usr/bin/env bash
# kawa-steam — Steam, as part of the desktop:
#   kawa-steam [steam://…] Steam's window (the launcher's Steam, a click on the bar's gamepad;
#                         ~/.local/share/applications/steam.desktop): brought up when Steam
#                         runs; started when it does not, with a notice ("starting Steam…",
#                         "updating itself" on its very first start) that goes once its window
#                         is there. A steam:// (or steamlink://) link (a game's page, "install" on a web page)
#                         is handed to it either way
#   kawa-steam --bar      the bar's gamepad, while Steam runs (waybar JSON, every 3 s):
#                         dim while it starts, lit once ready, filled vermilion in a game
#   kawa-steam --menu     the gamepad's right-click: Library · Downloads · Friends · Settings ·
#                         start with the desktop on/off · quit Steam
#   kawa-steam --warm     at login (the session's autostart): a minute later, Steam started
#                         quietly in the background at low priority — so the window is there
#                         at once when you want it. Off in the gamepad's menu (the file
#                         ~/.config/fedokawaii/steam-warm then says "no")
# Steam keeps running when its window is closed (downloads go on); "quit Steam" ends it.
# Exit status: 0 done · 1 could not (Steam is not installed) · 2 misuse.
set -u
case ${1:-} in
  ""|--bar|--menu|--warm|steam://*|steamlink://*) ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-steam [steam://… | --bar | --menu | --warm] (kawa-steam --help)" >&2; exit 2 ;;
esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
WARM=$HOME/.config/fedokawaii/steam-warm
running() { pgrep -xu "$UID" steam >/dev/null; }
ready()   { pgrep -xu "$UID" steamwebhelper >/dev/null; }
ingame()  { pgrep -u "$UID" -f 'SteamLaunch AppId=' >/dev/null; }
warm_on() { [[ $(cat "$WARM" 2>/dev/null) != no ]]; }

case ${1:-} in
  --bar)
    if ! running; then echo '{"text":""}'
    elif ingame; then printf '{"text":"%s","class":"game","tooltip":"Steam · in a game"}\n' "$ICON_GAMEPAD"
    elif ready; then printf '{"text":"%s","class":"ready","tooltip":"Steam · click: its window · right-click: its menu"}\n' "$ICON_GAMEPAD"
    else printf '{"text":"%s","class":"starting","tooltip":"Steam is starting…"}\n' "$ICON_GAMEPAD"; fi
    exit 0 ;;
  --warm)
    command -v steam >/dev/null && warm_on || exit 0
    sleep 60
    running && exit 0
    # -silent: no window, a minute into the session (in a scope of its own). No lower priority:
    # the games Steam starts are its children and would inherit it (and a scope takes no
    # Nice= or IOSchedulingClass= — systemd-run refuses them)
    setsid -f systemd-run --user --scope --quiet -- steam -silent </dev/null >/dev/null 2>&1
    exit 0 ;;
  --menu)
    command -v steam >/dev/null || exit 1
    w=on; warm_on || w=off
    rows=("$ICON_FOLDER  library" "$ICON_DOWNLOAD  downloads" "$ICON_USER  friends" "$ICON_SLIDERS  settings"
          "$ICON_RESTART  start with the desktop   $w" "$ICON_POWER  quit Steam")
    i=$(printf '%s\n' "${rows[@]}" | kawa-menu --drop --index --width 34 --lines ${#rows[@]}) || exit 0
    case $i in
      0) exec steam steam://open/games ;;
      1) exec steam steam://open/downloads ;;
      2) exec steam steam://open/friends ;;
      3) exec steam steam://open/settings ;;
      4) mkdir -p "${WARM%/*}"; if warm_on; then echo no >"$WARM"; else echo yes >"$WARM"; fi
         notify-send -a desktop -- "$ICON_GAMEPAD  Steam" "start with the desktop: $(warm_on && echo on || echo off)" ;;
      5) exec steam -shutdown ;;
    esac
    exit 0 ;;
esac

# the window
command -v steam >/dev/null || { notify-send -a desktop -- "$ICON_GAMEPAD  Steam" "Steam is not installed (STEAM=yes in fedokawaii settings, then update)"; exit 1; }
link=${1:-steam://open/main}
if running; then
  # (Steam hands the request to the running one, which brings its window up)
  setsid -f steam "$link" </dev/null >/dev/null 2>&1; exit 0
fi
first=0; [[ -x $HOME/.local/share/Steam/ubuntu12_32/steam ]] || first=1
if ((first)); then msg="updating itself — its very first start takes a few minutes"
else msg="starting…"; fi
id=$(notify-send -a desktop -p -t 0 -- "$ICON_GAMEPAD  Steam" "$msg" 2>/dev/null)
setsid -f steam ${1:+"$1"} </dev/null >/dev/null 2>&1
# the notice goes once Steam's window process is up (or after 10 minutes, whatever happened)
for ((t = 0; t < 600; t++)); do ready && break; sleep 1; done
[[ -n $id ]] && makoctl dismiss -n "$id" 2>/dev/null
exit 0
