#!/usr/bin/env bash
# kawa-steam — Steam, as part of the desktop:
#   kawa-steam [steam://…] Steam's window (the launcher's Steam, a click on the bar's gamepad;
#                         ~/.local/share/applications/steam.desktop): brought up when Steam
#                         runs; started when it does not, with a notice ("starting Steam…",
#                         "updating itself" on its very first start) that goes once its window
#                         is there. A steam:// (or steamlink://) link (a game's page, "install" on a web page)
#                         is handed to it either way
#   kawa-steam --bar      the bar's gamepad, while Steam runs (waybar JSON, once):
#                         dim while it starts, lit once ready, filled vermilion in a game
#   kawa-steam --bar-watch  the same, long-running: what the bar runs (read from /proc by
#                         bash alone, no process started: a look every 3 s, and at once
#                         when a dropdown opens or closes)
#   kawa-steam --menu     the gamepad's right-click: Library · Downloads · Friends · Settings ·
#                         start with the desktop on/off · quit Steam
#   kawa-steam --warm     at login (the session's autostart): a minute later, Steam started
#                         quietly in the background at low priority — so the window is there
#                         at once when you want it. Off in the gamepad's menu (the file
#                         ~/.config/fedokawaii/steam-warm then says "no")
#   kawa-steam --quit [WHY]  Steam closed properly — as its own menu's Exit closes it: it
#                         first sends your games' saves to Steam Cloud — and waited for (20 s
#                         at most), with a notice meanwhile. The power menu's log out runs it
#                         before the desktop ends (Steam draws through XWayland, which ends
#                         with the desktop: it would be cut off mid-upload); the menu's
#                         "quit Steam" too. WHY (logout, shutdown, menu) goes to the journal
#   kawa-steam --guard    for the whole session (autostart): logind's own warning before the
#                         computer stops — a delay lock on shutdown and restart — so whatever
#                         stops it (the power menu, the power button, `systemctl reboot`, an
#                         update's restart) closes Steam as --quit does, while the desktop
#                         still runs; logind waits up to 25 s (setup.sh: InhibitDelayMaxSec)
#   kawa-steam --cloud    each game's Steam Cloud, read from Steam's own log
#                         (~/.local/share/Steam/logs/cloud_log.txt): its last upload and its
#                         result, and a game whose cloud saves were made on Windows while it
#                         runs here as its Linux build (Steam skips them "to our platform":
#                         the two builds keep their saves apart, nothing crosses). Exit 1 when
#                         a game's last upload failed or its saves cannot cross
#   kawa-steam --cloud-fix   after Steam has closed (--quit runs it): such a game is set to
#                         run with GE-Proton (Steam's Compatibility setting, config.vdf — only
#                         safe to write while Steam is closed), so it reads and writes the
#                         Windows saves the cloud holds, and its sync state
#                         (userdata/…/APPID/remotecache.vdf, mixed by the two builds: an upload
#                         "I/O Operation Failed") starts afresh — Steam compares with the cloud
#                         at the game's next start. Once a game (~/.local/state/fedokawaii/
#                         steam-proton): changed back by hand, it stays as you set it; when
#                         update retires its GE-Proton, it moves to the newest
# Each quit goes to the journal (journalctl -t kawa-steam): "asked Steam to quit (WHY), done
# in N s" — or that it still ran after 20 s — then each upload Steam made while it closed
# ("cloud: GAME (APPID) upload OK" or its failure), and what --cloud-fix changed.
# Steam keeps running when its window is closed (downloads go on); "quit Steam" ends it.
# Exit status: 0 done · 1 could not (Steam is not installed; still running after --quit) · 2 misuse.
set -u
case ${1:-} in
  ""|--bar|--bar-watch|--menu|--warm|--quit|--guard|--guard-wait|--cloud|--cloud-fix|steam://*|steamlink://*) ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-steam [steam://… | --bar | --menu | --warm | --quit [WHY] | --guard | --cloud] (kawa-steam --help)" >&2; exit 2 ;;
esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# MangoHud in every game Steam starts (its Vulkan layer: DXVK and VKD3D, so every Proton game),
# hidden until Shift_R+F12 (~/.config/MangoHud/MangoHud.conf: no_display)
export MANGOHUD=1
WARM=$HOME/.config/fedokawaii/steam-warm
running() { pgrep -xu "$UID" steam >/dev/null; }
ready()   { pgrep -xu "$UID" steamwebhelper >/dev/null; }
ingame()  { pgrep -u "$UID" -f 'SteamLaunch AppId=' >/dev/null; }
warm_on() { [[ $(cat "$WARM" 2>/dev/null) != no ]]; }

say() { logger -t kawa-steam -- "$*" 2>/dev/null; }
STEAM_DIR=$HOME/.local/share/Steam
# cloud MODE [ARG] — Steam Cloud from Steam's own files (python: its config is VDF, nested)
#   status: a line a game (its last upload; saves made on Windows, run here natively), exit 1 on a problem
#   uploads-since EPOCH_µs: the uploads logged since then, a line each · fix: see --cloud-fix
cloud() {
  python3 -I - "$1" "${2:-0}" "$STEAM_DIR" "${XDG_STATE_HOME:-$HOME/.local/state}/fedokawaii/steam-proton" <<'PY'
import glob, os, re, sys, time
mode, since, root, statef = sys.argv[1], int(sys.argv[2]) // 1000000, sys.argv[3], sys.argv[4]
line_re = re.compile(r"^\[(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d)\] \[AppID (\d+)\] (.*)$")
last, skipped, uploads = {}, set(), []
try:
    log = open(os.path.join(root, "logs/cloud_log.txt"), errors="replace").read().splitlines()
except OSError:
    log = []
for l in log:
    m = line_re.match(l)
    if not m:
        continue
    when, app, msg = m.groups()
    if "to our platform" in msg and msg.startswith("Skipping download"):
        skipped.add(app)
    r = re.match(r"Upload complete, result (.*)", msg)
    if r:
        last[app] = (when, r.group(1).strip())
        if time.mktime(time.strptime(when, "%Y-%m-%d %H:%M:%S")) >= since:
            uploads.append((app, r.group(1).strip()))

def name(app):
    lf = os.path.join(root, "steamapps/libraryfolders.vdf")
    libs = [root] + (re.findall(r'"path"\s+"([^"]+)"', open(lf, errors="replace").read()) if os.path.exists(lf) else [])
    for lib in libs:
        f = os.path.join(lib, "steamapps", f"appmanifest_{app}.acf")
        m = re.search(r'"name"\s+"([^"]*)"', open(f, errors="replace").read()) if os.path.exists(f) else None
        if m:
            return m.group(1)
    return "AppID " + app

# config.vdf: tokens → nested [key, value-or-list] pairs, written back in Steam's own layout
CFG = os.path.join(root, "config/config.vdf")
def parse(text):
    toks = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', re.sub(r"(?m)^\s*//.*$", "", text))
    pos = 0
    def block():
        nonlocal pos
        out = []
        while pos < len(toks):
            s, b = toks[pos]; pos += 1
            if b == "}":
                return out
            v, vb = toks[pos]; pos += 1
            out.append([s, block() if vb == "{" else v])
        return out
    return block()
def dump(pairs, d=0):
    t = "\t" * d; out = ""
    for k, v in pairs:
        if isinstance(v, list):
            out += f'{t}"{k}"\n{t}{{\n{dump(v, d + 1)}{t}}}\n'
        else:
            out += f'{t}"{k}"\t\t"{v}"\n'
    return out
def child(pairs, key, make=False):
    for kv in pairs:
        if kv[0].lower() == key.lower() and isinstance(kv[1], list):
            return kv[1]
    if make:
        pairs.append([key, []]); return pairs[-1][1]
    return None
def mapping(cfg, make=False):
    node = cfg
    for k in ("InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"):
        node = child(node, k, make)
        if node is None:
            return None
    return node
def mapped(m, app):
    e = child(m, app) if m is not None else None
    return next((v for k, v in (e or []) if k == "name"), "")

cfg = parse(open(CFG, errors="replace").read()) if os.path.exists(CFG) else []
m = mapping(cfg)
if mode == "uploads-since":
    for app, res in uploads:
        print(f"cloud: {name(app)} ({app}) upload " + ("OK" if res == "OK" else f"failed: {res}"))
    sys.exit(0)
if mode == "status":
    bad = 0
    apps = sorted(set(last) | skipped, key=int)
    if not apps:
        print("no game has used Steam Cloud yet (Steam's cloud_log.txt names none)")
    for app in apps:
        parts = []
        if app in last:
            when, res = last[app]
            reset = max((time.mktime(time.strptime(f.rsplit("-", 2)[-2] + f.rsplit("-", 1)[-1], "%Y%m%d%H%M%S"))   # (when the fix moved it: its name)
                         for f in glob.glob(os.path.join(root, f"userdata/*/{app}/remotecache.vdf.fedokawaii-*"))), default=0)
            if res == "OK":
                parts.append(f"last upload {when}: OK")
            elif reset > time.mktime(time.strptime(when, "%Y-%m-%d %H:%M:%S")):
                parts.append(f"last upload {when}: failed ({res}), before --cloud-fix started its sync afresh — the game's next run uploads again")
            else:
                parts.append(f"last upload {when}: FAILED ({res})"); bad = 1
        tool = mapped(m, app)
        if app in skipped:
            if tool:
                parts.append(f"its cloud saves are Windows' — it runs with {tool}, so it uses them")
            else:
                parts.append("its cloud saves were made on Windows and it runs here as its Linux build: they never cross (kawa-steam --cloud-fix, with Steam closed)")
                bad = 1
        print(f"{name(app)} ({app}): " + " · ".join(parts))
    sys.exit(bad)
# fix
done = set(open(statef).read().split()) if os.path.exists(statef) else set()
ge = sorted((os.path.basename(d) for d in glob.glob(os.path.join(root, "compatibilitytools.d/GE-Proton*")) if os.path.isdir(d)),
            key=lambda n: [int(x) for x in re.findall(r"\d+", n)])
if not ge:
    if skipped - done:
        print("cloud: no GE-Proton in Steam's compatibilitytools.d — nothing set (fedokawaii update fetches it)")
    sys.exit(0)
newest, changed = ge[-1], []
for app in sorted(skipped - done, key=int):
    if mapped(m, app):
        continue                                   # (a Proton the user chose: kept)
    m = mapping(cfg, True)
    e = child(m, app, True); e[:] = [["name", newest], ["config", ""], ["priority", "250"]]
    for rc in glob.glob(os.path.join(root, f"userdata/*/{app}/remotecache.vdf")):
        os.replace(rc, rc + ".fedokawaii-" + time.strftime("%Y%m%d-%H%M%S"))
    done.add(app)
    changed.append(f"cloud: {name(app)} ({app}) keeps its cloud saves in Windows' folders — set to run with {newest}, its sync state started afresh (Steam compares with the cloud at its next start)")
for app in sorted(done, key=int):                  # (a GE-Proton update retired: the newest)
    t = mapped(m, app)
    if t.startswith("GE-Proton") and t not in ge:
        e = child(m, app); e[:] = [["name", newest], ["config", ""], ["priority", "250"]]
        changed.append(f"cloud: {name(app)} ({app}) moved from {t} (gone) to {newest}")
if changed:
    tmp = CFG + ".fedokawaii-tmp"
    with open(tmp, "w") as f:
        f.write(dump(cfg))
    os.replace(tmp, CFG)
    os.makedirs(os.path.dirname(statef), exist_ok=True)
    with open(statef, "w") as f:
        f.write("\n".join(sorted(done, key=int)) + "\n")
for c in changed:
    print(c)
PY
}
case ${1:-} in
  --quit)
    running || exit 0
    why=${2:-asked}; t0=${EPOCHREALTIME/[.,]/}
    id=$(notify-send -a desktop -p -t 0 -- "$ICON_GAMEPAD  Steam" "closing — your saves go to Steam Cloud first" 2>/dev/null)
    say "asking Steam to quit ($why): it sends your saves to Steam Cloud first"
    timeout 10 steam -shutdown </dev/null >/dev/null 2>&1
    for ((t = 0; t < ${KAWA_STEAM_QUIT_WAIT:-20} * 10; t++)); do running || break; sleep 0.1; done
    d=$(( ${EPOCHREALTIME/[.,]/} - t0 )); took=$((d / 1000000)).$((d / 100000 % 10))   # (µs → "3.4")
    [[ -n $id ]] && makoctl dismiss -n "$id" 2>/dev/null
    if running; then say "Steam still runs ${KAWA_STEAM_QUIT_WAIT:-20} s after it was asked to quit ($why) — left as it is"; exit 1; fi
    say "asked Steam to quit ($why), done in $took s"
    # what Steam uploaded while it closed (its log's lines since the ask), then the fix
    while IFS= read -r l; do say "$l"; done < <(cloud uploads-since "$t0")
    while IFS= read -r l; do say "$l"; done < <(cloud fix)
    exit 0 ;;
  --cloud) cloud status; exit ;;
  --cloud-fix)
    running && { echo "kawa-steam: Steam runs — its settings are written only while it is closed (kawa-steam --quit)" >&2; exit 1; }
    while IFS= read -r l; do say "$l"; echo "$l"; done < <(cloud fix)
    exit 0 ;;
  --guard)
    command -v steam >/dev/null || exit 0
    exec systemd-inhibit --what=shutdown --mode=delay --who=Steam \
      --why="Steam sends your saves to Steam Cloud before the computer stops" "$0" --guard-wait ;;
  --guard-wait)                                  # (--guard's own half, under its lock)
    # the monitor in a process group of its own (setsid: the same pid), ended with all it
    # started however the wait ends — the warning, a logout's signal, the monitor gone
    exec {bus}< <(exec setsid gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1 2>/dev/null)
    mon=$!
    trap 'kill -- -"$mon" 2>/dev/null; kill "$mon" 2>/dev/null' EXIT
    trap 'exit 0' TERM HUP INT
    while IFS= read -r -u "$bus" l; do
      [[ $l == *PrepareForShutdown*'(true'* ]] || continue
      "$0" --quit shutdown
      break
    done
    exit 0 ;;
  --bar-watch)
    # the bar's gamepad, long-running (waybar's restart-interval): the same states as --bar,
    # read straight from /proc by bash alone — Steam's pid from ~/.steampid, its children for
    # its web helper and a game (SteamLaunch) — so no process is started, Steam open or not;
    # a look every 3 s, at once when a dropdown opens or closes (kawa-bar's wake fifo: lit)
    . "${BASH_SOURCE[0]%/*}/kawa-bar"                 # bar_lit, lit_json's rules (bash alone)
    wake=${XDG_RUNTIME_DIR:?}/kawa-bar.wake.$$
    mkfifo -m 600 -- "$wake" && exec {quiet}<>"$wake" || exit 1
    trap 'rm -f -- "$wake"' EXIT
    trap 'exit 0' TERM HUP INT PIPE
    kids() {   # kids PID — its children, on one line (CONFIG_PROC_CHILDREN: each thread's)
      local t k all=""
      for t in /proc/"$1"/task/*/children; do k=""; read -r k 2>/dev/null <"$t"; [[ -n $k ]] && all+=" $k"; done   # (no newline at its end: read says 1, the line read all the same)
      printf -v KIDS '%s' "$all"
    }
    last="" gm=""
    while :; do
      st=off pid="" c=""
      read -r pid 2>/dev/null <"$HOME/.steampid"
      if [[ $pid =~ ^[0-9]+$ ]] && read -r c 2>/dev/null <"/proc/$pid/comm" && [[ $c == steam ]]; then
        # (the whole tree, not only Steam's own children: its web helper runs inside the
        # Steam Runtime's container — steamwebhelper.sh, srt-bwrap… between them — so a
        # look at the first level alone said "starting" for as long as Steam ran)
        st=starting; KIDS=""; kids "$pid"; tree=$KIDS d=0
        while [[ -n $KIDS ]] && ((++d < 6)); do n=""; for k in $KIDS; do kids "$k"; n+=$KIDS; done; KIDS=$n; tree+=$n; done
        for k in $tree; do
          read -r c 2>/dev/null <"/proc/$k/comm" || continue
          [[ $c == steamwebhelper && $st == starting ]] && st=ready
          if [[ $c == reaper ]]; then
            l=""
            while IFS= read -r -d '' a; do l+=" $a"; done 2>/dev/null </proc/"$k"/cmdline
            [[ $l == *'SteamLaunch AppId='* ]] && { st=game; break; }
          fi
        done
      fi
      # game mode for every Steam game, Windows ones through Proton too, with no launch option
      # (kawa-game): started once a game (its reaper: it lives as long as the game), ended when
      # no game is left — read from kawa-game's record by bash alone, no process meanwhile
      gr=""; read -r gw gr 2>/dev/null <"$XDG_RUNTIME_DIR/kawa-game.on" || gw=""
      if [[ $st == game && $k != "$gm" ]]; then gm=$k; kawa-game start steam "$k" &
      elif [[ $st != game && $gw == steam ]] || [[ $gw == run && ! -e /proc/$gr ]]; then
        gm=""; kawa-game end &
      fi
      case $st in
        off)      out='{"text":""}' ;;
        game)     out="{\"text\":\"$ICON_GAMEPAD\",\"class\":\"game\",\"tooltip\":\"Steam · in game\"}" ;;
        ready)    out="{\"text\":\"$ICON_GAMEPAD\",\"class\":\"ready\",\"tooltip\":\"Steam\"}" ;;
        starting) out="{\"text\":\"$ICON_GAMEPAD\",\"class\":\"starting\",\"tooltip\":\"Steam starting\"}" ;;
      esac
      if [[ $st != off ]] && bar_lit steam; then out=${out%%,\"tooltip\"*}; out="${out/\"class\":\"$st\"/\"class\":[\"$st\",\"active\"]}}"; fi
      [[ $out != "$last" ]] && { printf '%s\n' "$out" || exit 0; last=$out; }
      read -r -t 3 -u "$quiet" _
      while read -r -t 0 -u "$quiet" && read -r -u "$quiet" _; do :; done   # (wakes heaped up: one look)
    done ;;
  --bar)
    if ! running; then echo '{"text":""}'
    elif ingame; then printf '{"text":"%s","class":"game","tooltip":"Steam · in game"}\n' "$ICON_GAMEPAD"
    elif ready; then printf '{"text":"%s","class":"ready","tooltip":"Steam"}\n' "$ICON_GAMEPAD"
    else printf '{"text":"%s","class":"starting","tooltip":"Steam starting"}\n' "$ICON_GAMEPAD"; fi
    exit 0 ;;
  --warm)
    command -v steam >/dev/null && warm_on || exit 0
    sleep 60
    running && exit 0
    # -silent: no window, a minute into the session (in a scope of its own). No lower priority:
    # the games Steam starts are its children and would inherit it (and a scope takes no
    # Nice= or IOSchedulingClass= — systemd-run refuses them). 25 s to stop, not the 10 s of the
    # rest of yours: Steam sends your games' saves to Steam Cloud as it closes
    setsid -f systemd-run --user --scope --quiet -p TimeoutStopSec=25s -- steam -silent </dev/null >/dev/null 2>&1
    exit 0 ;;
  --menu)
    command -v steam >/dev/null || exit 1
    # in the panel's line format (kawa-menu; docs/design-system.md): 遊 Steam (遊, play), a
    # row a page of Steam's, the start with the desktop as a check (▣ on, □ off), quit
    c=□; warm_on && c=▣
    rows=()
    line() { local IFS=$'\t'; rows+=("$*"); }
    line part 遊 Steam
    line row "$ICON_FOLDER" library
    line row "$ICON_DOWNLOAD" downloads
    line row "$ICON_USER" friends
    line row "$ICON_SLIDERS" settings
    line row "$c" "start with the desktop"
    line row "$ICON_POWER" "quit Steam"
    i=$(printf '%s\n' "${rows[@]}" | kawa-menu --drop --index --select 1) || exit 0
    case $i in
      1) exec steam steam://open/games ;;
      2) exec steam steam://open/downloads ;;
      3) exec steam steam://open/friends ;;
      4) exec steam steam://open/settings ;;
      5) mkdir -p "${WARM%/*}"; if warm_on; then echo no >"$WARM"; else echo yes >"$WARM"; fi
         notify-send -a desktop -- "$ICON_GAMEPAD  Steam" "start with the desktop: $(warm_on && echo on || echo off)" ;;
      6) exec "$0" --quit menu ;;
    esac
    exit 0 ;;
esac

# the window
command -v steam >/dev/null || { notify-send -a desktop -- "$ICON_GAMEPAD  Steam" "Steam is not installed (STEAM=yes in fedokawaii settings, then update)"; exit 1; }
link=${1:-steam://open/main}
if running; then
  # (Steam hands the request to the running one, which brings its window up)
  setsid -f steam "$link" </dev/null >/dev/null 2>&1; exit 0
fi
first=0; [[ -x $HOME/.local/share/Steam/ubuntu12_32/steam ]] || first=1
if ((first)); then msg="updating itself — its very first start takes a few minutes"
else msg="starting"; fi
id=$(notify-send -a desktop -p -t 0 -- "$ICON_GAMEPAD  Steam" "$msg" 2>/dev/null)
setsid -f steam ${1:+"$1"} </dev/null >/dev/null 2>&1
# the notice goes once Steam's window process is up (or after 10 minutes, whatever happened)
for ((t = 0; t < 600; t++)); do ready && break; sleep 1; done
[[ -n $id ]] && makoctl dismiss -n "$id" 2>/dev/null
exit 0
