#!/usr/bin/python3 -IB
"""kawa-typing — touch typing, finger by finger, to 100 words a minute and past it: a terminal program, the
keyboard and the hands drawn in the terminal itself (Super+U, learning → typing).

    kawa-typing            the course: goes on where you stopped
    kawa-typing FILE       types a file of your own (code, notes, anything)
    kawa-typing --course   the lessons, as a table

Everything it keeps: ~/.local/state/fedokawaii/typing. The method and its sources: docs/learn/typing/.
"""
import os
import sys

sys.path.insert(0, os.path.expanduser('~/.local/lib/fedokawaii'))
here = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(here, 'configs/home/.local/lib/fedokawaii'))      # (from the repository: tests, the kit)
from kawatype.app import main   # noqa: E402

sys.exit(main(sys.argv[1:]))
