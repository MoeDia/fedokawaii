#!/usr/bin/env bash
# kawa-sketch — draw: FireAlpaca, the official Linux build, on a new sketch, with the drawing tablet's
# pen (its pressure makes the line) or the mouse, dressed as the desktop (src/kawa-firealpaca; its
# sheet and inks are the theme's, and it follows the theme while it runs). ("Sketch" in the launcher.)
#
#   kawa-sketch          a new sketch: ~/Pictures/Sketches/sketch 2026-10-17 21.40.mdp
#   kawa-sketch FILE     FILE in it: Enter on a .mdp in yazi, or a picture to work on. It is one
#                        program: while it runs, a file opens in the one running, in a tab of its own
#
# A sketch is FireAlpaca's own file (.mdp: every layer kept), saved with Ctrl+S; File → Export makes
# a PNG or a PSD to send. It takes no file on its command line and writes X11 only: the library is what
# hands it the file (KAWA_FA_OPEN, or $XDG_RUNTIME_DIR/kawa-firealpaca.open while it runs).
# KAWA_FA_PLAIN=1: FireAlpaca as it comes.
# Exit: 0 started · 1 it could not (said) · 2 wrong use.
set -u
case ${1:-} in
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  -*) echo "usage: kawa-sketch [FILE]   (no FILE: a new sketch in ~/Pictures/Sketches)" >&2; exit 2 ;;
esac
(($# <= 1)) || { echo "usage: kawa-sketch [FILE]   (no FILE: a new sketch in ~/Pictures/Sketches)" >&2; exit 2; }
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/files.sh"            # free_name
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
share=$HOME/.local/share/fedokawaii/firealpaca
app=$share/app/usr/bin/FireAlpaca
[[ -x $app ]] || { notify-send -a desktop -u critical -- "$ICON_NOTE  sketch" "FireAlpaca is missing — fedokawaii repair puts it back"; exit 1; }
if (($#)); then
  f=$(realpath -- "$1") || exit 1
  [[ -f $f ]] || { notify-send -a desktop -- "$ICON_NOTE  sketch" "no such file: $1"; exit 1; }
else
  dir=$HOME/Pictures/Sketches
  mkdir -p "$dir" || { notify-send -a desktop -- "$ICON_NOTE  sketch" "cannot make $dir"; exit 1; }
  printf -v name 'sketch %(%Y-%m-%d %H.%M)T' -1
  f=$(free_name "$dir/$name.mdp")                # (a second in the same minute: "… (1).mdp")
  cp -- "$share/blank.mdp" "$f" \
    || { rm -f -- "$f"; notify-send -a desktop -- "$ICON_NOTE  sketch" "could not write $f (is the disk full?)"; exit 1; }
fi
if pgrep -u "$(id -u)" -x FireAlpaca >/dev/null; then
  # (one running: it is asked, in one step, so it never reads half a name)
  req=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/kawa-firealpaca.open
  printf '%s\n' "$f" >"$req.new" && mv -f -- "$req.new" "$req"
  exit
fi
setsid -f env -u QT_QPA_PLATFORMTHEME -u QT_STYLE_OVERRIDE QT_QPA_PLATFORM=xcb KAWA_FA_OPEN="$f" \
  LD_PRELOAD="$HOME/.local/lib/fedokawaii/kawa-firealpaca.so" "$app" >/dev/null 2>&1 </dev/null
