#!/usr/bin/env bash
# kawa-screenshot [region|full|edit] — grim + slurp, copied to clipboard and
# saved to ~/Pictures/Screenshots. "edit" opens the capture in satty for annotation.
#
# Exit: 0 done (or Esc while picking the region) · 1 could not (a notice says why) · 2 wrong use.
set -u
# ImageMagick reads format names and options case-blind by the locale: in Turkish, "tile:"
# and -resize lose their "i" (kawa-sixel, kawa-clip and kawa-books do the same)
magick() { LC_ALL=C command magick "$@"; }
case ${1:-} in -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;; esac
mode=${1:-region}
case $mode in region|full|edit) ;; *) echo "usage: kawa-screenshot [region|full|edit] (kawa-screenshot --help)" >&2; exit 2 ;; esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/current/colors.sh"
# the region picker: everything outside the selection dimmed with ink (on either theme a
# selection reads as the lit part), the selection edged and faintly washed in vermilion
pick() { slurp -b '#0f0e0c66' -c "#${C_ACCENT}ff" -s "#${C_ACCENT}22" -w 2; }
fail() {   # fail TITLE BODY — a key press that gave no picture says why (it has no terminal)
  notify-send -a desktop -u critical "$ICON_CAMERA  $1" "$2"
  echo "kawa-screenshot: $1 — $2" >&2; exit 1
}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}
[[ -d $XDG_RUNTIME_DIR && -w $XDG_RUNTIME_DIR ]] \
  || { echo "kawa-screenshot: no runtime folder $XDG_RUNTIME_DIR (not logged in to the desktop?)" >&2; exit 1; }
# one at a time: dwl repeats a held key, which would stack region pickers
exec 9>"$XDG_RUNTIME_DIR/kawa-screenshot.lock"; flock -n 9 || exit 0
# the folder first: no region is asked for a shot that could not be kept
mkdir -p "$SCREENSHOT_DIR" 2>/dev/null && [[ -w $SCREENSHOT_DIR ]] \
  || fail "Screenshot not saved" "${SCREENSHOT_DIR/#"$HOME"/\~} cannot be written to"
# satty comes from GitHub (an install made offline may lack it): the shot is kept anyway
note=""
[[ $mode == edit ]] && ! command -v satty >/dev/null && mode=region note=" · not annotated: satty is missing"
base="$SCREENSHOT_DIR/$(date +%Y-%m-%d_%H-%M-%S)" file=$base.png n=2
while [[ -e $file ]]; do file=$base-$((n++)).png; done   # two in one second: -2, -3…

case "$mode" in
  full)
    grim "$file" 2>/dev/null || { rm -f "$file"; fail "Screenshot failed" "grim could not capture the screen"; } ;;
  region)
    geom=$(pick) || exit 0
    grim -g "$geom" "$file" 2>/dev/null || { rm -f "$file"; fail "Screenshot failed" "grim could not capture the screen"; } ;;
  edit)
    geom=$(pick) || exit 0
    exec 9>&-                                       # annotating may take a while: free the keys
    grim -g "$geom" - | satty --filename - --output-filename "$file"   # rest: ~/.config/satty/config.toml
    exit 0 ;;
esac

title="Screenshot copied"                       # (no clipboard helper: it is saved all the same)
wl-copy --type image/png <"$file" 9>&- 2>/dev/null || title="Screenshot saved"   # (it stays to serve the copy: never with the lock)
# the notice shows a square middle cut of the picture: a wide or tall capture scaled whole
# into the 32 px icon would be a sliver, and every notice's text starts at the same place
thumb=$XDG_RUNTIME_DIR/kawa-screenshot-icon.png
magick "$file" -resize '64x64^' -gravity center -extent 64x64 "$thumb" 2>/dev/null || thumb=$file
notify-send -a desktop -i "$thumb" "$ICON_CAMERA  $title" "${file##*/}$note"
