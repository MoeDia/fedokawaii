#!/usr/bin/env bash
# kawa-screenshot [region|full|edit|text] — grim + slurp, copied to clipboard and
# saved to ~/Pictures/Screenshots. "edit" opens the capture in satty for annotation.
# "text" reads the region's words instead (tesseract, English and Arabic): the text goes on
# the clipboard, its first words in the notice; nothing is saved.
#
# Exit: 0 done (or Esc while picking the region) · 1 could not (a notice says why) · 2 wrong use.
set -u
# ImageMagick reads format names and options case-blind by the locale: in Turkish, "tile:"
# and -resize lose their "i" (kawa-sixel, kawa-clip and kawa-books do the same)
magick() { LC_ALL=C command magick "$@"; }
case ${1:-} in -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;; esac
mode=${1:-region}
case $mode in region|full|edit|text) ;; *) echo "usage: kawa-screenshot [region|full|edit|text] (kawa-screenshot --help)" >&2; exit 2 ;; esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/current/colors.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/files.sh"   # clip_put
# the region picker: everything outside the selection dimmed with ink (on either theme a
# selection reads as the lit part), the selection edged and faintly washed in vermilion
# (this run's pid in kawa-screenshot.picking while it is up, slurp's in kawa-screenshot.pick:
# the key again takes it away, below). Then the shot is taken one at a time (the run lock)
pick() {
  local p r o=""
  slurp -b '#18171566' -c "#${C_ACCENT}ff" -s "#${C_ACCENT}22" -w 2 7>&- 9>&- & p=$!
  echo "$p" >"$RT/kawa-screenshot.pick"
  read -r o 2>/dev/null <"$RT/kawa-screenshot.picking"
  [[ $o == "$$" ]] || kill "$p" 2>/dev/null       # (the key again came before slurp was named)
  wait "$p"; r=$?
  flock 7; o=""; read -r o 2>/dev/null <"$RT/kawa-screenshot.picking"
  if [[ $o == "$$" ]]; then rm -f "$RT/kawa-screenshot.picking"; else r=1; fi
  o=""; read -r o 2>/dev/null <"$RT/kawa-screenshot.pick"; [[ $o == "$p" ]] && rm -f "$RT/kawa-screenshot.pick"
  flock -u 7
  ((r == 0)) && flock -w 10 9 && return 0
  return 1
}
fail() {   # fail TITLE BODY — a key press that gave no picture says why (it has no terminal)
  notify-send -a desktop -u critical -- "$ICON_CAMERA  $1" "$2"
  echo "kawa-screenshot: $1 — $2" >&2; exit 1
}
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}
[[ -d $XDG_RUNTIME_DIR && -w $XDG_RUNTIME_DIR ]] \
  || { echo "kawa-screenshot: no runtime folder $XDG_RUNTIME_DIR (not logged in to the desktop?)" >&2; exit 1; }
# The key again while a region is being picked takes the picker away (as Esc does): every press
# counts, however fast — two presses, no picker; three, one. While a shot is being taken and
# saved (the run lock), a press does nothing. Decided under a lock held a moment each time
RT=$XDG_RUNTIME_DIR
exec 7>"$RT/kawa-screenshot.state" 9>"$RT/kawa-screenshot.lock"
flock 7 || exit 1
o=""; read -r o 2>/dev/null <"$RT/kawa-screenshot.picking"
if [[ $o =~ ^[1-9][0-9]*$ ]] && kill -0 "$o" 2>/dev/null; then
  rm -f "$RT/kawa-screenshot.picking"
  p=""; read -r p 2>/dev/null <"$RT/kawa-screenshot.pick" && [[ $p =~ ^[1-9][0-9]*$ ]] && kill "$p" 2>/dev/null
  exit 0
fi
flock -n 9 || exit 0                              # (a shot being saved)
if [[ $mode == full ]]; then flock -u 7            # (no region: the shot at once, the run lock kept)
else echo "$$" >"$RT/kawa-screenshot.picking"; flock -u 9; flock -u 7; fi
# text: the region taken at twice the screen's size (grim -s 2: small screen text reads far
# better so), read by tesseract — English first, Arabic too — and only its words kept
if [[ $mode == text ]]; then
  command -v tesseract >/dev/null || fail "text not read" "tesseract is not installed — fedokawaii repair puts it back"
  geom=$(pick) || exit 0
  shot=$XDG_RUNTIME_DIR/kawa-screenshot-text.png
  grim -s 2 -g "$geom" "$shot" 2>/dev/null || { rm -f "$shot"; fail "text not read" "grim could not capture the screen"; }
  txt=$(tesseract "$shot" - -l eng+ara --dpi 192 2>/dev/null); r=$?
  rm -f "$shot"
  ((r == 0)) || fail "text not read" "tesseract could not read the region"
  txt=${txt//$'\f'/}                                  # (its page break)
  read -ra w <<<"$(tr -s '[:space:]' ' ' <<<"$txt")"
  ((${#w[@]})) || { notify-send -a desktop -- "$ICON_CLIPBOARD  no text found" "nothing to read in that region"; exit 0; }
  printf '%s\n' "$txt" | clip_put 'text/plain;charset=utf-8' 9>&- 2>/dev/null \
    || fail "text not copied" "the clipboard did not take it"
  first=""                                             # the first words, 48 columns at most
  for x in "${w[@]}"; do ((${#first} + ${#x} + 1 <= 48)) || break; first+=${first:+ }$x; done
  ((${#w[@]} == 1)) && n="1 word" || n="${#w[@]} words"
  notify-send -a desktop -- "$ICON_CLIPBOARD  text copied · $n" "${first:-${w[0]:0:48}}"
  exit 0
fi
# the folder first: no region is asked for a shot that could not be kept
mkdir -p "$SCREENSHOT_DIR" 2>/dev/null && [[ -w $SCREENSHOT_DIR ]] \
  || fail "screenshot not saved" "${SCREENSHOT_DIR/#"$HOME"/\~} cannot be written to"
# satty comes from GitHub (an install made offline may lack it): the shot is kept anyway
note=""
[[ $mode == edit ]] && ! command -v satty >/dev/null && mode=region note=" · not annotated: satty is missing"
base="$SCREENSHOT_DIR/$(date +%Y-%m-%d_%H-%M-%S)" file=$base.png n=2
while [[ -e $file ]]; do file=$base-$((n++)).png; done   # two in one second: -2, -3…

case "$mode" in
  full)
    grim "$file" 2>/dev/null || { rm -f "$file"; fail "screenshot failed" "grim could not capture the screen"; } ;;
  region)
    geom=$(pick) || exit 0
    grim -g "$geom" "$file" 2>/dev/null || { rm -f "$file"; fail "screenshot failed" "grim could not capture the screen"; } ;;
  edit)
    geom=$(pick) || exit 0
    exec 9>&-                                       # annotating may take a while: free the keys
    grim -g "$geom" - | satty --filename - --output-filename "$file"   # rest: ~/.config/satty/config.toml
    exit 0 ;;
esac

title="screenshot copied"                       # (no clipboard helper: it is saved all the same)
clip_put image/png <"$file" 9>&- 2>/dev/null || title="screenshot saved"   # (it stays to serve the copy: never with the lock)
# the notice shows a square middle cut of the picture: a wide or tall capture scaled whole
# into the 32 px icon would be a sliver, and every notice's text starts at the same place
thumb=$XDG_RUNTIME_DIR/kawa-screenshot-icon.png
magick "$file" -resize '64x64^' -gravity center -extent 64x64 "$thumb" 2>/dev/null || thumb=$file
notify-send -a desktop -i "$thumb" -- "$title" "${file##*/}$note"   # (the picture is its icon: no second one)
