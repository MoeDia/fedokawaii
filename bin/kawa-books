#!/usr/bin/env bash
# kawa-books — Super+R: your books in a small floating terminal. Every PDF, EPUB, MOBI,
# FB2, XPS and comic book (CBZ, CBR, CB7) in ~/Books, the ones you are reading first:
# each with how far in you are — the page zathura remembered when you last closed it,
# a bar, and the page count where the file has one (EPUBs flow their pages to the window,
# so for those it is the page alone). The cover of the one under the cursor shows beside.
#
#   Enter     read it in zathura (it opens where you stopped)
#   Ctrl+A    add books: the ones in ~/Downloads and ~/Documents — Tab marks
#             several, Enter moves them into ~/Books, Esc goes back
#   Ctrl+D    remove it: to the trash (yazi: g t), not gone for good
#   Esc       close
#
# The other forms are its own parts: --tui, --rows, --preview PATH INFO…, --open PATH,
# --remove PATH, --add. Covers are drawn once and kept in ~/.cache/kawa-books.
set -u
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/current/colors.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/screen.sh"
BOOKS=${KAWA_BOOKS:-$HOME/Books}
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/kawa-books
# every list of the desktop looks alike: one options file (rules, colours, the chevron)
export FZF_DEFAULT_OPTS_FILE=$HOME/.config/fedokawaii/fzf.opts; unset FZF_DEFAULT_OPTS
DB=${XDG_DATA_HOME:-$HOME/.local/share}/zathura/bookmarks.sqlite
EXT=(pdf epub mobi fb2 xps oxps cbz cbr cb7)
mkdir -p "$BOOKS" "$CACHE" 2>/dev/null       # (a cache that cannot be made: drawn each time)
# ImageMagick reads its format names ("info:", "gif:-") through the locale's letter case:
# in Turkish an i is not an I, and it writes a file called "info:" instead of answering
magick() { LC_ALL=C command magick "$@"; }

# ── the list: one python pass over ~/Books and zathura's memory (read-only) ────────────
# path<TAB>row<TAB>info line 1<TAB>info line 2<TAB>page — the row is what you see and
# search; the two info lines go under the cover; the page is set only for a book zathura
# knew under another path (Enter opens it there). Page counts are kept in pages.json (by
# size and time).
read -r -d '' ROWS <<'PY' || true
import calendar, json, os, sqlite3, subprocess, sys, time, unicodedata, urllib.parse
from concurrent.futures import ThreadPoolExecutor
books, cache, db, width = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
# a name that is not UTF-8 (an old zip's) goes out as the bytes it is, as the path to open
sys.stdout.reconfigure(errors="surrogateescape")
exts = {e: e for e in sys.argv[5:]}; exts["oxps"] = "xps"
IMG = (".jpg", ".jpeg", ".png", ".webp", ".gif")

def cols(s):                       # display width, as foot and fzf count it: CJK and emoji take
    n = w = 0; zwj = False         # two; accents, joiners, skin tones and what a joiner joins
    for c in s:                    # add nothing (👨‍👩‍👧 is two); an emoji selector makes two (❤️)
        o = ord(c)
        if unicodedata.category(c) in ("Mn", "Me", "Cf") or 0x1F3FB <= o <= 0x1F3FF \
           or zwj and unicodedata.category(c) == "So":
            if o == 0xFE0F: w = 2
            zwj = o == 0x200D
            continue
        zwj = False; n += w; w = 2 if unicodedata.east_asian_width(c) in "WF" else 1
    return n + w

def fit(s, w):                     # cut to w columns at a word's end (never "…"), then pad to exactly w
    if cols(s) > w:
        t = s
        while cols(t) > w: t = t[:-1]
        if s[len(t):len(t) + 1] != " " and " " in t.strip(): t = t.rstrip().rsplit(" ", 1)[0]
        s = t.rstrip()
    return s + " " * (w - cols(s))

def pages_of(path, kind):          # None where the file has no fixed pages (EPUB, MOBI, FB2)
    try:
        if kind == "pdf":
            out = subprocess.run(["pdfinfo", path], capture_output=True, text=True, timeout=10).stdout
            for line in out.splitlines():
                if line.startswith("Pages:"): return int(line.split()[1])
        elif kind in ("cbz", "cbr", "cb7"):
            # a RAR comic: unrar (RPM Fusion's; Fedora's 7-Zip reads no RAR) · zip and 7z ones (a .cbr is
            # often a zip renamed): 7z, the archive tool of the manifest
            if open(path, "rb").read(4) == b"Rar!":
                out = subprocess.run(["unrar", "lb", "-p-", "--", path], capture_output=True, text=True, timeout=20).stdout
                return sum(1 for l in out.splitlines() if l.lower().endswith(IMG)) or None
            out = subprocess.run(["7z", "l", "-ba", "-slt", "--", path], capture_output=True, text=True, timeout=20).stdout
            return sum(1 for l in out.splitlines() if l.startswith("Path = ") and l.lower().endswith(IMG)) or None
    except Exception:
        return None
    return None

found = []
for root, dirs, files in os.walk(books):
    dirs[:] = sorted(d for d in dirs if not d.startswith("."))
    for f in files:
        kind = exts.get(f.rsplit(".", 1)[-1].lower()) if "." in f else None
        if kind and not f.startswith(".") and "\t" not in f and "\n" not in f:
            found.append((os.path.join(root, f), kind))

try:
    known = json.load(open(os.path.join(cache, "pages.json")))
except Exception:
    known = {}
fresh, todo = {}, []
for path, kind in found:
    try:
        st = os.stat(path)        # (a dead link, or a book moved while the list was made)
    except OSError:
        continue
    k = known.get(path)
    if k and k[0] == st.st_size and k[1] == int(st.st_mtime):
        fresh[path] = k
    else:
        fresh[path] = [st.st_size, int(st.st_mtime), None]; todo.append((path, kind))
# a library seen for the first time: its books counted a few at once (each is a program run)
with ThreadPoolExecutor(max_workers=min(8, os.cpu_count() or 2)) as pool:
    for (path, kind), n in zip(todo, pool.map(lambda pk: pages_of(*pk), todo)):
        fresh[path][2] = n
if fresh != known:
    tmp = os.path.join(cache, f"pages.json.{os.getpid()}")
    try:                          # (a full disk: counted again next time, the list still shown)
        with open(tmp, "w") as f: json.dump(fresh, f)
        os.replace(tmp, os.path.join(cache, "pages.json"))
    except OSError:
        try: os.remove(tmp)
        except OSError: pass

# zathura's memory: the page (from 0) and when, by the file's real path — or, for a book
# moved since, by its name
read, by_name = {}, {}
try:
    con = sqlite3.connect(f"file:{urllib.parse.quote(db)}?mode=ro", uri=True, timeout=1)
    for file, page, when in con.execute("SELECT file, page, time FROM fileinfo"):
        try:
            t = calendar.timegm(time.strptime(when, "%Y-%m-%d %H:%M:%S"))   # (zathura writes UTC)
        except Exception:
            t = 0
        read[file] = (page or 0, t, False)
        b = os.path.basename(file)
        if b not in by_name or by_name[b][1] < t: by_name[b] = (page or 0, t, True)
    con.close()
except Exception:
    pass

def ago(t):
    d = time.time() - t
    if d < 86400: return "today"
    if d < 2 * 86400: return "yesterday"
    if d < 14 * 86400: return f"{int(d // 86400)} days ago"
    if d < 60 * 86400: return f"{int(d // (7 * 86400))} weeks ago"
    return time.strftime("%d %b %Y", time.localtime(t))

def size(n):
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024 or u == "GB": return f"{n:.0f} {u}" if u == "B" else f"{n:.1f} {u}"
        n /= 1024

# screen.sh's inks (foot's colours past the sixteen): accent_text, muted, edge2, the words' own
K, G, E, O = "\033[38;5;20m", "\033[38;5;21m", "\033[38;5;19m", "\033[0m"
glyph = f" {G}{os.environ['ICON_BOOK']}{O}  "       # (a row, §7: a column in, the glyph, two columns)
LIT, OFF = os.environ["ICON_READ"], os.environ["ICON_READ_OFF"]   # (a tenth each: solid, hollow)
rows = []
for path, kind in found:
    if path not in fresh:
        continue
    sz, mt, pages = fresh[path]
    seen = read.get(os.path.realpath(path)) or by_name.get(os.path.basename(path))
    title = os.path.splitext(os.path.basename(path))[0].replace("_", " ")
    tw = width - 4 - 2 - 10 - 2 - 9            # (the row: glyph 4 · title · 2 · meter 10 · 2 · mark 9)
    if seen:
        page = seen[0] + 1
        done = bool(pages) and page >= pages
        # the meter: how much is read, in tenths — at least one once begun (a book without a
        # page count shows just that one: begun, how far unknown); a done book's all ten, muted
        n = 10 if done else max(round(10 * page / pages) if pages else 1, 1)
        bar = (G if done else K) + LIT * n + E + OFF * (10 - n) + O
        # where you are, one way for every book: "87/120" — "37/–" where the book has no
        # fixed pages (an EPUB's depend on the window); "done"
        mark = "done" if done else (f"{page}/{pages}" if pages else f"{page}/–")
        info1 = f"read {ago(seen[1])}"         # (the page, and whether it is done: the list's)
        color, key = (G if done else O), (1, seen[1])
        goto = str(page) if seen[2] else ""     # (found by name: moved since, so open it there)
    else:
        bar, mark, goto = " " * 10, "new", ""     # (not begun: no meter, the mark says it)
        info1, color, key = "", O, (0, mt)     # (not opened yet: the list's "new" says it)
    # the kind and size, and the page count only where the list's mark does not show it
    # ("87/120" does; "new" and "done" do not)
    shown = "/" in mark
    info2 = f"{kind} · {pages} page{'s' if pages != 1 else ''} · {size(sz)}" if pages and not shown else f"{kind} · {size(sz)}"
    row = f"{glyph}{color}{fit(title, tw)}{O}  {bar}  {G}{mark:>9}{O}"
    # the caption under the cover names the book only when the list had to cut its title
    whole = title if cols(title) > tw else ""
    rows.append((key, f"{path}\t{row}\t{info1}\t{info2}\t{goto}\t{whole}"))
for _, r in sorted(rows, key=lambda x: x[0], reverse=True):
    print(r)
PY

# the list's width: fzf's own (FZF_COLUMNS, inside its margins, as fzf tells every command it
# runs) less the cover pane (36), its rule and padding, and the pointer — so the marks'
# column is right however late the window got its final size (the list is asked for again
# once fzf is up, and whenever the window changes size)
rows() {
  local w=${KAWA_BOOKS_W:-61}   # (the 104-column window)
  [[ ${FZF_COLUMNS:-} =~ ^[0-9]+$ ]] && ((FZF_COLUMNS > 70)) && w=$((FZF_COLUMNS - 41))   # (the cursor's fill a column past the text each side)
  ICON_BOOK=$ICON_BOOK ICON_READ=$ICON_READ ICON_READ_OFF=$ICON_READ_OFF \
    python3 -I -c "$ROWS" "$BOOKS" "$CACHE" "$DB" "$w" "${EXT[@]}"
}

# ── the cover: the first page (PDF, comics), the book's own cover (EPUB) or a plain card ──
cover_source() {   # cover_source PATH OUT.png — the picture a cover is made from
  local f=$1 out=$2 kind=${1##*.}
  case ${kind,,} in
    pdf) pdftoppm -f 1 -l 1 -singlefile -png -scale-to 900 -- "$f" "${out%.png}" 2>/dev/null ;;
    epub) python3 -I - "$f" "$out" 2>/dev/null <<'PY'
import posixpath, re, sys, urllib.parse, zipfile
src, out = sys.argv[1], sys.argv[2]
IMG = (".jpg", ".jpeg", ".png", ".webp", ".gif")
with zipfile.ZipFile(src) as z:
    names = z.namelist(); pick = None
    try:                                               # the cover the book declares
        opf = re.search(r'full-path="([^"]+)"', z.read("META-INF/container.xml").decode()).group(1)
        x = z.read(opf).decode("utf-8", "replace")
        cid = re.search(r'<meta[^>]+name="cover"[^>]+content="([^"]+)"', x) or re.search(r'<meta[^>]+content="([^"]+)"[^>]+name="cover"', x)
        item = None
        if cid: item = re.search(r'<item[^>]+id="%s"[^>]*>' % re.escape(cid.group(1)), x)
        if not item: item = re.search(r'<item[^>]+properties="[^"]*cover-image[^"]*"[^>]*>', x)
        if item:
            href = re.search(r'href="([^"]+)"', item.group(0)).group(1)
            # (an href is a URL: "front%20page.jpg" is the file "front page.jpg")
            pick = posixpath.normpath(posixpath.join(posixpath.dirname(opf), urllib.parse.unquote(href)))
    except Exception:
        pick = None
    if pick not in names:                              # else a picture named like a cover
        pick = next((n for n in names if "cover" in n.lower() and n.lower().endswith(IMG)), None)
    if not pick: sys.exit(1)
    open(out, "wb").write(z.read(pick))
PY
      ;;
    cbz|cbr|cb7)    # the first picture in page order (7z: the manifest's archive tool; a RAR comic: unrar)
      local first
      if [[ $(head -c 4 -- "$f" 2>/dev/null | tr -d '\0') == 'Rar!' ]]; then
        first=$(unrar lb -p- -- "$f" 2>/dev/null | grep -iE '\.(jpe?g|png|webp|gif)$' | LC_ALL=C sort -V | head -n1)
        [[ -n $first ]] || return 1
        unrar p -inul -p- -- "$f" "$first" >"$out" 2>/dev/null
        [[ -s $out ]]; return
      fi
      first=$(7z l -ba -slt -- "$f" 2>/dev/null | sed -n 's/^Path = //p' | grep -iE '\.(jpe?g|png|webp|gif)$' | LC_ALL=C sort -V | head -n1)
      [[ -n $first ]] || return 1
      # (-spd: the name as it is, never a wildcard — p[1].png or q*2.png is that one file)
      7z e -so -spd -- "$f" "$first" >"$out" 2>/dev/null ;;
    *) return 1 ;;
  esac
  [[ -s $out ]]
}

# ── the cover pane: the cover centred, the words under it ────────────────────────────────
# The cover sits as far from the pane's rule as from the pane's right edge, and as far
# below the top rule as the last line of words sits above the pane's foot — equal to the
# pixel. Its left edge is a column's edge, so the words under it start exactly there. To get
# all of that, the cover fills a box of whole columns and of a height that balances, which
# trims at most a few pixels off two opposite edges. It never reaches the pane's last row (a
# picture touching it would scroll the window: fzf #2544).
draw_cover() {   # draw_cover PATH SIX LAY — the picture (sixel) and its layout: "k tr W", title lines
  local f=$1 six=$2 lay=$3 tmp png w0=2 h0=3 card=1 kind=${1##*.} t a b cap dsc gap k w W n hn tr Hc Hb P C j \
        best="" S title
  local -a tl=() btl=()
  # the pane in pixels: foot draws fzf's rule itself (a line t px thick, centred in its
  # cells) and fzf leaves one blank column after it; the pane has that rule on its left
  # only (border-left), so its first row starts at the top of fzf's area (b: no rule above
  # it); the font's letters start 4 px into a 21 px row and its descenders end 2 px above
  # the row's foot
  t=$(( ch >= 42 ? ch / 21 : 1 ))
  a=$(( 2 * cw - (cw - t) / 2 - t ))            # the rule's right edge → the first column
  b=0
  cap=$(( (4 * ch + 10) / 21 )) dsc=$(( (2 * ch + 10) / 21 ))
  gap=$(( (2 * ch + 1) / 3 ))                   # cover → the title's letters (14 px)
  title=$CAP_TITLE                              # (empty: the list shows it whole)
  tmp=$(mktemp "$CACHE/cover.XXXXXX") && mv -f "$tmp" "$tmp.png" && tmp+=.png || return 1
  png=${tmp%.png}.box.png                      # (pdftoppm names its file: NAME.png)
  if cover_source "$f" "$tmp" && read -r w0 h0 < <(magick "${tmp}[0]" -format '%w %h\n' info: 2>/dev/null) \
     && ((w0 > 0 && h0 > 0)); then card=0; else w0=2 h0=3; fi
  # The biggest cover the pane holds. k: columns of margin each side — none (fzf's own blank
  # column after the rule is the margin: 13 px each side, as in every popup), one more each
  # side only while the cover would be taller than the pane leaves it. Its box is the
  # cover's own shape, or trimmed by at most 6 % (top and bottom) to stand that much taller
  # no longer. tr: the title's row — the cover, the title and its two lines are one block
  # in the middle of the pane (above and below it within a row of each other), and neither
  # above nor below it is there less paper than fzf's own margin at its sides (a).
  # The cover is w wide: the pane less k columns each side and less a (the paper between the
  # rule and the first column), so standing k columns in it has as much paper on its right
  # (to the pane's end, where the title's rule ends too) as on its left (to the rule)
  # (a pane too small for any cover trimmed by 6 % at most: then the one trimmed least)
  local keep
  for keep in 94 0; do
  for ((k = 0; ; k++)); do
    w=$(( cols * cw - 2 * k * cw - a ))
    ((w >= 8 * cw)) || break
    j=$k
    W=$(( w / cw ))                             # the words never pass the cover's right edge
    mapfile -t tl < <(python3 -I -c '
import sys, unicodedata
sys.stdout.reconfigure(errors="surrogateescape")
t, w = sys.argv[1], int(sys.argv[2])
def cols(s): return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)
def cut(s, n):                                  # the longest start of s that fits n columns
    while cols(s) > n: s = s[:-1]
    return s
lines, cur = [], ""
for word in t.split():
    cand = cur + " " + word if cur else word
    if cols(cand) <= w: cur = cand; continue
    if cur: lines.append(cur)
    while cols(word) > w:                       # a word longer than a line: broken
        part = cut(word, w); lines.append(part); word = word[len(part):]
    cur = word
if cur: lines.append(cur)
lines = lines or [cut(t, w)]
if len(lines) > 3: lines = lines[:3]            # (three lines at most — a subtitle too: the rest goes, no "…")
print("\n".join(lines))' "$title" "$W" 2>/dev/null)
    [[ -z $title ]] && tl=()
    [[ -n $title && ${#tl[@]} == 0 ]] && tl=("${title:0:W}")
    n=$(( ${#tl[@]} + ${CAP_LINES:-2} ))        # the title's lines (if any) and the lines about it
    hn=$(( w * h0 / w0 ))                       # the cover's own height at this width
    # above the block (from the top rule's lower edge) minus below it (to the pane's foot),
    # for the title in row tr and a box Hc tall: 2·tr·ch + C − Hc
    C=$(( b + cap - gap - (lines - n) * ch - dsc ))
    for ((Hc = hn; Hc * 100 >= hn * keep && Hc >= 2 * ch; Hc--)); do
      tr=$(( (Hc - C + ch) / (2 * ch) ))         # (the nearest balance, rounded)
      ((tr >= 1 && tr + n <= lines)) || continue
      # (and then to the pixel: a box that much shorter, while the trim allows it)
      Hb=$(( 2 * tr * ch + C )); ((Hb < Hc && Hb * 100 >= hn * keep && Hb >= 2 * ch)) && Hc=$Hb
      P=$(( tr * ch + cap - gap - Hc ))
      ((b + P >= a && (lines - tr - n) * ch + dsc >= a)) || continue   # (never nearer the pane's top or foot than its sides)
      best="$k $tr $Hc $P $W $j" btl=("${tl[@]}"); break 3
    done
  done
  done
  [[ -n $best ]] || { rm -f "$tmp" "$png"; return 1; }
  read -r k tr Hc P W j <<<"$best"
  w=$(( cols * cw - 2 * k * cw - a ))
  k=$j                                          # (from here on: the columns the cover stands in)
  S=$(( tr * ch / 6 * 6 ))                      # whole sixel bands, ending in row tr-1
  if ((card)); then                             # no picture in the file: a card, its kind on it
    magick -size "${w}x${Hc}" "xc:#$C_EDGE" -fill none -stroke "#$C_MUTED" -strokewidth 2 \
      -draw "rectangle 1,1 $((w - 2)),$((Hc - 2))" +antialias -stroke none -fill "#$C_MUTED" \
      -font "$(fc-match -f '%{file}' 'Sumi UI')" -pointsize 28 -gravity center \
      -annotate +0+0 "$(LC_ALL=C; printf '%s' "${kind^^}")" "PNG24:$png" 2>/dev/null
  else
    magick "${tmp}[0]" -resize "${w}x${Hc}^" -gravity center -extent "${w}x${Hc}" "PNG24:$png" 2>/dev/null
  fi
  magick -size "$((k * cw + w))x$S" "xc:#$C_GROUND" "$png" -geometry "+$((k * cw))+$P" -composite \
      png:- 2>/dev/null | kawa-sixel "$C_GROUND" >"$six.$$" \
    && { printf '%s %s %s\n' "$k" "$tr" "$W"; ((${#btl[@]} == 0)) || printf '%s\n' "${btl[@]}"; } >"$lay.$$" \
    && mv -f "$six.$$" "$six" && mv -f "$lay.$$" "$lay"
  rm -f "$tmp" "$png" "$six.$$" "$lay.$$"
  [[ -s $six && -s $lay ]]
}

case ${1:-} in
  --rows) rows; exit 0 ;;
  --preview)    # PATH INFO1 INFO2 [TITLE]: the cover, then the title (only when the list cut
                # it), and the lines about the book: when it was read (none: new), its kind and size
    f=${2:-} info1=${3:-} info2=${4:-} CAP_TITLE=${5:-} CAP_LINES=1
    [[ -n $info1 ]] && CAP_LINES=2
    [[ -f $f ]] || exit 0
    cell=${KAWA_CELL:?} cols=${FZF_PREVIEW_COLUMNS:-36} lines=${FZF_PREVIEW_LINES:-26}
    cw=${cell%x*} ch=${cell#*x}
    ((cw > 0 && ch > 0 && cols > 20 && lines > 8)) || exit 0
    key=$(printf '%s\n' p11 "$f" "$(stat -c '%s %Y' -- "$f")" "$cell" "$cols" "$lines" "$C_GROUND" "$CAP_TITLE" "$CAP_LINES" | sha1sum)
    key=${key%% *}; six=$CACHE/$key.six lay=$CACHE/$key.lay
    [[ -s $six && -s $lay ]] || draw_cover "$f" "$six" "$lay" || exit 0
    { read -r k tr W; mapfile -t tl; } <"$lay"
    pad=$(printf '%*s' "$k" '')
    cat "$six"; printf '\n'                    # (the picture leaves the cursor on its last row)
    for t in "${tl[@]}"; do printf '%s%s\n' "$pad" "$t"; done
    [[ -n $info1 ]] && printf '%s%s\n' "$pad" "${info1:0:W}"
    printf '%s%s%s%s' "$pad" "$INK_MUTED" "${info2:0:W}" "$INK_OFF"
    exit 0 ;;
  --open)       # PATH [PAGE]: zathura reopens a book where it was closed; PAGE only for a book
                # it knew under another path (moved since), so it opens there too
    [[ -f ${2:-} ]] || exit 0
    # (the window closes as this runs: a notice is the only way to say so)
    command -v zathura >/dev/null || { notify-send -a desktop -u critical -- "$ICON_BOOK  books" "zathura is missing — fedokawaii repair puts it back" 2>/dev/null; exit 1; }
    if [[ ${3:-} =~ ^[1-9][0-9]*$ ]]; then setsid -f zathura --page="$3" -- "$2" >/dev/null 2>&1 </dev/null
    else setsid -f zathura -- "$2" >/dev/null 2>&1 </dev/null; fi
    exit 0 ;;
  --remove)
    [[ -f ${2:-} ]] || exit 0
    gio trash -- "$2" 2>/dev/null || notify-send -a desktop -- "$ICON_BOOK  books" "could not move ${2##*/} to the trash"
    exit 0 ;;
  --add)        # books elsewhere in your home → ~/Books (moved; a name taken gets " (2)")
    # (the window's 104 columns: rows and heading 100 wide; the picked rows filled, as fzf.opts has it)
    args=(); for e in "${EXT[@]}"; do args+=(-e "$e"); done
    mapfile -t pick < <(fd -t f -i "${args[@]}" . \
        "$HOME/Downloads" "$HOME/Documents" 2>/dev/null \
      | while IFS= read -r p; do [[ $p == "$BOOKS"/* ]] || printf '%s\t %s%s%s  %s\n' "$p" "$INK_MUTED" "$ICON_BOOK" "$INK_OFF" "${p/#"$HOME"/\~}"; done \
      | fzf --ansi --multi --height=100% --delimiter=$'\t' --with-nth=2 \
          --header="$(screen_heading "$ICON_BOOK" "add books" 100)"$'\n ' --ghost='from ~/Downloads ~/Documents' \
          --footer=$'\n'"$(screen_keys tab mark '')" \
      | cut -f1)
    for p in "${pick[@]}"; do
      [[ -f $p ]] || continue
      to=$BOOKS/${p##*/} n=2
      while [[ -e $to ]]; do to="$BOOKS/${p##*/}"; to="${to%.*} ($n).${to##*.}"; n=$((n + 1)); done
      mv -n -- "$p" "$to" || notify-send -a desktop -- "$ICON_BOOK  books" "could not move ${p##*/}"
    done
    exec "$0" --tui ;;
  --tui) ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  "")           # Super+R: the window, once (a second press while it is open does nothing)
    exec kawa-term --float --once books books 104x29 -- "$0" --tui ;;
  *) echo "usage: kawa-books   (Super+R: your books)" >&2; exit 2 ;;
esac

# ── inside the window ─────────────────────────────────────────────────────────
find "$CACHE" -maxdepth 1 \( -name '*.six' -o -name '*.lay' \) -mtime +90 -delete 2>/dev/null   # (covers of long ago)
# and what covers still being drawn when fzf moved on left: fzf kills such a preview outright
# (SIGKILL — no trap runs), mid-way through its picture files
find "$CACHE" -maxdepth 1 \( -name 'cover.*' -o -name '*.six.*' -o -name '*.lay.*' -o -name 'pages.json.*' \) \
  -mmin +1 -delete 2>/dev/null
KAWA_CELL=$(kawa-cell) || exit 1
read -r _ c < <(stty size 2>/dev/null); [[ ${c:-} =~ ^[0-9]+$ ]] && ((c > 70)) || c=104   # (the window kawa-term --float opens: 104 columns)
KAWA_BOOKS_W=$((c - 43))   # (fzf's width is the window's less its margins: as FZF_COLUMNS - 41)
export KAWA_CELL KAWA_BOOKS_W
mapfile -t list < <(rows)
# A text screen (docs/design-system.md §7, screen.sh): the heading — its icon, books, the rule
# over the list's width — the search line, whose empty field says where they are, the list (each
# row its glyph, the title, how far it is read), the cover pane, its own keys
head="$(screen_heading "$ICON_BOOK" books "$KAWA_BOOKS_W")"$'\n '
# shellcheck disable=SC2088  # (words on the screen, not a path)
if ((${#list[@]})); then ghost='~/Books'; else ghost='none in ~/Books yet — ctrl+a adds some'; fi
self=$(printf '%q' "$0")
printf '%s\n' "${list[@]}" | fzf --ansi --no-sort --height=100% \
  --delimiter=$'\t' --with-nth=2 --tiebreak=index --header="$head" --ghost="$ghost" \
  --preview="$self --preview {1} {3} {4} {6}" --preview-window='right,36,border-left,noinfo,wrap' \
  --preview-wrap-sign=' ' \
  --footer=$'\n'"$(screen_keys ctrl+a add '' ctrl+d remove '')" \
  --bind="enter:become($self --open {1} {5})" \
  --bind="ctrl-a:become($self --add)" \
  --bind="start:reload-sync($self --rows)" --bind="resize:reload-sync($self --rows)" \
  --bind="ctrl-d:execute-silent($self --remove {1})+reload-sync($self --rows)"
exit 0
