#!/usr/bin/env bash
# kawa-help — Super+/ : every keybinding, type to filter (Esc closes). A menu of the panel's
# (kawa-menu; docs/design-system.md): each part of keybinds.txt under its kanji and name (what
# its heading says after a colon or in brackets at the heading's end), a row a binding — the key as the row's
# name, what it does in a column of its own (the panel puts it 12 px after the longest key).
# A row of keybinds.txt is a key, then its description from column 24 on (a key that runs past
# it: after its gap of two spaces). The first binding is where the first key puts the cursor.
# No arguments (--help: this text).
set -u
case ${1:-} in
  "") ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-help   (no arguments: the keybinding sheet)" >&2; exit 2 ;;
esac
f="$HOME/.config/fedokawaii/keybinds.txt"
[[ -r $f ]] || { . "$HOME/.config/fedokawaii/icons.sh"; notify-send -a desktop -u critical -- "$ICON_KEYBOARD  keybindings" "keybinds.txt is missing — fedokawaii repair puts it back"; exit 1; }
export LC_ALL=C.UTF-8                            # (a column a character)
# each part's kanji, by the first word of its name (a part of your own: 節, "a section")
kanji() {
  case ${1%%[^a-z]*} in
    launch) echo 起 ;; screenshots) echo 写 ;; windows) echo 窓 ;; workspaces) echo 場 ;;
    sound) echo 音 ;; terminal) echo 端 ;; files) echo 書 ;; drives) echo 盤 ;; session) echo 席 ;;
    drawing) echo 筆 ;;
    *) echo 節 ;;
  esac
}
# split LINE — the key and its description, each without the spaces around it (KEY, DESC).
# The description starts after the first gap of two spaces or more that ends at column 24 or
# later (the sheet's column, or past it for a longer key); with none, at the first word that
# starts there (a key of 23 that leaves a single space)
split() {
  local l=$1 i=0 rest=$1 e=0 gap='^([^ ]| [^ ])* {2,}'
  while [[ $rest =~ $gap ]]; do
    e=$((e + ${#BASH_REMATCH[0]})); rest=${rest:${#BASH_REMATCH[0]}}
    ((e >= 24)) && { i=$e; break; }
  done
  if ((i == 0)); then
    i=24; while ((i < ${#l})) && ! [[ ${l:i:1} != " " && ${l:i-1:1} == " " ]]; do i=$((i + 1)); done
  fi
  KEY=${l:0:i} DESC=${l:i}
  KEY=${KEY%"${KEY##*[! ]}"} DESC=${DESC#"${DESC%%[! ]*}"}
}
# sheet — the menu's lines: "── name: more ───" or "── name (more) ───" a part (its name; the
# more at its end), any other line a row (no glyph: the key, then what it does); blank lines left out
sheet() {
  local l t v
  while IFS= read -r l; do
    [[ -n ${l//[[:space:]]/} ]] || continue
    if [[ $l == ─* ]]; then
      t=${l#"${l%%[!─ ]*}"}; t=${t%"${t##*[!─ ]}"}
      v=""
      if [[ $t == *": "* ]]; then v=${t#*: } t=${t%%: *}
      elif [[ $t =~ ^(.*[^ ])\ +\((.*)\)$ ]]; then t=${BASH_REMATCH[1]} v=${BASH_REMATCH[2]}; fi
      printf 'part\t%s\t%s\t%s\n' "$(kanji "$t")" "$t" "$v"
    else
      split "$l"; printf 'row\t\t%s\t%s\n' "$KEY" "$DESC"
    fi
  done <"$f"
}
sheet | kawa-menu --prompt "> " --lines 24 --select 1 >/dev/null || true
