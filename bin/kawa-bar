#!/usr/bin/env bash
# kawa-bar — the bar's buttons, each lit (its class "active": its glyph and text drawn in
# vermilion) while what a click on it opened is on screen. waybar runs it for its modules:
#
#   kawa-bar torii | layout | date | day | mode | cat
#                                                 that item, drawn here (waybar JSON)
#   kawa-bar ITEM -- CMD [ARG…]                   CMD's own line (its module's JSON), with
#                                                 "active" added to its class while ITEM is lit
#   kawa-bar --lit ITEM                           exit 0 while ITEM is lit, 1 when not
#   . kawa-bar                                    (sourced) only defines bar_lit ITEM — for the
#                                                 bar's long-running modules (kawa-timer,
#                                                 kawa-mem, kawa-volume): no process started
#
# What lights each item: a marker in $XDG_RUNTIME_DIR holding its opener's pid (and, for a
# dropdown, the script that asked kawa-menu for it). An item is lit only while that pid lives:
# a marker left behind by an opener that was killed (even kill -9) or crashed lights nothing.
# The panels and the dropdowns are the session's panel's (kawa-panel): it writes their marker
# with its own pid as it shows one and takes it away as it hides it — the light is what is on
# screen, not a guess.
#   torii       the launcher               kawa-launcher.open                 kawa-menu --launcher
#   date, day   the calendar               kawa-drop.open  "PID kawa-calendar" (kawa-menu --drop)
#   time        the timer's menu           kawa-drop.open  "PID kawa-timer"
#   drives      the drives menu            kawa-drop.open  "PID kawa-drives"
#   downloads   the downloads menu         kawa-drop.open  "PID kawa-downloads"
#   weather     the forecast               kawa-drop.open  "PID kawa-weather"
#   layout      the layout menu            kawa-drop.open  "PID kawa-tag"
#   memory      btop                       kawa-term-btop.open               kawa-term --float --once btop
#   volume      the sound panel            kawa-panel-sound.open              kawa-panel --sound
#   brightness  the brightness slider      kawa-panel-brightness.open         kawa-panel --brightness
#   mode, cat   quick settings             kawa-panel.open                    kawa-panel
# Each opener writes its marker and pokes the bar as it opens, and takes it away and pokes
# again however it ends (kawa-dwlstatus --poke: the module's signal, and a wake for the
# long-running ones). While lit an item has no tooltip (an empty one: none): it would show
# behind the menu its click opened.
# Exit status: 0 printed (--lit: lit) · 1 not lit (--lit) · 2 misuse.

# bar_lit ITEM — ITEM's menu or window is on screen now (bash alone: read, kill -0)
bar_lit() {
  local run=${XDG_RUNTIME_DIR:-/nonexistent} m p n
  local -a marks
  case $1 in
    torii)       marks=("kawa-launcher.open") ;;
    date|day)    marks=("kawa-drop.open kawa-calendar") ;;
    time)        marks=("kawa-drop.open kawa-timer") ;;
    drives)      marks=("kawa-drop.open kawa-drives") ;;
    downloads)   marks=("kawa-drop.open kawa-downloads") ;;
    weather)     marks=("kawa-drop.open kawa-weather") ;;
    layout)      marks=("kawa-drop.open kawa-tag") ;;
    memory)      marks=("kawa-term-btop.open") ;;
    volume)      marks=("kawa-panel-sound.open") ;;
    brightness)  marks=("kawa-panel-brightness.open") ;;
    mode)        marks=("kawa-drop.open kawa-quick") ;;   # (its own dropdown: do not disturb's)
    cat)         marks=("kawa-panel.open") ;;
    *)           return 1 ;;
  esac
  for m in "${marks[@]}"; do
    p="" n=""
    { read -r p n <"$run/${m%% *}"; } 2>/dev/null || continue
    [[ $p =~ ^[1-9][0-9]*$ ]] || continue                 # (an empty or broken marker: nothing)
    [[ $m != *' '* || $n == "${m#* }" ]] || continue       # (another script's dropdown)
    kill -0 "$p" 2>/dev/null && return 0
  done
  return 1
}
# bar_push NAME LINE — a value pushed to the bar's long-running module NAME (volume,
# brightness) the moment it changes, by whoever changed it (the panel's meter dragged, a key):
# LINE into each $XDG_RUNTIME_DIR/kawa-bar.NAME.PID (a link to that module's fifo), opened
# read-write so it never waits — bash alone, no process started; the module draws it at once
bar_push() {
  local f
  for f in "${XDG_RUNTIME_DIR:-/nonexistent}/kawa-bar.$1".*; do
    [[ -p $f ]] && kill -0 "${f##*.}" 2>/dev/null && { printf '%s\n' "$2" 1<>"$f"; } 2>/dev/null
  done
  return 0
}
[[ ${BASH_SOURCE[0]} != "$0" ]] && return 0

set -u
LC_ALL=C.UTF-8                      # English day and month names, whatever the system's language
usage() { echo "usage: kawa-bar torii|layout|date|day|mode|cat · kawa-bar ITEM -- CMD… · kawa-bar --lit ITEM" >&2; exit 2; }
case ${1:-} in
  -h|--help) sed -n '2,/^# Exit status/{s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  --lit)     (($# == 2)) || usage; bar_lit "$2"; exit ;;
  "")        usage ;;
esac
item=$1; shift
lit=0; bar_lit "$item" && lit=1

lit_json() {   # lit_json LINE — LINE (a module's JSON) with "active" added to its class, and its
  local out=$1   # tooltip emptied (none), while lit
  if ((lit)) && [[ -n $out ]]; then
    while [[ $out =~ ^(.*\"tooltip\":\")(([^\"\\]|\\.)+)(\".*)$ ]]; do
      out="${BASH_REMATCH[1]}${BASH_REMATCH[4]}"
    done
    if [[ $out =~ ^(.*\"class\":)\"([^\"]*)\"(.*)$ ]]; then
      out="${BASH_REMATCH[1]}[\"${BASH_REMATCH[2]}\",\"active\"]${BASH_REMATCH[3]}"
    elif [[ $out =~ ^(.*\"class\":\[)(.*)$ ]]; then
      out="${BASH_REMATCH[1]}\"active\",${BASH_REMATCH[2]}"
    elif [[ $out == *'}' ]]; then
      out="${out%\}},\"class\":\"active\"}"
    fi
  fi
  [[ -n $out ]] && printf '%s\n' "$out"
  return 0
}

if (($#)); then                     # kawa-bar ITEM -- CMD…: the module's own line, "active" added
  [[ $1 == -- && $# -ge 2 ]] || usage
  shift
  out=$("$@"); rc=$?
  lit_json "${out%%$'\n'*}"
  exit "$rc"
fi

# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
cls=""; ((lit)) && cls=',"class":"active"'
case $item in
  torii) printf '{"text":"%s"%s}\n' "$ICON_TORII" "$cls" ;;
  layout) # kawa-dwlstatus's line for this bar's monitor (else the focused one's), lit
         l=""; { IFS= read -r l <"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/layout.json" \
                 || IFS= read -r l <"$XDG_RUNTIME_DIR/dwl-bar/layout.json"; } 2>/dev/null
         lit_json "$l" ;;
  cat)   # quick settings: the mood's own face — a demon by night, an angel by day (the old
         # masters' world: art/icons.txt oni, tennin) — that opens up while its panel is open
         # shellcheck source=/dev/null
         . "$HOME/.config/fedokawaii/current/colors.sh"           # (THEME)
         if [[ ${THEME:-dark} == light ]]; then face=$ICON_TENNIN open=$ICON_TENNIN_OPEN
         else face=$ICON_ONI open=$ICON_ONI_OPEN; fi
         if ((lit)); then printf '{"text":"%s"%s}\n' "$open" "$cls"
         else printf '{"text":"%s"}\n' "$face"; fi ;;
  date)  # DD∕MM∕YYYY, its two slashes our own (Sumi UI's ∕: a clean stair on the figures' ten
         # rows — art/signs.txt) in vermilion: the same width every day, figures only
         # shellcheck source=/dev/null
         . "$HOME/.config/fedokawaii/current/colors.sh"
         s="<span color='#$C_ACCENT_TEXT'>∕</span>"
         printf -v d "%(%d)T$s%(%m)T$s%(%Y)T" -1 -1 -1
         if ((lit)); then printf '{"text":"%s","class":"active"}\n' "$d"
         else printf '{"text":"%s"}\n' "$d"; fi ;;
  day)   # the day of the week as its kanji: 月 火 水 木 金 土 日, Monday first
         # (月 and 日 have more air of their own than the others: a class each, so style.css
         # keeps 14 px to the date and to the time)
         k=(月 火 水 木 金 土 日); printf -v u '%(%u)T' -1
         c=""; ((u == 1)) && c=mon; ((u == 7)) && c=sun
         if [[ -n $c ]]; then
           if [[ -n $cls ]]; then printf '{"text":"%s","class":["%s","active"]}\n' "${k[u - 1]}" "$c"
           else printf '{"text":"%s","class":"%s"}\n' "${k[u - 1]}" "$c"; fi
         else printf '{"text":"%s"%s}\n' "${k[u - 1]}" "$cls"; fi ;;
  mode)  # what is held back: the quiet bell while "do not disturb" is on (its end in the
         # tooltip when it is timed: kawa-quick dnd), the monitor while a screen is shared;
         # nothing otherwise (hidden). A click: do not disturb's own dropdown. Each an icon
         # alone (14 px, quick settings' picture size), its ink from the pen: no air either side
         case $(makoctl mode 2>/dev/null) in
           *sharing*)        lit_json "{\"text\":\"$ICON_SHARE_BAR\",\"class\":\"share\",\"tooltip\":\"sharing screen\"}" ;;
           *do-not-disturb*) tip="do not disturb"
                             if read -r end _ 2>/dev/null <"${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-dnd.until" \
                                && [[ $end =~ ^[0-9]+$ ]] && ((end > EPOCHSECONDS)); then
                               printf -v tip 'do not disturb until %(%-H:%M)T' "$end"
                             fi
                             lit_json "{\"text\":\"$ICON_TILE_BELL_OFF_BAR\",\"class\":\"dnd\",\"tooltip\":\"$tip\"}" ;;
           *)                echo '{"text":""}' ;;
         esac ;;
  *)     usage ;;
esac
exit 0
