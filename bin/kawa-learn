#!/usr/bin/python3
"""kawa-learn — the daily lessons: one of Part 1 (the system) and one of Part 2 (programming) a day, about
30 minutes together (Super+U → learning → lessons; the launcher's Lessons). A window of its own, tiled, so
what a lesson asks you to type goes in the terminal next to it (Super+Enter). docs/design-system.md §7.

    kawa-learn            the day: today's pair, how far, what comes next
    kawa-learn ID         that lesson
    kawa-learn --text [ID] [--cols N]  a lesson as plain text: today's next, or that one (a text
                          console: fedokawaii learn); on a terminal, in less, then its check
    kawa-learn --place    how far you are, a line of words (and the file Super+U's row reads)

The day: ↑ ↓ Tab the pair, Enter opens, ← → the days before (the next one waits for its date).
A lesson: ↑ ↓ the wheel, Space a page, Enter a page and at its end the check; a check passed stamps
the lesson, Enter then goes on; ← → the other of the pair; s its answer; Esc back.
The day, too: r the daily review (five cards, a question, Space shows the answer, y right, n wrong),
m the concept map, a the week and the rank, e the explain-it-back note of the lesson under the cursor
(~/notes/explain-ID.md, a checklist, opened in $EDITOR). Spaced as docs/lesson-standard.md says.
The source: docs/lessons, its format and the record's in lib/lessons.py, both in the toolkit
($KAWA_TOOLKIT; $KAWA_LEARN another folder of lessons). Kept: ~/.local/state/fedokawaii/days (the
record), learn.at (where you stopped), learn.place (Super+U's row), reviews (every answer of the review).
Exit 0 · 1 the lessons cannot be read (said) · 2 misuse."""
import math
import os
import re
import select
import signal
import subprocess
import sys
import termios
import time
import tty
import unicodedata

TOOLKIT = os.environ.get("KAWA_TOOLKIT") or "/usr/local/lib/fedokawaii"
LIB = TOOLKIT + "/lib"
LEARN = os.environ.get("KAWA_LEARN") or TOOLKIT + "/docs/lessons"
HOME = os.path.expanduser("~")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or HOME + "/.local/state", "fedokawaii")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or HOME + "/.config"
DOJO = HOME + "/dojo"
sys.dont_write_bytecode = True
sys.path.insert(0, LIB)
try:
    import lessons
    import review
except ImportError:
    lessons = review = None
MEASURE = 88        # the page's columns at most: a line you can read
PANE = 50           # the list's pane, as Super+U's
LIST_MIN = 46       # the list's columns at least, where a pane beside it is drawn
BLOCK = LIST_MIN + 3 + PANE + 14   # list and pane together at most: wider, they stay centred
SEAL_ROWS = 3       # the stamp at a lesson's end: its terminal rows (a 56 px seal, 60 px with its thump)
SEAL_COLS = 8
UNROLL = 0.30       # a lesson opening, seconds (§11: a scroll, 300)

# the inks: foot's palette past the sixteen (screen.sh), so a theme switch reaches every open page
ACCENT, ON_ACCENT, EDGE2, ACCENT_TEXT, MUTED, FAINT, STRONG, SELECT, ON_SELECT = \
    "38;5;16", "38;5;17", "38;5;19", "38;5;20", "38;5;21", "38;5;22", "38;5;23", "48;5;24", "38;5;25"
BAND = "48;5;0"     # the terminal's black: what a code word lies on (§1: it carries text, strong)
PART_ICON = {1: "TERMINAL", 2: "CODE"}
PART_NAME = {1: "system", 2: "coding"}
LACQUER = "38;5;24"  # select as an ink: a rod (§11; foot draws ▂ itself: 5 px of the cell's 20, on its foot)
ITALIC = "3"


# ── widths: what the terminal counts (a kanji two, an accent none; our icons one, spilling) ──
def char_cols(c):
    o = ord(c)
    if o < 0x300:
        return 1
    if 0xE000 <= o <= 0xF8FF or 0xF0000 <= o <= 0xFFFFD:
        return 1
    if unicodedata.category(c) in ("Mn", "Me", "Cf"):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def cols(s):
    return len(s) if s.isascii() else sum(map(char_cols, s))


def split_cols(s, n):
    """s cut after n columns at most: (what fits, the rest); nothing fits (a kanji in the last
    column): ("", s) — the caller starts a new line"""
    w = 0
    for i, c in enumerate(s):
        w += char_cols(c)
        if w > n:
            return s[:i], s[i:]
    return s, ""


# ── runs: a line is a list of (text, sgr) ─────────────────────────────────────────────────


def ansi(runs):
    out, cur = [], ""
    for text, sgr in runs:
        if sgr != cur:
            out.append(f"\x1b[0;{sgr}m" if sgr else "\x1b[0m")
            cur = sgr
        out.append(text)
    if cur:
        out.append("\x1b[0m")
    return "".join(out)


def plain(runs):
    return "".join(t for t, _ in runs)


def run_cols(runs):
    return sum(cols(t) for t, _ in runs)


def mix(a, b):
    return f"{a};{b}" if a and b else a or b


TOKEN = re.compile(r"(`+)(.+?)\1|\*\*(.+?)\*\*|(?<![\w*])\*(?=[^\s*])(.+?)(?<=[^\s*])\*(?![\w*])", re.S)


CHORD = re.compile(r"\b((?:(?:Super|Shift|Ctrl|Alt)\+)+(?:[A-Z][a-z]+|[A-Za-z0-9]|F\d+))(?![\w+])")
CAP_NAME = {"escape": "esc", "return": "enter", "backspace": "bksp", "delete": "del"}


def caps(s, sgr):
    """plain words as runs, a chord (Super+Shift+Print) drawn as keycaps (§4, §7): whole cells of Sumi Icons Term,
    one tile a key, their ends U+FF001 and U+FF002, the letters U+FF000 + the sign; muted, as every screen's keys"""
    out, at = [], 0
    for m in CHORD.finditer(s):
        if m.start() > at:
            out.append((s[at:m.start()], sgr))
        tiles = ""
        for k in m[1].split("+"):
            k = k.lower() if len(k) > 1 else k
            tiles += "\U000FF001" + "".join(chr(0xFF000 + ord(c)) for c in CAP_NAME.get(k, k)) + "\U000FF002"
        out.append((tiles, mix(sgr, MUTED)))
        at = m.end()
    if at < len(s):
        out.append((s[at:], sgr))
    return out


def inline(s, sgr=""):
    """a paragraph's words as runs: **strong**, *aside*, `code` (nothing inside it read); a chord its keycaps"""
    out, at = [], 0
    for m in TOKEN.finditer(s):
        if m.start() > at:
            out.extend(caps(s[at:m.start()], sgr))
        if m[1]:
            out.append((m[2], mix(sgr, BAND)))
        elif m[3] is not None:
            out.extend(inline(m[3], STRONG if not sgr else mix(sgr, STRONG)))
        else:
            out.extend(inline(m[4], mix(sgr, MUTED + ";" + ITALIC)))
        at = m.end()
    if at < len(s):
        out.extend(caps(s[at:], sgr))
    return out


def wrap(runs, width):
    """runs → lines of at most width columns, broken at spaces (a word longer than a line is cut
    across lines, nothing lost, nothing dotted); a space keeps its run's ink only inside a line"""
    atoms, cur, space = [], [], None
    for text, sgr in runs:
        parts = re.split(r"( +)", text)
        for p in parts:
            if not p:
                continue
            if p.startswith(" "):
                if cur:
                    atoms.append((cur, space))
                    cur = []
                space = sgr
            else:
                cur.append((p, sgr))
    if cur:
        atoms.append((cur, space))
    lines, line, used = [], [], 0
    for atom, sp in atoms:
        w = run_cols(atom)
        if line and used + 1 + w <= width:
            line.append((" ", sp or ""))
            line.extend(atom)
            used += 1 + w
            continue
        if line:
            lines.append(line)
            line, used = [], 0
        if w <= width:
            line, used = list(atom), w
            continue
        for text, sgr in atom:          # (longer than a line: a path, a long name)
            while text:
                head, rest = split_cols(text, width - used)
                if not head:
                    if not line:            # (a window one column wide: one letter a line, whatever it costs)
                        head, rest = text[0], text[1:]
                    else:
                        lines.append(line)
                        line, used = [], 0
                        continue
                text = rest
                line.append((head, sgr))
                used += cols(head)
    if line:
        lines.append(line)
    return lines or [[]]


# ── a piece: Markdown → lines of the page ──────────────────────────────────────────────────
class Line:
    __slots__ = ("runs", "block", "seal")

    def __init__(self, runs, block=0, seal=False):
        self.runs, self.block, self.seal = runs, block, seal


FENCE = re.compile(r"^```(\S*)$")
BOXES = (("Word — ", "BOOK"), ("Careful", "CAREFUL"))
HEADING_ICON = {"exercise": "PEN", "check": "CHECK", "not yet": "CAREFUL", "answer": "NOTE"}
BAT_LANG = {"python": "python", "rust": "rust", "sh": "bash", "json": "json", "toml": "toml", "markdown": "markdown"}


def highlight(blocks):
    """the code blocks (language, text) in bat's colours (the theme "ansi": foot's palette), each
    lines of runs: bat started on them together, so a lesson of ten blocks costs one's wait"""
    jobs = []
    for lang, text in blocks:
        if BAT_LANG.get(lang):
            try:
                p = subprocess.Popen(["bat", "--color=always", "--style=plain", "--paging=never", "--wrap=never",
                                      "--theme=ansi", "-l", BAT_LANG[lang]], stdin=subprocess.PIPE,
                                     stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
            except OSError:
                return {}
            jobs.append((lang, text, p))
    out = {}
    for lang, text, p in jobs:
        # (one write and one read each: a block is far smaller than a pipe's buffer or it waits a moment)
        coloured, _ = p.communicate(text)
        if p.returncode == 0:
            out[(lang, text)] = [ansi_runs(x) for x in coloured.split("\n")[:-1]] if coloured.endswith("\n") \
                else [ansi_runs(x) for x in coloured.split("\n")]
    return out


SGR = re.compile(r"\x1b\[([0-9;]*)m")


def ansi_runs(s):
    runs, at, sgr = [], 0, ""
    for m in SGR.finditer(s):
        if m.start() > at:
            runs.append((s[at:m.start()], sgr))
        sgr = "" if m[1] in ("", "0") else m[1]
        at = m.end()
    if at < len(s):
        runs.append((s[at:], sgr))
    return runs


def console_runs(text):
    """a ```text block: what you type strong, what the computer answers muted; a file's or a
    picture's lines (no prompt anywhere in it) as they are"""
    lines = text.split("\n")
    if not any(x.startswith(("$ ", ">>> ", "." * 3 + " ")) or x in ("$", ">>>") for x in lines):
        return [[(x, "")] if x else [] for x in lines]
    out, typed = [], False
    for x in lines:
        m = re.match(r"^(\$|>>>|\.{3})( .*)?$", x)
        if m:
            typed = x.endswith("\\")
            out.append([(m[1], FAINT), (m[2] or "", STRONG)])
        elif typed:
            typed = x.endswith("\\")
            out.append([(x, STRONG)])
        else:
            out.append([(x, MUTED)] if x else [])
    return out


class Page:
    """a piece laid out for a width: lines (runs at the page's own columns); each line knows its
    block, so a new width keeps what was at the top of the page"""

    def __init__(self, text, icons, title):
        self.text, self.icons, self.title = text, icons, title
        self.hl = None

    def blocks(self):
        return [m for m in re.finditer(r"^```(\S*)\n(.*?)\n```$", self.text, re.M | re.S)]

    def layout(self, width):
        if self.hl is None:
            self.hl = highlight([(m[1], m[2]) for m in self.blocks()])
        lines = []
        self.block = 0
        self.pending_blank = 0
        self.render(self.text.split("\n"), lines, width, 0)
        return lines

    def ink_icon(self, name, ink=ACCENT_TEXT):
        return (self.icons.get(name, "·"), ink)

    # (adds a run of blank lines before what comes next, however many were asked: the most wins)
    def gap(self, n):
        self.pending_blank = max(self.pending_blank, n)

    def put(self, lines, runs, indent=0):
        if self.pending_blank and lines:
            lines.extend(Line([], self.block) for _ in range(self.pending_blank))
        self.pending_blank = 0
        lines.append(Line(([(" " * indent, "")] if indent else []) + runs, self.block))

    def para(self, lines, runs, indent, width, first=None, hang=0):
        """words wrapped; first: what stands before them on the first line, hang columns wide"""
        for i, ln in enumerate(wrap(runs, max(1, width - indent - hang))):
            if i == 0 and first:
                self.put(lines, first + ln, indent)
            else:
                self.put(lines, ln, indent + hang)

    def code(self, lines, lang, text, indent, width):
        rows = self.hl.get((lang, text)) if BAT_LANG.get(lang) else None
        if rows is None:
            rows = console_runs(text)
        rail, room = ("│", EDGE2), max(1, width - indent - 2)
        for runs in rows:
            first = True
            cont = list(runs)
            while first or cont:
                line, used = [], 0
                while cont and used < room:
                    t, sgr = cont.pop(0)
                    if not t:
                        continue
                    head, rest = split_cols(t, room - used)
                    if not head:
                        if line:
                            cont.insert(0, (t, sgr))
                            break
                        head, rest = t[0], t[1:]        # (a window one column wide: never a loop)
                    line.append((head, sgr))
                    used += cols(head)
                    if rest:
                        cont.insert(0, (rest, sgr))
                self.put(lines, [rail if first else ("↳", FAINT), (" ", "")] + line, indent)
                first = False

    def table(self, lines, rows, indent, width):
        cells = [[inline(c.strip().replace(r"\|", "|")) for c in re.split(r"(?<!\\)\|", r.strip().strip("|"))]
                 for r in rows if not re.match(r"^\|[\s:|-]+\|$", r)]
        n = max(len(r) for r in cells)
        for r in cells:
            r.extend([[] for _ in range(n - len(r))])
        room = width - indent
        natural = [max(run_cols(r[i]) for r in cells) for i in range(n)]
        least = [max((max((cols(w) for w in plain(r[i]).split(" ")), default=0) for r in cells), default=1) for i in range(n)]
        least = [max(1, min(a, room)) for a in least]
        widths = natural
        if sum(natural) + 2 * (n - 1) > room:
            if sum(least) + 2 * (n - 1) > room:     # (too narrow for columns: each row a small block)
                self.stacked(lines, cells, indent, width)
                return
            # (the room left goes to the narrowest column still short of its words, a cell at a
            # time: short columns stay whole, only the long sentences wrap)
            spare = room - 2 * (n - 1) - sum(least)
            widths = list(least)
            while spare > 0:
                short = [i for i in range(n) if widths[i] < natural[i]]
                if not short:
                    break
                widths[min(short, key=lambda i: widths[i])] += 1
                spare -= 1
        total = sum(widths) + 2 * (n - 1)
        for k, row in enumerate(cells):
            wrapped = [wrap(row[i] if k else [(plain(row[i]), MUTED)], max(1, widths[i])) for i in range(n)]
            for j in range(max(len(w) for w in wrapped)):
                out = []
                for i in range(n):
                    part = wrapped[i][j] if j < len(wrapped[i]) else []
                    out.extend(part)
                    if i < n - 1:
                        out.append((" " * (widths[i] - run_cols(part) + 2), ""))
                self.put(lines, out, indent)
            if k == 0:
                self.put(lines, [("─" * total, EDGE2)], indent)

    def stacked(self, lines, cells, indent, width):
        head = cells[0]
        for row in cells[1:]:
            for i, c in enumerate(row):
                if not c:
                    continue
                self.para(lines, ([(plain(head[i]) + ": ", MUTED)] if plain(head[i]) else []) + c, indent + (2 if i else 0), width)
            self.gap(1)

    def heading(self, lines, name, width, indent, icon=None):
        """a part of the page (§7, two blank lines above, one under): its icon, its name, the rule"""
        self.gap(2)
        start = [self.ink_icon(icon), ("  ", "")] if icon else []
        room = width - indent - run_cols(start)
        fit = wrap([(name, STRONG)], max(1, room - 3))
        for i, ln in enumerate(fit):
            rule = room - run_cols(ln) - 1
            self.put(lines, (start if i == 0 else [(" " * run_cols(start), "")]) + ln
                     + ([(" ", ""), ("─" * rule, EDGE2)] if i == len(fit) - 1 and rule > 0 else []), indent)
        self.gap(1)

    def render(self, src, lines, width, indent):
        i, n = 0, len(src)
        while i < n:
            x = src[i]
            if not x.strip():
                i += 1
                continue
            self.block += 1
            m = FENCE.match(x)
            if m:
                j = i + 1
                while j < n and not src[j].startswith("```"):
                    j += 1
                self.gap(1)
                self.code(lines, m[1], "\n".join(src[i + 1:j]), indent, width)
                self.gap(1)
                i = j + 1
                continue
            h = re.match(r"^(#{2,3}) (.*)$", x)
            if h:
                name = h[2]
                if len(h[1]) == 2:
                    self.heading(lines, name, width, indent, HEADING_ICON.get(name))
                else:
                    self.gap(1)
                    self.para(lines, inline(name, STRONG), indent, width)
                    self.gap(1)
                i += 1
                continue
            if x.startswith("<!--"):
                while i < n and "-->" not in src[i]:
                    i += 1
                i += 1
                continue
            if x.startswith("|"):
                j = i
                while j < n and src[j].startswith("|"):
                    j += 1
                self.gap(1)
                self.table(lines, src[i:j], indent, width)
                self.gap(1)
                i = j
                continue
            if x.startswith(">"):
                j = i
                while j < n and src[j].startswith(">"):
                    j += 1
                self.box(lines, [q[1:].lstrip(" ") if len(q) > 1 else "" for q in src[i:j]], indent, width)
                i = j
                continue
            li = re.match(r"^([-*]|\d+\.) (.*)$", x)
            if li:
                j = i
                while j < n and re.match(r"^([-*]|\d+\.) ", src[j]):
                    item = [src[j]]
                    j += 1
                    while j < n and src[j].strip() and not re.match(r"^([-*]|\d+\.) |^```|^\||^>|^#|^<!--", src[j]):
                        item.append(src[j].strip())
                        j += 1
                    self.item(lines, " ".join(item), indent, width)
                self.gap(1)
                i = j
                continue
            j = i
            para = []
            while j < n and src[j].strip() and not re.match(r"^```|^\||^>|^#{2,3} |^<!--", src[j]) \
                    and not (j > i and re.match(r"^([-*]|\d+\.) ", src[j])):
                para.append(src[j].strip())
                j += 1
            self.paragraph(lines, " ".join(para), indent, width)
            self.gap(1)
            i = j

    def item(self, lines, text, indent, width):
        m = re.match(r"^([-*]|\d+\.) (.*)$", text)
        mark = "•" if m[1] in "-*" else m[1]
        w = cols(mark) + 1
        self.para(lines, inline(m[2]), indent + 1, width, first=[(mark, MUTED), (" ", "")], hang=w)

    def paragraph(self, lines, text, indent, width):
        self.para(lines, inline(text), indent, width)

    def box(self, lines, quote, indent, width):
        """a quote: a new word, a checkpoint, careful, in this chapter: the kind's icon in the heading's column,
        its words from the name's (§7); a line of - or 1. inside it a list"""
        icon = None
        head = next((q for q in quote if q), "")
        word = re.match(r"^\*\*(.*?)\*\*", head)
        if word:
            for start, name in BOXES:
                if word[1].startswith(start):
                    icon = name
        self.gap(1)
        paras, cur = [], []
        for q in quote:
            if not q:
                if cur:
                    paras.append(cur)
                cur = []
            elif re.match(r"^([-*]|\d+\.) ", q) and cur:
                paras.append(cur)
                cur = [q]
            else:
                cur.append(q)
        if cur:
            paras.append(cur)
        first = True
        for p in paras:
            text = " ".join(p)
            item = re.match(r"^([-*]|\d+\.) (.*)$", text)
            if not first and not item:
                self.gap(1)
            if first and text.startswith("**Word — "):
                text = "**" + text[len("**Word — "):]
            if item:
                mark = "•" if item[1] in "-*" else item[1]
                self.para(lines, inline(item[2]), indent + 3, width, first=[(mark, MUTED), (" ", "")], hang=cols(mark) + 1)
            else:
                start = [self.ink_icon(icon or "NOTE"), ("  ", "")] if first else [("   ", "")]
                self.para(lines, inline(text), indent, width, first=start, hang=3)
            first = False
        self.gap(1)

# ── the course: lib/lessons.py's, and what was done ────────────────────────────────────────
class Course:
    def __init__(self):
        self.whole = lessons.load(LEARN)
        self.days, self.by_id = self.whole["days"], self.whole["lessons"]
        self.record = os.path.join(STATE, "days")
        self.done = lessons.read_record(self.record)
        self.reviews_path = os.path.join(STATE, "reviews")
        self.deck = review.cards(self.whole)

    def reviews(self):
        return review.read_reviews(self.reviews_path)

    def due(self, limit=None):
        return review.due(self.deck, self.done, self.reviews(), time.strftime("%Y-%m-%d"), limit or review.SESSION)

    def answer(self, card, right):
        try:
            review.add_review(self.reviews_path, card, right, time.strftime("%Y-%m-%d"))
        except OSError:      # (a disk that is full: the review goes on, the answer is not kept)
            pass

    def corner(self):
        """the quiet line of the day: cards due, the belt, the streak"""
        rows = self.reviews()
        n = len(self.due(10 ** 6))
        run = review.streak(self.done, rows, time.strftime("%Y-%m-%d"))
        parts = [f"{n} due" if n else "nothing due", review.rank(self.done, rows)[0]]
        if run > 1:
            parts.append(f"{run} days in a row")
        return "  ·  ".join(parts)

    def note_path(self, lid):
        return os.path.join(HOME, "notes", f"explain-{lid}.md")

    def make_note(self, le):
        """the explain-it-back note: written once, never over your words"""
        path = self.note_path(le["id"])
        if not os.path.exists(path):
            write_file(path, f"# {le['title']}\n\nExplain it back, in your own words, as if to a friend who has never seen it.\n\n"
                       "## Checklist\n- [ ] I wrote it without looking at the lesson\n- [ ] I used no word I cannot explain\n"
                       "- [ ] I gave one example of my own\n- [ ] I said what goes wrong without it\n\n## My words\n\n")
        return path

    def stamp(self, lid):
        self.done = lessons.read_record(self.record)      # (another window of it may have stamped meanwhile)
        if lid not in self.done:
            today = time.strftime("%Y-%m-%d")
            self.done[lid] = today
            try:
                lessons.add_record(self.record, lid, today)
            except OSError:      # (a disk that is full: the page goes on, the stamp is not kept)
                pass
        self.write_place()

    def place(self):
        return lessons.place(self.whole, self.done, time.strftime("%Y-%m-%d"))

    def pair(self, day):
        return [self.by_id[day[1]], self.by_id[day[2]]]

    def day_of(self, le):
        return next(d for d in self.days if le["id"] in d[1:])

    def next_lesson(self):
        """the one thing to do: the first of the day shown that is not done; none once it is"""
        show = self.place()[0]
        return next((le for le in self.pair(show) if le["id"] not in self.done), None) if show else None

    def count(self, part):
        ids = [d[part] for d in self.days]
        return sum(1 for i in ids if i in self.done), len(ids)

    def left(self):
        return sum(le["minutes"] for le in self.by_id.values() if le["id"] not in self.done)

    def write_place(self):
        """DAY<TAB>DAYS<TAB>NEXT<TAB>ITS MINUTES<TAB>MINUTES LEFT"""
        show, _, _ = self.place()
        n = self.next_lesson()
        write_file(os.path.join(STATE, "learn.place"), "\t".join(
            (str(show[0] if show else len(self.days)), str(len(self.days)), n["title"] if n else "",
             str(n["minutes"]) if n else "0", str(self.left()))) + "\n")

    def where(self):
        try:
            with open(os.path.join(STATE, "learn.at"), encoding="utf-8") as f:
                c = f.read().strip().split("\t")
            if len(c) == 2 and c[0] in self.by_id and c[1].isdigit():
                return c[0], int(c[1])
        except (OSError, ValueError):
            pass
        return None, 0

    def keep_where(self, le, block):
        write_file(os.path.join(STATE, "learn.at"), f"{le['id']}\t{block}\n")


def write_file(path, text):
    tmp = f"{path}.{os.getpid()}"
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass


FILE_LANG = {".py": "python", ".rs": "rust", ".sh": "sh", ".json": "json", ".toml": "toml", ".md": "markdown"}


def answer_text(le):
    """a lesson's answer for the page: an ask's the words, a run's its prose with each step a block
    (a `file NAME` fence: its name, the file in its language's colours; a `do`: commands typed)"""
    if le["check"]["kind"] == "ask":
        return "`" + le["check"]["answer"] + "`"
    out = []
    for row in le["answer"].split("\n"):
        m = re.fullmatch(r"```(do|file (\S+))", row)
        if m and m[2]:
            out += ["**" + m[2] + "**", "", "```" + FILE_LANG.get(os.path.splitext(m[2])[1], "text")]
        elif m:
            out += ["```do"]
        else:
            out.append(row)
    text = "\n".join(out)
    # (a do's commands, each with its prompt: what is typed, §7)
    return re.sub(r"^```do\n(.*?)\n```$", lambda b: "```text\n" + "\n".join("$ " + x for x in b[1].split("\n")) + "\n```",
                  text, flags=re.M | re.S)


def check_text(le):
    c = le["check"]
    if c["kind"] == "ask":
        return c["ask"]
    said = ["$ cd ~/dojo/" + c["in"], "$ " + c["run"]] + c["expect"].split("\n")
    if c["exit"]:
        said.append(f"(exit status {c['exit']})")
    return "```text\n" + "\n".join(said) + "\n```"


def said_text(said):
    """what the last try of the check came to, for the page: `not yet`, and why"""
    if "words" in said:
        return f"You said `{said['words']}`."
    out = []
    if said["status"] == "no folder":
        return f"`~/dojo/{said['in']}` is not there yet."
    if said["status"] is None:
        out.append(f"Still running after {lessons.RUN_SECONDS} seconds: stopped.")
    elif said["status"] != said["exit"]:
        out.append(f"It ended with status {said['status']}, not {said['exit']}.")
    for what in (said["out"], said["err"]):
        if what.strip("\n"):
            out.append("```text\n" + what.strip("\n").replace("```", "'''") + "\n```")
    if not said["out"].strip("\n") and not said["err"].strip("\n"):
        out.append("It printed nothing.")
    return "\n\n".join(out)


def page_text(le, answer=False, said=None):
    """a lesson as the page shows it: the idea under the page's own heading, the exercise, the
    check; under them what the last try said, and the answer when asked for"""
    out = [le["idea"], "## exercise", le["exercise"], "## check", check_text(le)]
    if said:
        out += ["## not yet", said_text(said)]
    if answer:
        out += ["## answer", answer_text(le)]
    return "\n\n".join(out) + "\n"


def read_icons():
    icons = {}
    try:
        with open(os.path.join(CONFIG, "fedokawaii/icons.sh"), encoding="utf-8") as f:
            for m in re.finditer(r"^ICON_(\w+)=\$'((?:\\x[0-9a-f]{2})+)'", f.read(), re.M):
                icons[m[1]] = bytes.fromhex(m[2].replace("\\x", "")).decode()
    except (OSError, ValueError):
        pass
    return icons


def icon_key(name):
    return name.upper().replace("-", "_")


def how_long(minutes):
    if minutes < 60:
        return f"{minutes} min"
    h, m = divmod(minutes, 60)
    return f"{h} h {m}" if m and h < 10 else f"{h + (m >= 30)} h"


def pretty_date(iso):
    try:
        t = time.strptime(iso, "%Y-%m-%d")
    except ValueError:
        return iso
    return time.strftime("%-d %b", t) if t.tm_year == time.localtime().tm_year else time.strftime("%-d %b %Y", t)


# ── the seal: one ink, painted at each draw in the mood's colours ───────────────────────────
def theme_colours():
    """the mood's inks, as the theme writes them for the panel (a sixel's colours are its own, no palette's)"""
    try:
        with open(os.path.join(CONFIG, "fedokawaii/current/panel.conf"), encoding="utf-8") as f:
            return dict(re.findall(r"^(\w+)=#?([0-9a-fA-F]{6})\b", f.read(), re.M))
    except OSError:
        return {}


def read_seals():
    seals, cur = {}, None
    try:
        with open(os.path.join(TOOLKIT, "docs/lessons/seals.txt"), encoding="utf-8") as f:
            for row in f:
                row = row.rstrip("\n")
                if row.startswith("@"):
                    cur = seals[row[1:]] = []
                elif cur is not None and row and not row.startswith("#!"):
                    cur.append(row)
    except OSError:
        pass
    return seals


def sixel(mask, colour, grow=0):
    """a one-ink picture (rows of # and .) as a sixel: unset pixels left unset (P2=1), so the
    terminal's own ground, glass and all, shows through; grow: each pixel of its edge a pixel out"""
    if grow:
        h, w = len(mask), len(mask[0])
        big = [[False] * (w + 2) for _ in range(h + 2)]
        for y, row in enumerate(mask):
            for x, c in enumerate(row):
                if c == "#":
                    for dy in (0, 1, 2):
                        for dx in (0, 1, 2):
                            big[y + dy][x + dx] = True
        mask = ["".join("#" if p else "." for p in row) for row in big]
    w = len(mask[0])
    r, g, b = (round(int(colour[i:i + 2], 16) * 100 / 255) for i in (0, 2, 4))
    out = [f"\x1bP0;1;0q\"1;1;{w};{len(mask)}#0;2;{r};{g};{b}#0"]
    for top in range(0, len(mask), 6):
        band = mask[top:top + 6]
        cells = []
        for x in range(w):
            v = 0
            for i, row in enumerate(band):
                if row[x] == "#":
                    v |= 1 << i
            cells.append(chr(63 + v))
        # run-lengths: a seal is mostly long runs
        s, x = [], 0
        while x < w:
            y = x
            while y < w and cells[y] == cells[x]:
                y += 1
            s.append(f"!{y - x}{cells[x]}" if y - x > 3 else cells[x] * (y - x))
            x = y
        out.append("".join(s) + ("-" if top + 6 < len(mask) else ""))
    return "".join(out) + "\x1b\\"


# ── the terminal ────────────────────────────────────────────────────────────────────────────
class Term:
    def __init__(self):
        self.old = None
        self.rows, self.cols = 24, 80
        self.frame = []
        self.wiped = True       # (the next frame starts from a clean screen: inside it, so no blank one is ever seen)

    def __enter__(self):
        self.old = termios.tcgetattr(0)
        tty.setraw(0, termios.TCSANOW)
        # (no line wrap: what a very small window cannot hold stops at its edge, the rows stay rows)
        self.write("\x1b[?1049h\x1b[?7l\x1b[?25l\x1b[?2031h\x1b[?1007h\x1b]2;lessons\x1b\\")
        self.size()
        return self

    def __exit__(self, *_):
        self.write("\x1b[?2031l\x1b[?1000;1003;1006l\x1b[?7h\x1b[?25h\x1b[?1049l")
        try:
            termios.tcsetattr(0, termios.TCSANOW, self.old)
        except termios.error:
            pass

    @staticmethod
    def write(s):
        data = s.encode("utf-8", "surrogateescape")
        while data:
            try:
                n = os.write(1, data)
            except BlockingIOError:
                select.select([], [1], [], 1)
                continue
            data = data[n:]

    def size(self):
        try:
            sz = os.get_terminal_size(1)
            self.rows, self.cols = max(1, sz.lines), max(1, sz.columns)
        except OSError:
            pass
        self.frame = []

    def draw(self, lines, after=""):
        """the frame: only the rows that changed, all at once (synchronized output: no half frame,
        ever); after: what is written last (a picture, the cursor)"""
        out = ["\x1b[?2026h"]
        if self.wiped:
            out.append("\x1b[2J")
            self.frame = []
            self.wiped = False
        if len(self.frame) != len(lines):
            self.frame = [None] * len(lines)
        for i, s in enumerate(lines):
            if self.frame[i] != s:
                out.append(f"\x1b[{i + 1};1H{s}\x1b[K")
                self.frame[i] = s
        out.append(after)
        out.append("\x1b[?2026l")
        self.write("".join(out))


KEYS = {"A": "up", "B": "down", "C": "right", "D": "left", "H": "home", "F": "end", "Z": "btab"}
TILDE = {"1": "home", "4": "end", "5": "pgup", "6": "pgdn", "7": "home", "8": "end"}


MOUSE = re.compile(r"\x1b\[<(\d+);(\d+);(\d+)([Mm])")
THEME = re.compile(r"\x1b\[\?997;(\d)n")
CSI = re.compile(r"\x1b[\[O]([0-9;?]*)([A-Za-z~])")


def decode(data):
    """bytes as they came → events: a key's name or letter, ("mouse", button, x, y, press),
    ("theme",). A lone ESC is the key"""
    out = []
    s = data.decode("utf-8", "replace")
    i = 0
    while i < len(s):
        c = s[i]
        if c != "\x1b":
            i += 1
            if c in "\r\n":
                out.append("enter")
            elif c == "\t":
                out.append("tab")
            elif c in "\x7f\b":
                out.append("backspace")
            elif c in "\x03\x11":
                out.append("quit")
            elif c == "\x06":
                out.append("pgdn")
            elif c == "\x02":
                out.append("pgup")
            elif c == "\x15":
                out.append("clear")
            elif c >= " ":
                out.append(c)
            continue
        m = MOUSE.match(s, i)
        if m:
            out.append(("mouse", int(m[1]), int(m[2]) - 1, int(m[3]) - 1, m[4] == "M"))
            i = m.end()
            continue
        m = THEME.match(s, i)
        if m:
            out.append(("theme",))
            i = m.end()
            continue
        m = CSI.match(s, i)
        if m:
            i = m.end()
            if m[2] == "~":
                k = TILDE.get(m[1].split(";")[0])
                if k:
                    out.append(k)
            elif m[2] in KEYS:
                out.append(KEYS[m[2]])
            continue
        out.append("esc")
        i += 1
    return out

class App:
    def __init__(self, course):
        self.course = course
        self.icons = read_icons()
        self.seals = read_seals()
        self.colours = theme_colours()
        self.term = Term()
        self.screen = "day"
        self.day = None
        self.cursor = None
        self.hits = {}
        self.lesson = None
        self.page = None
        self.lines = []
        self.ptop = 0
        self.answer = False
        self.said = None
        self.asking = None
        self.seal_at = None
        self.seal_drawn = None
        self.thump = 0
        self.unroll = 0
        self.running = True
        self.mouse = None
        self.pane_seal = None
        self.rv = None
        self.go_day(self.last_day())

    def icon(self, name):
        return self.icons.get(icon_key(name), "·")

    # ── the day ──────────────────────────────────────────────────────────────────────────
    def last_day(self):
        """how far the days go: the one to do now, or the last of all once all are done"""
        return self.course.place()[0] or self.course.days[-1]

    def go_day(self, day, lesson=None):
        self.day = day
        pair = self.course.pair(day)
        self.cursor = lesson or next((le for le in pair if le["id"] not in self.course.done), pair[0])

    def shape(self):
        """columns: (left of the block, the pair's width, the pane's, or 0) for this window"""
        room = self.term.cols - 4
        if room >= LIST_MIN + 3 + PANE:
            block = min(room, BLOCK)
            return 2 + (room - block) // 2, block - PANE - 3, PANE
        return 2, max(8, room), 0

    def draw_day(self):
        rows = self.term.rows
        x0, lw, pw = self.shape()
        lines = [[] for _ in range(rows)]
        course = self.course

        def put(r, col, runs):
            if 0 <= r < rows:
                used = run_cols(lines[r])
                if col > used:
                    lines[r].append((" " * (col - used), ""))
                lines[r].extend(runs)

        self.heading_row(put, 1, x0, lw, "MORTARBOARD", self.day_name(), f"day {self.day[0]} of {len(course.days)}")
        pair = course.pair(self.day)
        self.hits = {}
        for i, le in enumerate(pair):
            self.hits[3 + i] = le
            put(3 + i, x0 - 1 if le is self.cursor else x0, self.lesson_row(le, lw))
        # what comes after today's, its date not yet come: told, never offered
        after = course.place()[1] if self.day is self.last_day() else None
        if after and rows >= 12:
            self.heading_row(put, 6, x0, lw, "CHEVRON_RIGHT", "next", f"day {after[0]}")
            for i, le in enumerate(course.pair(after)):
                put(8 + i, x0, self.lesson_row(le, lw, quiet=True))
        if pw:
            self.draw_pane(put, x0 + lw + 3, pw, rows)
        elif rows >= 16:
            self.meter(put, rows - 4, x0 - 3, "days", *self.days_done())
        foot = [("enter", ""), ("  ", ""), ("open", MUTED)]
        if len(course.days) > 1 and self.last_day()[0] > 1:
            foot += [("    ", ""), ("← →", ""), ("  ", ""), ("another day", MUTED)]
        for k, what in (("r", "review"), ("m", "map"), ("a", "week")):
            more = [("    ", ""), (k, ""), ("  ", ""), (what, MUTED)]
            if x0 + run_cols(foot + more) < self.term.cols:      # (what does not fit whole is left out)
                foot += more
        if rows > 6:
            put(rows - 2, x0, foot)
        if rows > 8:
            put(rows - 3, x0, wrap([(course.corner(), FAINT)], max(1, self.term.cols - x0 - 1))[0])
        self.term.write("\x1b[?1000;1003;1006h")
        spot = self.pane_seal if pw else None
        self.show([ansi(x) for x in lines], (spot[0] + 1, spot[1] + 1) if spot else None,
                  self.cursor["id"] in course.done, "\x1b[?25l")

    def day_name(self):
        """today, or the date a day before was finished on"""
        dates = [self.course.done.get(i) for i in self.day[1:]]
        if time.strftime("%Y-%m-%d") in dates or None in dates:
            return "today"
        return pretty_date(max(dates))

    def days_done(self):
        return self.course.place()[2], len(self.course.days)

    def heading_row(self, put, r, x, w, icon, name, value):
        """a **Heading** (§3): the icon, the name, the rule as far as the value, the value muted"""
        rule = w - 3 - cols(name) - 1 - cols(value) - 1
        runs = [(self.icon(icon), ACCENT_TEXT), ("  ", ""), (name, STRONG)]
        if rule >= 1:
            runs += [(" ", ""), ("─" * rule, EDGE2), (" ", ""), (value, MUTED)]
        put(r, x, runs)

    def lesson_row(self, le, lw, quiet=False):
        """a row (§7): its mark at column 1, its part's icon at 6, its name at 9, the time right-aligned
        at the last column. Under the cursor every ink is the lacquer's, from the cursor's column to
        the one past the content; quiet: what comes next, told, not to do yet"""
        done = le["id"] in self.course.done
        if done:
            mark, ink = self.icon("CHECK"), MUTED
        elif le is self.course.next_lesson():
            mark, ink = self.icon("SEAL"), ACCENT_TEXT
        else:
            mark, ink = " ", ""
        part = self.icon(PART_ICON[le["part"]])
        value = how_long(le["minutes"])
        room = lw - 9 - cols(value) - 2
        # (a narrow tile: the name's end goes, at a word, nothing in its place; the time stays)
        title = plain(wrap([(le["title"], "")], max(1, room))[0]) if cols(le["title"]) > room else le["title"]
        pad = " " * max(2, lw - 9 - cols(title) - cols(value))
        if le is self.cursor:
            s = mix(SELECT, ON_SELECT)
            return [("  ", s), (mark, s), ("    ", s), (part, s), ("  ", s), (title, s), (pad, s), (value, s), (" ", s)]
        if quiet:
            return [("      ", ""), (part, FAINT), ("  ", ""), (title, MUTED), (pad, ""), (value, FAINT)]
        return [(" ", ""), (mark, ink), ("    ", ""), (part, MUTED if done else ACCENT_TEXT), ("  ", ""), (title, MUTED if done else ""),
                (pad, ""), (value, FAINT if done else MUTED)]

    def draw_pane(self, put, x, w, rows):
        le = self.cursor
        course = self.course
        rule = max(0, w - 3 - cols(le["title"]) - 1)
        put(1, x, [(self.icon(PART_ICON[le["part"]]), ACCENT_TEXT), ("  ", ""), (le["title"], STRONG)]
            + ([(" ", ""), ("─" * rule, EDGE2)] if rule else []))
        r = 3
        key = 8

        def fact(k, runs):
            nonlocal r
            put(r, x + 3, [(k, MUTED)])
            put(r, x + 3 + key + 1, runs)
            r += 1

        fact("part", [(f"{le['part']}  {PART_NAME[le['part']]}", "")])
        fact("takes", [(how_long(le["minutes"]), "")])
        fact("check", [("you answer" if le["check"]["kind"] == "ask" else "you run it", "")])
        if le["id"] in course.done:
            fact("stamped", [(pretty_date(course.done[le["id"]]), "")])
        for i, need in enumerate(le["needs"]):
            n = course.by_id[need]
            mark = self.icon("CHECK") if need in course.done else self.icon("BOX_OFF")
            for k, ln in enumerate(wrap([(n["title"], MUTED if need in course.done else "")], w - 3 - key - 1 - 3)):
                fact("needs" if i == 0 and k == 0 else "", ([(mark, MUTED)] if k == 0 else [(" ", "")]) + [("  ", "")] + ln)
        # how far, at the pane's foot (§7 Meter); between it and the facts, what fits whole: the
        # idea's first words, and the lesson's stamp or the ring waiting for it
        foot = rows - 7
        para = le["idea"].split("\n\n")[0]
        words = wrap(inline(" ".join(para.split("\n"))), w - 3) if "```" not in para else []
        if words and r + 1 + len(words) < foot:
            r += 1
            for ln in words:
                put(r, x + 3, ln)
                r += 1
        self.pane_seal = (r + 1, x + 4) if foot - (r + 1) >= SEAL_ROWS + 1 else None
        if foot > r:
            for i, (name, part) in enumerate(((PART_NAME[1], 1), (PART_NAME[2], 2))):
                self.meter(put, foot + i, x, name, *course.count(part))
            self.meter(put, foot + 2, x, "days", *self.days_done())
            put(foot + 3, x + 3, [("left", MUTED)])
            put(foot + 3, x + 3 + key + 1, [(how_long(course.left()), "")])

    def meter(self, put, r, x, name, done, total):
        n = (done * 10 + total - 1) // total if total else 0
        put(r, x + 3, [(name, MUTED)])
        whole = done == total and total
        lit, off = self.icon("READ"), self.icon("READ_OFF")
        put(r, x + 3 + 9, [(lit * n, MUTED if whole else ACCENT_TEXT), (off * (10 - n), EDGE2), (f"  {done} of {total}", MUTED)])

    def key_day(self, k):
        if isinstance(k, tuple):
            return self.mouse_day(k)
        pair = self.course.pair(self.day)
        if k in ("q", "esc", "quit"):
            self.running = False
        elif k in ("j", "down", "k", "up", "tab", "btab"):
            self.cursor = pair[0 if self.cursor is pair[1] else 1]
        elif k in ("g", "home"):
            self.cursor = pair[0]
        elif k in ("G", "end"):
            self.cursor = pair[1]
        elif k in ("h", "left") and self.day[0] > 1:
            self.go_day(self.course.days[self.day[0] - 2])
        elif k in ("l", "right") and self.day[0] < self.last_day()[0]:
            self.go_day(self.course.days[self.day[0]])
        elif k == "enter":
            self.open_lesson(self.cursor)
        elif k == "r":
            self.go_aside("review")
        elif k == "m":
            self.go_aside("map")
        elif k == "a":
            self.go_aside("about")
        elif k == "e":
            self.explain(self.cursor)
        return None

    def explain(self, le):
        """the explain-it-back note of a lesson done, in $EDITOR (the page waits)"""
        if le["id"] not in self.course.done:
            return
        path = self.course.make_note(le)
        self.term.__exit__()
        try:
            subprocess.run([os.environ.get("EDITOR") or "nvim", path], check=False)
        except OSError:
            pass
        self.term.__enter__()
        self.term.wiped = True

    def mouse_day(self, k):
        _, b, x, y, press = k
        if b & 64:                  # the wheel
            if press:
                self.cursor = self.course.pair(self.day)[0 if b & 1 == 0 else 1]
            return
        x0, lw, _ = self.shape()
        hit = self.hits.get(y) if x0 - 1 <= x <= x0 + lw else None
        if b & 32:
            # (motion alone: one light — the cursor goes to the row under the pointer)
            if hit is not None and self.mouse != (x, y):
                self.cursor = hit
            self.mouse = (x, y)
        elif press and b & 3 == 0 and hit is not None:
            self.cursor = hit
            self.open_lesson(hit)

    # ── a lesson ──────────────────────────────────────────────────────────────────────────
    def page_shape(self):
        room = self.term.cols - 4
        w = max(8, min(room, MEASURE))
        return 2 + (room - w) // 2, w

    def open_lesson(self, le, at_block=None):
        self.lesson = le
        self.cursor = le
        self.screen = "page"
        self.answer = False
        self.said = None
        self.asking = None
        self.relayout()
        self.ptop = 0
        self.unroll = time.monotonic()
        if at_block is None:
            where, block = self.course.where()
            at_block = block if where == le["id"] else 0
        if at_block:
            self.to_block(at_block)
        self.term.write(f"\x1b[?1000;1003;1006l\x1b]2;{le['title']}\x1b\\")
        self.term.wiped = True
        self.seal_drawn = None

    def relayout(self):
        _, w = self.page_shape()
        self.page = Page(page_text(self.lesson, self.answer, self.said), self.icons, self.lesson["title"])
        self.lines = self.page.layout(w)
        # the place for the stamp, its rows blank: the seal is drawn over them while they are all in sight
        self.lines.extend(Line([], self.page.block) for _ in range(2))
        self.seal_at = len(self.lines)
        self.lines.extend(Line([], self.page.block, seal=i == 0) for i in range(SEAL_ROWS))
        self.lines.append(Line([], self.page.block))

    def body_height(self):
        return max(1, self.term.rows - 6)

    def to_block(self, block):
        self.ptop = next((i for i, ln in enumerate(self.lines) if ln.block >= block), 0)
        self.clamp()

    def top_block(self):
        return self.lines[self.ptop].block if self.ptop < len(self.lines) else 0

    def clamp(self):
        self.ptop = max(0, min(self.ptop, max(0, len(self.lines) - self.body_height())))

    def at_end(self):
        return self.ptop + self.body_height() >= len(self.lines)

    def draw_page(self):
        rows = self.term.rows
        x0, w = self.page_shape()
        le = self.lesson
        view = self.body_height()
        total = max(1, len(self.lines))
        lines = [""] * rows
        margin = " " * x0
        # the heading: its part's icon, the lesson's name, the rule — vermilion as far as you have read — and its day
        place = f"day {self.course.day_of(le)[0]}"
        name = plain(wrap([(le["title"], "")], max(1, w - 3 - (cols(place) + 3)))[0])
        room = w - 3 - cols(name) - 1 - (cols(place) + 1)
        seen = min(1.0, (self.ptop + view) / total)
        red = room if self.at_end() else int(room * seen)
        head = [(self.icon(PART_ICON[le["part"]]), ACCENT_TEXT), ("  ", ""), (name, STRONG)]
        if room >= 1:      # (a tile too narrow for them: the name alone)
            head += [(" ", ""), ("─" * red, ACCENT), ("─" * (room - red), EDGE2), (" ", ""), (place, MUTED)]
        if rows > 1:
            lines[1] = margin + ansi(head)
        # opening (§11: a scroll unrolling, on a spring: from rest, flowing, settling): the rows come
        # from the top, the rod going down before them, gone for the last 30 % as dwl's fades
        shown = view
        rod = False
        if self.unroll:
            t = (time.monotonic() - self.unroll) / UNROLL
            if t >= 1:
                self.unroll = 0
            else:
                shown = int(view * (1 - math.exp(-7 * t) * (1 + 7 * t)))
                rod = t < 0.7
        for k in range(shown):
            at = self.ptop + k
            r = 3 + k
            if r < rows and at < total:
                lines[r] = margin + ansi(self.lines[at].runs)
        if shown < view:
            if rod and 3 + shown < rows:
                lines[3 + shown] = margin + ansi([("▂" * w, LACQUER)])
            self.show(lines, None, False, "\x1b[?25l")
            return
        tail = "\x1b[?25l"
        if rows > 4:
            lines[rows - 2] = margin + ansi(self.footer(w))
            if self.asking is not None:
                tail = f"\x1b[{rows - 1};{x0 + 4 + cols(self.typed(w))}H\x1b[?25h"
        self.show(lines, self.seal_at_page(x0, view), le["id"] in self.course.done, tail)

    def show(self, lines, pos, done, tail=""):
        """the frame, and the stamp at (row, column), 1-based, or none: the empty ring, or the seal in
        the mood's vermilion — a pixel larger in accent_hi for the thump (§11). A row written again
        loses what it covered, so the seal is painted whenever one of its rows was; where it was
        before is written again, and that wipes it"""
        t = self.term
        hot = done and self.thump > time.monotonic()
        key = (pos, done, hot, self.colours.get("accent"), self.mood())
        last = self.seal_drawn
        if len(t.frame) != len(lines):
            t.frame = [None] * len(lines)
        if last and last[0] and last[0] != pos:
            for r in range(last[0][0] - 1, last[0][0] - 1 + SEAL_ROWS):
                if r < len(t.frame):
                    t.frame[r] = None
        paint = ""
        if pos:
            span = range(pos[0] - 1, min(pos[0] - 1 + SEAL_ROWS, len(lines)))
            if key != last or any(t.frame[r] != lines[r] for r in span):
                mask = self.seals.get(self.mood() if done else "place")
                ink = self.colours.get("accent_hi" if hot else "accent" if done else "edge2")
                if mask and ink:
                    paint = f"\x1b[{pos[0]};{pos[1]}H" + sixel(mask, ink, grow=1 if hot else 0)
                if hot != (last[2] if last else False) or key[:2] != (last[:2] if last else None):
                    for r in span:               # (a seal drawn over an older one: the older first wiped)
                        t.frame[r] = None
        self.seal_drawn = key
        t.draw(lines, paint + tail)

    def seal_at_page(self, x0, view):
        # the end of the lesson: the empty place, or the stamp — whole or not at all
        at = self.seal_at
        if at is not None and at >= self.ptop and at + SEAL_ROWS <= self.ptop + view:
            return (at - self.ptop + 4, x0 + 1)
        return None

    def mood(self):
        try:
            return "light" if os.readlink(os.path.join(CONFIG, "fedokawaii/current")).rstrip("/").endswith("light") else "dark"
        except OSError:
            return "dark"

    def typed(self, w):
        """what was typed, its end when it is longer than the line"""
        s = self.asking
        while cols(s) > max(1, w - 4):
            s = s[1:]
        return s

    def footer(self, w):
        if self.asking is not None:
            return [(self.icon("CHEVRON_RIGHT"), ACCENT_TEXT), ("  ", ""), (self.typed(w), "")]
        le = self.lesson
        done = le["id"] in self.course.done
        out = []

        def key(k, what, state=""):
            if out:
                out.append(("    ", ""))
            out.extend([(k, ""), ("  ", ""), (what, MUTED)])
            if state:
                out.extend([("  ", ""), (state, STRONG)])

        if self.at_end():
            if not done:
                key("enter", "answer it" if le["check"]["kind"] == "ask" else "run it")
            else:
                n = self.after(le)
                key("enter", "next: " + n["title"] if n else "the day")
        key("s", "answer", "on" if self.answer else "")
        return out

    def after(self, le):
        """the other of its pair, while that one waits"""
        return next((x for x in self.course.pair(self.course.day_of(le)) if x["id"] not in self.course.done), None)

    def key_page(self, k):
        if self.asking is not None:
            return self.key_asking(k)
        view = self.body_height()
        if isinstance(k, tuple):
            return None
        if k in ("q", "esc", "quit"):
            if k == "quit":
                self.running = False
            self.leave_page()
        elif k in ("j", "down"):
            self.ptop += 1
        elif k in ("k", "up"):
            self.ptop -= 1
        elif k in (" ", "pgdn", "f"):
            self.ptop += max(1, view - 2)
        elif k in ("b", "pgup"):
            self.ptop -= max(1, view - 2)
        elif k == "d":
            self.ptop += max(1, view // 2)
        elif k == "u":
            self.ptop -= max(1, view // 2)
        elif k in ("g", "home"):
            self.ptop = 0
        elif k in ("G", "end"):
            self.ptop = len(self.lines)
        elif k == "enter":
            if not self.at_end():
                self.ptop += max(1, view - 2)
            elif self.lesson["id"] not in self.course.done:
                self.check()
            else:
                n = self.after(self.lesson)
                self.course.keep_where(self.lesson, 0)
                if n:
                    self.open_lesson(n)
                else:
                    self.leave_page()
        elif k in ("n", "right", "l", "p", "left", "h"):
            self.other()
        elif k == "s":
            self.answer = not self.answer
            self.again(self.top_block())
        self.clamp()
        return None

    def key_asking(self, k):
        if k in ("esc", "quit"):
            self.asking = None
        elif k == "enter":
            words, self.asking = self.asking, None
            if words.strip():
                self.judge(lessons.same_answer(words, self.lesson["check"]["answer"]), {"words": words})
        elif k == "backspace":
            self.asking = self.asking[:-1]
        elif k == "clear":
            self.asking = ""
        elif isinstance(k, str) and len(k) == 1:
            self.asking += k

    def check(self):
        le = self.lesson
        if le["check"]["kind"] == "ask":
            self.asking = ""
            return
        # (it takes the moment it takes, ten seconds at most: said on the footer's line meanwhile)
        self.term.write(f"\x1b[{self.term.rows - 1};{self.page_shape()[0] + 1}H" + ansi([("running", MUTED)]) + "\x1b[K")
        got = lessons.run_check(le["check"], DOJO)
        self.judge(got["passed"], {**got, "in": le["check"]["in"], "exit": le["check"]["exit"]})

    def judge(self, passed, said):
        if passed:
            self.said = None
            self.course.stamp(self.lesson["id"])
            self.thump = time.monotonic() + 0.06
        else:
            self.said = said
        self.again(self.page.block + 1)
        self.ptop = len(self.lines)

    def again(self, block):
        """the page laid out anew, the words at the top kept"""
        self.relayout()
        self.seal_drawn = None
        self.term.wiped = True
        self.to_block(block)

    def other(self):
        pair = self.course.pair(self.course.day_of(self.lesson))
        self.course.keep_where(self.lesson, self.top_block())
        self.open_lesson(pair[0 if self.lesson is pair[1] else 1], at_block=0)

    def leave_page(self):
        self.course.keep_where(self.lesson, self.top_block())
        self.screen = "day"
        self.seal_drawn = None
        self.term.wiped = True
        self.term.write("\x1b]2;lessons\x1b\\")
        self.go_day(self.course.day_of(self.lesson), self.lesson)

    # ── running ───────────────────────────────────────────────────────────────────────────
    def resize(self):
        self.term.size()
        self.term.wiped = True
        self.seal_drawn = None
        if self.screen == "page":
            block = self.top_block()
            self.relayout()
            self.to_block(block)

    def draw(self):
        if self.screen == "day":
            self.draw_day()
        elif self.screen in ("review", "map", "about"):
            self.draw_aside()
        else:
            self.draw_page()

    # ── the review, the map, the week (sb03b) ────────────────────────────────────────────
    def go_aside(self, screen):
        self.screen = screen
        self.term.wiped = True
        self.seal_drawn = None
        if screen == "review":
            self.rv = {"cards": self.course.due(), "i": 0, "shown": False, "right": 0, "wrong": 0}

    def leave_aside(self):
        self.screen = "day"
        self.term.wiped = True
        self.rv = None

    def aside_lines(self, w):
        """(icon, name, value, body): the screen's heading and its lines of runs"""
        c = self.course
        rows = c.reviews()
        body = []
        if self.screen == "review":
            rv = self.rv
            if not rv["cards"]:
                return ("SEAL", "review", "", wrap([("Nothing is due. Come back tomorrow: a day missed costs nothing.", MUTED)], w))
            if rv["i"] >= len(rv["cards"]):
                body = [[(f"{rv['right']} right, {rv['wrong']} to see again soon.", "")], [],
                        [("A wrong one comes back tomorrow; a right one waits longer each time.", MUTED)]]
                return ("SEAL", "review", "done", body)
            q, a, lid = c.deck[rv["cards"][rv["i"]]]
            body = [[(c.by_id[lid]["title"], MUTED)], []] + wrap(inline(q), w)
            if rv["shown"]:
                body += [[], [("─" * min(w, 24), EDGE2)], []] + wrap(inline(a), w)
            return ("SEAL", "review", f"{rv['i'] + 1} of {len(rv['cards'])}", body)
        if self.screen == "map":
            st = review.concepts(c.deck, c.done, rows)
            st = {lid: st.get(lid, "done" if lid in c.done else "new") for d in c.days for lid in d[1:]}   # (no cards: done or not)
            mark = {"new": self.icon("BOX_OFF"), "practising": self.icon("READ"), "learned": self.icon("CHECK"), "done": self.icon("CHECK")}
            ink = {"new": FAINT, "practising": ACCENT_TEXT, "learned": MUTED, "done": MUTED}
            for d in c.days:
                for lid in d[1:]:
                    body.append([(mark[st[lid]], ink[st[lid]]), ("  ", ""), (c.by_id[lid]["title"], "" if st[lid] != "new" else FAINT),
                                 ("  " + st[lid], MUTED)])
            return ("MORTARBOARD", "concept map", f"{sum(1 for v in st.values() if v == 'learned')} learned", body)
        wk = review.look_back(c.done, rows, time.strftime("%Y-%m-%d"))
        belt, pts = review.rank(c.done, rows)
        body = [[("this week", STRONG)],
                [(f"{wk['lessons']} lessons  ·  {wk['right']} right  ·  {wk['wrong']} to see again  ·  {wk['days']} of 7 days", "")], [],
                [("rank", STRONG)], [(f"{belt}, {pts} points: a lesson five, a right answer one. It only grows.", "")], [],
                [("why it works", STRONG)]]
        for t in ("Worked examples first (Sweller and Cooper, 1985).",
                  "Asking yourself beats rereading (Roediger and Karpicke, 2006).",
                  "Review after 1, 3, 7, 14 days (Cepeda and others, 2006).",
                  "Words and pictures together (Mayer, Multimedia Learning)."):
            body += wrap([("· " + t, MUTED)], w)
        return ("MORTARBOARD", "this week", "", body)

    def draw_aside(self):
        rows, w = self.term.rows, max(1, min(MEASURE, self.term.cols - 4))
        x0 = max(1, (self.term.cols - w) // 2)
        icon, name, value, body = self.aside_lines(w)
        body = [ln for runs in body for ln in (wrap(runs, w) if runs else [[]])]
        name = plain(wrap([(name, "")], max(1, w - 3))[0])
        lines = [""] * rows
        margin = " " * x0
        rule = w - 3 - cols(name) - 1 - cols(value) - 1
        head = [(self.icon(icon), ACCENT_TEXT), ("  ", ""), (name, STRONG)]
        if rule >= 1:
            head += [(" ", ""), ("─" * rule, EDGE2), (" ", ""), (value, MUTED)]
        if rows > 1:
            lines[1] = margin + ansi(head)
        for k, runs in enumerate(body[:max(0, rows - 6)]):
            lines[3 + k] = margin + ansi(runs)
        if rows > 4:
            lines[rows - 2] = margin + ansi(wrap([(self.aside_keys(), MUTED)], w)[0])
        self.term.draw(lines, "\x1b[?25l")

    def aside_keys(self):
        rv = self.rv
        if self.screen != "review" or not rv["cards"] or rv["i"] >= len(rv["cards"]):
            return "Esc back"
        return "y right  ·  n wrong  ·  Esc back" if rv["shown"] else "think of the answer first  ·  Space shows it  ·  Esc back"

    def key_aside(self, k):
        if isinstance(k, tuple):
            return
        if k in ("q", "esc", "quit") or (k == "enter" and self.screen != "review"):
            self.leave_aside()
            return
        rv = self.rv
        if self.screen != "review" or not rv["cards"] or rv["i"] >= len(rv["cards"]):
            return
        if not rv["shown"]:
            if k in (" ", "enter"):
                rv["shown"] = True
        elif k in ("y", "n"):
            self.course.answer(rv["cards"][rv["i"]], k == "y")
            rv["right" if k == "y" else "wrong"] += 1
            rv["i"] += 1
            rv["shown"] = False

    def run(self, start=None):
        r, w = os.pipe()
        os.set_blocking(w, False)
        signal.set_wakeup_fd(w, warn_on_full_buffer=False)
        signal.signal(signal.SIGWINCH, lambda *_: None)
        signal.signal(signal.SIGTERM, lambda *_: setattr(self, "running", False))
        signal.signal(signal.SIGHUP, lambda *_: setattr(self, "running", False))
        with self.term:
            self.resize()
            if start:
                self.open_lesson(start)
            self.course.write_place()
            size = (self.term.rows, self.term.cols)
            while self.running:
                self.draw()
                wait = None
                if self.thump:
                    wait = max(0.0, self.thump - time.monotonic())
                if self.unroll:
                    wait = 0.007        # (a frame of its own, at every refresh: nothing waits for it)
                ready, _, _ = select.select([0, r], [], [], wait)
                if self.thump and time.monotonic() >= self.thump:
                    self.thump = 0
                if r in ready:
                    os.read(r, 256)
                    try:
                        sz = os.get_terminal_size(1)
                    except OSError:
                        sz = None
                    if sz and (sz.lines, sz.columns) != size:
                        size = (sz.lines, sz.columns)
                        self.resize()
                if 0 in ready:
                    data = os.read(0, 4096)
                    if not data:
                        self.running = False
                        break
                    self.unroll = 0             # (a key acts at once on where things are going: §6)
                    for k in decode(data):
                        if isinstance(k, tuple) and k[0] == "theme":
                            self.colours = theme_colours()
                            self.seal_drawn = None
                        elif self.screen == "day":
                            self.key_day(k)
                        elif self.screen != "page":
                            self.key_aside(k)
                        else:
                            self.key_page(k)
            if self.screen == "page":
                self.course.keep_where(self.lesson, self.top_block())
        return 0


# ── plain text: a text console ──────────────────────────────────────────────────────────────
CONSOLE = str.maketrans({"—": "-", "–": "-", "·": "-", "•": "*", "→": "->", "←": "<-", "↳": ">", "│": "|", "─": "-",
                         "×": "x", "✓": "v", "✗": "x", "“": '"', "”": '"', "‘": "'", "’": "'", "§": "s."})


def text_lesson(course, le, width, answer=False):
    page = Page(page_text(le, answer), {}, le["title"])
    page.hl = {}
    place = f"day {course.day_of(le)[0]} of {len(course.days)}"
    out = "\n".join([f"{le['title']} — {place}", ""] + [plain(ln.runs).rstrip() for ln in page.layout(width)]) + "\n"
    # (a text console's font has few of these signs; a terminal has them all)
    return out.translate(CONSOLE) if os.environ.get("TERM") == "linux" else out


def text_check(course, le, width):
    """the check on a console: True when it passed and is stamped, False when you stopped"""
    c = le["check"]
    while True:
        print(c["ask"] + " (? its answer, q stops) " if c["kind"] == "ask" else
              f"{le['title']}: enter runs its check (? its answer, q stops) ", end="", flush=True)
        try:
            words = sys.stdin.readline()
        except KeyboardInterrupt:
            return False
        words = words.strip()
        if not sys.stdin.isatty() or words == "q":
            return False
        if words == "?":
            print(answer_text(le))
            continue
        if c["kind"] == "ask":
            passed = lessons.same_answer(words, c["answer"])
            said = {"words": words}
        else:
            got = lessons.run_check(c, DOJO)
            passed, said = got["passed"], {**got, "in": c["in"], "exit": c["exit"]}
        if passed:
            course.stamp(le["id"])
            return True
        print("not yet. " + said_text(said))


def text_mode(course, args):
    width = None
    if "--cols" in args:
        i = args.index("--cols")
        try:
            width = int(args[i + 1])
        except (IndexError, ValueError):
            print("usage: kawa-learn --text [ID] [--cols N]", file=sys.stderr)
            return 2
        del args[i:i + 2]
    if len(args) > 1:
        print("usage: kawa-learn --text [ID] [--cols N]", file=sys.stderr)
        return 2
    le = course.by_id.get(args[0]) if args else course.next_lesson()
    if args and not le:
        print(f"kawa-learn: no lesson {args[0]}", file=sys.stderr)
        return 1
    if not le:
        print("nothing to do today.")
        return 0
    if width is None:
        try:
            width = os.get_terminal_size(1).columns - 1
        except OSError:
            width = 80
    width = max(8, min(width, MEASURE))
    if not sys.stdout.isatty():
        sys.stdout.write(text_lesson(course, le, width))
        return 0
    while le:
        subprocess.run(["less", "-c"], input=text_lesson(course, le, width), text=True, check=False)
        if not text_check(course, le, width):
            return 0
        le = course.next_lesson()
    print("nothing more today.")
    return 0


def main(args):
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__)
        return 0
    if lessons is None:
        print(f"kawa-learn: {LIB}/lessons.py cannot be read — fedokawaii repair puts it back", file=sys.stderr)
        return 1
    try:
        course = Course()
    except (OSError, lessons.Fault) as e:
        print(f"kawa-learn: the lessons cannot be read ({LEARN}: {e}) — fedokawaii repair puts them back", file=sys.stderr)
        return 1
    if not course.days:
        print(f"kawa-learn: no lessons in {LEARN} — fedokawaii repair puts them back", file=sys.stderr)
        return 1
    if args[:1] == ["--text"]:
        return text_mode(course, args[1:])
    if args[:1] == ["--place"]:
        course.write_place()
        show = course.place()[0]
        n = course.next_lesson()
        print(f"day {show[0] if show else len(course.days)} of {len(course.days)}" + (f" · next: {n['title']}" if n else ""))
        return 0
    start = None
    if args:
        start = course.by_id.get(args[0])
        if not start or len(args) > 1:
            print("usage: kawa-learn [ID | --text [ID] | --place]", file=sys.stderr)
            return 2
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("kawa-learn: it needs a terminal (--text prints a lesson)", file=sys.stderr)
        return 2
    return App(course).run(start)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
