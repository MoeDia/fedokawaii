#!/usr/bin/env bash
# kawa-notes — Super+N: your notes, in a small floating window; Super+N again puts it away
# (a warm window: kawa-warm keeps it running, so it shows in the frame).
# One plain file, ~/Notes/notes.md, read top to bottom like a diary: each day you write
# something starts with its date as a heading, and the window opens at the end, ready to
# type. It is neovim (the desktop's editor, its keys and colours), saving as you type —
# whichever way the window goes, nothing is lost. A day you opened but wrote nothing under
# leaves no heading behind.
#
# (Its own parts: --inside [--shown], what runs in the window; --today, today's heading;
# --tidy, the end of the file tidied — the page runs these two as it shows and goes.)
set -u
NOTES=${KAWA_NOTES:-$HOME/Notes/notes.md}
SOCK=${XDG_RUNTIME_DIR:?}/kawa-notes.nvim     # the page's neovim listens here (kawa-warm: --shown/--hidden)
today=$(LC_ALL=C date '+%Y-%m-%d · %a')     # (English day names: any locale)
HEAD="## $today"

case ${1:-} in
  "") exec kawa-warm notes ;;
  --today|--tidy) ;;
  --inside)                               # in the window: neovim
    # as a page, a text screen's heading and footer, with notes.lua as its whole configuration
    # (not LazyVim: the window has its text as it appears; notes.lua says), at the end of
    # the file, on a fresh line, typing. No swap file (-n): every change is in the file
    # itself at once, and a window closed under neovim (Super+Q) would leave one behind —
    # and with it a "Found a swap file" question in the next window. No ShaDa (-i NONE): the
    # page needs no registers, marks or search history from other sessions, and does not wait
    # to read and write them as it opens and closes. It listens on $SOCK: put away and shown
    # again (kawa-warm), it is saved and tidied, then opens at today's note (notes.lua); shown
    # as it starts (--shown), that at once. Ended (:q, or its window closed), the file tidied
    mkdir -p "${NOTES%/*}" || exit 1
    rm -f "$SOCK"
    first=(); [[ ${2:-} == --shown ]] && first=(-c 'lua kawa_notes_shown()')
    KAWA_NOTES_WHERE=${NOTES/#"$HOME"/\~} \
      nvim -n -i NONE --listen "$SOCK" -u ~/.config/fedokawaii/notes.lua "${first[@]}" -- "$NOTES"
    "$0" --tidy; exit 0 ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-notes   (Super+N: your notes, ~/Notes/notes.md)" >&2; exit 2 ;;
esac

# notes written on Windows end their lines in CR LF: what is added here does the same (the
# window keeps them so too) — a file of both kinds shows a ^M at the end of every old line
nl=$'\n'
{ IFS= read -r first <"$NOTES" && [[ $first == *$'\r' ]] && nl=$'\r\n'; } 2>/dev/null
# --today: today's heading, once a day — a blank line, the heading, a blank line (the page
# then opens a new line under it)
if [[ $1 == --today ]]; then
  mkdir -p "${NOTES%/*}" || exit 1
  if ! grep -qxF -e "$HEAD" -e "$HEAD"$'\r' "$NOTES" 2>/dev/null; then
    if [[ ! -s $NOTES ]]; then printf '%s\n\n' "$HEAD" >"$NOTES"
    elif [[ -n $(tail -c1 "$NOTES") ]]; then printf '%s' "$nl$nl$HEAD$nl$nl" >>"$NOTES"   # (it ended mid-line)
    else printf '%s' "$nl$HEAD$nl$nl" >>"$NOTES"; fi
  fi
  exit 0
fi
# --tidy:
sync -- "$NOTES" 2>/dev/null               # (the window writes without waiting for the disk)
# tidy the end: no empty lines left by a fresh line you did not use — and a heading with
# nothing under it goes too, with the blank line before it
# — only the end of the file is read (a diary years long tidies as fast as a new one), and
# the result is written beside it and moved over it in one step, so a full disk or a crash
# at that moment leaves the diary as it was, never half-written
if [[ -s $NOTES ]]; then
  real=$(readlink -f -- "$NOTES")
  LC_ALL=C                                 # (bytes from here on: lengths are file offsets)
  size=$(stat -c %s -- "$real") || exit 0
  { end=$(tail -c 65536 -- "$real"; printf x); } 2>/dev/null; end=${end%x}
  ((${#end} == (size < 65536 ? size : 65536))) || exit 0   # (a NUL byte: left as it is)
  t=${end%"${end##*[![:space:]]}"}         # the end without its trailing blanks
  # (a day's heading, today's or the day the page showed — put away after midnight)
  if [[ ${t##*$'\n'} =~ ^##\ [0-9]{4}-[0-9]{2}-[0-9]{2}\ ·\ [[:alpha:]]{3}$ ]]; then
    t=${t%"${t##*$'\n'}"}; t=${t%"${t##*[![:space:]]}"}
  fi
  if [[ -n $t ]]; then [[ $end == "$t$nl" ]] && exit 0                    # (already tidy)
  elif ((size > ${#end})); then exit 0; fi  # (blank for longer than that: left as it is)
  keep=$(( size - ${#end} + ${#t} ))
  tmp=$(mktemp -- "$real.XXXXXX") || exit 0
  if { head -c "$keep" -- "$real" && { ((keep == 0)) || printf '%s' "$nl"; }; } >"$tmp" && sync -- "$tmp" 2>/dev/null; then
    chmod --reference="$real" -- "$tmp" 2>/dev/null; mv -f -- "$tmp" "$real"
  else rm -f -- "$tmp"; fi
fi
exit 0
