#!/usr/bin/env bash
# kawa-dwlstatus — reads dwl's status stream on stdin (dwl -s) and writes small JSON
# files for waybar's custom modules, then pokes only the modules that changed:
#   SIGRTMIN+8 workspaces · +9 layout · +10 window title · +11 keyboard layout
# `kawa-dwlstatus --poke N…` pokes waybar the same careful way for others, and wakes the bar's
# long-running modules (kawa-timer, kawa-mem, kawa-volume: each waits on a fifo of its own,
# $XDG_RUNTIME_DIR/kawa-bar.wake.PID), then exits; `kawa-dwlstatus --wake` only wakes them.
# The signals, one per module (an opener pokes its module as its menu opens and as it closes:
# the module is lit meanwhile — kawa-bar):
#   +12 the mode seal (quick settings, the screen-share portal; and with every +15: its click
#       opens quick settings too) · +13 the drive mark (kawa-drives) · +14 the brightness
#   (kawa-brightness, its slider) · +15 the cat (quick settings) · +16 the volume (the sound
#   panel; a fifo wake) · +17 Steam's gamepad · +18 the weather · +19 the date and its day
#   (the calendar) · +20 the torii (the launcher) — the menus' through kawa-menu
# Exit status: 0 the stream ended (dwl is gone) or poked · 1 no runtime folder · 2 misuse.
#
# dwl prints these lines per monitor (the last one comes from src/dwl/dwl.patch):
#   <mon> title <text> · appid · fullscreen · floating · selmon <0|1>
#   <mon> tags <occupied> <selected> <focused-client> <urgent> · <mon> layout <sym>
#   <mon> kblayout <n>      the active keyboard layout, 0 = first of XKB_DEFAULT_LAYOUT
#
# Workspaces: 1–3 are always shown; 4–9 appear only while they hold a window, are
# selected or are urgent. Each is its own waybar module (custom/tag1 … tag9) so the
# stylesheet can draw it as a key: raised when occupied, pressed when selected.
# Each monitor's bar shows that monitor: its workspaces, layout and window title go to
# dwl-bar/<monitor>/ (waybar names the bar's monitor to the module: WAYBAR_OUTPUT_NAME);
# dwl-bar/ itself holds the focused monitor's, for a bar that is told no name. The keyboard
# layout is one for all (dwl-bar/kb.json).
# No forks per update but the rename that makes each file appear whole (the signals come
# from bash's own kill).
set -u
# one fixed locale for bash's own work: control characters as UTF-8 sees them, and the
# layout names in plain capitals (a Turkish locale would make "ir" İR); plain C should this
# system have no C.UTF-8 (the patterns use classes, not a-z, so they hold in any locale)
{ LC_ALL=C.UTF-8; } 2>/dev/null
t=i; [[ ${t^^} == I ]] || LC_ALL=C

WB=""
poke() {   # poke N… — SIGRTMIN+N to waybar, but only once it catches them: until waybar has
  local k v n c   # installed its handlers, a real-time signal's default action kills it
  if [[ -z $WB ]] || ! { read -r c <"/proc/$WB/comm"; } 2>/dev/null || [[ $c != waybar ]]; then
    WB=$(pgrep -nxu "$UID" waybar) || { WB=""; return 0; }      # not running (yet): it reads the files
  fi                                                    # itself when it starts
  while read -r k v; do
    [[ $k == SigCgt: ]] || continue
    for n; do (( 16#$v >> (33 + n) & 1 )) && kill -s "RTMIN+$n" "$WB" 2>/dev/null; done
    return 0
  done 2>/dev/null <"/proc/$WB/status"   # (it may have just exited)
  return 0
}
wake() {   # the bar's long-running modules look again (what they show, and whether their menu
  # is open): a line into each one's fifo — opened read-write, so it never blocks, read or not;
  # the fifo of one that is gone (its pid dead) is taken away
  local w run=${XDG_RUNTIME_DIR:-}
  [[ -n $run ]] || return 0
  for w in "$run"/kawa-bar.wake.*; do
    [[ -p $w ]] || continue
    if kill -0 "${w##*.}" 2>/dev/null; then { printf '\n' 1<>"$w"; } 2>/dev/null
    else rm -f -- "$w"; fi
  done
  return 0
}
case ${1:-} in
  "") ;;
  --poke)   # (numbers only: each goes into (( )), where a word is read as a variable or an expression)
    shift
    (($#)) || { echo "usage: kawa-dwlstatus --poke N…" >&2; exit 2; }
    for n; do [[ $n =~ ^[0-9]{1,2}$ ]] && ((n <= 30)) || { echo "kawa-dwlstatus: --poke takes signal numbers 0–30, not $n" >&2; exit 2; }; done
    # quick settings opened or closed (+15): the mode seal too, whose click opens them
    [[ " $* " == *" 15 "* && " $* " != *" 12 "* ]] && set -- "$@" 12
    poke "$@"; wake; exit 0 ;;
  --wake) (($# == 1)) || { echo "usage: kawa-dwlstatus --wake" >&2; exit 2; }
    wake; exit 0 ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-dwlstatus < dwl's status · kawa-dwlstatus --poke N… · kawa-dwlstatus --wake (kawa-dwlstatus --help)" >&2; exit 2 ;;
esac

# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# the workspaces by their kanji numerals, as the bar shows them
KANJI=(一 二 三 四 五 六 七 八 九)
DIR="${XDG_RUNTIME_DIR:?}/dwl-bar"
mkdir -p "$DIR" || exit 1
ALWAYS=3

declare -A OCC SEL URG TITLE LAYOUT KB LAST
SELMON=""
# keyboard layouts as the session set them (start-dwl): "us,ara" → US AR
IFS=, read -r -a KBNAMES <<<"${XKB_DEFAULT_LAYOUT:-us}"

put() {   # put NAME JSON — DIR/NAME.json (NAME may be MONITOR/…): atomic, and only when it changed;
  # remembered only once written, so a write that failed (the runtime folder full) is tried
  # again with the next status instead of leaving the bar behind for good
  [[ ${LAST[$1]:-} == "$2" ]] && return 1
  { printf '%s\n' "$2" >"$DIR/$1.tmp" && mv -f "$DIR/$1.tmp" "$DIR/$1.json"; } 2>/dev/null || return 1
  LAST[$1]=$2
}

esc() {   # esc VAR TEXT — JSON + pango escaping into VAR (a variable, not $(…): no subshell)
  local s=$2
  s=${s//[[:cntrl:]]/ }                                    # tabs, ESC, CR: not valid in JSON
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//&/"&amp;"}; s=${s//</"&lt;"}; s=${s//>/"&gt;"}   # quoted: bash 5.2 treats a bare & as "the match"
  printf -v "$1" '%s' "$s"
}

emit() {   # emit MONITOR — its files (and the focused one's at the top), then the pokes
  local mon=$1 i bit cls tg=0 ly=0 tt=0 kc=0 at
  local -a to=("$mon/")
  [[ -z $SELMON || $mon == "$SELMON" ]] && to+=("")
  if [[ ! -d $DIR/$mon ]]; then
    [[ -d $DIR ]] || LAST=()       # the whole folder gone (deleted under it): write everything again
    mkdir -p "$DIR/$mon" 2>/dev/null || return 0
  fi
  for ((i = 1; i <= 9; i++)); do
    bit=$((1 << (i - 1)))
    if   (( ${URG[$mon]:-0} & bit )); then cls=urgent
    elif (( ${SEL[$mon]:-0} & bit )); then cls=selected
    elif (( ${OCC[$mon]:-0} & bit )); then cls=occupied
    elif (( i <= ALWAYS ));            then cls=empty
    else cls=""; fi
    for at in "${to[@]}"; do
      if [[ -n $cls ]]; then put "${at}tag$i" "{\"text\":\"${KANJI[i - 1]}\",\"class\":[\"tag\",\"$cls\"]}" && tg=1
      else put "${at}tag$i" '{"text":""}' && tg=1; fi
    done
  done
  # the layout as a pixel icon (dwl's symbols: (@) spiral, ||| columns, ><> floating)
  local lt=${LAYOUT[$mon]:-(@)} icon cls title
  case $lt in
    '(@)')       icon=$ICON_SPIRAL cls=spiral ;;
    '|||')       icon=$ICON_TILE cls=columns ;;
    '><>')       icon=$ICON_FLOAT cls=float ;;
    *)           icon=$lt cls=other ;;
  esac
  # the title: 60 letters at most, cut at a word's end — never "…" (waybar's max-length
  # would add one)
  title=${TITLE[$mon]:-}
  if ((${#title} > 60)); then
    [[ ${title:60:1} == ' ' ]] && title=${title:0:60} || { title=${title:0:60}; [[ $title == *' '* ]] && title=${title% *}; }
    title=${title%"${title##*[! ]}"}
  fi
  esc icon "$icon"; esc title "$title"
  for at in "${to[@]}"; do
    put "${at}layout" "{\"text\":\"$icon\",\"class\":\"$cls\"}" && ly=1
    put "${at}title" "{\"text\":\"$title\"}" && tt=1
  done
  # the keyboard layout, shown only when there is more than one to switch between
  local k=${KB[$mon]:-0} name="" which=first
  if ((${#KBNAMES[@]} > 1)); then
    name=${KBNAMES[k]:-?}; name=${name:0:2}; ((k)) && which=other
    put kb "{\"text\":\"${name^^}\",\"class\":\"$which\"}" && kc=1
  else
    put kb '{"text":""}' && kc=1
  fi
  local sigs=()
  ((tg)) && sigs+=(8); ((ly)) && sigs+=(9); ((tt)) && sigs+=(10); ((kc)) && sigs+=(11)
  ((${#sigs[@]})) && poke "${sigs[@]}"
  return 0
}

# Only whole values are taken: when the pipe was full (the reader held up), dwl drops what it
# cannot write, and a cut line can run into the next ("DP-1 layout []DP-1 kblayout 0") — such
# a line is passed over, and the next whole status puts the bar right.
while IFS=' ' read -r mon kind rest; do
  case $kind in
    tags)   IFS=' ' read -r occ sel _ urg <<<"$rest"
            [[ $occ$sel${urg:-0} =~ ^[0-9]+$ ]] || continue   # numbers only: they go into (( ))
            OCC[$mon]=$occ; SEL[$mon]=$sel; URG[$mon]=${urg:-0} ;;
    title)  TITLE[$mon]=$rest ;;
    layout|kblayout)                       # layout ends an unpatched dwl's block, kblayout ours
            if [[ $kind == layout ]]; then
              [[ ${#rest} -le 15 && $rest != *' '* ]] || continue   # dwl's symbol: 15 bytes at most
              LAYOUT[$mon]=$rest
            else
              [[ $rest =~ ^[0-9]{1,2}$ ]] || continue
              KB[$mon]=$rest
            fi
            [[ $mon =~ ^[[:alnum:]][[:alnum:]_.-]*$ ]] && emit "$mon" ;;   # (the name becomes a folder)
    selmon) [[ $rest == 1 ]] && SELMON=$mon ;;
  esac
done
exit 0
