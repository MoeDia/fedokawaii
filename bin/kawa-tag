#!/usr/bin/env bash
# kawa-tag N — what clicking workspace N in the bar does: presses Super+N through a
# virtual keyboard (wtype), so dwl switches exactly as if you had pressed it.
# Exit status: 0 pressed · 1 could not (wtype missing or refused) · 2 misuse.
set -u
case ${1:-} in
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
esac
[[ $# == 1 && $1 =~ ^[1-9]$ ]] || { echo "usage: kawa-tag 1-9" >&2; exit 2; }
# (a click that does nothing would say nothing: the bar's clicks have no terminal to print to)
command -v wtype >/dev/null || {
  echo "kawa-tag: wtype is missing" >&2
  notify-send -a desktop "Workspaces" "wtype is missing, so the bar cannot switch workspaces: fedokawaii repair puts it back" 2>/dev/null
  exit 1
}
exec wtype -M logo -k "$1" -m logo
