#!/usr/bin/env bash
# kawa-nowplaying — what is playing (Spotify's web player, mpv, a video in Brave…), on the bar:
#
#   ▁▃▅▇▅▃▂▁  Wed 21 Oct ┆ 水 ┆ 09:14:08 PM  ▁▂▃▅▇▅▃▁      ┆ ⌸ title  artist ┆ …
#
#   the wings   the sound's spectrum either side of the clock in the middle — the left
#               channel on the left, the right on the right, 8 bands each, the lowest notes
#               nearest the clock: thin columns (2 px, 2 apart) rising in one piece, their ink
#               by height — the floor all but the cloth, low ones faint, the middle muted, the
#               tall ones the text's: one warm grey, no colour. Drawn with the eq-* pixel
#               icons, in two modules of their own (kawa-nowplaying --wing left|right)
#   the label   a cell on the right: a cassette whose reels turn while there is sound, the
#               title, and after it, quieter, the artist
#   paused      a pause icon, the title in grey and no wings; no player → hidden
#
# The wings are written by this one script (one cava for both): each wing module reads a
# fifo of its own ($XDG_RUNTIME_DIR/kawa-nowplaying/wing-left|right, made by the wing), and
# this script writes a frame into each while its wing is running (its pid file says so —
# asked once a second, no process started), never into one nobody reads.
#
# Several players at once (music in Spotify, a paused video in a Brave tab): the one
# playing is shown — the last to start, if more than one is — else the last one paused.
#
# Two event streams merged into one pipe, nothing polled: playerctl --follow (track and
# play state) and cava (60 meter frames a second, started only while a player plays: about 2–3 %
# of a core for waybar to draw them). cava listens to the default output — what you hear,
# whatever plays it — and is started again on the output that becomes the default (headphones
# plugged in, a Bluetooth headset), as PipeWire's own default (pw-metadata) says. Without cava
# the cassette and title still show, with no meter. Pure bash per frame: no forks.
#
# kawa-nowplaying --wing left|right — a wing's module: its fifo's frames, as they come.
# kawa-nowplaying play-pause|next|previous — the media keys and the bar's clicks: they go to
# the player the bar shows. (playerctl on its own picks the player that started first: with
# music playing, Play/Pause would start the paused video on top of it.)
# Exit status: 0 done (the bar's script: its watcher ended, waybar starts it again) · 1 could
# not (no player, playerctl missing) · 2 misuse.
set -u
US=$'\x1f'                                       # between the fields of a player's line
SHOWN="${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-nowplaying.player"   # the player shown, for the keys
case ${1:-} in
  play-pause|next|previous)
    command -v playerctl >/dev/null || exit 1
    p=$(cat "$SHOWN" 2>/dev/null) play=""
    # (asked again, should the bar lag behind or not run: a playing player goes first, the
    # one shown if it is among them)
    while IFS=$US read -r i s; do
      [[ $s == Playing ]] || continue
      [[ $i == "$p" ]] && { play=$i; break; }
      [[ -n $play ]] || play=$i
    done < <(timeout 2 playerctl --all-players metadata --format "{{playerInstance}}$US{{status}}" 2>/dev/null)
    p=${play:-$p}
    [[ -n $p ]] && timeout 2 playerctl --player="$p" "$1" 2>/dev/null && exit 0
    exec playerctl "$1" ;;                       # (the bar not running, or its player gone)
  --wing)
    [[ ${2:-} == @(left|right) ]] || { echo "usage: kawa-nowplaying --wing left|right" >&2; exit 2; }
    dir=${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-nowplaying
    mkdir -p -m 700 -- "$dir" || exit 1
    fifo=$dir/wing-$2
    [[ -p $fifo ]] || { rm -f -- "$fifo"; mkfifo -m 600 -- "$fifo" || exit 1; }
    exec {fd}<>"$fifo"                           # (read and write: never an end of file)
    printf '%s\n' "$$" >"$fifo.pid"
    trap 'rm -f -- "$fifo.pid"' EXIT
    trap 'exit 0' TERM HUP INT
    printf '{"text":""}\n'
    while IFS= read -r -u "$fd" l; do printf '%s\n' "$l" 2>/dev/null || exit 0; done
    exit 0 ;;
  "") ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-nowplaying [play-pause|next|previous] (kawa-nowplaying --help)" >&2; exit 2 ;;
esac
LC_ALL=C.UTF-8                                   # count characters, not bytes
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
THEME=""
colours() {   # the C_* colours of the theme in use, read again after a switch (bash alone: is
  # current the light theme's folder?) — the meter keeps its colours inside its own text
  local t=dark
  [[ $HOME/.config/fedokawaii/current -ef $HOME/.config/fedokawaii/themes/light ]] && t=light
  [[ $t == "$THEME" ]] && return 0
  # shellcheck source=/dev/null
  . "$HOME/.config/fedokawaii/current/colors.sh"
  THEME=$t
  # the meter's inks by height, quiet to bright: the floor (0) all but the cloth, the low
  # columns faint, the middle muted, the tall ones the text's — one warm grey, no colour
  TIER=("$C_EDGE2" "$C_FAINT" "$C_FAINT" "$C_MUTED" "$C_MUTED" "$C_TEXT" "$C_TEXT")
  EQ=("$ICON_EQ_0" "$ICON_EQ_1" "$ICON_EQ_2" "$ICON_EQ_3" "$ICON_EQ_4" "$ICON_EQ_5" "$ICON_EQ_6")
}
colours
MAX=40                                           # longest "title  artist" (each cut at a word)
MAXA=16                                          # longest artist: a long one (several names
                                                 # in a row) would leave no room for the title

esc() {   # esc VAR TEXT — JSON + pango escaping into VAR
  local s=$2
  s=${s//[[:cntrl:]]/ }                          # tabs, ESC, CR: not valid in JSON
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//&/"&amp;"}; s=${s//</"&lt;"}; s=${s//>/"&gt;"}
  printf -v "$1" '%s' "$s"
}

meter() {   # meter VAR DIGITS — "036410" → one eq glyph per band (0–6), each in its tier's ink
  local s=$2 o="" i d
  for ((i = 0; i < ${#s}; i++)); do
    d=${s:i:1}; [[ $d == [0-6] ]] || d=0
    # shellcheck disable=SC2089  # pango markup going into JSON: single quotes on purpose
    o+="<span color='#${TIER[d]}'>${EQ[d]}</span>"
  done
  printf -v "$1" '%s' "$o"
}

# Where a line may be cut: at a space; on either side of a letter of a script written without
# spaces (Chinese, Japanese, Thai, Lao, Khmer, Myanmar: each letter stands alone there); never
# before a mark that belongs to the letter in front of it (an accent, a vowel sign, an emoji's
# skin tone) nor after a joiner. In code points (LC_ALL=C.UTF-8 above: also in a C session).
# shellcheck disable=SC2089  # (printf's 'C form: the code point of C, no quote kept)
point() { printf -v "$1" '%d' "'$2"; }   # point VAR CHAR — its code point
nospace() {   # nospace CHAR — a letter of a script written without spaces
  local c; point c "$1"
  (( (c >= 0x0E00 && c <= 0x0EFF) || (c >= 0x1000 && c <= 0x109F) || (c >= 0x1780 && c <= 0x17FF) ||
     (c >= 0x2E80 && c <= 0x2FDF) || (c >= 0x3001 && c <= 0x31FF) || (c >= 0x3400 && c <= 0x4DBF) ||
     (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0xF900 && c <= 0xFAFF) || (c >= 0xFF00 && c <= 0xFFEF) ||
     (c >= 0x20000 && c <= 0x3FFFF) ))
}
mark() {   # mark CHAR — part of the letter before it (combining, vowel sign, selector, skin tone)
  local c; point c "$1"
  (( (c >= 0x0300 && c <= 0x036F) || (c >= 0x0483 && c <= 0x0489) || (c >= 0x0591 && c <= 0x05C7) ||
     (c >= 0x0610 && c <= 0x061A) || (c >= 0x064B && c <= 0x065F) || c == 0x0670 ||
     (c >= 0x06D6 && c <= 0x06ED) || (c >= 0x0900 && c <= 0x0903) || (c >= 0x093A && c <= 0x094F) ||
     c == 0x0E31 || (c >= 0x0E34 && c <= 0x0E3A) || (c >= 0x0E47 && c <= 0x0E4E) ||
     c == 0x0EB1 || (c >= 0x0EB4 && c <= 0x0EBC) || (c >= 0x0EC8 && c <= 0x0ECD) ||
     (c >= 0x102B && c <= 0x103E) || (c >= 0x17B4 && c <= 0x17D3) || (c >= 0x1AB0 && c <= 0x1AFF) ||
     (c >= 0x1DC0 && c <= 0x1DFF) || c == 0x200D || (c >= 0x20D0 && c <= 0x20FF) ||
     (c >= 0x3099 && c <= 0x309A) || (c >= 0xFE00 && c <= 0xFE0F) || (c >= 0xFE20 && c <= 0xFE2F) ||
     (c >= 0x1F3FB && c <= 0x1F3FF) || (c >= 0xE0100 && c <= 0xE01EF) ))
}
words() {   # words TEXT N — TEXT in at most N letters, cut where a line may break (above);
            # a single long word of spaced script loses its last letters, never half a letter
  local s=$1 k=$2 a b
  while ((k > 0)); do
    a=${s:k-1:1} b=${s:k:1}
    if [[ $b == ' ' || $a == ' ' ]]; then break; fi
    if ! mark "$b" && [[ $a != $'\u200d' ]] && { nospace "$a" || nospace "$b"; }; then break; fi
    ((k--))
  done
  a=${s:0:k}
  [[ -z ${a//[ —-]/} ]] && {   # no place to break (one long word): at a letter's edge
    k=$2; while ((k > 1)) && { mark "${s:k:1}" || [[ ${s:k-1:1} == $'\u200d' ]]; }; do ((k--)); done
    a=${s:0:k}
  }
  a=${a%"${a##*[! —-]}"}
  printf '%s' "$a"
}
status="" artist="" title="" last="" bands="" reel=0 frames=0
# the wings: their fifos, open while their module runs (WFD: side → fd; WPID: side → its pid)
WDIR=${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-nowplaying
declare -A WFD=() WPID=() WLAST=()
wsec=0
wings_check() {   # wings_check — each wing: open its fifo if its module runs, close it if not
  local side p fd
  for side in left right; do
    p=""; { read -r p <"$WDIR/wing-$side.pid"; } 2>/dev/null
    if [[ $p =~ ^[0-9]+$ ]] && kill -0 "$p" 2>/dev/null && [[ -p $WDIR/wing-$side ]]; then
      [[ -n ${WFD[$side]:-} && ${WPID[$side]:-} == "$p" ]] && continue
      [[ -n ${WFD[$side]:-} ]] && { fd=${WFD[$side]}; exec {fd}>&-; }
      exec {fd}<>"$WDIR/wing-$side" && WFD[$side]=$fd WPID[$side]=$p WLAST[$side]=""
    elif [[ -n ${WFD[$side]:-} ]]; then
      fd=${WFD[$side]}; exec {fd}>&-; unset "WFD[$side]" "WPID[$side]" "WLAST[$side]"
    fi
  done
}
wing() {   # wing SIDE JSON — a frame to a wing, if it runs and it is new
  [[ -n ${WFD[$1]:-} && $2 != "${WLAST[$1]:-}" ]] || return 0
  printf '%s\n' "$2" >&"${WFD[$1]}" 2>/dev/null && WLAST[$1]=$2
}
show() {
  local out t n body ml mr tape a=$artist wl='{"text":""}' wr='{"text":""}'

  colours
  if [[ -z $title || ( $status != Playing && $status != Paused ) ]]; then
    out='{"text":""}'
  else
    # too long: cut at a word's end (a single long word loses its last letters) — never "…"
    ((${#a} > MAXA)) && a=$(words "$a" "$MAXA")
    t=$title n=$((MAX - ${#a} - (${#a} ? 2 : 0)))
    ((${#t} > n)) && t=$(words "$t" "$n")
    esc body "$t"
    if [[ -n $a ]]; then
      esc a "$a"
      # (two spaces, then the artist in the quiet ink: the title is what you look for)
      # shellcheck disable=SC2089  # pango markup going into JSON: single quotes on purpose
      body+="  <span color='#$C_FAINT'>$a</span>"
    fi
    # (ICON_BAR_*: the icon's ink, then exactly 8 px to the words)
    if [[ $status == Paused ]]; then
      out="{\"text\":\"$ICON_BAR_PAUSE$body\",\"class\":\"paused\"}"
    else
      tape=$ICON_BAR_CASSETTE_A; ((reel)) && tape=$ICON_BAR_CASSETTE_B
      out="{\"text\":\"$tape$body\",\"class\":\"playing\"}"
      if [[ -n $bands ]]; then
        meter ml "${bands:0:8}"; meter mr "${bands:8:8}"
        wl="{\"text\":\"$ml\",\"class\":\"playing\"}" wr="{\"text\":\"$mr\",\"class\":\"playing\"}"
      fi
    fi
  fi
  wing left "$wl"; wing right "$wr"
  [[ $out == "$last" ]] && return
  # the bar is gone (waybar ignores SIGPIPE, and so does its child: a write just fails) —
  # end here, cava and playerctl with it, rather than meter music for nobody
  printf '%s\n' "$out" 2>/dev/null || exit 0
  last=$out
}

last='{"text":""}'; printf '%s\n' "$last"         # at once: hidden until a player shows
# One pipe for both streams, told apart by shape: a player line holds \x1f separators (not
# tabs: read would collapse repeats and lose an empty artist), an empty line means no
# player, a cava frame is 16 bands of 0–6 ("0;3;6;…;"). When the player watcher stops,
# END makes this script exit, and waybar starts it again.
# cava runs only while a player plays: no audio capture stream (and no wake-ups) otherwise,
# so the sound card can rest while nothing plays.
FMT="{{playerInstance}}$US{{status}}$US{{artist}}$US{{title}}"
exec {in}< <(
  exec 2>/dev/null
  cv=""
  # (the meter held still while its cava and watch go, then itself: never one left behind)
  stop() { [[ -n $cv ]] && { kill -STOP "$cv"; pkill -P "$cv"; kill "$cv"; kill -CONT "$cv"; } 2>/dev/null; cv=""; }
  # meter — cava on the default output, started again whenever another output becomes the
  # default (cava finds the default once, as it starts). PipeWire's "default" metadata says
  # which: its first line for default.audio.sink is the one cava found, a different one later
  # is a change. Should that watch end (PipeWire restarted), cava runs on and it begins again.
  meter() {
    local c="" w="" l now="" fd
    trap '[[ -n $c ]] && kill "$c"; [[ -n $w ]] && kill "$w"; exit 0' TERM
    cava -p "$HOME/.config/fedokawaii/cava.conf" & c=$!
    while :; do
      exec {fd}< <(exec pw-metadata -n default -m 2>/dev/null); w=$!
      while IFS= read -r -u "$fd" l; do
        [[ $l == *"key:'default.audio.sink'"* ]] || continue
        if [[ -z $now ]]; then now=$l
        elif [[ $l != "$now" ]]; then
          now=$l; kill "$c" 2>/dev/null; wait "$c" 2>/dev/null
          cava -p "$HOME/.config/fedokawaii/cava.conf" & c=$!
        fi
      done
      exec {fd}<&-; w=""
      sleep 1 & wait "$!"                        # (the watch ended: again in a second)
    done
  }
  # pick LINE — what to show after LINE, one player's change: itself if it plays; else a
  # player still playing (a video paused in a tab must not hide the music); else itself if
  # paused, or else another paused one. (One playerctl per change of a player, not per frame.)
  pick() {
    local l s paused=""
    IFS=$US read -r _ s _ <<<"$1"
    [[ $s == Playing ]] && { printf '%s\n' "$1"; return; }
    [[ $s == Paused ]] && paused=$1
    while IFS= read -r l; do
      IFS=$US read -r _ s _ <<<"$l"
      [[ $s == Playing ]] && { printf '%s\n' "$l"; return; }
      [[ -z $paused && $s == Paused ]] && paused=$l
    done < <(timeout 2 playerctl --all-players metadata --format "$FMT")
    printf '%s\n' "${paused:-$1}"
  }
  while IFS= read -r m; do
    [[ -z $m || $m == *"$US"*"$US"*"$US"* ]] || continue   # (the rest of a title holding a line break)
    m=$(pick "$m")
    printf '%s\n' "$m"
    IFS=$US read -r _ s _ <<<"$m"
    if [[ $s == Playing ]]; then
      # (started again should it have ended by itself: PipeWire restarted, say)
      { [[ -z $cv ]] || ! kill -0 "$cv" 2>/dev/null; } && command -v cava >/dev/null \
        && { meter & cv=$!; }
    else stop; fi
  done < <(playerctl --follow metadata --format "$FMT")
  stop                                           # (cava would never notice on its own
  echo END                                       #  that nobody reads it)
)
feeder=$!
# and if this script goes first, take every reader along — the feeder and its meter held still
# meanwhile: one that started cava for a song (or for a new output) just then would leave it
# metering for nobody, for good
# shellcheck disable=SC2090  # (follows from the SC2089 note above: a false alarm)
trap 'kill -STOP "$feeder" 2>/dev/null
      for c in $(pgrep -P "$feeder" 2>/dev/null); do kill -STOP "$c"; pkill -P "$c"; done 2>/dev/null
      pkill -P "$feeder" 2>/dev/null; pkill -CONT -P "$feeder" 2>/dev/null
      kill -TERM "$feeder" 2>/dev/null; kill -CONT "$feeder" 2>/dev/null' EXIT
trap 'exit 0' TERM HUP INT                     # (bash skips the EXIT trap on a bare signal)

player=""
while IFS= read -r -u "$in" line; do
  case $line in
    END)        exit 0 ;;
    '')         status="" artist="" title="" bands="" ;;
    *"$US"*)    IFS=$US read -r p status artist title <<<"$line"
                [[ $p == "$player" ]] || { player=$p; printf '%s\n' "$p" >"$SHOWN"; }
                [[ $status == Playing ]] || bands="" ;;
    *)          frame=${line//;/}
                [[ $status == Playing && ${#frame} == 16 && $frame != *[!0-6]* ]] || continue
                [[ $frame == *[1-5]* ]] && { ((++frames % 12)) || reel=$((1 - reel)); }  # sound: turn the reels (5 a second)
                ((EPOCHSECONDS == wsec)) || { wsec=$EPOCHSECONDS; wings_check; }   # (the wings: once a second)
                bands=$frame ;;
  esac
  [[ $line == *"$US"* || -z $line ]] && wings_check
  show
done
