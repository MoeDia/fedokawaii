#!/usr/bin/env bash
# kawa-sixel RRGGBB < PICTURE > SIXEL — a picture as a sixel for the terminal, drawn exactly.
# The books, clipboard and wallpaper windows draw their pictures with it.
#
#   · pixels in the ground colour RRGGBB — or within one unit of it (sixel colours are whole
#     percents, and ImageMagick's dither scatters such near-ground specks into a margin) —
#     are left undrawn, so the terminal's own background shows there, exact; a picture's
#     margins are invisible to the pixel
#   · ImageMagick marks its sixels "unset pixels: colour 0" and ends them with a band break,
#     so the terminal adds an empty 6 px band in the picture's first colour — on paper, a
#     dark line under it. Here unset pixels stay unset (P2=1) and there is no last break:
#     the picture is exactly its own height
#   · a picture ImageMagick cannot read (cut short, not a picture at all) prints nothing and
#     fails, quietly: the callers are fzf previews, which show whatever lands on stderr, and
#     each says "no preview" its own way
set -o pipefail
[[ ${1:-} == @(-h|--help) ]] && { sed -n '2,/^set -o/{/^set -o/d;s/^# \{0,1\}//;p}' "$0"; exit 0; }
[[ ${1:-} =~ ^[0-9a-fA-F]{6}$ ]] || { echo "usage: kawa-sixel RRGGBB < picture > sixel" >&2; exit 2; }
# (LC_ALL=C: ImageMagick reads "sixel:" through the locale's letter case — in Turkish an i
# is not an I, and it writes a file called "sixel:-" instead)
# shellcheck disable=SC2016  # python, not shell
LC_ALL=C magick - sixel:- 2>/dev/null | python3 -I -c '
import re, sys
g = sys.argv[1]
ground = tuple(int(100 * int(g[i:i + 2], 16) / 255 + 0.5) for i in (0, 2, 4))
s = sys.stdin.buffer.read().decode("latin1")
if not re.match(r"\x1bP[0-9;]*q", s):
    sys.exit(1)                                   # no sixel came out: nothing to draw
s = re.sub(r"^\x1bP(\d*);\d*;", lambda m: "\x1bP" + m[1] + ";1;", s, count=1)
s = re.sub(r"-(\x1b\\)$", r"\1", s)
q = s.index("q") + 1
regs = {m[1] for m in re.finditer(r"#(\d+);2;(\d+);(\d+);(\d+)", s)
        if max(abs(int(v) - w) for v, w in zip(m.groups()[1:], ground)) <= 1}
# the picture data, cut at each colour chosen (or defined and chosen); in the stretches
# drawn in a ground colour every sixel character (? to ~) becomes "?": nothing drawn
# (repeat counts, "$" and "-" are below "?" and stay; the closing ESC \ is kept apart)
end = "\x1b\\" if s.endswith("\x1b\\") else ""
body = s[q:len(s) - len(end)]
blank = bytes.maketrans(bytes(range(0x40, 0x7f)), b"?" * 0x3f).decode("latin1")
out, cur = [s[:q]], None
for i, t in enumerate(re.split(r"(#\d+(?:;\d+;\d+;\d+;\d+)?)", body)):
    if i % 2:
        cur = t[1:].split(";", 1)[0]
    elif cur in regs:
        t = t.translate(blank)
    out.append(t)
out.append(end)
sys.stdout.buffer.write("".join(out).encode("latin1"))' "$1"
