#!/usr/bin/env bash
# kawa-cell — the terminal's character cell in pixels, printed as WxH: the clipboard and
# wallpaper windows size their picture previews with it, so a picture fills its area
# exactly. Asks the terminal (CSI 16 t) on its own tty; 9x21 (foot at the desktop's font,
# scale 1) when there is no answer within half a second.
set -u
case ${1:-} in
  "") ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-cell   (prints the terminal's cell size, WxH)" >&2; exit 2 ;;
esac
cell=9x21
if [[ -t 0 ]] && saved=$(stty -g 2>/dev/null); then
  stty raw -echo 2>/dev/null                  # (so an early answer is never echoed)
  printf '\e[16t' >/dev/tty
  # (-d t: the answer "ESC [ 6 ; H ; W t" ends in a t). The wait is read's own -t: with
  # -d, read sets the terminal to wait for a first byte for ever, whatever stty said
  # shellcheck disable=SC2034
  IFS=";" read -r -t 0.5 -d "t" _ ch cw </dev/tty
  stty "$saved"
  [[ ${ch:-} =~ ^[0-9]{1,3}$ && ${cw:-} =~ ^[0-9]{1,3}$ ]] && ((cw >= 4 && ch >= 8)) && cell=${cw}x${ch}
fi
printf '%s\n' "$cell"
