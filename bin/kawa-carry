#!/usr/bin/env bash
# kawa-carry — what is yours, across a wipe. A backup (kawa-backup) keeps your home's history behind
# a password that lives in that home; this is one plain carry-over for the day the disk is erased:
# written to a drive before the wipe, read back and checked, put back after the fresh install.
#
#   kawa-carry save [--to FOLDER] [--downloads] [--yes]
#                      Super+U → backups → before you wipe: what goes and how much, the drive; then
#                      written, read back from the drive, compared. "safe to wipe" means just that.
#                      --to a folder instead of a drive picked; --yes asks nothing
#   kawa-carry restore [--from FOLDER] [--yes]
#                      Super+U → backups → after a wipe, or by itself at the first login: the newest
#                      carry-over on an open drive, put back in your home, checked as it comes
#   kawa-carry first   the session's, at each login until it has been seen once: a carry-over on a
#                      drive, in the first ten minutes of a new install, opens restore in a window
#   kawa-carry find    the folder of the newest carry-over on an open drive (exit 1: none)
#   kawa-carry list    what would go, a line each: BYTES<TAB>PATH under your home
#
# What goes: every folder and file at the top of your home but what comes back by itself or is
# not yours to carry (SKIP; Downloads by one key, it is often huge), and from under the dots only
# what the fresh system cannot make again (DOTS, and the browser's profile without its caches).
# Configs stay behind: the new system's theme writes its own. On the drive: FOLDER/fedokawaii-carry,
# parts of a plain tar (no filesystem limit on file size matters, FAT32 included), carry.info, its
# sum. No password: nobody has to remember anything across a wipe, so the drive is to be kept safe:
# it holds your keys. Exit: 0 done · 1 it could not be done (said on the screen) · 2 misuse · 4 left alone.
set -u
export LC_ALL=C.UTF-8
case :$PATH: in *":$HOME/.local/bin:"*) ;; *) PATH=$HOME/.local/bin:$PATH ;; esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/screen.sh"

NAME=fedokawaii-carry
PART_BYTES=${KAWA_CARRY_PART:-2147483648}     # (2 GiB: FAT32 holds that, and no tool here cares how many there are)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/fedokawaii
SEEN=$STATE/carry-seen
SKIP=(Downloads repos VM Drives Restored)
DOTS=(.ssh .gnupg .gitconfig .config/gh .config/fedokawaii/secrets.sh .local/state/bash
      .local/state/fedokawaii/chess .local/state/fedokawaii/typing .local/state/fedokawaii/learn)
EXCLUDE=(--exclude='*/Cache' --exclude='*/Code Cache' --exclude='*/GPUCache' --exclude='*/ShaderCache'
         --exclude='*/GrShaderCache' --exclude='*/DawnCache' --exclude='*/DawnGraphiteCache'
         --exclude='*/DawnWebGPUCache' --exclude='*/CacheStorage' --exclude='*/Singleton*')
WITH_DOWNLOADS=0 YES=0 WHERE=""
W=$(screen_width 2>/dev/null) || W=76
((W > 76)) && W=76

human() { numfmt --to=si --suffix=B -- "$1" | sed -E 's/([0-9])([A-Za-z])/\1 \2/'; }
say() { printf '  %s\n' "$@"; }
why() { printf '  %s%s%s\n' "$INK_ACCENT_TEXT" "$*" "$INK_OFF"; return 1; }
heading() { printf '\n  %s\n\n' "$(screen_heading "$1" "$2" "$W")"; }
row() { printf '  %s\n' "$(screen_row "$1" "$2" "$3" "$W")"; }
key() {   # key → one key pressed: "enter", "esc" or the letter (the screen's own, read from the terminal)
  local k
  IFS= read -rsn1 k </dev/tty || { echo esc; return; }
  case $k in '') echo enter ;; $'\e') read -rsn5 -t 0.01 _ </dev/tty; echo esc ;; *) printf '%s\n' "$k" ;; esac
}

what_goes() {   # what_goes → the paths under your home, a line each
  local d n
  for d in "$HOME"/*; do
    n=${d##*/}
    [[ -e $d && ! -L $d ]] || continue
    if [[ $n == Downloads ]]; then ((WITH_DOWNLOADS)) && echo "$n"; continue; fi
    [[ " ${SKIP[*]} " == *" $n "* ]] || echo "$n"
  done
  for n in "${DOTS[@]}"; do [[ -e $HOME/$n ]] && echo "$n"; done
  # (a Chromium's profile is where Default/Preferences is, whichever browser it is now)
  find "$HOME/.config" -mindepth 3 -maxdepth 4 -path '*/Default/Preferences' 2>/dev/null \
    | sed -E "s|^$HOME/(\.config/[^/]+).*|\1|" | sort -u
}
sized() {   # sized → BYTES<TAB>PATH, a line each
  local p
  while IFS= read -r p; do
    printf '%s\t%s\n' "$(du -sb "${EXCLUDE[@]}" -- "$HOME/$p" 2>/dev/null | cut -f1)" "$p"
  done < <(what_goes)
}

# the drives: pick one when several are plugged in (kawa-drives list: DEVICE DISK LABEL SIZE TYPE FOLDER)
pick_drive() {   # pick_drive → sets WHERE, the folder of the drive; said why not otherwise
  local dev label size fs folder
  local -a rows=()
  while IFS=$'\t' read -r dev _ label size fs folder; do
    [[ -n $label ]] && rows+=("$dev"$'\t'"$label"$'\t'"$size $fs"$'\t'"$folder")
  done < <(kawa-drives list 2>/dev/null)
  if ((${#rows[@]} == 0)); then why "no drive plugged in: plug one in, then come back here"; return 4; fi
  local pick=${rows[0]}
  if ((${#rows[@]} > 1)); then
    export FZF_DEFAULT_OPTS_FILE=$HOME/.config/fedokawaii/fzf.opts; unset FZF_DEFAULT_OPTS
    pick=$(printf '%s\n' "${rows[@]}" | fzf --delimiter=$'\t' --with-nth=2,3 --no-sort --height=~10) \
      || return 4
  fi
  IFS=$'\t' read -r dev label size folder <<<"$pick"
  [[ -n $folder ]] || folder=$(kawa-drives open "$dev") || { why "$label did not open"; return 1; }
  WHERE=$folder DRIVE_NAME=$label
}

meter() {   # meter DONE TOTAL WORDS — ten segments (§7) and the words, on one line, again and again
  local n=$(($1 * 10 / ($2 > 0 ? $2 : 1))) i s=""
  ((n > 10)) && n=10
  for ((i = 0; i < 10; i++)); do
    if ((i < n)); then s+=${ICON_READ:-#}; else s+=${INK_FAINT}${ICON_READ_OFF:-.}${INK_OFF}; fi
  done
  printf '\r\e[K  %s  %s%s%s' "$s" "$INK_MUTED" "$3" "$INK_OFF"
}

save() {
  local total=0 b p free old=0
  mapfile -t lines < <(sized)
  for p in "${lines[@]}"; do b=${p%%$'\t'*}; total=$((total + ${b:-0})); done
  if [[ -z $WHERE ]]; then
    heading "${ICON_USB:-·}" "before you wipe"
    pick_drive || return
  fi
  [[ -d $WHERE && -w $WHERE ]] || { why "$WHERE cannot be written"; return 1; }
  while :; do
    if ((!YES)); then
      printf '\e[2J\e[H'
      heading "${ICON_USB:-·}" "before you wipe"
      local shown=0 h=$(( $(stty size </dev/tty 2>/dev/null | cut -d' ' -f1) - 12 ))
      ((h < 6)) && h=6
      for p in "${lines[@]}"; do
        ((shown++ < h)) && row "${ICON_CHECK:-·}" "${p#*$'\t'}" "$(human "${p%%$'\t'*}")"
      done
      ((${#lines[@]} > h)) && row "" "and $((${#lines[@]} - h)) more" ""
      printf '\n'
      free=$(df --output=avail -B1 -- "$WHERE" | tail -n1 | tr -d ' ')
      row "${ICON_ARCHIVE:-·}" "all of it" "$(human "$total")"
      row "${ICON_USB:-·}" "${DRIVE_NAME:-$WHERE}" "$(human "$free") free"
      printf '\n'
      local dl=""
      if [[ -d $HOME/Downloads ]]; then
        dl=$(du -sb -- "$HOME/Downloads" 2>/dev/null | cut -f1)
        if ((WITH_DOWNLOADS)); then local on=with; else local on=without; fi
        say "$(screen_keys d "Downloads, $(human "${dl:-0}")" "$on")"
      fi
      case $(key) in
        enter) ;;
        d) WITH_DOWNLOADS=$((1 - WITH_DOWNLOADS)); mapfile -t lines < <(sized)
           total=0; for p in "${lines[@]}"; do b=${p%%$'\t'*}; total=$((total + ${b:-0})); done
           continue ;;
        *) return 4 ;;
      esac
    fi
    break
  done
  [[ -d $WHERE/$NAME ]] && old=$(du -sb -- "$WHERE/$NAME" | cut -f1)
  free=$(df --output=avail -B1 -- "$WHERE" | tail -n1 | tr -d ' ')
  if ((free + old < total + 104857600)); then
    why "$(human "$total") does not fit: the drive has $(human "$((free + old))")"
    return 1
  fi
  if ((free < total + 104857600)); then rm -rf -- "${WHERE:?}/$NAME"; fi    # (the older carry-over makes way)

  local new=$WHERE/$NAME.new tmp
  rm -rf -- "$new"; mkdir -p -- "$new" || { why "$WHERE cannot be written"; return 1; }
  tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/kawa-carry.XXXXXX") || return 1
  trap 'rm -rf -- "$tmp"; printf "\e[?25h"' EXIT
  printf '\e[2J\e[H\e[?25l'
  heading "${ICON_DOWNLOAD:-·}" "writing"
  mkfifo "$tmp/sum.in"
  sha256sum <"$tmp/sum.in" >"$tmp/sum" &
  local sumpid=$!
  mapfile -t items < <(printf '%s\n' "${lines[@]}" | cut -f2-)
  (
    tar -C "$HOME" -cf - "${EXCLUDE[@]}" --ignore-failed-read --warning=no-file-changed -- "${items[@]}" 2>"$tmp/err" \
      | tee "$tmp/sum.in" | split -b "$PART_BYTES" -d -a 4 - "$new/carry.part."
    printf '%s\n' "${PIPESTATUS[@]}" >"$tmp/rc"
  ) &
  local job=$!
  while kill -0 "$job" 2>/dev/null; do
    b=$(du -cb -- "$new"/carry.part.* 2>/dev/null | tail -n1 | cut -f1)
    meter "${b:-0}" "$total" "$(human "${b:-0}") of $(human "$total")"
    sleep 1
  done
  wait "$job"; wait "$sumpid"
  printf '\n'
  # (tar: 1 is "a file changed as it was read", no harm)
  local rcs; rcs=$(tr '\n' ' ' <"$tmp/rc")
  if [[ $rcs != @(0|1)\ 0\ 0\  ]]; then
    rm -rf -- "$new"; sed -n 1,4p "$tmp/err" | sed 's/^/  /'
    why "the writing stopped ($rcs): the drive is as it was"; return 1
  fi
  local want have
  want=$(cut -d' ' -f1 <"$tmp/sum")
  printf '\r\e[K  %s\n' "$(screen_row "${ICON_HOURGLASS:-·}" "read back from the drive" "" "$W")"
  sync -f -- "$new"
  # (what is checked comes off the drive, not out of memory)
  python3 -I -c 'import os,sys
for p in sys.argv[1:]:
    f=os.open(p,os.O_RDONLY); os.posix_fadvise(f,0,0,os.POSIX_FADV_DONTNEED); os.close(f)' "$new"/carry.part.* 2>/dev/null
  have=$(cat -- "$new"/carry.part.* | sha256sum | cut -d' ' -f1)
  if [[ $want != "$have" ]]; then
    rm -rf -- "$new"
    why "what the drive gave back is not what was written: the drive is failing. take another"; return 1
  fi
  local files bytes unread
  files=$(cat -- "$new"/carry.part.* | tar -tf - 2>/dev/null | wc -l)
  bytes=$(du -cb -- "$new"/carry.part.* | tail -n1 | cut -f1)
  unread=$(grep -c 'Cannot\|Permission denied' "$tmp/err")
  { printf 'date=%s\nfrom=%s@%s\nbytes=%s\nfiles=%s\nsha256=%s\n' "$(date +%F\ %H:%M)" "$USER" "$(hostname)" "$bytes" "$files" "$want"
    printf 'item=%s\n' "${items[@]}"; } >"$new/carry.info"
  ((unread)) && cp -- "$tmp/err" "$new/carry.unread"
  sync -f -- "$new"
  rm -rf -- "${WHERE:?}/$NAME"
  mv -T -- "$new" "$WHERE/$NAME" || { why "could not name it on the drive"; return 1; }
  mkdir -p "$STATE"; : >"$SEEN"     # (this PC is not the one to be offered its own carry-over)
  printf '\n'
  row "${ICON_CHECK:-·}" "safe to wipe" "$(human "$bytes")"
  say "" "$files files on ${DRIVE_NAME:-$WHERE}, read back and checked. the drive now holds your keys."
  ((unread)) && say "$unread could not be read (your user cannot): the list is carry.unread beside them."
  say "" "after the install this comes back by itself when the drive is plugged in."
  return 0
}

newest() {   # newest → the folder of the newest carry-over on an open drive
  local best="" bestt=0 t folder
  while IFS=$'\t' read -r _ _ _ _ _ folder; do
    [[ -n $folder && -f $folder/$NAME/carry.info ]] || continue
    t=$(stat -c %Y -- "$folder/$NAME/carry.info" 2>/dev/null) || continue
    ((t > bestt)) && { best=$folder/$NAME; bestt=$t; }
  done < <(kawa-drives list 2>/dev/null)
  [[ -n $best ]] && printf '%s\n' "$best"
}

info() { sed -n "s/^$2=//p" "$1/carry.info" | head -n1; }

restore() {
  local from=$WHERE
  if [[ -z $from ]]; then
    from=$(newest) || { heading "${ICON_UNPACK:-·}" "after a wipe"; why "no carry-over on the drives plugged in: plug in the drive with it"; return 4; }
  fi
  [[ -f $from/carry.info ]] || { why "$from holds no carry-over"; return 1; }
  local bytes date who want
  bytes=$(info "$from" bytes); date=$(info "$from" date); who=$(info "$from" from); want=$(info "$from" sha256)
  if ((!YES)); then
    printf '\e[2J\e[H'
    heading "${ICON_UNPACK:-·}" "after a wipe"
    row "${ICON_ARCHIVE:-·}" "your things, from $who" "$(human "$bytes")"
    row "${ICON_CALENDAR:-·}" "written" "$date"
    printf '\n'
    sed -n 's/^item=//p' "$from/carry.info" | head -n 12 | while IFS= read -r p; do row "${ICON_CHECK:-·}" "$p" ""; done
    printf '\n'
    say "enter brings them back into your home, over what has the same name."
    [[ $(key) == enter ]] || return 4
  fi
  local tmp
  tmp=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/kawa-carry.XXXXXX") || return 1
  trap 'rm -rf -- "$tmp"; printf "\e[?25h"' EXIT
  printf '\e[2J\e[H\e[?25l'
  heading "${ICON_UNPACK:-·}" "bringing back"
  mkfifo "$tmp/sum.in"
  sha256sum <"$tmp/sum.in" >"$tmp/sum" &
  local sumpid=$!
  (
    # (tar counts 1024 of its 10 KiB records aloud, to stderr: how far it has come)
    cat -- "$from"/carry.part.* | tee "$tmp/sum.in" \
      | tar -C "$HOME" -xpf - --checkpoint=1024 --checkpoint-action=echo='%u' 2>"$tmp/err"
    printf '%s\n' "${PIPESTATUS[@]}" >"$tmp/rc"
  ) &
  local job=$! files b
  files=$(info "$from" files)
  while kill -0 "$job" 2>/dev/null; do
    b=$(grep -oE '[0-9]+$' "$tmp/err" 2>/dev/null | tail -n1)
    b=$(( ${b:-0} * 10240 ))
    meter "$b" "$bytes" "$(human "$b") of $(human "$bytes")"
    sleep 1
  done
  wait "$job"; wait "$sumpid"
  printf '\n'
  local rcs; rcs=$(tr '\n' ' ' <"$tmp/rc")
  if [[ $rcs != "0 0 0 " ]]; then
    grep -vE '^tar: [0-9]+$' "$tmp/err" | sed -n 1,4p | sed 's/^/  /'
    why "it stopped ($rcs): some of it is back, the drive is as it was. run it again"; return 1
  fi
  if [[ $(cut -d' ' -f1 <"$tmp/sum") != "$want" ]]; then
    why "the drive gave back something else than was written: compare your files, the drive is failing"; return 1
  fi
  # (labels: what SELinux keeps apart under a home, as ssh expects them)
  command -v restorecon >/dev/null && restorecon -R -- "$HOME/.ssh" "$HOME/.gnupg" 2>/dev/null
  mkdir -p "$STATE"; : >"$SEEN"
  printf '\n'
  row "${ICON_CHECK:-·}" "back" "$files files, checked"
  return 0
}

first() {   # the first login of a new install: ten minutes for the drive to be there, then never again
  [[ -e $SEEN ]] && exit 0
  local end=$((SECONDS + 600))
  while ((SECONDS < end)); do
    if newest >/dev/null; then
      mkdir -p "$STATE"; : >"$SEEN"
      exec kawa-term --float --once carry --dialog "after a wipe" 100x27 -- kawa-carry restore
    fi
    sleep 5
  done
  mkdir -p "$STATE"; : >"$SEEN"
}

cmd=${1:-}; (($#)) && shift
while (($#)); do
  case $1 in
    --to|--from) WHERE=${2:?}; shift 2 ;;
    --downloads) WITH_DOWNLOADS=1; shift ;;
    --yes) YES=1; shift ;;
    *) echo "kawa-carry: unknown option $1" >&2; exit 2 ;;
  esac
done
case $cmd in
  save) save ;;
  restore) restore ;;
  first) first ;;
  find) newest ;;
  list) sized ;;
  *) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 2 ;;
esac
