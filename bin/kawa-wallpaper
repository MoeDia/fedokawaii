#!/usr/bin/env bash
# kawa-wallpaper             choose a wallpaper for the current theme (Super+W): a small
#                            window lists them and shows the one under the cursor, as the
#                            screen will; Enter sets it — it dissolves in over the old one
#                            (kawa-veil) — Esc leaves everything as it was
# kawa-wallpaper --restore   show the current theme's choice again (login, theme switch)
# kawa-wallpaper --set C     show choice C and remember it (what the picker runs)
# kawa-wallpaper --pack      fetch and draw the wallpaper pack (theme.sh runs it)
# (--tui, --preview C and --warm are the picker window's own parts)
#
# Each theme (dark, light) remembers its own wallpaper. The choices are:
#   default   the theme's picture from the pack, one place by night and by day: ink-ridges-night
#             (ink ridges under a pale moon) on the dark theme, ink-ridges (the same ridges
#             under a vermilion sun, on paper) on the light. Before the pack is fetched: the
#             theme's plain ground
#   the pack  pictures listed in ~/.local/share/fedokawaii/wallpapers.list, fetched from
#             GitHub (checked by SHA-256) and kept as they came. Some come in pairs (the
#             same place by day and by night): choosing one sets both themes.
#   your own  anything in ~/Pictures/Wallpapers, on either theme
# Every picture is shown at full quality on each monitor: scaled with a Lanczos filter (the
# sharpest clean one) to cover the screen exactly, and cropped to it — from the middle, or
# the side the list names (a picture whose subject is high up keeps its top). The pack's
# pictures are all at least as large as a 1080p screen, so on one they are only ever
# reduced; drawn once per monitor size, cached in ~/.cache.
#
# Exit: 0 done (or the picker closed) · 1 could not · 2 wrong use.
set -u
# ImageMagick reads format names and options case-blind by the locale: in Turkish, "tile:"
# and -resize lose their "i" (kawa-sixel, kawa-clip and kawa-books do the same)
magick() { LC_ALL=C command magick "$@"; }
case ${1:-} in -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;; esac
WALLPAPER_DIR=$HOME/Pictures/Wallpapers
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
case ${1:-menu} in
  --restore|--set|menu)   # (the session's runtime folder: also found from a shell without it)
    export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$UID}
    [[ -d $XDG_RUNTIME_DIR && -w $XDG_RUNTIME_DIR ]] \
      || { echo "kawa-wallpaper: no runtime folder $XDG_RUNTIME_DIR (not logged in to the desktop?)" >&2; exit 1; } ;;
esac
# One change at a time: two quick theme switches start two of these, and the later one
# must win. So a change waits for the lock first, then reads which theme is current.
if [[ ${1:-} == --restore || ${1:-} == --set ]]; then
  # (checked first: without swaybg the picture on screen must not be taken down)
  command -v swaybg >/dev/null || { echo "kawa-wallpaper: swaybg is not installed (sudo dnf install swaybg)" >&2; exit 1; }
  exec 8>"$XDG_RUNTIME_DIR/kawa-wallpaper.lock"
  flock -w 30 8 || exit 1
fi
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/current/colors.sh"
SHARE=$HOME/.local/share/fedokawaii
PACK=$SHARE/wallpapers LIST=$SHARE/wallpapers.list    # the pack: PACK/THEME/NAME.src, as fetched
STATE_DIR=$HOME/.local/state/fedokawaii CACHE=$HOME/.cache/kawa-wallpaper
PACK_TMP=""
mkdir -p "$WALLPAPER_DIR" "$STATE_DIR" "$CACHE"

outputs() {   # "NAME WxH" for every enabled output, as it stands (a turned screen: H×W)
  wlr-randr 2>/dev/null | awk '
    function flush() { if (out != "" && on && size != "") {
        if (turned) { split(size, d, "x"); size = d[2] "x" d[1] }
        print out, size } }
    /^[^ ]/ { flush(); out = $1; on = 0; size = ""; turned = 0; next }
    /^  Enabled: yes/ { on = 1 }
    /^  Transform: (90|270|flipped-90|flipped-270)$/ { turned = 1 }
    /^    [0-9]+x[0-9]+ px.*current/ { size = $1 }    # (a custom mode may have no refresh rate)
    END { flush() }'
}

crop_of() {   # crop_of NAME → the side a pack picture is cropped towards (the list's crop column)
  local mode name pair crop _
  while read -r mode name pair crop _; do
    [[ $mode == "$THEME" && $name == "$1" ]] && { printf '%s' "$crop"; return 0; }
  done <"$LIST"
  printf center
}

cover() {   # cover SRC W H GRAVITY → SRC reduced to cover W×H and cropped to it (cached)
  # Lanczos, in linear light (the colours mix as light does: no darkened edges); the cache
  # key holds the source's path and time, so a picture replaced under the same name is
  # drawn again
  local src=$1 w=$2 h=$3 g=$4 key out
  key=$(printf '%s\n' c1 "$src" "$(stat -c %Y "$src" 2>/dev/null)" "$w" "$h" "$g" | sha1sum); key=${key%% *}
  out=$CACHE/$w"x"$h-$key.png
  if [[ ! -s $out ]]; then
    magick "${src}[0]" -auto-orient -colorspace RGB -filter Lanczos -resize "${w}x${h}^" \
      -colorspace sRGB -gravity "$g" -extent "${w}x${h}" -strip "PNG24:$out.$$.tmp" 2>/dev/null \
      && mv -f "$out.$$.tmp" "$out" || { rm -f "$out.$$.tmp"; return 1; }
  fi
  printf '%s' "$out"
}

# shellcheck disable=SC2034  # read through ${!d} in resolve()
DEFAULT_dark=ink-ridges-night DEFAULT_light=ink-ridges
resolve() {   # resolve CHOICE → pack:NAME or a file ("default" is the theme's pack picture)
  local d=DEFAULT_$THEME
  if [[ $1 == default ]]; then printf 'pack:%s' "${!d}"; else printf '%s' "$1"; fi
}
SRC="" GRAV=""
source_of() {   # source_of pack:NAME|FILE → SRC, the picture file, and GRAV, its crop side
  # (set, not printed: a name of yours may hold a tab or a line break)
  case $1 in
    pack:*) SRC=$PACK/$THEME/${1#pack:}.src GRAV=$(crop_of "${1#pack:}"); [[ -s $SRC ]] ;;
    *)      SRC=$1 GRAV=center; [[ -f $SRC ]] ;;
  esac
}

apply() {   # apply CHOICE — default | pack:NAME | /path/to/file; 1: no such picture now
  local args=() name size img
  source_of "$(resolve "$1")" || return 1
  # every screen there now, drawn at its exact size
  while read -r name size; do
    img=$(cover "$SRC" "${size%x*}" "${size#*x}" "$GRAV") || return 1
    args+=(-o "$name" -i "$img" -m fill)       # (already its exact size: shown 1:1)
  done < <(outputs)
  show "${args[@]}"
}
show() {   # show [SWAYBG ARGS…] — a new swaybg up over the old one, the old one closed after
  # half a second (the new one has drawn by then): no bare flash between. That wait runs
  # on its own, so a theme switch goes on at once (its veil hides the overlap)
  local old=()
  mapfile -t old < <(pgrep -x -u "$UID" swaybg)
  setsid -f swaybg -c "#$C_GROUND" "$@" >/dev/null 2>&1 <&- 8>&-   # (it outlives the lock)
  ((${#old[@]})) && setsid -f sh -c 'sleep 0.5; kill "$@"' sh "${old[@]}" >/dev/null 2>&1 <&- 7>&- 8>&- 9>&-
  return 0
}
ground() {   # only the theme's plain ground (before the pack is here)
  show
}

pack() {   # download and check every pack picture not here yet; it is kept as it came
  local mode name pair crop sum url _ tmp out rc host n=0 have=0 fail=0 offline=0 untried=0
  [[ -r $LIST ]] || { echo "kawa-wallpaper: $LIST is missing (run theme.sh)" >&2; return 1; }
  tmp=$(mktemp -d) || return 1
  PACK_TMP=$tmp; trap 'rm -rf "$PACK_TMP"' EXIT        # (stopped half way: nothing left behind)
  while read -r mode name pair crop sum url _; do
    [[ $mode == dark || $mode == light ]] || continue          # comments and blank lines
    out="$PACK/$mode/$name.src"
    if [[ -s $out ]]; then have=$((have + 1)); continue; fi
    # every picture comes from the same host: three in a row that found no way there (no
    # network, its name not found, no answer) and the rest are left for the next run —
    # curl retries each one, so offline the whole list would take minutes
    if ((offline >= 3)); then fail=$((fail + 1)) untried=$((untried + 1)); continue; fi
    mkdir -p "$PACK/$mode"
    curl -fsSL --proto '=https' --retry 2 --max-time 180 -o "$tmp/src" "$url"; rc=$?
    # (a picture ImageMagick cannot read is refused too: a page in its place, say)
    if ((rc == 0)) && [[ $(sha256sum "$tmp/src") == "$sum "* ]] \
       && magick "$tmp/src[0]" -format %w info: >/dev/null 2>&1 \
       && mv -f "$tmp/src" "$out.tmp" && mv -f "$out.tmp" "$out"; then
      n=$((n + 1)) offline=0
    else
      fail=$((fail + 1)); rm -f "$out.tmp"
      case $rc in 5|6|7|28|35|56) offline=$((offline + 1)) host=${url#*://} ;; *) offline=0 ;; esac
      echo "kawa-wallpaper: could not fetch or draw '$name' ($url)" >&2
    fi
    rm -f "$tmp/src"
  done <"$LIST"
  rm -rf "$tmp"
  ((untried)) && echo "kawa-wallpaper: no connection to ${host%%/*} — $untried more not tried" >&2
  # pictures the list no longer names go — and every file of the pack before this one (its
  # small redrawn copies, NAME.png) — with the screen-sized copies made of them
  local keep=() f gone=0
  mapfile -t keep < <(awk '$1 == "dark" || $1 == "light" { print $1 "/" $2 ".src" }' "$LIST")
  if ((${#keep[@]})); then
    for f in "$PACK"/dark/* "$PACK"/light/*; do
      [[ -e $f ]] || continue
      [[ " ${keep[*]} " == *" ${f#"$PACK"/} "* ]] && continue
      rm -f "$f" && gone=$((gone + 1))
    done
    ((gone)) && find "$CACHE" -maxdepth 1 -name '*x*-*.png' -delete 2>/dev/null   # (drawn again as needed)
  fi
  f="wallpaper pack: $n fetched, $have already here, $fail failed"; ((gone)) && f+=", $gone retired"
  echo "$f"
  ((fail == 0))
}

pair_of() {   # pair_of NAME → the same place in the other theme, if there is one
  local mode name pair _
  while read -r mode name pair _; do
    [[ $mode == "$THEME" && $name == "$1" && $pair != - ]] && { printf '%s' "$pair"; return 0; }
  done <"$LIST"
  return 1
}

choices() {   # every choice for this theme: "CHOICE<TAB>LABEL" (◐ after a name: day and night)
  local mode name pair _ both dflt nw=0
  both=$'  \e[90m'"$ICON_THEME"$'\e[0m'
  dflt=$(resolve default)
  [[ -s $PACK/$THEME/${dflt#pack:}.src ]] && printf 'default\t%s  %s (default)\n' "$ICON_TORII" "${dflt#pack:}"
  # the ◐ marks stand in one column: every name padded to the longest
  while read -r mode name pair _; do
    [[ $mode == "$THEME" ]] && ((${#name} > nw)) && nw=${#name}
  done <"$LIST"
  while read -r mode name pair _; do
    [[ $mode == "$THEME" && -s $PACK/$THEME/$name.src ]] || continue
    [[ pack:$name == "$dflt" ]] && continue                 # (listed first, as the default)
    if [[ $pair == - ]]; then printf 'pack:%s\t%s  %s\n' "$name" "$ICON_PICTURE" "$name"
    else printf 'pack:%s\t%s  %-*s%s\n' "$name" "$ICON_PICTURE" "$nw" "$name" "$both"; fi
  done <"$LIST"
  # your own (a name with a tab or a line break in it cannot be listed)
  find -L "$WALLPAPER_DIR" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) \
    ! -name $'*\t*' ! -name $'*\n*' \
    | sort | while IFS= read -r f; do printf '%s\t%s  %s\n' "$f" "$ICON_FOLDER" "${f#"$WALLPAPER_DIR"/}"; done
}

# ── the picker's preview: the picture as the screen shows it, smaller ─────────────────
# The first screen's picture (drawn as the screen gets it), reduced to fit the window's
# preview area, centred in it (a sixel picture starts at the area's top-left corner: the
# margin is drawn as nothing, so the terminal's own background shows — kawa-sixel), and
# clear of its last line (a picture touching it would scroll the window: fzf #2544). Drawn
# once, cached in ~/.cache/kawa-wallpaper/preview.
CELL=${KAWA_CELL:-12x24}                               # the terminal's cell, in pixels
PREV_COLS=74 PREV_ROWS=20                              # the window's preview area (--tui)

preview_file() {   # preview_file CHOICE → that sixel file
  local c=$1 name size w=1920 h=1080 aw ah bw bh n m pw ph lp tp screen key out
  read -r name size < <(outputs)
  [[ $size =~ ^[0-9]+x[0-9]+$ ]] && w=${size%x*} h=${size#*x}
  aw=$((PREV_COLS * ${CELL%x*})) ah=$((PREV_ROWS * ${CELL#*x}))      # the area
  bw=$aw bh=$((ah - ${CELL#*x}))                                     # what the picture may fill
  ((bw > 0 && bh > 0)) || return 1
  n=$(( (w + bw - 1) / bw )) m=$(( (h + bh - 1) / bh )); ((m > n)) && n=$m; ((n < 1)) && n=1
  pw=$((w / n)) ph=$((h / n))
  lp=$(( (aw - pw) / 2 )) tp=$(( (ah - ph) / 2 )); ((tp > bh - ph)) && tp=$((bh - ph))
  # (quiet: fzf shows a preview's stderr in the pane — a picture it cannot read, cut short
  # or not a picture at all, gets the plain "no preview" line instead of ImageMagick's words)
  source_of "$(resolve "$c")" || return 1
  screen=$(cover "$SRC" "$w" "$h" "$GRAV") || return 1
  key=$(printf '%s\n' p4 "$screen" "$pw" "$ph" "$lp" "$tp" | sha1sum); key=${key%% *}
  out=$CACHE/preview/$key.six
  if [[ ! -s $out ]]; then
    mkdir -p "$CACHE/preview"
    magick "$screen" -filter Lanczos -resize "${pw}x${ph}!" \
      -background "#$C_GROUND" -gravity southeast -extent "$((lp + pw))x$((tp + ph))" png:- 2>/dev/null \
      | kawa-sixel "$C_GROUND" >"$out.$$.tmp" || { rm -f "$out.$$.tmp"; return 1; }
    mv -f "$out.$$.tmp" "$out"
  fi
  printf '%s' "$out"
}

case ${1:-menu} in
  --restore)
    # a choice not there now (deleted, or on a drive not plugged in yet) shows the default,
    # but stays the choice: it comes back with its picture
    c=$(cat "$STATE_DIR/wallpaper-$THEME" 2>/dev/null)
    apply "${c:-default}" || apply default || ground ;;
  --set)
    c=${2:-default}
    # a picture named from the folder you are in is remembered in full: found from anywhere
    case $c in default|pack:*|/*) ;; *) [[ -e $c ]] && c=$PWD/$c ;; esac
    apply "$c" || { echo "kawa-wallpaper: cannot show '$c' (not there, or not a picture file)" >&2; exit 1; }
    printf '%s\n' "$c" >"$STATE_DIR/wallpaper-$THEME"
    if [[ $c == pack:* ]] && p=$(pair_of "${c#pack:}"); then   # the same place, other theme
      other=dark; [[ $THEME == dark ]] && other=light
      printf 'pack:%s\n' "$p" >"$STATE_DIR/wallpaper-$other"
    fi ;;
  --pack)
    pack ;;
  menu)        # Super+W: the picker window, once (a second press while it is open closes it: kawa-float --once)
    pick=$(mktemp "$XDG_RUNTIME_DIR/kawa-wallpaper.XXXXXX") || exit 1
    trap 'rm -f "$pick"' EXIT
    # 80 × 39 (the clipboard window's width, an odd height: centred to the pixel): the list,
    # then a 20-row area for the picture — as far below its rule as above the window's foot
    kawa-float --once wallpaper wallpaper 80x39 -- "$0" --tui "$pick" || exit 0
    c=$(cat "$pick" 2>/dev/null)
    cur=$(cat "$STATE_DIR/wallpaper-$THEME" 2>/dev/null)
    [[ -n $c && $c != "$cur" ]] || exit 0
    sleep 0.15                                # the window gone from the screen first
    kawa-veil --dissolve --time 520 -- "$0" --set "$c"; exit ;;   # the new one dissolves in over the old
  --tui)       # inside the window: the list on top, the picture under the cursor below
    out=${2:?}
    KAWA_CELL=$(kawa-cell) || exit 1                  # the cell's pixels: previews fit exactly
    export KAWA_CELL
    mapfile -t rows < <(choices)
    cur=$(cat "$STATE_DIR/wallpaper-$THEME" 2>/dev/null) pos=1
    for i in "${!rows[@]}"; do [[ ${rows[i]%%$'\t'*} == "$cur" ]] && pos=$((i + 1)); done
    # every preview drawn ahead, quietly, while you look: moving through the list is instant
    setsid "$0" --warm </dev/null >/dev/null 2>&1 &   # its own group: closing stops all of it
    warm=$!
    trap 'kill -- -"$warm" 2>/dev/null' EXIT
    # the title in the panel's top rule, like the clipboard window ("─ ▣ wallpaper ──")
    title=" $(printf '\e[91m%s\e[0m' "$ICON_PICTURE")  wallpaper "$'\e[90m'"· $THEME theme"$'\e[0m '
    self=$(printf '%q' "$0")
    export FZF_DEFAULT_OPTS_FILE=$HOME/.config/fedokawaii/fzf.opts; unset FZF_DEFAULT_OPTS   # (every list alike)
    sel=$(for r in "${rows[@]}"; do printf '%s\n' "$r"; done | fzf --ansi --no-sort --height=100% --margin=1,2 \
      --delimiter=$'\t' --with-nth=2.. --border-label="$title" \
      --preview="$self --preview {1}" --preview-window='down,20,border-top,noinfo' \
      --footer=$'\n'"enter set  ·  $ICON_THEME  sets both themes  ·  esc close" \
      --bind="start:pos($pos)") || exit 0
    printf '%s\n' "${sel%%$'\t'*}" >"$out" ;;
  --preview)   # fzf's preview: the picture, centred in its area
    PREV_COLS=${FZF_PREVIEW_COLUMNS:-74} PREV_ROWS=${FZF_PREVIEW_LINES:-20}
    if f=$(preview_file "${2:-}"); then cat "$f"; printf '\n'
    else printf '  %s  no preview\n' "$ICON_PICTURE"; fi ;;
  --warm)      # every preview of this theme drawn ahead (the picker starts it)
    renice -n 19 $$ >/dev/null 2>&1
    # (other sizes, old ones — and what previews fzf killed half-way left: it kills one you
    # moved on from outright, SIGKILL, mid-way through its file)
    find "$CACHE/preview" \( -name '*.six' -mtime +30 -o -name '*.six.*.tmp' -mmin +1 \) -delete 2>/dev/null
    choices | while IFS=$'\t' read -r c _; do preview_file "$c" >/dev/null 2>&1; done ;;
  *) echo "usage: kawa-wallpaper [--restore|--set CHOICE|--pack] (kawa-wallpaper --help)" >&2; exit 2 ;;
esac
