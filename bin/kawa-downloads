#!/usr/bin/python3
"""kawa-downloads — everything this computer is downloading, in one place: the bar's download
mark (hidden while nothing comes in), its menu, and one notice as each download finishes.

    kawa-downloads           the menu (a click on the mark): 受 downloads — a row each, its
                             source's glyph, its name, how much of how much, the percent; a
                             click opens where it lands (Steam: its downloads page) · the
                             foot: torrents (the search), while that window is not open
    kawa-downloads list      one line a download, tab-separated: SOURCE NAME DONE TOTAL WHERE
                             (bytes; TOTAL 0: not known yet)
    kawa-downloads bar       the bar's mark (waybar JSON): the percent of them all, and how
                             many past one; empty (hidden) while nothing downloads
    kawa-downloads watch     the session's watcher (autostart): woken by the kernel (inotify)
                             as a download starts or ends, it pokes the mark (SIGRTMIN+21) and
                             says each finished one; while any runs it looks every 2 s, idle
                             it sleeps until the next
    kawa-downloads notice SOURCE NAME BYTES WHERE    a finished download's notice (the one
                             layout: its name, then "SOURCE · SIZE · click to open it");
                             a click opens WHERE
    kawa-downloads open SOURCE WHERE                 that: its folder in yazi, the file
                             under the cursor (Steam: its downloads page)

The sources, each read where it already keeps its state (nothing asked of a running program):
  torrent  Torrents (torrra), while its window is open: kawa-torrra writes what it downloads
           to $XDG_RUNTIME_DIR/kawa-downloads/torrra.PID every 2 s, and gives each finished
           one its notice itself (a torrent's file staying put says nothing)
  Brave    a .crdownload file in Brave's download folder: its size is what has come; how
           much will come, from Brave's own list (History, read without its lock)
  Steam    a game in steamapps/downloading of each of Steam's libraries: how far, from its
           appmanifest (BytesDownloaded of BytesToDownload)
Exit: 0 · 1 it could not be done · 2 wrong use.
"""
import ctypes
import json
import os
import re
import select
import signal
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
RUN = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
STATE = os.path.join(RUN, "kawa-downloads")                  # torrra.PID: kawa-torrra's
BRAVE = os.path.join(HOME, ".config/BraveSoftware/Brave-Origin/Default")
STEAM = os.path.join(HOME, ".local/share/Steam")
SIGNAL = 21                                                  # the bar's mark: SIGRTMIN+21
BUSY = 2.0                                                   # seconds between looks while one runs
WIDTH = 30                                                   # a name's columns in the menu
GLYPH = {"torrent": "download", "Brave": "link", "Steam": "gamepad"}


def icons():
    """icons.sh's glyphs by name (download, link…)."""
    out = {}
    with open(os.path.join(HOME, ".config/fedokawaii/icons.sh"), encoding="utf-8") as f:
        for line in f:
            if line.startswith("ICON_") and "=$'" in line:
                k, v = line.split("=", 1)
                raw = v[2:v.index("'", 2)]
                out[k[5:].lower()] = bytes(int(h, 16) for h in raw.split("\\x")[1:]).decode()
    return out


def size(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n:.0f} {unit}" if unit in ("B", "KB") else f"{n:.1f} {unit}"
        n /= 1000
    return ""


# ── the sources ─────────────────────────────────────────────────────────────────────────────
def torrents():
    """kawa-torrra's lists; one whose window is gone (its pid) is taken away."""
    out = []
    try:
        names = os.listdir(STATE)
    except OSError:
        return out
    for n in names:
        m = re.fullmatch(r"torrra\.(\d+)", n)
        if not m:
            continue
        p = os.path.join(STATE, n)
        if not os.path.exists(f"/proc/{m.group(1)}"):
            try:
                os.remove(p)
            except OSError:
                pass
            continue
        try:
            with open(p, encoding="utf-8") as f:
                for line in f:
                    t = line.rstrip("\n").split("\t")
                    if len(t) == 4 and t[1].isdigit() and t[2].isdigit():
                        out.append(("torrent", t[0], int(t[1]), int(t[2]), t[3]))
        except OSError:
            pass
    return out


def brave_folder():
    """Brave's download folder: the one set in its settings, else Brave's own, ~/Downloads."""
    try:
        with open(os.path.join(BRAVE, "Preferences"), encoding="utf-8") as f:
            d = json.load(f).get("download", {}).get("default_directory")
    except (OSError, ValueError, AttributeError):
        d = None
    return d or os.path.join(HOME, "Downloads")


def brave(folder):
    try:
        parts = [n for n in os.listdir(folder) if n.endswith(".crdownload")]
    except OSError:
        return []
    if not parts:
        return []
    known = {}
    try:   # (immutable: read as it is on disk, past the lock Brave holds while it runs)
        db = sqlite3.connect(f"file:{os.path.join(BRAVE, 'History')}?immutable=1", uri=True)
        for cur, target, total in db.execute(
                "SELECT current_path, target_path, total_bytes FROM downloads WHERE state = 0"):
            known[cur] = (target, total)
        db.close()
    except sqlite3.Error:
        pass
    out = []
    for n in parts:
        p = os.path.join(folder, n)
        try:
            done = os.stat(p).st_size
        except OSError:
            continue
        target, total = known.get(p, ("", 0))
        target = target or p[:-len(".crdownload")]
        out.append(("Brave", os.path.basename(target), done, max(total or 0, 0), target))
    return out


def steam_libraries():
    try:
        with open(os.path.join(STEAM, "steamapps/libraryfolders.vdf"), encoding="utf-8") as f:
            return [os.path.join(p, "steamapps") for p in re.findall(r'"path"\s+"([^"]*)"', f.read())]
    except OSError:
        return []


def acf(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return {}
    out = {}
    for k, v in re.findall(r'"(\w+)"\s+"([^"]*)"', text):
        out.setdefault(k, v)
    return out


def steam(libs):
    out = []
    for lib in libs:
        try:
            ids = [i for i in os.listdir(os.path.join(lib, "downloading")) if i.isdigit()]
        except OSError:
            continue
        for i in ids:
            a = acf(os.path.join(lib, f"appmanifest_{i}.acf"))
            done, total = int(a.get("BytesDownloaded", "0") or 0), int(a.get("BytesToDownload", "0") or 0)
            if total and done < total:
                out.append(("Steam", a.get("name", i), done, total, i))
    return out


def scan(folder, libs):
    return torrents() + brave(folder) + steam(libs)


# ── what they show ─────────────────────────────────────────────────────────────────────────
def percent(items):
    known = [(d, t) for _, _, d, t, _ in items if t]
    if not known:
        return None
    return int(100 * sum(d for d, _ in known) / sum(t for _, t in known))


def bar_json(items, ic):
    if not items:
        return '{"text":""}'
    p = percent(items)
    # (icons.sh's bar_download, no space, before a value: exactly 6 px from its ink to the value's)
    vals = ([str(len(items))] if len(items) > 1 else []) + ([] if p is None else [f"{p}%"])
    text = ic["bar_download"] + " ".join(vals) if vals else ic["download"]
    cls = ["downloading", "count"] if len(items) > 1 else "downloading" if vals else ["downloading", "bare"]
    return json.dumps({"text": text, "class": cls}, ensure_ascii=False)


def short(name):
    """A name for the menu: dots and underscores read as spaces (a torrent's), cut at a word
    within WIDTH columns (never with "…")."""
    name = re.sub(r"[._]+", " ", name).strip() if " " not in name else name
    if len(name) <= WIDTH:
        return name
    cut = name[:WIDTH]
    return cut[:cut.rfind(" ")] if " " in cut[WIDTH // 2:] else cut


def torrra_open():
    """Torrents' window is open (it holds kawa-torrra's lock)."""
    import fcntl
    try:
        with open(os.path.join(RUN, "kawa-torrra.lock"), "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
    except BlockingIOError:
        return True
    except OSError:
        return False


def detached(cmd):
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def open_it(source, where):
    if source == "Steam":
        detached(["xdg-open", "steam://open/downloads"])
        return
    # the file itself under yazi's cursor once it is there, else the folder it comes into
    detached(["kawa-term", "yazi", where if os.path.exists(where) else os.path.dirname(where)])


def menu():
    ic = icons()
    items = scan(brave_folder(), steam_libraries())
    rows, acts = ["part\t受\tdownloads"], [None]
    for src, name, done, total, where in items:
        detail = f"{size(done)} of {size(total)}" if total else size(done)
        value = f"{int(100 * done / total)}%" if total else ""
        rows.append("\t".join(("row", ic[GLYPH[src]], short(name), detail, value)))
        acts.append(("open", src, where))
    if not items:
        rows.append(f"off\t{ic['download']}\tnothing downloading")
        acts.append(None)
    if not torrra_open():
        rows.append(f"key\t{ic['download']}\ttorrents")
        acts.append(("torrents",))
    sel = ["--select", "1"] if items else []
    r = subprocess.run(["kawa-menu", "--drop", "--index", *sel], input="\n".join(rows) + "\n",
                       capture_output=True, text=True)
    try:
        act = acts[int(r.stdout.strip())]
    except (ValueError, IndexError):
        return 0
    if act and act[0] == "open":
        open_it(act[1], act[2])
    elif act and act[0] == "torrents":
        detached(["kawa-term", "kawa-torrra", "--open"])
    return 0


def notice(source, name, nbytes, where):
    ic = icons()
    body = f"{source} · {size(nbytes)} · click to open it" if nbytes.isdigit() and int(nbytes) else \
        f"{source} · click to open it"
    r = subprocess.run(["notify-send", "-a", "downloads", "-A", "default=open", "--",
                        f"{ic['download']}  {name}", body], capture_output=True, text=True)
    if r.stdout.strip() == "default":
        open_it(source, where)
    return 0


# ── the watcher ─────────────────────────────────────────────────────────────────────────────
IN_CLOSE_WRITE, IN_MOVED_FROM, IN_MOVED_TO = 0x8, 0x40, 0x80
IN_CREATE, IN_DELETE, IN_ONLYDIR = 0x100, 0x200, 0x1000000
CHANGES = IN_CREATE | IN_DELETE | IN_MOVED_FROM | IN_MOVED_TO | IN_ONLYDIR


def finished(item):
    """Did the download that just left the list finish (not cancelled)?"""
    src, _, _, _, where = item
    if src == "Brave":
        return os.path.exists(where) and not os.path.exists(where + ".crdownload")
    if src == "Steam":
        for lib in steam_libraries():
            a = acf(os.path.join(lib, f"appmanifest_{where}.acf"))
            if a:
                return int(a.get("BytesDownloaded", "0") or 0) >= int(a.get("BytesToDownload", "0") or 0) > 0
    return False                                             # (torrents: kawa-torrra says it)


def watch():
    libc = ctypes.CDLL(None, use_errno=True)
    fd = libc.inotify_init1(os.O_CLOEXEC)
    if fd < 0:
        print("kawa-downloads: no inotify", file=sys.stderr)
        return 1
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    folder, libs = brave_folder(), steam_libraries()
    watched = set()

    def add(path, mask=CHANGES):
        if path not in watched and libc.inotify_add_watch(fd, os.fsencode(path), mask) >= 0:
            watched.add(path)

    def watches():   # (a Steam library's downloading/ comes and goes: watched once it is there)
        add(STATE, CHANGES | IN_CLOSE_WRITE)
        add(folder)
        for lib in libs:
            add(lib, CHANGES | IN_CLOSE_WRITE)
            add(os.path.join(lib, "downloading"))
    ic = icons()
    before, shown = {}, None
    while True:
        watches()
        items = scan(folder, libs)
        now = {(i[0], i[4]): i for i in items}
        for k, i in before.items():
            if k not in now and finished(i):
                detached([sys.argv[0], "notice", i[0], i[1], str(i[3]), i[4]])
        before = now
        b = bar_json(items, ic)
        if b != shown:
            shown = b
            subprocess.run(["kawa-dwlstatus", "--poke", str(SIGNAL)], stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL, check=False)
        # asleep until the kernel says something changed; while one runs, a look every 2 s
        ready, _, _ = select.select([fd], [], [], BUSY if items else None)
        if ready:
            os.read(fd, 65536)
            time.sleep(0.3)                                  # (a burst of changes: one look)
            ready, _, _ = select.select([fd], [], [], 0)
            if ready:
                os.read(fd, 65536)


def main(a):
    cmd = a[0] if a else "menu"
    if cmd in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if cmd == "menu" and len(a) <= 1:
        return menu()
    if cmd == "list" and len(a) == 1:
        for i in scan(brave_folder(), steam_libraries()):
            print("\t".join(str(x) for x in i))
        return 0
    if cmd == "bar" and len(a) == 1:
        print(bar_json(scan(brave_folder(), steam_libraries()), icons()))
        return 0
    if cmd == "watch" and len(a) == 1:
        return watch()
    if cmd == "notice" and len(a) == 5:
        return notice(*a[1:])
    if cmd == "open" and len(a) == 3:
        open_it(a[1], a[2])
        return 0
    print("usage: kawa-downloads [menu|list|bar|watch|notice SOURCE NAME BYTES WHERE|open SOURCE WHERE]"
          " (kawa-downloads --help)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # a pipe closed early (| head) ends it quietly
    sys.exit(main(sys.argv[1:]))
