#!/usr/bin/env bash
# kawa-quick — quick settings: the panel under the bar's right end (its cat, or Super+X), and
# what it shows and does. The panel itself is kawa-panel (it draws; this knows the machine).
#
#   kawa-quick                  the panel opens, or closes if it is open
#   kawa-quick --state          how everything stands, one "KEY<TAB>VALUE" a line: theme,
#                               brightness, night, vrr, wallpaper, sound, nettype, network,
#                               bluetooth and devices (only with a Bluetooth adapter), drives,
#                               backup, dnd
#   kawa-quick --do ACTION [N]  one thing done: theme · night · vrr · bluetooth · dnd (each
#                               switched over) · brightness N · volume N (set, in %) · sound ·
#                               network · devices · drives · backup · wallpaper · screenshot ·
#                               power (each opens its own menu or window)
#
# Exit: 0 done · 1 it could not (said) · 2 wrong use.
set -u
usage() { echo "usage: kawa-quick [--state | --do ACTION [N]] (kawa-quick --help)" >&2; exit 2; }
case ${1:-} in
  ""|--state) (($# <= 1)) || usage ;;
  --do) (($# == 2 || $# == 3)) || usage ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) usage ;;
esac
# the panel's key (Super+X, the cat, the sound's and the brightness's click): the panel told
# at once, before anything else is read — no process started on the way (its pid file and
# that pid's command line, read by bash itself)
if [[ -z ${1:-} ]]; then
  run=${XDG_RUNTIME_DIR:-/run/user/$UID} a=()
  pid=""; read -r pid 2>/dev/null <"$run/kawa-panel.pid"
  if [[ $pid =~ ^[1-9][0-9]*$ ]] && mapfile -d '' -t a 2>/dev/null <"/proc/$pid/cmdline" && [[ " ${a[*]} " == *kawa-panel* ]]; then
    kill -USR1 "$pid" && exit 0
  fi
  setsid -f kawa-panel --open </dev/null >/dev/null 2>&1; exit 0
fi
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"

state_net() {   # the cable or the Wi-Fi in use, wherever nmcli lists it: a VPN that holds the
  # default route comes first there, a bridge for virtual machines rides on the cable, and a
  # cable set up by another tool is "connected (externally)" (as the loopback always is).
  # → "TYPE NAME": the Wi-Fi's own name (its connection), the cable as "wired"
  local type state conn other=""
  while IFS=: read -r type state conn; do
    [[ $state == connected || $state == "connected (externally)" ]] || continue
    case $type in
      ethernet) echo "ethernet wired"; return ;;
      wifi)     echo "wifi ${conn:-Wi-Fi}"; return ;;
      loopback|wireguard|tun|vpn|bridge) ;;
      *) [[ $state == connected ]] && other=${other:-$type} ;;   # (a phone's mobile data: gsm)
    esac
  done < <(nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null)
  echo "${other:-offline} ${other:-offline}"
}
# Bluetooth only when the machine has an adapter; bluetoothctl waits forever for a
# bluetoothd that is not running, so never longer than 2 s
bt()          { compgen -G '/sys/class/bluetooth/hci*' >/dev/null && timeout 2 bluetoothctl "$@"; }
# (Bluetooth asked over D-Bus: instant, where bluetoothctl takes its time to connect; no
# answer — bluetoothd not running — is off)
state_bt()    {
  [[ $(busctl --system get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered 2>/dev/null) == 'b true' ]] \
    && echo on || echo off
}
state_theme() { [[ $(readlink "$HOME/.config/fedokawaii/current" 2>/dev/null) == */light ]] && echo light || echo dark; }
state_night() { pgrep -xu "$UID" gammastep >/dev/null && echo on || echo off; }
VRR=$HOME/.config/fedokawaii/vrr
state_vrr()   {   # FreeSync (variable refresh, dwl reads the file): in games (a full-screen
  # window: the screen follows the game's frames, no tearing, no stutter), always, or off
  case $(cat "$VRR" 2>/dev/null) in always) echo always ;; off) echo off ;; *) echo 'in games' ;; esac
}
state_dnd()   { [[ $(makoctl mode 2>/dev/null) == *do-not-disturb* ]] && echo on || echo off; }
state_drives() {   # USB sticks, disks, SD cards plugged in (kawa-drives: one line per file system):
  # one by its name and size ("SANDISK 58G"), more by the first one's name and how many more
  # ("SANDISK +2") — the count alone is the bar's drive mark, right above
  local -a l; local n label
  mapfile -t l < <(kawa-drives list 2>/dev/null)
  n=$(printf '%s\n' "${l[@]}" | cut -f2 | sort -u | grep -c .)
  if ((n == 0)); then echo none
  elif ((n == 1)); then IFS=$'\t' read -r _ _ label size _ <<<"${l[0]}"; echo "$label $size"
  else IFS=$'\t' read -r _ _ label _ <<<"${l[0]}"; echo "$label +$((n - 1))"; fi
}
state_backup() { kawa-backup status 2>/dev/null || echo 'not set up'; }   # the last backup's age (never · 3 days ago · not set up)
state_sound() {   # the output's level, or muted
  local v; v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || { echo "no output"; return; }
  [[ $v == *MUTED* ]] && { echo muted; return; }
  [[ $v =~ ([0-9]+)\.([0-9]{2}) ]] && echo "$((10#${BASH_REMATCH[1]} * 100 + 10#${BASH_REMATCH[2]}))%" || echo "no output"
}
state_bright() {  # the monitors' level (the last read or set; read once if never)
  local l; l=$(timeout 3 kawa-brightness --level 2>/dev/null)
  [[ $l =~ ^[0-9]+$ ]] && echo "$l%" || echo "no DDC/CI"
}
state_wall() {    # the wallpaper this theme shows (its name, as the picker lists it)
  local c; c=$(cat "$HOME/.local/state/fedokawaii/wallpaper-$(state_theme)" 2>/dev/null)
  case ${c:-default} in default) echo default ;; pack:*) echo "${c#pack:}" ;; *) local b=${c##*/}; echo "${b%.*}" ;; esac
}
state_paired() {  # the Bluetooth devices connected now: one by name, more by their count
  local -a d
  [[ $1 == on ]] || { echo off; return; }
  mapfile -t d < <(bt devices Connected 2>/dev/null | sed -n 's/^Device [0-9A-Fa-f:]\{17\} //p')
  if ((${#d[@]} == 0)); then echo none
  elif ((${#d[@]} == 1)); then echo "${d[0]}"
  else echo "${#d[@]} connected"; fi
}

dwl_reload() {   # SIGUSR1 to dwl — only one that catches it (src/dwl/dwl.patch): to a build
  # without the handler the signal would end the session (as kawa-theme sends it)
  local pid k v
  for pid in $(pgrep -xu "$UID" dwl); do
    while read -r k v; do
      [[ $k == SigCgt: ]] || continue
      (( 16#$v >> 9 & 1 )) && kill -USR1 "$pid" 2>/dev/null
      break
    done 2>/dev/null <"/proc/$pid/status"
  done
  return 0
}

state() {   # everything, KEY<TAB>VALUE (a value's tabs and line breaks become spaces: a name
  local nettype net bt   # of yours — a Wi-Fi, a drive, a picture — cannot break a line)
  kv() { local v=${2//[$'\t\n\r']/ }; printf '%s\t%s\n' "$1" "$v"; }
  read -r nettype net <<<"$(state_net)"
  kv theme "$(state_theme)"; kv brightness "$(state_bright)"; kv night "$(state_night)"
  kv vrr "$(state_vrr)"; kv wallpaper "$(state_wall)"; kv sound "$(state_sound)"
  kv nettype "$nettype"; kv network "$net"
  if compgen -G '/sys/class/bluetooth/hci*' >/dev/null; then
    bt=$(state_bt); kv bluetooth "$bt"; kv devices "$(state_paired "$bt")"
  fi
  kv drives "$(state_drives)"; kv backup "$(state_backup)"; kv dnd "$(state_dnd)"
}

act() {   # act ACTION [N] — the panel's choices
  local v
  case $1 in brightness|volume) (($# == 2)) || usage ;; *) (($# == 1)) || usage ;; esac
  case $1 in
    theme)      kawa-theme toggle ;;
    night)      if [[ $(state_night) == on ]]; then
                  # gammastep fades back for ~4 s after a first signal, still running: a second
                  # one ends that at once, so the panel shows the night light really off
                  pkill -xu "$UID" gammastep; sleep 0.2; pkill -xu "$UID" gammastep
                  for _ in {1..20}; do pgrep -xu "$UID" gammastep >/dev/null || break; sleep 0.05; done
                else setsid -f gammastep -l "$NIGHT_LIGHT" -t 6500:4200 </dev/null >/dev/null 2>&1; sleep 0.2; fi ;;
    vrr)        mkdir -p "${VRR%/*}"   # in games → always → off → in games (dwl takes it up at once:
                case $(state_vrr) in 'in games') v=always ;; always) v=off ;; *) v=games ;; esac
                echo "$v" >"$VRR"      # SIGUSR1 makes it read the file again)
                dwl_reload ;;
    bluetooth)  if [[ $(state_bt) == on ]]; then bt power off >/dev/null
                elif ! v=$(bt power on 2>&1); then        # (an airplane-mode key, or a switch)
                  if [[ $v == *Blocked* ]]; then
                    notify-send -a desktop -- "$ICON_BLUETOOTH  Bluetooth" "it is blocked — rfkill unblock bluetooth (or the machine's own switch)"
                  else notify-send -a desktop -- "$ICON_BLUETOOTH  Bluetooth" "it did not switch on — is the bluetooth service running?"; fi
                  return 1
                fi ;;
    dnd)        makoctl mode -t do-not-disturb >/dev/null
                kawa-dwlstatus --poke 12 ;;                     # the bar's 静 seal
    brightness) [[ ${2:-} =~ ^[0-9]{1,3}$ ]] && ((10#$2 <= 100)) || usage
                kawa-brightness "$((10#$2))" ;;
    volume)     [[ ${2:-} =~ ^[0-9]{1,3}$ ]] && ((10#$2 <= 100)) || usage
                wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ "$((10#$2))%" ;;
    sound)      exec kawa-audio ;;                               # (outputs, the microphone)
    network)    exec kawa-float --once network network 80x25 -- nmtui ;;
    devices)    exec kawa-float --once pair 'pair a device' 96x29 -- bluetui ;;   # (the paired, the found, the adapter)
    drives)     exec kawa-drives ;;
    backup)     exec kawa-backup --window ;;
    wallpaper)  exec kawa-wallpaper ;;
    screenshot) exec kawa-screenshot region ;;
    power)      exec kawa-power ;;
    *)          usage ;;
  esac
}

# (the panel itself: kawa-panel runs all session long (autostart), hidden until asked —
# SIGUSR1 opens or closes it; should it not be running (it crashed and autostart has not
# started it again yet), it is started, open — done above, first thing)

case ${1:-} in
  --state) state ;;
  --do)    act "${@:2}" ;;
esac
