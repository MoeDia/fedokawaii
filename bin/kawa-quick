#!/usr/bin/env bash
# kawa-quick — the key at the bar's right end (or Super+X): quick settings as a dropdown.
# Each line shows its current state; toggles reopen the menu so the change is visible.
# No arguments (--help: this text).
set -u
case ${1:-} in
  "") ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-quick   (no arguments: the quick settings menu)" >&2; exit 2 ;;
esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"

state_net() {   # the cable or the Wi-Fi in use, wherever nmcli lists it: a VPN that holds the
  # default route comes first there, a bridge for virtual machines rides on the cable, and a
  # cable set up by another tool is "connected (externally)" (as the loopback always is)
  local type state other=""
  while IFS=: read -r type state; do
    [[ $state == connected || $state == "connected (externally)" ]] || continue
    case $type in
      ethernet|wifi) echo "$type"; return ;;
      loopback|wireguard|tun|vpn|bridge) ;;
      *) [[ $state == connected ]] && other=${other:-$type} ;;   # (a phone's mobile data: gsm)
    esac
  done < <(nmcli -t -f TYPE,STATE device 2>/dev/null)
  echo "${other:-offline}"
}
# Bluetooth only when the machine has an adapter; bluetoothctl waits forever for a
# bluetoothd that is not running, so never longer than 2 s
bt()          { compgen -G '/sys/class/bluetooth/hci*' >/dev/null && timeout 2 bluetoothctl "$@"; }
# (Bluetooth asked over D-Bus: instant, where bluetoothctl takes its time to connect)
state_bt()    {
  local p
  p=$(busctl --system get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered 2>/dev/null) \
    || p=$([[ $(bt show 2>/dev/null) == *"Powered: yes"* ]] && echo 'b true')
  [[ $p == 'b true' ]] && echo on || echo off
}
state_theme() { [[ $(readlink "$HOME/.config/fedokawaii/current" 2>/dev/null) == */light ]] && echo light || echo dark; }
state_night() { pgrep -xu "$UID" gammastep >/dev/null && echo on || echo off; }
state_dnd()   { [[ $(makoctl mode 2>/dev/null) == *do-not-disturb* ]] && echo on || echo off; }
state_drives() {   # USB sticks, disks, SD cards plugged in (kawa-drives: one line per file system)
  local n
  n=$(kawa-drives list 2>/dev/null | cut -f2 | sort -u | grep -c .)
  if ((n == 0)); then echo none; else echo "$n plugged in"; fi
}

row() {   # row ACTION ICON NAME STATE
  local r; printf -v r '%s  %-16s%s' "$2" "$3" "$4"; rows+=("$r"); acts+=("$1")
}

sel=0
weather=$(kawa-weather)                    # (the title: once, not after every toggle)
while :; do
  net=$(state_net) night=$(state_night) dnd=$(state_dnd) mode=$(state_theme)
  case $net in ethernet) neticon=$ICON_ETHERNET ;; wifi) neticon=$ICON_WIFI ;; *) neticon=$ICON_OFFLINE ;; esac
  dndicon=$ICON_BELL; [[ $dnd == on ]] && dndicon=$ICON_BELL_OFF
  # the theme as a two-way switch: the lit box marks the one in use
  if [[ $mode == dark ]]; then themestate="$ICON_BOX_ON dark  $ICON_BOX_OFF light"
  else themestate="$ICON_BOX_OFF dark  $ICON_BOX_ON light"; fi
  rows=() acts=()
  # the screen · sound and connections · quiet · tools
  row theme      "$ICON_THEME"    theme "$themestate"
  row brightness "$ICON_SUN"      brightness '…'
  row night      "$ICON_LANTERN"  'night light' "$night"
  row wallpaper  "$ICON_PICTURE"  wallpaper '…'
  row sound      "$ICON_SPEAKER"  sound '…'
  row network    "$neticon"       network "$net"
  if compgen -G '/sys/class/bluetooth/hci*' >/dev/null; then
    bt=$(state_bt)
    row bt       "$ICON_BLUETOOTH" bluetooth "$bt"
    row pair     "$ICON_BLUETOOTH" 'pair a device' '…'
  fi
  row drives     "$ICON_DRIVE"    drives "$(state_drives)"
  row dnd        "$dndicon"       'do not disturb' "$dnd"
  row shot       "$ICON_CAMERA"   screenshot region
  row keys       "$ICON_KEYBOARD" keybindings '…'
  row system     "$ICON_TORII"    system '…'
  row change     "$ICON_CODE"     change '…'
  row power      "$ICON_POWER"    power '…'
  # 38 columns: the theme row is the widest, 37 — icon (2) + 2 + name (16) + "▣ dark  ☐ light"
  # (17: the boxes are icons, two columns each) — and fuzzel fills one column less than its
  # width (the last is kept for its "…")
  i=$(printf '%s\n' "${rows[@]}" | kawa-menu --drop --index --width 38 --lines ${#rows[@]} --select "$sel" \
        --title "$weather") || exit 0
  sel=$i
  case ${acts[i]:-} in
    brightness) exec kawa-brightness ;;
    sound)      exec kawa-audio ;;
    network)    exec kawa-float --once network network 80x25 -- nmtui ;;
    bt)         if [[ $bt == on ]]; then bt power off >/dev/null
                elif ! out=$(bt power on 2>&1); then        # (an airplane-mode key, or a switch)
                  if [[ $out == *Blocked* ]]; then
                    notify-send -a desktop "Bluetooth" "it is blocked — rfkill unblock bluetooth (or the machine's own switch)"
                  else notify-send -a desktop "Bluetooth" "it did not switch on — is the bluetooth service running?"; fi
                fi ;;
    pair)       setsid -f blueman-manager >/dev/null 2>&1; exit 0 ;;
    drives)     exec kawa-drives ;;
    night)      if [[ $night == on ]]; then
                  # gammastep fades back for ~4 s after a first signal, still running: a second
                  # one ends that at once, so the menu reopens with the night light really off
                  pkill -xu "$UID" gammastep; sleep 0.2; pkill -xu "$UID" gammastep
                  for _ in {1..20}; do pgrep -xu "$UID" gammastep >/dev/null || break; sleep 0.05; done
                else setsid -f gammastep -l "$NIGHT_LIGHT" -t 6500:4200 </dev/null >/dev/null 2>&1; sleep 0.2; fi ;;
    dnd)        makoctl mode -t do-not-disturb >/dev/null
                kawa-dwlstatus --poke 12 ;;                     # the bar's 静 seal
    theme)      kawa-theme toggle ;;
    shot)       sleep 0.2; exec kawa-screenshot region ;;      # let the menu close before slurp
    wallpaper)  exec kawa-wallpaper ;;
    keys)       exec kawa-help ;;
    system)     exec fedokawaii --window ;;
    change)     exec kawa-config ;;
    power)      exec kawa-power ;;
    *)          exit 0 ;;
  esac
done
