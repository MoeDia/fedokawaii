#!/usr/bin/env bash
# kawa-quick — quick settings: the panel under the bar's right end (its cat, or Super+X), and
# what it and its two siblings (the sound panel, the brightness slider) show and do. The panels
# themselves are kawa-panel (it draws; this knows the machine).
#
#   kawa-quick [sound|brightness]   the panel (quick settings, the sound panel, the brightness
#                               slider) opens, or closes if it is open: the running panel asked
#                               through its fifo (kawa-panel), by bash alone — the bar's clicks
#                               and the keys, at once
#   kawa-quick dnd              do not disturb's own dropdown (the bar's quiet bell): off · for an
#                               hour · until the morning (8:00) · on — the one in force marked; a
#                               timed one ends by itself (kawa-dnd-end, a timer of your systemd)
#                               and is not kept across a login (an untimed one is: kawa-state)
#   kawa-quick --state          how everything stands, one "KEY<TAB>VALUE" a line: theme,
#                               brightness, night ("off" or its warmth, "4000K"), vrr,
#                               wallpaper, sound, nettype, network, bluetooth and devices (only
#                               with a Bluetooth adapter), drives, backup, dnd, saver (the
#                               screensaver after 15 min away: "15 min", or "off"), vrrnow (FreeSync on
#                               the card this moment: on, off, none, unread)
#   kawa-quick --state sound    the sound panel's: sound (the output's level, also while
#                               muted), muted (on|off), mic (on|muted|none), cleanmic (on: the
#                               clean mic is the default input · off · none: not loaded), then
#                               each output and input (not "Share", not the clean mic — while
#                               it is on, the microphone it listens to is the ticked input):
#                               "output|input<TAB>ID<TAB>1 (the
#                               default) or 0<TAB>DESCRIPTION<TAB>PORT<TAB>NICK<TAB>CARD<TAB>
#                               PROFILE<TAB>API" (what names it; any but the first may be empty)
#   kawa-quick --state brightness   the slider's: brightness
#   kawa-quick --do ACTION [N]  one thing done: theme · night · vrr · bluetooth · dnd (each
#                               switched over; dnd on|off|hour|morning: set so; end: off, as a
#                               timed one's timer ends it) · saver (the screensaver on ⇄ off) ·
#                               warmer · cooler (the night light, a step, on) · brightness N · volume N (set, in %) · mute ·
#                               micmute (the output's, the microphone's, switched over) ·
#                               output ID · input ID (the default: playing audio moves to it;
#                               an input: what records moves to it, the mute carried over) ·
#                               cleanmic (the default input clean ⇄ raw, as input ID; kept: kawa-state) ·
#                               mictest (5 s recorded from the default input, played back) ·
#                               sound (the sound panel) · mixer · network · devices · drives ·
#                               backup · wallpaper · screenshot · record · ocr · power (each opens its own menu
#                               or window)
#
# Exit: 0 done · 1 it could not (said) · 2 wrong use.
set -u
usage() { echo "usage: kawa-quick [sound | brightness | dnd | --state | --do ACTION [N]] (kawa-quick --help)" >&2; exit 2; }
case ${1:-} in
  ""|sound|brightness|dnd) (($# <= 1)) || usage ;;
  --state) (($# == 1)) || [[ $# == 2 && ( $2 == sound || $2 == brightness ) ]] || usage ;;
  --do) (($# == 2 || $# == 3)) || usage ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) usage ;;
esac
# a panel's key or button (Super+X or the cat, Super+A or the volume, the brightness): the
# panel told at once, before anything else is read — no process started on the way (its pid
# file, that pid's command line, its fifo: bash's own); none running: started, open
toggle() {
  local run=${XDG_RUNTIME_DIR:-/run/user/$UID} a=() pid=""
  read -r pid 2>/dev/null <"$run/kawa-panel.pid"
  if [[ $pid =~ ^[1-9][0-9]*$ ]] && mapfile -d '' -t a 2>/dev/null <"/proc/$pid/cmdline" && [[ " ${a[*]} " == *kawa-panel* ]] \
     && { printf 'toggle %s\n' "$1" 1<>"$run/kawa-panel.in"; } 2>/dev/null; then
    return 0
  fi
  case $1 in quick) set -- --open ;; *) set -- "--$1" ;; esac
  setsid -f kawa-panel "$1" </dev/null >/dev/null 2>&1
}
case ${1:-} in
  "")                toggle quick; exit 0 ;;
  sound|brightness)  toggle "$1"; exit 0 ;;
esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/env"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"

state_net() {   # the cable or the Wi-Fi in use, wherever nmcli lists it: a VPN that holds the
  # default route comes first there, a bridge for virtual machines rides on the cable, and a
  # cable set up by another tool is "connected (externally)" (as the loopback always is).
  # → "TYPE NAME": the Wi-Fi's own name (its connection), the cable as "wired"
  local type state conn other=""
  while IFS=: read -r type state conn; do
    [[ $state == connected || $state == "connected (externally)" ]] || continue
    case $type in
      ethernet) echo "ethernet wired"; return ;;
      wifi)     echo "wifi ${conn:-Wi-Fi}"; return ;;
      loopback|wireguard|tun|vpn|bridge) ;;
      *) [[ $state == connected ]] && other=${other:-$type} ;;   # (a phone's mobile data: gsm)
    esac
  done < <(nmcli -t -f TYPE,STATE,CONNECTION device 2>/dev/null)
  echo "${other:-offline} ${other:-offline}"
}
# Bluetooth only when the machine has an adapter; bluetoothctl waits forever for a
# bluetoothd that is not running, so never longer than 2 s
bt()          { compgen -G '/sys/class/bluetooth/hci*' >/dev/null && timeout 2 bluetoothctl "$@"; }
# (Bluetooth asked over D-Bus: instant, where bluetoothctl takes its time to connect; no
# answer — bluetoothd not running — is off)
state_bt()    {
  [[ $(busctl --system get-property org.bluez /org/bluez/hci0 org.bluez.Adapter1 Powered 2>/dev/null) == 'b true' ]] \
    && echo on || echo off
}
state_theme() { [[ $(readlink "$HOME/.config/fedokawaii/current" 2>/dev/null) == */light ]] && echo light || echo dark; }
state_night() { kawa-night; }                     # ("off", or its warmth: kawa-night keeps it)
SAVER=${XDG_STATE_HOME:-$HOME/.local/state}/fedokawaii/saver
state_record() {   # a screen recording running (kawa-record's "PID START FILE", its wf-recorder alive): on · off
  local p a=()
  read -r p _ 2>/dev/null <"${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-record" && [[ $p =~ ^[1-9][0-9]*$ ]] \
    && mapfile -d '' -t a 2>/dev/null </proc/"$p"/cmdline && [[ ${a[0]##*/} == wf-recorder || ${a[1]:-} == */wf-recorder ]] \
    && echo on || echo off
}
state_saver() {   # the screensaver (kawa-saver reads the same file): on unless "off" — after
  [[ $(cat "$SAVER" 2>/dev/null) == off ]] && echo off || echo "15 min"   # 15 min (kawa-idle)
}
VRR=$HOME/.config/fedokawaii/vrr
state_vrr()   {   # FreeSync (variable refresh, dwl reads the file): in games (a full-screen
  # window: the screen follows the game's frames, no tearing, no stutter), always, or off
  case $(cat "$VRR" 2>/dev/null) in always) echo always ;; off) echo off ;; *) echo 'in games' ;; esac
}
state_vrrnow() {  # …and what the card does this moment (kawa-display --vrr, DRM's VRR_ENABLED):
  # on (a screen follows the frames now) · off · none (no screen offers it: the monitor's own
  # menu has it off, or the cable or port cannot) · unread (DRM could not be asked)
  local l
  l=$(kawa-display --vrr 2>/dev/null) || { echo unread; return; }
  if grep -q $'\ton$' <<<"$l"; then echo on
  elif grep -q $'\tyes\t' <<<"$l"; then echo off
  else echo none; fi
}
state_dnd()   { [[ $(makoctl mode 2>/dev/null) == *do-not-disturb* ]] && echo on || echo off; }
# do not disturb, set: off · on (until you turn it off: kept across a login) · hour · morning
# (timed: kawa-dnd-end, a timer of your systemd, turns it off; not kept — a login ends it).
# Every change ends a timer still waiting, and tells the bar (its bell)
DND_UNTIL=${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-dnd.until     # "EPOCH CHOICE" while a timed one runs
morning() {   # the next 8:00, as seconds
  local t; t=$(date -d 'today 08:00' +%s) || return 1
  ((t > EPOCHSECONDS)) || t=$(date -d 'tomorrow 08:00' +%s)
  echo "$t"
}
dnd_set() {
  local end
  # a timer still waiting stopped first — and its service, but never from inside it: the timer's
  # own end runs "dnd end", and stopping the service it runs in would kill it before the quiet ends
  if [[ $1 == end ]]; then systemctl --user stop kawa-dnd-end.timer >/dev/null 2>&1; set -- off
  else systemctl --user stop kawa-dnd-end.timer kawa-dnd-end.service >/dev/null 2>&1; fi
  rm -f -- "$DND_UNTIL"
  case $1 in
    off) makoctl mode -r do-not-disturb >/dev/null; kawa-state set dnd off ;;
    on)  makoctl mode -a do-not-disturb >/dev/null; kawa-state set dnd on ;;
    hour|morning)
      if [[ $1 == hour ]]; then end=$((EPOCHSECONDS + 3600)); else end=$(morning) || return 1; fi
      kawa-state set dnd off                                     # (timed: not kept across a login)
      # (with this PATH: your systemd's own has no ~/.local/bin, where kawa-quick finds
      # kawa-state and kawa-dwlstatus — the bell would stay on the bar)
      # (--collect: gone once it has run, even failed — or the next timed one could not take its name)
      if systemd-run --user --quiet --collect --unit=kawa-dnd-end --on-active="$((end - EPOCHSECONDS))s" \
           --timer-property=AccuracySec=1s --setenv=PATH="$PATH" -- kawa-quick --do dnd end >/dev/null 2>&1; then
        echo "$end $1" >"$DND_UNTIL"
        makoctl mode -a do-not-disturb >/dev/null
      else   # (its end could not be set: no quiet at all — one that never ended would hide
             # every notice for good)
        notify-send -a desktop -- "$ICON_BELL_OFF  do not disturb" "its end could not be set (systemd --user) — it stays off"
      fi ;;
  esac
  kawa-dwlstatus --poke 12                                       # (the bar's bell)
}
dnd_menu() {   # its dropdown: the four, the one in force marked (the cursor on it)
  local cur=off end choice m when rows=() acts=() n=0 sel=1 i c a g name detail
  [[ $(state_dnd) == on ]] && cur=on
  if [[ $cur == on ]] && read -r end choice 2>/dev/null <"$DND_UNTIL" && [[ $end =~ ^[0-9]+$ ]] && ((end > EPOCHSECONDS)); then
    cur=$choice
  fi
  m=$(morning) || m=0
  when="8:00"; (($(date -d "@$m" +%j) != $(date +%j))) && when="8:00 tomorrow"
  line() { local IFS=$'\t'; rows+=("$*"); }
  line part "$ICON_BELL_OFF" "do not disturb" "$([[ $cur == @(hour|morning) ]] && date -d "@$end" '+until %-H:%M')"; acts+=(-)
  for c in "off|$ICON_BELL|off|notices as they come" "hour|$ICON_HOURGLASS|for an hour|until $(date -d "@$((EPOCHSECONDS + 3600))" +%-H:%M)" \
           "morning|$ICON_MOON|until the morning|$when" "on|$ICON_BELL_OFF|on|until you turn it off"; do
    IFS='|' read -r a g name detail <<<"$c"
    n=$((n + 1)); [[ $a == "$cur" ]] && sel=$n
    line "$([[ $a == "$cur" ]] && echo on || echo row)" "$g" "$name" "$detail"; acts+=("$a")
  done
  i=$(printf '%s\n' "${rows[@]}" | kawa-menu --drop --index --select "$sel") || return 0
  [[ $i =~ ^[0-9]+$ && -n ${acts[i]:-} && ${acts[i]} != - ]] || return 0
  dnd_set "${acts[i]}"
}
state_drives() {   # USB sticks, disks, SD cards plugged in (kawa-drives: one line per file system):
  # one by its name and size ("SANDISK 58G"), more by the first one's name and how many more
  # ("SANDISK +2") — the count alone is the bar's drive mark, right above
  local -a l; local n label
  mapfile -t l < <(kawa-drives list 2>/dev/null)
  n=$(printf '%s\n' "${l[@]}" | cut -f2 | sort -u | grep -c .)
  if ((n == 0)); then echo none
  elif ((n == 1)); then IFS=$'\t' read -r _ _ label size _ <<<"${l[0]}"; echo "$label $size"
  else IFS=$'\t' read -r _ _ label _ <<<"${l[0]}"; echo "$label +$((n - 1))"; fi
}
state_backup() { kawa-backup status 2>/dev/null || echo 'not set up'; }   # the last backup's age (never · 3 days ago · not set up)
state_sound() {   # the output's level, or muted
  local v; v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || { echo "no output"; return; }
  [[ $v == *MUTED* ]] && { echo muted; return; }
  [[ $v =~ ([0-9]+)\.([0-9]{2}) ]] && echo "$((10#${BASH_REMATCH[1]} * 100 + 10#${BASH_REMATCH[2]}))%" || echo "no output"
}
state_bright() {  # the monitors' level (the last read or set; read once if never)
  local l; l=$(timeout 3 kawa-brightness --level 2>/dev/null)
  [[ $l =~ ^[0-9]+$ ]] && echo "$l%" || echo "no DDC/CI"
}
state_wall() {    # the wallpaper this theme shows (its name, as the picker lists it)
  local c; c=$(cat "$HOME/.local/state/fedokawaii/wallpaper-$(state_theme)" 2>/dev/null)
  case ${c:-default} in default) echo default ;; pack:*) echo "${c#pack:}" ;; *) local b=${c##*/}; echo "${b%.*}" ;; esac
}
state_paired() {  # the Bluetooth devices connected now: one by name, more by their count
  local -a d
  [[ $1 == on ]] || { echo off; return; }
  mapfile -t d < <(bt devices Connected 2>/dev/null | sed -n 's/^Device [0-9A-Fa-f:]\{17\} //p')
  if ((${#d[@]} == 0)); then echo none
  elif ((${#d[@]} == 1)); then echo "${d[0]}"
  else echo "${#d[@]} connected"; fi
}

dwl_reload() {   # SIGUSR1 to dwl — only one that catches it (src/dwl/dwl.patch): to a build
  # without the handler the signal would end the session (as kawa-theme sends it)
  local pid k v
  for pid in $(pgrep -xu "$UID" dwl); do
    while read -r k v; do
      [[ $k == SigCgt: ]] || continue
      (( 16#$v >> 9 & 1 )) && kill -USR1 "$pid" 2>/dev/null
      break
    done 2>/dev/null <"/proc/$pid/status"
  done
  return 0
}

state_audio() {   # the sound panel's: the output's level and mute, the microphone's, the devices
  local v d
  v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
  if [[ $v =~ ([0-9]+)\.([0-9]{2}) ]]; then
    printf 'sound\t%s%%\n' "$((10#${BASH_REMATCH[1]} * 100 + 10#${BASH_REMATCH[2]}))"
  else printf 'sound\tno output\n'; fi
  [[ $v == *MUTED* ]] && printf 'muted\ton\n' || printf 'muted\toff\n'
  v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
  if [[ $v != *Volume:* ]]; then printf 'mic\tnone\n'
  elif [[ $v == *MUTED* ]]; then printf 'mic\tmuted\n'
  else printf 'mic\ton\n'; fi
  # the clean mic (~/.config/pipewire/pipewire.conf.d/60-clean-mic.conf, node clean_mic): on
  # while it is the default input — PipeWire's own default, read each time, never remembered
  # here. It is not a row: its key says it; while on, the row ticked is the microphone it
  # listens to (its capture stream's link)
  # the devices from pw-dump (JSON: a name with any characters is safe), the default ticked,
  # each with what names it (the panel makes its short name of them, kawa-panel's
  # device_names): its description, the port in use (its card's active route for it: Line
  # Out, Rear Microphone, HDMI / DisplayPort), its nick (an HDMI output's: the monitor's
  # name), its card's description, its profile's (Analog Stereo, Digital Stereo (HDMI)), its
  # API (alsa, bluez5). A control character (a tab, a line break) a space: one device a line.
  # Not "Share" (share_sink, ~/.config/pipewire): what plays there goes to calls, so it is
  # picked for one program at a time in the mixer — as the default, every sound would be shared
  d=$(pw-dump 2>/dev/null) || { printf 'cleanmic\tnone\n'; return 0; }   # (PipeWire not running: no devices)
  jq -r '
    ([.[] | select(.type == "PipeWire:Interface:Metadata" and .props["metadata.name"] == "default")
          | .metadata[]?] ) as $md
    | ($md | map(select(.key == "default.audio.sink"))   | .[0].value.name // "") as $sink
    | ($md | map(select(.key == "default.audio.source")) | .[0].value.name // "") as $src
    | ([.[] | select(.type == "PipeWire:Interface:Device") | {key: (.id | tostring), value: .}]
       | from_entries) as $cards
    | ([.[] | select(.type == "PipeWire:Interface:Node")]) as $nodes
    | ($nodes | map(select(.info.props["node.name"] == "clean_mic.capture")) | .[0].id // -1) as $cap
    | ([.[] | select(.type == "PipeWire:Interface:Link") | .info | select(.["input-node-id"] == $cap)
        | .["output-node-id"]] | .[0] // -1) as $heard
    | (if any($nodes[]; .info.props["node.name"] == "clean_mic") | not then "none"
       elif $src == "clean_mic" then "on" else "off" end) as $clean
    | "cleanmic\t\($clean)",
    ([$nodes[] | .info.props as $p
       | select($p["media.class"] == "Audio/Sink" or $p["media.class"] == "Audio/Source")
       | select($p["node.name"] != "share_sink" and $p["node.name"] != "clean_mic")
       | ($p["media.class"] == "Audio/Sink") as $out
       | ($cards[($p["device.id"] // "" | tostring)] // {}) as $card
       | [ (if $out then "output" else "input" end), .id,
           (if $p["node.name"] == $sink or $p["node.name"] == $src
               or ($clean == "on" and .id == $heard) then 1 else 0 end),
           ($p["node.description"] // $p["node.nick"] // $p["node.name"]),
           ([$card.info.params.Route[]?
             | select(.direction == (if $out then "Output" else "Input" end)
                      and .device == $p["card.profile.device"])] | .[0].description // ""),
           ($p["node.nick"] // ""), ($card.info.props["device.description"] // ""),
           ($p["device.profile.description"] // ""), ($p["device.api"] // "") ]]
    | (map(select(.[0] == "output")) + map(select(.[0] == "input")))[]
    | map(tostring | gsub("[[:cntrl:]]"; " ")) | join("\t"))' <<<"$d" 2>/dev/null
  return 0
}

# source_to ID — the default input made node ID (wpctl set-default: WirePlumber keeps it
# across restarts), and what was recording from the old default moved with it at once, a
# call's microphone too (pw-metadata target.object — Brave picks its microphone itself when a
# site names one, and such a stream would not follow the default alone); the old one's mute
# carried over (muted stays muted). Never the clean mic's own capture stream. With the clean
# mic loaded, its state kept too (kawa-state cleanmic on|off: every login puts it back). 1: no
# such input
source_to() {
  local d plan m to="" s clean=false
  d=$(pw-dump 2>/dev/null) || return 1
  plan=$(jq -r --argjson to "$1" '
    [.[] | select(.type == "PipeWire:Interface:Node")] as $n
    | ($n | map(select(.id == $to and .info.props["media.class"] == "Audio/Source")) | .[0]) as $t
    | if $t == null then empty else
      ([.[] | select(.type == "PipeWire:Interface:Metadata" and .props["metadata.name"] == "default")
        | .metadata[]? | select(.key == "default.audio.source") | .value.name] | .[0] // "") as $src
      | ($n | map(select(.info.props["node.name"] == $src)) | .[0].id // -1) as $old
      | "to\t\($t.info.props["node.name"])",
        "clean\t\(any($n[]; .info.props["node.name"] == "clean_mic"))",
        ([.[] | select(.type == "PipeWire:Interface:Link") | .info
          | select(.["output-node-id"] == $old) | .["input-node-id"]] | unique[]) as $s
        | ($n | map(select(.id == $s)) | .[0].info.props // {}) as $p
        | select($p["media.class"] == "Stream/Input/Audio" and $p["node.name"] != "clean_mic.capture")
        | "move\t\($s)"
      end' <<<"$d" 2>/dev/null)
  while IFS=$'\t' read -r s m; do
    case $s in to) to=$m ;; clean) clean=$m ;; esac
  done <<<"$plan"
  [[ -n $to ]] || return 1
  m=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
  wpctl set-default "$1" >/dev/null 2>&1 || return 1
  [[ $m == *Volume:* ]] && wpctl set-mute "$1" "$([[ $m == *MUTED* ]] && echo 1 || echo 0)"
  while IFS=$'\t' read -r s m; do
    [[ $s == move ]] && pw-metadata "$m" target.object "$to" >/dev/null 2>&1
  done <<<"$plan"
  [[ $clean == true ]] && kawa-state set cleanmic "$([[ $to == clean_mic ]] && echo on || echo off)"
  return 0
}

# clean_mic — the default input clean ⇄ raw. Clean → raw: the microphone the clean mic
# listens to (else the sound card's best). Raw → clean: the clean mic first told to listen
# to that raw one (its capture stream's target), then made the default. 1: not loaded
clean_mic() {
  local d st clean cap raw rawname
  d=$(pw-dump 2>/dev/null) || return 1
  read -r st clean cap raw rawname < <(jq -r '
    [.[] | select(.type == "PipeWire:Interface:Node")] as $n
    | ([.[] | select(.type == "PipeWire:Interface:Metadata" and .props["metadata.name"] == "default")
        | .metadata[]? | select(.key == "default.audio.source") | .value.name] | .[0] // "") as $src
    | ($n | map(select(.info.props["node.name"] == "clean_mic")) | .[0].id // empty) as $clean
    | ($n | map(select(.info.props["node.name"] == "clean_mic.capture")) | .[0].id // -1) as $cap
    | ([.[] | select(.type == "PipeWire:Interface:Link") | .info | select(.["input-node-id"] == $cap)
        | .["output-node-id"]] | .[0] // -1) as $heard
    | ($n | map(select(.info.props["media.class"] == "Audio/Source" and .info.props["node.name"] != "clean_mic"))
        | sort_by(-(.info.props["priority.session"] // 0))) as $raws
    | (if $src == "clean_mic" then ($raws | map(select(.id == $heard)) + $raws)
       else ($raws | map(select(.info.props["node.name"] == $src)) + $raws) end | .[0]) as $raw
    | select($raw != null)
    | [(if $src == "clean_mic" then "on" else "off" end), $clean, $cap, $raw.id, $raw.info.props["node.name"]]
    | map(tostring) | join(" ")' <<<"$d" 2>/dev/null)
  [[ -n ${raw:-} ]] || return 1
  if [[ $st == on ]]; then source_to "$raw"; return; fi
  ((cap >= 0)) && pw-metadata "$cap" target.object "$rawname" >/dev/null 2>&1
  source_to "$clean"
}

# mic_test — 5 s from the default input, played back at once: how the others hear you (the
# clean mic's noise suppression included while it is on). One at a time; a notice for each
# half, the first naming the input recorded ("Clean mic" while it is the default: the proof
# that calls get it)
mic_test() {
  local f="${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-mictest.wav" from
  exec 9>"$f.lock"; flock -n 9 || return 0
  from=$(wpctl inspect @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | sed -n 's/^[ *]*node\.description = "\(.*\)"$/\1/p' | head -n 1)
  notify-send -a desktop -t 5000 -- "$ICON_MIC  test mic" "recording 5 seconds from ${from:-the default input} — speak as in a call" 2>/dev/null
  timeout -s INT 5 pw-record --channels 1 "$f" >/dev/null 2>&1
  [[ -s $f ]] || { notify-send -a desktop -- "$ICON_MIC_OFF  test mic" "nothing recorded — is there a microphone (Super+A, under 入)?" 2>/dev/null; return 1; }
  notify-send -a desktop -t 5000 -- "$ICON_MIC  test mic" "playing it back" 2>/dev/null
  pw-play "$f" >/dev/null 2>&1
  rm -f -- "$f"
}

state() {   # everything, KEY<TAB>VALUE (a value's tabs and line breaks become spaces: a name
  local nettype net bt   # of yours — a Wi-Fi, a drive, a picture — cannot break a line)
  kv() { local v=${2//[$'\t\n\r']/ }; printf '%s\t%s\n' "$1" "$v"; }
  read -r nettype net <<<"$(state_net)"
  kv theme "$(state_theme)"; kv brightness "$(state_bright)"; kv night "$(state_night)"
  kv vrr "$(state_vrr)"; kv wallpaper "$(state_wall)"; kv sound "$(state_sound)"
  kv nettype "$nettype"; kv network "$net"
  if compgen -G '/sys/class/bluetooth/hci*' >/dev/null; then
    bt=$(state_bt); kv bluetooth "$bt"; kv devices "$(state_paired "$bt")"
  fi
  kv drives "$(state_drives)"; kv backup "$(state_backup)"; kv dnd "$(state_dnd)"
  kv saver "$(state_saver)"; kv record "$(state_record)"; kv vrrnow "$(state_vrrnow)"
}

act() {   # act ACTION [N] — the panel's choices
  local v
  case $1 in brightness|volume|output|input) (($# == 2)) || usage ;; dnd) (($# <= 2)) || usage ;; *) (($# == 1)) || usage ;; esac
  case $1 in
    theme)      kawa-theme toggle ;;
    night)      kawa-night toggle ;;                 # (kept: the next login finds it so)
    warmer|cooler) kawa-night "$1" ;;
    saver)      mkdir -p "${SAVER%/*}"             # on ⇄ off (off: the lock alone at 15 min)
                [[ $(state_saver) == off ]] && v=on || v=off
                echo "$v" >"$SAVER.$$" && mv -f "$SAVER.$$" "$SAVER" ;;   # (whole: kawa-saver never reads half)
    vrr)        mkdir -p "${VRR%/*}"   # in games → always → off → in games (dwl takes it up at once:
                case $(state_vrr) in 'in games') v=always ;; always) v=off ;; *) v=games ;; esac
                echo "$v" >"$VRR.$$" && mv -f "$VRR.$$" "$VRR"   # (SIGUSR1 makes it read the file again)
                dwl_reload ;;
    bluetooth)  if [[ $(state_bt) == on ]]; then bt power off >/dev/null; v=off
                elif ! v=$(bt power on 2>&1); then        # (an airplane-mode key, or a switch)
                  if [[ $v == *Blocked* ]]; then
                    notify-send -a desktop -- "$ICON_BLUETOOTH  Bluetooth" "it is blocked — rfkill unblock bluetooth (or the machine's own switch)"
                  else notify-send -a desktop -- "$ICON_BLUETOOTH  Bluetooth" "it did not switch on — is the bluetooth service running?"; fi
                  return 1
                else v=on; fi
                kawa-state set bluetooth "$v" ;;   # (kept: bluetoothd powers it at every boot otherwise)
    dnd)        case ${2:-} in
                  on|off|hour|morning|end) dnd_set "$2" ;;   # (end: the timer's own, below)
                  "") if [[ $(state_dnd) == on ]]; then dnd_set off; else dnd_set on; fi ;;
                  *) usage ;;
                esac ;;
    brightness) [[ ${2:-} =~ ^[0-9]{1,3}$ ]] && ((10#$2 <= 100)) || usage
                kawa-brightness "$((10#$2))" ;;
    volume)     [[ ${2:-} =~ ^[0-9]{1,3}$ ]] && ((10#$2 <= 100)) || usage
                wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ "$((10#$2))%" ;;
    mute)       wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    micmute)    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    output|input)                                                # (one unplugged meanwhile: 1, the panel reads again)
                [[ ${2:-} =~ ^[0-9]{1,9}$ ]] || usage
                if [[ $1 == input ]]; then source_to "$((10#$2))"
                else wpctl set-default "$((10#$2))" >/dev/null 2>&1 || return 1; fi ;;
    cleanmic)   clean_mic ;;
    mictest)    mic_test ;;
    sound)      toggle sound ;;                                 # (its own panel: outputs, inputs)
    mixer)      exec kawa-term --float --once mixer mixer 96x29 -- wiremix ;;   # (7 rows of 4 lines, the tabs)
    network)    exec kawa-term --float --once network network 80x25 -- nmtui ;;
    devices)    exec kawa-term --float --once pair 'pair a device' 96x29 -- bluetui ;;   # (the paired, the found, the adapter)
    drives)     exec kawa-drives ;;
    backup)     exec kawa-backup --window ;;
    wallpaper)  exec kawa-wallpaper ;;
    screenshot) exec kawa-screenshot region ;;
    record)     exec kawa-record ;;                             # (not recording: its menu · recording: stopped)
    ocr)        exec kawa-screenshot text ;;                    # (a region's words onto the clipboard)
    power)      exec kawa-power ;;
    *)          usage ;;
  esac
}

# (the panel itself: kawa-panel runs all session long (autostart), hidden until asked —
# a line into its fifo (kawa-panel.in) opens or closes it; should it not be running (it crashed and autostart has not
# started it again yet), it is started, open — done above, first thing)

case ${1:-} in
  --state) case ${2:-} in
             sound)      state_audio ;;
             brightness) printf 'brightness\t%s\n' "$(state_bright)" ;;
             *)          state ;;
           esac ;;
  --do)    act "${@:2}" ;;
  dnd)     dnd_menu ;;
esac
