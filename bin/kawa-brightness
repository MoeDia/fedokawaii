#!/usr/bin/env bash
# kawa-brightness — real monitor brightness over DDC/CI (what Twinkle Tray does on
# Windows): the monitor's own backlight changes, not a software dimming layer.
#
#   kawa-brightness +10|-10   step every monitor (Super+] / Super+[)
#   kawa-brightness 40        set every monitor to 40 % (quick settings' meter: shown there,
#                             so no level pops up over it)
#   kawa-brightness --level   the level now, in percent (quick settings shows it): the last
#                             one read or set this session, else read from the monitor
#
# Needs ddcutil (i2c-dev is loaded by the package; its udev rule gives the logged-in
# user the monitors' I2C buses) and DDC/CI switched on in the monitor's own menu.
# Detection is slow (~1 s), so the bus numbers are cached for the session (autostart
# clears the cache at each login; a monitor that stops answering means look again).
# A laptop's own screen has no DDC/CI: its backlight (/sys/class/backlight) moves with the
# monitors, set through logind, which lets the session's own user do it without root.
# Exit status: 0 done (or dropped: a held key's repeats) · 1 could not (no monitor answered,
# said in a notice) · 2 misuse.
set -u
arg=${1:-}
case $arg in
  --level) ;;
  [+-][0-9]|[+-][0-9][0-9]|[+-][0-9][0-9][0-9]|[0-9]|[0-9][0-9]|[0-9][0-9][0-9]) ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-brightness [+N|-N|N] (kawa-brightness --help)" >&2; exit 2 ;;
esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
CACHE="${XDG_RUNTIME_DIR:?}/kawa-ddc-buses"
LEVEL="$XDG_RUNTIME_DIR/kawa-brightness.level"   # (the last level read or set: instant to show)
if [[ $arg == --level ]]; then
  l=$(cat "$LEVEL" 2>/dev/null)
  [[ $l =~ ^[0-9]{1,3}$ ]] && { echo "$l"; exit 0; }
fi
SYS=${KAWA_SYSFS:-/sys}                       # (the tests point this at a made-up laptop)

PANEL=""
panel() {   # sets PANEL to a lit built-in screen's backlight (a laptop), or fails
  local c d t r rank=3 lit=0
  # only with a built-in panel connected: a desktop board's ACPI can offer a backlight
  # device that drives nothing, and the monitors' level must not be read from it
  for c in "$SYS"/class/drm/card*-eDP-* "$SYS"/class/drm/card*-LVDS-* "$SYS"/class/drm/card*-DSI-*; do
    [[ -r $c/status && $(<"$c/status") == connected ]] && lit=1
  done
  ((lit)) || return 1
  for d in "$SYS"/class/backlight/*; do       # several: the kind GNOME and KDE prefer —
    [[ -r $d/max_brightness && -r $d/brightness ]] || continue   # firmware, platform, raw
    t=""; [[ -r $d/type ]] && t=$(<"$d/type")
    case $t in firmware) r=0 ;; platform) r=1 ;; *) r=2 ;; esac
    ((r < rank)) && rank=$r PANEL=$d
  done
  [[ -n $PANEL ]]
}
panel_get() {   # → NOW, the panel's level in percent
  local cur max
  cur=$(<"$PANEL/brightness") max=$(<"$PANEL/max_brightness")
  [[ $cur =~ ^[0-9]+$ && $max =~ ^[0-9]+$ ]] && ((max > 0)) || return 1
  NOW=$(( (cur * 100 + max / 2) / max ))
}
panel_set() {   # panel_set PERCENT — never quite 0: a laptop panel at 0 is a black screen
  local max v
  max=$(<"$PANEL/max_brightness"); [[ $max =~ ^[0-9]+$ ]] && ((max > 0)) || return 1
  v=$(( $1 * max / 100 )); ((v < 1)) && v=1
  busctl call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
    org.freedesktop.login1.Session SetBrightness ssu backlight "${PANEL##*/}" "$v" >/dev/null 2>&1 \
    || { [[ -w $PANEL/brightness ]] && printf '%s\n' "$v" >"$PANEL/brightness"; }
}

buses() {
  # (looked for again also when the list holds anything but bus numbers or "-": a list cut
  # short or edited must not end in a false "no monitor answered")
  if [[ ! -s $CACHE ]] || grep -qvxE -- '[0-9]+|-' "$CACHE"; then
    # only "Display N" entries; "Invalid display" (no DDC/CI) is skipped
    ddcutil detect --terse 2>/dev/null | awk '
      /^Display [0-9]/   { ok = 1; next }
      /^[^ ]/            { ok = 0 }
      ok && /I2C bus:/   { sub(/.*\/dev\/i2c-/, ""); print }' >"$CACHE.tmp"
    # a laptop with no monitor answering keeps that answer too ("-"): its keys must not
    # wait a second for a fresh look at every press
    [[ -s $CACHE.tmp || -z $PANEL ]] || echo - >"$CACHE.tmp"
    mv -f "$CACHE.tmp" "$CACHE"
  fi
  local b
  while read -r b; do [[ $b =~ ^[0-9]+$ ]] && printf '%s\n' "$b"; done <"$CACHE"
}

MAX=100
get() {   # get BUS → sets NOW (percent) and MAX (the monitor's own scale, nearly always 100)
  local _vcp _code _type cur max
  read -r _vcp _code _type cur max <<<"$(ddcutil --bus "$1" getvcp 10 --terse 2>/dev/null)"
  [[ $cur =~ ^[0-9]+$ && $max =~ ^[0-9]+$ && $max -gt 0 ]] || return 1
  MAX=$max NOW=$((cur * 100 / max))
}

set_all() {   # set_all PERCENT — every monitor on its own scale (the first one's is known)
  local b
  [[ -n $PANEL ]] && { panel_set "$1" & }
  for b in "${BUSES[@]}"; do
    { m=$MAX
      if [[ $b != "${BUSES[0]}" ]]; then
        read -r _ _ _ _ m <<<"$(ddcutil --bus "$b" getvcp 10 --terse 2>/dev/null)"
        [[ $m =~ ^[0-9]+$ ]] && ((m > 0)) || m=100
      fi
      ddcutil --bus "$b" setvcp 10 $(($1 * m / 100)) --noverify >/dev/null 2>&1; } &
  done
  wait
}

note() { echo "$1" >"$LEVEL"; kawa-osd "$ICON_SUN" brightness "$1"; }   # the level, shown for a moment

# one DDC/CI conversation at a time: a held key repeats faster than monitors answer, and
# overlapping read-then-write cycles would lose steps (repeats are simply dropped)
exec 9>"${XDG_RUNTIME_DIR:?}/kawa-ddc.lock"
if [[ $arg == --level ]]; then flock -w 5 9 || exit 0; else flock -n 9 || exit 0; fi

panel
mapfile -t BUSES < <(buses)
# the buses may have been renumbered since they were cached (a monitor plugged in or out):
# a monitor that does not answer means look again, once
if ((${#BUSES[@]})) && ! get "${BUSES[0]}"; then
  rm -f "$CACHE"; mapfile -t BUSES < <(buses)
fi
if ((${#BUSES[@]} == 0)) && [[ -z $PANEL ]]; then
  rm -f "$CACHE"
  [[ $arg == --level ]] && exit 1
  notify-send -a desktop "$ICON_SUN  brightness" "no monitor answered over DDC/CI — turn DDC/CI on in the monitor's own menu"
  exit 1
fi
# a step needs the level it starts from: the laptop's own screen's, else the first monitor's
NOW=50
if [[ -n $PANEL ]]; then panel_get || exit 0
else get "${BUSES[0]}" || exit 0; fi
now=$NOW
echo "$now" >"$LEVEL"
[[ $arg == --level ]] && { echo "$now"; exit 0; }

if [[ $arg =~ ^[+-][0-9]{1,3}$ ]]; then
  new=$((now + 10#${arg:1} * (${arg:0:1}1))); ((new > 100)) && new=100; ((new < 0)) && new=0
  set_all "$new"; note "$new"; exit 0
else   # (a level: the usage above lets nothing else through; quick settings' meter shows it)
  new=$((10#$arg)); ((new > 100)) && new=100
  set_all "$new"; echo "$new" >"$LEVEL"
fi
