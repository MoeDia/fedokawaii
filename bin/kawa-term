#!/usr/bin/env bash
# kawa-term CMD [ARG…] — CMD in a new terminal window: footclient (instant, through the
# foot server the session keeps running), or a standalone foot if that server is down.
# footclient -N hands the window over and returns at once, so its status says only whether
# the server took it — never how CMD ended (a command that fails must not open twice).
# The "open with" entries for yazi and neovim use it (Files, Editor), so anything that
# opens a folder or a text file — Brave's "Show in folder", xdg-open, yazi — gets a window.
set -u
# started from systemd --user (a portal, xdg-open in a service) PATH lacks ~/.local/bin,
# where yazi and the desktop's helpers live — a standalone foot below needs it
case :$PATH: in *":$HOME/.local/bin:"*) ;; *) PATH=$HOME/.local/bin:$PATH ;; esac
(($#)) || set -- "${SHELL:-bash}"
footclient -N -- "$@" 2>/dev/null || exec foot -- "$@"
