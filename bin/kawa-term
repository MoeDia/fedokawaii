#!/usr/bin/env bash
# kawa-term CMD [ARG…] — CMD in a new terminal window: footclient, through the foot server
# the session keeps running (instant). footclient -N hands the window over and returns at
# once, so its status says only whether the server took it — never how CMD ended.
# The "open with" entries for yazi and neovim use it (Files, Editor), so anything that
# opens a folder or a text file — Brave's "Show in folder", xdg-open, yazi — gets a window.
#
# Exit: 0 the window opened · otherwise footclient's own status (the server down: autostart
# keeps it running; it says so when it cannot).
set -u
case ${1:-} in -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;; esac
(($#)) || set -- "${SHELL:-bash}"
exec footclient -N -- "$@"
