#!/usr/bin/env bash
# kawa-timer — the bar's time, and a click on it: a kitchen timer, or a stopwatch, counting
# beside the time.
#
#   kawa-timer                   the menu: 5 · 10 · 25 · 45 · 60 min, stopwatch (and cancel
#                                while one runs) — a dropdown under the time
#   kawa-timer start MINUTES     a timer of 1 to 1440 minutes (one at a time: a new one
#                                takes the place of the one before)
#   kawa-timer stopwatch         a stopwatch, from zero
#   kawa-timer cancel            the timer or stopwatch stopped (a stopwatch says where it stood)
#   kawa-timer bar               the bar's clock (waybar JSON, a line each second): the time
#                                ("08:52:07 PM"), lit (class "active") while its menu is open
#   kawa-timer bar timer         the bar's timer cell: the hourglass and the time left (class
#                                "timer") or gone by ("stopwatch") while one runs, else empty
#                                — a cell of its own, so the clock's patch keeps its width
#   kawa-timer ring END          what start leaves behind: at END (epoch seconds) a critical
#                                notice with the bell, and a chime (pw-play)
#
# The timer lives in $XDG_RUNTIME_DIR/kawa-timer ("timer END MINUTES SET" or "stopwatch
# START"), so it outlives the bar (a waybar restart draws it again) and goes with the session.
# Exit status: 0 done (or dismissed) · 1 no runtime folder · 2 misuse.
set -u
export LC_ALL=C.UTF-8                            # (EPOCHREALTIME with a dot, whatever the locale)
case :$PATH: in *":$HOME/.local/bin:"*) ;; *) PATH=$HOME/.local/bin:$PATH ;; esac
RUN=${XDG_RUNTIME_DIR:-}
[[ ${1:-} == -h || ${1:-} == --help ]] && { sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0; }
[[ -n $RUN && -d $RUN ]] || { echo "kawa-timer: no runtime folder (XDG_RUNTIME_DIR)" >&2; exit 1; }
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
STATE=$RUN/kawa-timer

clock() {   # clock VAR SECONDS → VAR: 04:05 · 24:59 · 1:02:03 (hours only past one; minutes always
  # two figures, as the clock beside it, so the bar never shifts as they count down)
  local s=$2
  if ((s >= 3600)); then printf -v "$1" '%d:%02d:%02d' $((s / 3600)) $((s % 3600 / 60)) $((s % 60))
  else printf -v "$1" '%02d:%02d' $((s / 60)) $((s % 60)); fi
}
running() {   # running → KIND A B C from the state (1: none, or a timer already over)
  local k a b c
  read -r k a b c 2>/dev/null <"$STATE" || return 1
  [[ $a =~ ^[0-9]+$ ]] || return 1
  [[ $k == stopwatch ]] || { [[ $k == timer ]] && ((a > EPOCHSECONDS)); } || return 1
  printf '%s %s %s %s\n' "$k" "$a" "${b:-}" "${c:-}"
}
wake() {   # every bar draws the change at once (each listens on a fifo of its own, as the
  # bar's other long-running modules do: kawa-dwlstatus --wake writes to them all)
  local w
  for w in "$RUN"/kawa-bar.wake.*; do [[ -p $w ]] && { printf '\n' 1<>"$w"; } 2>/dev/null; done
  return 0
}
stop_ring() { pkill -u "$UID" -f '(^|/)kawa-timer ring [0-9]+$' 2>/dev/null; return 0; }   # (the one before)
nap() {   # nap SECONDS (a fraction too) — a read that times out on a fifo of its own: no process
  local w=$RUN/kawa-timer.nap.$BASHPID fd
  mkfifo -m 600 -- "$w" && exec {fd}<>"$w" && rm -f -- "$w" || return 1
  read -r -t "$1" -u "$fd" _
  exec {fd}<&-
}
put() { printf '%s\n' "$1" >"$STATE.$$" && mv -f "$STATE.$$" "$STATE"; }

start() {
  local m=$1 end set
  [[ $m =~ ^[0-9]{1,4}$ ]] && ((10#$m >= 1 && 10#$m <= 1440)) \
    || { echo "kawa-timer: start takes minutes, 1 to 1440 — not \"$m\"" >&2; return 2; }
  m=$((10#$m)); end=$((EPOCHSECONDS + m * 60))
  stop_ring
  printf -v set '%(%I:%M %p)T' -1                   # (as the bar's clock writes it)
  put "timer $end $m $set" || return 1
  wake
  setsid -f "$0" ring "$end" >/dev/null 2>&1 </dev/null
}
stopwatch() { stop_ring; put "stopwatch $EPOCHSECONDS" && wake; }
cancel() {
  local k a _
  local t
  read -r k a _ < <(running) || { rm -f -- "$STATE"; wake; return 0; }
  stop_ring; rm -f -- "$STATE"; wake
  clock t $((EPOCHSECONDS - a))
  [[ $k == stopwatch ]] && notify-send -a desktop -- "$ICON_HOURGLASS  stopwatch" "stopped at $t" 2>/dev/null
  return 0
}

# ── the end: the bell, and a chime ──────────────────────────────────────────────
# The chime is drawn here, as the bar is: three short square-wave beeps at 1 kHz (8 bit, 8 kHz
# — a kitchen timer's voice), written once into the runtime folder and played by pw-play
# (PipeWire's own player: no sound theme needed)
chime() {
  local f=$RUN/kawa-timer.wav beep="" gap="" data="" i n LC_ALL=C   # (C: a byte is a letter)
  if [[ ! -s $f ]]; then
    for ((i = 0; i < 100; i++)); do beep+=$'\xb0\xb0\xb0\xb0\x50\x50\x50\x50'; done   # 0.1 s
    for ((i = 0; i < 80; i++)); do gap+=$'\x80\x80\x80\x80\x80\x80\x80\x80'; done     # 0.08 s
    data=$beep$gap$beep$gap$beep
    n=${#data}
    le32() { printf '\\x%02x\\x%02x\\x%02x\\x%02x' $(($1 & 255)) $(($1 >> 8 & 255)) $(($1 >> 16 & 255)) $(($1 >> 24 & 255)); }
    # shellcheck disable=SC2059  # (the header's bytes are the format)
    { printf "RIFF$(le32 $((36 + n)))WAVEfmt $(le32 16)\\x01\\x00\\x01\\x00$(le32 8000)$(le32 8000)\\x01\\x00\\x08\\x00data$(le32 "$n")"
      printf '%s' "$data"; } >"$f.$$" && mv -f "$f.$$" "$f"
  fi
  pw-play "$f" >/dev/null 2>&1 &
}
ring() {
  local end=$1 k a m set
  [[ $end =~ ^[0-9]+$ ]] || return 2
  while ((end > EPOCHSECONDS)); do nap $((end - EPOCHSECONDS)) || return 1; done
  read -r k a m set 2>/dev/null <"$STATE" || return 0
  [[ $k == timer && $a == "$end" ]] || return 0   # (cancelled, or another took its place)
  rm -f -- "$STATE"; wake
  notify-send -a desktop -u critical -- "$ICON_BELL  time is up" "the ${m} min timer set at ${set:-?} has ended" 2>/dev/null
  chime
}

# ── the bar ─────────────────────────────────────────────────────────────────────
bar() {
  local cell=${1:-time} w=$RUN/kawa-bar.wake.$$ fd k a b c s t now line last="" us frac cls tm
  # shellcheck source=kawa-bar
  . "${BASH_SOURCE[0]%/*}/kawa-bar"                 # bar_lit (bash alone)
  trap 'exit 0' TERM HUP INT PIPE                 # (waybar closing it: its fifo goes too)
  for line in "$RUN"/kawa-bar.wake.* "$RUN"/kawa-timer.wake.*; do   # (a bar that was killed: its fifo goes)
    [[ -p $line ]] && ! kill -0 "${line##*.}" 2>/dev/null && rm -f -- "$line"
  done
  mkfifo -m 600 -- "$w" && exec {fd}<>"$w" || return 1
  trap 'rm -f -- "$w"' EXIT
  while :; do
    printf -v now '%(%I:%M:%S %p)T' -1
    tm="" cls=""
    # (the colours are style.css's: vermilion left, asagi gone by — the classes say which)
    if [[ $cell == timer ]] && read -r k a b c 2>/dev/null <"$STATE" && [[ $a =~ ^[0-9]+$ ]]; then
      if [[ $k == timer ]] && ((a > EPOCHSECONDS)); then
        clock t $((a - EPOCHSECONDS)); tm=$ICON_BAR_HOURGLASS$t cls='"timer"'
      elif [[ $k == stopwatch ]]; then
        s=$((EPOCHSECONDS - a)); ((s < 0)) && s=0; clock t "$s"; tm=$ICON_BAR_HOURGLASS$t cls='"stopwatch"'
      fi
    fi
    if [[ $cell == timer ]]; then
      if [[ -n $tm ]] && bar_lit time; then cls="[$cls,\"active\"]"; fi
      line="{\"text\":\"$tm\"${cls:+,\"class\":$cls}}"
    else
      # (an hour from 10 to 12: its first figure, a 1, has a column of air of its own — "l1":
      # style.css takes it back, so the kanji to the time stays 14 px)
      [[ $now == 1* ]] && cls='"l1"'
      if bar_lit time; then cls=${cls:+[$cls,\"active\"]}; cls=${cls:-'"active"'}; fi
      line="{\"text\":\"$now\"${cls:+,\"class\":$cls}}"
    fi
    [[ $line == "$last" ]] || { printf '%s\n' "$line" || exit 0; last=$line; }
    # to the next whole second, with no process started: a read that times out (or a wake)
    us=${EPOCHREALTIME#*.}; us=$((1000000 - 10#$us)); printf -v frac '%06d' $((us % 1000000))
    read -r -t "$((us / 1000000)).$frac" -u "$fd" _
  done
}

# ── the menu ────────────────────────────────────────────────────────────────────
menu() {
  # in the panel's line format (kawa-menu; docs/design-system.md): 時 timer, the one running
  # at the heading's end ("04:05 left", "stopwatch 1:02:03"); a row a length (" 5 min",
  # "10 min": the figures right-aligned, the font is monospaced), the stopwatch, and cancel
  # while one runs
  local i m k a t="" v
  local -a rows=() acts=()
  line() { local IFS=$'\t'; rows+=("$*"); }
  if read -r k a _ < <(running); then
    if [[ $k == timer ]]; then clock v $((a - EPOCHSECONDS)); t="$v left"
    else clock v $((EPOCHSECONDS - a)); t="stopwatch $v"; fi
  fi
  line part "$ICON_HOURGLASS" timer "$t"; acts+=(-)
  for m in 5 10 25 45 60; do printf -v v '%2d min' "$m"; line row "$ICON_HOURGLASS" "$v"; acts+=("start $m"); done
  line row "$ICON_HOURGLASS" stopwatch; acts+=(stopwatch)
  [[ -n $t ]] && { line row "$ICON_CROSS" "cancel the $k"; acts+=(cancel); }
  i=$(printf '%s\n' "${rows[@]}" | kawa-menu --drop --middle --index --select 1) || return 0
  case ${acts[i]:--} in
    "start "*) start "${acts[i]#start }" ;;
    stopwatch) stopwatch ;;
    cancel)    cancel ;;
  esac
}

case ${1:-} in
  "")        menu ;;
  start)     (($# == 2)) || { echo "usage: kawa-timer start MINUTES" >&2; exit 2; }; start "$2" ;;
  stopwatch) (($# == 1)) || exit 2; stopwatch ;;
  cancel)    (($# == 1)) || exit 2; cancel ;;
  bar)       (($# == 1)) || [[ $# == 2 && $2 == timer ]] || exit 2; bar "${2:-time}" ;;
  ring)      (($# == 2)) || exit 2; ring "$2" ;;
  *)         echo "kawa-timer: unknown command $1 (kawa-timer --help)" >&2; exit 2 ;;
esac
