#!/usr/bin/env bash
# kawa-clip — Super+V: the clipboard history (cliphist) in a small floating terminal.
# Newest first; type to filter, ↑/↓ or the mouse to move, the full text (or the picture)
# shows underneath. All in the terminal's 16 colours, so it follows dark/light like foot.
#
#   Enter     put that entry back on the clipboard (and close) — then paste as usual
#   Super+Z   shrink or convert that entry, a picture or a PDF (kawa-shrink): the result
#             lands on the clipboard and at the top of this list, under the cursor
#   Ctrl+D    forget that entry          Ctrl+X   forget them all (asks first)
#   Esc       close, the clipboard exactly as it was
#
# The other forms are its own parts: --tui (inside the window), --list, --preview ID,
# --copy ID, --decode ID, --delete ID, --wipe, --focus PID [ID], --held, --poke, and --store,
# which keeps each new copy: the session's wl-paste --watch runs it (autostart.sh). Text and
# pictures are kept — the last 100 copies, none bigger than 20 MiB. Copies outlive the app
# they came from (kawa-clipkeep).
#
# cliphist (0.7, Fedora's) keeps nothing over 5,000,000 bytes and says nothing about it (its
# store returns at once; newer versions name it -max-store-size): a photo or a 4K screenshot
# copied never reached the history. Such a copy is kept here instead, whole, as a file in
# ~/.cache/kawa-clip/big/ named by its SHA-256's first 16 figures, and the history holds a line
# standing in for it — "kawa-clip:big TYPE WxH BYTES NAME" (WxH "-" for what is no picture;
# well under the 100 characters cliphist's list shows of a line) — which the list shows as the
# picture it is and --decode turns back into its bytes (the preview, Enter, Super+Z all read it
# so). A file whose line has left the history (the newest 100 kept, one forgotten, all wiped)
# goes with it.
#
# While the window is open, $XDG_RUNTIME_DIR/kawa-clip.current says which entry its cursor
# is on — "PID ID", PID the window's own kawa-clip, ID empty while the search matches
# nothing — and fzf listens on kawa-clip.sock: --held reads the first (Super+Z, dwl's key,
# asks it), --store pokes the second so a new copy shows at once. Both go with the window.
set -u
RUN=${XDG_RUNTIME_DIR:-/tmp}                         # (a shell outside the session has none)
CUR=$RUN/kawa-clip.current SOCK=$RUN/kawa-clip.sock  # (the open window: see above)
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/current/colors.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/screen.sh"
# every list of the desktop looks alike: one options file (rules, colours, the chevron)
export FZF_DEFAULT_OPTS_FILE=$HOME/.config/fedokawaii/fzf.opts; unset FZF_DEFAULT_OPTS
# ImageMagick reads its format names ("info:") through the locale's letter case: in
# Turkish an i is not an I, and it writes a file called "info:" instead of answering
magick() { LC_ALL=C command magick "$@"; }
KEEP=(-max-items 100)                                # cliphist: the newest 100 copies, the rest forgotten
MAX_BYTES=$((20 << 20))                              # a bigger copy is not kept (a 20 MiB picture is ~5000×4000)
CLIPHIST_MAX=5000000                                 # cliphist's own: above it, kept as a file (see the top)
BIG=${XDG_CACHE_HOME:-$HOME/.cache}/kawa-clip/big    # those files

entry() { printf '%s\t\n' "$1"; }            # cliphist's own line form: "ID<tab>…"
# decode ID — the entry's bytes on stdout: cliphist's, or — a line standing in for a big copy —
# the file it stands for. 1: no such entry, or its file gone
decode() {
  local t line="" r
  t=$(mktemp "$RUN/kawa-clip.XXXXXX") || return 1     # (the window clears such files: one a killed preview left)
  entry "$1" | cliphist decode >"$t" 2>/dev/null
  IFS= read -r -n 160 line <"$t" 2>/dev/null
  if [[ $line =~ ^kawa-clip:big\ [^\ ]+\ [^\ ]+\ [0-9]+\ ([0-9a-f]{16})$ ]]; then cat -- "$BIG/${BASH_REMATCH[1]}" 2>/dev/null
  else cat -- "$t"; fi
  r=$?; rm -f -- "$t"; return "$r"
}
# prune — the big copies' files no line of the history stands for any more: gone
prune() {
  [[ -d $BIG ]] || return 0
  local keep f
  keep=$(cliphist list 2>/dev/null | sed -n 's/^[0-9]*\tkawa-clip:big [^ ]* [^ ]* [0-9]* \([0-9a-f]\{16\}\)$/\1/p')
  for f in "$BIG"/*; do
    [[ -f $f ]] || continue
    grep -qxF -- "${f##*/}" <<<"$keep" || rm -f -- "$f"
  done
}
# window — the open window's kawa-clip, from $CUR: its pid, and the entry under the cursor in
# $held. Fails when no window is open: no file, one not ours, or its process gone — a window
# killed outright leaves the file behind, and its pid may since be another program's
window() {
  local p="" id="" a=() s
  [[ -f $CUR && -O $CUR ]] && read -r p id 2>/dev/null <"$CUR" || return 1
  [[ $p =~ ^[1-9][0-9]*$ && ( -z $id || $id =~ ^[0-9]+$ ) ]] || return 1
  mapfile -d '' -t a 2>/dev/null <"/proc/$p/cmdline"      # (bash SCRIPT --tui)
  s=${a[1]:-}; [[ ${s##*/} == kawa-clip && ${a[2]:-} == --tui ]] || return 1
  held=$id
}
# poke — the window open: its list read again, the cursor on the top entry (the newest copy),
# through fzf's own socket (--listen)
poke() {
  window || return 0
  curl -s --max-time 2 --unix-socket "$SOCK" --data-binary "reload($(printf '%q' "$0") --list)+first" \
    http://localhost/ >/dev/null 2>&1
  return 0
}

case ${1:-} in
  --list)       # ID<tab>the row (docs/design-system.md §7): its glyph, what it holds — text as
    # cliphist keeps it, a picture or data named — and, for those, its size right-aligned; W
    # columns wide: fzf's own width less a column each side (FZF_COLUMNS, which fzf tells a
    # reload), or the window's (80 columns: 76)
    w=76; [[ ${FZF_COLUMNS:-} =~ ^[0-9]+$ ]] && ((FZF_COLUMNS > 20)) && w=$((FZF_COLUMNS - 2))
    # (classes, not ranges: in Turkish, "i" is not within a-z)
    cliphist list 2>/dev/null | while IFS=$'\t' read -r id rest; do
      if [[ $rest =~ ^\[\[\ binary\ data\ ([0-9.]+\ [KMG]?i?B)\ ([[:alnum:]+.-]+)\ ([0-9]+)x([0-9]+)\ \]\]$ ]]; then
        printf '%s\t%s\n' "$id" "$(screen_row "$ICON_PICTURE" "${BASH_REMATCH[2]} picture" \
          "${BASH_REMATCH[3]}×${BASH_REMATCH[4]} · ${BASH_REMATCH[1]}" "$w")"
      elif [[ $rest =~ ^kawa-clip:big\ image/([[:alnum:]+.-]+)\ ([0-9]+)x([0-9]+)\ ([0-9]+)\ [0-9a-f]{16}$ ]]; then
        # (a big copy kept as a file: listed as cliphist lists a picture — its MiB as cliphist rounds them)
        printf '%s\t%s\n' "$id" "$(screen_row "$ICON_PICTURE" "${BASH_REMATCH[1]} picture" \
          "${BASH_REMATCH[2]}×${BASH_REMATCH[3]} · $(( (BASH_REMATCH[4] + (1 << 19)) >> 20 )) MiB" "$w")"
      elif [[ $rest =~ ^kawa-clip:big\ ([^\ ]+)\ -\ ([0-9]+)\ [0-9a-f]{16}$ ]]; then
        printf '%s\t%s\n' "$id" "$(screen_row "$ICON_BOX_OFF" data "${BASH_REMATCH[1]} · $(( (BASH_REMATCH[2] + (1 << 19)) >> 20 )) MiB" "$w")"
      elif [[ $rest =~ ^\[\[\ binary\ data\ (.*)\ \]\]$ ]]; then
        printf '%s\t%s\n' "$id" "$(screen_row "$ICON_BOX_OFF" data "${BASH_REMATCH[1]}" "$w")"
      elif [[ $rest == *�* ]]; then   # bytes that are not text (cliphist 0.7 shows them as �,
        # and the odd characters among them scramble the rows): named, the preview tells more
        printf '%s\t%s\n' "$id" "$(screen_row "$ICON_BOX_OFF" data "not text" "$w")"
      else      # an escape in a copy is shown as ^[ — fzf would act on it (other control
                # characters fzf itself shows as ^G, ^H…); a long one fzf cuts at the edge
        printf '%s\t %s%s%s  %s\n' "$id" "$INK_MUTED" "$ICON_CLIPBOARD" "$INK_OFF" "${rest//$'\e'/^[}"   # (screen_row's columns)
      fi
    done
    exit 0 ;;
  --preview)    # what is under the list: the whole text, or the picture itself
    [[ ${2:-} =~ ^[0-9]+$ ]] || exit 0
    tmp=$(mktemp "$RUN/kawa-clip.XXXXXX") || exit 0
    trap 'rm -f "$tmp"' EXIT
    decode "$2" >"$tmp" || exit 0
    # text is whatever has a character set — code, mail and keys too, which `file` names
    # application/javascript, message/rfc822, application/pgp-keys…
    mime=$(file -b --mime "$tmp" 2>/dev/null); type=${mime%%;*}
    [[ $type != image/* && $mime != *charset=binary* ]] && type=text/plain
    case $type in
      image/*)
        # the picture (its first frame), never enlarged, centred in the preview: as far
        # below the rule as above the window's foot. It never reaches the last line (a
        # sixel touching it would scroll the whole window up a line: fzf #2544), so it is
        # drawn one line shorter and a line of ground is put above it
        # — and, so its margins are equal to the pixel, a width and height of the same
        # parity as the area's (one edge row or column trimmed if need be, never resampled)
        cell=${KAWA_CELL:?}; ch=${cell#*x}
        aw=$(( ${FZF_PREVIEW_COLUMNS:-74} * ${cell%x*} )) bh=$(( (${FZF_PREVIEW_LINES:-9} - 2) * ch ))
        w0=0 h0=0; read -r w0 h0 < <(magick "${tmp}[0]" -format '%w %h\n' info: 2>/dev/null)
        if ((aw > 0 && bh > 0 && w0 > 0 && h0 > 0)); then
          sw=$w0 sh=$h0 fit=()
          if ((sw > aw || sh > bh)); then
            if ((sw * bh > sh * aw)); then sh=$(( sh * aw / sw )) sw=$aw; else sw=$(( sw * bh / sh )) sh=$bh; fi
            ((sw > 0 && sh > 0)) || { sw=1 sh=1; }
            fit=(-resize "${sw}x${sh}!")
          fi
          nw=$sw nh=$sh
          (( (aw - nw) % 2 && nw > 1 )) && nw=$((nw - 1))
          (( (bh - nh) % 2 && nh > 1 )) && nh=$((nh - 1))
          if magick "${tmp}[0]" "${fit[@]}" -crop "${nw}x${nh}+0+0" +repage -background "#$C_GROUND" \
               -gravity center -extent "${aw}x${bh}" -gravity south -extent "${aw}x$((bh + ch))" png:- 2>/dev/null \
               | kawa-sixel "$C_GROUND"; then
            printf '\n'; exit 0
          fi
        fi
        printf '   %s  picture (%s)\n' "$ICON_PICTURE" "${type#image/}" ;;
      text/*|inode/x-empty)
        # in the column of the list's glyphs (a wrapped line too: --preview-wrap-sign); an
        # escape as ^[ (an escape code would act on the preview: colour it, clear it), a CR
        # before a line's end left out (text from Windows)
        head -c 65536 "$tmp" | sed -e 's/\r$//' -e 's/\x1b/^[/g' -e 's/^/   /' ;;
      *) printf '   %s  %s, %s bytes\n' "$ICON_BOX_OFF" "$type" "$(stat -c %s "$tmp")" ;;
    esac
    exit 0 ;;
  --copy)       # back on the clipboard; wl-copy keeps serving it after this window closes
    [[ ${2:-} =~ ^[0-9]+$ ]] || exit 1
    # (the window closes as this runs: a notice is the only way to say so)
    command -v wl-copy >/dev/null || { notify-send -a desktop -u critical -- "$ICON_CLIPBOARD  clipboard" "wl-copy is missing — fedokawaii repair puts it back" 2>/dev/null; exit 1; }
    tmp=$(mktemp "$RUN/kawa-clip.XXXXXX") || exit 1
    trap 'rm -f "$tmp"' EXIT
    decode "$2" >"$tmp" && [[ -s $tmp ]] || exit 1
    # its own session: closing the window keeps it. A picture is offered as what it is
    # (image/png…), so the program you paste into takes a picture; text as wl-copy finds it
    type=$(file -b --mime-type "$tmp" 2>/dev/null)
    if [[ $type == image/* ]]; then setsid -f wl-copy --type "$type" <"$tmp"
    else setsid -f wl-copy <"$tmp"; fi
    exit 0 ;;
  --store)      # a new copy into the history: wl-paste --watch runs this at every copy, with the
                # copy on stdin as wl-paste chose it (text, when there is any) and how it went in
                # CLIPBOARD_STATE — "data", or "sensitive" (a password manager's), "clear", "nil"
    # (cliphist's own way with those; the window, open, shows what came of it — of any copy)
    [[ ${CLIPBOARD_STATE:-} == data ]] || { cliphist "${KEEP[@]}" store; r=$?; poke; exit "$r"; }
    types=$(wl-paste --list-types 2>/dev/null)
    # kawa-clipkeep offering a copy again once its program closed: stored when it was made
    if grep -qxF application/x-kawa-clipkeep <<<"$types"; then cat >/dev/null; exit 0; fi
    tmp=$(mktemp "$RUN/kawa-clip-store.XXXXXX") || exit 0
    trap 'rm -f "$tmp"' EXIT
    head -c $((MAX_BYTES + 1)) >"$tmp"; cat >/dev/null      # (all read: the copying program never waits)
    # A picture is kept as the picture — PNG when it is offered as one — unless the copy is
    # text that only comes with a picture of itself (cells from a spreadsheet). Text that is
    # just the picture's address counts as none: Brave's "Copy image" offers the picture,
    # its <img> tag and its link, and wl-paste hands over the link
    pic=$(grep -m1 -x image/png <<<"$types" || grep -m1 '^image/' <<<"$types")
    if [[ -n $pic ]] && { ! grep -qxE 'text/plain(;charset=utf-8)?|UTF8_STRING|STRING|TEXT' <<<"$types" \
                          || { (($(grep -c '' "$tmp") <= 1)) \
                               && grep -qE '^[[:space:]]*(https?|file|data|blob):[^[:space:]]+[[:space:]]*$' "$tmp"; }; }; then
      wl-paste --no-newline --type "$pic" 2>/dev/null | head -c $((MAX_BYTES + 1)) >"$tmp"
    fi
    size=$(stat -c %s "$tmp")
    ((size <= MAX_BYTES)) || exit 0
    if ((size > CLIPHIST_MAX)); then
      # (more than cliphist keeps: the copy as a file, the history a line standing for it — see
      # the top; the same copy again is the same file and the same line, so it shows once)
      sum=$(sha256sum <"$tmp") sum=${sum:0:16}
      mkdir -p -- "$BIG" || exit 1
      [[ -s $BIG/$sum ]] || { cp -- "$tmp" "$BIG/$sum.part" && mv -f -- "$BIG/$sum.part" "$BIG/$sum"; } || exit 1
      t=$(file -b --mime-type "$tmp" 2>/dev/null) dims=-
      [[ $t == image/* ]] && dims=$(magick "${tmp}[0]" -format '%wx%h' info: 2>/dev/null)
      [[ $dims =~ ^[0-9]+x[0-9]+$ ]] || dims=-
      printf 'kawa-clip:big %s %s %s %s' "${t:-application/octet-stream}" "$dims" "$size" "$sum" \
        | cliphist "${KEEP[@]}" store; r=$?
    else
      cliphist "${KEEP[@]}" store <"$tmp"; r=$?
    fi
    prune                                                     # (one the newest 100 pushed out: its file too)
    poke
    exit "$r" ;;
  --decode)     # an entry's bytes, a big copy's too (the preview, Enter and Super+Z read them so)
    [[ ${2:-} =~ ^[0-9]+$ ]] || exit 2
    decode "$2"; exit ;;
  --delete)
    [[ ${2:-} =~ ^[0-9]+$ ]] && entry "$2" | cliphist delete
    prune
    exit 0 ;;
  --focus)      # fzf's, at each move: the window PID's cursor is on entry ID now — none, while
                # the search matches nothing (see the top)
    [[ ${2:-} =~ ^[1-9][0-9]*$ && ${3:-} =~ ^[0-9]*$ ]] || exit 0
    printf '%s %s\n' "$2" "${3:-}" >"$CUR.$2" && mv -f -- "$CUR.$2" "$CUR"
    exit 0 ;;
  --held)       # the entry under the open window's cursor (an empty line: none); exit 1: no window
    # shown — a warm window put away is open still, but not for Super+Z (kawa-warm's mark)
    [[ -e $RUN/kawa-warm-clip.shown ]] && window || exit 1
    printf '%s\n' "$held"
    exit 0 ;;
  --wipe)       # asks in the window itself
    n=$(cliphist list 2>/dev/null | wc -l)
    ((n)) || exit 0
    printf '\n  forget all %d entries, and empty the clipboard?  [y/N] ' "$n"
    read -rsn1 a </dev/tty
    # (the clipboard emptied too: what was copied last is gone for every app, and for Super+Z)
    [[ $a == [yY] ]] && { cliphist wipe; prune; wl-copy --clear; }
    exit 0 ;;
  --poke)       # the open window's list read again (kawa-warm, as it shows)
    poke; exit 0 ;;
  --tui) ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  "")           # Super+V: the window — warm (kawa-warm): shown, or put away
    exec kawa-warm clip ;;
  *) echo "usage: kawa-clip   (Super+V: the clipboard history)" >&2; exit 2 ;;
esac

# ── inside the window ─────────────────────────────────────────────────────────
KAWA_CELL=$(kawa-cell) || exit 1   # the cell's pixels: previews fit exactly
export KAWA_CELL
# fzf kills a preview it no longer needs outright (SIGKILL): the copies such previews were
# reading are in memory (the runtime folder) until cleared — here, as one window is open
rm -f -- "$RUN"/kawa-clip.?????? 2>/dev/null
# A text screen (docs/design-system.md §7, screen.sh): the heading — its icon, clipboard, the
# rule across the window's 76 columns — then the search line, whose empty field says how the
# list stands (newest first, or why it is empty), the list, the preview under its rule, its keys.
head="$(screen_heading "$ICON_CLIPBOARD" clipboard 76)"$'\n '
if ! command -v cliphist >/dev/null; then ghost='cliphist is missing — fedokawaii repair puts it back'
elif [[ -n $(cliphist list 2>/dev/null | head -c1) ]]; then ghost='newest first'
else ghost='nothing copied yet'; fi
self=$(printf '%q' "$0") pid=$$
# Which entry the cursor is on, for Super+Z (dwl's key, so kawa-shrink asks: --held): kept in
# $CUR at every move and every new result (a search, a reload — fzf's "focus" misses a new
# entry landing where the cursor is), and none while nothing matches (fzf runs no command
# naming {1} then: the second one). The file goes with the window — closed by Esc or Enter,
# or from outside (dwl hangs up its process group); one this window no longer owns stays
gone() {
  local p=""
  read -r p _ 2>/dev/null <"$CUR"
  [[ $p == "$pid" ]] && rm -f -- "$CUR"
  rm -f -- "$CUR.$pid" "$SOCK"
}
trap gone EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
rm -f -- "$SOCK"                                     # (a window killed outright left it)
"$0" --focus "$pid"                                  # open, nothing under the cursor yet
# Ended by a key (a copy, Esc): in the warm window, put away first — while the list is still
# drawn (dwl's ghost of it fades, never a page fzf wiped on its way out: kawa-warm --away)
away=""; [[ ${KAWA_WARM:-} == clip ]] && away="execute-silent(kawa-warm --away clip)+"
fzf --ansi --no-sort --height=100% \
  --delimiter=$'\t' --with-nth=2.. --scheme=history --header="$head" --ghost="$ghost" \
  --preview="$self --preview {1}" --preview-window='down,9,wrap-word,border-top,noinfo' --preview-wrap-sign='   ' \
  --footer=$'\n'"$(screen_keys super+z shrink '' ctrl+d forget '' ctrl+x 'forget all' '')" \
  --listen="$SOCK" \
  --bind="focus:execute-silent($self --focus $pid {1})" \
  --bind="result:execute-silent($self --focus $pid {1})+execute-silent([ \"\$FZF_MATCH_COUNT\" != 0 ] || $self --focus $pid)" \
  --bind="enter:${away}become($self --copy {1})" \
  --bind="esc,ctrl-c,ctrl-g,ctrl-q:${away}abort" \
  --bind="ctrl-d:execute-silent($self --delete {1})+reload($self --list)" \
  --bind="ctrl-x:execute($self --wipe)+reload($self --list)" \
  < <("$0" --list)
