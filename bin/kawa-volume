#!/usr/bin/env bash
# kawa-volume up|down [STEP] | mute | mic — the volume keys (STEP 5 %) and Super+scroll
# (STEP 2 %): change it, then show the level for a moment (kawa-osd), updating in place while
# you keep pressing — also in fullscreen, when the bar is hidden. Up unmutes and stops at
# 100 %; a level set higher in the mixer stays as it is.
# kawa-volume bar — the bar's volume (waybar JSON, a line whenever it changes): the speaker,
# its waves showing the level (none at 0, one up to 25 %, two to 50, three to 75, four above)
# and the number, its % quiet; muted: the speaker crossed out and "off". Lit (class "active")
# while the sound panel, which a click on it opens, is on screen (kawa-bar). It follows
# PipeWire's own events (pw-mon: a level, a mute, another output) and the panel's poke
# (kawa-dwlstatus wakes it: a fifo of its own, $XDG_RUNTIME_DIR/kawa-bar.wake.PID); nothing
# is polled. It ends when PipeWire does (waybar starts it again).
# Exit status: 0 done · 1 could not (no sound output or input, PipeWire not running) · 2 misuse.
set -u
case ${1:-} in
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
esac
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"

bar() {
  local w=${XDG_RUNTIME_DIR:?}/kawa-bar.wake.$$ p=$XDG_RUNTIME_DIR/kawa-bar.volume.$$ fd feeder line last=""
  local pct="" muted=0 pushed=0 due=0 now t frac
  # shellcheck source=kawa-bar
  . "${BASH_SOURCE[0]%/*}/kawa-bar"                 # bar_lit (bash alone)
  mkfifo -m 600 -- "$w" && exec {fd}<>"$w" && ln -sfn -- "${w##*/}" "$p" || return 1
  # PipeWire's changes, as a line into the same fifo: pw-mon writes a block per change of any
  # object; a Node's (a level, a mute) or the Metadata's (the default output) are this one's —
  # not a Client's, which every wpctl below is (it would wake this again, for ever)
  (
    exec 2>/dev/null
    while IFS= read -r line; do
      case $line in *'type: PipeWire:Interface:Node'*|*'type: PipeWire:Interface:Metadata'*) printf '\n' >&"$fd" ;; esac
    done < <(exec pw-mon -N -o -a)
    printf 'END\n' >&"$fd"                        # (PipeWire gone: so is this, until waybar's restart)
  ) &
  feeder=$!
  trap 'pkill -P "$feeder" 2>/dev/null; kill "$feeder" 2>/dev/null; rm -f -- "$w" "$p"' EXIT
  trap 'exit 0' TERM HUP INT PIPE
  look() {   # the level and mute as PipeWire has them now (pct "" with no output)
    local vol="" state=""
    read -r _ vol state < <(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    if [[ $vol =~ ^([0-9]+)\.([0-9]{2}) ]]; then
      pct=$((10#${BASH_REMATCH[1]} * 100 + 10#${BASH_REMATCH[2]})); muted=0
      [[ $state == *MUTED* ]] && muted=1
    else pct=""; fi
  }
  draw() {   # the line for $pct and $muted, printed when it changed
    local icon cls="" tip line
    if [[ -n $pct ]]; then
      if ((muted)); then
        # (ICON_BAR_*, no space: exactly 6 px from the icon's ink to the value's)
        line="$ICON_BAR_VOL_MUTE<span fgalpha='55%'>off</span>" cls='"muted"' tip="volume off ($pct %)"
      else
        if ((pct == 0)); then icon=$ICON_BAR_VOL_0; elif ((pct <= 25)); then icon=$ICON_BAR_VOL_1
        elif ((pct <= 50)); then icon=$ICON_BAR_VOL_2; elif ((pct <= 75)); then icon=$ICON_BAR_VOL_3
        else icon=$ICON_BAR_VOL_4; fi
        line="$icon$pct<span fgalpha='55%'>%</span>" tip="volume $pct %"
      fi
      tip="$tip · click: the sound panel · right-click: mute · scroll: ±2 %"
      # (lit: its panel open under it — no tooltip, which would show behind the panel)
      bar_lit volume && cls="[${cls:+$cls,}\"active\"]" tip=""
      line="{\"text\":\"$line\",\"tooltip\":\"$tip\"${cls:+,\"class\":$cls}}"
    else
      line='{"text":""}'                           # (no output: hidden)
    fi
    [[ $line == "$last" ]] || { printf '%s\n' "$line" || exit 0; last=$line; }
  }
  look; draw
  # Each line in the fifo: "volume PCT MUTED" pushed by whoever changed it (the sound panel's
  # meter dragged, a volume key — bar_push) is drawn at once, no process asked; an empty one
  # (PipeWire's event, or a wake: the panel opened or closed) is drawn at once too, from
  # PipeWire's own answer — except while levels are being pushed: PipeWire then reports
  # the steps that were set a moment ago, older than the newest pushed, so it is asked once,
  # 300 ms after the last push (the level the meter, the key's display and the bar agree on)
  while :; do
    if ((due)); then
      now=${EPOCHREALTIME/[.,]/}; t=$((due - now)); printf -v frac '%06d' $((t % 1000000))
      if ((t <= 0)) || ! IFS= read -r -t "$((t / 1000000)).$frac" -u "$fd" line; then
        due=0; look; draw; continue
      fi
    else
      IFS= read -r -u "$fd" line || exit 0
    fi
    local ev=0 got=0
    while :; do                                    # (every line waiting now, the newest wins)
      case $line in
        END) exit 0 ;;
        "volume "*) read -r _ t muted <<<"$line"
                    [[ $t =~ ^[0-9]{1,3}$ && $muted =~ ^[01]$ ]] && { pct=$t; got=1; pushed=${EPOCHREALTIME/[.,]/}; } ;;
        *) ev=1 ;;
      esac
      read -r -t 0 -u "$fd" || break
      IFS= read -r -u "$fd" line || break
    done
    if ((ev)) && ((${EPOCHREALTIME/[.,]/} - pushed >= 300000)); then look
    elif ((ev)); then due=$((pushed + 300000)); fi
    ((got || ev)) && draw
  done
}
[[ ${1:-} == bar ]] && { (($# == 1)) || { echo "usage: kawa-volume bar" >&2; exit 2; }; bar; exit; }
# one change at a time: a held key repeats faster than wpctl answers, so a press that comes
# while one is still being applied is dropped (no backlog that keeps changing the volume
# after you let go), and the level shown is always the one the last change left
step=${2:-5}
[[ $step =~ ^[1-9][0-9]?$ && $# -le 2 && ( $# -le 1 || ${1:-} == up || ${1:-} == down ) ]] \
  || { echo "usage: kawa-volume up|down [STEP 1-99] | mute | mic" >&2; exit 2; }
exec 9>"${XDG_RUNTIME_DIR:?}/kawa-volume.lock"; flock -n 9 || exit 0
case ${1:-} in
  up)   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
        # up to 100 %; a level set higher in the mixer (wiremix goes to 150 %) stays as it
        # is — wpctl's limit would pull it down to 100 %, the louder key making it quieter
        read -r _ vol _ <<<"$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
        [[ $vol =~ ^[1-9][0-9]*\. ]] || wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$step%+" ;;
  down) wpctl set-volume @DEFAULT_AUDIO_SINK@ "$step%-" ;;
  mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
  mic)  wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
  *)    echo "usage: kawa-volume up|down [STEP 1-99] | mute | mic" >&2; exit 2 ;;
esac || exit 1

if [[ $1 == mic ]]; then
  read -r _ vol state <<<"$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)"
  icon=$ICON_MIC label=microphone
else
  read -r _ vol state <<<"$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)"
  label=volume
fi
[[ $vol =~ ^([0-9]+)\.([0-9]{2}) ]] || exit 0                 # "Volume: 0.62 [MUTED]"
pct=$((10#${BASH_REMATCH[1]} * 100 + 10#${BASH_REMATCH[2]}))
off=""
# the volume's glyph as the sound panel's meter has it (and the bar): the speaker with its
# waves for the level — none at 0, one to 25 %, two to 50, three to 75, four above —
# crossed out while muted
if [[ $1 != mic ]]; then
  if ((pct == 0)); then icon=$ICON_VOL_0; elif ((pct <= 25)); then icon=$ICON_VOL_1
  elif ((pct <= 50)); then icon=$ICON_VOL_2; elif ((pct <= 75)); then icon=$ICON_VOL_3
  else icon=$ICON_VOL_4; fi
fi
if [[ $state == *MUTED* ]]; then
  [[ $1 == mic ]] && icon=$ICON_MIC_OFF || icon=$ICON_VOL_MUTE
  off=off
fi
# the bar's level the same moment (pushed: no process asked), then shown — the change is
# done whether or not it shows
if [[ $1 != mic ]]; then
  # shellcheck source=kawa-bar
  . "${BASH_SOURCE[0]%/*}/kawa-bar"
  m=0; [[ -n $off ]] && m=1
  bar_push volume "volume $pct $m"
fi
kawa-osd "$icon" "$label" "$pct" $off 9>&- || :
