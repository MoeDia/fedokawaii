#!/usr/bin/env bash
# kawa-menu — one look for every small menu: the panel's, drawn as the sound panel is — parts
# under kanji seals, rows, keys —, list order kept; and the launcher.
#
#   … | kawa-menu [--drop] [--title TEXT] [--width N] [--lines N] [--select N] [--prompt P] [--index]
#   kawa-menu --launcher
#
#   the lines   one a thing, its fields apart by tabs (kawa-panel's "a menu"): part KANJI NAME
#               [VALUE] · row|on|off GLYPH NAME [DETAIL [VALUE]] · key GLYPH NAME · cell TEXT
#               [today|dim|head] · note TEXT · an empty line · any other line: a choice of
#               that text
#   --drop      open as a dropdown from the bar: under the button just clicked, or from a key
#               under the bar's right end (where quick settings' panel opens too); its button
#               lit while it is open; otherwise in the middle of the screen
#   --launcher  the launcher itself (fuzzel's own list of programs: the torii and Super+Space),
#               in the middle of the screen, fuzzel's own place
#   --title     a quiet line above the list
#   --width N   at least N columns of 6 px (without it the menu is as wide as its content)
#   --lines N   at most N rows show; a longer list scrolls (the wheel, the cursor)
#   --select N  the line the first arrow, Tab or Enter puts the cursor on (it opens with none)
#   --prompt P  a line to type in at the top, P before it: typing filters the choices (Enter
#               on none of them gives what was typed)
#   --index     print the chosen line's number (0-based) instead of its name
#
# A menu is shown by the session's panel (kawa-panel), asked through its fifo with bash alone
# (no process started on the way): the request in $XDG_RUNTIME_DIR/kawa-menu.PID.req, the
# answer read from the fifo kawa-menu.PID.out. The panel decides everything else, in one
# place, in the order the requests come: one menu at a time, the script's menu that is open
# closes again (its key or bar button), a click on its own bar button that closed it is not
# a new open, every key press counts (dwl repeats no held key that opens a menu: presses as
# fast as you like end open after an odd number), the bar's button lit exactly while it is
# on screen.
# The launcher (fuzzel) the same way, kept here: its record $XDG_RUNTIME_DIR/kawa-launcher.state
# ("PID HOW LOST USED": fuzzel's pid; open, toggled, lost or done; the bar click that
# closed it; the last bar click answered), its button lit by
# kawa-launcher.open (this script's pid) and a poke (SIGRTMIN+20). A plain fuzzel — a
# passphrase — is left alone: the launcher then does not open.
# Prints the chosen line; exits 1 when the menu is dismissed (Esc, a click outside, its key
# again) or cannot open, 2 on wrong use.
set -u
usage() { echo "usage: … | kawa-menu [--drop] [--title TEXT] [--width N] [--lines N] [--select N] [--prompt P] [--index] · kawa-menu --launcher" >&2; exit 2; }
pargs=()                                      # (a menu's options, as the panel takes them)
launcher=0 idx=0
while (($#)); do
  case $1 in
    --drop)   pargs+=(--drop); shift; continue ;;
    --launcher) launcher=1; shift; continue ;;
    --index)  idx=1; pargs+=(--index); shift; continue ;;
    -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    --title|--width|--lines|--select|--prompt) (($# >= 2)) || usage ;;
    *) echo "kawa-menu: unknown option $1" >&2; usage ;;
  esac
  case $1 in
    --width|--lines|--select) [[ $2 =~ ^[0-9]+$ ]] || { echo "kawa-menu: $1 takes a number" >&2; usage; } ;;
  esac
  [[ $2 == *$'\n'* ]] && { echo "kawa-menu: $1 takes one line" >&2; usage; }
  pargs+=("$1" "$2")
  shift 2
done
((launcher && ${#pargs[@]})) && { echo "kawa-menu: --launcher takes no other option" >&2; usage; }
run=${XDG_RUNTIME_DIR:-/run/user/$UID}
now() { local t=${KAWA_MENU_TIME:-$EPOCHREALTIME}; printf '%s' "${t//[!0-9]/}"; }   # µs (tests stand in)

# the running panel (its pid file, that pid's command line: bash's own reads) → $panel
panel=""
alive() {
  local p="" a=()
  read -r p 2>/dev/null <"$run/kawa-panel.pid"
  [[ $p =~ ^[1-9][0-9]*$ ]] && mapfile -d '' -t a 2>/dev/null <"/proc/$p/cmdline" && [[ " ${a[*]} " == *kawa-panel* ]] \
    && [[ -p $run/kawa-panel.in ]] && panel=$p
}
ask() { { printf '%s\n' "$1" 1<>"$run/kawa-panel.in"; } 2>/dev/null; }   # (one write: arrives whole)

if ((!launcher)); then
  # ── a menu: the panel's ──────────────────────────────────────────────────────────────
  [[ -d $run ]] || { echo "kawa-menu: no runtime folder ($run)" >&2; exit 1; }
  # the script that asked (an interpreter's script: its first argument that is no option —
  # bash's, python3 -I's), else the program: the panel's toggle is by it (the calendar's
  # button closes the calendar), and so is the bar's lit button
  me="" a=()
  mapfile -d '' -t a 2>/dev/null </proc/$PPID/cmdline
  case ${a[0]##*/} in
    bash|sh|python3*) for x in "${a[@]:1}"; do [[ $x == -* ]] || { me=$x; break; }; done ;;
    *) me=${a[0]:-} ;;
  esac
  me=${me:-?}
  me=${me##*/}; me=${me//[[:space:]]/_}
  req=$run/kawa-menu.$$.req out=$run/kawa-menu.$$.out
  trap 'rm -f "$req" "$out"' EXIT
  trap 'exit 1' TERM HUP INT                    # (the panel sees this end: its menu goes)
  { printf '%s\n%s\n' "$me" "${#pargs[@]}"; ((${#pargs[@]})) && printf '%s\n' "${pargs[@]}"; cat; } >"$req" || exit 1
  rm -f "$out"; mkfifo -m 600 "$out" && exec 5<>"$out" || exit 1
  if ! alive; then                              # (none running: started, and waited for — 3 s)
    setsid -f kawa-panel </dev/null >/dev/null 2>&1
    for _ in {1..60}; do alive && break; read -r -t 0.05 -u 5 _; done
    [[ -n $panel ]] || { echo "kawa-menu: no panel to show the menu (is the session's kawa-panel running?)" >&2; exit 1; }
  fi
  ask "menu $$" || exit 1
  # the answer: "RC TEXT" (while it is open, the panel looked at once a second: gone, dismissed)
  until IFS= read -r -t 1 -u 5 line; do
    (($? > 128)) || exit 1
    p0=$panel panel=""; alive && [[ $panel == "$p0" ]] || exit 1   # (gone, or another one now)
  done
  rc=${line%% *} out_=${line#* }
  [[ $rc == 0 ]] || { [[ $rc == 2 ]] && echo "kawa-menu: the panel did not take the menu" >&2; exit 1; }
  # Enter on a filter that matches nothing hands back the typed text: with --index, callers
  # use the answer as an array index, so anything but a line number counts as dismissed
  ((idx)) && [[ ! $out_ =~ ^[0-9]+$ ]] && exit 1
  printf '%s\n' "$out_"
  exit 0
fi

# ── the launcher: fuzzel ─────────────────────────────────────────────────────────────────
command -v fuzzel >/dev/null || { . "$HOME/.config/fedokawaii/icons.sh"; notify-send -a desktop -u critical -- "$ICON_CHEVRON  menus" "fuzzel is missing — fedokawaii repair puts it back" 2>/dev/null; exit 1; }
# the bar click this is (dwl rewrites dwl-pointer at every press on the bar, a new file each
# time: its inode and time are that press), while fresh — else none: a key
click() {
  local s ino mt t
  s=$(LC_ALL=C stat -c '%i %.6Y' "$run/dwl-pointer" 2>/dev/null) || return 0
  read -r ino mt <<<"$s"; mt=${mt//[!0-9]/}; t=$(now)
  [[ $mt =~ ^[0-9]+$ ]] && (( t - 10#$mt < 1000000 && 10#$mt - t < 1000000 )) && printf '%s.%s' "$ino" "$mt"
  return 0
}
rec=$run/kawa-launcher.state
{ exec 9>>"$rec"; } 2>/dev/null && flock -w 2 9 2>/dev/null || rec=""
put() { [[ -n $rec ]] && printf '%s %s %s %s\n' "${1:--}" "${2:--}" "${3:--}" "${4:--}" >"$rec"; }
pid=- how=- lost=- used=-
this=$(click)
if [[ -n $rec ]]; then
  # (a launcher that has just ended — the click outside it on its own button that runs this —
  # but whose script has not yet written so: the lock let go a moment for it to; one that
  # never does, killed, counts as none after 0.2 s)
  for _ in {1..8}; do
    pid=- how=- lost=- used=- c=""
    read -r pid how lost used _ 2>/dev/null <"$rec"
    [[ $pid =~ ^[1-9][0-9]*$ ]] && read -r c 2>/dev/null </proc/"$pid"/comm
    [[ $how == open && $c != fuzzel && $c != kawa-menu && $pid =~ ^[1-9][0-9]*$ ]] || break
    flock -u 9; sleep 0.025; flock -w 2 9 || exit 1
  done
  if [[ -n $this && $this == "$used" ]]; then this=""; fi   # (that click was answered: a key)
  [[ -n $this ]] && used=$this
  # open — or on its way up (not yet fuzzel: still this script's child): its key or button
  # closes it
  if [[ $how == open && ( $c == fuzzel || $c == kawa-menu ) ]]; then
    kill "$pid" 2>/dev/null; put "$pid" toggled - "$used"
    # gone before the next press is heard (it waits for this lock): fuzzel's own lock let go,
    # so a press right after opens it again — never taken for a passphrase's fuzzel
    for _ in {1..40}; do [[ -e /proc/$pid ]] || break; sleep 0.025; done
    exit 1
  fi
  if [[ -n $this && $how == lost && $lost == "$this" ]]; then
    put - "done" - "$used"; exit 1               # (the click outside that closed it was on its button)
  fi
fi
# a plain fuzzel (a passphrase) holds fuzzel's own lock: left alone (75: the lock is held; a
# lock file that cannot be opened is fuzzel's to warn about)
if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
  flock -n -E 75 "$run/fuzzel-$WAYLAND_DISPLAY.lock" true 2>/dev/null
  (($? == 75)) && { put - "done" - "$used"; exit 1; }
fi
alive && ask close                             # (the panel's menu or panel on screen: closed)
# the torii lit while it is open: kawa-launcher.open holds this script's pid, and it goes
# however this ends (fuzzel closed or killed, or this script stopped)
lit() {
  if [[ $1 == on ]]; then { printf '%s\n' "$$" >"$run/kawa-launcher.open"; } 2>/dev/null
  else rm -f "$run/kawa-launcher.open"; fi
  kawa-dwlstatus --poke 20 2>/dev/null || true
}
fz=""
trap '[[ -n $fz ]] && lit off' EXIT
trap '[[ -n $fz ]] && kill "$fz" 2>/dev/null; exit 1' TERM HUP INT
fuzzel </dev/null 9>&- & fz=$!
put "$fz" open - "$used"
[[ -n $rec ]] && flock -u 9
lit on
wait "$fz"; rc=$?
if [[ -n $rec ]] && flock -w 2 9; then
  p="" h=""; read -r p h _ 2>/dev/null <"$rec"
  if [[ $p == "$fz" && $h == open ]]; then        # (unless its key closed it, and wrote so)
    l=-; ((rc == 0)) || { l=$(click); [[ -n $l && $l != "$used" ]] || l=-; }
    if [[ $l != - ]]; then put "$fz" lost "$l" "$used"; else put "$fz" "done" - "$used"; fi
  fi
  flock -u 9
fi
exit $((rc == 0 ? 0 : 1))
