#!/usr/bin/env bash
# kawa-menu — one look for every small menu: the panel's, drawn as the sound panel is — parts
# under kanji seals, rows, keys —, list order kept; and the launcher.
#
#   … | kawa-menu [--drop] [--title TEXT] [--width N] [--lines N] [--select N] [--prompt P] [--index] [--stay]
#   kawa-menu --launcher
#
#   the lines   one a thing, its fields apart by tabs (kawa-panel's "a menu"): part KANJI NAME
#               [VALUE] · row|on|off|info GLYPH NAME [DETAIL [VALUE]] · key GLYPH NAME · cell TEXT
#               [today|dim|head] · note TEXT · an empty line · any other line: a choice of
#               that text
#   --drop      open as a dropdown from the bar: under the button just clicked, or from a key
#               under the bar's right end (where quick settings' panel opens too); its button
#               lit while it is open; otherwise in the middle of the screen
#   --launcher  the launcher itself (the panel's: the torii and Super+Space), in the middle
#               of the screen — open, or closed when it is open
#   --title     a quiet line above the list
#   --width N   at least N columns of 7 px (without it the menu is as wide as its content)
#   --lines N   at most N rows show; a longer list scrolls (the wheel, the cursor)
#   --select N  the line the cursor opens on (else the first choice: Enter takes it at once;
#               the pointer moves it — one cursor, the pointer's or the keys')
#   --prompt P  a line to type in at the top, P before it: typing filters the choices (Enter
#               on none of them gives what was typed)
#   --index     print the chosen line's number (0-based) instead of its name
#   --password  with --prompt: what is typed shows as ◆ each (a passphrase), and Enter gives it
#   --stay      a key line chosen is printed and the menu stays on screen: the caller's next
#               kawa-menu (its next page — the calendar's months) takes its place in the same
#               window, at once; keys pressed meanwhile are done on it, none lost. Nothing
#               asked within a second: it closes
#
# A menu is shown by the session's panel (kawa-panel), asked through its fifo with bash alone
# (no process started on the way): the request in $XDG_RUNTIME_DIR/kawa-menu.PID.req, the
# answer read from the fifo kawa-menu.PID.out. The panel decides everything else, in one
# place, in the order the requests come: one menu at a time, the script's menu that is open
# closes again (its key or bar button), a click on its own bar button that closed it is not
# a new open, every key press counts (dwl repeats no held key that opens a menu: presses as
# fast as you like end open after an odd number), the bar's button lit exactly while it is
# on screen.
# The launcher the same way: the panel's own ("toggle launcher" through its fifo).
# Prints the chosen line; exits 1 when the menu is dismissed (Esc, a click outside, its key
# again) or cannot open, 2 on wrong use.
set -u
usage() { echo "usage: … | kawa-menu [--drop] [--title TEXT] [--width N] [--lines N] [--select N] [--prompt P [--password]] [--index] [--stay] · kawa-menu --launcher" >&2; exit 2; }
pargs=()                                      # (a menu's options, as the panel takes them)
launcher=0 idx=0
while (($#)); do
  case $1 in
    --drop)   pargs+=(--drop); shift; continue ;;
    --launcher) launcher=1; shift; continue ;;
    --index)  idx=1; pargs+=(--index); shift; continue ;;
    --stay)   pargs+=(--stay); shift; continue ;;
    --password) pargs+=(--password); shift; continue ;;
    -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    --title|--width|--lines|--select|--prompt) (($# >= 2)) || usage ;;
    *) echo "kawa-menu: unknown option $1" >&2; usage ;;
  esac
  case $1 in
    --width|--lines|--select) [[ $2 =~ ^[0-9]+$ ]] || { echo "kawa-menu: $1 takes a number" >&2; usage; } ;;
  esac
  [[ $2 == *$'\n'* ]] && { echo "kawa-menu: $1 takes one line" >&2; usage; }
  pargs+=("$1" "$2")
  shift 2
done
((launcher && ${#pargs[@]})) && { echo "kawa-menu: --launcher takes no other option" >&2; usage; }
run=${XDG_RUNTIME_DIR:-/run/user/$UID}

# the running panel (its pid file, that pid's command line: bash's own reads) → $panel
panel=""
alive() {
  local p="" a=()
  read -r p 2>/dev/null <"$run/kawa-panel.pid"
  [[ $p =~ ^[1-9][0-9]*$ ]] && mapfile -d '' -t a 2>/dev/null <"/proc/$p/cmdline" && [[ " ${a[*]} " == *kawa-panel* ]] \
    && [[ -p $run/kawa-panel.in ]] && panel=$p
}
ask() { { printf '%s\n' "$1" 1<>"$run/kawa-panel.in"; } 2>/dev/null; }   # (one write: arrives whole)

if ((!launcher)); then
  # ── a menu: the panel's ──────────────────────────────────────────────────────────────
  [[ -d $run ]] || { echo "kawa-menu: no runtime folder ($run)" >&2; exit 1; }
  # the script that asked (an interpreter's script: its first argument that is no option —
  # bash's, python3 -I's), else the program: the panel's toggle is by it (the calendar's
  # button closes the calendar), and so is the bar's lit button
  me="" a=()
  mapfile -d '' -t a 2>/dev/null </proc/$PPID/cmdline
  case ${a[0]##*/} in
    bash|sh|python3*) for x in "${a[@]:1}"; do [[ $x == -* ]] || { me=$x; break; }; done ;;
    *) me=${a[0]:-} ;;
  esac
  me=${me:-?}
  me=${me##*/}; me=${me//[[:space:]]/_}
  req=$run/kawa-menu.$$.req out=$run/kawa-menu.$$.out
  trap 'rm -f "$req" "$out"' EXIT
  trap 'exit 1' TERM HUP INT                    # (the panel sees this end: its menu goes)
  { printf '%s\n%s\n' "$me" "${#pargs[@]}"; ((${#pargs[@]})) && printf '%s\n' "${pargs[@]}"; cat; } >"$req" || exit 1
  rm -f "$out"; mkfifo -m 600 "$out" && exec 5<>"$out" || exit 1
  if ! alive; then                              # (none running: started, and waited for — 3 s)
    setsid -f kawa-panel </dev/null >/dev/null 2>&1
    for _ in {1..60}; do alive && break; read -r -t 0.05 -u 5 _; done
    [[ -n $panel ]] || { echo "kawa-menu: no panel to show the menu (is the session's kawa-panel running?)" >&2; exit 1; }
  fi
  ask "menu $$" || exit 1
  # the answer: "RC TEXT" (while it is open, the panel looked at once a second: gone, dismissed)
  until IFS= read -r -t 1 -u 5 line; do
    (($? > 128)) || exit 1
    p0=$panel panel=""; alive && [[ $panel == "$p0" ]] || exit 1   # (gone, or another one now)
  done
  rc=${line%% *} out_=${line#* }
  [[ $rc == 0 ]] || { [[ $rc == 2 ]] && echo "kawa-menu: the panel did not take the menu" >&2; exit 1; }
  # Enter on a filter that matches nothing hands back the typed text: with --index, callers
  # use the answer as an array index, so anything but a line number counts as dismissed
  ((idx)) && [[ ! $out_ =~ ^[0-9]+$ ]] && exit 1
  printf '%s\n' "$out_"
  exit 0
fi

# ── the launcher: the panel's ────────────────────────────────────────────────────────────
if ! alive; then
  setsid -f kawa-panel </dev/null >/dev/null 2>&1
  for _ in {1..60}; do alive && break; sleep 0.05; done
  [[ -n $panel ]] || { echo "kawa-menu: no panel to show the launcher (is the session's kawa-panel running?)" >&2; exit 1; }
fi
ask "toggle launcher" || exit 1
exit 0
