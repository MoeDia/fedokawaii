#!/usr/bin/env bash
# kawa-menu — one look for every small menu: fuzzel in dmenu mode, list order kept.
#
#   … | kawa-menu [--drop] [--title TEXT] [--width N] [--lines N] [--select N] [--prompt P] [--index]
#
#   --drop      open as a dropdown under the bar's right end (quick settings, audio,
#               calendar, brightness); otherwise centred on screen like the launcher
#   --title     a quiet line above the list (fuzzel --mesg)
#   --select N  pre-select line N (0-based)
#   --prompt P  show a filter prompt (dropdowns hide it; typing still filters)
#   --index     print the chosen line's number (0-based) instead of its text
#
# One menu at a time, as on other desktops: the key or bar button of the menu on screen
# closes it again, another menu's takes its place, and a key held down (dwl repeats it) is
# one press. (A plain fuzzel — the launcher, a passphrase — is left alone: the menu then
# does not open.)
# Prints the chosen line; exits 1 when the menu is dismissed (Esc, a click outside, its key
# again) or cannot open, 2 on wrong use.
set -u
usage() { echo "usage: … | kawa-menu [--drop] [--title TEXT] [--width N] [--lines N] [--select N] [--prompt P] [--index]" >&2; exit 2; }
C_MUTED=877f6f                                      # (the dark theme's, if none is set up)
# shellcheck source=/dev/null
[[ -r $HOME/.config/fedokawaii/current/colors.sh ]] && . "$HOME/.config/fedokawaii/current/colors.sh"
args=(--dmenu --no-sort --minimal-lines "--message-color=${C_MUTED}ff")   # the title line, quiet
drop=0 prompt="" idx=0
while (($#)); do
  case $1 in
    --drop)   drop=1; shift; continue ;;
    --index)  args+=(--index); idx=1; shift; continue ;;
    -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    --title|--width|--lines|--select|--prompt) (($# >= 2)) || usage ;;
    *) echo "kawa-menu: unknown option $1" >&2; usage ;;
  esac
  case $1 in
    --width|--lines|--select) [[ $2 =~ ^[0-9]+$ ]] || { echo "kawa-menu: $1 takes a number" >&2; usage; } ;;&
    --title)  [[ -n $2 ]] && args+=("--mesg=$2") ;;       # (an empty one would be a blank line)
    --width)  args+=("--width=$2") ;;
    --lines)  args+=("--lines=$2") ;;
    --select) args+=("--select-index=$2") ;;
    --prompt) prompt=$2 ;;
  esac
  shift 2
done
if ((drop)); then args+=(--anchor=top-right --x-margin=6 --y-margin=6); fi
if [[ -n $prompt ]]; then args+=("--prompt=$prompt"); else args+=(--hide-prompt); fi
command -v fuzzel >/dev/null || { notify-send -a desktop -u critical "Menus" "fuzzel is missing — run update or repair" 2>/dev/null; exit 1; }

# ── one menu at a time ────────────────────────────────────────────────────────────────
# $rec says which menu is on screen: fuzzel's pid, when (µs), how it stands — open; lost (a
# click outside closed it); toggled (its own key closed it); chosen (or Esc, or another menu
# took its place) — and the script that opened it. Read and written under a lock: a held key
# starts a dozen at once. (KAWA_MENU_TIME, in µs, stands in for the clock: tests/menus.)
now() {
  local t=${KAWA_MENU_TIME:-$EPOCHREALTIME}
  printf '%s' "${t//[!0-9]/}"                       # (the decimal mark is the locale's)
}
caller() {   # the script that asked for this menu (bash's script argument), else the program
  local a=()
  mapfile -d '' -t a 2>/dev/null </proc/$PPID/cmdline
  case ${a[0]:-} in */bash|bash|*/sh|sh) printf '%s' "${a[1]:-?}" ;; *) printf '%s' "${a[0]:-?}" ;; esac
}
rec=""
if [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]] \
   && { exec 9>>"$XDG_RUNTIME_DIR/kawa-menu-${WAYLAND_DISPLAY:-}.state"; } 2>/dev/null && flock -w 2 9 2>/dev/null; then
  rec=$XDG_RUNTIME_DIR/kawa-menu-${WAYLAND_DISPLAY:-}.state
fi
if [[ -n $rec ]]; then
  me=$(caller) t=$(now) pid="" at=0 how="" who="" c=""
  read -r pid at how who <"$rec"
  [[ $at =~ ^[0-9]+$ ]] || at=0
  [[ $how == open && $pid =~ ^[1-9][0-9]*$ ]] && read -r c 2>/dev/null </proc/"$pid"/comm
  if [[ $who == "$me" && ( $c == fuzzel || $how == toggled ) ]] && ((t - at < 500000)); then
    # its key held down: dwl repeats it every 29 ms after 300 ms — still the same press
    printf '%s %s %s %s\n' "$pid" "$t" "$how" "$who" >"$rec"; exit 1
  fi
  if [[ $c == fuzzel ]]; then
    kill "$pid" 2>/dev/null                         # (the menu that asked for it gets "dismissed")
    if [[ $who == "$me" ]]; then printf '%s %s toggled %s\n' "$pid" "$t" "$me" >"$rec"; exit 1; fi
    for _ in {1..40}; do [[ -e /proc/$pid ]] || break; sleep 0.025; done   # (fuzzel's lock goes with it)
  elif [[ $who == "$me" && $how == lost ]] && ((t - at < 600000)); then
    exit 1   # the click outside that just closed it was on its own bar button: that click's toggle
  fi
  # a plain fuzzel (the launcher, a passphrase) holds fuzzel's own lock: left alone, and this
  # is no "click outside" (the launcher closed by Esc, then this key at once, still opens)
  # (75: the lock is held; a lock file that cannot be opened is fuzzel's to warn about)
  if [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    flock -n -E 75 "$XDG_RUNTIME_DIR/fuzzel-$WAYLAND_DISPLAY.lock" true 2>/dev/null
    (($? == 75)) && exit 1
  fi
  # fuzzel on the side, so its pid is known: it can then be closed by the next menu
  exec 3<&0
  exec 4< <(exec fuzzel "${args[@]}" <&3 3<&- 9>&-)
  fz=$!
  # (recorded once it is fuzzel, not the shell about to become it)
  for _ in {1..2000}; do read -r c 2>/dev/null </proc/$fz/comm || break; [[ $c == fuzzel ]] && break; done
  printf '%s %s open %s\n' "$fz" "$(now)" "$me" >"$rec"
  flock -u 9
  IFS= read -r -d '' out <&4; out=${out%$'\n'}
  wait "$fz"; rc=$?
  if flock -w 2 9; then
    read -r pid at how who <"$rec"
    # (unless another menu or its own key closed it, and wrote so)
    if [[ $pid == "$fz" && $how == open ]]; then
      how=chosen; ((rc == 1)) && how=lost            # fuzzel exits 1 when the keyboard focus goes
      printf '%s %s %s %s\n' "$fz" "$(now)" "$how" "$me" >"$rec"
    fi
    flock -u 9
  fi
  ((rc == 0)) || exit 1
else
  out=$(fuzzel "${args[@]}") || exit 1
fi
# Enter on a filter that matches nothing hands back the typed text (or -1): with --index,
# callers use the answer as an array index, so anything but a line number counts as dismissed
((idx)) && [[ ! $out =~ ^[0-9]+$ ]] && exit 1
printf '%s\n' "$out"
