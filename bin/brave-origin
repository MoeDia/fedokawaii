#!/usr/bin/env bash
# ~/.local/bin/brave-origin — Brave Origin, started so that sharing a whole screen or a
# window can carry the computer's sound too ("Also share system audio" in Brave's picker).
# That is Chromium's PulseAudio loopback for screen sharing: off by default, and no longer a
# brave://flags switch (Brave clears it from its settings), so it goes on the command line.
# Super+B, links (Theme points the desktop's brave-origin.desktop here) and `brave-origin`
# in a shell all start Brave this way; everything else reaches Brave unchanged — a feature
# list of your own is joined to this one, not replaced by it.
# The password store is pinned to Brave's basic one — the one it uses here today, with no
# keyring running — so that a keyring a package brings later, or a Brave that chooses
# differently, can never leave every login and cookie saved before it unreadable. (A
# --password-store of your own comes after it: Chromium keeps a switch's last value.)
set -u
feat=PulseaudioLoopbackForScreenShare args=() rest=""
for a in "$@"; do                           # (after --, Chromium reads no switches: nor here)
  if [[ -z $rest && $a == --enable-features=* ]]; then feat+=",${a#--enable-features=}"
  else [[ $a == -- ]] && rest=1; args+=("$a"); fi
done
# (the package's launcher, which its own brave-origin.desktop runs: Chromium's installer names
# it PACKAGE-channel, PACKAGE being brave-core's brave-origin, under /opt/brave.com/brave-origin;
# its profile is ~/.config/BraveSoftware/Brave-Origin)
b=/usr/bin/brave-origin-stable
[[ -x $b ]] || { echo "brave-origin: Brave Origin is not installed (sudo dnf install brave-origin)" >&2; exit 127; }
exec "$b" "--enable-features=$feat" --password-store=basic "${args[@]}"
