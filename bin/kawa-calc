#!/usr/bin/env bash
# kawa-calc — the calculator ("Calculator" in the launcher): type a sum, a percentage or a
# conversion and the answer shows as you type; Enter copies it. qalc (Qalculate) works every
# answer out, so everything it knows works: "15% of 2400", "120 usd to aed", "5 ft to cm",
# "2^64", "sqrt(2)", "3.5 h to min", "255 to hex". Currency rates are qalc's own, fetched again
# when a week old.
#
#   kawa-calc            the panel of the session's: a floating panel as the launcher (kawa-panel's
#                        Calc, one qalc for the panel): open, or closed when it is open
#   kawa-calc --answer EXPR   qalc's answer to EXPR on stdout (exit 1: no answer)
#
# "X% of Y" is qalc's "X% * Y" (qalc reads "% of" as a remainder: "rem(15, 1 B)").
#
# Keys: Enter copies the answer (and keeps the sum below) · ↑ the sum before again · ↓ the
# session's sums, Enter copies one · Ctrl+U clears · Ctrl+Q qalc's own prompt in a window of its
# own (its every command: help, set, store, rpn…) · Esc closes.
# Exit status: 0 · 1 no qalc, or no panel · 2 misuse.
set -u
export LC_ALL=C.UTF-8
case ${1:-} in
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  "") exec kawa-menu --calc ;;
  --answer) ;;
  *) echo "usage: kawa-calc [--answer EXPR]" >&2; exit 2 ;;
esac
command -v qalc >/dev/null || { echo "kawa-calc: qalc is missing — fedokawaii repair puts it back" >&2; exit 1; }
QALC=(qalc -s 'upxrates 7')                         # (currency rates refreshed once a week)
SENT=7777777.25                                     # (the line after each sum: its answer ends one)

# ── qalc, asked line by line ─────────────────────────────────────────────────────────────
start() { coproc { "${QALC[@]}" -t -s 'color 0' -s 'unicode 0' -s 'exp off' 2>&1; }; }   # (every figure: 2^64 as it is, not 1.844674407E19)
start
# answer EXPR → qalc's answer on stdout (nothing: no answer — not a sum, or qalc says no)
answer() {
  local e=$1 l out="" w
  [[ $e == *[0-9]* ]] || return 0                   # (a word alone is no sum: "steam" is not one)
  w=${e%% *}; w=${w,,}
  # (qalc's own commands are its prompt's, Ctrl+Q: never sent from here — "exit" would end it)
  [[ $w == @(quit|exit|set|save|store|assume|base|mode|help|list|find|info|delete|keep|unkeep|function|variable|rpn|stack|clear|history|exrates|swap|rotate|copy|move|pop|to|convert|factor|expand|partial|simplify|approximate|exact) ]] && return 0
  # (qalc's percentage: "15% of 2400" is "15% * 2400")
  while [[ $e =~ ^(.*[0-9.])[[:space:]]*%[[:space:]]*[Oo][Ff][[:space:]]+(.*)$ ]]; do
    e="${BASH_REMATCH[1]}% * ${BASH_REMATCH[2]}"
  done
  # (a conversion: "100 eur in usd" is "… to usd" — qalc reads a lone "in" as inches — and
  # into the unit asked alone: "5 km to miles" 3.106855961 mi, not "3 mi + 188 yd + …"
  # (qalc's "-" before the unit); its own forms — hex, roman, fraction… — as they are)
  local t
  if [[ $e =~ ^(.*[^[:space:]])[[:space:]]+([Tt][Oo]|[Ii][Nn])[[:space:]]+([[:alpha:]\$€£¥°][^[:space:]]*)$ ]]; then
    t=${BASH_REMATCH[3]}
    [[ ${t,,} == @(hex|hexadecimal|bin|binary|oct|octal|dec|decimal|duo|duodecimal|roman|base*|bases|fraction|frac|sci|scientific|eng|engineering|utc|time|sexa*|factors|partial*|cis|polar|rect*|exact|approximate|optimal|prefix|bijective|unicode|calendars|fp*|float|double|ieee*|si|cgs|imperial|us) ]] || t="-$t"
    e="${BASH_REMATCH[1]} to $t"
  fi
  kill -0 "${COPROC_PID:-0}" 2>/dev/null || start          # (ended: a new one)
  { printf '%s\n%s\n' "$e" "$SENT" >&"${COPROC[1]}"; } 2>/dev/null || return 0
  while IFS= read -r -t 3 -u "${COPROC[0]}" l; do
    [[ $l == "  $SENT" ]] && break
    [[ -z $out && $l == "  "?* ]] && out=${l#  }
  done
  [[ $out == @(error|warning)* || $out == "$e" ]] && return 0
  # (an amount of money: to the cent — "EUR 8.92", not "EUR 8.916629514"; under one, as qalc
  # has it: a fraction of a bitcoin)
  if [[ $out =~ ^([A-Z]{3}\ |[\$€£¥])(-?[0-9]+\.[0-9]+)$ ]] && [[ ${BASH_REMATCH[2]#-} != 0.* ]]; then
    printf -v out '%s%.2f' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
  fi
  printf '%s' "$out"
}

shift; a=$(answer "$*"); [[ -n $a ]] || exit 1; printf '%s\n' "$a"
