#!/usr/bin/env bash
# kawa-osd ICON LABEL PERCENT [off] — the level display of the volume, microphone and
# brightness keys: one small panel at the bottom centre (mako, category "osd") that
# updates in place while a key is held, also over fullscreen windows and while "do not
# disturb" is on.
#
#   ┌──────────────────────────────────────────┐   quick settings' meter row, to the pixel
#   │ 明 brightness  ■■■■■■■■□□□□   70%        │   (docs/design-system.md): the glyph in
#   └──────────────────────────────────────────┘   accent_text, the name in text, twelve
#                                                  squares of 14 × 10 on a 16 px pitch — lit
#   asagi, the rest edge2; muted, the lit ones hollow — and the number, right-aligned in
#   muted ("off" in faint while muted). A level lights the squares the panel's meter lights
#   for it: to the nearest twelfth, at least one above 0; above 100 % (only the mixer goes
#   there) all twelve, the real number.
# Exit status: 0 shown · 1 not shown (no notice daemon) · 2 misuse.
set -u
case ${1:-} in
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
esac
(($# >= 3)) || { echo "usage: kawa-osd ICON LABEL PERCENT [off] (kawa-osd --help)" >&2; exit 2; }
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/current/colors.sh"

icon=${1:-} label=${2:-} pct=${3:-0} off=${4:-}
[[ $pct =~ ^[0-9]{1,4}$ ]] || pct=0
pct=$((10#$pct)); ((pct > 999)) && pct=999     # (three digits wide)
lit=0                                          # as kawa-panel's lit_of: the nearest twelfth
((pct > 0)) && lit=$(( (pct * 24 + 100) / 200 ))
((pct > 0 && lit < 1)) && lit=1
((lit > 12)) && lit=12

# Across, as the panel's row (mako's padding puts the first pen at x 26, the row's x + 8):
# the glyph — a kanji or an icon, two columns of Sumi UI (16 px) —, a space (8 px), the
# name in 12 columns (96 px), the twelve squares (16 px each, the last 2 px of air
# included), a space, the number in 4 columns: 352 px, within mako's 360 px line (the
# panel 412 px wide, quick settings' own width)
printf -v name '%-12.12s' "$label"
square=$ICON_SEG; [[ -n $off ]] && square=$ICON_SEG_HOLLOW
on="" rest=""
for ((i = 0; i < 12; i++)); do if ((i < lit)); then on+=$square; else rest+=$ICON_SEG; fi; done
if [[ -n $off ]]; then value="<span color='#$C_FAINT'> off</span>"
else printf -v value "<span color='#%s'>%3d%%</span>" "$C_MUTED" "$pct"; fi
# one row of 24 px (line_height in Pango units: px × 1024), its words on the 16 px line in
# the middle
body="<span line_height='24576'><span color='#$C_ACCENT_TEXT'>$icon</span> <span color='#$C_TEXT'>$name</span>"
body+="<span font='Sumi Icons 16px'><span color='#$C_TEAL'>$on</span><span color='#$C_EDGE2'>$rest</span></span> $value</span>"

# its own app name, so mako never groups it with other notices; and one panel, whatever comes:
# mako's synchronous tag (x-canonical-private-synchronous) makes each one take the place of
# the panel already on screen with the same tag and app — the volume's, the microphone's and
# the brightness's alike, a held key's overlapping runs too — in place, with no id to keep
exec notify-send -a osd -c osd -u low -h int:transient:1 -h string:x-canonical-private-synchronous:osd \
  "$icon  $label" "$body" 2>/dev/null
