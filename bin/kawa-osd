#!/usr/bin/env bash
# kawa-osd ICON LABEL PERCENT [off] — the level display of the volume, microphone and
# brightness keys: one small panel at the bottom centre (mako, category "osd") that
# updates in place while a key is held, also over fullscreen windows and while "do not
# disturb" is on.
#
#   ☼ brightness
#   ▁▁▁▁▂▂▂▂▃▃▃▃▄▄▄▄▅▅▅▅  70%      a wedge of 20 pixel columns, 5 % each, rising like the
#                                  volume scale of an old hi-fi; lit in asagi with the top
#                                  one vermilion (the peak lamp of the music meter), the
#                                  rest faint; "off" when muted. Wedge and number are drawn
#                                  at twice the pixel size (24 px), so every pixel stays a
#                                  crisp 2×2 square.
# Exit status: 0 shown (or left to the update already under way) · 1 not shown (no notice
# daemon, no runtime folder) · 2 misuse.
set -u
case ${1:-} in
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
esac
(($# >= 3)) || { echo "usage: kawa-osd ICON LABEL PERCENT [off] (kawa-osd --help)" >&2; exit 2; }
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/current/colors.sh"
ID_FILE="${XDG_RUNTIME_DIR:?}/kawa-osd-id"

icon=${1:-} label=${2:-} pct=${3:-0} off=${4:-}
[[ $pct =~ ^[0-9]{1,4}$ ]] || pct=0
pct=$((10#$pct)); ((pct > 999)) && pct=999     # (three digits wide)
lit=$(( (pct + 4) / 5 ))                       # 1–5 % → 1 column … 96–100 % → 20
((lit > 20)) && lit=20                         # above 100 % (the mixer allows it): a full wedge, the real number
[[ -n $off ]] && lit=0

STEP=("$ICON_EQ_1" "$ICON_EQ_2" "$ICON_EQ_3" "$ICON_EQ_4" "$ICON_EQ_5")   # 4 columns each
on="" peak="" rest=""
for ((i = 0; i < 20; i++)); do
  g=${STEP[i / 4]}
  if ((i < lit - 1)); then on+=$g; elif ((i == lit - 1)); then peak=$g; else rest+=$g; fi
done
# the value is always 42 px wide (" 70%": three 12 px digits and a 6 px sign; a 6 px space
# and "off"), so the panel never changes width, its two sides stay equal and the value
# ends at the same edge either way
F="Fusion Pixel 12px Mono ja"
if [[ -n $off ]]; then value="<span font='$F 12px'> </span><span color='#$C_ACCENT_TEXT'>off</span>"
else printf -v value "<span color='#%s'>%3d</span><span font='%s 12px' color='#%s'>%%</span>" "$C_STRONG" "$pct" "$F" "$C_MUTED"; fi
# wedge 160 px · gap 18 px (a 6 px and a 12 px space) · value 42 px = 220 px: an even
# width, so the panel (mako: 220 + 16 + 14 + 2 × 2 = 254) sits exactly in the screen's centre
body="<span font='Sumi Icons 24px'><span color='#$C_TEAL'>$on</span><span color='#$C_ACCENT'>$peak</span><span color='#$C_FAINT'>$rest</span></span><span font='$F 12px'> </span><span font='$F 24px'> $value</span>"

# its own app name, so mako never groups it with other notices; and one update at a time
# (a held key overlaps runs), so each replaces the panel instead of opening another
args=(-a osd -c osd -u low -h int:transient:1 -p)
exec 8>"$ID_FILE.lock"; flock -w 1 8 || exit 0
# (a notice id is mako's uint32 counter; anything else in the file — cut short, or a number
# notify-send refuses as out of range — would keep every panel from showing: start afresh)
id=$(cat "$ID_FILE" 2>/dev/null) && [[ $id =~ ^[1-9][0-9]{0,8}$ ]] && args+=(-r "$id")
id=$(notify-send "${args[@]}" "$icon  $label" "$body" 2>/dev/null) && [[ $id =~ ^[0-9]+$ ]] \
  && printf '%s\n' "$id" >"$ID_FILE"
