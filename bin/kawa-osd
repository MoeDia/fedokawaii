#!/usr/bin/env bash
# kawa-osd ICON LABEL PERCENT [off] — the level display of the volume, microphone and
# brightness keys: one small panel at the bottom centre (mako, category "osd") that
# updates in place while a key is held, also over fullscreen windows and while "do not
# disturb" is on.
#
#   ☼ brightness
#   ▁▁▁▁▂▂▂▂▃▃▃▃▄▄▄▄▅▅▅▅  70%      a wedge of 20 pixel columns, 5 % each, rising like the
#                                  volume scale of an old hi-fi; lit in asagi with the top
#                                  one vermilion (the peak lamp of the music meter), the
#                                  rest faint; "off" when muted. Wedge and number are drawn
#                                  at twice the pixel size (22 px), so every pixel stays a
#                                  crisp 2×2 square.
set -u
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
C_TEAL=7fb8b0 C_ACCENT=d0583a C_ACCENT_TEXT=d15b3d C_FAINT=5f584c C_STRONG=ece3cc C_MUTED=877f6f   # (dark, if no theme yet)
# shellcheck source=/dev/null
[[ -r $HOME/.config/fedokawaii/current/colors.sh ]] && . "$HOME/.config/fedokawaii/current/colors.sh"
ID_FILE="${XDG_RUNTIME_DIR:?}/kawa-osd-id"

icon=${1:-} label=${2:-} pct=${3:-0} off=${4:-}
[[ $pct =~ ^[0-9]+$ ]] || pct=0
pct=$((10#$pct)); ((pct > 100)) && pct=100
lit=$(( (pct + 4) / 5 ))                       # 1–5 % → 1 column … 96–100 % → 20
[[ -n $off ]] && lit=0

STEP=("$ICON_EQ_1" "$ICON_EQ_2" "$ICON_EQ_3" "$ICON_EQ_4" "$ICON_EQ_5")   # 4 columns each
on="" peak="" rest=""
for ((i = 0; i < 20; i++)); do
  g=${STEP[i / 4]}
  if ((i < lit - 1)); then on+=$g; elif ((i == lit - 1)); then peak=$g; else rest+=$g; fi
done
# the value is always 49 px wide (" 70%": three 14 px digits and a 7 px sign; a 7 px space
# and "off"), so the panel never changes width, its two sides stay equal and the value
# ends at the same edge either way
if [[ -n $off ]]; then value="<span font='DepartureMono Nerd Font 11px'> </span><span color='#$C_ACCENT_TEXT'>off</span>"
else printf -v value "<span color='#%s'>%3d</span><span font='DepartureMono Nerd Font 11px' color='#%s'>%%</span>" "$C_STRONG" "$pct" "$C_MUTED"; fi
# wedge 160 px · gap 21 px (a 7 px and a 14 px space) · value 49 px = 230 px: an even
# width, so the panel (mako: 230 + 16 + 14 + 2 × 2 = 264) sits exactly in the screen's centre
body="<span font='Sumi Icons 22px'><span color='#$C_TEAL'>$on</span><span color='#$C_ACCENT'>$peak</span><span color='#$C_FAINT'>$rest</span></span><span font='DepartureMono Nerd Font 11px'> </span><span font='DepartureMono Nerd Font 22px'> $value</span>"

# its own app name, so mako never groups it with other notices; and one update at a time
# (a held key overlaps runs), so each replaces the panel instead of opening another
args=(-a osd -c osd -u low -h int:transient:1 -p)
exec 8>"$ID_FILE.lock"; flock -w 1 8 || exit 0
id=$(cat "$ID_FILE" 2>/dev/null) && [[ $id =~ ^[0-9]+$ ]] && args+=(-r "$id")
id=$(notify-send "${args[@]}" "$icon  $label" "$body" 2>/dev/null) && [[ $id =~ ^[0-9]+$ ]] \
  && printf '%s\n' "$id" >"$ID_FILE"
