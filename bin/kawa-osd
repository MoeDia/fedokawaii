#!/usr/bin/env bash
# kawa-osd ICON LABEL PERCENT [off] — the level display of the volume, microphone and
# brightness keys (docs/design-system.md §9): the running panel shows it — kawa-panel, asked
# through its fifo ("level ICON PCT [off]"), no process started there — in a window of its own,
# low in the middle of the screen: ICON, the meter's twenty segments (quick settings' own, to
# the pixel: reddening near the top, hollow while off), the value; drawn anew as each key
# comes, gone 1.2 s after the last. Over a fullscreen window and while "do not disturb" is on
# too: it is not a notice. LABEL says what the level is of (the icon shows it: not drawn).
# Exit status: 0 asked · 1 not shown (no panel running) · 2 misuse.
set -u
case ${1:-} in
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
esac
usage() { echo "usage: kawa-osd ICON LABEL PERCENT [off] (kawa-osd --help)" >&2; exit 2; }
(($# >= 3 && $# <= 4)) || usage
icon=$1 pct=$3 off=${4:-}
[[ -n $icon && $icon != *[[:space:]]* ]] || usage
[[ -z $off || $off == off ]] || usage
[[ $pct =~ ^[0-9]{1,4}$ ]] || pct=0
pct=$((10#$pct)); ((pct > 999)) && pct=999     # (the mixer goes past 100: the real number, three digits at most)
fifo=${XDG_RUNTIME_DIR:-/run/user/$UID}/kawa-panel.in
[[ -p $fifo ]] || exit 1
# one line, one write (under PIPE_BUF: whole, never mixed with another key's), and never a wait:
# opened for writing without blocking — no panel reading it (a stale fifo): refused at once;
# a hung panel's pipe full: the line dropped, not this process stuck holding the key's lock —
# and never made a plain file should the fifo go meanwhile (nocreat)
printf 'level %s %d%s\n' "$icon" "$pct" "${off:+ off}" \
  | dd of="$fifo" iflag=fullblock oflag=nonblock conv=nocreat status=none 2>/dev/null || exit 1
exit 0
