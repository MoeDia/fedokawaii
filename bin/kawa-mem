#!/usr/bin/env bash
# kawa-mem — memory in use, for the bar: the chip icon and how much is taken ("5.2G"), the
# way btop and Windows count it — what the programs hold, not the cache Linux keeps of files
# (MemTotal − MemAvailable). Quiet while there is room; vermilion past 85 %. Pure bash on
# /proc/meminfo, no forks (the wait is a read with a timeout on a pipe that never speaks).
# Prints one waybar JSON line at once, then one whenever the figure changes (looked at every
# 3 s) or btop, which a click on it opens, opens or closes (lit, class "active": kawa-bar; the
# wait is on a fifo of its own, $XDG_RUNTIME_DIR/kawa-bar.wake.PID, which kawa-term --float's
# kawa-dwlstatus --wake writes to), until the bar is gone (exit 0: waybar starts it again).
# Exit status: 0 the bar went away · 2 misuse.
set -u
case ${1:-} in
  "") ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-mem (kawa-mem --help)" >&2; exit 2 ;;
esac
# (the tests point these at a stand-in /proc/meminfo and a shorter wait)
INFO=${KAWA_PROC_MEMINFO:-/proc/meminfo} EVERY=${KAWA_MEM_EVERY:-3}
[[ $EVERY =~ ^[0-9]+(\.[0-9]+)?$ ]] || EVERY=3
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
# shellcheck source=kawa-bar
. "${BASH_SOURCE[0]%/*}/kawa-bar"                   # bar_lit (bash alone)
wake=${XDG_RUNTIME_DIR:?}/kawa-bar.wake.$$
mkfifo -m 600 -- "$wake" && exec {quiet}<>"$wake" || exit 1
trap 'rm -f -- "$wake"' EXIT
trap 'exit 0' TERM HUP INT PIPE
last=""
while :; do
  total=0 avail=-1
  while read -r k v _; do
    case $k in MemTotal:) total=$v ;; MemAvailable:) avail=$v ;; esac
  done <"$INFO"
  if ((total > 0 && avail >= 0)); then
    used=$((total - avail))
    t10=$(( (used * 10 + 524288) / 1048576 ))           # tenths of a GiB, rounded
    all10=$(( (total * 10 + 524288) / 1048576 ))
    pct=$((used * 100 / total))
    cls='"calm"'; ((pct > 85)) && cls='"high"'
    printf -v tip 'RAM %d%% of %d GB' "$pct" $(( (all10 + 5) / 10 ))
    # (lit: btop open — no tooltip, which would show behind it)
    bar_lit memory && cls="[$cls,\"active\"]" tip=""
    printf -v out '{"text":"%s%d.%dG","class":%s,"tooltip":"%s"}' "$ICON_BAR_MEMORY" $((t10 / 10)) $((t10 % 10)) "$cls" "$tip"
    [[ $out != "$last" ]] && { printf '%s\n' "$out" || exit 0; last=$out; }
  fi
  read -r -t "$EVERY" -u "$quiet" _
  while read -r -t 0 -u "$quiet" && read -r -u "$quiet" _; do :; done   # (wakes heaped up: one look)
done
