#!/usr/bin/env bash
# kawa-power — Super+Shift+E (or "power" in quick settings): lock, sleep, log out,
# restart, shut down. A small centred menu: 電 power and the uptime over a row a choice, each
# with its own pixel icon. Esc cancels (--help: this text).
#   kawa-power         the menu
#   kawa-power sleep   locked, then asleep, with no menu (a keyboard's Sleep key)
# A choice the system refuses (another user logged in, something inhibiting it, no password
# agent for polkit) says why in a notice, and exits 1. A sleep, and what became of it, goes
# to the journal too (journalctl -t kawa-power; the lock's own lines: -t kawa-lock). Log out
# closes Steam properly first (kawa-steam --quit); restart and shut down leave that to
# kawa-steam --guard, which logind tells before the computer stops, whoever asked.
set -u
# (the icons first: a sleep that is refused says so with the power icon too)
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
say() { logger -t kawa-power -- "$*" 2>/dev/null; }
# act WHAT SYSTEMCTL-VERB — logind's answer, when it says no, as a notice (its first line)
act() {
  local err
  err=$(systemctl "$2" 2>&1 >/dev/null) && return 0
  err=${err%%$'\n'*}
  notify-send -a desktop -u critical -- "$ICON_POWER  power" "could not $1${err:+ — $err}"
  say "could not $1${err:+ — $err}"
  return 1
}
# sleep_now — locked first (kawa-lock returns once every screen is locked), then asleep;
# never asleep unlocked. The hand-off is meant to be seen: the lock screen up and drawn, a
# short beat on it, then the screens to black (wlopm), then the sleep — never a lock that
# flashes and vanishes. (swayidle's after-resume turns them on again as the machine wakes;
# a sleep the system refuses turns them on at once.) KAWA_SLEEP_BEAT: the beat, in seconds
sleep_now() {
  say "sleep requested"
  kawa-lock || { say "not locked — no sleep"; exit 1; }
  sleep "${KAWA_SLEEP_BEAT:-0.8}"
  wlopm --off '*'
  act sleep suspend || { wlopm --on '*'; exit 1; }
  say "suspend asked of the system"
}
case ${1:-} in
  "") ;;
  sleep) sleep_now; exit ;;                       # (a keyboard's Sleep key)
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-power [sleep]" >&2; exit 2 ;;
esac
# the menu (kawa-menu, the panel's line format: docs/design-system.md): 電 power, how long the
# machine has been up at the heading's end — "up 03h 07m", "up 04d 03h", "up 15w 02d" — then a
# row a choice, its icon and its name; the cursor's first key lands on lock
read -r up _ </proc/uptime; up=${up%.*}
h=$((up / 3600)) d=$((up / 86400))
if ((h < 24)); then printf -v t 'up %02dh %02dm' "$h" $((up / 60 % 60))
elif ((d < 100)); then printf -v t 'up %02dd %02dh' "$d" $((h % 24))
else w=$((d / 7)) r=$((d % 7)); ((w > 99)) && w=99 r=6        # (as far as it can count)
     printf -v t 'up %02dw %02dd' "$w" "$r"; fi
rows=()
line() { local IFS=$'\t'; rows+=("$*"); }
line part 電 power "$t"
line row "$ICON_LOCK" lock
line row "$ICON_ZZZ" sleep
line row "$ICON_DOOR" "log out"
line row "$ICON_RESTART" restart
line row "$ICON_POWER" "shut down"

i=$(printf '%s\n' "${rows[@]}" | kawa-menu --index --select 1) || exit 0
case $i in
  1) exec kawa-lock --sleep ;;                     # (still locked 90 s later: sleep)
  2) sleep_now ;;
  3) kawa-steam --quit logout                     # (Steam closed properly first: its saves to Steam
     exec pkill -xu "$UID" dwl ;;                 #  Cloud — it ends with the desktop otherwise)
  4) act restart reboot ;;
  5) act "shut down" poweroff ;;
esac
