#!/usr/bin/env bash
# kawa-power — Super+Shift+E (or "power" in quick settings): lock, sleep, log out,
# restart, shut down. A small centred menu: the title and the column of choices sit in
# the middle of the box, each choice with its own pixel icon. Esc cancels. No arguments
# (--help: this text). A choice the system refuses (another user logged in, something
# inhibiting it, no password agent for polkit) says why in a notice, and exits 1.
set -u
case ${1:-} in
  "") ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-power   (no arguments: the power menu)" >&2; exit 2 ;;
esac
LC_ALL=C.UTF-8                 # widths count characters, not bytes
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"

WIDTH=25                       # the menu's width in characters: odd, like the 13-column block
LABEL=9                        # the label column (longest: "shut down")
names=(lock sleep "log out" restart "shut down")
icons=("$ICON_LOCK" "$ICON_ZZZ" "$ICON_DOOR" "$ICON_RESTART" "$ICON_POWER")

# an icon is two character cells wide, then two spaces, then the label column
pad=$(( (WIDTH - 2 - 2 - LABEL) / 2 ))
rows=()
for i in "${!names[@]}"; do
  printf -v r '%*s%s  %-*s' "$pad" '' "${icons[i]}" "$LABEL" "${names[i]}"
  rows+=("$r")
done
# the title: how long the machine has been up, as the hourglass and ten characters always —
# "up 03h 07m", "up 04d 03h", "up 15w 02d" — so it is 13 columns whatever the uptime: odd
# like WIDTH, so it centres to the pixel, right over the icons and names below. (A user
# name or an uptime of changing length would sit half a column off whenever its length was
# even.)
read -r up _ </proc/uptime; up=${up%.*}
h=$((up / 3600)) d=$((up / 86400))
if ((h < 24)); then printf -v t 'up %02dh %02dm' "$h" $((up / 60 % 60))
elif ((d < 100)); then printf -v t 'up %02dd %02dh' "$d" $((h % 24))
else w=$((d / 7)) r=$((d % 7)); ((w > 99)) && w=99 r=6        # (as far as it can count)
     printf -v t 'up %02dw %02dd' "$w" "$r"; fi
printf -v title '%*s%s %s' $(( (WIDTH - 2 - 1 - ${#t}) / 2 )) '' "$ICON_HOURGLASS" "$t"

i=$(printf '%s\n' "${rows[@]}" |
    kawa-menu --index --width "$WIDTH" --lines ${#rows[@]} --title "$title") || exit 0
# act WHAT SYSTEMCTL-VERB — logind's answer, when it says no, as a notice (its first line)
act() {
  local err
  err=$(systemctl "$2" 2>&1 >/dev/null) && return 0
  err=${err%%$'\n'*}
  notify-send -a desktop -u critical "Power" "could not $1${err:+ — $err}"
  exit 1
}
case $i in
  0) exec kawa-lock ;;
  1) kawa-lock && act sleep suspend ;;            # locked first (swaylock -f), then sleep
  2) exec pkill -xu "$UID" 'dwl(\.prev)?' ;;     # (dwl.prev: start-dwl's fallback)
  3) act restart reboot ;;
  4) act "shut down" poweroff ;;
esac
