#!/usr/bin/env bash
# kawa-power — Super+Shift+E (or "power" in quick settings): lock, sleep, log out, restart,
# shut down. A dialog of its own, the desktop dimmed behind it (docs/design-system.md §4): five seal
# tiles in a row, the word under each, the one under the cursor inked; restart and shut down ask for a
# second press, in the foot's place, never an accidental power-off. Its foot: how long the machine has
# been up. Esc cancels (--help: this text).
#   kawa-power         the menu
#   kawa-power sleep   locked, then asleep, with no menu (a keyboard's Sleep key)
# A choice the system refuses (another user logged in, something inhibiting it, no password
# agent for polkit) says why in a notice, and exits 1. A sleep, and what became of it, goes
# to the journal too (journalctl -t kawa-power; the lock's own lines: -t kawa-lock).
set -u
# (the icons first: a sleep that is refused says so with the power icon too)
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh"
say() { logger -t kawa-power -- "$*" 2>/dev/null; }
# act WHAT SYSTEMCTL-VERB — logind's answer, when it says no, as a notice (its first line)
act() {
  local err
  err=$(systemctl "$2" 2>&1 >/dev/null) && return 0
  err=${err%%$'\n'*}
  notify-send -a desktop -u critical -- "$ICON_POWER  power" "could not $1${err:+ — $err}"
  say "could not $1${err:+ — $err}"
  return 1
}
# sleep_now — asleep at once, never unlocked: the screens go black and the lock comes up on
# them (kawa-lock --now: it returns once every screen is locked), then the suspend — nothing
# of the lock shows before the sleep, and it is there when the screens come back. (swayidle's
# after-resume lights them as the machine wakes — kawa-lock --resumed; a sleep the system
# refuses lights them at once.)
sleep_now() {
  say "sleep requested"
  kawa-lock --now || { kawa-lock --screens on; say "not locked — no sleep"; exit 1; }
  act sleep suspend || { kawa-lock --screens on; exit 1; }
  say "suspend asked of the system"
}
case ${1:-} in
  "") ;;
  sleep) sleep_now; exit ;;                       # (a keyboard's Sleep key)
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-power [sleep]" >&2; exit 2 ;;
esac
# the dialog (kawa-menu, the panel's line format: docs/design-system.md): a seal a choice, how long the
# machine has been up in its foot — "up 03h 07m", "up 04d 03h", "up 15w 02d"; it opens on lock
read -r up _ </proc/uptime; up=${up%.*}
h=$((up / 3600)) d=$((up / 86400))
if ((h < 24)); then printf -v t 'up %02dh %02dm' "$h" $((up / 60 % 60))
elif ((d < 100)); then printf -v t 'up %02dd %02dh' "$d" $((h % 24))
else w=$((d / 7)) r=$((d % 7)); ((w > 99)) && w=99 r=6        # (as far as it can count)
     printf -v t 'up %02dw %02dd' "$w" "$r"; fi
rows=()
line() { local IFS=$'\t'; rows+=("$*"); }
line seal @t-lock lock
line seal @t-sleep sleep
line seal @t-logout "log out"
line seal @t-restart restart "press again to restart"
line seal @t-off "shut down" "press again to shut down"
line foot "$t"

i=$(printf '%s\n' "${rows[@]}" | kawa-menu --index --dim) || exit 0
case $i in
  0) exec kawa-lock --sleep ;;                     # (still locked 90 s later: sleep)
  1) sleep_now ;;
  2) exec pkill -xu "$UID" dwl ;;
  3) act restart reboot ;;
  4) act "shut down" poweroff ;;
esac
