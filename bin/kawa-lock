#!/usr/bin/env bash
# kawa-lock — locks the screen (Super+Escape, before sleep, the power menu) with gtklock: the
# theme's plain ground, and in the middle of each screen the day's seal (土 on a Saturday),
# the pixel padlock, the time, the date, and one box for the password — each character you
# type shows as a vermilion ◆; a wrong one empties the box and says so under it (ちがう ·
# wrong password). The login screen (kawa-greet) is its twin. The layout is
# ~/.config/fedokawaii/lock.ui, the colours current/gtklock.css (dark or light), the
# pictures ~/.local/share/fedokawaii/<theme>/ (tools/build-art.py).
#
# `kawa-lock --sleep` (Super+Escape, the power menu's "lock"): a lock you asked for — still
# locked 90 seconds later, the computer sleeps (unlock before then and it stays awake). That
# is the only way it sleeps by itself: nothing sleeps or locks on its own when you are just
# away (the screens only go dark after an hour: autostart.sh). (KAWA_LOCK_SLEEP=SECONDS in
# its environment sets another wait, 0 none: the tests use it.)
# `kawa-lock --now` (swayidle, right before sleep) is the same lock; both return only once
# the screens are locked.
#
# Exit: 0 locked (or it already was) · 1 it could not lock (gtklock missing, stopped, or it
# did not lock within 10 s — said in a notice) — so `kawa-lock && systemctl suspend` never sleeps
# unlocked.
set -u
case ${1:-} in -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;; esac
THEME=dark
# shellcheck source=/dev/null
[[ -r $HOME/.config/fedokawaii/current/colors.sh ]] && . "$HOME/.config/fedokawaii/current/colors.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh" 2>/dev/null
sleep_after=0
case ${1:-} in
  --now) shift ;;
  --sleep) sleep_after=90; [[ ${KAWA_LOCK_SLEEP:-} =~ ^[0-9]+$ ]] && sleep_after=$KAWA_LOCK_SLEEP; shift ;;
esac
run=${XDG_RUNTIME_DIR:-/run/user/$UID}
fail() {
  notify-send -a desktop -u critical "${ICON_LOCK:-}  could not lock the screen" "$1" 2>/dev/null
  echo "kawa-lock: $1" >&2; exit 1
}
# one at a time: a second press while the first is still starting (a double press, idle
# firing as you press) waits for it, then finds the screen locked
{ exec 9>"$run/kawa-lock.busy"; } 2>/dev/null && flock -w 10 9 2>/dev/null   # (exec … 2>/dev/null alone would silence the whole script)
pgrep -xu "$UID" gtklock >/dev/null && exit 0               # already locked (this user's)
command -v gtklock >/dev/null || fail "gtklock is not installed — fedokawaii repair puts it back"

# today's seal and the theme's padlock into a copy of the layout (pictures drawn once, at
# build time: nothing to draw now, so the lock is up at once)
art=$HOME/.local/share/fedokawaii/$THEME
printf -v day '%(%u)T' -1
ui=$run/kawa-lock.ui
# The layout missing is no reason not to lock: the screen still locks, in gtklock's own plain
# look, and a notice says what to repair (the one place a lesser way is taken — a sleep must
# never find the screen unlocked)
layout=(-x "$ui")
sed -e "s|{SEAL}|$art/seal-$day.png|" -e "s|{PADLOCK}|$art/padlock.png|" \
  "$HOME/.config/fedokawaii/lock.ui" >"$ui.tmp" 2>/dev/null && mv -f "$ui.tmp" "$ui" || {
  layout=()
  notify-send -a desktop -u critical "${ICON_LOCK:-}  lock screen" "its layout is missing (~/.config/fedokawaii/lock.ui), so it locks plain — fedokawaii repair puts it back" 2>/dev/null
}

locked=$run/kawa-lock.locked
rm -f "$locked"
# gtklock runs on (it is the lock); --lock-command marks the moment every screen is locked.
# The date in English whatever the language (C), the ◆ box and the seal say the rest; its two
# messages in the desktop's words (LANGUAGE=fk: the catalogue setup installs, art/gtklock.mo)
setsid -f env LC_TIME=C LANGUAGE=fk gtklock -s "$HOME/.config/fedokawaii/current/gtklock.css" "${layout[@]}" \
  --date-format '%d %b' --time-format '%I:%M %p' \
  --lock-command "touch $locked" </dev/null >/dev/null 2>&1 9>&-
# (gone after a second without locking — it could not start: said at once, not after 10 s)
for ((i = 0; i < 100; i++)); do
  [[ -e $locked ]] && break
  ((i >= 10)) && ! pgrep -xu "$UID" gtklock >/dev/null && fail "gtklock stopped before it locked"
  sleep 0.1
done
[[ -e $locked ]] || { pkill -xu "$UID" gtklock; fail "gtklock did not lock within 10 s"; }
exec 9>&-
((sleep_after > 0)) || exit 0
# the sleep after a lock you asked for: tied to this very lock — unlocked (gtklock gone)
# before the time is up, nothing happens; a second lock later has its own count
pid=$(pgrep -nxu "$UID" gtklock) || exit 0
setsid -f bash -c 'for ((i = 0; i < $1; i++)); do sleep 1; kill -0 "$2" 2>/dev/null || exit 0; done
  systemctl suspend' _ "$sleep_after" "$pid" </dev/null >/dev/null 2>&1
exit 0
