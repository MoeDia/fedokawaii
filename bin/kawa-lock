#!/usr/bin/env bash
# kawa-lock — locks the screen (Super+Escape, idle, before sleep, the power menu): the
# theme's plain ground with the pixel padlock in the very centre — paper on ink, or ink on
# paper. swaylock's tiny ring sits inside the padlock's keyhole (current/swaylock), so the
# keyhole lights up as you type. Above the padlock, the day of the week as a vermilion
# kanji seal; below it, the date — drawn into the picture at lock time (ImageMagick, a few
# tenths of a second; the picture grows by the same amount on every side, so the padlock
# and the ring stay exactly centred; the words sit 2 px right with the padlock art, which
# is drawn 2 px in to meet swaylock's ring). `kawa-lock --now` (before sleep) skips that and
# locks with the bare padlock at once; so does any failure.
set -u
# It must lock even when something around it is broken (it also runs right before
# suspend): every missing piece falls back to less decoration, never to no lock.
THEME=dark C_GROUND=0f0e0c
CONF="$HOME/.config/fedokawai/current/swaylock"
# shellcheck source=/dev/null
[[ -r $HOME/.config/fedokawai/current/colors.sh ]] && . "$HOME/.config/fedokawai/current/colors.sh"
PADLOCK="$HOME/.local/share/fedokawai/$THEME/lock.png"
pgrep -xu "$UID" swaylock >/dev/null && exit 0        # already locked (this user's)
now=0; [[ ${1:-} == --now ]] && { now=1; shift; }

if ((now == 0)) && [[ -s $PADLOCK && -n ${XDG_RUNTIME_DIR:-} ]] && command -v magick >/dev/null; then
  K=(月 火 水 木 金 土 日); printf -v u '%(%u)T' -1; kj=${K[u - 1]}
  dt=$(LC_ALL=C date '+%a %d %b')                       # (English: the pixel font's letters)
  fd=$(fc-match -f '%{file}' 'DepartureMono Nerd Font' 2>/dev/null)
  fj=$(fc-match -f '%{file}' 'PixelMplus12' 2>/dev/null)
  out=$XDG_RUNTIME_DIR/kawa-lock.png
  # pixel fonts at whole multiples of their grids (Departure 2 × 11 px, PixelMplus 2 × 12),
  # unsmoothed: every pixel a crisp square, like the padlock
  if [[ -s $fd && -s $fj ]] && LC_ALL=C.UTF-8 timeout 3 magick "$PADLOCK" -bordercolor "#$C_GROUND" -border 240x170 \
       +antialias -gravity center \
       \( -size 36x36 "xc:#${C_ACCENT:-d0583a}" -font "$fj" -pointsize 24 -fill "#ece3cc" \
          -annotate +1+1 "$kj" \) -geometry +2-126 -composite \
       -font "$fd" -pointsize 22 -fill "#${C_MUTED:-877f6f}" -annotate +2+86 "${dt^^}" \
       "PNG32:$out.tmp" 2>/dev/null; then
    mv -f "$out.tmp" "$out" && PADLOCK=$out
  fi
fi

args=()
[[ -s $PADLOCK ]] && args+=(-i "$PADLOCK")
if [[ -r $CONF ]]; then args=(-C "$CONF" "${args[@]}"); else args+=(-c "$C_GROUND"); fi
exec swaylock -f "${args[@]}" "$@"
