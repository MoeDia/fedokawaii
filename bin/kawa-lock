#!/usr/bin/env bash
# kawa-lock — locks the screen (Super+Escape, before sleep, the power menu) with gtklock: your
# wallpaper shaded into the theme's ground (kawa-wallpaper draws it as it shows a picture;
# none yet: the plain ground), and in the middle of each screen, no box, the pixel padlock and
# the time, the day's seal (土 on a Saturday) and the date, and one line for the password —
# each character you type shows as a vermilion ◆; a wrong one empties it and says so above it
# (ちがう · wrong password). The login screen (kawa-greet) is its twin. The layout is
# ~/.config/fedokawaii/lock.ui, the colours current/gtklock.css (dark or light), the
# pictures ~/.local/share/fedokawaii/<theme>/ (tools/build-art.py).
#
# `kawa-lock --sleep` (Super+Escape, the power menu's "lock"): a lock you asked for — still
# locked 90 seconds later, the computer sleeps (unlock before then and it stays awake). That
# is the only way it sleeps by itself: away, nothing sleeps — the screensaver and the lock
# behind it after 15 minutes, the screens dark after 30 (kawa-idle; never while something plays).
# (KAWA_LOCK_SLEEP=SECONDS in its environment sets another wait, 0 none: the tests use it.)
# `kawa-lock --now` (the power menu's sleep, the Sleep key, and swayidle right before every
# sleep): the screens go dark first, then the same lock comes up on them — so a sleep shows no
# lock for a moment: the screens just go black, and the lock is there when they come back.
# Both return only once the screens are locked.
#
# The screens, dark or lit (`--screens off|on`: wlopm, and a note of it in
# $XDG_RUNTIME_DIR/kawa-screens — "off", or "on" from the moment they came back). The lock
# screen reads that note (its module, kawa-lockmod: src/kawa-lockmod): while the screens are
# dark, and for 2 s after they come back, every key and click on it only wakes — the Enter
# that woke the computer is never taken for a password. An empty Enter is never one either.
# `--resumed` (swayidle, as the machine wakes) lights the screens and notes the wake.
# Under the line, three keys — sleep, restart, power off — as on the login screen.
#
# The lock holds until your password, whatever happens meanwhile: gtklock runs under a
# keeper (kawa-lock --keep, started here). Should gtklock stop without the password — a
# crash, a screen that went away as the machine slept — the desktop stays locked (dwl keeps
# its plain locked screen) and the keeper starts gtklock again at once. What happens goes to
# the journal (journalctl -t kawa-lock): "lock up", "unlocked", "locker exited rc=N",
# "screens off", "resumed — locked" (swayidle runs kawa-lock --resumed as the machine wakes).
#
# Exit: 0 locked (or it already was) · 1 it could not lock (gtklock missing, stopped, or it
# did not lock within 10 s — said in a notice) — so `kawa-lock && systemctl suspend` never sleeps
# unlocked.
set -u
case ${1:-} in -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;; esac
run=${XDG_RUNTIME_DIR:-/run/user/$UID}
locked=$run/kawa-lock.locked     # there while the desktop is locked (gtklock's --lock-command)
held=$run/kawa-lock.held         # the keeper's: held (flock) while it runs, its process id inside
say() { logger -t kawa-lock -- "$*" 2>/dev/null; }
keeping() { ! flock -n "$held" true 2>/dev/null; }   # the keeper runs: the desktop is locked

# keep GTKLOCK-COMMAND… — the keeper: runs gtklock until it ends with the password (status 0).
# gtklock gone any other way after it had locked, dwl keeps the desktop locked with no lock
# screen on it: gtklock is started again at once (after a second, should it stop again within
# a second), for as long as the desktop runs. One that stops before it ever locked ends the
# keeper: kawa-lock says why.
keep() {
  exec 8>>"$held"
  flock -n 8 || exit 0                               # (one keeper at a time)
  echo "$$" >"$held"
  local rc ever=0 t0 t1
  while :; do
    read -r t0 _ </proc/uptime
    "$@" </dev/null >/dev/null 2>&1 8>&-; rc=$?
    read -r t1 _ </proc/uptime
    [[ -e $locked ]] && ever=1
    if ((rc == 0)); then rm -f "$locked"; say "unlocked"; exit 0; fi
    if ((!ever)); then say "locker exited rc=$rc before it locked"; exit 1; fi
    if ! pgrep -xu "$UID" dwl >/dev/null; then rm -f "$locked"; say "locker exited rc=$rc — the desktop has ended"; exit 0; fi
    say "locker exited rc=$rc — the desktop stays locked: started again"
    ((${t1%.*} - ${t0%.*} >= 1)) || sleep 1
  done
}
# screens off|on — every output dark (wlopm), or lit again; the note the lock screen reads
# (written before they go dark, after they are lit: its wake guard never misses an edge)
screens() {
  if [[ $1 == off ]]; then
    echo off >"$run/kawa-screens"; say "screens off"; wlopm --off '*'
  else
    wlopm --on '*'; echo on >"$run/kawa-screens"; say "screens on"
  fi
}
case ${1:-} in
  --up) : >"$locked"; say "lock up"; exit 0 ;;        # gtklock's --lock-command: every screen locked
  --screens) [[ ${2:-} == @(on|off) ]] || { echo "usage: kawa-lock --screens on|off" >&2; exit 2; }
             screens "$2"; exit 0 ;;
  --resumed) screens on
             if keeping; then say "resumed — locked"; else say "resumed — not locked"; fi; exit 0 ;;
  --keep) shift; keep "$@" ;;
esac

THEME=dark
# shellcheck source=/dev/null
[[ -r $HOME/.config/fedokawaii/current/colors.sh ]] && . "$HOME/.config/fedokawaii/current/colors.sh"
# shellcheck source=/dev/null
. "$HOME/.config/fedokawaii/icons.sh" 2>/dev/null
sleep_after=0
case ${1:-} in
  --now) shift; screens off ;;                       # (dark first: no lock shows before a sleep)
  --sleep) sleep_after=90; [[ ${KAWA_LOCK_SLEEP:-} =~ ^[0-9]+$ ]] && sleep_after=$KAWA_LOCK_SLEEP; shift ;;
esac
fail() {
  notify-send -a desktop -u critical -- "${ICON_LOCK:-}  could not lock the screen" "$1" 2>/dev/null
  say "could not lock: $1"
  echo "kawa-lock: $1" >&2; exit 1
}
# one at a time: a second press while the first is still starting (a double press, idle
# firing as you press) waits for it, then finds the screen locked
{ exec 9>"$run/kawa-lock.busy"; } 2>/dev/null && flock -w 10 9 2>/dev/null   # (exec … 2>/dev/null alone would silence the whole script)
keeping && exit 0                                     # already locked
command -v gtklock >/dev/null || fail "gtklock is not installed — fedokawaii repair puts it back"

# today's seal and the theme's padlock into a copy of the layout (pictures drawn once, at
# build time: nothing to draw now, so the lock is up at once)
art=$HOME/.local/share/fedokawaii/$THEME
printf -v day '%(%u)T' -1
ui=$run/kawa-lock.ui
# The layout missing is no reason not to lock: the screen still locks, in gtklock's own plain
# look, and a notice says what to repair (the one place a lesser way is taken — a sleep must
# never find the screen unlocked)
layout=(-x "$ui")
sed -e "s|{SEAL}|$art/seal-$day.png|" -e "s|{PADLOCK}|$art/padlock.png|" \
  "$HOME/.config/fedokawaii/lock.ui" >"$ui.tmp" 2>/dev/null && mv -f "$ui.tmp" "$ui" || {
  layout=()
  notify-send -a desktop -u critical -- "${ICON_LOCK:-}  lock screen" "its layout is missing (~/.config/fedokawaii/lock.ui), so it locks plain — fedokawaii repair puts it back" 2>/dev/null
}

# the module (the three keys, the wake guard: built from src/kawa-lockmod by theme.sh) — gone,
# the screen still locks, without them, and a notice says what to repair
mod=$HOME/.local/lib/fedokawaii/kawa-lockmod.so
[[ -r $mod ]] || notify-send -a desktop -u critical -- "${ICON_LOCK:-}  lock screen" "its keys and wake guard are missing ($mod), so it locks without them — fedokawaii repair builds it again" 2>/dev/null

rm -f "$locked"
# the ground: the wallpaper shaded (kawa-wallpaper's lock_ground), or the theme's plain one
bg=$HOME/.cache/fedokawaii/lock-$THEME.png ground=()
[[ -s $bg ]] && ground=(-b "$bg")
# gtklock, under its keeper (above); --lock-command marks the moment every screen is locked.
# The date in English whatever the language (C), the ◆ box and the seal say the rest; its two
# messages in the desktop's words (LANGUAGE=fk: the catalogue setup installs, art/gtklock.mo)
setsid -f "$0" --keep env LC_TIME=C LANGUAGE=fk gtklock -s "$HOME/.config/fedokawaii/current/gtklock.css" "${layout[@]}" "${ground[@]}" -m "$mod" \
  --date-format '%a %d %b' --time-format '%I:%M' \
  --lock-command "kawa-lock --up" </dev/null >/dev/null 2>&1 9>&-
# (gone after a second without locking — it could not start: said at once, not after 10 s)
for ((i = 0; i < 100; i++)); do
  [[ -e $locked ]] && break
  ((i >= 10)) && ! keeping && fail "gtklock stopped before it locked"
  sleep 0.1
done
[[ -e $locked ]] || { pkill -xu "$UID" gtklock; fail "gtklock did not lock within 10 s"; }
exec 9>&-
((sleep_after > 0)) || exit 0
# the sleep after a lock you asked for: tied to this very lock (its keeper) — unlocked
# before the time is up, nothing happens; a second lock later has its own count
pid=$(<"$held") 2>/dev/null; [[ $pid =~ ^[0-9]+$ ]] || exit 0
setsid -f bash -c 'for ((i = 0; i < $1; i++)); do sleep 1; kill -0 "$2" 2>/dev/null || exit 0; done
  logger -t kawa-lock -- "still locked after $1 s: sleep" 2>/dev/null; systemctl suspend' _ "$sleep_after" "$pid" </dev/null >/dev/null 2>&1
exit 0
