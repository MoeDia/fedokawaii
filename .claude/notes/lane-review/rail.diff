+/* …and what a speed v (px for the whole of p) at p = 0 adds, px per unit of v: nothing stops dead when a
+ * new move takes over from one under way */
+static double
+springv(double p, double w, double z)
+{
+	double d, k;
+	if (p <= 0.0 || p >= 1.0)
+		return 0.0;
+	k = p > 0.9 ? 1.0 - (p - 0.9) * 10.0 : 1.0;
+	d = w * sqrt(1.0 - z * z);
+	return k * exp(-z * w * p) * sin(d * p) / d;
+}
