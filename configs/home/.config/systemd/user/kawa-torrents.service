# ~/.config/systemd/user/kawa-torrents.service — Torrents' engine (libtorrent): downloads go on with the window
# closed; it ends by itself, everything saved, 30 s after there is no window and nothing left to download.
# It reads what strangers on the network send, so it sees next to nothing: of your home only its own program, the
# downloads, its state and its cache (a tmpfs over the rest: your keys, your browsers' cookies, your data are not there to
# read). It starts no program: its words wait for the session's watcher (kawa-downloads watch). Each line below tried on
# the real network, 4 Nov 2026: 41 peers, pieces coming, in a transient unit with these same walls.
[Unit]
Description=Torrents' engine (libtorrent)
Requires=kawa-torrents.socket
After=kawa-torrents.socket

[Service]
ExecStart=%h/.local/bin/kawa-torrents engine
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
OOMScoreAdjust=200
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=tmpfs
# (+: this one line outside the walls below, so that they find what they name)
ExecStartPre=+/usr/bin/mkdir -p %h/downloads %S/fedokawaii/torrents %C/kawa-torrents %t/kawa-downloads
BindPaths=%h/downloads %S/fedokawaii/torrents %C/kawa-torrents %t/kawa-downloads
BindReadOnlyPaths=%h/.local/bin/kawa-torrents %h/.local/lib/fedokawaii/kawa-torrents
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount
