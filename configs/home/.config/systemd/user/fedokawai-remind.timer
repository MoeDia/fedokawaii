# ~/.config/systemd/user/fedokawai-remind.timer — two minutes after you log in, then every
# six hours while the session runs (started by ~/.config/dwl/autostart.sh; it stops with the
# session). The check is instant and silent unless something is due: `fedokawai remind`
# changes the season or turns it off.
[Unit]
Description=Fedokawai — the update season's reminder
PartOf=dwl-session.target

[Timer]
OnActiveSec=2min
OnUnitActiveSec=6h
AccuracySec=5min
