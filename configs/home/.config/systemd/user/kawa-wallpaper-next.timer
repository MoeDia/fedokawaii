# ~/.config/systemd/user/kawa-wallpaper-next.timer — a look every hour while the session runs
# (started by ~/.config/dwl/autostart.sh; it stops with the session). The change itself only
# when it is time by the Super+W picker's setting (off, 1 h, 4 h, daily: kawa-state
# wallpaper-rotate); otherwise each run looks at that and leaves at once.
[Unit]
Description=Fedokawaii — a look at whether a new wallpaper is due
PartOf=dwl-session.target

[Timer]
OnActiveSec=1h
OnUnitActiveSec=1h
AccuracySec=1min
