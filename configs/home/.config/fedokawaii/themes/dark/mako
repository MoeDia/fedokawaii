# ~/.config/fedokawaii/current/mako — sumi (ink) colours for notifications. Generated by tools/build-themes.py; edit the palette there.
# Included at the top of ~/.config/mako/config (mako allows include only outside a
# [section]); this file starts at the top level again, so it can have sections of its own.
# A notice is a panel (docs/design-system.md §4, §9) on a solid ground, surface, in the frame of
# everything that floats — the hairline in the bar's tiles' ink, its corners left out, and the
# shadow under it (the desktop's mako: src/mako/mako.patch's shadow-color). Its first row the
# title — the app's pixel icon in accent_text (summary-icon-color), its words 8 px on, strong —,
# then the body in text, every line on a 20 px row (line_height in Pango units: px × 1024) and
# under the title's words (the main config's hanging-indent). mako hands the title over as plain
# text: only its leading icon takes an ink of its own; the pixel fonts have no bold face, and a
# synthesised one smears their pixels.
background-color=#1c1916ff
text-color=#e7cfa1
border-color=#e7cfa180
shadow-color=#111314aa #11131450
summary-icon-color=#f47b58
# kanagu (P3): the brass chest fitting in each corner, as on the panels (lit edge, body, shade, rivet)
kanagu-color=#d6c09a #c5a56e #746346 #111314
# an app's own progress (the hint "value"): mako fills the card from the left, under the
# words — asagi, the meters' colour, thinned so the words keep their contrast
progress-color=over #82c1b440
format=<span foreground="#f5ecc2" line_height="20480">%s</span>\n<span line_height="20480">%b</span>

# critical: what needs you (the main config keeps these on screen until dismissed) — the hairline in vermilion, a
# 3 px bar of it inside the left one, the title's icon in a filled seal, and the key that takes it away
[urgency=critical]
border-color=#eb5324
left-edge=3 #eb5324
summary-icon-seal=#eb5324
summary-icon-color=#111314
format=<span foreground="#f5ecc2" line_height="20480">%s</span>\n<span line_height="20480">%b</span>\n<span line_height="20480"><span background="#2d251e" foreground="#f5ecc2"> super </span> <span background="#2d251e" foreground="#f5ecc2"> shift </span> <span background="#2d251e" foreground="#f5ecc2"> n </span><span foreground="#cab596"> dismiss</span></span>

# several notices from one app, folded into one card: the count beside the title, muted
[grouped]
format=<span foreground="#f5ecc2" line_height="20480">%s <span foreground="#cab596">×%g</span></span>\n<span line_height="20480">%b</span>

# udiskie's notice of a drive that would not open ("Job failed" — failed to mount, or to
# unlock: a wrong passphrase): titled like the drives' own notices (kawa-drives)
[app-name=udiskie]
format=<span foreground="#f5ecc2" line_height="20480">󾁄 not opened</span>\n<span line_height="20480">%b</span>
