* { font-family: "Sumi UI"; font-size: 14px; font-weight: normal; outline: 0; }
QWidget { background-color: #e8e3c2; color: #122625; selection-background-color: #82241f; selection-color: #f8f3d8; }
QMainWindow::separator { background: #e8e3c2; width: 8px; height: 8px; }
QMainWindow::separator:hover { background: #d7bc8c; }
QLabel, QCheckBox, QRadioButton { background: transparent; }
QLabel:disabled, QCheckBox:disabled, QRadioButton:disabled { color: #8b917f; }
QToolTip { background-color: #ecdfb3; color: #122625; border: 1px solid #d7bc8c; padding: 2px 8px; }

QMenuBar { background: #e8e3c2; padding: 0; spacing: 0; border: none; }
QMenuBar::item { background: transparent; padding: 3px 8px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background: #82241f; color: #f8f3d8; }
QMenu { background: #e8e3c2; border-image: url(KAWATHEME/firealpaca-frame.png) 1 2 3 1 stretch stretch; border-width: 1px 2px 3px 1px; padding: 8px 0; }
QMenu::item { background: transparent; padding: 3px 16px 3px 32px; }
QMenu::item:selected { background: #82241f; color: #f8f3d8; }
QMenu::item:disabled { color: #8b917f; }
QMenu::item:disabled:selected { background: transparent; color: #8b917f; }
QMenu::separator { height: 1px; background: #d7bc8c; margin: 9px 8px 10px 8px; }
QMenu::indicator { width: 12px; height: 12px; left: 10px; background: transparent; }
QMenu::indicator:checked { image: url(KAWATHEME/firealpaca-menu-check.png); }
QMenu::indicator:checked:selected { image: url(KAWATHEME/firealpaca-menu-check-sel.png); }
QMenu::indicator:checked:disabled { image: url(KAWATHEME/firealpaca-check-off.png); }
QMenu::right-arrow { image: url(KAWATHEME/firealpaca-right.png); width: 12px; height: 12px; right: 4px; }
QMenu::right-arrow:selected { image: url(KAWATHEME/firealpaca-right-sel.png); }
QMenu::right-arrow:disabled { image: url(KAWATHEME/firealpaca-right-off.png); }

QToolBar { background: #e8e3c2; border: none; spacing: 0; padding: 0; }
QToolBar::handle { image: none; width: 0; height: 0; }
QToolBar::separator:horizontal { background: #d7bc8c; width: 1px; margin: 6px 8px; }
QToolBar::separator:vertical { background: #d7bc8c; height: 1px; margin: 8px 6px; }
QToolButton { background: transparent; border: none; padding: 2px; }
QToolButton:hover { background: #f8f3d8; }
QToolButton:checked, QToolButton:pressed { background: #82241f; color: #f8f3d8; }
QToolButton::menu-indicator { image: none; }

QDockWidget { color: #121b1b; titlebar-close-icon: none; titlebar-normal-icon: none; }
QDockWidget::title { background-color: #e8e3c2; background-repeat: no-repeat; background-position: left center; text-align: left; padding: 3px 0 3px 32px; }
QDockWidget#DockColor::title { background-image: url(KAWATHEME/firealpaca-head-color.png); }
QDockWidget#DockColorHistory::title { background-image: url(KAWATHEME/firealpaca-head-history.png); }
QDockWidget#DockPalette::title { background-image: url(KAWATHEME/firealpaca-head-palette.png); }
QDockWidget#DockBrushPreview::title { background-image: url(KAWATHEME/firealpaca-head-preview.png); }
QDockWidget#DockBrushControl::title { background-image: url(KAWATHEME/firealpaca-head-control.png); }
QDockWidget#DockBrush::title { background-image: url(KAWATHEME/firealpaca-head-brush.png); }
QDockWidget#DockNavi::title { background-image: url(KAWATHEME/firealpaca-head-navi.png); }
QDockWidget#DockLayer::title { background-image: url(KAWATHEME/firealpaca-head-layer.png); }
QDockWidget#DockReference::title { background-image: url(KAWATHEME/firealpaca-head-reference.png); }
QDockWidget#DockBrushSize::title { background-image: url(KAWATHEME/firealpaca-head-size.png); }
QDockWidget::close-button, QDockWidget::float-button { width: 0; height: 0; border: none; background: transparent; image: none; }
QDockWidget#DockColor { min-height: 220px; max-height: 220px; }
QDockWidget#DockPalette { min-height: 281px; max-height: 281px; }
QDockWidget#DockBrushControl { min-height: 124px; max-height: 124px; }

QPushButton { background: #f8f3d8; color: #122625; border: 1px solid #dfcc9c; padding: 0 8px; min-height: 18px; dialogbuttonbox-buttons-have-icons: 0; }
QPushButton:hover { background: #82241f; border-color: #82241f; color: #f8f3d8; }
QPushButton:pressed { background: #82241f; border-color: #82241f; color: #f8f3d8; }
QPushButton:default { border-color: #82241f; }
QPushButton:disabled { color: #8b917f; }
QDialogButtonBox { button-layout: 0; dialogbuttonbox-buttons-have-icons: 0; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QAbstractSpinBox { background: #f8f3d8; color: #122625; border: 1px solid #dfcc9c; padding: 0 3px; min-height: 18px; }
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #586459; }
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled { color: #8b917f; }
QComboBox::drop-down { background: transparent; border: none; width: 16px; }
QComboBox::down-arrow { image: url(KAWATHEME/firealpaca-down.png); width: 12px; height: 12px; }
QComboBox::down-arrow:disabled { image: url(KAWATHEME/firealpaca-down-off.png); }
QComboBox QAbstractItemView { background: #e8e3c2; color: #122625; border: 1px solid #d7bc8c; selection-background-color: #82241f; selection-color: #f8f3d8; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { background: transparent; border: none; width: 16px; }
QAbstractSpinBox::up-arrow { image: url(KAWATHEME/firealpaca-up.png); width: 12px; height: 6px; }
QAbstractSpinBox::down-arrow { image: url(KAWATHEME/firealpaca-down.png); width: 12px; height: 6px; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 12px; height: 12px; background: #f8f3d8; border: 1px solid #d7bc8c; }
QCheckBox::indicator:checked { image: url(KAWATHEME/firealpaca-check.png); }
QCheckBox::indicator:checked:disabled { image: url(KAWATHEME/firealpaca-check-off.png); }
QCheckBox::indicator:disabled { border-color: #dfcc9c; }
QRadioButton { spacing: 8px; }
QRadioButton::indicator { width: 12px; height: 12px; background: #f8f3d8; border: 1px solid #d7bc8c; }
QRadioButton::indicator:checked { image: url(KAWATHEME/firealpaca-dot.png); }

QSlider { background: transparent; }
QSlider::groove:horizontal { background: #dfcc9c; height: 2px; }
QSlider::sub-page:horizontal { background: #00726a; }
QSlider::handle:horizontal { background: #a84222; width: 6px; margin: -6px 0; }
QSlider::groove:vertical { background: #dfcc9c; width: 2px; }
QSlider::handle:vertical { background: #a84222; height: 6px; margin: 0 -6px; }

QTabWidget::pane { background: #e8e3c2; border: none; border-top: 1px solid #d7bc8c; }
QTabBar { background: #e8e3c2; }
QTabBar::tab { background: #e8e3c2; color: #586459; border: none; padding: 3px 16px; min-height: 14px; }
QTabBar::tab:selected { background: #82241f; color: #f8f3d8; }
QTabBar::tab:hover:!selected { color: #122625; background: #f8f3d8; }
QTabBar::close-button { image: none; width: 0; }

QMdiArea { background: #e8e3c2; border: none; qproperty-background: #e8e3c2; }
QMdiSubWindow { background: #e8e3c2; border: none; }
QMdiArea QTabBar::tab, QMdiArea QTabBar::tab:selected, QMdiArea QTabBar::tab:hover { background: #e8e3c2; color: #586459; padding: 3px 8px; }
QMdiArea QTabBar::tab:selected { color: #121b1b; }
QAbstractScrollArea { background: #e8e3c2; border: none; }
QScrollBar:vertical { background: #e8e3c2; width: 8px; margin: 0; }
QScrollBar:horizontal { background: #e8e3c2; height: 8px; margin: 0; }
QScrollBar::handle { background: #d7bc8c; }
QScrollBar::handle:hover { background: #586459; }
QScrollBar::handle:vertical { min-height: 20px; margin: 0 0 0 16px; }
QScrollBar::handle:horizontal { min-width: 20px; margin: 16px 0 0 0; }
QScrollBar::add-line, QScrollBar::sub-line { background: transparent; height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QListView, QTreeView, QTableView, QListWidget, QTreeWidget, QTableWidget, QTextEdit, QPlainTextEdit { background: #f7f1d1; color: #122625; border: none; alternate-background-color: #f7f1d1; }
QListView::item, QTreeView::item { padding: 3px 8px; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #82241f; color: #f8f3d8; }
QHeaderView::section { background: #e8e3c2; color: #586459; border: none; padding: 3px 8px; }
QTableCornerButton::section { background: #e8e3c2; border: none; }

QGroupBox { background: transparent; border: none; margin-top: 28px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; color: #121b1b; padding: 3px 0; }
QProgressBar { background: #dfcc9c; color: #121b1b; border: none; text-align: center; }
QProgressBar::chunk { background: #00726a; }
QSplitter::handle { background: #e8e3c2; }
QStatusBar { background: #e8e3c2; color: #586459; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #586459; }
