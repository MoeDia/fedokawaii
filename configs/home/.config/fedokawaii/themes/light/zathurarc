# ~/.config/fedokawaii/current/zathurarc — washi (paper) colours for zathura. Generated by tools/build-themes.py; edit the palette there.
set default-bg          "#e8e3c2"
set default-fg          "#122625"
set statusbar-bg        "#ecdfb3"
set statusbar-fg        "#122625"
set inputbar-bg         "#ecdfb3"
set inputbar-fg         "#122625"
set notification-bg     "#ecdfb3"
set notification-fg     "#122625"
set notification-error-bg "#a84222"
set notification-error-fg "#f8f3d8"
set notification-warning-bg "#986f2d"
set notification-warning-fg "#ffffff"
set highlight-color     "rgba(152,111,45,0.40)"
set highlight-active-color "rgba(168,66,34,0.55)"
set completion-bg       "#ecdfb3"
set completion-fg       "#122625"
set completion-highlight-bg "#dfcc9c"
set completion-highlight-fg "#122625"
set index-bg            "#e8e3c2"
set index-fg            "#122625"
set index-active-bg     "#dfcc9c"
set index-active-fg     "#122625"
# Ctrl+r recolours the page itself: ink on paper, or paper on ink
set recolor-lightcolor  "#e8e3c2"
set recolor-darkcolor   "#122625"
