// ~/.config/waybar/config.jsonc — waybar 0.15. The bar as a hanging scroll (kakejiku): a thin
// strip of paper across the top, a fine hairline under it, every button the same size.
//   left:   torii key (opens the launcher) · workspaces 一 二 三 (+ any others in use) ·
//           layout icon (click: the next layout, right-click: the one before) · window title
//   centre: now playing between the two halves of a segment meter (hidden when nothing
//           plays) — waybar centres it on the screen
//   right:  mode seal · drives · Steam's gamepad (while it runs) · keyboard layout · memory ·
//           volume · weather ┆ date · day seal · time ┆ the cat (quick settings: it smiles while
//           a dropdown is open) — ┆ a sashiko stitch down the paper
// Network, Bluetooth, brightness, night light, theme… live in the quick-settings dropdown,
// so the bar stays quiet. No tray: the desktop's own modules stand for what apps would put
// there (Steam's gamepad). Reload without logging out: pkill -USR2 waybar
//
// Icons are drawn in the "Sumi Icons" font (art/icons.txt) and written here as JSON
// escapes; the name of each is in the comment beside it.
{
  "layer": "top",
  "position": "top",
  // 32 px, the hairline painted over the last row: the 12 px text line and the 23 px
  // buttons land on whole pixels, 4 px of paper above every button and 4 below
  "height": 32,
  "spacing": 0,

  "modules-left": [
    "custom/torii",
    "custom/tag1", "custom/tag2", "custom/tag3", "custom/tag4", "custom/tag5",
    "custom/tag6", "custom/tag7", "custom/tag8", "custom/tag9",
    "custom/layout", "custom/title"
  ],
  "modules-center": ["custom/nowplaying"],
  "modules-right": ["group/status", "custom/sep1", "group/when", "custom/sep2", "custom/menu"],
  // the groups: what the computer is doing, and when it is — between them, and before the
  // cat, a sashiko stitch: a running stitch of faint thread down the paper (style.css draws
  // it; the text is a zero-width space, as an empty one would hide the module)
  "group/status": { "orientation": "horizontal",
                    "modules": ["custom/mode", "custom/drives", "custom/steam", "custom/kb", "custom/mem", "wireplumber", "custom/weather"] },
  "group/when":   { "orientation": "horizontal", "modules": ["clock#date", "custom/day", "clock#time"] },
  "custom/sep1":  { "format": "\u200b", "tooltip": false },
  "custom/sep2":  { "format": "\u200b", "tooltip": false },

  // the torii icon
  "custom/torii": { "format": "\uDBB8\uDC00", "tooltip": false, "on-click": "fuzzel" },

  // workspaces: written by kawa-dwlstatus, which pokes only what changed — SIGRTMIN+8 workspaces,
  // +9 layout, +10 title, +11 keyboard layout; an empty text hides the module. Each monitor's
  // bar shows that monitor's (dwl-bar/$WAYBAR_OUTPUT_NAME/, else the focused one's).
  // Clicking one switches to it (kawa-tag presses its Super+1…9 through a virtual keyboard:
  // dwl acts on the monitor under the pointer, the one whose bar was clicked).
  "custom/tag1": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag1.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag1.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 1" },
  "custom/tag2": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag2.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag2.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 2" },
  "custom/tag3": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag3.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag3.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 3" },
  "custom/tag4": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag4.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag4.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 4" },
  "custom/tag5": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag5.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag5.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 5" },
  "custom/tag6": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag6.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag6.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 6" },
  "custom/tag7": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag7.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag7.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 7" },
  "custom/tag8": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag8.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag8.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 8" },
  "custom/tag9": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag9.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag9.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 8, "tooltip": false, "on-click": "kawa-tag 9" },
  "custom/layout": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/layout.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/layout.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "interval": "once", "signal": 9, "tooltip": false,
                     "on-click": "kawa-tag layout next", "on-click-right": "kawa-tag layout prev" },
  // keyboard layout (US / AR, switched with Alt+Shift); vermilion while it is not the first
  "custom/kb":     { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/kb.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"",     "return-type": "json", "interval": "once", "signal": 11, "tooltip": false },
  "custom/title":  { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/title.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/title.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"",  "return-type": "json", "interval": "once", "signal": 10, "tooltip": false, "max-length": 60 },

  // one long-running script (see its header); restarted if it ever exits
  "custom/nowplaying": {
    "exec": "kawa-nowplaying", "return-type": "json", "restart-interval": 5, "tooltip": false,
    "on-click": "kawa-nowplaying play-pause", "on-click-right": "kawa-nowplaying next", "on-click-middle": "kawa-nowplaying previous"
  },

  // the USB mark while a stick, disk or SD card is plugged in (lit while one is open, a count
  // past one): click for the drives menu, open or eject. The session's watcher (kawa-drives
  // watch) pokes it with SIGRTMIN+13 the moment udisks sees one come, open, close or go —
  // a card put into a reader included; empty hides it
  "custom/drives": { "exec": "kawa-drives bar", "return-type": "json", "interval": "once", "signal": 13,
                     "tooltip": false, "on-click": "kawa-drives" },

  // Steam's gamepad, only while Steam runs (kawa-steam --bar): dim while it starts, lit once
  // ready, filled vermilion in a game. Click: Steam's window · right-click: its menu
  "custom/steam": { "exec": "kawa-steam --bar", "return-type": "json", "interval": 3,
                    "on-click": "kawa-steam", "on-click-right": "kawa-steam --menu" },

  // memory in use (kawa-mem: what programs hold, as btop counts it); click: btop, big
  // enough for all its panels
  "custom/mem": { "exec": "kawa-mem", "return-type": "json", "restart-interval": 5,
                  "on-click": "kawa-float --once btop btop 112x33 -- btop" },

  // the volume: the speaker's waves show the level — none at 0, one up to 25 %, two to 50,
  // three to 75, four above (one icon per per cent: waybar picks icon N of 100 for N %) —
  // and the number beside it, its % quiet; muted: the speaker crossed out
  "wireplumber": {
    "format": "{icon} {volume}<span fgalpha='55%'>%</span>",
    "format-muted": "\uDBB8\uDC4B <span fgalpha='55%'>off</span>",
    "format-icons": ["\uDBB8\uDC46", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC47", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC48", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC49", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A", "\uDBB8\uDC4A"],
    "tooltip": false,
    "on-click": "kawa-audio", "on-click-right": "kawa-volume mute",
    // (scrolling over it: kawa-volume, as Super+scroll — up unmutes and stops at 100 %, the level shown)
    "on-scroll-up": "kawa-volume up 2", "on-scroll-down": "kawa-volume down 2",
    "max-volume": 100
  },

  // the weather: the sky's icon and the temperature (the city and the words in the tooltip);
  // click: the forecast for the next days
  "custom/weather": { "exec": "kawa-weather --bar", "return-type": "json", "interval": 600,
                      "on-click": "kawa-weather --forecast" },

  // the clock: English names and AM/PM whatever the system language; waybar wakes on
  // each whole second itself, so no script is needed. Click either part for the calendar.
  // a seal while something is held back: 静 (quiet) while "do not disturb" is on, 共有
  // (shared) in vermilion while a screen is shared; nothing otherwise. Poked with SIGRTMIN+12
  // by quick settings and the screen-sharing portal.
  "custom/mode": { "exec": "case $(makoctl mode 2>/dev/null) in *sharing*) echo '{\"text\":\"共有\",\"class\":\"share\"}' ;; *do-not-disturb*) echo '{\"text\":\"静\",\"class\":\"dnd\"}' ;; *) echo '{\"text\":\"\"}' ;; esac", "return-type": "json", "interval": "once", "signal": 12,
                   "tooltip": false, "on-click": "kawa-quick" },

  // the day of the week as its kanji (月 火 水 木 金 土 日), a vermilion seal between the date and the time
  "custom/day": { "exec": "set -- 月 火 水 木 金 土 日; shift $(( $(date +%u) - 1 )); printf '%s\\n' \"$1\"",
                  "interval": 60, "tooltip": false, "on-click": "kawa-calendar" },
  "clock#date": { "format": "{:%a %d %b}", "interval": 60, "locale": "C", "tooltip": false, "on-click": "kawa-calendar" },
  "clock#time": { "format": "{:%I:%M:%S %p}", "interval": 1, "locale": "C", "tooltip": false, "on-click": "kawa-calendar" },

  // the cat (quick settings): it smiles, filled vermilion, while any dropdown is on screen —
  // the panel, or a menu dropping from the bar (audio, calendar, drives, Steam's): kawa-menu
  // says so with SIGRTMIN+15. (the cat and cat-happy icons)
  "custom/menu": { "exec": "if [ -e \"$XDG_RUNTIME_DIR/kawa-drop.open\" ]; then echo '{\"text\":\"\uDBB8\uDC52\",\"class\":\"open\"}'; else echo '{\"text\":\"\uDBB8\uDC51\"}'; fi",
                   "return-type": "json", "interval": "once", "signal": 15, "tooltip": false, "on-click": "kawa-quick" }
}
