// ~/.config/waybar/config.jsonc — waybar 0.15. No bar: washi tiles floating along the top of
// the screen (紙 kami — style.css), each part of the desktop on a tile of its own.
//   left:   the torii key (opens the launcher) on a vermilion tile · the workspaces 一 二 三
//           (+ any others in use), a tile each, the one you are on stamped with a vermilion seal
//           · the layout's mark (click: the next layout, right-click: the one before) and the
//           window's name, on one tile (group/focused)
//   centre: the clock mounted as a hanging scroll: date · the day's kanji · time — and while
//           music plays, its spectrum inside it either side, the left channel left, the right
//           one right
//   right:  now playing · a timer (while one runs) · recording (while one runs) · the quiet
//           bell or the sharing monitor · drives · downloads (while one runs) · the keyboard
//           layout (click: the next) · memory · volume · brightness · weather, a tile each ·
//           the mood's face (quick settings: a demon by night, an angel by day) on the other end's vermilion tile
// Network, Bluetooth, night light, theme… live in the quick-settings dropdown,
// so the bar stays quiet. No tray: the desktop's own modules stand for what apps would put
// there. Reload without logging out: pkill -USR2 waybar
//
// Every button that opens something toggles it — a click opens it, the same click again
// closes it, another button's closes it and opens its own — and stays lit (its class "active":
// its glyph and text in vermilion) while what it opened is on screen: each opener holds a
// marker with its pid and pokes its button's module as it opens and as it closes (kawa-bar
// says which marker is whose). The openers run apart from the bar (setsid -f): waybar waits
// for a click's command before it runs that module's own again, so one that stayed (a menu
// open) would hold its button's light back. A module that only answers its signal has no
// "interval" (waybar then never waits for its clicks at all).
// Signals (SIGRTMIN+N, kawa-dwlstatus --poke): 8 workspaces · 9 layout · 10 title · 11
// keyboard layout · 12 mode · 13 drives · 14 brightness · 15 the face · 18 weather ·
// 19 date and day · 20 torii · 21 downloads · 22 recording; the long-running modules (time, memory, volume) are woken
// through a fifo of their own instead.
// Tooltips: only where the glyph does not say it all — what it is · click · right-click ·
// scroll, from the module's own JSON; every other module has "tooltip": false.
// A click runs only its command ("exec-on-event": false): the module's own runs on its signal
// or interval alone — not again on every click, racing the opener (the light would flicker)
// and setting its tooltip anew, which GTK then shows again under the pointer, behind the menu
// the click opened. While lit a module's tooltip is empty (kawa-bar), so none shows over its
// own menu.
//
// Icons are drawn in the "Sumi Icons" font (art/icons.txt); kawa-bar and the modules' own
// scripts write them (icons.sh).
{
  "layer": "top",
  "position": "top",
  // 31 px: a tile's hairline, paper and rule above the 16 px text line and below it, and the
  // tile's shadow (style.css: the rows)
  "height": 27,
  // its exclusive zone ends on the tiles' lower hairline (row 24): the shadow's two rows lie in
  // the windows' 8 px gap (gtk-layer-shell's auto zone: the height plus this margin), so the
  // windows' tops are on y 33 (dwl's outergappx 8) — docs/design-system.md §3, §12
  "margin-bottom": -2,
  "spacing": 0,

  "modules-left": [
    "custom/torii",
    "custom/tag1", "custom/tag2", "custom/tag3", "custom/tag4", "custom/tag5",
    "custom/tag6", "custom/tag7", "custom/tag8", "custom/tag9",
    "group/focused"
  ],
  "modules-center": ["group/when"],
  "modules-right": ["group/status", "custom/menu"],
  "group/status": { "orientation": "horizontal",
                    "modules": ["custom/nowplaying", "custom/timer", "custom/record", "custom/mode", "custom/drives", "custom/downloads", "custom/kb", "custom/mem", "custom/volume", "custom/brightness", "custom/weather"] },
  "group/when":   { "orientation": "horizontal", "modules": ["custom/wing-left", "custom/date", "custom/day", "custom/time", "custom/wing-right"] },
  "group/focused": { "orientation": "horizontal", "modules": ["custom/layout", "custom/title"] },

  // the torii: the launcher (kawa-menu --launcher, in the middle of the screen; Super+Space the same)
  "custom/torii": { "exec": "kawa-bar torii", "return-type": "json", "signal": 20, "tooltip": false,
                    "exec-on-event": false, "on-click": "setsid -f kawa-menu --launcher" },

  // workspaces: written by kawa-dwlstatus, which pokes only what changed — SIGRTMIN+8 workspaces,
  // +9 layout, +10 title, +11 keyboard layout; an empty text hides the module. Each monitor's
  // bar shows that monitor's (dwl-bar/$WAYBAR_OUTPUT_NAME/, else the focused one's).
  // Clicking one switches to it (kawa-tag presses its Super+1…9 through a virtual keyboard:
  // dwl acts on the monitor under the pointer, the one whose bar was clicked).
  "custom/tag1": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag1.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag1.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 1" },
  "custom/tag2": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag2.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag2.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 2" },
  "custom/tag3": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag3.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag3.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 3" },
  "custom/tag4": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag4.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag4.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 4" },
  "custom/tag5": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag5.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag5.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 5" },
  "custom/tag6": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag6.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag6.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 6" },
  "custom/tag7": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag7.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag7.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 7" },
  "custom/tag8": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag8.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag8.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 8" },
  "custom/tag9": { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/tag9.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/tag9.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"", "return-type": "json", "signal": 8, "tooltip": false, "exec-on-event": false, "on-click": "kawa-tag 9" },
  "custom/layout": { "exec": "kawa-bar layout", "return-type": "json", "signal": 9, "tooltip": false,
                     "exec-on-event": false, "on-click": "kawa-tag layout next", "on-click-right": "kawa-tag layout prev" },
  // keyboard layout (US / AR, switched with Alt+Shift); vermilion while it is not the first
  "custom/kb":     { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/kb.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"",     "return-type": "json", "signal": 11, "tooltip": false,
                     "exec-on-event": false, "on-click": "kawa-tag kb next" },
  "custom/title":  { "exec": "{ IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/${WAYBAR_OUTPUT_NAME:-.}/title.json\" || IFS= read -r l <\"$XDG_RUNTIME_DIR/dwl-bar/title.json\"; } 2>/dev/null && printf '%s\\n' \"$l\"",  "return-type": "json", "signal": 10, "tooltip": false },

  // one long-running script (see its header); restarted if it ever exits. It meters the music
  // too, into the two wings beside the clock: each reads its own fifo, which kawa-nowplaying
  // writes while something plays (empty: hidden)
  "custom/wing-left":  { "exec": "kawa-nowplaying --wing left",  "return-type": "json", "restart-interval": 1, "tooltip": false,
                         "exec-on-event": false, "on-click": "kawa-nowplaying play-pause" },
  "custom/wing-right": { "exec": "kawa-nowplaying --wing right", "return-type": "json", "restart-interval": 1, "tooltip": false,
                         "exec-on-event": false, "on-click": "kawa-nowplaying play-pause" },
  "custom/nowplaying": {
    "exec": "kawa-nowplaying", "return-type": "json", "restart-interval": 1, "tooltip": false,
    "exec-on-event": false, "on-click": "kawa-nowplaying play-pause", "on-click-right": "kawa-nowplaying next", "on-click-middle": "kawa-nowplaying previous"
  },

  // what is held back: the quiet bell while "do not disturb" is on, the monitor while a screen
  // is shared; nothing otherwise. Poked with SIGRTMIN+12 by kawa-quick (do not disturb, from
  // quick settings or its own dropdown — this tile's click) and the screen-sharing portal
  "custom/mode": { "exec": "kawa-bar mode", "return-type": "json", "signal": 12, "exec-on-event": false, "on-click": "setsid -f kawa-quick dnd" },

  // 録 (record) and the time gone by, in vermilion, while the screen is recorded (Super+Shift+R);
  // hidden otherwise. kawa-record pokes it each second while it records — nothing runs for it
  // the rest of the time. Click: stop
  "custom/record": { "exec": "kawa-record bar", "return-type": "json", "signal": 22, "tooltip": false,
                     "exec-on-event": false, "on-click": "kawa-record stop" },

  // the USB mark while a stick, disk or SD card is plugged in (lit while one is open, a count
  // past one): click for the drives menu, open or eject. The session's watcher (kawa-drives
  // watch) pokes it with SIGRTMIN+13 the moment udisks sees one come, open, close or go —
  // a card put into a reader included; empty hides it
  "custom/drives": { "exec": "kawa-bar drives -- kawa-drives bar", "return-type": "json", "signal": 13,
                     "tooltip": false, "exec-on-event": false, "on-click": "setsid -f kawa-drives" },

  // the download mark while anything downloads — a torrent, Brave (kawa-downloads): its arrow
  // dropping into the tray (6 frames, 8 a second), the percent of them all; click: what comes
  // in and how far, a click on one opens where it lands. Long-running: asleep while nothing
  // downloads, woken by its watcher's word and its menu's (kawa-dwlstatus: its fifo); empty
  // hides it
  "custom/downloads": { "exec": "kawa-downloads bar --follow", "return-type": "json", "restart-interval": 5,
                        "tooltip": false, "exec-on-event": false, "on-click": "setsid -f kawa-downloads" },

  // memory in use (kawa-mem: what programs hold, as btop counts it); click: btop, big
  // enough for all its boxes — the graphics card's too (140 × 41 cells: 1420 × 922 px)
  "custom/mem": { "exec": "kawa-mem", "return-type": "json", "restart-interval": 5,
                  "exec-on-event": false, "on-click": "setsid -f kawa-term --float --once btop btop 140x41 -- btop" },

  // the volume (kawa-volume bar, long-running on PipeWire's own events): the speaker's waves
  // show the level — none at 0, one up to 25 %, two to 50, three to 75, four above — and the
  // number beside it, its % quiet; muted: the speaker crossed out. Click: the sound panel ·
  // right-click: mute · scroll: ±2 % (kawa-volume, as Super+scroll: up unmutes and stops at
  // 100 %, the level shown)
  "custom/volume": { "exec": "kawa-volume bar", "return-type": "json", "restart-interval": 5,
                     "exec-on-event": false, "on-click": "kawa-quick sound", "on-click-right": "kawa-volume mute",
                     "on-scroll-up": "kawa-volume up 2", "on-scroll-down": "kawa-volume down 2" },

  // the monitor's brightness beside the sound's level, drawn the same way: the sun in five
  // steps (a hollow disc when dim … every ray when bright) and the level. Only while a monitor
  // answers over DDC/CI (hidden otherwise). Click: its slider · scroll: ±10 %, as Super+] /
  // Super+[. Long-running: every change pushed to it the moment it is made (the slider
  // dragged, a key — kawa-bar's bar_push), drawn within a frame; lit by its slider (a wake)
  "custom/brightness": { "exec": "kawa-brightness --bar", "return-type": "json", "restart-interval": 5, "signal": 14,
                         "exec-on-event": false, "on-click": "kawa-quick brightness", "on-scroll-up": "kawa-brightness +10", "on-scroll-down": "kawa-brightness -10" },

  // the weather: the sky's icon and the temperature (the city and the words in the tooltip);
  // click: the forecast for the days ahead, a dropdown
  "custom/weather": { "exec": "kawa-bar weather -- kawa-weather --bar", "return-type": "json", "interval": 600, "signal": 18,
                      "exec-on-event": false, "on-click": "setsid -f kawa-weather --menu" },

  // the date ("Mon 19 Oct", in English whatever the system language) and the day of the
  // week as its kanji seal (月 火 水 木 金 土 日) — one click, the calendar; the time to the
  // second, and beside it while one runs the hourglass and what is left (vermilion: a timer)
  // or gone by (asagi: a stopwatch) — its click, the timer's menu. The time is one
  // long-running script that sleeps between seconds; the timer's state outlives the bar
  "custom/date": { "exec": "kawa-bar date", "return-type": "json", "interval": 60, "signal": 19, "tooltip": false,
                   "exec-on-event": false, "on-click": "setsid -f kawa-calendar" },
  "custom/day":  { "exec": "kawa-bar day", "return-type": "json", "interval": 60, "signal": 19, "tooltip": false,
                   "exec-on-event": false, "on-click": "setsid -f kawa-calendar" },
  "custom/time": { "exec": "kawa-timer bar", "return-type": "json", "restart-interval": 5, "tooltip": false,
                   "exec-on-event": false, "on-click": "setsid -f kawa-timer" },
  // the timer or stopwatch running, a cell of its own on the right (kawa-timer bar timer):
  // the hourglass and the time left (vermilion) or gone by (asagi); hidden otherwise
  "custom/timer": { "exec": "kawa-timer bar timer", "return-type": "json", "restart-interval": 5, "tooltip": false,
                    "exec-on-event": false, "on-click": "setsid -f kawa-timer" },

  // the mood's face (quick settings, kawa-panel): the oni roars, the tennin smiles while they are open
  "custom/menu": { "exec": "kawa-bar cat", "return-type": "json", "signal": 15, "tooltip": false,
                   "exec-on-event": false, "on-click": "kawa-quick" }
}
