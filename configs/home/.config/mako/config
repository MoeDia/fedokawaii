# ~/.config/mako/config — mako 1.11. Apply: makoctl reload (fails loudly on a bad key)
# Every card is a panel of the design system (docs/design-system.md): the surface in a 2 px
# muted frame, square, never a shadow; the pixel font at its one size, 16 px. Critical ones
# get a vermilion frame and stay.
# "do not disturb" in quick settings switches to the mode at the end of this file.
# colours, the title's row and the level display's look come from the current theme (the
# vermilion frame of critical ones too); mako takes include only outside a [section]
include=~/.config/fedokawaii/current/mako
font=Sumi UI,Sumi Icons,JetBrainsMono Nerd Font,Noto Kufi Arabic 16px
border-size=2
border-radius=0
# the panel's 16 px of pad all round: the words start 16 px inside the frame — an app's
# picture stands there instead (two of the card's 24 px rows high: max-icon-size), and the
# words 16 px after it, its top on the title's row and its foot on the first line's
padding=16
# 8 px from the screen's edge and below the bar: the windows' gap (dwl's gappx), so a notice
# lines up with the windows and the dropdown menus to the pixel; as wide as quick settings'
# panel (kawa-panel), so the two make one column under the bar's right end
margin=8
width=412
height=180
default-timeout=5000
layer=overlay
max-icon-size=48
# the same notice again (a job started twice, a drive plugged in again) folds into its card,
# ×N beside the title; different notices from one app each keep a card of their own (mako
# shows only a group's first member: folding them all would hide what the others say)
group-by=app-name,summary,body
# a click takes the card away at once — the whole card, ×N and all (a plain dismiss closes
# only its first member, and the card stays for the next): a notice with a default action
# (the drives') runs it instead, below
on-button-left=dismiss-group
on-button-right=dismiss-all
# the notices that went by: kawa-hush counts and lists those held back during a screen share
# or a game from here (the default keeps 5)
max-history=50

[urgency=low]
default-timeout=3000

[app-name=desktop]
default-timeout=2500

# the drives (kawa-drives): a drive that opened says so for 8 s, and a click opens its
# files (the notice's default action, run and the card closed in the same moment); "safe to
# unplug" and the rest close on a click.
# A drive pulled out while open is critical: it stays until you have read it.
[app-name=drives]
default-timeout=8000
on-button-left=invoke-default-action

[app-name=drives urgency=critical]
default-timeout=0

# a finished download (kawa-downloads: a torrent, Brave's, a Steam game): 8 s, and a click
# opens it — the file under yazi's cursor, or Steam's downloads
[app-name=downloads]
default-timeout=8000
on-button-left=invoke-default-action

# what only you can do (kawa-foryou: a cable to plug, a choice that is yours): critical, so
# it stays; a click marks it done (its default action), a right click puts it away until the
# next login
[app-name=foryou]
on-button-left=invoke-default-action

# what was held back during a share or a game (kawa-hush): "3 notices while you shared",
# 8 s, and a click lists them
[app-name=notices]
default-timeout=8000
on-button-left=invoke-default-action

# a critical notice stays until you have read it, whichever app sent it ("the move to
# Fedora … did not complete" comes from the desktop): after the apps' own times above, as
# mako applies every section that matches, in order, and the last one wins
[urgency=critical]
default-timeout=0

# udiskie's own notice of a drive that would not open: titled like the drives' notices (the
# theme's part), without udiskie's picture — and when closing a drive failed, none at all:
# kawa-drives' eject says it, and which of your programs still uses the drive (a switch-off
# or media eject refused after the drive closed: it is safe to unplug all the same)
[app-name=udiskie]
icons=0

[app-name=udiskie body~="^failed to (unmount|lock|detach|eject) "]
invisible=1

# the level display of the volume and brightness keys (kawa-osd): a small panel at the
# bottom centre, replaced in place while a key is held — quick settings' brightness panel,
# to the pixel: 412 × 60, one meter row of 24 px in the 16 px of pad above and below, and
# 24 across — the panel's 16 and its row's 8 — so the glyph's pen stands at x 26 and the
# squares at x 146, where the panel's meter has them (kawa-osd). An even width, so it is
# centred to the pixel on any screen; 72 px above the bottom edge (mako leaves out the last
# notice's own bottom margin, so the distance is the outer margin).
[category=osd]
anchor=bottom-center
margin=0
outer-margin=0,0,72,0
width=412
padding=16,24
default-timeout=1400

# (hidden notices are not folded into a shown one: a critical card would count them, ×N)
[mode=do-not-disturb]
invisible=1
group-by=none

# critical messages, and the level of a key you just pressed, still show while not disturbed
[mode=do-not-disturb urgency=critical]
invisible=0

[mode=do-not-disturb category=osd]
invisible=0

# while a screen is shared (kawa-hush, run by the screen-sharing portal: see
# ~/.config/xdg-desktop-portal-wlr/config): the same rules, so nothing private shows on it
[mode=sharing]
invisible=1
group-by=none

[mode=sharing urgency=critical]
invisible=0

[mode=sharing category=osd]
invisible=0

# while a game runs (game mode: kawa-game): the same rules
[mode=game]
invisible=1
group-by=none

[mode=game urgency=critical]
invisible=0

[mode=game category=osd]
invisible=0
