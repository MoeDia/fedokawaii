# ~/.config/mako/config — mako 1.11. Apply: makoctl reload (fails loudly on a bad key)
# Solid square cards with a full 2 px warm-grey border (like every menu and window), pixel
# font; critical ones get a vermilion border and stay.
# "do not disturb" in quick settings switches to the mode at the end of this file.
# colours and icons of the current theme (also the quieter text of low-urgency notices and
# the vermilion edge of critical ones); mako takes include only outside a [section]
include=~/.config/fedokawaii/current/mako
font=DepartureMono Nerd Font,Sumi Icons,PixelMplus12,Noto Kufi Arabic 11px
border-size=2
border-radius=0
padding=10,16
# 6 px from the screen's edge and below the bar: the same right edge as the dropdown menus
margin=6
width=340
height=140
default-timeout=5000
layer=overlay
max-icon-size=32
group-by=app-name
on-button-left=dismiss
on-button-right=dismiss-all

[urgency=low]
default-timeout=3000

[app-name=desktop]
default-timeout=2500

# the drives (kawa-drives): a drive that opened says so for 8 s, and a click opens its
# files (the notice's default action); "safe to unplug" and the rest close on a click.
# A drive pulled out while open is critical: it stays until you have read it.
[app-name=drives]
default-timeout=8000
on-button-left=invoke-default-action

[app-name=drives urgency=critical]
default-timeout=0

# a critical notice stays until you have read it, whichever app sent it ("the move to
# Fedora … did not complete" comes from the desktop): after the apps' own times above, as
# mako applies every section that matches, in order, and the last one wins
[urgency=critical]
default-timeout=0

# udiskie's own notice of a drive that would not open: titled like the drives' notices (the
# theme's part), without udiskie's picture — and when closing a drive failed, none at all:
# kawa-drives' eject says it, and which of your programs still uses the drive (a switch-off
# or media eject refused after the drive closed: it is safe to unplug all the same)
[app-name=udiskie]
icons=0

[app-name=udiskie body~="^failed to (unmount|lock|detach|eject) "]
invisible=1

# the level display of the volume and brightness keys (kawa-osd): a small panel at the
# bottom centre, replaced in place while a key is held. Its width is its content exactly
# (230 px, see kawa-osd) + 16 + 14 padding + 2 × 2 border: the left padding is 2 px less
# because the label's icon and the wedge both start 2 px into their own boxes, so 16 px of
# panel shows on both sides; an even width, so it is centred to the pixel on any screen. 72 px above the bottom edge: mako leaves
# out the last notice's own bottom margin, so the distance is the outer margin. Padding
# 7 above and below: with the label's taller line (the theme's format) the text block has
# 6 px over the letters and 6 px under the wedge (whose floor stands on the number's
# baseline), so 13 px of panel shows above and below what you see, and 16 px at the sides.
[category=osd]
anchor=bottom-center
margin=0
outer-margin=0,0,72,0
width=264
padding=7,16,7,14
default-timeout=1400

# (hidden notices are not folded into a shown one: a critical card would count them, ×N)
[mode=do-not-disturb]
invisible=1
group-by=none

# critical messages, and the level of a key you just pressed, still show while not disturbed
[mode=do-not-disturb urgency=critical]
invisible=0

[mode=do-not-disturb category=osd]
invisible=0

# while a screen is shared (set by the screen-sharing portal, see
# ~/.config/xdg-desktop-portal-wlr/config): the same rules, so nothing private shows on it
[mode=sharing]
invisible=1
group-by=none

[mode=sharing urgency=critical]
invisible=0

[mode=sharing category=osd]
invisible=0
