# ~/.config/fedokawai/current/zathurarc — washi (paper) colours for zathura. Generated by tools/build-themes.py; edit the palette there.
set default-bg          "#e9e1cb"
set default-fg          "#2b2721"
set statusbar-bg        "#dcd2b8"
set statusbar-fg        "#2b2721"
set inputbar-bg         "#dcd2b8"
set inputbar-fg         "#2b2721"
set notification-bg     "#dcd2b8"
set notification-fg     "#2b2721"
set notification-error-bg "#a8342a"
set notification-error-fg "#fbf7ec"
set notification-warning-bg "#845b0f"
set notification-warning-fg "#fbf7ec"
set highlight-color     "rgba(132,91,15,0.40)"
set highlight-active-color "rgba(192,70,42,0.55)"
set completion-bg       "#dcd2b8"
set completion-fg       "#2b2721"
set completion-highlight-bg "#c2b79b"
set completion-highlight-fg "#2b2721"
set index-bg            "#e9e1cb"
set index-fg            "#2b2721"
set index-active-bg     "#c2b79b"
set index-active-fg     "#2b2721"
# Ctrl+r recolours the page itself: ink on paper, or paper on ink
set recolor-lightcolor  "#e9e1cb"
set recolor-darkcolor   "#2b2721"
