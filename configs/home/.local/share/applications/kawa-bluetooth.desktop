[Desktop Entry]
# bluetui, Bluetooth pairing — the window quick settings' devices opens (kawa-quick --do
# devices: floating, one at a time). Its icon: foot's, the terminal that draws its window
# (bluetui ships none of its own; the launcher shows each program's own icon, never an icon
# pack's).
Type=Application
Name=Bluetooth
GenericName=Pair a device
Comment=bluetui: pair and connect headphones, speakers, controllers and keyboards
Icon=foot
Exec=@HOME@/.local/bin/kawa-quick --do devices
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=bluetui;pair;headphones;earbuds;speaker;controller;gamepad;
