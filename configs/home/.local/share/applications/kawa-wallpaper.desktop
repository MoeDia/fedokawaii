[Desktop Entry]
# The wallpaper picker (kawa-wallpaper), as Super+W opens it: the pictures for the current
# theme, the one under the cursor shown as the screen will; Enter sets it. Its icon: our
# seal of 壁 (tools/build-appicons.py, the theme's own: current/apps).
Type=Application
Name=Wallpaper
GenericName=Desktop background
Comment=Choose the picture behind the windows
Icon=@HOME@/.config/fedokawaii/current/apps/wallpaper.png
Exec=@HOME@/.local/bin/kawa-wallpaper
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=background;wallpaper;picture;desktop;
