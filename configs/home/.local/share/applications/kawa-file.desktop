[Desktop Entry]
# Archives and PDFs (kawa-file): the menu Super+D opens, on what you copied — or, with
# nothing copied, on the files you choose in the file dialog first.. Its icon: our seal of 具
# (the launcher draws it: X-Fedokawaii-Icon).
Type=Application
Name=File tools
GenericName=Archives and PDFs
Comment=Unpack or pack archives; merge, split, sign and lock PDFs
X-Fedokawaii-Icon=tools
Exec=@HOME@/.local/bin/kawa-file --choose
Terminal=false
Categories=Utility;Archiving;Compression;Office;
Keywords=zip;unzip;7z;rar;tar;archive;extract;compress;pdf;merge;split;rotate;sign;signature;ocr;password;
