[Desktop Entry]
# torrra in a terminal window of its own: from the launcher it opens the search; a magnet
# link (Brave asks once whether to open it here) or a .torrent file starts downloading
# straight away (defaults in ~/.config/mimeapps.list). kawa-torrra hands torrra the Prowlarr
# key from secrets.sh and says what is wrong as a notice. Its icon: our seal of 種
# (the launcher draws it: X-Fedokawaii-Kanji).
Type=Application
Name=Torrents
GenericName=Torrent search and download
Comment=torrra, searching through Prowlarr
X-Fedokawaii-Kanji=種
Exec=@HOME@/.local/bin/kawa-term kawa-torrra --open %u
Terminal=false
MimeType=x-scheme-handler/magnet;application/x-bittorrent;
Categories=Network;FileTransfer;P2P;
Keywords=torrra;torrent;magnet;prowlarr;download;
