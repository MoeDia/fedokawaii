[Desktop Entry]
# Torrents, in a terminal window of its own (kawa-torrents --open: no terminal is opened just to hand a link
# over): from the launcher, its list; a magnet link (the browser asks once whether to open it here) or a
# .torrent file opened anywhere is added, to the window that is open or to one opened for it (defaults in
# ~/.config/mimeapps.list). Its icon: ours (the launcher draws it: X-Fedokawaii-Icon).
Type=Application
Name=Torrents
GenericName=Torrent search and download
Comment=Find torrents, add magnet links, play what is still coming
X-Fedokawaii-Icon=download
Exec=@HOME@/.local/bin/kawa-torrents --open %u
Terminal=false
MimeType=x-scheme-handler/magnet;application/x-bittorrent;
Categories=Network;FileTransfer;P2P;
Keywords=torrent;magnet;prowlarr;download;
