[Desktop Entry]
# Draw (kawa-sketch): FireAlpaca on a new sketch in ~/notes/sketches, dressed as the desktop, for
# the drawing tablet's pen or the mouse. Its icon: our brush (the launcher draws it: X-Fedokawaii-Icon).
Type=Application
Name=Sketch
GenericName=Drawing
Comment=Draw and paint, with the pen or the mouse (FireAlpaca)
X-Fedokawaii-Icon=brush
Exec=@HOME@/.local/bin/kawa-sketch %f
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=draw;drawing;sketch;paint;pen;tablet;doodle;firealpaca;illustration;
StartupWMClass=FireAlpaca
