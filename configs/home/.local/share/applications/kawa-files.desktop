[Desktop Entry]
# Folders open in yazi, in a terminal window of its own (the default for inode/directory in
# ~/.config/mimeapps.list). yazi's own entry asks for a terminal (Terminal=true), which
# xdg-open does not provide on this desktop; this one starts the terminal itself. (`--`: a
# folder named like -V is opened, never read as an option) Its icon: our seal of 箱
# (the launcher draws it: X-Fedokawaii-Kanji).
Type=Application
Name=Files
GenericName=File manager
Comment=yazi, the terminal file manager
X-Fedokawaii-Kanji=箱
Exec=@HOME@/.local/bin/kawa-term yazi -- %f
Terminal=false
MimeType=inode/directory;
Categories=System;FileTools;FileManager;
Keywords=yazi;files;folder;explorer;
