[Desktop Entry]
# The calculator: kawa-calc, a panel of the session's (as the launcher hangs) — the answer as you
# type ("15% of 2400", "120 usd to aed", "5 ft to cm"), Enter copies it; qalc works every answer
# out, and Ctrl+Q there is qalc's own prompt (its every command) in a window of its own.
# Its icon: our pixel calc (the launcher draws it: X-Fedokawaii-Icon).
Type=Application
Name=Calculator
GenericName=Calculator and unit converter
Comment=qalc: sums, percentages, units and currencies — the answer as you type
X-Fedokawaii-Icon=calc
Exec=@HOME@/.local/bin/kawa-calc
Terminal=false
Categories=Utility;Calculator;
Keywords=qalc;qalculate;calc;math;convert;units;currency;percent;
