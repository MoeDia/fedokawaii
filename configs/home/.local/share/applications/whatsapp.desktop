[Desktop Entry]
# WhatsApp: WhatsApp Web (web.whatsapp.com) in a window of its own — Brave's app window: no
# tabs, no address bar, tiled like every other window, through ~/.local/bin/brave-origin as
# all of Brave is. Linked to your phone once (scan the code in WhatsApp → Linked devices);
# Brave keeps the link. Its notices come through Brave, as the desktop's other notices do.
# Its icon: our seal of 話 (tools/build-appicons.py, the theme's own: current/apps).
Type=Application
Name=WhatsApp
GenericName=Messenger
Comment=WhatsApp Web, in a window of its own
Icon=@HOME@/.config/fedokawaii/current/apps/whatsapp.png
Exec=@HOME@/.local/bin/brave-origin --app=https://web.whatsapp.com
Terminal=false
Categories=Network;InstantMessaging;Chat;
Keywords=whatsapp;chat;messages;messenger;
