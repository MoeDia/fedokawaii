[Desktop Entry]
# Your books (kawa-books), as Super+R opens them: every PDF, EPUB and comic in ~/Books, the
# ones you are reading first, opened in zathura where you left off. Its icon: our seal of 本
# (tools/build-appicons.py, the theme's own: current/apps).
Type=Application
Name=Books
GenericName=Book reader
Comment=PDFs, EPUBs and comics in ~/Books, the ones you are reading first
Icon=@HOME@/.config/fedokawaii/current/apps/books.png
Exec=@HOME@/.local/bin/kawa-books
Terminal=false
Categories=Office;Viewer;
Keywords=books;pdf;epub;comics;reader;ebook;zathura;library;
