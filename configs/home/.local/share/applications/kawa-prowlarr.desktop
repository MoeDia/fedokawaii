[Desktop Entry]
# Prowlarr's web page (its indexers, its login): kawa-prowlarr wakes Prowlarr if it is
# asleep, opens the page once it answers, and lets it sleep again 30 minutes later. Its
# icon: our seal of 索 (tools/build-appicons.py, the theme's own: current/apps).
Type=Application
Name=Prowlarr
GenericName=Torrent indexers
Comment=The sites torrra searches through
Icon=@HOME@/.config/fedokawaii/current/apps/prowlarr.png
Exec=@HOME@/.local/bin/kawa-prowlarr
Terminal=false
Categories=Network;P2P;
Keywords=prowlarr;indexers;torrents;torrra;
