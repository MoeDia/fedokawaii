[Desktop Entry]
# Prowlarr's web page (its indexers, its login): kawa-prowlarr wakes Prowlarr if it is
# asleep, opens the page once it answers, and lets it sleep again 30 minutes later.
Type=Application
Name=Prowlarr
GenericName=Torrent indexers
Comment=The sites torrra searches through
Icon=applications-internet
Exec=@HOME@/.local/bin/kawa-prowlarr
Terminal=false
Categories=Network;P2P;
Keywords=prowlarr;indexers;torrents;torrra;
