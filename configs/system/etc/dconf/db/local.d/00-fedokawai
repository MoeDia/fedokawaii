# /etc/dconf/db/local.d/00-fedokawai — system defaults read by GTK 3/4, libadwaita
# and xdg-desktop-portal-gtk (→ Brave's dark mode). Compiled by `dconf update`.
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Fedokawai-dark'
icon-theme='Papirus-Dark'
cursor-theme='Fedokawai'
cursor-size=24
font-name='Noto Sans 10.5'
document-font-name='Liberation Serif 11'
monospace-font-name='JetBrainsMono Nerd Font 11'
font-antialiasing='rgba'
font-hinting='slight'

# no window buttons anywhere — dwl tiles and closes windows (Super+Q), so title bars
# (GTK headers, Brave's tab strip) carry none: ':' is "nothing left, nothing right"
[org/gnome/desktop/wm/preferences]
button-layout=':'
