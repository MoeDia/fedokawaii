class Held(Exception):
    """the end of a case with no fix: CLASS for the bench and the report, a plain line for him"""
    def __init__(self, cls, reason):
        super().__init__(reason)
        self.cls, self.reason = cls, reason


class ModelError(Exception):
    pass


# ── the card ────────────────────────────────────────────────────────────────────────────────────
def sysfs_cards(base="/sys/class/drm"):
    """every card with its own memory: (path, pci ids, total, used, its driver)"""
    base = os.environ.get("KAWA_FIXER_SYSFS", base)
    out = []
    for c in sorted(glob.glob(f"{base}/card[0-9]*")):
        if not re.fullmatch(r"card\d+", os.path.basename(c)):
            continue
        d = f"{c}/device"
        try:
            total = int(open(f"{d}/mem_info_vram_total").read())
            used = int(open(f"{d}/mem_info_vram_used").read())
            vid = open(f"{d}/vendor").read().strip().removeprefix("0x")
            did = open(f"{d}/device").read().strip().removeprefix("0x")
        except (OSError, ValueError):
            continue
        out.append({"path": c, "ids": f"{vid}:{did}", "total": total, "used": used,
                    "driver": os.path.basename(os.path.realpath(f"{d}/driver"))})
    return out


def the_card():
    """the card the model runs on: the one with the most memory of its own, 12 GiB or more"""
    cards = [c for c in sysfs_cards() if c["total"] >= 12 << 30]
    return max(cards, key=lambda c: c["total"]) if cards else None


# ── where it lives (~/.local, the desktop user's) ───────────────────────────────────────────────
def paths(home):
    rt = f"{home}/.local/lib/fedokawaii/llama-{RUNTIME['tag']}"
    return {"rt": rt, "server": f"{rt}/llama-server", "models": f"{home}/.local/share/fedokawaii/models",
            "model": f"{home}/.local/share/fedokawaii/models/{MODEL['file']}"}


def sha256_file(path):
    """the hash, leaving the page cache as it was: a model read whole must not push his apps out of RAM"""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        fd, done = f.fileno(), 0
        while True:
            b = f.read(1 << 24)
            if not b:
                break
            h.update(b)
            done += len(b)
            if done % (1 << 28) == 0:
                os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
    return h.hexdigest()


def missing(home, full=False):
    """what keeps the fixer from running, in plain words ("" = ready)"""
    p = paths(home)
    if not the_card():
        return "no graphics card with 12 GB of its own"
    if not os.access(p["server"], os.X_OK):
        return "its runtime is not installed"
    if not os.path.isfile(p["model"]) or os.path.getsize(p["model"]) != MODEL["size"]:
        return "its model is not installed"
    if full and sha256_file(p["model"]) != MODEL["sha"]:
        return "its model file is damaged (its checksum differs)"
    return ""


def fetch(url, sha, dest):
    """url → dest, resumed if cut, its checksum proven; a wrong file is removed"""
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part"
    subprocess.run(["curl", "-fsSL", "-C", "-", "--retry", "5", "--retry-delay", "5", "-o", part, url], check=True)
    if sha256_file(part) != sha:
        os.unlink(part)
        raise RuntimeError(f"{os.path.basename(dest)}: its checksum differs from the pin")
    os.replace(part, dest)


def install(home):
    if not the_card():
        print("the fixer: no graphics card with 12 GB of its own here, nothing installed")
        return 0
    p = paths(home)
    if not os.access(p["server"], os.X_OK):
        with tempfile.TemporaryDirectory(prefix="kawa-fixer.") as tmp:
            tar = f"{tmp}/rt.tar.gz"
            fetch(RUNTIME["url"], RUNTIME["sha"], tar)
            # (only the server and its libraries: the release's fifty other tools are no one's here)
            names = subprocess.run(["tar", "-tzf", tar], check=True, capture_output=True, text=True).stdout.split("\n")
            want = [n for n in names if re.search(r"/(llama-server|LICENSE.*|lib[^/]*\.so[.0-9]*)$", n)]
            subprocess.run(["tar", "-xzf", tar, "-C", tmp, "--strip-components=1", *want], check=True)
            os.unlink(tar)
            shutil.rmtree(p["rt"], ignore_errors=True)
            os.makedirs(os.path.dirname(p["rt"]), exist_ok=True)
            shutil.copytree(tmp, p["rt"], symlinks=True)
        # (older runtimes go: one tool per job)
        for old in glob.glob(os.path.join(os.path.dirname(p["rt"]), "llama-*")):
            if old != p["rt"]:
                shutil.rmtree(old, ignore_errors=True)
    os.makedirs(p["models"], exist_ok=True)
    # (a backup leaves it out: restic --exclude-caches; it comes back with the next install)
    with open(f"{p['models']}/CACHEDIR.TAG", "w") as f:
        f.write("Signature: 8a477f597d28d172789f06886806bc55\n# the fixer's model: downloaded again by the installer\n")
    if not os.path.isfile(p["model"]) or sha256_file(p["model"]) != MODEL["sha"]:
        fetch(MODEL["url"], MODEL["sha"], p["model"])
    for old in glob.glob(f"{p['models']}/*.gguf"):
        if old != p["model"]:
            os.unlink(old)
    print(f"the fixer: {MODEL['file']} on llama.cpp {RUNTIME['tag']}")
    return 0


# ── the model's server: a child that cannot outlive this program and has no network ─────────────
class Server:
    def __init__(self, home, user=None, log=None, model=None, extra=None, ctx=None):
        self.home, self.user, self.log = home, user, log
        self.model = model or paths(home)["model"]
        self.extra = extra if extra is not None else MODEL["server"]
        self.ctx = ctx or MODEL["ctx"]
        self.proc, self.tmp, self.sock = None, None, None

    def argv(self, card):
        rt = paths(self.home)["rt"]
        drop = ["setpriv"]
        if os.geteuid() == 0:
            pw = self.user or os.path.basename(self.home)
            drop += [f"--reuid={pw}", f"--regid={pw}", "--init-groups"]
        drop += ["--pdeathsig", "KILL", "--"]
        return [*drop, "unshare", "--user", "--map-current-user", "--net", "--kill-child=KILL", "--",
                "nice", "-n", "15", "ionice", "-c3", f"{rt}/llama-server",
                "--host", self.sock, "--model", self.model, "--device", "Vulkan0", "-ngl", "all", "--fit", "off",
                "-c", str(self.ctx), "-np", "1", "-t", "4", "--poll", "0", "--prio", "-1", "--no-ui", "--no-warmup",
                "--cache-ram", "0", "--jinja", *self.extra]

    def start(self, need_mib=None):
        card = the_card()
        if not card:
            raise Held("no-card", "no graphics card with 12 GB of its own")
        if card["driver"] == "vfio-pci":
            raise Held("card-busy", "the card is passed to a virtual machine")
        free = (card["total"] - card["used"]) >> 20
        need = MODEL["vram_mib"] if need_mib is None else need_mib
        if free < need:
            raise Held("card-busy", f"the card has {free} MiB free and the model needs {need}: other programs hold it")
        base = "/run/fedokawaii" if os.geteuid() == 0 else os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir())
        os.makedirs(base, exist_ok=True)
        self.tmp = tempfile.mkdtemp(prefix="fixer.", dir=base)
        if os.geteuid() == 0:
            shutil.chown(self.tmp, self.user or os.path.basename(self.home), None)
        self.sock = f"{self.tmp}/server.sock"
        env = {"PATH": "/usr/bin:/bin", "HOME": self.home, "LD_LIBRARY_PATH": paths(self.home)["rt"],
               # (Mesa's own device-select layer: this card alone is Vulkan0, whatever the order)
               "MESA_VK_DEVICE_SELECT": card["ids"] + "!", "LANG": "C.UTF-8"}
        log = open(self.log, "ab") if self.log else subprocess.DEVNULL
        self.proc = subprocess.Popen(self.argv(card), env=env, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                     start_new_session=True)
        end = time.time() + LOAD_S
        while time.time() < end:
            if self.proc.poll() is not None:
                raise Held("runtime", f"the model's runtime stopped while loading (exit {self.proc.returncode})")
            if os.path.exists(self.sock) and health(self.sock):
                return self.sock
            time.sleep(0.5)
        raise Held("runtime", f"the model did not load in {LOAD_S} s")

    def stop(self):
        if self.proc:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
            except ProcessLookupError:
                pass
            try:
                self.proc.wait(10)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(self.proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                self.proc.wait()
            self.proc = None
        if self.tmp:
            shutil.rmtree(self.tmp, ignore_errors=True)
            self.tmp = None
        # (the file's pages out of RAM again: nothing held outside a run)
        try:
            fd = os.open(self.model, os.O_RDONLY)
            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
            os.close(fd)
        except OSError:
            pass


class UnixHTTP(http.client.HTTPConnection):
    def __init__(self, path, timeout):
        super().__init__("fixer", timeout=timeout)
        self.path = path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self.path)
        self.sock = s


def health(sock):
    try:
        c = UnixHTTP(sock, 3)
        c.request("GET", "/health")
        ok = c.getresponse().status == 200
        c.close()
        return ok
    except OSError:
        return False
    except http.client.HTTPException:
        return False


def ask(sock, system, user, schema, seed, deadline, request=None, stall=STALL_S):
    """the model's one answer, streamed so a hang shows: (the JSON's text, tokens, seconds, thinking's tokens)"""
    body = {"messages": [{"role": "system", "content": system}, {"role": "user", "content": user}],
            "stream": True, "seed": seed, "max_tokens": MAX_TOKENS, "cache_prompt": True,
            "response_format": {"type": "json_schema", "json_schema": {"name": "fix", "strict": True, "schema": schema}},
            **MODEL["request"], **(request or {})}
    t0 = time.time()
    text, think, usage = [], 0, {}
    if t0 > deadline:
        raise Held("budget", "the time for this fix ran out")
    try:
        c = UnixHTTP(sock, stall)
        c.request("POST", "/v1/chat/completions", json.dumps(body), {"Content-Type": "application/json"})
        r = c.getresponse()
        if r.status != 200:
            raise ModelError(f"the server answered {r.status}: {r.read(300).decode('utf8', 'replace')}")
        for raw in r:
            if time.time() > deadline:
                raise Held("budget", "the time for this fix ran out")
            line = raw.decode("utf8", "replace").strip()
            if not line.startswith("data: ") or line == "data: [DONE]":
                continue
            d = json.loads(line[6:])
            if d.get("error"):
                raise ModelError(str(d["error"])[:300])
            usage = d.get("timings") or usage
            for ch in d.get("choices") or []:
                delta = ch.get("delta") or {}
                if delta.get("reasoning_content"):
                    think += 1
                if delta.get("content"):
                    text.append(delta["content"])
        c.close()
    except (OSError, http.client.HTTPException, json.JSONDecodeError) as e:
        raise ModelError(f"the server stopped answering: {e}") from e
    return "".join(text), {"secs": round(time.time() - t0, 1), "think": think, "prompt_n": usage.get("prompt_n"),
                           "predicted_n": usage.get("predicted_n"), "predicted_per_s": usage.get("predicted_per_second")}


# ── a case's files and docs ─────────────────────────────────────────────────────────────────────
class Place:
    """the two systems: where the candidate's files lie, and the old ones"""
    def __init__(self, case):
        self.root = case.get("root", "/").rstrip("/") or ""
        self.old = case.get("old_root", "/").rstrip("/") or ""
        self.home = case["home"].rstrip("/")
        self.home_in = case.get("home_in", case["home"]).rstrip("/")

    def real(self, shown):
        """a file as the case names it (~/x or /etc/x) → as this program reaches it"""
        if shown.startswith("~/"):
            return f"{self.home}/{shown[2:]}"
        return f"{self.root}{shown}"

    def shown(self, real):
        if real.startswith(self.home + "/"):
            return "~/" + real[len(self.home) + 1:]
        return real[len(self.root):] if self.root and real.startswith(self.root + "/") else real


def files_of(prog, place):
    out = []
    for pat in prog["files"]:
        if any(ch in pat for ch in "*?["):
            out += sorted(f for f in glob.glob(place.real(pat), recursive=True) if os.path.isfile(f))
        elif os.path.isfile(place.real(pat)):
            out.append(place.real(pat))
    seen, keep = set(), []
    for f in out:
        if f not in seen and not NEVER.search(f):
            seen.add(f)
            keep.append(f)
    return keep


def read_text(path, limit=4 << 20):
    try:
        with open(path, "rb") as f:
            b = f.read(limit)
    except OSError:
        return ""
    if path.endswith(".gz"):
        try:
            b = gzip.decompress(b)
        except OSError:
            return ""
    return b.decode("utf8", "replace")


def man_text(root, name):
    """a man page as text: rendered by man itself from that system's file"""
    for base in (f"{root}/usr/share/man/{name}.gz", f"{root}/usr/share/man/{name}", f"{root}/usr/local/share/man/{name}.gz"):
        if os.path.isfile(base):
            r = subprocess.run(["man", "-l", base], capture_output=True, env={"PATH": "/usr/bin:/bin", "MANWIDTH": "100",
                               "MANPAGER": "cat", "LANG": "C.UTF-8", "GROFF_NO_SGR": "1"}, timeout=30)
            return re.sub(r".\x08", "", r.stdout.decode("utf8", "replace"))
    return ""


def docs_of(prog, place):
    """{name: (old text, new text)} — the new version's docs, its defaults and its news, and the old beside them"""
    out = {}
    for n in prog.get("man", []):
        out[f"man {os.path.basename(n)}"] = (man_text(place.old, n), man_text(place.root, n))
    for key in ("defaults", "docs", "news"):
        for f in prog.get(key, []):
            out[f] = (read_text(place.old + f), read_text(place.root + f))
    return {k: v for k, v in out.items() if v[1]}


STOP = set("the a an and or not of to in on at for from is it its this that with as by be was are but no yes valid option "
           "error err warn warning config file line failed parse could does take home usr local share etc caused toml "
           "chunk stack traceback function string core unknown invalid missing field setting".split())


def refused_names(out):
    """the names a complaint is about, the way programs mark them: quoted, [section].key, option X, a hyphened word"""
    s = re.sub(r"(?:~|\.{0,2}/)[\w.@%+~/-]+(?::\d+)*", " ", out)    # (its paths)
    s = re.sub(r"\b[\w-]+\.(?:c|cc|cpp|rs|lua|py):\d+", " ", s)     # (the program's own source lines)
    names = []
    for pat in (r"'([^'\s=]+)(?:=[^']*)?'", r"`([^`\s]+)`", r"\[([\w:-]+)\]\.([\w.-]+)", r"\boption:?\s+([\w.-]+)",
                r"\bfield\s+`?([\w.-]+)", r"\bproperty\s+'?([-\w]+)"):
        for m in re.findall(pat, s):
            names += [m] if isinstance(m, str) else list(m)
    names += re.findall(r"[A-Za-z_][\w.-]*[-_.][\w.-]*[A-Za-z0-9_]", s)
    seen, out_names = set(), []
    for n in names:
        n = n.strip(".-:;,")
        if len(n) > 2 and n.lower() not in STOP and n not in seen and not n.startswith(("config.", "vim/_core")):
            seen.add(n)
            out_names.append(n)
    return out_names


def tokens(text):
    """the words of a text, for the rule that a kept value appears somewhere"""
    return set(re.findall(r"[A-Za-z_][A-Za-z0-9_.-]{2,}", text))


def trim(text, cap):
    """at most CAP characters, cut at a line"""
    if len(text) <= cap:
        return text
    return text[:cap].rsplit("\n", 1)[0] + "\n[the rest is left out]"


def neighbours(names, corpus):
    """the documented names closest to a refused one: a rename usually keeps most of its letters"""
    known = set(re.findall(r"(?<![\w])(?<!\w-)[a-z][a-z0-9]*(?:[-_.][a-z0-9]+)+(?![\w-])", corpus))
    out = []
    for w in names:
        for n in difflib.get_close_matches(w, known, n=5, cutoff=0.6):
            if n not in out and n not in names:
                out.append(n)
    return out


def excerpts(text, names, near, cap, before=2, after=3):
    """the lines around each mention of a name, the exact ones first, in the text's own order, within CAP"""
    lines = text.splitlines()
    word = lambda ws: re.compile("|".join(rf"(?<![\w])(?<!\w-){re.escape(w)}(?![\w-])" for w in ws)) if ws else None
    exact, close = word(names), word(near)
    spans = []
    for i, line in enumerate(lines):
        if exact and exact.search(line):
            spans.append((0, i))
        elif close and close.search(line):
            spans.append((1, i))
    keep, size = set(), 0
    for _, i in sorted(spans):
        new = [j for j in range(max(0, i - before), min(len(lines), i + after + 1)) if j not in keep]
        cost = sum(len(lines[j]) + 1 for j in new)
        if size + cost > cap:
            continue
        keep.update(new)
        size += cost
    out, last = [], None
    for j in sorted(keep):
        if last is not None and j != last + 1:
            out.append("[lines left out]")
        out.append(lines[j])
        last = j
    return "\n".join(out)


def docs_diff(old, new, names, near, cap):
    """what changed between the two versions' text: the hunks that touch the names, else the first"""
    if not old or old == new:
        return ""
    d = list(difflib.unified_diff(old.splitlines(), new.splitlines(), lineterm="", n=1))[2:]
    hunks, cur = [], []
    for line in d:
        if line.startswith("@@") and cur:
            hunks.append(cur)
            cur = []
        cur.append(line)
    if cur:
        hunks.append(cur)
    hit = [h for h in hunks if any(n in x for x in h for n in [*names, *near])]
    return trim("\n".join(x for h in (hit or hunks[:3]) for x in h), cap)


def binary_words(prog, place):
    """the program's own bytes: a key it does not contain it cannot accept (no docs needed: B6 #11)"""
    b = prog.get("binary")
    if not b:
        return b""
    b = b.replace("{home}", place.home)
    path = place.home + b[len(place.home):] if b.startswith(place.home) else place.root + b
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        return b""


def pack(prog, place, check_out, target_files, feedback=""):
    """the user's message: the failure, the file, what changed — every piece of it quoted as data"""
    docs = docs_of(prog, place)
    names = refused_names(check_out)
    near = neighbours(names, "\n".join(v[1] for v in docs.values()))
    parts = [f"<data name=\"the program's own check says\">\n{trim(check_out, EVIDENCE['check'])}\n</data>"]
    # (each file as it stands, its comment lines left out: what an edit touches, and nothing to mislead)
    room = EVIDENCE["config"]
    for f in target_files:
        t = "\n".join(x for x in read_text(f).splitlines() if not is_comment(x, prog["kind"]) or x.strip() == "")
        t = re.sub(r"\n{3,}", "\n\n", t)
        if room <= 200:
            break
        if len(t) > room:
            t = window(t, check_out, names, room)
        room -= len(t)
        parts.append(f"<data name=\"file {place.shown(f)} (comment lines not shown)\">\n{t}\n</data>")
    if near:
        parts.append("The documented names closest to what was refused: " + ", ".join(near))
    diffs, dl = [], EVIDENCE["diff"]
    for name, (old, new) in docs.items():
        d = docs_diff(old, new, names, near, dl)
        if d:
            diffs.append(f"--- {name}\n{d}")
            dl -= len(d)
    if diffs:
        parts.append("<data name=\"what changed in the documentation between the two versions\">\n" + "\n".join(diffs) + "\n</data>")
    dd, news, dr = [], [], EVIDENCE["docs"]
    for name, (_, new) in docs.items():
        if name in prog.get("news", []):
            hits = excerpts(new, names, near, EVIDENCE["news"] // max(1, len(prog["news"])))
            if hits:
                news.append(f"--- {name}\n{hits}")
            continue
        hits = excerpts(new, names, near, dr, before=1, after=6)
        if hits:
            dd.append(f"--- {name}\n{hits}")
            dr -= len(hits)
    if news:
        parts.append("<data name=\"the new version's changelog, what mentions these names\">\n" + "\n".join(news) + "\n</data>")
    if dd:
        parts.append("<data name=\"the new version's documentation, what mentions these names\">\n" + "\n".join(dd) + "\n</data>")
    if feedback:
        parts.append(f"Your last answer was refused:\n{feedback}\nAnswer again, correcting that, or answer cannot_fix.")
    return "\n\n".join(parts)


def window(text, check_out, names, cap):
    """the part of a long file around what the complaint names"""
    lines = text.split("\n")
    at = [i for i, line in enumerate(lines) if any(n in line for n in names)][:8]
    keep = set()
    for i in at or [0]:
        keep.update(range(max(0, i - 15), min(len(lines), i + 15)))
    # (the section headers stay, so the file's shape is seen)
    keep.update(i for i, line in enumerate(lines) if line.startswith("["))
    out, last = [], -1
    for i in sorted(keep):
        if i != last + 1 and out:
            out.append("[lines left out]")
        out.append(lines[i])
        last = i
    return trim("\n".join(out), cap)


# ── the guard rails: what an answer must be before it is even tried ─────────────────────────────
def is_comment(line, kind):
    s = line.strip()
    return not s or s.startswith(COMMENT.get(kind, ("#",)))


def keys_in(line, kind):
    """the option names a line sets"""
    s = line.strip()
    if is_comment(s, kind):
        return []
    if kind == "ini" or kind == "toml":
        out = re.findall(r"^\[+\s*([^\]=\s]+)", s)
        out += re.findall(r"^([\w.-]+)\s*=", s)
        if kind == "toml":
            out += re.findall(r"[{,]\s*([\w-]+)\s*=", s)
        return out
    if kind == "jsonc":
        return re.findall(r'"([\w/#.-]+)"\s*:', s)
    if kind == "lua":
        return re.findall(r"\bvim\.(?:opt|o|go|bo|wo)\.(\w+)", s)
    return []   # (css: GTK's own parser is the key check, and it is strict)


def value_words(line, kind):
    s = line.strip()
    if kind in ("ini", "toml") and "=" in s:
        s = s.split("=", 1)[1]
    elif kind == "css" and ":" in s:
        s = s.split(":", 1)[1]
    return {w for w in re.findall(r"[^\s,;\"'{}\[\]()=]+", s)}


def apply_edit(text, e):
    return text.replace(e["search"], e["replace"], 1)


def moods_of(path):
    """a palette file has a brother in the other mood: an edit goes to both"""
    m = re.search(r"/themes/([^/]+)/", path)
    if not m:
        return [path]
    return sorted(glob.glob(path.replace(f"/themes/{m.group(1)}/", "/themes/*/"))) or [path]


def plan_edits(answer, allowed, place):
    """the answer as {real path: new text}, with the problems found → (plan, problems)"""
    problems, plan = [], {}
    shown = {place.shown(f): f for f in allowed}
    for e in answer.get("edits", []):
        name, search, replace = e.get("file", ""), e.get("search", ""), e.get("replace", "")
        if name not in shown or NEVER.search(name):
            problems.append(f"{name}: that file may not be edited; the files are: {', '.join(shown)}")
            continue
        if not search:
            problems.append(f"{name}: an edit with an empty search")
            continue
        if search == replace:
            problems.append(f"{name}: an edit that changes nothing")
            continue
        if re.search(r"[\x00-\x08\x0b-\x1f\x7f]", search + replace):
            problems.append(f"{name}: an edit with control characters")
            continue
        for f in moods_of(shown[name]):
            text = plan.get(f, read_text(f))
            n = text.count(search)
            if n != 1:
                problems.append(f"{place.shown(f)}: the search text occurs {n} times there, it must occur exactly once: {search[:120]!r}")
                continue
            plan[f] = apply_edit(text, e)
    return plan, problems


def validate(prog, plan, corpus, binary, check_out):
    """every rule an edit must pass (B6 #11–15): the problems found, in words the model can act on"""
    kind = prog["kind"]
    problems = []
    for f, new in plan.items():
        old = read_text(f)
        removed, added = [], []
        for line in difflib.ndiff(old.splitlines(), new.splitlines()):
            if line.startswith("- "):
                removed.append(line[2:])
            elif line.startswith("+ "):
                added.append(line[2:])
        if len(removed) + len(added) > MAX_LINES:
            problems.append(f"{os.path.basename(f)}: {len(removed) + len(added)} lines changed: a fix is smaller than {MAX_LINES}")
        real_add = [x for x in added if not is_comment(x, kind)]
        real_rem = [x for x in removed if not is_comment(x, kind)]
        carried = "\n".join(removed)
        # a key that exists nowhere in the new version's docs or bytes is invented
        known_before = set(k for x in old.splitlines() for k in keys_in(x, kind))
        for x in real_add:
            for k in keys_in(x, kind):
                if k in known_before:
                    continue
                if not (re.search(rf"(?<![\w])(?<!\w-){re.escape(k)}(?![\w-])", corpus) or k.encode() in binary):
                    problems.append(f"the option {k!r} does not appear in the new version's documentation")
        # commands, downloads, new paths: only a line that said them already may carry them
        for x in real_add:
            for m in SHELLY.finditer(x):
                w = m.group(0)
                if w not in carried and not (kind in ("ini", "toml") and re.match(rf"\s*{re.escape(w)}\s*=", x) and w in old):
                    problems.append(f"{w!r} may not be brought in by a fix: {x.strip()[:100]}")
            for m in PATHY.finditer(x):
                p = m.group(1)
                if p not in old and len(p) > 1:
                    problems.append(f"the path {p!r} may not be brought in by a fix")
        # a deletion is not a fix — unless the new version's own news says the option went
        if real_rem and not real_add:
            for x in real_rem:
                ks = keys_in(x, kind) or sorted(value_words(x, kind))[:1]
                said = any(re.search(rf"\b(removed|dropped|deleted|no longer|obsolete)\b", line, re.I) and k in line
                           for k in ks for line in corpus.splitlines())
                if not said:
                    problems.append(f"deleting {x.strip()[:80]!r} only silences the check; nothing in the new version's documentation says it was removed")
        # a renamed setting keeps what it said
        if real_rem and real_add:
            was = set().union(*(value_words(x, kind) for x in real_rem))
            now = set().union(*(value_words(x, kind) for x in real_add))
            if was and not (was & now) and not any(re.search(rf"(?<![\w-]){re.escape(w)}(?![\w-])", corpus) for w in now):
                problems.append("the new text keeps none of the old value, and the documentation does not show the new one")
    return problems


def write_keep(path, text):
    """FILE's new text, whole or not at all; its owner, mode and SELinux label kept"""
    st = os.stat(path)
    tmp = f"{path}.fixer.{os.getpid()}"
    with open(tmp, "w", encoding="utf8") as f:
        f.write(text)
    os.chmod(tmp, st.st_mode & 0o7777)
    try:
        os.chown(tmp, st.st_uid, st.st_gid)
    except PermissionError:
        pass
    try:
        os.setxattr(tmp, "security.selinux", os.getxattr(path, "security.selinux"))
    except OSError:
        pass
    os.replace(tmp, path)


# ── the check: the program's own, in the candidate ──────────────────────────────────────────────
def own_check(prog, case, place):
    """→ (red?, what it said). Its status, or its words where its status says nothing"""
    argv = [a.replace("{home}", place.home_in).replace("{root}", case.get("root_in", "")) for a in prog["check"]]
    try:
        r = subprocess.run([*case["runner"], *argv], capture_output=True, timeout=120, stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return True, "its check did not end in 2 minutes"
    out = (r.stdout + b"\n" + r.stderr).decode("utf8", "replace").strip()
    out = re.sub(r"\x1b\[[0-9;?]*[a-zA-Z]", "", out)
    red = prog.get("red")
    return (bool(re.search(red, out)) if red else r.returncode != 0), out


def implicated(case):
    """which of our programs this failure names: by the checks' words, then by the held packages"""
    why = "\n".join(case.get("why", []))
    names = {p["name"] for p in case.get("packages", [])}
    hits = [n for n, p in PROGRAMS.items() if re.search(p["says"], why, re.I)]
    if not hits:
        hits = [n for n, p in PROGRAMS.items() if names & set(p["packages"])]
    return hits


def fix_one(name, case, place, sock, seed0, report, logdir):
    """one program red: the model, the rails, the check, at most TRIES wrong answers"""
    prog = PROGRAMS[name]
    allowed = files_of(prog, place)
    if not allowed:
        raise Held("no-file", f"{name}: none of its config files is here")
    corpus_docs = docs_of(prog, place)
    corpus = "\n".join(v[1] for v in corpus_docs.values())
    binary = binary_words(prog, place)
    red, out = own_check(prog, case, place)
    if not red:
        return False
    schema = {"type": "object", "additionalProperties": False, "required": ["verdict", "reason", "edits"],
              "properties": {"verdict": {"enum": ["fix", "cannot_fix"]}, "reason": {"type": "string", "maxLength": 240},
                             "edits": {"type": "array", "maxItems": 6, "items": {
                                 "type": "object", "additionalProperties": False, "required": ["file", "search", "replace"],
                                 "properties": {"file": {"enum": [place.shown(f) for f in allowed]},
                                                "search": {"type": "string"}, "replace": {"type": "string"}}}}}}
    wrong, rounds, feedback = 0, 0, ""
    deadline = case["_deadline"]
    while True:
        rounds += 1
        if rounds > ROUNDS:
            raise Held("rounds", f"{name}: still red after {ROUNDS} edits: {first_line(out)}")
        # (the file the complaint names first)
        targets = sorted(allowed, key=lambda f: (place.shown(f) not in out and f not in out, f))
        msg = pack(prog, place, out, targets, feedback)
        pk = [f"{p['name']} {p.get('old', '?')} → {p.get('new', '?')}" for p in case.get("packages", [])]
        user = f"Updated: {', '.join(pk) or name}.\nThe program at fault: {name}.\n\n{msg}"
        try:
            text, stats = ask(sock, SYSTEM, user, schema, seed0 + wrong, deadline, case.get("request"), case.get("stall_s", STALL_S))
        except ModelError as e:
            raise Held("runtime", f"the model stopped: {e}") from e
        report["tries"] += 1
        report["runs"].append(stats)
        if logdir:
            with open(f"{logdir}/try-{report['tries']}.txt", "w") as f:
                f.write(f"=== SYSTEM\n{SYSTEM}\n=== USER\n{user}\n=== ANSWER\n{text}\n=== STATS\n{json.dumps(stats)}\n")
        try:
            answer = json.loads(text)
        except json.JSONDecodeError:
            answer = None
        if not isinstance(answer, dict):
            problems = ["the answer was not the JSON asked for"]
        elif answer.get("verdict") == "cannot_fix":
            raise Held("refused", f"{name}: {answer.get('reason') or 'the model sees no safe fix'}")
        elif not answer.get("edits"):
            problems = ["verdict fix with no edits"]
        else:
            plan, problems = plan_edits(answer, allowed, place)
            problems += validate(prog, plan, corpus, binary, out) if plan else []
        if not problems:
            backup = {f: read_text(f) for f in plan}
            for f, t in plan.items():
                write_keep(f, t)
            still, newout = own_check(prog, case, place)
            if not still:
                # (a palette's brother: the other mood must pass too)
                bad = check_moods(prog, case, place, plan)
                if bad:
                    still, newout = True, bad
            if not still or moved_on(out, newout, answer["edits"]):
                report["edits"] += [dict(e) for e in answer["edits"]]
                report["reasons"].append(answer.get("reason", ""))
                report["files"] = sorted(set(report["files"]) | {place.shown(f) for f in plan})
                if not still:
                    return True
                out, feedback = newout, ""
                continue
            for f, t in backup.items():
                write_keep(f, t)
            problems = [f"the program still refuses it, it says: {trim(newout, 800)}"]
        wrong += 1
        report["refused"].append(problems[:4])
        if wrong >= TRIES:
            raise Held("wrong", f"{name}: no fix in {TRIES} tries: {first_line(problems[0])}")
        feedback = "\n".join(f"- {p}" for p in problems[:6])


def check_moods(prog, case, place, plan):
    """an edit of a palette file: the check with the other mood's files current (on the copy, put back)"""
    cur = f"{place.home}/.config/fedokawaii/current"
    if not any("/themes/" in f for f in plan) or not os.path.islink(cur):
        return ""
    was = os.readlink(cur)
    themes = sorted(os.path.basename(d) for d in glob.glob(f"{place.home}/.config/fedokawaii/themes/*"))
    try:
        for t in themes:
            os.unlink(cur)
            os.symlink(f"themes/{t}", cur)
            red, out = own_check(prog, case, place)
            if red:
                return f"with the {t} theme: {out}"
    finally:
        if os.path.lexists(cur):
            os.unlink(cur)
        os.symlink(was, cur)
    return ""


def moved_on(before, after, edits):
    """the complaint it was made for is gone, another took its place (a program stops at its first) —
    one about what the answer itself wrote is no progress"""
    a, b = set(refused_names(before)), set(refused_names(after))
    wrote = "\n".join(e.get("replace", "") for e in edits)
    return bool(after.strip()) and bool(a - b) and not any(n in wrote for n in b)


def first_line(s):
    for line in str(s).splitlines():
        if line.strip():
            return line.strip()[:200]
    return ""


def run_case(case, sock, out_path, logdir, server_args):
    """the whole of one failure → the report (also at OUT.json)"""
    t0 = time.time()
    report = {"verdict": "held", "class": "", "reason": "", "programs": [], "edits": [], "files": [], "reasons": [],
              "refused": [], "tries": 0, "runs": [], "secs": 0, "model": MODEL["file"], "packages": case.get("packages", [])}
    case["_deadline"] = t0 + float(case.get("budget_s", 1500))
    place = Place(case)
    server = None
    backups = {}
    lock = None
    try:
        why = "\n".join(case.get("why", []))
        names = implicated(case)
        if not names or (NOT_CONFIG.search(why) and not any(re.search(PROGRAMS[n]["says"], why, re.I) for n in names)):
            raise Held("not-config", f"not a config of ours: {first_line(why) or 'no failure named'}")
        reds = []
        for n in names:
            if own_check(PROGRAMS[n], case, place)[0]:
                reds.append(n)
        report["programs"] = reds
        if not reds:
            raise Held("green", f"{', '.join(names)}: its own check finds nothing wrong with its config")
        lock = open(os.path.join(os.environ.get("XDG_RUNTIME_DIR", tempfile.gettempdir()), "kawa-fixer.lock"), "w")
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not sock:
            gone = missing(case.get("user_home", place.home), full=True)
            if gone:
                raise Held("absent", f"the fixer cannot run: {gone}")
            server = Server(case.get("user_home", place.home), case.get("user"), f"{logdir}/server.log" if logdir else None,
                            extra=server_args)
            sock = server.start()
        for n in reds:
            for f in files_of(PROGRAMS[n], place):
                for g in moods_of(f):
                    backups.setdefault(g, read_text(g))
        for i, n in enumerate(reds):
            fix_one(n, case, place, sock, int(case.get("seed", 1)) + 10 * i, report, logdir)
        report["verdict"], report["class"] = "fixed", "fixed"
        report["reason"] = "; ".join(r for r in report["reasons"] if r)[:400]
    except Held as h:
        report["class"], report["reason"] = h.cls, h.reason
        # (a half-way state is never left in the candidate: what was edited goes back)
        for f, t in backups.items():
            if read_text(f) != t:
                write_keep(f, t)
        report["edits"], report["files"] = [], []
    finally:
        if server:
            server.stop()
        if lock:
            lock.close()
        report["secs"] = round(time.time() - t0, 1)
        if out_path:
            with open(out_path, "w") as f:
                json.dump(report, f, indent=1, ensure_ascii=False)
    print(line_of(report))
    return 0 if report["verdict"] == "fixed" else 3


def line_of(r):
    """the report's one line"""
    if r["verdict"] == "fixed":
        files = ", ".join(os.path.basename(f) for f in r["files"])
        return f"fixed {files} in {r['tries']} {'try' if r['tries'] == 1 else 'tries'}, {r['secs']:.0f} s: {r['reason']}"
    return f"held: {r['reason']}"


# ── the kept fixes: a theme run writes the toolkit's configs again, these go back over them ─────
def keep(out_path, fixes):
    r = json.load(open(out_path))
    if r.get("verdict") != "fixed":
        print("nothing to keep: the report is not a fix", file=sys.stderr)
        return 2
    os.makedirs(fixes, exist_ok=True)
    name = time.strftime("%Y%m%d-%H%M%S") + "-" + "-".join(r.get("programs") or ["fix"]) + ".json"
    rec = {"date": time.strftime("%F %T"), "programs": r.get("programs"), "packages": r.get("packages"),
           "edits": r["edits"], "reason": r.get("reason", ""), "model": r.get("model")}
    with open(f"{fixes}/{name}", "w") as f:
        json.dump(rec, f, indent=1, ensure_ascii=False)
    print(f"kept: {name}")
    return 0


def reapply(fixes, home, root):
    """each kept edit again: in place already, fine; its old text gone (the toolkit has caught up), it is dropped"""
    place = Place({"home": home, "root": root, "old_root": root})
    done, dropped = 0, 0
    for rec in sorted(glob.glob(f"{fixes}/*.json")):
        try:
            data = json.load(open(rec))
        except (OSError, ValueError):
            print(f"{os.path.basename(rec)}: unreadable, dropped")
            os.unlink(rec)
            continue
        alive = False
        for e in data.get("edits", []):
            for f in moods_of(place.real(e["file"])):
                if NEVER.search(f) or not os.path.isfile(f):
                    continue
                text = read_text(f)
                if e["replace"] and e["replace"] in text:
                    alive = True
                elif text.count(e["search"]) == 1:
                    write_keep(f, apply_edit(text, e))
                    alive = True
        if alive:
            done += 1
        else:
            os.unlink(rec)
            dropped += 1
            print(f"{os.path.basename(rec)}: its old text is gone (the toolkit has caught up), dropped")
    print(f"kept fixes: {done} in place, {dropped} dropped")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="kawa-fixer", add_help=True)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("run")
    p.add_argument("case")
    p.add_argument("--out")
    p.add_argument("--sock")
    p.add_argument("--log")
    p = sub.add_parser("keep")
    p.add_argument("out")
    p.add_argument("--fixes", required=True)
    p = sub.add_parser("reapply")
    p.add_argument("--fixes", required=True)
    p.add_argument("--home", required=True)
    p.add_argument("--root", default="/")
    p = sub.add_parser("serve")
    p.add_argument("--sock", required=True)
    p.add_argument("--model")
    p.add_argument("--ctx", type=int)
    p.add_argument("--log")
    p.add_argument("--home", default=os.path.expanduser("~"))
    p.add_argument("extra", nargs="*")
    p = sub.add_parser("status")
    p.add_argument("--full", action="store_true")
    p.add_argument("--home", default=os.path.expanduser("~"))
    p = sub.add_parser("install")
    p.add_argument("--home", default=os.path.expanduser("~"))
    a = ap.parse_args()
    if a.cmd == "run":
        if a.log:
            os.makedirs(a.log, exist_ok=True)
        try:
            case = json.load(open(a.case))
        except (OSError, ValueError) as e:
            print(f"the case could not be read: {e}", file=sys.stderr)
            return 2
        return run_case(case, a.sock, a.out, a.log, None)
    if a.cmd == "keep":
        return keep(a.out, a.fixes)
    if a.cmd == "reapply":
        return reapply(a.fixes, a.home, a.root)
    if a.cmd == "status":
        gone = missing(a.home, a.full)
        print(gone or f"ready: {MODEL['file']} on llama.cpp {RUNTIME['tag']}")
        return 3 if gone else 0
    if a.cmd == "install":
        return install(a.home)
    if a.cmd == "serve":
        s = Server(a.home, None, a.log, a.model, a.extra, a.ctx)
        signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
        try:
            s.start(0)
            shutil.rmtree(a.sock, ignore_errors=True)
            if os.path.lexists(a.sock):
                os.unlink(a.sock)
            os.symlink(s.sock, a.sock)
            s.proc.wait()
            return s.proc.returncode or 0
        except Held as h:
            print(h.reason, file=sys.stderr)
            return 3
        finally:
            s.stop()
            if os.path.lexists(a.sock):
                os.unlink(a.sock)
    return 2


if __name__ == "__main__":
    sys.exit(main())
