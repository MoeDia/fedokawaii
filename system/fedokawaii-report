# by design: left out)
find "$UH" -xdev -path "$UH/.local/share/containers" -prune -o -not -user "$U" -printf '%u\t%P\n' 2>/dev/null >"$TMP/notmine"
sub "files in your home not yours, by owner and folder (podman's storage left out)"
awk -F'\t' '{ n = split($2, p, "/"); k = p[1]; if (n > 2 && (k == ".cache" || k == ".local" || k == ".config")) k = k "/" p[2] (n > 3 && p[2] == "share" ? "/" p[3] : "")
