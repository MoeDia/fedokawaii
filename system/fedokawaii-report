# ════ 17. the clipboard ══════════════════════════════════════════════════════════════════
sec "17. the clipboard"
urun "the history's size (cliphist list | wc -l)" bash -c 'cliphist list | wc -l'
if ((SES)); then
  # live, as you: what is on the clipboard saved first; a text copied (wl-copy → wl-paste →
  # the history); a file list and a picture copied by a program that then quits (kawa-clipkeep
  # must keep every type: Super+Z reads exactly these); yazi's Ctrl+C (kawa-clipfiles). Then
  # every test entry taken out of the history — the put-back's own entry too — and what was
  # on the clipboard offered again
  asu bash -c '
    t="fk-report-$1"; d=$(mktemp -d); ty=$(wl-paste --list-types 2>/dev/null | head -n1)
    [ -n "$ty" ] && wl-paste --no-newline --type "$ty" >"$d/old" 2>/dev/null
    printf %s "$t" | setsid -f wl-copy; hop=paste
    for _ in $(seq 20); do [ "$(wl-paste --no-newline 2>/dev/null)" = "$t" ] && { hop=history; break; }; sleep 0.1; done
    if [ $hop = history ]; then
      for _ in $(seq 20); do cliphist list | grep -qF -- "$t" && { hop=ok; break; }; sleep 0.1; done
    fi
    echo "CLIP-03 round trip: $hop"
    # CLIP-04: a file list, its program gone
    printf "file:///etc/hostname\r\n" | wl-copy --type text/uri-list & p=$!; sleep 0.4; kill "$p" 2>/dev/null; pkill -u "$(id -u)" -f "^wl-copy --type text/uri-list" 2>/dev/null; sleep 0.4
    l=$(wl-paste --list-types 2>/dev/null | tr "\n" " "); echo "CLIP-04 types after its program quit: ${l:-none}"
    case " $l " in *" text/uri-list "*) echo "CLIP-04: kept" ;; *) echo "CLIP-04: LOST" ;; esac
    # CLIP-05: a picture
    if command -v magick >/dev/null; then
      magick -size 8x8 xc:red png:- 2>/dev/null | wl-copy --type image/png & p=$!; sleep 0.4; kill "$p" 2>/dev/null; pkill -u "$(id -u)" -f "^wl-copy --type image/png" 2>/dev/null; sleep 0.4
      l=$(wl-paste --list-types 2>/dev/null | tr "\n" " "); echo "CLIP-05 types: ${l:-none}"
      case " $l " in *" image/png "*) echo "CLIP-05: kept" ;; *) echo "CLIP-05: LOST" ;; esac
    fi
    # CLIP-06: yazi Ctrl+C
    kawa-clipfiles copy --quiet /etc/hostname >/dev/null 2>&1; sleep 0.4
    u=$(wl-paste --type text/uri-list 2>/dev/null | tr -d "\r"); echo "CLIP-06 kawa-clipfiles: ${u:-nothing}"
    case $u in *file:///etc/hostname*) echo "CLIP-06: ok" ;; *) echo "CLIP-06: NOTHING" ;; esac
    # the test entries out of the history, then what was there put back, and its new entry out
    cliphist list | grep -E -- "$t|file:///etc/hostname|binary data .* png .* 8x8" | cliphist delete 2>/dev/null
    if [ -n "$ty" ]; then setsid -f wl-copy --type "$ty" <"$d/old"; sleep 0.5; cliphist list | head -n 1 | cliphist delete 2>/dev/null
    else wl-copy --clear; fi
    rm -rf "$d"; echo "type before: ${ty:-(empty)}: put back"' _ "$$" >"$TMP/clip" 2>&1
  cap 30 <"$TMP/clip" >>"$BODY"
  case $(sed -n 's/^CLIP-03 round trip: //p' "$TMP/clip") in
    ok)      good "CLIP-03 a copy reaches the clipboard and Super+V's history (wl-copy → wl-paste → cliphist)" ;;
    history) fail "CLIP-03 a copy reaches the clipboard but not Super+V's history (wl-paste --watch kawa-clip --store → cliphist)" "send the report" ;;
    paste)   fail "CLIP-03 a copy never reaches the clipboard (wl-copy → wl-paste)" "send the report" ;;
    *)       fail "CLIP-03 the clipboard test did not run" "send the report"; detail <"$TMP/clip" ;;
  esac
  grep -q '^CLIP-04: LOST' "$TMP/clip" && fail "CLIP-04 a file list copied is lost when its program quits (kawa-clipkeep keeps only text?): Super+Z finds the clipboard empty" "send the report"
  grep -q '^CLIP-04: kept' "$TMP/clip" && good "CLIP-04 a file list outlives the program that copied it"
  grep -q '^CLIP-05: LOST' "$TMP/clip" && fail "CLIP-05 a picture copied is lost when its program quits: Super+Z finds the clipboard empty" "send the report"
  grep -q '^CLIP-05: kept' "$TMP/clip" && good "CLIP-05 a picture outlives the program that copied it"
  grep -q '^CLIP-06: NOTHING' "$TMP/clip" && fail "CLIP-06 yazi's Ctrl+C (kawa-clipfiles copy) puts nothing on the clipboard" "send the report"
  grep -q '^CLIP-06: ok' "$TMP/clip" && good "CLIP-06 yazi's Ctrl+C puts the file on the clipboard"
fi
sub "the copies the desktop made (~/.cache/kawa-clip.log, the last 40)"
tail -n 40 "$UH/.cache/kawa-clip.log" >>"$BODY" 2>/dev/null

