# ════ 13. the bar ════════════════════════════════════════════════════════════════════════
sec "13. the bar"
WB=$UH/.config/waybar/config.jsonc
# each custom module's exec, run once as the bar runs it (sh -c), timed
asu python3 -c '
import json, re, sys
t = open(sys.argv[1]).read()
out, q, i = [], False, 0
while i < len(t):
    c = t[i]
    if q:
        out.append(c)
        if c == "\\": out.append(t[i + 1]); i += 2; continue
        if c == "\"": q = False
    elif c == "\"": q = True; out.append(c)
    elif t.startswith("//", i): i = t.find("\n", i); i = len(t) if i < 0 else i; continue
    elif t.startswith("/*", i): i = t.find("*/", i) + 2; continue
    else: out.append(c)
    i += 1
conf = json.loads(re.sub(r",(\s*[}\]])", r"\1", "".join(out)))
for b in conf if isinstance(conf, list) else [conf]:
    for k, v in b.items():
        if isinstance(v, dict):
            # (no interval: the command runs for good, a line each time it has news)
            if "exec" in v: print(k + "\t" + ("" if "interval" in v else "~") + v["exec"].replace("\n", " "))
            if k.startswith("clock"): print(k + "\t#format " + str(v.get("format", "")) + " · interval " + str(v.get("interval", 60)))
' "$WB" >"$TMP/wbmods" 2>"$TMP/wberr"; wr=$?
if ((wr)); then fail "waybar's config does not parse ($WB)" "send the report (section 13)"; detail <"$TMP/wberr"
else
  good "waybar's config parses ($(grep -vc $'\t#' "$TMP/wbmods") modules run a command)"
  sub "each module's command, run once (as the bar runs it), timed"
  while IFS=$'\t' read -r mod ex; do
    if [[ $ex == '#'* ]]; then say "$(printf '%-20s %s' "$mod" "${ex#\#}")"; continue; fi
    if [[ $ex == '~'* ]]; then   # (runs for good: its first lines in 3 s, untimed)
      o=$(asu timeout 3 sh -c "${ex#\~}" 2>&1 </dev/null | head -n 2 | tr '\n' ' ')
      say "$(printf '%-20s %-17s %s' "$mod" "(runs for good)" "${o:0:120}")"; continue
    fi
    t0=$EPOCHREALTIME; o=$(asu timeout 10 sh -c "$ex" 2>&1 </dev/null | head -n 3 | tr '\n' ' '); r=${PIPESTATUS[0]}; ms=$(ms_since "$t0")
    say "$(printf '%-20s %5s ms  exit %-3s %s' "$mod" "$ms" "$r" "${o:0:120}")"
    ((SES && ms > 1000)) && warn "the bar's $mod takes ${ms} ms" "send the report (section 13)"
    ((SES && r == 124)) && fail "the bar's $mod hangs (no answer in 10 s)" "send the report (section 13)"
  done <"$TMP/wbmods"
fi
sub "drives: what is plugged in (lsblk) and what the bar shows (kawa-drives bar)"
lsblk -rno NAME,TYPE,RM,HOTPLUG,TRAN,SIZE,LABEL,MOUNTPOINTS >"$TMP/lsblk" 2>&1
cap 40 <"$TMP/lsblk" >>"$BODY"
nrm=$(awk '$2 == "disk" && ($3 == 1 || $4 == 1 || $5 == "usb")' "$TMP/lsblk" | grep -c .)
bar=$(asu timeout 10 kawa-drives bar 2>&1)
say "removable drives: $nrm · kawa-drives bar: $bar"
if ((nrm)); then
  if [[ $bar == *'"text":""'* || -z $bar ]]; then fail "a drive is plugged in ($nrm), but the bar shows none" "send the report (section 13)"
  else good "the bar shows the plugged-in drive"; fi
else say "(no USB drive plugged in: plug one in and run the report again to test the bar's mark)"; fi
sub "waybar's own log (~/.cache/waybar.log: errors and warnings)"
grep -iE 'error|warn|fail|critical' "$UH/.cache/waybar.log" 2>/dev/null | cap 60 >>"$BODY"
nwb=$(grep -ciE '\[error\]|critical|failed' "$UH/.cache/waybar.log" 2>/dev/null)
((${nwb:-0})) && warn "waybar logged ${nwb} errors" "section 13 lists them"

# ════ 14. notices ═════════════════════════════════════════════════════════════════════════
