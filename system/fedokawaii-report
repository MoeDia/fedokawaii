MPV-01 mpv's config | user | fail | mpv | o=$(mpv --msg-level=all=warn --vo=null --ao=null --frames=1 --keep-open=no --idle=no --input-terminal=no 'av://lavfi:testsrc=d=1' 2>&1); r=$?; printf '%s\n' "$o"; [ $r = 0 ] && ! grep -qiE 'error|unknown|invalid' <<<"$o" | plays one frame with mpv.conf loaded, and no option refused | run: fedokawaii apply
