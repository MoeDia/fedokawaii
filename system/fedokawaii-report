#!/usr/bin/env bash
# /usr/local/bin/fedokawaii-report — the whole machine's health in one file:
# ~/fedokawaii-report.txt, to read or to send with any question. About 450 checks, area by
# area — the system and the toolkit, the boot and the console, the login and the session,
# dwl and its keys, the theme, the card and the monitor, the session's programs, the journal,
# the network, sound and Bluetooth, sleep and the lock, how fast menus and the level display
# answer, the bar, notices, the clipboard, screen sharing and the file dialog, fonts (Arabic
# too), the launcher and what opens what, drives, packages, units, disks and snapshots,
# security, X11, every application, backups — and every program the desktop ships run once,
# not only looked for. It takes a few minutes (the checks run side by side).
#
# On top: the verdict, then the findings by area (each FAIL and WARN with → what to do or
# send, and what the failing command printed), then each area's table of checks, then the
# raw logs and captures, and last a machine-readable summary (STATUS<tab>area<tab>check<tab>
# detail, one line per check: diff two runs).
#
#   sudo fedokawaii-report          the report (as root: the install's log and the journal are
#                                   root's); the session's parts are asked as you, in the
#                                   running desktop's environment
#   sudo fedokawaii-report --quick  without the timed and the longer tests (the theme switch,
#                                   the menus timed, the download speed, a trial boot image…)
#   fedokawaii-report --help        this text
#
# Setup runs it once by itself after the first start of the finished desktop
# (fedokawaii-report.service). Secrets are never copied: no value of secrets.sh is printed (two
# checks only ask whether a password and a key are set), and any line that looks like a
# password, a token or a key has its value replaced by ●●●. Each command's
# output is cut at 200 lines. It changes nothing for good: the full report switches the theme
# to the other one and back, FreeSync round once, sends test notices, takes a screenshot and a
# copy (both removed, the clipboard put back), opens a menu, the panel and a file dialog and
# closes them, and builds a trial boot image in /var/tmp (deleted).
set -u
QUICK=0 BOOT=0
case ${1:-} in
  "") ;;
  --quick) QUICK=1 ;;
  --boot) BOOT=1 ;;                           # (the first-start service: waits for the desktop)
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: fedokawaii-report [--quick]" >&2; exit 2 ;;
esac
if ((EUID != 0)); then exec sudo bash "$0" "$@"; fi
START=$EPOCHREALTIME
export LC_ALL=C.UTF-8
TOOLKIT=/usr/local/lib/fedokawaii
STATE=/var/lib/fedokawaii
LOG=/var/log/fedokawaii.log
MAXL=200                                      # lines kept of any one command's output

# ── whose desktop ───────────────────────────────────────────────────────────────────────
U=${SUDO_USER:-}
if [[ -z $U || $U == root ]]; then
  U=$(sed -n 's/^command = .*kawa-greet \([a-z_][a-z0-9_-]*\)".*/\1/p' /etc/greetd/fedokawaii.toml 2>/dev/null)
fi
[[ -n $U ]] || U=$(getent passwd 1000 | cut -d: -f1)
UH=$(getent passwd "$U" | cut -d: -f6); UID_=$(id -u "$U" 2>/dev/null)
[[ -n $UH && -d $UH ]] || { echo "fedokawaii-report: no home for user '$U'" >&2; exit 1; }
OUT=$UH/fedokawaii-report.txt
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
chmod 0755 "$TMP"                             # (the checks run as you write their answers here)
FIND=$TMP/findings BODY=$TMP/body.0
: >"$FIND"; : >"$BODY"; : >"$TMP/areas"; : >"$TMP/machine"; : >"$TMP/captures"

# ── the desktop session (when one is running): its environment, to ask its programs ───────
DWLPID=$(pgrep -u "$U" -x dwl | head -n1)
if ((BOOT)); then                        # the first start: give the desktop up to 5 minutes
  for _ in $(seq 60); do DWLPID=$(pgrep -u "$U" -x dwl | head -n1); [[ -n $DWLPID ]] && break; sleep 5; done
  sleep 20                               # (and its autostart time to settle)
fi
WBPID=$(pgrep -u "$U" -x waybar | head -n1)
# dwl sets WAYLAND_DISPLAY (and DISPLAY) itself once it runs, so its own /proc environ — what
# it was started with — lacks them: the environment is read from the bar, mako, or another
# program dwl started; all of it is handed on (but what names the process and its place)
SENV=() SENVSRC=""
if [[ -n $DWLPID ]]; then
  for c in $WBPID $(pgrep -u "$U" -x mako) $(pgrep -u "$U" -P "$DWLPID"); do
    tr '\0' '\n' <"/proc/$c/environ" 2>/dev/null | grep -q '^WAYLAND_DISPLAY=' || continue
    while IFS= read -r -d '' kv; do
      case ${kv%%=*} in HOME|USER|LOGNAME|SHELL|PWD|OLDPWD|SHLVL|_|TERM|MAIL|INVOCATION_ID|JOURNAL_STREAM|NOTIFY_SOCKET|MANAGERPID|SYSTEMD_EXEC_PID|WAYBAR_OUTPUT_NAME) ;; *) SENV+=("$kv") ;; esac
    done <"/proc/$c/environ"
    SENVSRC="process $c ($(cat "/proc/$c/comm" 2>/dev/null))"; break
  done
  if [[ -z $SENVSRC ]]; then                 # (none holds it: the session's one socket, said)
    mapfile -t socks < <(find "/run/user/$UID_" -maxdepth 1 -type s -name 'wayland-[0-9]*' ! -name '*.lock' -printf '%f\n' 2>/dev/null)
    ((${#socks[@]} == 1)) && { SENV+=("WAYLAND_DISPLAY=${socks[0]}"); SENVSRC="the one socket ${socks[0]} (no program holds the environment)"; }
  fi
fi
[[ " ${SENV[*]} " == *" XDG_RUNTIME_DIR="* ]] || SENV+=("XDG_RUNTIME_DIR=/run/user/$UID_")
[[ " ${SENV[*]} " == *" DBUS_SESSION_BUS_ADDRESS="* ]] || SENV+=("DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UID_/bus")
# ASU CMD… — as the desktop's user, in its session's environment: a plain command line, so that
# timeout (run, below) and the checks run in the background can run it too (the session's PATH
# when it has one)
ASU=(runuser -u "$U" -- env -i HOME="$UH" USER="$U" LOGNAME="$U" SHELL=/bin/bash LANG=C.UTF-8 TERM=xterm-256color
     PATH="$UH/.local/bin:/usr/local/bin:/usr/bin:/bin" "${SENV[@]}")
asu() { "${ASU[@]}" "$@"; }
conf() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}.*/\1/p" "$TOOLKIT/fedokawaii.conf" 2>/dev/null | tail -n1; }
SES=0; [[ -n $DWLPID ]] && SES=1

# ── writing: each area has its own body (sec), put together in order at the end ──────────
AREA="0. the report itself"
sec() { AREA=$1; printf '%s\n' "$1" >>"$TMP/areas"; BODY=$TMP/body.${1%%.*}
        printf '\n\n══════ %s %s\n' "$1" "$(printf '═%.0s' $(seq $((80 - ${#1}))))" >>"$BODY"; }
sub() { printf '\n── %s\n' "$1" >>"$BODY"; }
say() { printf '%s\n' "$*" >>"$BODY"; }
cap() {   # cap [N] — the first N lines (MAXL), and how many more there were
  awk -v m="${1:-$MAXL}" 'NR <= m { print } END { if (NR > m) printf "… %d more lines\n", NR - m }'
}
tailcap() {   # tailcap — the last MAXL lines, and how many came before them
  awk -v m="$MAXL" '{ l[NR % m] = $0 } END { if (NR > m) printf "… %d earlier lines\n", NR - m
                                             for (i = (NR > m ? NR - m + 1 : 1); i <= NR; i++) print l[i % m] }'
}
RUNSHOW=""
run() {   # run TITLE CMD… — the command's output (20 s at most, 200 lines), its exit status if not 0
  local t=$1 r; shift
  printf '\n── %s\n$ %s\n' "$t" "${RUNSHOW:-$*}" >>"$BODY"; RUNSHOW=""
  timeout 20 "$@" >"$TMP/run.out" 2>&1; r=$?
  cap <"$TMP/run.out" >>"$BODY"
  ((r == 0)) || printf '[exit %s%s]\n' "$r" "$( ((r == 124)) && echo ': timed out after 20 s')" >>"$BODY"
  return $r
}
urun() { local t=$1; shift; RUNSHOW="$*"; run "$t (as $U)" "${ASU[@]}" "$@"; }
# fail|warn|good MESSAGE [WHAT TO DO OR SEND] — a finding, under the area it was made in
finding() { printf '%s\t%s\t%s\t%s\n' "$AREA" "$1" "$2" "${3:-}" >>"$FIND"; }
fail() { finding FAIL "$@"; }
warn() { finding WARN "$@"; }
good() { finding ok "$1"; }
detail() { sed 's/\t/ /g; s/^/          | /' | cap 12 | while IFS= read -r l; do finding detail "$l"; done; }
ms_since() { local a=${1/[.,]/} b=${EPOCHREALTIME/[.,]/}; echo $(( (b - a) / 1000 )); }

# ── the checks: a table of rows per area ───────────────────────────────────────────────────
#   checks AREA <<'ROWS'
#   NAME | MODE | LEVEL | NEEDS | COMMAND | EXPECTED | TO DO
#   one line a row; the first four fields are split off at the first " | "s, EXPECTED and TO DO
#   at the last two, so COMMAND may hold " | " (the shell's pipes) and those two may not
#   MODE     user: as you, in the session's environment when there is one · ses: the same,
#            skipped without a running desktop · root: as root. Then, optionally: "+full" —
#            left out by --quick · "+solo" — run alone, after the others (what is timed, or
#            shows something on the screen) · "/N" — N seconds at most (30 without)
#   LEVEL    fail · warn: what a failure is · info: no verdict, what it prints is kept
#   NEEDS    - · a program on your PATH · a path (~ is your home); "?" before it: optional
#            (missing: a WARN, not a FAIL)
#   COMMAND  bash, exit 0 passes; what it prints is kept for a failure. It may use $TK (the
#            toolkit), $STATE, $U, $UH (your home), $UIDN, $RT (your runtime folder), $DWL and $WB
#            (dwl's and waybar's process, or empty), $QUICK; as you, $HOME is yours
#   EXPECTED what passing means · TO DO what to do on a failure (-: send the report)
# Each row runs on its own; nothing is shared between them but the machine.
CK=$TMP/ck; mkdir -m 0777 "$CK"; NCK=0
checks() {
  local area=$1 line name mode level need cmd exp todo rest
  printf '%s\n' "$area" >>"$TMP/areas"
  while IFS= read -r line; do
    [[ -z $line || $line == '#'* ]] && continue
    NCK=$((NCK + 1))
    name=${line%% | *}; rest=${line#* | }; mode=${rest%% | *}; rest=${rest#* | }
    level=${rest%% | *}; rest=${rest#* | }; need=${rest%% | *}; rest=${rest#* | }
    todo=${rest##* | }; rest=${rest% | *}; exp=${rest##* | }; cmd=${rest% | *}
    if [[ ! $mode =~ ^(user|ses|root)(\+full)?(\+solo)?(/[0-9]+)?$ || ! $level =~ ^(fail|warn|info)$ || $cmd == "$rest" || -z $cmd ]]; then
      mode=bad
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$area" "$name" "$mode" "$level" "$need" "$cmd" "$exp" "$todo" >"$CK/$NCK.def"
  done
}
# (the row's own shell: its variables, NEEDS looked for, then COMMAND)
# shellcheck disable=SC2016
CHK='TK=$3 STATE=$4 U=$5 UH=$6 UIDN=$7 DWL=$8 WB=$9 QUICK=${10} RT=/run/user/$7
n=${1#\?}; n=${n/#\~/$HOME}
case $n in -) ;; */*) [ -e "$n" ] || { echo "(not installed: ${1#\?})"; exit 127; } ;;
  *) command -v -- "$n" >/dev/null || { echo "(not installed: ${1#\?})"; exit 127; } ;; esac
eval "$2"'
one_check() {   # one_check N — row N run; leaves N.rc, N.ms, N.out
  local i=$1 area name mode level need cmd exp todo t as t0
  IFS=$'\t' read -r area name mode level need cmd exp todo <"$CK/$i.def"
  as=${mode%%[+/]*}; t=30; [[ $mode == */* ]] && t=${mode##*/}
  t0=$EPOCHREALTIME
  if [[ $as == root ]]; then
    HOME=/root timeout -k 5 "$t" bash -c "$CHK" _ "${need/#\~/$UH}" "$cmd" "$TOOLKIT" "$STATE" "$U" "$UH" "$UID_" "$DWLPID" "$WBPID" "$QUICK" >"$CK/$i.out" 2>&1 </dev/null
  else
    "${ASU[@]}" timeout -k 5 "$t" bash -c "$CHK" _ "$need" "$cmd" "$TOOLKIT" "$STATE" "$U" "$UH" "$UID_" "$DWLPID" "$WBPID" "$QUICK" >"$CK/$i.out" 2>&1 </dev/null
  fi
  echo $? >"$CK/$i.rc"; ms_since "$t0" >"$CK/$i.ms"
}
skipped() {   # skipped N — why row N does not run here (200 no desktop · 201 malformed · 202 --quick), or nothing
  local mode; mode=$(cut -f3 "$CK/$1.def")
  if [[ $mode == bad ]]; then echo 201
  elif [[ $mode == *+full* ]] && ((QUICK)); then echo 202
  elif [[ $mode == ses* ]] && ((SES == 0)); then echo 200; fi
}
run_checks() {   # every row but the solo ones, 8 at a time
  local i s
  for ((i = 1; i <= NCK; i++)); do
    s=$(skipped "$i"); [[ -n $s ]] && { echo "$s" >"$CK/$i.rc"; continue; }
    [[ $(cut -f3 "$CK/$i.def") == *+solo* ]] && continue
    while (($(jobs -rp | wc -l) >= 8)); do wait -n; done
    one_check "$i" &
  done
  wait
}
run_solo() {     # the solo rows, one after another, nothing else of the report running
  local i
  for ((i = 1; i <= NCK; i++)); do
    [[ -e $CK/$i.rc || $(cut -f3 "$CK/$i.def") != *+solo* ]] && continue
    one_check "$i"
  done
}
judge_checks() {   # each row's outcome: a finding (in its area), its table line, its summary line
  local i area name mode level need cmd exp todo r ms st t nses=0
  for ((i = 1; i <= NCK; i++)); do
    IFS=$'\t' read -r area name mode level need cmd exp todo <"$CK/$i.def"
    r=$(cat "$CK/$i.rc" 2>/dev/null); ms=$(cat "$CK/$i.ms" 2>/dev/null); AREA=$area
    t=30; [[ $mode == */* ]] && t=${mode##*/}
    [[ $todo == - ]] && todo="send the report"
    case $r in
      200) st=SKIP; nses=$((nses + 1)) ;;
      202) st=SKIP ;;
      201) st=FAIL; fail "ENV-05 the report's own table: row '$name' is malformed" "send the report" ;;
      *)   if [[ $level == info ]]; then st=INFO
           elif [[ $r == 0 ]]; then st=ok
           elif [[ $r == 127 ]] && grep -q '^(not installed: ' "$CK/$i.out"; then
             if [[ $need == '?'* ]]; then st=WARN; warn "$name: not installed (optional)" "set it in fedokawaii.conf, then: fedokawaii apply"
             else st=FAIL; fail "$name: not installed ($(sed -n 's/^(not installed: \(.*\))$/\1/p' "$CK/$i.out"))" "run: fedokawaii repair"; fi
           else
             if [[ $r == 124 || $r == 137 || -z $r ]]; then r="no answer in $t s"; else r="exit $r"; fi
             if [[ $level == fail ]]; then st=FAIL; fail "$name: $( [[ $need == - ]] && echo failed || echo "installed but broken") ($r) — expected: $exp" "$todo"
             else st=WARN; warn "$name ($r) — expected: $exp" "$todo"; fi
             detail <"$CK/$i.out"
           fi ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\n' "$area" "$st" "$name" "${ms:--}" "$exp" >>"$CK/table"
    printf '%s\t%s\t%s\t%s\n' "$st" "$area" "$name" "$(grep -m1 . "$CK/$i.out" 2>/dev/null | tr '\t' ' ' | cut -c1-160)" >>"$TMP/machine"
    if [[ $st != ok && $st != SKIP ]]; then
      { printf '\n── %s · %s (%s)\n$ %s\n' "$area" "$name" "$st" "$cmd"; cap 60 <"$CK/$i.out"; } >>"$TMP/captures"
    fi
  done
  AREA="0. the report itself"
  ((nses)) && warn "ENV-06 $nses checks of the live desktop were skipped: no desktop session runs for $U" "log in, then run: fedokawaii report"
  return 0
}

