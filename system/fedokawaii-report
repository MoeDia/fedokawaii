# ════ 11. sleep and the lock ═════════════════════════════════════════════════════════════
sec "11. sleep and the lock"
# the kernel's and systemd's sleep lines, and the lock agent's own (kawa-power: "sleep
# requested", "lock up", "resumed", "locker exited rc=N"), the boot before and this one
{ journalctl -b -1 -o short-unix --no-pager 2>/dev/null; journalctl -b -o short-unix --no-pager 2>/dev/null; } \
  | grep -E 'systemd-sleep|PM: suspend (entry|exit)|Suspending system|System returned from sleep|[Ff]ailed to (suspend|put system to sleep)|suspend.*(failed|aborted)|Some devices failed to suspend| kawa-power(\[[0-9]+\])?: ' >"$TMP/sleep"
sub "sleep, resume and the lock (the boot before and this one)"
awk '{ $1 = strftime("%F %T", $1); print }' "$TMP/sleep" | cap >>"$BODY"; [[ -s $TMP/sleep ]] || say "(no sleep this boot or the one before)"
nsl=$(grep -c 'PM: suspend entry' "$TMP/sleep")
nsf=$(grep -cE '[Ff]ailed to (suspend|put system to sleep)|suspend.*(failed|aborted)|Some devices failed to suspend' "$TMP/sleep")
((nsf)) && { fail "sleep failed $nsf times" "send the report (section 11)"; grep -E 'ailed|aborted' "$TMP/sleep" | cut -d' ' -f2- | detail; }
if ((nsl)); then
  if grep -q ' kawa-power' "$TMP/sleep"; then
    # each sleep: the locker up before the kernel suspends, and not gone before the resume
    awk '/ kawa-power.*lock up/ { lock = 1 }
         / kawa-power.*locker exited/ { if (asleep) bad = bad "the locker exited while asleep: " $0 "\n"; lock = 0
                                        if ($0 !~ /rc=0/) crash = crash $0 "\n" }
         /PM: suspend entry/ { asleep = 1; if (!lock) bad = bad "suspended with no lock up: " $0 "\n" }
         /PM: suspend exit/  { asleep = 0 }
         END { printf "%s", bad > "/dev/stderr"; printf "%s", crash }' "$TMP/sleep" >"$TMP/crash" 2>"$TMP/unlocked"
    if [[ -s $TMP/unlocked ]]; then fail "the session was unlocked while asleep" "send the report (section 11) at once"; detail <"$TMP/unlocked"
    else good "$nsl sleeps, each with the screen locked"; fi
    [[ -s $TMP/crash ]] && { fail "the locker exited with an error (the screen was left open)" "send the report (section 11)"; detail <"$TMP/crash"; }
  else
    warn "$nsl sleeps, but the lock agent (kawa-power) logged nothing about them" "update the toolkit (fedokawaii update); send the report"
  fi
else say "(no suspend entry found)"; fi

# ════ 12. responsiveness: menus, quick settings, the level display ═════════════════════
