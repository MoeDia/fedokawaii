# ════ 16. the launcher ════════════════════════════════════════════════════════════════════
sec "16. the launcher"
# the entries shown: ~/.local/share/applications first (it hides or replaces a system one by
# the same name), then /usr/local/share and /usr/share; NoDisplay=true and Hidden=true are not shown
declare -A seen=() want=()
for f in "$TOOLKIT"/configs/home/.local/share/applications/*.desktop; do [[ -f $f ]] && want[${f##*/}]=1; done
for d in $(sed -n 's/^[^#[][^=]*=//p' "$UH/.config/mimeapps.list" 2>/dev/null | tr ';' ' '); do want[$d]=1; done
: >"$TMP/shown"
for dir in "$UH/.local/share/applications" /usr/local/share/applications /usr/share/applications; do
  for f in "$dir"/*.desktop; do
    [[ -f $f ]] || continue
    b=${f##*/}; [[ -n ${seen[$b]:-} ]] && continue; seen[$b]=1
    awk -v f="$f" -F= '/^\[/ { s = ($0 == "[Desktop Entry]") } s && /^(NoDisplay|Hidden|Exec|TryExec|Terminal|Type)=/ { v[$1] = substr($0, length($1) + 2) }
      END { if (v["NoDisplay"] != "true" && v["Hidden"] != "true" && (v["Type"] == "" || v["Type"] == "Application"))
              printf "%s\t%s\t%s\t%s\n", f, v["Exec"], v["TryExec"], v["Terminal"] }' "$f" >>"$TMP/shown"
  done
done
say "$(grep -c . "$TMP/shown") entries are shown in the launcher"
junk=() noexec=() term=()
while IFS=$'\t' read -r f ex try tm; do
  b=${f##*/}
  read -ra w <<<"$ex"; i=0
  while [[ ${w[i]:-} == env || ${w[i]:-} == *=* ]]; do i=$((i + 1)); done
  p=${w[i]:-}; p=${p//\"/}
  if [[ -z $p ]] || ! asu bash -c 'command -v -- "$1"' _ "$p" >/dev/null 2>&1; then noexec+=("$b (Exec: ${p:-none})")
  elif [[ -n $try ]] && ! asu bash -c 'command -v -- "$1"' _ "$try" >/dev/null 2>&1; then noexec+=("$b (TryExec: $try)"); fi
  [[ $tm == true ]] && term+=("$b")
  [[ -n ${want[$b]:-} ]] || junk+=("$b")
  say "$(printf '%-48s %s%s' "$b" "$ex" "$( [[ $tm == true ]] && echo '   [Terminal=true]')")"
done <"$TMP/shown"
((${#noexec[@]})) && { fail "${#noexec[@]} launcher entries open nothing (their program is missing)" "send the report (section 16)"; printf '%s\n' "${noexec[@]}" | detail; }
((${#junk[@]})) && { warn "${#junk[@]} entries in the launcher are not the desktop's own" "send the report: they can be hidden"; echo "${junk[*]}" | fold -s -w 90 | detail; }
if ((${#term[@]})); then
  warn "${#term[@]} entries open in a plain terminal (Terminal=true), not through kawa-term" "send the report (section 16)"; printf '%s\n' "${term[@]}" | detail
fi
((${#noexec[@]} + ${#junk[@]} + ${#term[@]})) || good "every entry in the launcher is the desktop's and opens"
if command -v desktop-file-validate >/dev/null; then
  sub "desktop-file-validate (the shown entries)"
  cut -f1 "$TMP/shown" | xargs -r desktop-file-validate 2>&1 | cap 80 >>"$BODY"
fi

