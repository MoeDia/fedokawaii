# ════ 20. the launcher ════════════════════════════════════════════════════════════════════
sec "20. the launcher and what opens what"
# the entries shown, found as the launcher finds them (Gio's list): ~/.local/share/applications first (it hides or
# replaces a system one by the same name), then each folder of the session's XDG_DATA_DIRS;
# NoDisplay=true and Hidden=true are not shown
declare -A seen=() want=()
for f in "$TOOLKIT"/configs/home/.local/share/applications/*.desktop; do [[ -f $f ]] && want[${f##*/}]=1; done
for d in $(sed -n 's/^[^#[][^=]*=//p' "$UH/.config/mimeapps.list" 2>/dev/null | tr ';' ' '); do want[$d]=1; done
xdd=$(printf '%s\n' "${SENV[@]}" | sed -n 's/^XDG_DATA_DIRS=//p'); xdd=${xdd:-/usr/local/share:/usr/share}
: >"$TMP/shown"
IFS=: read -ra ddirs <<<"$UH/.local/share:$xdd"
for dir in "${ddirs[@]}"; do
  for f in "$dir"/applications/*.desktop; do
    [[ -f $f ]] || continue
    b=${f##*/}; [[ -n ${seen[$b]:-} ]] && continue; seen[$b]=1
    awk -v f="$f" -F= '/^\[/ { s = ($0 == "[Desktop Entry]") } s && /^(NoDisplay|Hidden|Exec|TryExec|Terminal|Type|OnlyShowIn|NotShowIn)=/ { v[$1] = substr($0, length($1) + 2) }
      END { if (v["NoDisplay"] != "true" && v["Hidden"] != "true" && (v["Type"] == "" || v["Type"] == "Application") &&
                (v["OnlyShowIn"] == "" || v["OnlyShowIn"] ~ /wlroots/) && v["NotShowIn"] !~ /wlroots/)
              printf "%s\t%s\t%s\t%s\n", f, v["Exec"], v["TryExec"], v["Terminal"] }' "$f" >>"$TMP/shown"
  done
done
say "$(grep -c . "$TMP/shown") entries are shown in the launcher"
junk=() noexec=() term=()
while IFS=$'\t' read -r f ex try tm; do
  b=${f##*/}
  read -ra w <<<"$ex"; i=0
  while [[ ${w[i]:-} == env || ${w[i]:-} == *=* ]]; do i=$((i + 1)); done
  p=${w[i]:-}; p=${p//\"/}
  if [[ -z $p ]] || ! asu bash -c 'command -v -- "$1"' _ "$p" >/dev/null 2>&1; then noexec+=("$b (Exec: ${p:-none})")
  elif [[ -n $try ]] && ! asu bash -c 'command -v -- "$1"' _ "$try" >/dev/null 2>&1; then noexec+=("$b (TryExec: $try)"); fi
  [[ $tm == true ]] && term+=("$b")
  if [[ -z ${want[$b]:-} ]]; then
    own=""
    [[ $f == "$UH"/* ]] && grep -q 'steam://rungameid' "$f" && own=steam
    [[ $f == /usr/* && -s $TMP/pkgs ]] && grep -qxF "$(rpm -qf --qf '%{NAME}' "$f" 2>/dev/null)" "$TMP/pkgs" && own=manifest
    [[ -n $own ]] || junk+=("$b ($f)")
  fi
  say "$(printf '%-48s %s%s' "$b" "$ex" "$( [[ $tm == true ]] && echo '   [Terminal=true]')")"
done <"$TMP/shown"
((${#noexec[@]})) && { fail "APP-03 ${#noexec[@]} launcher entries open nothing (their program is missing)" "send the report"; printf '%s\n' "${noexec[@]}" | detail; }
((${#junk[@]})) && { warn "APP-01 ${#junk[@]} entries in the launcher are not the desktop's own" "send the report: they can be hidden"; printf '%s\n' "${junk[@]}" | detail; }
if ((${#term[@]})); then
  warn "APP-01b ${#term[@]} entries open in a plain terminal (Terminal=true), not through kawa-term" "send the report"; printf '%s\n' "${term[@]}" | detail
fi
((${#noexec[@]} + ${#junk[@]} + ${#term[@]})) || good "APP-01 every entry in the launcher is the desktop's and opens"

# ════ 24. disks, snapshots, memory ═══════════════════════════════════════════════════════
sec "24. disks and snapshots"
run "space" df -h -x tmpfs -x devtmpfs
run "Btrfs" btrfs filesystem usage -h /
run "snapshots (/)" snapper -c root list
run "snapshots (/home)" snapper -c home list
run "memory and swap" bash -c 'free -h; swapon --show'
run "processor" bash -c 'lscpu | head -n 20'
# (root's are what verify counts; podman's rootless storage belongs to the containers' own ids
# by design: left out)
# (~/Downloads is a Btrfs subvolume of its own, which -xdev stops at: searched on its own)
{ find "$UH" -xdev \( -path "$UH/.local/share/containers/storage" -o -path "$UH/Downloads" \) -prune -o -not -user "$U" -printf '%u\t%P\n'
  [[ -d $UH/Downloads ]] && find "$UH/Downloads" -xdev -not -user "$U" -printf '%u\tDownloads/%P\n'; } 2>/dev/null >"$TMP/notmine"
nst=$(find "$UH/.local/share/containers/storage" -xdev -not -user "$U" 2>/dev/null | grep -c .)
sub "files in your home not yours, by owner and folder (~/Downloads included)"
awk -F'\t' '{ n = split($2, p, "/"); k = p[1]; if (n > 2 && (k == ".cache" || k == ".local" || k == ".config")) k = k "/" p[2] (n > 3 && p[2] == "share" ? "/" p[3] : "")
              c[$1 "\t~/" k]++ } END { for (x in c) printf "%7d  %s\n", c[x], x }' "$TMP/notmine" | sort -rn | cap 40 >"$TMP/notmine.g"
cat "$TMP/notmine.g" >>"$BODY"; [[ -s $TMP/notmine ]] || say "(none)"
nro=$(awk -F'\t' '$1 == "root"' "$TMP/notmine" | grep -c .)
nfo=$(awk -F'\t' '$1 != "root"' "$TMP/notmine" | grep -c .)
if ((nro)); then warn "SEC-03 $nro files in your home belong to root (a program run as root with your HOME?)" "run: sudo chown -R $U: ~ — the folders are listed in the report"; grep -P '\troot\t' "$TMP/notmine.g" | head -n 8 | detail
else good "SEC-03 no root-owned file in your home"; fi
say "podman's storage (~/.local/share/containers/storage): $nst files of podman's containers' own (subordinate) ids — by design"
((nfo)) && { warn "$nfo files in your home belong to another user" "the folders are listed in the report"; grep -vP '\troot\t' "$TMP/notmine.g" | head -n 6 | detail; }
run "secrets.sh (mode only — never read)" stat -c '%A %U %n' "$UH/.config/fedokawaii/secrets.sh"

# ════ 22. packages ════════════════════════════════════════════════════════════════════════
sec "22. packages and updates"
# PKG-01: every package the manifest installs here is there, its files whole
if [[ -r $TOOLKIT/lib/manifest.sh ]]; then
  [[ -s $TMP/pkgs ]] || fail "lib/manifest.sh gives no package list" "send the report"
  while IFS= read -r p; do
    [[ -n $p ]] || continue
    if ! rpm -q --quiet "$p" >/dev/null; then echo "NOT INSTALLED $p"; continue; fi
    rpm -V --nofiledigest --nomtime --nouser --nogroup --nomode --nordev --nosize "$p" | grep '^missing' | grep -vE '^missing +[cdgl] ' | sed "s|^|$p: |"
  done <"$TMP/pkgs" >"$TMP/rpmv"
  sub "PKG-01 the packages lib/manifest.sh installs ($(grep -c . "$TMP/pkgs") here): installed, no file missing"
  cap <"$TMP/rpmv" >>"$BODY"
  np=$(grep -c '^NOT INSTALLED' "$TMP/rpmv"); nm=$(grep -vc '^NOT INSTALLED' "$TMP/rpmv")
  if ((np)); then fail "PKG-01 $np packages of the manifest are not installed" "run: fedokawaii repair"; sed -n 's/^NOT INSTALLED //p' "$TMP/rpmv" | tr '\n' ' ' | fold -s -w 90 | detail; fi
  if ((nm)); then fail "PKG-01 $nm files of the manifest's packages are missing" "run: sudo dnf reinstall <the package>"; grep -v '^NOT INSTALLED' "$TMP/rpmv" | detail; fi
  ((np + nm)) || good "PKG-01 all $(grep -c . "$TMP/pkgs") packages of the manifest are installed, none missing a file"
else fail "lib/manifest.sh is missing from the toolkit: the packages are not checked" "run: sudo bash $TOOLKIT/setup.sh"; fi

# ════ the checks done: those that run alone, then the theme switch ══════════════════════
wait "$CKPID"
run_solo

# ════ 7. the theme, timed from outside: to the other one and back, settled each time ══════
sec "7. the theme"
if [[ -r $TOOLKIT/theme.sh ]]; then
  timeout 120 bash "$TOOLKIT/theme.sh" --check --user "$U" >"$TMP/drift" 2>&1; dr=$?
  sub "THEME-05 theme.sh --check (what differs from the toolkit)"; cap <"$TMP/drift" >>"$BODY"; say "[exit $dr]"
  if ((dr == 0)); then good "THEME-05 the theme is in sync with the toolkit"
  else warn "THEME-05 the theme drifted from the toolkit (exit $dr)" "run: fedokawaii apply"; sed -n '1,12p' "$TMP/drift" | detail; fi
fi
run "current theme" readlink -f "$UH/.config/fedokawaii/current"
if ((QUICK == 0 && SES)) && asu bash -c 'command -v kawa-theme' >/dev/null; then
  sub "THEME-10 the theme switch, timed until it settled (the link, GTK's colour scheme, no kawa-theme left)"
  orig=$(asu kawa-theme get 2>/dev/null)
  for i in 1 2; do
    want=dark; [[ $(asu kawa-theme get 2>/dev/null) == dark ]] && want=light
    t0=$EPOCHREALTIME; asu timeout 60 kawa-theme "$want" >"$TMP/sw.out" 2>&1; r=$?; ms=$(ms_since "$t0")
    # each part polled until it is done, the time it was done kept: the link, GTK's colour
    # scheme, kawa-theme's process and its busy marker, the bar's reload (its log), mako's
    t_link="" t_gtk="" t_proc="" t_busy="" t_bar="" wb0=$(grep -c 'Reloading\|appearance' "$UH/.cache/waybar.log" 2>/dev/null)
    for _ in $(seq 800); do
      [[ -z $t_link && $(readlink "$UH/.config/fedokawaii/current") == themes/$want ]] && t_link=$(ms_since "$t0")
      if [[ -z $t_gtk ]]; then cs=$(asu gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)
        [[ $want == dark && $cs == "'prefer-dark'" || $want == light && $cs != "'prefer-dark'" ]] && t_gtk=$(ms_since "$t0"); fi
      [[ -z $t_proc ]] && ! pgrep -u "$U" -f '^(/usr/bin/)?bash [^ ]*/kawa-theme( |$)' >/dev/null && t_proc=$(ms_since "$t0")
      [[ -z $t_busy ]] && { [[ ! -e /run/user/$UID_/kawa-theme.busy ]] || flock -n /run/user/$UID_/kawa-theme.busy true; } && t_busy=$(ms_since "$t0")
      [[ -z $t_bar ]] && (($(grep -c 'Reloading\|appearance' "$UH/.cache/waybar.log" 2>/dev/null) > wb0)) && t_bar=$(ms_since "$t0")
      [[ -n $t_link && -n $t_gtk && -n $t_proc && -n $t_busy ]] && break
      sleep 0.01
    done
    say "  the parts done after (ms): the theme link ${t_link:-never} · GTK's colour scheme ${t_gtk:-never} · kawa-theme ended ${t_proc:-never} · its busy lock free ${t_busy:-never} · the bar reloaded ${t_bar:-not seen}"
    st=$(ms_since "$t0")
    cap 40 <"$TMP/sw.out" >>"$BODY"
    say "switch $i to $want: the command ${ms} ms (exit $r), settled after ${st} ms"
    if ((r)); then fail "THEME-10 kawa-theme failed switching to $want (exit $r)" "send the report"; break; fi
    printf 'THEME-10 the theme switch to %s: settled after %s ms (at most 1500)\n' "$want" "$st" >>"$TMP/perf-theme"
    if ((st > 1500)); then fail "THEME-10 the switch to $want took ${st} ms to settle (over 1.5 s): link ${t_link:-?} · GTK ${t_gtk:-?} · kawa-theme ended ${t_proc:-?} · busy lock free ${t_busy:-?} · bar ${t_bar:-?} ms" "send the report"
    else good "THEME-10 the switch to $want settled in ${st} ms"; fi
    sleep 1
  done
  [[ $(asu kawa-theme get 2>/dev/null) == "$orig" ]] || asu timeout 60 kawa-theme "$orig" >/dev/null 2>&1
  say "back to: $(asu kawa-theme get 2>/dev/null) (it was $orig)"
  [[ $(asu kawa-theme get 2>/dev/null) == "$orig" ]] || fail "THEME-10 the theme could not be put back to $orig" "switch it back: kawa-theme $orig"
fi
sub "the theme's own log (~/.cache/kawa-theme.log, the last 40 lines)"
tail -n 40 "$UH/.cache/kawa-theme.log" >>"$BODY" 2>/dev/null
# "kawa-theme: switched to light in 412 ms" — the switch as kawa-theme times it itself
grep -E 'kawa-theme: switched to [a-z]+ in [0-9]+ ms' "$UH/.cache/kawa-theme.log" 2>/dev/null | tail -n 6 >"$TMP/tt"
if [[ -s $TMP/tt ]]; then
  # judged by the last switch: the first to a theme after a login decodes its wallpaper cold
  # (glycin's sandboxed loader starting up) — over in a moment; one over 1.5 s is a stall
  slow=$(sed -nE 's/.*switched to ([a-z]+) in ([0-9]+) ms.*/\2 \1/p' "$TMP/tt" | awk -v n="$(grep -c . "$TMP/tt")" '$1 > 1500 || (NR == n && $1 > 400)' | sort -n | tail -n1)
  last=$(sed -nE 's/.*switched to ([a-z]+) in ([0-9]+) ms.*/\2 ms (to \1)/p' "$TMP/tt" | tail -n1)
  if [[ -n $slow ]]; then warn "a theme switch took ${slow% *} ms by its own count (to ${slow#* }; the last switch over 400 ms, or any over 1.5 s) — the last: $last" "send the report"
  else good "the theme switches in time by its own count (the last: $last)"; fi
else warn "kawa-theme logged no switch time (~/.cache/kawa-theme.log: no 'switched to … in N ms' line)" "THEME-12 says whether your kawa-theme is older than the toolkit's"; fi

# ════ the report ══════════════════════════════════════════════════════════════════════════
judge_checks
# the performance at a glance, on top after the verdict: each PERF row, the timed menus (UI-03
# the panel, UI-04 a dropdown from the bar, UI-05 the launcher) and the bar's modules (BAR-04),
# with the numbers they printed — what is over its threshold first
{
  for ((i = 1; i <= NCK; i++)); do
    IFS=$'\t' read -r area name _ <"$CK/$i.def"
    [[ $area == "29. performance" || $name == UI-0[345]\ * || $name == BAR-04\ * ]] || continue
    st=$(awk -F'\t' -v n="$name" '$3 == n { print $2; exit }' "$CK/table")
    printf '  %-4s  %s\n' "${st:-?}" "$name"
    [[ $st == SKIP || ! -s $CK/$i.out ]] && continue
    if [[ $name == PERF-09\ * ]]; then cut -c1-160 "$CK/$i.out" | sed 's/^/          | /'; continue; fi   # (its table whole: worst first)
    { grep -E 'OVER|TOO MANY|← ' "$CK/$i.out"; grep -vE 'OVER|TOO MANY|← |^$' "$CK/$i.out" | head -n 5; } | head -n 8 | cut -c1-110 | sed 's/^/          | /'
  done
  [[ -s $TMP/perf-theme ]] && sed 's/^/  /' "$TMP/perf-theme"
} >"$TMP/perf"
rm -f "/tmp/fk-perf-sample.$UID_"
# the findings made outside the tables, in the machine-readable summary too
awk -F'\t' '$2 == "FAIL" || $2 == "WARN" || $2 == "ok" { printf "%s\t%s\t%s\t%s\n", $2, $1, $3, $4 }' "$FIND" >>"$TMP/machine"
FAILS=$(grep -c $'\tFAIL\t' "$FIND"); WARNS=$(grep -c $'\tWARN\t' "$FIND")
sort -n "$TMP/areas" | awk '!seen[$0]++' >"$TMP/areas.s"
took=$(ms_since "$START")
{
  echo "fedokawaii health report — $(date '+%Y-%m-%d %H:%M:%S %Z') — $(hostname) — for $U"
  echo "made by fedokawaii-report in $((took / 1000)) s: $NCK checks in tables, and the logs$( ((QUICK)) && echo ' (--quick: no timed or long tests)')"
  echo
  if ((FAILS)); then echo "VERDICT: BROKEN — $FAILS failures, $WARNS warnings"
  elif ((WARNS)); then echo "VERDICT: WORKS, WITH WARNINGS — $WARNS warnings"
  else echo "VERDICT: HEALTHY — nothing failed, no warnings"; fi
  echo
  echo "── performance (the desktop at rest, and how fast it answers: each a FAIL past its threshold) ──"
  cat "$TMP/perf"
  echo
  echo "── findings by area (FAIL, then WARN; → what to do or send) ─────────────────────"
  while IFS= read -r a; do
    awk -F'\t' -v a="$a" '$1 == a' "$FIND" >"$TMP/fa"
    grep -qP '\t(FAIL|WARN)\t' "$TMP/fa" || continue
    printf '\n%s\n' "$a"
    for lv in FAIL WARN; do
      awk -F'\t' -v lv="$lv" '
        $2 == lv { printf "  %-4s  %s\n", $2, $3; if ($4 != "") printf "          → %s\n", $4; keep = 1; next }
        $2 == "detail" { if (keep) print $3; next }
        { keep = 0 }' "$TMP/fa"
    done
  done <"$TMP/areas.s"
  echo
  echo "── by area: each check (ok · FAIL · WARN · INFO: kept · SKIP: needs the desktop, or --quick) ──"
  while IFS= read -r a; do
    awk -F'\t' -v a="$a" '$1 == a' "$CK/table" 2>/dev/null >"$TMP/ta"
    nf=$(awk -F'\t' -v a="$a" '$1 == a && ($2 == "FAIL" || $2 == "WARN")' "$FIND" | grep -c .)
    if [[ ! -s $TMP/ta ]]; then printf '\n%s — no table: %d findings (above), its logs below\n' "$a" "$nf"; continue; fi
    printf '\n%s — %d checks: %d ok, %d FAIL, %d WARN, %d INFO, %d SKIP%s\n' "$a" "$(grep -c . "$TMP/ta")" \
      "$(grep -c $'\tok\t' "$TMP/ta")" "$(grep -c $'\tFAIL\t' "$TMP/ta")" "$(grep -c $'\tWARN\t' "$TMP/ta")" \
      "$(grep -c $'\tINFO\t' "$TMP/ta")" "$(grep -c $'\tSKIP\t' "$TMP/ta")" "$( ((nf)) && echo " · $nf findings in all (above)")"
    awk -F'\t' '{ printf "  %-4s  %-36s %7s ms  %s\n", $2, $3, $4, $5 }' "$TMP/ta"
  done <"$TMP/areas.s"
  echo
  echo "── fine (the findings outside the tables) ─────────────────────────────────────────"
  awk -F'\t' '$2 == "ok" { printf "  ok    %s\n", $3 }' "$FIND"
  for b in $(cd "$TMP" && ls body.* | sort -t. -k2,2n); do cat "$TMP/$b"; done
  printf '\n\n══════ the checks: what each one printed (all but the passed and skipped) %s\n' "$(printf '═%.0s' $(seq 8))"
  cat "$TMP/captures"
  printf '\n\n══════ machine-readable: STATUS<tab>area<tab>check<tab>detail (diff two runs) %s\n' "$(printf '═%.0s' $(seq 4))"
  cat "$TMP/machine"
} | sed -E 's/((password|passwd|passphrase|secret|token|api[_-]?key|psk|RESTIC_PASSWORD)[A-Za-z_]*[[:space:]]*[=:][[:space:]]*)[^[:space:]]+/\1●●●/Ig; s/(Bearer[[:space:]]+)[^[:space:]]+/\1●●●/Ig; s/(X-Api-Key:[[:space:]]*)[^[:space:]"]+/\1●●●/Ig' >"$TMP/report"
install -m 0600 -o "$U" -g "$(id -gn "$U")" "$TMP/report" "$OUT"
echo "fedokawaii-report: $OUT ($(wc -l <"$OUT") lines) — $( ((FAILS)) && echo "BROKEN: $FAILS failures, $WARNS warnings" || { ((WARNS)) && echo "works, $WARNS warnings" || echo healthy; })"
# run from a stick: a copy beside the script too, to carry back
here=$(cd "$(dirname "$0")" && pwd)
# (in your home already the file is there: one file, never a second one of root's)
if [[ $here != /usr/local/* && $here != "$UH" && $here != "$UH"/* && -w $here ]]; then
  install -m 0600 -o "$U" -g "$(id -gn "$U")" "$OUT" "$here/fedokawaii-report.txt" && echo "fedokawaii-report: also $here/fedokawaii-report.txt"
fi
exit 0
