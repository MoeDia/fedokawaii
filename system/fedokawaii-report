#!/usr/bin/env bash
# /usr/local/bin/fedokawaii-report — the whole machine's health in one file:
# ~/fedokawaii-report.txt. Everything the install and the desktop did and how they stand now —
# the install's log, verify's full answer, the theme's drift and its switch timed, the graphics
# cards and the monitor, the session's every part, the journal (failed units, errors,
# crashes, SELinux denials), the network and the mirrors, sound, Bluetooth and DDC/CI, disks
# and snapshots; the boot (quiet, the splash, the time to the login screen), sleep and the
# lock, the bar's modules, notices, fonts (Arabic too), the launcher's entries, dwl's own log —
# and every program the desktop ships proved to work, not only installed. On top: the verdict
# (what is broken, what is a warning), the findings grouped by area with what to do or send.
#
#   sudo fedokawaii-report          the report (as root: the install's log and the journal are
#                                   root's); the session's parts are read as you, from the
#                                   running desktop when there is one
#   sudo fedokawaii-report --quick  the same without the timed tests (no theme switch, no
#                                   download speed, no brightness change)
#   fedokawaii-report --help        this text
#
# Setup runs it once by itself after the first start of the finished desktop
# (fedokawaii-report.service). Secrets are never copied: secrets.sh is not read, and any line
# that looks like a password, a token or a key has its value replaced by ●●●. Each command's
# output is cut at 200 lines. It changes nothing — but the timed theme test switches the theme
# to the other one and back, and the program checks send one test notice and take one
# screenshot (deleted at once).
set -u
QUICK=0 BOOT=0
case ${1:-} in
  "") ;;
  --quick) QUICK=1 ;;
  --boot) BOOT=1 ;;                           # (the first-start service: waits for the desktop)
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: fedokawaii-report [--quick]" >&2; exit 2 ;;
esac
if ((EUID != 0)); then exec sudo bash "$0" "$@"; fi
START=$EPOCHREALTIME
export LC_ALL=C.UTF-8
TOOLKIT=/usr/local/lib/fedokawaii
STATE=/var/lib/fedokawaii
LOG=/var/log/fedokawaii.log
MAXL=200                                      # lines kept of any one command's output

# ── whose desktop ───────────────────────────────────────────────────────────────────────
U=${SUDO_USER:-}
if [[ -z $U || $U == root ]]; then
  U=$(sed -n 's/^command = .*kawa-greet \([a-z_][a-z0-9_-]*\)".*/\1/p' /etc/greetd/fedokawaii.toml 2>/dev/null)
fi
[[ -n $U ]] || U=$(getent passwd 1000 | cut -d: -f1)
UH=$(getent passwd "$U" | cut -d: -f6); UID_=$(id -u "$U" 2>/dev/null)
[[ -n $UH && -d $UH ]] || { echo "fedokawaii-report: no home for user '$U'" >&2; exit 1; }
OUT=$UH/fedokawaii-report.txt
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
chmod 0755 "$TMP"                             # (the checks run as you write their answers here)
BODY=$TMP/body FIND=$TMP/findings
: >"$BODY"; : >"$FIND"

# ── the desktop session (when one is running): its environment, to ask its programs ───────
DWLPID=$(pgrep -u "$U" -x dwl | head -n1)
if ((BOOT)); then                        # the first start: give the desktop up to 5 minutes
  for _ in $(seq 60); do DWLPID=$(pgrep -u "$U" -x dwl | head -n1); [[ -n $DWLPID ]] && break; sleep 5; done
  sleep 20                               # (and its autostart time to settle)
fi
SENV=()
if [[ -n $DWLPID ]]; then
  while IFS= read -r -d '' kv; do
    case $kv in WAYLAND_DISPLAY=*|XDG_RUNTIME_DIR=*|DBUS_SESSION_BUS_ADDRESS=*|DISPLAY=*|XDG_CURRENT_DESKTOP=*|WLR_DRM_DEVICES=*) SENV+=("$kv") ;; esac
  done </proc/"$DWLPID"/environ
fi
[[ " ${SENV[*]} " == *" XDG_RUNTIME_DIR="* ]] || SENV+=("XDG_RUNTIME_DIR=/run/user/$UID_")
[[ " ${SENV[*]} " == *" DBUS_SESSION_BUS_ADDRESS="* ]] || SENV+=("DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UID_/bus")
asu() {   # asu CMD… — as the desktop's user, in its session's environment
  runuser -u "$U" -- env -i HOME="$UH" USER="$U" LOGNAME="$U" SHELL=/bin/bash LANG=C.UTF-8 TERM=xterm-256color \
    PATH="$UH/.local/bin:/usr/local/bin:/usr/bin:/bin" "${SENV[@]}" "$@"
}
conf() { sed -n "s/^$1=\"\{0,1\}\([^\"]*\)\"\{0,1\}.*/\1/p" "$TOOLKIT/fedokawaii.conf" 2>/dev/null | tail -n1; }

# ── writing ─────────────────────────────────────────────────────────────────────────────
AREA=""
sec() { AREA=$1; printf '%s\n' "$1" >>"$TMP/areas"
        printf '\n\n══════ %s %s\n' "$1" "$(printf '═%.0s' $(seq $((80 - ${#1}))))" >>"$BODY"; }
sub() { printf '\n── %s\n' "$1" >>"$BODY"; }
say() { printf '%s\n' "$*" >>"$BODY"; }
cap() {   # cap [N] — the first N lines (MAXL), and how many more there were
  awk -v m="${1:-$MAXL}" 'NR <= m { print } END { if (NR > m) printf "… %d more lines\n", NR - m }'
}
run() {   # run TITLE CMD… — the command's output (20 s at most, 200 lines), its exit status if not 0
  local t=$1 r; shift
  printf '\n── %s\n$ %s\n' "$t" "$*" >>"$BODY"
  timeout 20 "$@" >"$TMP/run.out" 2>&1; r=$?
  cap <"$TMP/run.out" >>"$BODY"
  ((r == 0)) || printf '[exit %s%s]\n' "$r" "$( ((r == 124)) && echo ': timed out after 20 s')" >>"$BODY"
  return $r
}
urun() { local t=$1; shift; run "$t (as $U)" asu "$@"; }
FAILS=0 WARNS=0
# fail|warn|good MESSAGE [WHAT TO DO OR SEND] — a finding, under the section it was made in
finding() { printf '%s\t%s\t%s\t%s\n' "$AREA" "$1" "$2" "${3:-}" >>"$FIND"; }
fail() { FAILS=$((FAILS + 1)); finding FAIL "$@"; }
warn() { WARNS=$((WARNS + 1)); finding WARN "$@"; }
good() { finding ok "$1"; }
detail() { sed 's/\t/ /g; s/^/          | /' | cap 12 | while IFS= read -r l; do finding detail "$l"; done; }
ms_since() { local a=${1/[.,]/} b=${EPOCHREALTIME/[.,]/}; echo $(( (b - a) / 1000 )); }
SES=0; [[ -n $DWLPID ]] && SES=1

# ════ 1. the system ══════════════════════════════════════════════════════════════════════
sec "1. the system"
run "release" cat /etc/os-release
run "kernel" uname -a
run "kernel arguments" cat /proc/cmdline
run "up since" uptime
run "setup's state ($STATE)" bash -c "for f in $STATE/*; do [[ -f \$f && \$(stat -c %s \"\$f\") -lt 4096 ]] && printf '%-28s %s\n' \"\${f##*/}\" \"\$(tr '\n' ' ' <\"\$f\")\"; done"
phase=$(cat "$STATE/phase" 2>/dev/null)
if [[ $phase == "done" ]]; then good "setup finished (phase done)"
else fail "setup did not finish: phase is '${phase:-none}'" "run: sudo bash $TOOLKIT/setup.sh"; fi
[[ -e /etc/systemd/system/fedokawaii-resume.service ]] && warn "the resume unit is still installed (setup expects to continue at the next start)"
run "the toolkit" bash -c "ls -la $TOOLKIT | head -n 40"
run "settings (fedokawaii.conf, secrets left out)" grep -vE '^[[:space:]]*(#|$)' "$TOOLKIT/fedokawaii.conf"

# ════ 2. the start-up ════════════════════════════════════════════════════════════════════
sec "2. the start-up"
run "time to start" systemd-analyze
run "slowest units" bash -c 'systemd-analyze blame | head -n 25'
run "critical chain" systemd-analyze critical-chain
run "last starts" bash -c 'journalctl --list-boots --no-pager | tail -n 6'
t=$(systemd-analyze 2>/dev/null | sed -n 's/.*= \([0-9.]*\)s$/\1/p' | head -n1)
[[ -n $t ]] && { if (( ${t%.*} > 60 )); then warn "start-up took ${t}s (over a minute)" "send the report: section 2 names the slow units"; else good "start-up took ${t}s"; fi; }

# ── the boot, clean: quiet, the splash, the login screen in time ──
sub "the kernel's arguments for a clean boot"
cmd=$(cat /proc/cmdline 2>/dev/null)
miss=()
for a in quiet loglevel=3 vt.global_cursor_default=0 splash; do [[ " $cmd " == *" $a "* ]] || miss+=("$a"); done
say "/proc/cmdline: $cmd"
if ((${#miss[@]})); then fail "the boot is not quiet: /proc/cmdline lacks ${miss[*]}" "run: sudo fedokawaii apply (theme.sh sets them), then restart"
else good "the kernel's arguments are quiet (quiet loglevel=3 vt.global_cursor_default=0 splash)"; fi
pt=$(plymouth-set-default-theme 2>/dev/null)
say "the boot splash (plymouth-set-default-theme): ${pt:-(none)}"
if [[ $pt == sumi ]]; then good "the boot splash theme is sumi"
else fail "the boot splash theme is '${pt:-none}', not sumi" "run: sudo fedokawaii apply"; fi
lsinitrd 2>/dev/null | grep -i plymouth >"$TMP/initrd"
sub "the splash in the initramfs (lsinitrd | grep plymouth)"; cap 60 <"$TMP/initrd" >>"$BODY"
if grep -q "plymouth/themes/${pt:-sumi}" "$TMP/initrd"; then good "the initramfs holds the ${pt:-sumi} splash"
else fail "the initramfs lacks the ${pt:-sumi} splash (it shows only after the disk is open)" "run: sudo dracut -f --regenerate-all"; fi
after=$(systemctl show greetd.service -p After --value 2>/dev/null)
say "greetd starts after: $after"
if [[ " $after " == *" plymouth-quit-wait.service "* ]]; then good "the login screen waits for the splash to end (After=plymouth-quit-wait.service)"
else fail "greetd is not ordered after plymouth-quit-wait.service: the splash and the login screen fight over the screen" "send the report (section 2)"; fi
sub "the timeline of this start (seconds from the kernel's start)"
journalctl -b -o short-monotonic --no-pager 2>/dev/null >"$TMP/jb"
mono() { sed -n 's/^\[ *\([0-9]*\.[0-9]*\)\].*/\1/p' | head -n1; }
t_ply=$(grep -m1 -E 'plymouth-quit-wait.service|Hold until boot process finishes up' "$TMP/jb" | mono)
t_gd=$(grep -m1 -E 'Started (greetd.service|.*[Gg]reeter daemon)' "$TMP/jb" | mono)
t_gr=$(grep -m1 -E ' kawa-greet(\[[0-9]+\])?: ' "$TMP/jb" | mono)
t_fr=$(grep -m1 -iE ' kawa-greet(\[[0-9]+\])?: .*(first frame|shown|drawn)' "$TMP/jb" | mono)
t_lg=$(grep -m1 -E "session opened for user $U" "$TMP/jb" | mono)
t_dwl=""
if ((SES)); then
  up=$(cut -d' ' -f1 /proc/uptime); et=$(ps -o etimes= -p "$DWLPID" | tr -d ' ')
  [[ -n $et ]] && t_dwl=$(awk -v u="$up" -v e="$et" 'BEGIN { printf "%.1f", u - e }')
fi
{
  printf '%-44s %s\n' "the kernel starts" 0
  printf '%-44s %s\n' "the splash ends (plymouth-quit-wait)" "${t_ply:-?}"
  printf '%-44s %s\n' "greetd started" "${t_gd:-?}"
  printf '%-44s %s\n' "the login screen's first line (kawa-greet)" "${t_gr:-?}"
  printf '%-44s %s\n' "the login screen's first frame" "${t_fr:-? (kawa-greet logs no frame line)}"
  printf '%-44s %s\n' "your session opened (the login)" "${t_lg:-?}"
  printf '%-44s %s\n' "dwl started (this session)" "${t_dwl:-?}"
} >>"$BODY"
tg=${t_fr:-$t_gr}
if [[ -n $tg ]]; then
  if (( ${tg%.*} > 30 )); then warn "the login screen came ${tg%.*} s after the kernel started (over 30 s)" "send the report (sections 2 and 8)"
  else good "the login screen came ${tg%.*} s after the kernel started"; fi
elif [[ -s $TMP/jb ]]; then warn "the login screen (kawa-greet) logged nothing this boot" "send the report"; fi
sub "logout → login screen (each logout this boot, and the boot before)"
{ journalctl -b -1 -o short-unix --no-pager 2>/dev/null; journalctl -b -o short-unix --no-pager 2>/dev/null; } \
  | grep -E "session closed for user $U| kawa-greet(\[[0-9]+\])?: " \
  | awk -v u="$U" '$0 ~ "session closed for user " u { c = $1; next }
                   c != "" { printf "logout at %s → login screen %.1f s later\n", strftime("%F %T", c), $1 - c; c = "" }' >"$TMP/gaps"
cap <"$TMP/gaps" >>"$BODY"; [[ -s $TMP/gaps ]] || say "(no logout found)"
gmax=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "screen") print $(i + 1) }' "$TMP/gaps" | sort -n | tail -n1)
[[ -n $gmax ]] && { if (( ${gmax%.*} > 3 )); then warn "a logout took ${gmax} s to show the login screen (over 3 s)" "send the report (section 2)"; else good "logout → login screen within ${gmax} s"; fi; }

# ════ 3. the install's own log ═══════════════════════════════════════════════════════════
sec "3. the install's log"
if [[ -r $LOG ]]; then
  say "$LOG: $(stat -c %s "$LOG") bytes, $(wc -l <"$LOG") lines"
  nf=$(grep -c '✘' "$LOG"); nw=$(grep -ciE '(^|[^a-z])warn(ing)?' "$LOG"); ne=$(grep -ciE '(^|[^a-z])(error|failed|fatal)' "$LOG")
  say "lines with ✘: $nf · with warning: $nw · with error/failed/fatal: $ne"
  sub "every ✘, error and warning line (with the line before it; the last $MAXL)"
  grep -n -B1 -iE '✘|(^|[^a-z])(warn(ing)?|error|failed|fatal|refus|timed out|denied)' "$LOG" | tail -n "$MAXL" >>"$BODY"
  sub "the run's steps (✔ / ✘ lines; the last $MAXL)"
  grep -nE '✔|✘|── [0-9]\.[0-9]' "$LOG" | tail -n "$MAXL" >>"$BODY"
  sub "the last $MAXL lines"
  tail -n "$MAXL" "$LOG" >>"$BODY"
  ((nf)) && warn "the install's log has $nf ✘ lines (earlier attempts included)" "send the report (section 3)"
else
  fail "the install's log $LOG is missing"
fi

# ════ 4. verify — the install proved ═════════════════════════════════════════════════════
sec "4. verify"
if [[ -r $TOOLKIT/verify.sh ]]; then
  timeout 300 bash "$TOOLKIT/verify.sh" >"$TMP/verify" 2>&1; vr=$?
  say "\$ sudo bash $TOOLKIT/verify.sh"; cap 400 <"$TMP/verify" >>"$BODY"; say "[exit $vr]"
  vf=$(grep -c '✘' "$TMP/verify"); vw=$(grep -ciE '⚠|warning' "$TMP/verify")
  if ((vr == 0 && vf == 0)); then good "verify passed ($(grep -c '✔' "$TMP/verify") checks, $vw warnings)"
  else fail "verify: $vf checks failed (exit $vr)" "each ✘ says what to do; else send the report"; grep '✘' "$TMP/verify" | detail; fi
  ((vw)) && warn "verify: $vw warnings" "section 4"
else fail "verify.sh is missing from $TOOLKIT" "run: sudo bash $TOOLKIT/setup.sh"; fi

# ════ 5. the theme: in sync, current, timed ══════════════════════════════════════════════
sec "5. the theme"
if [[ -r $TOOLKIT/theme.sh ]]; then
  timeout 120 bash "$TOOLKIT/theme.sh" --check --user "$U" >"$TMP/drift" 2>&1; dr=$?
  sub "theme.sh --check (what differs from the toolkit)"; cap <"$TMP/drift" >>"$BODY"; say "[exit $dr]"
  if ((dr == 0)); then good "the theme is in sync with the toolkit"; else warn "the theme drifted from the toolkit (exit $dr)" "run: fedokawaii apply"; fi
fi
run "current theme" readlink -f "$UH/.config/fedokawaii/current"
urun "fonts the desktop uses" bash -c 'for f in "Fusion Pixel 12px Mono ja" "Sumi Icons" "Sumi Icons Term" "Noto Sans" "Noto Sans CJK JP" "Noto Kufi Arabic" "JetBrainsMono Nerd Font"; do printf "%-28s → %s\n" "$f" "$(fc-match "$f")"; done'
fc=$(asu fc-match "Fusion Pixel 12px Mono ja" 2>/dev/null)
[[ $fc == *Fusion* ]] && good "the pixel font resolves" || fail "the pixel font does not resolve (fc-match: $fc)" "run: fedokawaii apply"
urun "GTK settings" bash -c 'for k in gtk-theme icon-theme cursor-theme color-scheme font-name; do printf "%-14s %s\n" $k "$(gsettings get org.gnome.desktop.interface $k)"; done'
run "dwl's animation settings (config.h)" bash -c "grep -niE 'anim|fade|duration' '$UH/.local/src/dwl/config.h' || echo '(none)'"
if ((QUICK == 0 && SES)) && asu bash -c 'command -v kawa-theme' >/dev/null; then
  sub "the theme switch, timed (to the other theme and back)"
  for i in 1 2; do
    t0=$EPOCHREALTIME; asu timeout 60 kawa-theme >"$TMP/sw.out" 2>&1; r=$?; ms=$(ms_since "$t0")
    cap 40 <"$TMP/sw.out" >>"$BODY"
    say "switch $i: ${ms} ms (exit $r) → now $(asu kawa-theme get 2>/dev/null)"
    ((r == 0)) || fail "kawa-theme switch $i failed (exit $r)" "send the report (section 5)"
    sleep 2
  done
fi
sub "the theme's own log (~/.cache/kawa-theme.log, the last 40 lines)"
tail -n 40 "$UH/.cache/kawa-theme.log" >>"$BODY" 2>/dev/null
# "kawa-theme: switched to light in 412 ms" — the switch as kawa-theme times it itself
grep -E 'kawa-theme: switched to [a-z]+ in [0-9]+ ms' "$UH/.cache/kawa-theme.log" 2>/dev/null | tail -n 6 >"$TMP/tt"
if [[ -s $TMP/tt ]]; then
  slow=$(sed -nE 's/.*switched to ([a-z]+) in ([0-9]+) ms.*/\2 \1/p' "$TMP/tt" | awk '$1 > 400' | sort -n | tail -n1)
  last=$(sed -nE 's/.*switched to ([a-z]+) in ([0-9]+) ms.*/\2 ms (to \1)/p' "$TMP/tt" | tail -n1)
  if [[ -n $slow ]]; then warn "a theme switch took ${slow% *} ms (to ${slow#* }; over 400 ms) — the last: $last" "send the report (section 5)"
  else good "the theme switches in time (the last: $last)"; fi
else warn "kawa-theme logged no switch time (~/.cache/kawa-theme.log: no 'switched to … in N ms' line)" "switch the theme once (Super+T), then run the report again"; fi

# ════ 6. graphics, monitor, input ════════════════════════════════════════════════════════
sec "6. graphics, the monitor and input devices"
run "PCI devices and their drivers" bash -c 'lspci -k | grep -A3 -iE "vga|3d|display|audio|network|ethernet|usb controller" | head -n 80'
sub "graphics cards (sysfs)"
for c in /sys/class/drm/card[0-9]; do
  [[ -e $c/device ]] || continue
  vram=$(cat "$c/device/mem_info_vram_total" 2>/dev/null)
  say "${c##*/}: driver $(basename "$(readlink -f "$c/device/driver")") · vendor $(cat "$c/device/vendor") device $(cat "$c/device/device") · boot_vga $(cat "$c/device/boot_vga" 2>/dev/null) · vram $(( ${vram:-0} / 1048576 )) MiB"
done
for p in /sys/class/drm/card*-*; do
  [[ -r $p/status ]] || continue
  say "  ${p##*/}: $(cat "$p/status")$( [[ $(cat "$p/status") == connected ]] && printf ' · modes: %s' "$(head -n 3 "$p/modes" | tr '\n' ' ')")"
done
if ((SES)); then
  drm=$(tr '\0' '\n' </proc/"$DWLPID"/environ | sed -n 's/^WLR_DRM_DEVICES=//p')
  say "dwl draws on: ${drm:-(not pinned: wlroots chose)}"
  [[ -n $drm ]] && good "dwl is pinned to $drm" || warn "dwl is not pinned to a card (WLR_DRM_DEVICES unset)" "send the report (section 6)"
  urun "outputs (wlr-randr)" wlr-randr
  cur=$(asu wlr-randr 2>/dev/null | grep -m1 'current' | sed -E 's/.* ([0-9.]+) Hz.*/\1/')
  hz=$(conf MONITOR_HZ)
  say "current refresh: ${cur:-?} Hz · MONITOR_HZ ${hz:-?}"
  [[ -n $cur && -n $hz ]] && { if (( ${cur%.*} + 1 >= hz )); then good "the monitor runs at ${cur} Hz"; else warn "the monitor runs at ${cur} Hz, below MONITOR_HZ=$hz" "check the cable and the monitor's menu; send the report"; fi; }
else
  fail "no desktop session is running (dwl not found for $U)" "log in, then run: fedokawaii report"
fi
run "the kernel on the GPU (amdgpu, drm, firmware)" bash -c 'journalctl -k -b --no-pager | grep -iE "amdgpu|drm|firmware|radeon" | tail -n 80'
ng=$(journalctl -k -b --no-pager 2>/dev/null | grep -ciE 'amdgpu.*(error|fail|timeout|hang|reset)')
((ng)) && fail "the kernel logged $ng amdgpu errors this boot" "send the report (section 6)" || good "no amdgpu errors this boot"
run "input devices" bash -c 'grep -E "^N: Name=" /proc/bus/input/devices | sed "s/^N: Name=//"'
grep -qiE 'xp-pen|ugee|g430|tablet|stylus|pen' /proc/bus/input/devices && good "a tablet/pen is seen by the kernel" || say "(no tablet seen — plugged in?)"
run "USB devices" lsusb

# ════ 7. the session: every part ═════════════════════════════════════════════════════════
sec "7. the desktop session"
run "the login service" systemctl status greetd --no-pager -l
run "the login screen's own log (journal: kawa-greet)" bash -c 'journalctl -b -t kawa-greet --no-pager | tail -n 120'
ngr=$(journalctl -b -t kawa-greet --no-pager 2>/dev/null | grep -ciE 'traceback|error|exception')
((ngr)) && warn "the login screen logged $ngr error lines this boot" "send the report (section 7)"
systemctl is-active --quiet greetd 2>/dev/null && good "greetd is running" || fail "greetd is not running" "run: sudo systemctl start greetd"
sub "the session's programs (running for $U?)"
for p in dwl waybar mako swayidle swaybg pipewire wireplumber pipewire-pulse xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk lxqt-policykit-agent udiskie foot kawa-clipkeep gammastep; do
  n=$(pgrep -u "$U" -x "${p:0:15}" | wc -l)
  say "$(printf '%-24s %s' "$p" "$( ((n)) && echo "running ($n)" || echo MISSING)")"
  ((SES && n == 0)) && case $p in gammastep|swaybg) warn "$p is not running" ;; *) fail "$p is not running" "log out and in; if it stays, send the report (~/.cache/dwl.log is in section 7)" ;; esac
done
pgrep -u "$U" -f kawa-panel >/dev/null && say "kawa-panel               running" || { say "kawa-panel               MISSING"; ((SES)) && fail "kawa-panel (quick settings) is not running" "send the report (~/.cache/kawa-panel.log, section 7)"; }
urun "your services that failed" systemctl --user --failed --no-pager
nuf=$(asu systemctl --user --failed --no-legend 2>/dev/null | grep -c .)
((nuf)) && fail "$nuf of your services failed" "send the report (section 7)"
sub "the session's services (they must be active)"
for u in dwl-session.target graphical-session.target fedokawaii-remind.timer pipewire.service wireplumber.service pipewire-pulse.service xdg-desktop-portal.service; do
  st=$(asu systemctl --user is-active "$u" 2>/dev/null); say "$(printf '%-30s %s' "$u" "${st:-?}")"
  ((SES)) && [[ $st != active ]] && fail "your $u is ${st:-unknown}, not active" "send the report (section 7)"
done
urun "your services' warnings this boot" bash -c 'journalctl --user -b -p warning --no-pager | tail -n 150'
for f in "$UH"/.cache/*.log "$UH"/.cache/*.log.old; do
  [[ -f $f ]] || continue
  sub "${f/#$UH/\~} ($(wc -l <"$f") lines; the last 150)"
  tail -n 150 "$f" >>"$BODY"
  [[ $f == *.old ]] && continue
  ne=$(grep -ciE 'error|traceback|exception|fatal|segfault|crash' "$f")
  ((ne)) && warn "${f/#$UH/\~}: $ne error lines" "section 7 has its last lines"
done
