nno=$(find "$UH" -xdev -not -user "$U" -not -path '*/.cache/*' 2>/dev/null | grep -c .)
((nno)) && warn "$nno files in your home belong to someone else" "run: sudo chown -R $U: ~ (section 18 lists them)"
run "secrets.sh (mode only — never read)" stat -c '%A %U %n' "$UH/.config/fedokawaii/secrets.sh"

# ════ 19. every program, proved ══════════════════════════════════════════════════════════
sec "19. every program, proved"
# NAME | KIND | NEEDS | CHECK | WHAT SUCCESS MEANS
#   KIND  req: the desktop ships it (missing or broken: FAIL) · opt: a choice in
#         fedokawaii.conf (missing: WARN) · ses: needs the running desktop · root: as root
#   NEEDS the program that must be there (~ is your home; - none); CHECK runs as you in the
#         session's environment (bash), 25 s at most; exit 0 is success
SWT=$(cat <<'TABLE'
foot | req | foot | foot --version | prints its version
foot's config | req | foot | foot --check-config | foot.ini (and the theme's) parse
foot server | ses | footclient | footclient --version && ss -xl | grep -qF "$XDG_RUNTIME_DIR/foot-$WAYLAND_DISPLAY.sock" | the terminal server listens (new terminals open at once)
fuzzel | req | fuzzel | fuzzel --version | prints its version
fuzzel's config | req | fuzzel | fuzzel --check-config | fuzzel.ini (and the theme's) parse
mako | ses | makoctl | makoctl mode | mako answers on D-Bus
mako's config | ses | makoctl | makoctl reload | mako takes its config again (no bad key)
waybar | ses | waybar | waybar --version && pgrep -x waybar >/dev/null | waybar runs
sound | ses | wpctl | wpctl status | grep -q Audio | PipeWire answers, with its Audio list
cava | req | cava | cava -v | prints its version
playerctl | req | playerctl | playerctl --version | prints its version
wiremix | req | wiremix | wiremix --version | prints its version
neovim | req | nvim | o=$(timeout 40 nvim --headless -c 'lua vim.defer_fn(function() io.stdout:write(vim.fn.execute("messages")) vim.cmd("qa!") end, 1500)' 2>&1); r=$?; printf '%s\n' "$o"; [ $r = 0 ] && ! grep -qE 'E[0-9]+:|Error|error' <<<"$o" | starts with its config (LazyVim) and no error in :messages
yazi | req | yazi | yazi --version && ya --version | yazi and ya print their versions
yazi's config | req | python3 | for f in ~/.config/yazi/*.toml; do python3 -c 'import sys, tomllib; tomllib.load(open(sys.argv[1], "rb"))' "$f" || exit 1; echo "$f: ok"; done | every TOML file in ~/.config/yazi parses
lazygit | req | lazygit | lazygit --version | prints its version
lazygit's config | req | python3 | python3 -c 'import sys, yaml; yaml.safe_load(open(sys.argv[1])); print("ok")' ~/.config/lazygit/config.yml | config.yml parses
btop | req | btop | btop --version && awk '!/^[[:space:]]*(#|$)/ && !/^[a-z_]+ = /{print "bad line " NR ": " $0; bad=1} END{exit bad}' ~/.config/btop/btop.conf | prints its version; btop.conf is all "key = value" lines
visidata | req | vd | vd --version | prints its version
zathura | ses | zathura | zathura --version | prints its version (and its plugins)
mpv | req | mpv | mpv --version | prints its version
mpv's config | req | mpv | o=$(mpv --msg-level=all=warn --vo=null --ao=null --frames=1 --keep-open=no --idle=no --input-terminal=no 'av://lavfi:testsrc=d=1' 2>&1); r=$?; printf '%s\n' "$o"; [ $r = 0 ] && ! grep -qiE 'error|unknown|invalid' <<<"$o" | plays one frame with mpv.conf loaded, and no option refused
imv | req | imv | ! ldd "$(command -v imv)" | grep 'not found' | its libraries are all there
brave | req | brave-origin | brave-origin --version | prints its version
claude | req | claude | claude --version | prints its version
syncplay | req | ~/.local/bin/syncplay | syncplay --version | prints its version
gtklock | req | gtklock | gtklock --version | prints its version
swayidle | ses | swayidle | pgrep -x swayidle >/dev/null | the idle watcher runs (lock, screens off)
swaybg | ses | swaybg | pgrep -x swaybg >/dev/null | the wallpaper runs
clipboard | ses | wl-copy | t="fedokawaii-report-$$"; wl-copy --primary -- "$t" && sleep 0.3 && [ "$(wl-paste --primary -n)" = "$t" ]; r=$?; wl-copy --primary --clear; exit $r | a text copied (the selection, never your clipboard) comes back
clipboard history | req | cliphist | cliphist version | prints its version
screenshot | ses | grim | f=$(mktemp /tmp/fedokawaii-report.XXXXXX); grim -s 0.25 -t png "$f" && [ -s "$f" ]; r=$?; rm -f "$f"; exit $r | grim takes a picture of the live screen
slurp | req | slurp | ! ldd "$(command -v slurp)" | grep 'not found' | its libraries are all there
satty | req | satty | satty --version | prints its version
outputs | ses | wlr-randr | wlr-randr | lists the monitors
screens off | ses | wlopm | wlopm | lists the monitors' power
wtype | req | wtype | ! ldd "$(command -v wtype)" | grep 'not found' | its libraries are all there
night light | req | gammastep | gammastep -V | prints its version
notices | req | notify-send | notify-send --version | prints its version
udiskie | req | udiskie | udiskie --version | prints its version
bluetooth | req | bluetoothctl | bluetoothctl --version | prints its version
bluetui | req | bluetui | bluetui --version | prints its version
restic | req | restic | restic version | prints its version
snapper | root | snapper | snapper -c root list | lists the system's snapshots
ddcutil | req | ddcutil | ddcutil --version | prints its version
herdr | req | herdr | herdr --version | prints its version
torrra | req | ~/.local/share/pipx/bin/torrra | ~/.local/share/pipx/bin/torrra --version | prints its version
localsend | req | localsend | ! ldd "$(readlink -f "$(command -v localsend)")" | grep 'not found' | its libraries are all there
spotify | opt | spotify | rpm -q spotify-client | built from RPM Fusion's recipe (lpf) and installed
steam | opt | steam | rpm -q steam | installed
xournal++ | ses | xournalpp | xournalpp --version | prints its version
libreoffice | req | libreoffice | libreoffice --version | prints its version
qalculate | req | qalc | qalc -t 6*7 | grep -qx 42 | works a sum out
OCR | req | tesseract | tesseract --list-langs 2>&1 | grep -qx ara && tesseract --list-langs 2>&1 | grep -qx eng | knows Arabic and English
ImageMagick | req | magick | magick -version | prints its version
PDF tools | req | qpdf | qpdf --version && gs --version && pdfinfo -v | qpdf, ghostscript and poppler answer
media | req | ffmpeg | ffmpeg -hide_banner -version && ffprobe -hide_banner -version | ffmpeg and ffprobe print their versions
yt-dlp | req | yt-dlp | yt-dlp --version && node --version | yt-dlp and its JavaScript runtime answer
video decoding | ses | vainfo | vainfo --display drm | VA-API names the card's driver
shell tools | req | fzf | fzf --version && fd --version && rg --version && bat --version && eza --version && zoxide --version && gdu --version && 7z i >/dev/null && file --version && jq --version | fzf, fd, rg, bat, eza, zoxide, gdu, 7z, file and jq answer
git | req | git | git --version && gh --version | git and gh print their versions
shellcheck | req | shellcheck | shellcheck --version | prints its version
tree-sitter | req | tree-sitter | tree-sitter --version | prints its version
podman | req | podman | podman info --format '{{.Host.OS}}' | podman works (Prowlarr runs in it)
the prompt (ble.sh) | req | ~/.local/share/blesh/ble.sh | o=$(bash -ic 'printf "ble.sh %s\n" "${BLE_VERSION:-not loaded}"' 2>&1 </dev/null); r=$?; printf '%s\n' "$o"; [ $r = 0 ] && ! grep -qiE 'error|syntax|not found' <<<"$o" | the shell starts with ble.sh and its settings, without an error
dwl | root | /usr/local/bin/dwl | ! ldd /usr/local/bin/dwl | grep 'not found' | its libraries (its own wlroots) are all there
login screen | root | /usr/local/bin/kawa-greet | python3 -c 'import ast, sys; ast.parse(open(sys.argv[1]).read())' /usr/local/bin/kawa-greet && cage -v | kawa-greet is whole Python; cage answers
kawa-veil | req | kawa-veil | ! ldd "$(command -v kawa-veil)" | grep 'not found' | built, its libraries all there
kawa-clipkeep | req | kawa-clipkeep | ! ldd "$(command -v kawa-clipkeep)" | grep 'not found' | built, its libraries all there
tuned | root | tuned-adm | tuned-adm active | the fedokawaii profile is active
TABLE
)
# every kawa-* helper of the toolkit: --help exits 0
for f in "$TOOLKIT"/bin/kawa-*; do
  [[ -f $f ]] && SWT+=$'\n'"${f##*/} | req | ~/.local/bin/${f##*/} | ${f##*/} --help >/dev/null | --help exits 0"
done
[[ -d $TOOLKIT/bin ]] || fail "the toolkit has no bin/ ($TOOLKIT)" "run: sudo bash $TOOLKIT/setup.sh"
# lib/upstream.sh's binaries not checked above by name
if [[ -r $TOOLKIT/lib/upstream.sh ]]; then
  for b in $(sed -nE 's/^\s*"[^"|]+\|[^"]*\|([^"|]*)"\s*$/\1/p' "$TOOLKIT/lib/upstream.sh"); do
    grep -qE "^[^|]*\| [a-z]+ \| (~/.local/bin/)?$b \|" <<<"$SWT" || grep -q "$b --version" <<<"$SWT" \
      || SWT+=$'\n'"$b | req | ~/.local/bin/$b | $b --version | prints its version"
  done
else fail "lib/upstream.sh is missing from the toolkit" "run: sudo bash $TOOLKIT/setup.sh"; fi

SW=$TMP/sw; mkdir -m 0777 "$SW"
# shellcheck disable=SC2016  # (the check's own shell expands it)
CHK='n=${1/#\~/$HOME}; [ "$1" = - ] || command -v -- "$n" >/dev/null || { echo "(not installed: $1)"; exit 127; }; eval "$2"'
n=0
while IFS= read -r line; do
  [[ -n $line ]] || continue
  n=$((n + 1))
  name=${line%% | *}; rest=${line#* | }; kind=${rest%% | *}; rest=${rest#* | }
  need=${rest%% | *}; rest=${rest#* | }; mean=${rest##* | }; ck=${rest% | *}
  printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$kind" "$need" "$ck" "$mean" >"$SW/$n.def"
  if [[ $kind == ses ]] && ((SES == 0)); then echo 200 >"$SW/$n.rc"; continue; fi
  while (($(jobs -rp | wc -l) >= 8)); do wait -n; done
  {
    t0=$EPOCHREALTIME
    if [[ $kind == root ]]; then HOME=/root timeout 45 bash -c "$CHK" _ "${need/#\~/$UH}" "$ck" >"$SW/$n.out" 2>&1 </dev/null
    else asu timeout 45 bash -c "$CHK" _ "$need" "$ck" >"$SW/$n.out" 2>&1 </dev/null; fi
    echo $? >"$SW/$n.rc"; ms_since "$t0" >"$SW/$n.ms"
  } &
done <<<"$SWT"
# the packages themselves: every one the manifest installs here is there, its files whole
if [[ -r $TOOLKIT/lib/manifest.sh ]]; then
  ( export STEAM SPOTIFY STATE_DIR=$STATE; STEAM=$(conf STEAM) SPOTIFY=$(conf SPOTIFY)
    # shellcheck source=/dev/null
    . "$TOOLKIT/lib/manifest.sh" && manifest_all "$(cat "$STATE/gpu" 2>/dev/null)" ) >"$TMP/pkgs" 2>"$TMP/pkgs.err" \
    || fail "lib/manifest.sh gives no package list" "send the report"
  { while IFS= read -r p; do
      [[ -n $p ]] || continue
      if ! rpm -q --quiet "$p"; then echo "NOT INSTALLED $p"; continue; fi
      rpm -V --nofiledigest --nomtime --nouser --nogroup --nomode --nordev --nosize "$p" | grep '^missing' | grep -vE '^missing +[cdgl] ' | sed "s|^|$p: |"
    done <"$TMP/pkgs" >"$TMP/rpmv"; } &
else fail "lib/manifest.sh is missing from the toolkit: the packages are not checked" "run: sudo bash $TOOLKIT/setup.sh"; fi
wait
sub "the packages lib/manifest.sh installs ($(grep -c . "$TMP/pkgs" 2>/dev/null) here): installed, no file missing"
if [[ -s $TMP/pkgs ]]; then
  cap <"$TMP/rpmv" >>"$BODY"
  np=$(grep -c '^NOT INSTALLED' "$TMP/rpmv"); nm=$(grep -vc '^NOT INSTALLED' "$TMP/rpmv")
  if ((np)); then fail "$np packages of the manifest are not installed" "run: fedokawaii repair"; sed -n 's/^NOT INSTALLED //p' "$TMP/rpmv" | tr '\n' ' ' | fold -s -w 90 | detail; fi
  if ((nm)); then fail "$nm files of the manifest's packages are missing" "run: sudo dnf reinstall <the package>"; grep -v '^NOT INSTALLED' "$TMP/rpmv" | detail; fi
  ((np + nm)) || good "all $(grep -c . "$TMP/pkgs") packages of the manifest are installed, none missing a file"
fi
sub "each program, run (name · result · time · what success means)"
nok=0 nbad=0
for ((i = 1; i <= n; i++)); do
  IFS=$'\t' read -r name kind need ck mean <"$SW/$i.def"
  r=$(cat "$SW/$i.rc" 2>/dev/null); ms=$(cat "$SW/$i.ms" 2>/dev/null)
  case $r in
    0)   st=ok; nok=$((nok + 1)) ;;
    200) st="skipped (no desktop session)" ;;
    127) if [[ $kind == opt ]]; then st="not installed (optional)"; warn "$name is not installed (optional)" "set it in fedokawaii.conf, then: fedokawaii apply"
         elif grep -q '^(not installed' "$SW/$i.out"; then st="NOT INSTALLED"; nbad=$((nbad + 1)); fail "$name is not installed" "run: fedokawaii repair"
         else st="BROKEN (exit 127)"; nbad=$((nbad + 1)); fail "$name: installed but broken (exit 127)" "send the report (section 19)"; detail <"$SW/$i.out"; fi ;;
    124) st="BROKEN (no answer in 45 s)"; nbad=$((nbad + 1)); fail "$name: installed but hangs (no answer in 45 s)" "send the report (section 19)" ;;
    *)   st="BROKEN (exit $r)"; nbad=$((nbad + 1)); fail "$name: installed but broken (exit $r)" "send the report (section 19)"; detail <"$SW/$i.out" ;;
  esac
  say "$(printf '%-22s %-26s %6s ms   %s' "$name" "$st" "${ms:--}" "$mean")"
  if [[ $r != 0 && $r != 200 ]]; then { printf '    $ %s\n' "$ck"; sed 's/^/    /' "$SW/$i.out" | cap 30; } >>"$BODY"; fi
done
((nbad == 0)) && good "every program checked works ($nok run)"

# ════ the report ══════════════════════════════════════════════════════════════════════════
took=$(ms_since "$START")
{
  echo "fedokawaii health report — $(date '+%Y-%m-%d %H:%M:%S %Z') — $(hostname) — for $U"
  echo "made by fedokawaii-report in $((took / 1000)) s$( ((QUICK)) && echo ' (--quick: no timed tests)')"
  echo
  if ((FAILS)); then echo "VERDICT: BROKEN — $FAILS failures, $WARNS warnings"
  elif ((WARNS)); then echo "VERDICT: WORKS, WITH WARNINGS — $WARNS warnings"
  else echo "VERDICT: HEALTHY — nothing failed, no warnings"; fi
  echo
  echo "── findings by area (FAIL, then WARN; → what to do or send) ─────────────────────"
  while IFS= read -r a; do
    awk -F'\t' -v a="$a" '$1 == a' "$FIND" >"$TMP/fa"
    grep -qP '\t(FAIL|WARN)\t' "$TMP/fa" || continue
    printf '\n%s\n' "$a"
    awk -F'\t' '
      $2 == "FAIL" || $2 == "WARN" { lvl = $2; printf "  %-4s  %s\n", $2, $3; if ($4 != "") printf "          → %s\n", $4; keep = 1; next }
      $2 == "detail" { if (keep) print $3; next }
      { keep = 0 }' "$TMP/fa" | awk '/^  FAIL/ { f = 1 } { print }'
  done <"$TMP/areas"
  echo
  echo "── fine ─────────────────────────────────────────────────────────────────────────"
  awk -F'\t' '$2 == "ok" { printf "  ok    %s\n", $3 }' "$FIND"
  cat "$BODY"
} | sed -E 's/((password|passwd|passphrase|secret|token|api[_-]?key|psk|RESTIC_PASSWORD)[A-Za-z_]*[[:space:]]*[=:][[:space:]]*)[^[:space:]]+/\1●●●/Ig; s/(Bearer[[:space:]]+)[^[:space:]]+/\1●●●/Ig' >"$TMP/report"
install -m 0600 -o "$U" -g "$(id -gn "$U")" "$TMP/report" "$OUT"
echo "fedokawaii-report: $OUT ($(wc -l <"$OUT") lines) — $( ((FAILS)) && echo "BROKEN: $FAILS failures, $WARNS warnings" || { ((WARNS)) && echo "works, $WARNS warnings" || echo healthy; })"
# run from a stick: a copy beside the script too, to carry back
here=$(cd "$(dirname "$0")" && pwd)
if [[ $here != /usr/local/* && -w $here ]]; then cp "$OUT" "$here/fedokawaii-report.txt" && echo "fedokawaii-report: also $here/fedokawaii-report.txt"; fi
exit 0
