# ════ 13. sleep and the lock ═════════════════════════════════════════════════════════════
sec "13. sleep and the lock"
# the kernel's and systemd's sleep lines, and the lock's own (kawa-power and kawa-lock: "sleep
# requested", "lock up", "resumed", "locker exited rc=N"), the boot before and this one
{ journalctl -b -1 -o short-unix --no-pager 2>/dev/null; journalctl -b -o short-unix --no-pager 2>/dev/null; } \
  | grep -E 'systemd-sleep|PM: suspend (entry|exit)|Suspending system|System returned from sleep|[Ff]ailed to (suspend|put system to sleep)|suspend.*(failed|aborted)|Some devices failed to suspend| kawa-(power|lock)(\[[0-9]+\])?: ' >"$TMP/sleep"
sub "SLP-02/03 sleep, resume and the lock (the boot before and this one)"
awk '{ $1 = strftime("%F %T", $1); print }' "$TMP/sleep" | cap >>"$BODY"; [[ -s $TMP/sleep ]] || say "(no sleep this boot or the one before)"
nsl=$(grep -c 'PM: suspend entry' "$TMP/sleep")
nsf=$(grep -cE '[Ff]ailed to (suspend|put system to sleep)|suspend.*(failed|aborted)|Some devices failed to suspend' "$TMP/sleep")
((nsf)) && { fail "sleep failed $nsf times" "send the report"; grep -E 'ailed|aborted' "$TMP/sleep" | cut -d' ' -f2- | detail; }
if ((nsl)); then
  if grep -qE ' kawa-(power|lock)' "$TMP/sleep"; then
    # each sleep: the locker up before the kernel suspends (and long enough before it to have
    # drawn: 0.3 s), and not gone before the resume
    awk '/ kawa-(power|lock).*lock up/ { lock = 1; up = $1 }
         / kawa-(power|lock).*locker exited/ { if (asleep) bad = bad "the locker exited while asleep: " $0 "\n"; lock = 0
                                        if ($0 !~ /rc=0/) crash = crash $0 "\n" }
         /PM: suspend entry/ { asleep = 1; if (!lock) bad = bad "suspended with no lock up: " $0 "\n"
                               else if ($1 - up < 0.3) late = late sprintf("the lock came %.2f s before the suspend: %s\n", $1 - up, $0) }
         /PM: suspend exit/  { asleep = 0 }
         END { printf "%s", bad > "/dev/stderr"; printf "%s", crash; printf "%s", late > "'"$TMP/late"'" }' "$TMP/sleep" >"$TMP/crash" 2>"$TMP/unlocked"
    if [[ -s $TMP/unlocked ]]; then fail "SLP-02 the session was unlocked while asleep" "send the report at once"; detail <"$TMP/unlocked"
    else good "SLP-02 $nsl sleeps, each with the screen locked"; fi
    [[ -s $TMP/crash ]] && { fail "the locker exited with an error (the screen was left open)" "send the report"; detail <"$TMP/crash"; }
    [[ -s $TMP/late ]] && { warn "SLP-03 the lock came less than 0.3 s before a sleep (the desktop can flash at the wake)" "send the report"; detail <"$TMP/late"; }
  else
    warn "SLP-02 $nsl sleeps, but the lock (kawa-power, kawa-lock) logged nothing about them" "update the toolkit (fedokawaii update); send the report"
  fi
else say "(no suspend entry found)"; fi

