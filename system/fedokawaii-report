echo "fedokawaii-report: $NCK checks and the machine's logs — this takes a few minutes" >&2
run_checks & CKPID=$!

# ════ 0. the report itself: whose session it reads ═══════════════════════════════════════
sec "0. the report itself"
say "user $U (uid $UID_), home $UH · dwl ${DWLPID:-not running} · waybar ${WBPID:-not running}"
say "ENV-01/02 the session's environment: ${SENVSRC:-none} — $(printf '%s ' "${SENV[@]%%=*}")"
if ((SES)) && [[ -z $SENVSRC ]]; then
  fail "ENV-01 the session's environment could not be read (no program of the desktop holds WAYLAND_DISPLAY, and not one socket): every check of the live desktop is blind" "send the report"
elif ((SES)); then good "ENV-01 the session's environment, from $SENVSRC"; fi

# ════ 1. the system ══════════════════════════════════════════════════════════════════════
sec "1. the system and the toolkit"
run "release" cat /etc/os-release
run "kernel" uname -a
run "kernel arguments" cat /proc/cmdline
run "up since" uptime
run "setup's state ($STATE: its small records, not the settings files)" bash -c "for f in $STATE/*; do [[ -f \$f && \$f != *.conf* && \$(stat -c %s \"\$f\") -lt 4096 ]] && printf '%-28s %s\n' \"\${f##*/}\" \"\$(tr '\n' ' ' <\"\$f\")\"; done"
phase=$(cat "$STATE/phase" 2>/dev/null)
if [[ $phase == "done" ]]; then good "setup finished (phase done)"
else fail "setup did not finish: phase is '${phase:-none}'" "run: sudo bash $TOOLKIT/setup.sh"; fi
[[ -e /etc/systemd/system/fedokawaii-resume.service ]] && warn "the resume unit is still installed (setup expects to continue at the next start)" "run: sudo bash $TOOLKIT/setup.sh"
run "the toolkit" bash -c "ls -la $TOOLKIT | head -n 40"
run "settings (fedokawaii.conf, secrets left out)" grep -vE '^[[:space:]]*(#|$)' "$TOOLKIT/fedokawaii.conf"
[[ -d $TOOLKIT/bin ]] || fail "the toolkit has no bin/ ($TOOLKIT): the kawa-* helpers are not checked" "run: sudo bash $TOOLKIT/setup.sh"
[[ -r $TOOLKIT/lib/upstream.sh ]] || fail "lib/upstream.sh is missing from the toolkit: the upstream tools are not checked" "run: sudo bash $TOOLKIT/setup.sh"

# ════ 2. the start-up ════════════════════════════════════════════════════════════════════
sec "2. the boot and the console"
run "time to start" systemd-analyze
run "slowest units" bash -c 'systemd-analyze blame | head -n 25'
run "critical chain" systemd-analyze critical-chain
run "last starts" bash -c 'journalctl --list-boots --no-pager | tail -n 6'
t=$(systemd-analyze 2>/dev/null | sed -n 's/.*= \([0-9.]*\)s$/\1/p' | head -n1)
[[ -n $t ]] && { if (( ${t%.*} > 60 )); then warn "start-up took ${t}s (over a minute)" "send the report: it names the slow units"; else good "start-up took ${t}s"; fi; }
pt=$(plymouth-set-default-theme 2>/dev/null)
say "the boot splash (plymouth-set-default-theme): ${pt:-(none)}"
lsinitrd 2>/dev/null | grep -i plymouth >"$TMP/initrd"
sub "the splash in the running kernel's initramfs (lsinitrd | grep plymouth)"; cap 60 <"$TMP/initrd" >>"$BODY"
after=$(systemctl show greetd.service -p After --value 2>/dev/null)
say "greetd starts after: $after"
if [[ " $after " == *" plymouth-quit-wait.service "* ]]; then good "the login screen waits for the splash to end (After=plymouth-quit-wait.service)"
else fail "greetd is not ordered after plymouth-quit-wait.service: the splash and the login screen fight over the screen" "run: fedokawaii repair"; fi
# the timeline of this boot, from the kernel's start (seconds): each mark the first of this
# boot, but the login: the last one (the session running now); dwl's own start from its age
sub "the timeline of this start (seconds from the kernel's start)"
journalctl -b -o short-monotonic --no-pager 2>/dev/null >"$TMP/jb"
mono() { sed -n 's/^\[ *\([0-9]*\.[0-9]*\)\].*/\1/p' | head -n1; }
t_ply=$(grep -m1 -E 'plymouth-quit-wait.service|Hold until boot process finishes up' "$TMP/jb" | mono)
t_gf=$(grep -m1 -E 'Failed to start greetd' "$TMP/jb" | mono)
t_gd=$(grep -E 'Started (greetd.service|.*[Gg]reeter daemon)' "$TMP/jb" | tail -n1 | mono)
t_gr=$(grep -m1 -E ' kawa-greet(\[[0-9]+\])?: |session opened for user greetd' "$TMP/jb" | mono)
t_fr=$(grep -m1 -iE ' kawa-greet(\[[0-9]+\])?: .*(first frame|shown|drawn)' "$TMP/jb" | mono)
t_lg=$(grep -E "pam_unix\(greetd:session\): session opened for user $U" "$TMP/jb" | tail -n1 | mono)
t_dwl=""
if ((SES)); then
  up=$(cut -d' ' -f1 /proc/uptime); et=$(ps -o etimes= -p "$DWLPID" | tr -d ' ')
  [[ -n $et ]] && t_dwl=$(awk -v u="$up" -v e="$et" 'BEGIN { printf "%.1f", u - e }')
fi
{
  printf '%-48s %s\n' "the kernel starts" 0
  printf '%-48s %s\n' "the splash ends (plymouth-quit-wait)" "${t_ply:-?}"
  [[ -n $t_gf ]] && printf '%-48s %s\n' "greetd FAILED to start (the first time)" "$t_gf"
  printf '%-48s %s\n' "greetd started (the last start)" "${t_gd:-?}"
  printf '%-48s %s\n' "the login screen's first line (kawa-greet)" "${t_gr:-?}"
  printf '%-48s %s\n' "the login screen's first frame" "${t_fr:-? (kawa-greet logs no frame line)}"
  printf '%-48s %s\n' "your login (greetd's session, the last this boot)" "${t_lg:-?}"
  printf '%-48s %s\n' "dwl started (this session)" "${t_dwl:-?}"
} >>"$BODY"
tg=${t_fr:-$t_gr}
if [[ -n $tg ]]; then
  if (( ${tg%.*} > 30 )); then warn "the login screen came ${tg%.*} s after the kernel started (over 30 s)" "send the report"
  else good "the login screen came ${tg%.*} s after the kernel started"; fi
fi
sub "LOGIN-06 logout → login screen (each logout this boot and the one before; the greeter's own line, or its session)"
{ journalctl -b -1 -o short-unix --no-pager 2>/dev/null; journalctl -b -o short-unix --no-pager 2>/dev/null; } \
  | grep -E "session closed for user $U| kawa-greet(\[[0-9]+\])?: |session opened for user greetd" \
  | awk -v u="$U" '$0 ~ "session closed for user " u { c = $1; next }
                   c != "" { printf "logout at %s → login screen %.1f s later\n", strftime("%F %T", c), $1 - c; c = "" }' >"$TMP/gaps"
cap <"$TMP/gaps" >>"$BODY"; [[ -s $TMP/gaps ]] || say "(no logout found)"
gmax=$(awk '{ for (i = 1; i <= NF; i++) if ($i == "screen") print $(i + 1) }' "$TMP/gaps" | sort -n | tail -n1)
[[ -n $gmax ]] && { if (( ${gmax%.*} > 3 )); then warn "LOGIN-06 a logout took ${gmax} s to show the login screen (over 3 s)" "send the report"; else good "LOGIN-06 logout → login screen within ${gmax} s"; fi; }

# ════ 3. the install's own log ═══════════════════════════════════════════════════════════
sec "3. the install's log"
if [[ -r $LOG ]]; then
  say "$LOG: $(stat -c %s "$LOG") bytes, $(wc -l <"$LOG") lines"
  nf=$(grep -c '✘' "$LOG"); nw=$(grep -ciE '(^|[^a-z])warn(ing)?' "$LOG"); ne=$(grep -ciE '(^|[^a-z])(error|failed|fatal)' "$LOG")
  say "lines with ✘: $nf · with warning: $nw · with error/failed/fatal: $ne"
  sub "every ✘ line, with the 6 lines before it"
  grep -n -B6 '✘' "$LOG" | tailcap >>"$BODY"
  sub "every error and warning line (with the line before it)"
  grep -n -B1 -iE '(^|[^a-z])(warn(ing)?|error|failed|fatal|refus|timed out|denied)' "$LOG" | tailcap >>"$BODY"
  sub "the run's steps (✔ / ✘ lines; the last $MAXL)"
  grep -nE '✔|✘|── [0-9]\.[0-9]' "$LOG" | tailcap >>"$BODY"
  sub "the last $MAXL lines"
  tailcap <"$LOG" >>"$BODY"
  ((nf)) && warn "UPK-06 the install's log has $nf ✘ lines (earlier attempts included)" "they are in the report, each with what led to it"
else
  fail "the install's log $LOG is missing" "send the report"
fi

# ════ 4. verify — the install proved ═════════════════════════════════════════════════════
sec "4. verify"
if [[ -r $TOOLKIT/verify.sh ]]; then
  pw=$(asu systemctl --user is-active prowlarr.service 2>/dev/null)
  timeout 300 bash "$TOOLKIT/verify.sh" >"$TMP/verify" 2>&1; vr=$?
  # (verify starts Prowlarr to prove it starts: back to sleep, unless it was running before)
  [[ $pw == active ]] || asu systemctl --user stop --no-block prowlarr.service >/dev/null 2>&1
  say "\$ sudo bash $TOOLKIT/verify.sh"; cap 400 <"$TMP/verify" >>"$BODY"; say "[exit $vr]"
  vf=$(grep -c '✘' "$TMP/verify"); vw=$(grep -ciE '⚠|warning' "$TMP/verify")
  if ((vr == 0 && vf == 0)); then good "verify passed ($(grep -c '✔' "$TMP/verify") checks, $vw warnings)"
  else fail "verify: $vf checks failed (exit $vr)" "each ✘ says what to do; else send the report"; grep '✘' "$TMP/verify" | detail; fi
  ((vw)) && warn "verify: $vw warnings" "they are in the report"
else fail "verify.sh is missing from $TOOLKIT" "run: sudo bash $TOOLKIT/setup.sh"; fi

# ════ 5. login and the session ═══════════════════════════════════════════════════════════
sec "5. login and the session"
run "the login service" systemctl status greetd --no-pager -l
run "the login screen's own log (journal: kawa-greet)" bash -c 'journalctl -b -t kawa-greet --no-pager | tail -n 120'
ngr=$(journalctl -b -t kawa-greet --no-pager 2>/dev/null | grep -ciE 'traceback|error|exception')
((ngr)) && warn "the login screen logged $ngr error lines this boot" "send the report"
journalctl -b -u greetd.service --no-pager 2>/dev/null | grep -E 'Failed|start-limit|Start request repeated' >"$TMP/gdf"
if [[ -s $TMP/gdf ]]; then
  warn "LOGIN-02 greetd failed to start $(grep -c 'Failed to start' "$TMP/gdf") times this boot (the console showed until it came)" "send the report (LOGIN-05 says what it found)"; detail <"$TMP/gdf"
fi
run "greetd's config" bash -c 'grep -vE "^[[:space:]]*(#|$)" /etc/greetd/fedokawaii.toml'
run "the sessions logind knows" loginctl list-sessions --no-pager

# ════ 6. dwl: layouts, VRR, its log ═════════════════════════════════════════════════════
sec "6. dwl and the keys"
DL=$UH/.cache/dwl.log
run "VRR and layout lines (~/.cache/dwl.log)" grep -E 'vrr:|layout' "$DL"
grep -E 'vrr: .* has no adaptive sync' "$DL" 2>/dev/null | while IFS= read -r l; do say "($l)"; done
run "the layout each monitor shows now" bash -c "for f in /run/user/$UID_/dwl-bar/*/layout.json /run/user/$UID_/dwl-bar/layout.json; do [ -f \"\$f\" ] && printf '%s: %s\n' \"\$f\" \"\$(cat \"\$f\")\"; done"
run "animation and fade settings in config.h (code, not comments)" bash -c "grep -nE '^[^/*]*\b(anim|fade)' '$UH/.local/src/dwl/config.h' || echo '(none)'"
sub "dwl's log, the last $MAXL lines"
[[ -f $DL ]] && tailcap <"$DL" >>"$BODY"
sub "the session before (~/.cache/dwl.log.old, the last 150)"
tail -n 150 "$DL.old" >>"$BODY" 2>/dev/null

# ════ 8. graphics, monitor, input ════════════════════════════════════════════════════════
sec "8. graphics, the monitor and input"
run "PCI devices and their drivers" bash -c 'lspci -k | grep -A3 -iE "vga|3d|display|audio|network|ethernet|usb controller" | head -n 80'
sub "graphics cards (sysfs)"
for c in /sys/class/drm/card[0-9]; do
  [[ -e $c/device ]] || continue
  vram=$(cat "$c/device/mem_info_vram_total" 2>/dev/null)
  say "${c##*/}: driver $(basename "$(readlink -f "$c/device/driver")") · vendor $(cat "$c/device/vendor") device $(cat "$c/device/device") · boot_vga $(cat "$c/device/boot_vga" 2>/dev/null) · vram $(( ${vram:-0} / 1048576 )) MiB"
done
for p in /sys/class/drm/card*-*; do
  [[ -r $p/status ]] || continue
  say "  ${p##*/}: $(cat "$p/status")$( [[ $(cat "$p/status") == connected ]] && printf ' · modes: %s' "$(head -n 3 "$p/modes" | tr '\n' ' ')")"
done
if ((SES)); then
  drm=$(tr '\0' '\n' </proc/"$DWLPID"/environ | sed -n 's/^WLR_DRM_DEVICES=//p')
  say "dwl draws on: ${drm:-(not pinned: wlroots chose)}"
  [[ -n $drm ]] && good "dwl is pinned to $drm" || warn "dwl is not pinned to a card (WLR_DRM_DEVICES unset)" "send the report"
  urun "outputs (wlr-randr)" wlr-randr
else
  fail "no desktop session is running (dwl not found for $U)" "log in, then run: fedokawaii report"
fi
run "the kernel on the GPU (amdgpu, drm, firmware)" bash -c 'journalctl -k -b --no-pager | grep -iE "amdgpu|drm|firmware|radeon" | tail -n 80'
journalctl -k -b -p err --no-pager 2>/dev/null | grep -iE 'amdgpu|drm' | grep -v 'Overdrive is enabled' >"$TMP/gpuerr"
ng=$(grep -c . "$TMP/gpuerr")
if ((ng)); then fail "the kernel logged $ng errors about the graphics card this boot" "send the report"; detail <"$TMP/gpuerr"
else good "no graphics errors from the kernel this boot (amdgpu's Overdrive notice aside: LACT needs it)"; fi
run "input devices" bash -c 'grep -E "^N: Name=" /proc/bus/input/devices | sed "s/^N: Name=//"'
run "USB devices" lsusb

# ════ 9. the session's programs ═════════════════════════════════════════════════════════
sec "9. the session's programs"
sub "the session's programs (running for $U? each matched by its whole command)"
# (comm is cut at 15 characters — the three portals would all be "xdg-desktop-por" — so each
# is matched by its command line; gammastep runs while the night light is on)
for p in dwl waybar mako swayidle swaybg pipewire wireplumber pipewire-pulse \
         /usr/libexec/xdg-desktop-portal /usr/libexec/xdg-desktop-portal-wlr /usr/libexec/xdg-desktop-portal-gtk \
         /usr/libexec/lxqt-policykit-agent udiskie 'foot --server' kawa-clipkeep gammastep 'python3 .*kawa-panel'; do
  n=$(pgrep -u "$U" -f "^(/usr/bin/|/usr/local/bin/|$UH/.local/bin/)?${p}( |\$)" | wc -l)
  say "$(printf '%-40s %s' "$p" "$( ((n)) && echo "running ($n)" || echo MISSING)")"
  ((SES)) || continue
  case $p in
    gammastep) if ((n == 0)); then   # (autostart starts it; quick settings may have turned it off)
                 ge=$(grep -iE 'gammastep|gamma' "$UH/.cache/dwl.log" 2>/dev/null | grep -iE 'error|fail|could not|unable|not supported' | tail -n 3)
                 if [[ -n $ge ]]; then fail "gammastep (the night light) stopped with an error" "turn the night light on in quick settings; if it stops again, send the report"; detail <<<"$ge"
                 else say "  (the night light is off: quick settings turned it off, or it stopped without a word)"; fi
               fi ;;
    swaybg) ((n == 0)) && warn "swaybg (the wallpaper) is not running" "run: kawa-wallpaper" ;;
    waybar) ((n > 1)) && { fail "$n waybar processes run: the bar is doubled (laggy icons, a stuck cat)" "log out and in; if it comes back, send the report"; ps -o pid=,ppid=,etimes=,stat=,args= -C waybar | detail; }
            ((n == 0)) && fail "waybar is not running" "log out and in" ;;
    *) ((n == 0)) && fail "${p##*/} is not running" "log out and in; if it stays, send the report (dwl.log is in it)" ;;
  esac
done
urun "your services that failed" systemctl --user --failed --no-pager
nuf=$(asu systemctl --user --failed --no-legend 2>/dev/null | grep -c .)
((nuf)) && { fail "$nuf of your services failed" "send the report"; asu systemctl --user --failed --no-legend 2>/dev/null | detail; }
sub "the session's services (they must be active)"
for u in dwl-session.target graphical-session.target fedokawaii-remind.timer pipewire.service wireplumber.service pipewire-pulse.service xdg-desktop-portal.service; do
  st=$(asu systemctl --user is-active "$u" 2>/dev/null); say "$(printf '%-30s %s' "$u" "${st:-?}")"
  ((SES)) && [[ $st != active ]] && fail "your $u is ${st:-unknown}, not active" "log out and in; if it stays, send the report"
done
sub "Prowlarr (it starts on demand) and podman's wait for the network"
urun "their state" systemctl --user status prowlarr.service podman-user-wait-network-online.service --no-pager -l
urun "their journal this boot" bash -c 'journalctl --user -b -u prowlarr.service -u podman-user-wait-network-online.service --no-pager | tail -n 80'
urun "your services' warnings this boot" bash -c 'journalctl --user -b -p warning --no-pager | tail -n 150'
for f in "$UH"/.cache/*.log; do
  [[ -f $f && $f != */dwl.log ]] || continue
  sub "${f/#$UH/\~} ($(wc -l <"$f") lines; the last 150)"
  tail -n 150 "$f" >>"$BODY"
  ne=$(grep -ciE 'error|traceback|exception|fatal|segfault|crash' "$f")
  if ((ne)); then
    warn "${f/#$UH/\~}: $ne error lines" "the most frequent below; the log's tail is in the report"
    grep -iE 'error|traceback|exception|fatal|segfault|crash' "$f" | sed -E 's/[0-9]+/N/g; s/^\[[^]]*\] *//' | cut -c1-100 | sort | uniq -c | sort -rn | head -n 4 | detail
  fi
done
urun "the session's bus: portals, notices, players" bash -c 'busctl --user list --no-pager | grep -iE "portal|notifications|mpris" | head -n 20'

# ════ 10. the journal: errors, warnings, crashes, denials ════════════════════════════════
sec "10. the journal and the system's health"
run "system units that failed" systemctl --failed --no-pager
if nsf=$(systemctl --failed --no-legend 2>/dev/null | grep -c .); [[ -d /run/systemd/system ]]; then
  ((nsf)) && fail "$nsf system units failed" "send the report" || good "no system unit failed"
fi
sub "errors this boot (most frequent first)"
journalctl -b -p err --no-pager -o cat 2>/dev/null | sed 's/[0-9]\{2,\}/N/g' | sort | uniq -c | sort -rn | head -n 60 >>"$BODY"
nerr=$(journalctl -b -p err --no-pager -o cat 2>/dev/null | grep -c .)
sub "errors this boot (as they came, the last $MAXL)"
journalctl -b -p err --no-pager 2>/dev/null | tailcap >>"$BODY"
sub "warnings this boot (most frequent first)"
journalctl -b -p warning --no-pager -o cat 2>/dev/null | sed 's/[0-9]\{2,\}/N/g' | sort | uniq -c | sort -rn | head -n 80 >>"$BODY"
nwarn=$(journalctl -b -p warning --no-pager -o cat 2>/dev/null | grep -c .)
say "this boot: $nerr error lines, $nwarn warning-or-worse lines"
((nerr > 0)) && warn "SYS-01 the journal has $nerr error lines this boot" "they are in the report, grouped"
run "the boot before: errors" bash -c 'journalctl -b -1 -p err --no-pager | tail -n 120'
run "crashes (coredumps, all of them)" coredumpctl list --no-pager
# crashes by program: a desktop program's since setup finished is a FAIL, another's a WARN;
# the ones before setup finished (a package's scriptlet as it installed) are listed only
coredumpctl list --no-legend --no-pager 2>/dev/null >"$TMP/cores"
if [[ -s $TMP/cores ]]; then
  sd=$(cat "$STATE/setup-done" 2>/dev/null)
  # (a line: DAY DATE TIME TZ PID UID GID SIG COREFILE EXE SIZE)
  awk -v sd="${sd:-0}" '{ split($2 " " $3, a, /[-: ]/); t = mktime(a[1] " " a[2] " " a[3] " " a[4] " " a[5] " " a[6]); k = $10 "\t" $6 "\t" (t >= sd ? "after" : "before"); n[k]++; if (!(k in f)) f[k] = $2 " " $3; l[k] = $2 " " $3; g[k] = $8 }
       END { for (k in n) printf "%s\t%d\t%s\t%s\t%s\n", k, n[k], f[k], l[k], g[k] }' "$TMP/cores" | sort -t$'\t' -k4,4nr >"$TMP/coreg"
  dnf history list 2>/dev/null >"$TMP/dnfh"
  sub "crashes by program and user: its package, and the dnf transaction last begun before the first"
  while IFS=$'\t' read -r exe uid when cnt first last sig; do
    pkg=$(rpm -qf "$exe" 2>&1 | head -n1)
    tx=$(awk -v t="$first" '$1 ~ /^[0-9]+$/ && match($0, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]/) {
                              d = substr($0, RSTART, 19); if (d !~ /:[0-9][0-9]:[0-9][0-9]$/) d = substr(d, 1, 16) ":00"
                              if (d <= t && d > best) { best = d; id = $1; line = $0 } }
                            END { if (id != "") printf "%s\t%s", id, line }' "$TMP/dnfh")
    say "$cnt × $sig  $exe  (uid $uid, $pkg)  $first → $last  [$when setup finished]"
    if [[ -n $tx ]]; then
      say "  the dnf transaction last begun before it: ${tx#*$'\t'}"
      dnf history info "${tx%%$'\t'*}" 2>&1 | cap 40 | sed 's/^/    /' >>"$BODY"
    fi
    [[ $when == before ]] && continue
    msg="SYS-02 $exe crashed $cnt times ($sig, $first$( [[ $last != "$first" ]] && echo " → $last"))"
    case ${exe##*/} in
      dwl|waybar|mako|foot|footclient|kawa-*|pipewire*|wireplumber|xdg-desktop-portal*|gtklock|swayidle|swaybg|Xwayland|cage|python3*|fuzzel|udiskie|gammastep)
        fail "$msg" "send the report (its package and what dnf was doing then are in it)" ;;
      *) warn "$msg" "send the report if it happens again" ;;
    esac
    { echo "package: $pkg"; [[ -n $tx ]] && echo "the dnf transaction last begun before it: ${tx%%$'\t'*}: $(sed -E 's/^ *[0-9]+ +//; s/ {2,}/ · /g; s/ +$//' <<<"${tx#*$'\t'}")"; } | detail
  done <"$TMP/coreg"
fi
sub "SELinux denials this boot"
journalctl -b --no-pager 2>/dev/null | grep -E 'avc: +denied' | tail -n 80 >>"$BODY"
run "SELinux mode" getenforce

# ════ 11. network, mirrors, speed ════════════════════════════════════════════════════════
sec "11. the network"
run "devices" nmcli -f DEVICE,TYPE,STATE,CONNECTION device
run "addresses" ip -br address
run "routes" ip route
run "DNS" bash -c 'resolvectl status --no-pager | head -n 40'
sub "reachable? (TLS handshake time, HTTP status)"
for u in https://mirrors.fedoraproject.org/ https://download1.rpmfusion.org/ https://codeberg.org/ https://github.com/ https://brave-browser-rpm-release.s3.brave.com/ https://downloads.claude.ai/ https://copr.fedorainfracloud.org/; do
  r=$(curl -sS -o /dev/null --max-time 15 -w '%{http_code} %{time_connect}s connect · %{time_total}s total' "$u" 2>&1)
  say "$(printf '%-48s %s' "$u" "$r")"
  [[ $r =~ ^[1-5][0-9][0-9]( |$) ]] || fail "unreachable: $u ($r)" "check the network; send the report"   # (any HTTP answer: the server is there)
done
fv=$(rpm -E %fedora)
ml="https://mirrors.fedoraproject.org/metalink?repo=fedora-$fv&arch=x86_64"
run "the mirrors dnf would use for Fedora $fv (metalink)" bash -c "curl -sS --max-time 15 '$ml' | grep -o 'https://[^<]*repomd.xml' | head -n 5"
metered=$(nmcli -t -f GENERAL.METERED dev show 2>/dev/null | grep -m1 -oE 'yes')
if ((QUICK == 0)) && [[ -z $metered ]]; then
  m=$(curl -sS --max-time 15 "$ml" 2>/dev/null | grep -o 'https://[^<]*repomd.xml' | head -n1)
  if [[ -n $m ]]; then
    base=${m%repodata/repomd.xml}
    f=$(curl -sS --max-time 15 "$m" | grep -o 'href="repodata/[^"]*primary[^"]*"' | head -n1 | cut -d'"' -f2)
    if [[ -n $f ]]; then
      sp=$(curl -sS -o /dev/null --max-time 25 -w '%{speed_download} %{size_download}' "$base$f" 2>&1)
      read -r bps size <<<"$sp"
      say "NET-12 download test: ${size:-0} bytes from ${base%%/pub*} at $(( ${bps%.*} / 1024 )) KiB/s"
      (( ${bps%.*} < 1048576 )) && warn "downloads from the nearest Fedora mirror run at $(( ${bps%.*} / 1024 )) KiB/s (under 1 MiB/s)" "check the network; dnf's mirror list is in the report" || good "mirror speed $(( ${bps%.*} / 1048576 )) MiB/s"
    fi
  fi
elif [[ -n $metered ]]; then say "(a metered connection: no download test)"; fi
run "repositories" dnf repolist --enabled
sub "dnf's own errors and warnings, and the downloads that failed (its logs, the last 100)"
grep -hE ' (ERROR|WARNING) ' /var/log/dnf5.log* 2>/dev/null | tail -n 100 >>"$BODY"
grep -hE 'Curl error|Status code: [45][0-9][0-9]' /var/log/dnf5.librepo.log* 2>/dev/null | tail -n 60 >>"$BODY"
ndf=$(cat /var/log/dnf5.librepo.log* 2>/dev/null | grep -cE 'Curl error|Status code: [45][0-9][0-9]')
