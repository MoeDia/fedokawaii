# ════ 22. packages ════════════════════════════════════════════════════════════════════════
sec "22. packages and updates"
# PKG-01: every package the manifest installs here is there, its files whole
if [[ -r $TOOLKIT/lib/manifest.sh ]]; then
  ( export STEAM SPOTIFY STATE_DIR=$STATE; STEAM=$(conf STEAM) SPOTIFY=$(conf SPOTIFY)
    # shellcheck source=/dev/null
    . "$TOOLKIT/lib/manifest.sh" && manifest_all "$(cat "$STATE/gpu" 2>/dev/null)" ) >"$TMP/pkgs" 2>"$TMP/pkgs.err" \
    || fail "lib/manifest.sh gives no package list" "send the report"
  while IFS= read -r p; do
    [[ -n $p ]] || continue
    if ! rpm -q --quiet "$p" >/dev/null; then echo "NOT INSTALLED $p"; continue; fi
    rpm -V --nofiledigest --nomtime --nouser --nogroup --nomode --nordev --nosize "$p" | grep '^missing' | grep -vE '^missing +[cdgl] ' | sed "s|^|$p: |"
  done <"$TMP/pkgs" >"$TMP/rpmv"
  sub "PKG-01 the packages lib/manifest.sh installs ($(grep -c . "$TMP/pkgs") here): installed, no file missing"
  cap <"$TMP/rpmv" >>"$BODY"
  np=$(grep -c '^NOT INSTALLED' "$TMP/rpmv"); nm=$(grep -vc '^NOT INSTALLED' "$TMP/rpmv")
  if ((np)); then fail "PKG-01 $np packages of the manifest are not installed" "run: fedokawaii repair"; sed -n 's/^NOT INSTALLED //p' "$TMP/rpmv" | tr '\n' ' ' | fold -s -w 90 | detail; fi
  if ((nm)); then fail "PKG-01 $nm files of the manifest's packages are missing" "run: sudo dnf reinstall <the package>"; grep -v '^NOT INSTALLED' "$TMP/rpmv" | detail; fi
  ((np + nm)) || good "PKG-01 all $(grep -c . "$TMP/pkgs") packages of the manifest are installed, none missing a file"
else fail "lib/manifest.sh is missing from the toolkit: the packages are not checked" "run: sudo bash $TOOLKIT/setup.sh"; fi

# ════ the checks done: those that run alone, then the theme switch ══════════════════════
wait "$CKPID"
run_solo

# ════ 7. the theme, timed from outside: to the other one and back, settled each time ══════
sec "7. the theme"
if [[ -r $TOOLKIT/theme.sh ]]; then
  timeout 120 bash "$TOOLKIT/theme.sh" --check --user "$U" >"$TMP/drift" 2>&1; dr=$?
  sub "THEME-05 theme.sh --check (what differs from the toolkit)"; cap <"$TMP/drift" >>"$BODY"; say "[exit $dr]"
  if ((dr == 0)); then good "THEME-05 the theme is in sync with the toolkit"
  else warn "THEME-05 the theme drifted from the toolkit (exit $dr)" "run: fedokawaii apply"; sed -n '1,12p' "$TMP/drift" | detail; fi
fi
run "current theme" readlink -f "$UH/.config/fedokawaii/current"
if ((QUICK == 0 && SES)) && asu bash -c 'command -v kawa-theme' >/dev/null; then
  sub "THEME-10 the theme switch, timed until it settled (the link, GTK's colour scheme, no kawa-theme left)"
  orig=$(asu kawa-theme get 2>/dev/null)
  for i in 1 2; do
    want=dark; [[ $(asu kawa-theme get 2>/dev/null) == dark ]] && want=light
    t0=$EPOCHREALTIME; asu timeout 60 kawa-theme "$want" >"$TMP/sw.out" 2>&1; r=$?; ms=$(ms_since "$t0")
    for _ in $(seq 300); do
      [[ $(readlink "$UH/.config/fedokawaii/current") == themes/$want ]] \
        && ! pgrep -u "$U" -f '(^|/)kawa-theme( |$)' >/dev/null && [[ ! -e /run/user/$UID_/kawa-theme.busy ]] \
        && { cs=$(asu gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null); [[ $want == dark && $cs == "'prefer-dark'" || $want == light && $cs != "'prefer-dark'" ]]; } && break
      sleep 0.01
    done
    st=$(ms_since "$t0")
    cap 40 <"$TMP/sw.out" >>"$BODY"
    say "switch $i to $want: the command ${ms} ms (exit $r), settled after ${st} ms"
    if ((r)); then fail "THEME-10 kawa-theme failed switching to $want (exit $r)" "send the report"; break; fi
    if ((st > 1500)); then warn "THEME-10 the switch to $want took ${st} ms to settle (over 1.5 s)" "send the report"
    else good "THEME-10 the switch to $want settled in ${st} ms"; fi
    sleep 1
  done
  [[ $(asu kawa-theme get 2>/dev/null) == "$orig" ]] || asu timeout 60 kawa-theme "$orig" >/dev/null 2>&1
  say "back to: $(asu kawa-theme get 2>/dev/null) (it was $orig)"
  [[ $(asu kawa-theme get 2>/dev/null) == "$orig" ]] || fail "THEME-10 the theme could not be put back to $orig" "switch it back: kawa-theme $orig"
fi
sub "the theme's own log (~/.cache/kawa-theme.log, the last 40 lines)"
tail -n 40 "$UH/.cache/kawa-theme.log" >>"$BODY" 2>/dev/null
# "kawa-theme: switched to light in 412 ms" — the switch as kawa-theme times it itself
grep -E 'kawa-theme: switched to [a-z]+ in [0-9]+ ms' "$UH/.cache/kawa-theme.log" 2>/dev/null | tail -n 6 >"$TMP/tt"
if [[ -s $TMP/tt ]]; then
  slow=$(sed -nE 's/.*switched to ([a-z]+) in ([0-9]+) ms.*/\2 \1/p' "$TMP/tt" | awk '$1 > 400' | sort -n | tail -n1)
  last=$(sed -nE 's/.*switched to ([a-z]+) in ([0-9]+) ms.*/\2 ms (to \1)/p' "$TMP/tt" | tail -n1)
  if [[ -n $slow ]]; then warn "a theme switch took ${slow% *} ms by its own count (to ${slow#* }; over 400 ms) — the last: $last" "send the report"
  else good "the theme switches in time by its own count (the last: $last)"; fi
else warn "kawa-theme logged no switch time (~/.cache/kawa-theme.log: no 'switched to … in N ms' line)" "THEME-12 says whether your kawa-theme is older than the toolkit's"; fi

# ════ the report ══════════════════════════════════════════════════════════════════════════
judge_checks
# the findings made outside the tables, in the machine-readable summary too
awk -F'\t' '$2 == "FAIL" || $2 == "WARN" || $2 == "ok" { printf "%s\t%s\t%s\t%s\n", $2, $1, $3, $4 }' "$FIND" >>"$TMP/machine"
FAILS=$(grep -c $'\tFAIL\t' "$FIND"); WARNS=$(grep -c $'\tWARN\t' "$FIND")
sort -n "$TMP/areas" | awk '!seen[$0]++' >"$TMP/areas.s"
took=$(ms_since "$START")
{
  echo "fedokawaii health report — $(date '+%Y-%m-%d %H:%M:%S %Z') — $(hostname) — for $U"
  echo "made by fedokawaii-report in $((took / 1000)) s: $NCK checks in tables, and the logs$( ((QUICK)) && echo ' (--quick: no timed or long tests)')"
  echo
  if ((FAILS)); then echo "VERDICT: BROKEN — $FAILS failures, $WARNS warnings"
  elif ((WARNS)); then echo "VERDICT: WORKS, WITH WARNINGS — $WARNS warnings"
  else echo "VERDICT: HEALTHY — nothing failed, no warnings"; fi
  echo
  echo "── findings by area (FAIL, then WARN; → what to do or send) ─────────────────────"
  while IFS= read -r a; do
    awk -F'\t' -v a="$a" '$1 == a' "$FIND" >"$TMP/fa"
    grep -qP '\t(FAIL|WARN)\t' "$TMP/fa" || continue
    printf '\n%s\n' "$a"
    for lv in FAIL WARN; do
      awk -F'\t' -v lv="$lv" '
        $2 == lv { printf "  %-4s  %s\n", $2, $3; if ($4 != "") printf "          → %s\n", $4; keep = 1; next }
        $2 == "detail" { if (keep) print $3; next }
        { keep = 0 }' "$TMP/fa"
    done
  done <"$TMP/areas.s"
  echo
  echo "── by area: each check (ok · FAIL · WARN · INFO: kept · SKIP: needs the desktop, or --quick) ──"
  while IFS= read -r a; do
    awk -F'\t' -v a="$a" '$1 == a' "$CK/table" 2>/dev/null >"$TMP/ta"
    nf=$(awk -F'\t' -v a="$a" '$1 == a && ($2 == "FAIL" || $2 == "WARN")' "$FIND" | grep -c .)
    if [[ ! -s $TMP/ta ]]; then printf '\n%s — no table: %d findings (above), its logs below\n' "$a" "$nf"; continue; fi
    printf '\n%s — %d checks: %d ok, %d FAIL, %d WARN, %d INFO, %d SKIP%s\n' "$a" "$(grep -c . "$TMP/ta")" \
      "$(grep -c $'\tok\t' "$TMP/ta")" "$(grep -c $'\tFAIL\t' "$TMP/ta")" "$(grep -c $'\tWARN\t' "$TMP/ta")" \
      "$(grep -c $'\tINFO\t' "$TMP/ta")" "$(grep -c $'\tSKIP\t' "$TMP/ta")" "$( ((nf)) && echo " · $nf findings in all (above)")"
    awk -F'\t' '{ printf "  %-4s  %-36s %7s ms  %s\n", $2, $3, $4, $5 }' "$TMP/ta"
  done <"$TMP/areas.s"
  echo
  echo "── fine (the findings outside the tables) ─────────────────────────────────────────"
  awk -F'\t' '$2 == "ok" { printf "  ok    %s\n", $3 }' "$FIND"
  for b in $(cd "$TMP" && ls body.* | sort -t. -k2,2n); do cat "$TMP/$b"; done
  printf '\n\n══════ the checks: what each one printed (all but the passed and skipped) %s\n' "$(printf '═%.0s' $(seq 8))"
  cat "$TMP/captures"
  printf '\n\n══════ machine-readable: STATUS<tab>area<tab>check<tab>detail (diff two runs) %s\n' "$(printf '═%.0s' $(seq 4))"
  cat "$TMP/machine"
} | sed -E 's/((password|passwd|passphrase|secret|token|api[_-]?key|psk|RESTIC_PASSWORD)[A-Za-z_]*[[:space:]]*[=:][[:space:]]*)[^[:space:]]+/\1●●●/Ig; s/(Bearer[[:space:]]+)[^[:space:]]+/\1●●●/Ig; s/(X-Api-Key:[[:space:]]*)[^[:space:]"]+/\1●●●/Ig' >"$TMP/report"
install -m 0600 -o "$U" -g "$(id -gn "$U")" "$TMP/report" "$OUT"
echo "fedokawaii-report: $OUT ($(wc -l <"$OUT") lines) — $( ((FAILS)) && echo "BROKEN: $FAILS failures, $WARNS warnings" || { ((WARNS)) && echo "works, $WARNS warnings" || echo healthy; })"
# run from a stick: a copy beside the script too, to carry back
here=$(cd "$(dirname "$0")" && pwd)
if [[ $here != /usr/local/* && -w $here ]]; then cp "$OUT" "$here/fedokawaii-report.txt" && echo "fedokawaii-report: also $here/fedokawaii-report.txt"; fi
exit 0
