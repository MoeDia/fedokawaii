#!/usr/bin/python3
"""/usr/local/bin/kawa-greet USER — the login screen. greetd runs it in cage (a kiosk
compositor: one full-screen window) on tty1, as its own user (greetd).

It is the lock screen's twin: on your wallpaper shaded into the ground (as the lock shows it:
kawa-wallpaper leaves a copy in /var/lib/fedokawaii-greeter), no panel, no box — one column in
the middle: the pixel padlock beside the time at 64 px, the day (its seal, the date, the
weekday in kanji: 火曜日), a line of the season and the hour (VERSES — the same sixteen as
kawa-lockmod's), and one line for your password, each character a ◆ in accent_text. A wrong
password empties it and says so above it; the right one starts the desktop
(/usr/local/bin/start-dwl). Under it three keys: sleep, restart and power off — words alone,
accent_text under the pointer and under the keyboard's focus (Tab). The lock screen has the
same (kawa-lockmod).

The key that wakes the computer only wakes it: from logind's word that the machine is going to
sleep (PrepareForSleep) until 2 s after it is awake again, every key and click is swallowed —
an Enter that woke it is never a wrong password. An Enter in an empty field is never a try.

There is one person on this computer, so there is no user name to type: setup writes yours
into greetd's settings (/etc/greetd/fedokawaii.toml), which hand it to this program.

Its look: /usr/local/share/fedokawaii/greeter/<theme>/ (gtklock.css, padlock.png,
seal-1.png … seal-7.png — setup installs both themes), dark or light as the desktop is
(kawa-theme writes the name into /var/lib/fedokawaii-greeter/theme, a file of yours).

greetd's protocol: JSON messages over the socket in $GREETD_SOCK, each after its length
(4 bytes, the machine's byte order) — create_session, post_auth_message_response,
start_session, cancel_session (man 7 greetd-ipc).
"""
import json
import locale
import os
import socket
import struct
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

SESSION = ["/usr/local/bin/start-dwl"]
SHARE = "/usr/local/share/fedokawaii/greeter"
THEME_FILE = "/var/lib/fedokawaii-greeter/theme"
GUARD = 2.0                                # seconds after a wake that keys and clicks only wake
ENTER = (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter)
WEEKDAYS = ("月曜日", "火曜日", "水曜日", "木曜日", "金曜日", "土曜日", "日曜日")
# VERSES: a season (spring Mar–May … winter Dec–Feb), an hour (morning 5–10, day 11–16,
# evening 17–19, night) — the same in kawa-lockmod
VERSES = (
    (("春の朝", "spring morning, the first thread"), ("春の昼", "plum blossom on the sleeve"),
     ("春の夕", "the needle rests in silk"), ("春の夜", "a lantern, a quiet stitch")),
    (("夏の朝", "cool tatami, early light"), ("夏の昼", "cicadas behind the screen"),
     ("夏の夕", "a fan, the river breeze"), ("夏の夜", "fireflies between the reeds")),
    (("秋の朝", "frost on the bamboo fence"), ("秋の昼", "red leaves on still water"),
     ("秋の夕", "crows home, the sky in ink"), ("秋の夜", "the moon, a seal on paper")),
    (("冬の朝", "snow on the temple roof"), ("冬の昼", "a kettle sings, a quiet room"),
     ("冬の夕", "the lamp lit early"), ("冬の夜", "the stove's last ember")),
)


def verse(t):
    """The season's and the hour's line for a time.struct_time: (kanji, words)."""
    m, h = t.tm_mon, t.tm_hour
    season = 0 if 3 <= m <= 5 else 1 if 6 <= m <= 8 else 2 if 9 <= m <= 11 else 3
    hour = 0 if 5 <= h <= 10 else 1 if 11 <= h <= 16 else 2 if 17 <= h <= 19 else 3
    return VERSES[season][hour]


class Greetd:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)

    def ask(self, **msg):
        data = json.dumps(msg).encode()
        self.sock.sendall(struct.pack("=I", len(data)) + data)
        head = self._read(4)
        return json.loads(self._read(struct.unpack("=I", head)[0]))

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("greetd closed the connection")
            buf += chunk
        return buf


def theme():
    try:
        with open(THEME_FILE) as f:
            name = f.read().strip()
    except OSError:
        name = "dark"                      # (before your first login: the desktop starts dark)
    return name if name in ("dark", "light") else "dark"


class Greeter(Gtk.Window):
    def __init__(self, user, greetd):
        super().__init__(title="login")
        self.user, self.greetd = user, greetd
        art = f"{SHARE}/{theme()}"
        css = Gtk.CssProvider()
        css.load_from_path(f"{art}/gtklock.css")
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        # the wallpaper shaded into the ground, as the lock shows it (none yet: the plain ground)
        bg = f"{os.path.dirname(THEME_FILE)}/lock-{theme()}.png"
        if os.path.isfile(bg):
            wall = Gtk.CssProvider()
            wall.load_from_data(f'window {{ background-image: url("file://{bg}"); background-size: cover; '
                                f'background-position: center; }}'.encode())
            Gtk.StyleContext.add_provider_for_screen(self.get_screen(), wall, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)

        # the lock screen's column (~/.config/fedokawaii/lock.ui), part for part: the padlock and
        # the time, the day (its seal, the date, the weekday), the season, the line for what
        # went wrong, the password's line — then the three keys
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, name="window-box",
                      halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, name="info-box")
        # the face: the padlock, the time in the display size (64 px: design-system §2), AM/PM
        face = Gtk.Box(name="face", halign=Gtk.Align.CENTER)
        face.add(Gtk.Image(file=f"{art}/padlock.png", name="padlock", valign=Gtk.Align.CENTER))
        self.clock = Gtk.Label(name="clock-label", valign=Gtk.Align.CENTER)
        face.add(self.clock)
        self.ampm = Gtk.Label(name="ampm", valign=Gtk.Align.END)
        face.add(self.ampm)
        info.add(face)
        heading = Gtk.Box(name="heading", halign=Gtk.Align.CENTER)
        heading.add(Gtk.Image(file=f"{art}/seal-{time.strftime('%u')}.png", name="seal", valign=Gtk.Align.CENTER))
        self.date = Gtk.Label(name="date-label", valign=Gtk.Align.CENTER)
        heading.add(self.date)
        self.weekday = Gtk.Label(name="weekday", valign=Gtk.Align.CENTER)
        heading.add(self.weekday)
        info.add(heading)
        line = Gtk.Box(name="verse-line", spacing=6, halign=Gtk.Align.CENTER)
        self.verse_kanji = Gtk.Label(name="verse-kanji")
        self.verse = Gtk.Label(name="verse")
        line.add(self.verse_kanji)
        line.add(self.verse)
        info.add(line)
        box.add(info)

        messages = Gtk.Box(name="messages")
        self.error = Gtk.Label(name="error-label", halign=Gtk.Align.START, hexpand=True, xalign=0,
                               wrap=True, max_width_chars=44)   # (a long one from PAM: whole, on more lines)
        messages.add(self.error)
        box.add(messages)
        self.entry = Gtk.Entry(name="input-field", hexpand=True, xalign=0.5,
                               visibility=False, invisible_char=ord("◆"), caps_lock_warning=False,   # (a code point: GTK takes a number)
                               input_purpose=Gtk.InputPurpose.PASSWORD,
                               placeholder_text=f"{user} · パスワード · password")
        self.entry.connect("activate", self.login)
        box.add(self.entry)

        power = Gtk.Box(name="keys", homogeneous=True)
        for label, verb in (("眠 sleep", "suspend"), ("再 restart", "reboot"), ("電 power off", "poweroff")):
            b = Gtk.Button(label=label, can_focus=True, hexpand=True, focus_on_click=False)
            b.connect("clicked", self.power, verb)
            power.add(b)
        box.add(power)

        # the wake guard: asleep (or about to be), and GUARD s after waking, input only wakes
        self.asleep, self.woke = False, 0.0
        Gio.bus_get_sync(Gio.BusType.SYSTEM, None).signal_subscribe(
            "org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
            "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE, self.sleeping)
        for ev in ("key-press-event", "key-release-event", "button-press-event", "button-release-event"):
            self.connect(ev, self.input)

        self.add(box)
        self.tick()
        GLib.timeout_add_seconds(1, self.tick)
        self.fullscreen()
        self.show_all()
        self.entry.grab_focus()

    def sleeping(self, _bus, _sender, _path, _iface, _signal, params):
        self.asleep = params.unpack()[0]
        if not self.asleep:
            self.woke = time.monotonic()

    def guarded(self):
        return self.asleep or time.monotonic() - self.woke < GUARD

    def input(self, _win, ev):
        if self.guarded():
            return True
        # an Enter in an empty field: nothing to try
        return (ev.type == Gdk.EventType.KEY_PRESS and ev.keyval in ENTER
                and self.entry.has_focus() and not self.entry.get_text())

    def power(self, _button, verb):
        if not self.guarded():
            subprocess.Popen(["systemctl", verb])

    def tick(self):
        self.clock.set_text(time.strftime("%I:%M"))
        self.ampm.set_text(time.strftime("%p"))
        self.date.set_text(time.strftime("%a %d %b"))   # ("Mon 19 Oct": the weekday in words, and its seal above)
        now = time.localtime()
        self.weekday.set_text(WEEKDAYS[now.tm_wday])
        kanji, words = verse(now)
        self.verse_kanji.set_text(kanji)
        self.verse.set_text(words)
        return True

    def say(self, text):
        self.error.set_text(text)

    def login(self, _entry):
        self.say("")
        password = self.entry.get_text()
        self.entry.set_text("")
        self.entry.set_sensitive(False)
        try:
            ok = self.run_pam(password)
        except (OSError, ConnectionError, ValueError) as e:
            self.say(f"the login service did not answer ({e})")
            ok = False
        if ok:
            Gtk.main_quit()
            return
        self.entry.set_sensitive(True)
        self.entry.grab_focus()

    def run_pam(self, password):
        r = self.greetd.ask(type="create_session", username=self.user)
        while r.get("type") == "auth_message":
            kind = r.get("auth_message_type")
            if kind in ("secret", "visible"):
                r = self.greetd.ask(type="post_auth_message_response", response=password)
            else:                          # info or error from PAM: shown, then acknowledged
                self.say(r.get("auth_message", "").strip())
                r = self.greetd.ask(type="post_auth_message_response")
        if r.get("type") == "success":
            r = self.greetd.ask(type="start_session", cmd=SESSION, env=[])
            if r.get("type") == "success":
                return True
        self.greetd.ask(type="cancel_session")
        if r.get("error_type") == "auth_error":
            self.say("ちがう · wrong password")
        else:
            self.say(r.get("description", "the login failed"))
        return False


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: kawa-greet USER (greetd runs it: /etc/greetd/fedokawaii.toml)")
    locale.setlocale(locale.LC_TIME, "C")  # the words in English (the seal says the rest), as on the lock
    greetd = Greetd(os.environ["GREETD_SOCK"])
    win = Greeter(sys.argv[1], greetd)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
