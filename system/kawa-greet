#!/usr/bin/python3
"""/usr/local/bin/kawa-greet USER — the login screen. greetd runs it in cage (a kiosk
compositor: one full-screen window) on tty1, as its own user (greetd).

It is the lock screen's twin — the first lock of the day: the mood's scene (lock-scene.png and
lock-scene.txt, tools/build-lock.py — the same pictures kawa-lockmod draws on the lock) at whole
pixels, centred, its edges' own colour round it; the torches' flames, 8 frames a second; your
password as marks in the scene's row, in the gate (the demon's mouth, the Kannon's lotus: shut at rest, Tab
opens it, Enter shuts it on the marks and only then tries),
the newest ones while more are typed than the row holds, the arms in the Caps Lock ink while it
is on; the caret a bar as tall as a mark, blinking once a second while the line has the keyboard.
A wrong password: the marks scatter and fade, the face shakes a pixel of the scene twice (240 ms,
five steps of 48), and the line is empty again; the right one starts the desktop
(/usr/local/bin/start-dwl). No date, no time, no keys. Anything else the system says on the way
(an expiring password, a session that will not start) is the line of words low on the scene, each
its own line, in the rows lock-scene.txt names for it (a stone course of the wall, the gold under
the last cloud) — as on the lock. The check runs beside the screen, so the flames never stop while
greetd answers.

The key that wakes the computer only wakes it: from logind's word that the machine is going to
sleep (PrepareForSleep) until 2 s after it is awake again, every key and click is swallowed —
an Enter that woke it is never a wrong password. An Enter in an empty field is never a try.

There is one person on this computer, so there is no user name to type: setup writes yours
into greetd's settings (/etc/greetd/fedokawaii.toml), which hand it to this program.

Its look: /usr/local/share/fedokawaii/greeter/<theme>/ (gtklock.css, lock-scene.png,
lock-scene.txt, the dark's lock-flame.png — setup installs both themes), dark or light as the
desktop is (kawa-theme writes the name into /var/lib/fedokawaii-greeter/theme, a file of yours).

greetd's protocol: JSON messages over the socket in $GREETD_SOCK, each after its length
(4 bytes, the machine's byte order) — create_session, post_auth_message_response,
start_session, cancel_session (man 7 greetd-ipc).
"""
import json
import os
import socket
import struct
import sys
import threading
import time

import cairo
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

SESSION = ["/usr/local/bin/start-dwl"]
SHARE = "/usr/local/share/fedokawaii/greeter"
THEME_FILE = "/var/lib/fedokawaii-greeter/theme"
GUARD = 2.0                                # seconds after a wake that keys and clicks only wake
ENTER = (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_ISO_Enter)
GATE_KEY = Gdk.KEY_Tab                     # the secret key: the gate opens
GATE_S = 0.34                              # opening, shutting: all its frames
GATE_SHUT, GATE_OPENING, GATE_OPEN, GATE_SHUTTING = range(4)
WRONG = "wrong password"                    # (said by the scene: the marks scatter, the face shakes)
STEP, STEPS = 0.048, 5                      # the wrong password's steps (s), as kawa-lockmod's
FLARE = 0.090                               # a key's answer: the newest mark flares (s), as kawa-lockmod's


class Scene:
    """lock-scene.txt (the lock's words: where the marks and flames go, their inks) and its
    pictures, from FOLDER."""

    def __init__(self, folder):
        kv = {}
        with open(f"{folder}/lock-scene.txt") as f:
            for line in f:
                w = line.split("#")[0].split()
                if w:
                    kv.setdefault(w[0], []).append(w[1:])
        ink = lambda h: tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))   # noqa: E731
        self.w, self.h = map(int, kv["size"][0])
        self.ground = ink(kv["ground"][0][0])
        self.rx, self.ry, self.pitch, self.rn = map(int, kv["row"][0])
        self.arms, self.core, self.corner = (ink(h) for h in kv["mark"][0])
        self.caps, self.caret = ink(kv["caps"][0][0]), ink(kv["caret"][0][0])
        self.cx, self.cy, self.cr = map(int, kv["plate"][0])
        self.wy0, self.wy1 = map(int, kv["words"][0])
        self.img = cairo.ImageSurface.create_from_png(f"{folder}/lock-scene.png")
        self.flames = [tuple(map(int, f)) for f in kv.get("flame", [])]
        self.fw, self.fh, self.frames = map(int, kv["frames"][0]) if self.flames else (0, 0, 1)
        self.flame = cairo.ImageSurface.create_from_png(f"{folder}/lock-flame.png") if self.flames else None
        self.gx, self.gy, self.gw, self.gh, self.gn = map(int, kv["gate"][0]) if "gate" in kv else (0, 0, 0, 0, 0)
        self.gate = cairo.ImageSurface.create_from_png(f"{folder}/lock-gate.png") if self.gn else None

    def fit(self, w, h):
        """The scale (whole) and the corner of the scene on a W × H screen."""
        n = max(1, min(w // self.w, h // self.h))
        return n, (w - n * self.w) // 2, (h - n * self.h) // 2


class Greetd:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)

    def ask(self, **msg):
        data = json.dumps(msg).encode()
        self.sock.sendall(struct.pack("=I", len(data)) + data)
        head = self._read(4)
        return json.loads(self._read(struct.unpack("=I", head)[0]))

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("greetd closed the connection")
            buf += chunk
        return buf


def theme():
    try:
        with open(THEME_FILE) as f:
            name = f.read().strip()
    except OSError:
        name = "dark"                      # (before your first login: the desktop starts dark)
    return name if name in ("dark", "light") else "dark"


class Greeter(Gtk.Window):
    def __init__(self, user, greetd):
        super().__init__(title="login")
        self.user, self.greetd = user, greetd
        art = f"{SHARE}/{theme()}"
        css = Gtk.CssProvider()
        css.load_from_path(f"{art}/gtklock.css")
        Gtk.StyleContext.add_provider_for_screen(self.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        try:
            self.scene = Scene(art)
        except (OSError, KeyError, ValueError, cairo.Error) as e:   # (its plain line: the theme's ground)
            print(f"kawa-greet: no scene ({e})", file=sys.stderr)
            self.scene = None
        self.frame, self.caret_on, self.wrong, self.tried = 0, True, 0.0, 0
        self.length, self.flare, self.flare_src = 0, 0.0, 0
        # the gate, kawa-lockmod's twin: shut at rest, Tab opens it, Enter shuts it on the marks and
        # only then tries; no frames: always open
        self.gate = GATE_SHUT if self.scene and self.scene.gn else GATE_OPEN
        self.gate_frame, self.gate_t0, self.gate_src, self.gate_try = 0, 0.0, 0, False

        # the password's line (gtklock.css hides it under .kawa: the scene draws what is typed)
        self.entry = Gtk.Entry(name="input-field", xalign=0.5, visibility=False,
                               invisible_char=ord("◆"), caps_lock_warning=False,   # (a code point: GTK takes a number)
                               input_purpose=Gtk.InputPurpose.PASSWORD,
                               halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
        self.entry.connect("activate", self.login)
        self.error = Gtk.Label(name="error-label", halign=Gtk.Align.CENTER, wrap=True,
                               max_width_chars=60, justify=Gtk.Justification.CENTER)   # (a long one from PAM: whole)
        layers = Gtk.Overlay()
        if self.scene:
            self.get_style_context().add_class("kawa")
            self.entry.set_opacity(0)      # (its line unseen from the first frame, whatever the CSS does)
            self.area = Gtk.DrawingArea(can_focus=False)
            self.area.connect("draw", self.draw_scene)
            layers.add(self.area)
            self.entry.connect("changed", self.typed)
            self.entry.connect("notify::has-focus", lambda *_: self.redraw_row())
            self.entry.connect("notify::sensitive", lambda *_: self.redraw_row())
            Gdk.Keymap.get_for_display(Gdk.Display.get_default()).connect("state-changed", lambda *_: self.redraw_row())
            if self.scene.flames:
                GLib.timeout_add(1000 // 8, self.flames_tick)
            self.blink = GLib.timeout_add(500, self.caret_tick)
        layers.add_overlay(self.entry)
        layers.add_overlay(self.error)
        layers.set_overlay_pass_through(self.error, True)
        if self.scene:                     # (its place on the scene: kawa-lockmod's twin)
            layers.connect("get-child-position", self.place_words)
        else:                              # (the plain login: low on the theme's ground)
            self.error.set_valign(Gtk.Align.END)
            self.error.set_margin_bottom(48)

        # the wake guard: asleep (or about to be), and GUARD s after waking, input only wakes
        self.asleep, self.woke = False, 0.0
        try:                               # (no system bus: the login stays up, without the guard)
            Gio.bus_get_sync(Gio.BusType.SYSTEM, None).signal_subscribe(
                "org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
                "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE, self.sleeping)
        except GLib.Error as e:
            print(f"kawa-greet: no word of sleeps ({e.message})", file=sys.stderr)
        for ev in ("key-press-event", "key-release-event", "button-press-event", "button-release-event"):
            self.connect(ev, self.input)

        self.add(layers)
        self.fullscreen()
        self.show_all()
        self.entry.grab_focus()

    # ── the scene: drawn as kawa-lockmod draws the lock ─────────────────────────────────
    def draw_scene(self, area, cr):
        s = self.scene
        n, ox, oy = s.fit(area.get_allocated_width(), area.get_allocated_height())
        cr.set_source_rgb(*s.ground)
        cr.paint()
        cr.translate(ox, oy)
        cr.scale(n, n)

        def picture(dx):
            cr.set_source_surface(s.img, dx, 0)
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
            cr.rectangle(dx, 0, s.w, s.h)
            cr.fill()

        picture(0)
        step = int((time.monotonic() - self.wrong) / STEP) if self.wrong else -1
        step = step if step < STEPS else -1
        dx = (1 if step in (0, 2) else -1 if step in (1, 3) else 0) if step >= 0 else 0
        if s.gate:
            cr.save()
            cr.rectangle(s.gx + dx, s.gy, s.gw, s.gh)
            cr.clip()
            cr.set_source_surface(s.gate, s.gx + dx - self.gate_frame * s.gw, s.gy)
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
            cr.paint()
            cr.restore()
        elif dx:
            cr.save()
            cr.arc(s.cx + dx, s.cy, s.cr, 0, 6.2832)
            cr.clip()
            picture(dx)
            cr.restore()
        for i, (fx, fy) in enumerate(s.flames):
            f = (self.frame + 3 * i) % s.frames      # (the two out of step)
            cr.set_source_surface(s.flame, fx - f * s.fw, fy)
            cr.get_source().set_filter(cairo.FILTER_NEAREST)
            cr.rectangle(fx, fy, s.fw, s.fh)
            cr.fill()

        def dot(x, y, c):
            cr.set_source_rgb(*c)
            cr.rectangle(x, y, 1, 1)
            cr.fill()

        def mark(x, y, arms, core, corner):
            for ax, ay in ((1, 1), (1, -1), (-1, 1), (-1, -1)) if corner else ():
                dot(x + ax, y + ay, corner)
            for ax, ay in ((1, 0), (-1, 0), (0, 1), (0, -1)):
                dot(x + ax, y + ay, arms)
            if core:
                dot(x, y, core)

        caps = Gdk.Keymap.get_for_display(Gdk.Display.get_default()).get_caps_lock_state()
        arms = s.caps if caps else s.arms
        opened = self.gate == GATE_OPEN           # (the marks in the mouth only while it is open)
        shown = min(len(self.entry.get_text()), s.rn) if opened else 0
        if step >= 0:                            # the tried ones scatter, dimming, then go
            for i in range(min(self.tried, s.rn)):
                vx, vy = (i * 7 + 3) % 5 - 2, (-1 - (i % 3 > 0)) if i % 2 else (1 + (i % 4 == 0))
                x, y = s.rx + s.pitch * i + dx + vx * step, s.ry + vy * step
                if step < 2:
                    mark(x, y, arms, s.core, s.corner)
                elif step < 4:
                    mark(x, y, s.corner, arms, None)
        else:
            flaring = shown and time.monotonic() < self.flare    # (the newest: its corners in the arms' ink)
            for i in range(shown):
                mark(s.rx + s.pitch * i, s.ry, arms, s.core, arms if flaring and i == shown - 1 else s.corner)
        if self.caret_on and opened and step < 0 and self.entry.has_focus() and self.entry.is_sensitive():
            cr.set_source_rgb(*s.caret)
            cr.rectangle(s.rx + s.pitch * shown, s.ry - 1, 1, 3)   # (a mark's height)
            cr.fill()
        return False

    def redraw(self, x, y, w, h):               # a part, in the scene's pixels
        a = self.area
        n, ox, oy = self.scene.fit(a.get_allocated_width(), a.get_allocated_height())
        a.queue_draw_area(ox + n * x, oy + n * y, n * w, n * h)

    def redraw_row(self):
        s = self.scene
        self.redraw(s.rx - 2, s.ry - 3, s.pitch * s.rn + 4, 7)

    def flames_tick(self):
        s = self.scene
        self.frame = (self.frame + 1) % s.frames
        for fx, fy in s.flames:
            self.redraw(fx, fy, s.fw, s.fh)
        return True

    def caret_tick(self):
        self.caret_on = not self.caret_on
        self.redraw_row()
        return True

    def typed(self, entry):                     # (solid while typing: the blink starts over)
        n = len(entry.get_text())
        if n > self.length:                    # (a key typed: its answer, also past the seventh)
            self.flare = time.monotonic() + FLARE
            if self.flare_src:
                GLib.source_remove(self.flare_src)
            self.flare_src = GLib.timeout_add(int(FLARE * 1000) + 1, self.flare_end)
        self.length = n
        self.caret_on = True
        GLib.source_remove(self.blink)
        self.blink = GLib.timeout_add(500, self.caret_tick)
        self.redraw_row()

    def flare_end(self):
        self.flare_src = 0
        self.redraw_row()
        return False

    def wrong_tick(self, _area, _clock):
        s = self.scene
        if s.gn:
            self.redraw(s.gx - 2, s.gy - 2, s.gw + 4, s.gh + 4)
        else:
            self.redraw(s.cx - s.cr - 4, s.cy - s.cr - 4, 2 * s.cr + 8, 2 * s.cr + 8)
        if time.monotonic() - self.wrong < STEPS * STEP:
            return True
        self.wrong = 0.0
        return False

    # ── the gate ──────────────────────────────────────────────────────────────────────
    def gate_redraw(self):
        s = self.scene
        self.redraw(s.gx - 2, s.gy - 2, s.gw + 4, s.gh + 4)
        self.redraw_row()

    def gate_go(self, to):
        self.gate, self.gate_t0 = to, time.monotonic()
        if not self.gate_src:
            self.gate_src = GLib.timeout_add(7, self.gate_step)
        self.gate_redraw()

    def gate_step(self):
        s = self.scene
        q = min(1.0, (time.monotonic() - self.gate_t0) / GATE_S)
        q = q * q * (3 - 2 * q)                # (gentle at both ends)
        f = int((s.gn - 1) * (q if self.gate == GATE_OPENING else 1 - q) + .5)
        if f != self.gate_frame:
            self.gate_frame = f
            self.gate_redraw()
        if q < 1:
            return True
        self.gate_src = 0
        if self.gate == GATE_OPENING:
            self.gate = GATE_OPEN
            self.gate_redraw()
        else:
            self.gate = GATE_SHUT
            if self.gate_try:                  # (eaten: now the password is tried)
                self.gate_try = False
                self.login(self.entry)
        return False

    def gate_keys(self, ev):
        """A key: what the gate makes of it; True: it goes no further."""
        if not self.scene or not self.scene.gn:
            return False
        press = ev.type == Gdk.EventType.KEY_PRESS
        if ev.keyval == GATE_KEY or self.gate in (GATE_SHUT, GATE_SHUTTING):
            # (shut, every key is nothing; the secret one opens it, unless a try waits for its word)
            if press and ev.keyval == GATE_KEY and self.gate == GATE_SHUT and self.entry.is_sensitive():
                self.gate_go(GATE_OPENING)
            return True
        if not press:
            return False
        if ev.keyval == Gdk.KEY_Escape:
            self.entry.set_text("")
            self.gate_go(GATE_SHUTTING)
            return True
        if ev.keyval in ENTER and self.entry.get_text():
            self.gate_try = True
            self.gate_go(GATE_SHUTTING)
            return True
        return False

    # ── input and the login ───────────────────────────────────────────────────────────
    def sleeping(self, _bus, _sender, _path, _iface, _signal, params):
        self.asleep = params.unpack()[0]
        if not self.asleep:
            self.woke = time.monotonic()

    def guarded(self):
        return self.asleep or time.monotonic() - self.woke < GUARD

    def input(self, _win, ev):
        if self.guarded():
            return True
        if ev.type in (Gdk.EventType.KEY_PRESS, Gdk.EventType.KEY_RELEASE) and self.gate_keys(ev):
            return True
        # an Enter in an empty field: nothing to try
        return (ev.type == Gdk.EventType.KEY_PRESS and ev.keyval in ENTER
                and self.entry.has_focus() and not self.entry.get_text())

    def place_words(self, layers, child, r):
        """The line of words across the screen's middle, in the middle of the scene's rows for it
        (lock-scene.txt's words: a stone course of the wall, the gold under the last cloud)."""
        if child is not self.error:
            return False
        sw = layers.get_allocated_width()
        n, _, oy = self.scene.fit(sw, layers.get_allocated_height())
        r.width = min(child.get_preferred_width()[1], sw)
        r.height = child.get_preferred_height_for_width(r.width)[1]
        r.x = (sw - r.width) // 2
        r.y = oy + n * self.scene.wy0 + (n * (self.scene.wy1 - self.scene.wy0 + 1) - r.height) // 2
        return True

    def say(self, text):
        self.error.set_text(text)

    def login(self, _entry):
        password = self.entry.get_text()
        self.tried = len(password)
        self.say("")
        self.entry.set_sensitive(False)
        threading.Thread(target=self.check, args=(password,), daemon=True).start()

    def check(self, password):                  # (beside the screen: greetd may take seconds)
        notes = []
        try:
            ok = self.run_pam(password, notes.append)
        except (OSError, ConnectionError, ValueError) as e:
            ok, notes = False, [f"the login service did not answer ({e})"]
        GLib.idle_add(self.answered, ok, notes)

    def answered(self, ok, notes):
        if ok:
            Gtk.main_quit()
            return False
        self.entry.set_text("")
        self.entry.set_sensitive(True)
        self.entry.grab_focus()
        if WRONG in notes and self.scene:
            notes.remove(WRONG)
            self.wrong = time.monotonic()
            self.area.add_tick_callback(self.wrong_tick)
        if self.scene and self.scene.gn:       # (spat out: open again, the line empty)
            self.gate_go(GATE_OPENING)
        self.say("\n".join(notes))           # (each its own line: kawa-lockmod's twin)
        return False

    def run_pam(self, password, say):
        r = self.greetd.ask(type="create_session", username=self.user)
        while r.get("type") == "auth_message":
            kind = r.get("auth_message_type")
            if kind in ("secret", "visible"):
                r = self.greetd.ask(type="post_auth_message_response", response=password)
            else:                          # info or error from PAM: shown, then acknowledged
                say(r.get("auth_message", "").strip())
                r = self.greetd.ask(type="post_auth_message_response")
        if r.get("type") == "success":
            r = self.greetd.ask(type="start_session", cmd=SESSION, env=[])
            if r.get("type") == "success":
                return True
        self.greetd.ask(type="cancel_session")
        say(WRONG if r.get("error_type") == "auth_error" else r.get("description", "the login failed"))
        return False


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: kawa-greet USER (greetd runs it: /etc/greetd/fedokawaii.toml)")
    greetd = Greetd(os.environ["GREETD_SOCK"])
    win = Greeter(sys.argv[1], greetd)
    win.connect("destroy", Gtk.main_quit)
    Gtk.main()


if __name__ == "__main__":
    main()
