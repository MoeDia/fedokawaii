#!/usr/bin/env bash
# /usr/local/sbin/kawa-snap — the system's snapshots, as root.
#
#   kawa-snap pre|post [PID]   called by libdnf5-plugin-actions around every dnf transaction:
#                              a snapper "pre" snapshot before, the matching "post" after, both
#                              named by the dnf command that ran (from PID, dnf's own process:
#                              "dnf install htop"); after the post, the boot menu's list again.
#                              It never stops dnf: a snapshot that could not be taken is written
#                              to the journal (journalctl -t kawa-snap)
#   kawa-snap boot             the boot menu's "snapshots" list made again from the snapshots
#                              there are (grub-btrfs: the newest ten "before" points)
#   kawa-snap list             every snapshot of /, read from the disk itself (so it works in a
#                              snapshot started from the boot menu too, where snapper sees none):
#                              NUMBER TAB TYPE TAB DATE (UTC) TAB DESCRIPTION TAB booted|-
#                              — and "old", the system a restore replaced, while it is kept
#   kawa-snap finish           a restore cut short after its exchange finished: its default, the
#                              snapshots moved back (the start-up run calls it; restore does too)
#   kawa-snap restore N|old [--with-home]
#                              snapshot N becomes the system at the next start: its kernels made
#                              whole in /boot and written to disk, then a writable copy of it is
#                              exchanged with the root subvolume in one atomic step and its newest
#                              kernel made the default at once; the one replaced is kept as ROOT.old
#                              (restore old goes back to it; two older ones kept in ROOT.old.d), any
#                              subvolume inside it moves across (the kernels it lacks stay in /boot
#                              until it has started). The disk's layout (fedokawaii-split) keeps your
#                              files, the logs, the updater's memory and the snapshots out of it: a
#                              snapshot from before that layout gets its fstab lines. While /home is
#                              still inside the system your files would go back too: only with
#                              --with-home
# Or at power-on: hold Shift (Esc/F8) for the boot menu → snapshots (each starts as it was, on a
#   layer in memory: nothing done to the system there is kept; in a snapshot made after the disk's
#   new layout your files, in /home of their own, are today's and stay as you leave them — in an
#   older one they are that day's too; kawa-snap restore N works from there too).
# Inspect: kawa-snap list · revert one transaction: sudo snapper -c root undochange PRE..POST
# Exit status: pre, post 0 always (dnf goes on whatever happens) · boot, list, restore 0 done,
# 1 could not (the reason on stderr; restore: nothing was changed) · 2 misuse.
set -u
export LC_ALL=C.UTF-8
state=/run/kawa-snap.pre
lock=/run/kawa-snap.lock                     # one restore at a time; a dnf run's pre waits for it
top=/run/kawa-snap/top                       # the file system's top level, mounted while working
uphase=/var/lib/fedokawaii/update/phase      # the update's phase (lib/update.sh): a restore ends it
case ${1:-} in
  pre|post|boot|list|finish) ;;
  restore) [[ ${2:-} =~ ^([1-9][0-9]*|old)$ && ${3:---with-home} == --with-home && $# -le 3 ]] \
             || { echo "usage: kawa-snap restore NUMBER|old [--with-home]" >&2; exit 2; } ;;
  -h|--help) sed -n '2,/^set -u/{/^set -u/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-snap pre|post [PID] (dnf runs it) · kawa-snap boot|list · kawa-snap restore N|old" >&2
     echo "(or at power-on: hold Shift (Esc/F8) for the boot menu → snapshots)" >&2; exit 2 ;;
esac
[[ $EUID -eq 0 ]] || { echo "kawa-snap: runs as root — dnf runs pre and post itself; the rest: sudo kawa-snap $1" >&2; exit 2; }

note() {   # note WHAT ERR — to the journal (to stderr, should there be no journal to write to)
  local why=${2//$'\n'/ }
  command -v snapper >/dev/null || why="snapper is not installed"
  why="no snapshot $1 this dnf run: ${why:-snapper failed}"
  logger -t kawa-snap -p user.warning -- "${why:0:240}" 2>/dev/null || printf 'kawa-snap: %s\n' "$why" >&2
}
fail() { printf 'kawa-snap: %s\n' "$*" >&2; exit 1; }

# ── the boot menu's list ─────────────────────────────────────────────────────────────────
# grub-btrfs's script writes /boot/grub2/grub-btrfs.cfg, which grub.cfg's "snapshots" submenu
# reads at boot; grub.cfg itself is made again only while it lacks that submenu. No daemon
# (grub-btrfsd): this runs after each dnf run, each snapshot of an update or repair, and
# snapper's daily clean-up — the only times the list changes.
boot_list() {
  local s=/etc/grub.d/41_snapshots-btrfs out
  [[ -x $s ]] || { echo "kawa-snap: grub-btrfs is not installed — no snapshots in the boot menu (fedokawaii repair)" >&2; return 1; }
  if grep -qs 'grub-btrfs.cfg' /boot/grub2/grub.cfg; then
    out=$("$s" 2>&1 >/dev/null) || { printf 'kawa-snap: the boot menu list: %s\n' "${out//$'\n'/ }" >&2; return 1; }
  else
    out=$(grub2-mkconfig -o /boot/grub2/grub.cfg 2>&1) || { printf 'kawa-snap: grub2-mkconfig: %s\n' "${out//$'\n'/ }" >&2; return 1; }
  fi
  [[ -s /boot/grub2/grub-btrfs.cfg ]] || echo "kawa-snap: no snapshot to list in the boot menu yet" >&2
  return 0
}

# ── the pair around a dnf transaction ────────────────────────────────────────────────────
# the command, as it was typed — its options left out (snapper's own list shows the date);
# whole letters of any script kept, anything that is no text left out, at most 72 of them
what() {
  local a=""
  if [[ ${1:-} =~ ^[0-9]+$ && -r /proc/$1/cmdline ]]; then
    a=$(tr '\0' '\n' <"/proc/$1/cmdline" | awk 'NR > 1 && !/^-/ { printf " %s", $0 }' \
        | iconv -c -f UTF-8 -t UTF-8 2>/dev/null | sed 's/[[:cntrl:]]//g')
    a=${a:0:72}
  fi
  if [[ -n $a ]]; then printf 'dnf%s' "$a"; else printf 'dnf %s' "$(date '+%F %H:%M')"; fi
}
if [[ $1 == pre || $1 == post ]]; then
  # (dnf's actions plugin reads this program's stdout as requests to it: nothing may reach it)
  exec >/dev/null
  d=$(what "${2:-}")
  case $1 in
    pre)  # (a restore making its copy now: waited for, ten minutes at most — dnf is never stopped)
          { exec 9>"$lock" && flock -w 600 9; } 2>/dev/null
          # (the flat layout's /.snapshots not mounted from its subvolume: snapper would write into
          # the plain folder inside the system — no snapshot, said)
          if [[ $(findmnt --fstab -no OPTIONS /.snapshots 2>/dev/null) == *subvol=snapshots* \
                && $(findmnt -no SOURCE --mountpoint /.snapshots 2>/dev/null) != *"[/snapshots]" ]]; then
            note before "/.snapshots is not mounted from its subvolume (fstab names it) — sudo mount /.snapshots"; exit 0
          fi
          if ! err=$(snapper -c root create -t pre -p -c number -d "$d" 2>&1 >"$state") \
             || ! [[ $(<"$state") =~ ^[0-9]+$ ]]; then          # (only a number pairs with a post)
            rm -f "$state"; note before "${err:-snapper gave no snapshot number}"
          fi ;;
    post) [[ -s $state ]] || exit 0
          n=$(<"$state"); rm -f "$state"
          if [[ ! $n =~ ^[0-9]+$ ]]; then note after "no number from the pre snapshot"
          elif ! err=$(snapper -c root create -t post --pre-number "$n" -c number -d "$d" 2>&1 >/dev/null); then
            note after "$err"
          fi
          # (the new pre in the boot menu; a list that could not be made is the journal's)
          err=$(boot_list 2>&1) || logger -t kawa-snap -p user.warning -- "${err:0:240}" 2>/dev/null || true ;;
  esac
  exit 0
fi
[[ $1 == boot ]] && { boot_list; exit; }

# ── the disk itself: its top level, the root subvolume's name ────────────────────────────
# T — the root subvolume's name, as fstab mounts / (Fedora's installer: "root"); in a snapshot
# started from the boot menu fstab is the snapshot's own copy, so it names the same one
T=$(findmnt --fstab -no OPTIONS / 2>/dev/null | tr ',' '\n' | sed -n 's/^subvol=\/\{0,1\}//p' | head -n1)
# what runs, from which disk: the root subvolume (/T) or a snapshot of it (/snapshots/N/snapshot;
# before the flat layout /T/.snapshots/N/snapshot),
# mounted as it is — or, a snapshot started from the boot menu, under a layer in memory
# (systemd.volatile=overlay): then the kernel's own arguments name both (root=UUID=, rootflags=subvol=)
here="" dev=""
case $(findmnt -no FSTYPE / 2>/dev/null) in
  btrfs)   here=$(findmnt -no FSROOT / 2>/dev/null); dev=$(findmnt -no SOURCE / 2>/dev/null); dev=${dev%%\[*} ;;
  overlay) read -r -a args </proc/cmdline
           for a in "${args[@]}"; do
             case $a in
               root=UUID=*) dev=/dev/disk/by-uuid/${a#root=UUID=} ;;
               rootflags=*) here=/$(tr ',' '\n' <<<"${a#rootflags=}" | sed -n 's|^subvol=/\{0,1\}||p') ;;
             esac
           done ;;
esac
[[ -n $dev && $here == /?* ]] || fail "/ is not Btrfs — there are no snapshots of it"
[[ -n $T && $T != */* ]] || fail "fstab mounts / without a plain subvol= (it says: $(findmnt --fstab -no OPTIONS / 2>/dev/null)) — not the layout Fedora's installer makes"
booted=-; [[ $here =~ ^/(snapshots|$T/\.snapshots)/([0-9]+)/snapshot$ ]] && booted=${BASH_REMATCH[2]}
# S — where the snapshots are: their own subvolume at the top (the flat layout: fedokawaii-split),
# or the installer's, inside the root subvolume
mount_top() {
  mkdir -p "$top" || fail "cannot make $top"
  mountpoint -q "$top" || mount -o subvolid=5 "$dev" "$top" || fail "cannot mount the top of $dev"
  trap 'umount "$top" 2>/dev/null; rmdir "$top" 2>/dev/null' EXIT
  S=$top/$T/.snapshots; btrfs subvolume show "$top/snapshots" >/dev/null 2>&1 && S=$top/snapshots
  # flat — the disk's layout whole (fedokawaii-split): all four of its subvolumes at the top
  local x; flat=1
  for x in home log fk snapshots; do btrfs subvolume show "$top/$x" >/dev/null 2>&1 || flat=0; done
}
# the field of a snapper info.xml: one of type, date, description (XML's five escapes undone)
info() {
  sed -n "s:.*<$1>\(.*\)</$1>.*:\1:p" "$2" 2>/dev/null | head -n1 \
    | sed 's/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g; s/&apos;/'"'"'/g; s/&amp;/\&/g'
}

if [[ $1 == list ]]; then
  mount_top
  for d in "$S"/*/; do
    n=${d%/}; n=${n##*/}
    [[ $n =~ ^[0-9]+$ && -d $d/snapshot ]] || continue
    printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$(info type "$d/info.xml")" "$(info date "$d/info.xml")" \
      "$(info description "$d/info.xml")" "$([[ $n == "$booted" ]] && echo booted || echo -)"
  done | sort -n
  [[ -d $top/$T.new && ! -e $top/$T.new/.kawa-snap-copy ]] \
    && echo "kawa-snap: a restore was cut short after its exchange — its snapshots are back once it is finished (the start-up run does it, or: sudo kawa-snap finish)" >&2
  if [[ -d $top/$T.old ]]; then
    t=$(btrfs subvolume show "$top/$T.old" 2>/dev/null | sed -n 's/^[[:space:]]*Creation time:[[:space:]]*//p')
    printf 'old\tsingle\t%s\tthe system before the last restore\t-\n' "$(date -u -d "${t:-@0}" '+%F %T' 2>/dev/null)"
  fi
  exit 0
fi

# ── restore ──────────────────────────────────────────────────────────────────────────────
# Every step leaves a system that starts (design: .claude/notes/update-design.md §3.1): the copy
# and its kernels are made first and written to disk, nothing else changes; then ONE atomic
# exchange (exch: renameat2 RENAME_EXCHANGE — never a moment without a root subvolume, which the
# kernel mounts by name), synced, and at once the copy's newest kernel the default; then what lived
# inside the replaced root (the snapshots …) moves across. Nothing that may hold a subvolume is
# deleted recursively, and the system that ran is never deleted at all.
N=${2:-}
exec 9>"$lock"; flock -n 9 || fail "another restore is running — nothing changed"
for p in dnf5 dnf; do pgrep -x "$p" >/dev/null && fail "a package transaction is running ($p) — restore once it has finished; nothing changed"; done
mount_top
# (his files: until the disk's layout is whole (fedokawaii-split) they are inside the system, and go back too)
if [[ $1 == restore ]] && ((!flat)) && [[ ${3:-} != --with-home ]]; then
  fail "/home is inside the system: a restore takes your files back to that day too. Until /home is its own subvolume (fedokawaii repair arms that), say that is what you want: kawa-snap restore $N --with-home"
fi
[[ -d $top/$T ]] || fail "the root subvolume $T is not on this disk"
# (/boot and the ESP where GRUB reads them: unmounted, the kernels would land inside the copy)
mountpoint -q /boot || fail "/boot is not mounted — nothing changed (sudo mount /boot, then again)"
if findmnt --fstab -no TARGET /boot/efi >/dev/null 2>&1 && ! mountpoint -q /boot/efi; then
  fail "/boot/efi is not mounted — nothing changed (sudo mount /boot/efi, then again)"
fi
command -v exch >/dev/null || fail "exch (util-linux) is missing — the exchange could not be atomic; nothing changed"
new=$top/$T.new copy=$top/$T.copy
mark=.kawa-snap-copy        # (in a copy until it is exchanged in: a $T.new without it is the system that ran;
                            # the copy is made as $T.copy, marked, then named $T.new — never unmarked there)
binds=() added=() sk="" skb=""
unbind() { local i; for ((i = ${#binds[@]} - 1; i >= 0; i--)); do umount "${binds[i]}" 2>/dev/null; done; binds=(); }
gone() { btrfs subvolume delete --commit-after "$1" >/dev/null 2>&1; }   # (never -R: one subvolume, synced)
# power_cut STEP — a power cut at that step, for the VM's proof only (tools/vm-inject/restore-cut.sh
# sets KAWA_SNAP_CUT and makes /run/kawa-snap.cut): the kernel restarts at once, nothing synced
power_cut() { [[ ${KAWA_SNAP_CUT:-} == "$1" && -e /run/kawa-snap.cut ]] || return 0; echo b >/proc/sysrq-trigger; sleep 30; }
# whole V — kernel V complete in /boot: the kernel, its boot image, its entry
# (a boot entry that lost root= or rootflags=: as good as none, made again — design §5 row 31)
whole() {
  [[ -f /boot/vmlinuz-$1 && -s /boot/initramfs-$1.img ]] || return 1
  local e
  for e in /boot/loader/entries/*-"$1".conf; do
    [[ -f $e ]] && grep -Eq '^options .*root=' "$e" && grep -Eq '^options .*rootflags=subvol=' "$e" && return 0
  done
  return 1
}
newest() { local m; for m in "$1"/usr/lib/modules/*/vmlinuz; do [[ -f $m ]] && m=${m%/vmlinuz} && echo "${m##*/}"; done | sort -V | tail -n1; }
start="restart now"   # (what the last line asks: the default could not be set → choose the kernel)
default_to() {   # default_to V — kernel V's entry the default, written to disk
  if ! grubby --set-default "/boot/vmlinuz-$1" >/dev/null 2>&1; then
    echo "kawa-snap: the default boot entry could not be set" >&2
    start="at the next start, choose kernel $1 in the boot menu (hold Shift)"; return 0
  fi
  sync -f /boot || echo "kawa-snap: /boot not confirmed on disk — wait a minute before restarting" >&2
}
parents() {   # parents REL — the folders above REL made in the restored system, owned as in the one that ran
  local d=${1%/*} acc="" x IFS=/
  [[ $d != "$1" ]] || return 0
  for x in $d; do
    acc+=${acc:+/}$x
    [[ -d $top/$T/$acc ]] && continue
    mkdir "$top/$T/$acc" && chown --reference="$new/$acc" "$top/$T/$acc" && chmod --reference="$new/$acc" "$top/$T/$acc"
  done
}
# finish — the restore's tail, after the exchange and the default ($T the restored system, $T.new
# the one that ran): what lived inside the replaced root (the snapshots, systemd's machines …)
# moves across — a snapshot holds an empty folder where each was — then the replaced one is named
# $T.old (the one before it kept in $T.old.d with its time, at most two there), synced
finish() {
  local p rel o i olds=()
  rm -f -- "$top/$T/$mark"
  while IFS= read -r p; do
    p=${p#<FS_TREE>/}; rel=${p#"$T.new"/}
    [[ $p == "$T.new"/* && -n $rel ]] || continue
    if [[ -d $top/$T/$rel ]]; then
      rmdir "$top/$T/$rel" 2>/dev/null || { echo "kawa-snap: $rel is not empty in the restored system — left in $T.old" >&2; continue; }
    else parents "$rel"; fi
    mv -T --no-copy "$new/$rel" "$top/$T/$rel" || echo "kawa-snap: $rel could not move across — left in $T.old" >&2
  done < <(btrfs subvolume list -o "$new" 2>/dev/null | sed -n 's/.* path //p')
  power_cut moved
  mkdir -p "$top/$T.old.d"
  if [[ -d $top/$T.old ]]; then mv -T --no-copy "$top/$T.old" "$top/$T.old.d/$(date +%s)" || echo "kawa-snap: the older $T.old could not be put aside" >&2; fi
  mapfile -t olds < <(for o in "$top/$T.old.d"/*; do [[ -d $o ]] && echo "${o##*/} $o"; done | sort -n | cut -d' ' -f2-)
  for ((i = 0; i < ${#olds[@]} - 2; i++)); do
    if [[ -n $(btrfs subvolume list -o "${olds[i]}" 2>/dev/null) ]]; then echo "kawa-snap: ${olds[i]##*/} kept (it holds a subvolume)" >&2
    elif ! gone "${olds[i]}"; then echo "kawa-snap: ${olds[i]##*/} could not be removed" >&2; fi
  done
  # (the system that ran: named $T.old — never left under the copy's name for long)
  mv -T --no-copy "$new" "$top/$T.old" || mv -T --no-copy "$new" "$top/$T.old.d/$(date +%s)-$$" \
    || echo "kawa-snap: the system before is kept as $T.new (it could not be renamed) — the next restore finishes it" >&2
  power_cut renamed
  # (an update's open phase — a run cut, or one whose snapshot was offered — was about the system
  # this restore replaced: ended, so no start judges the restored one by it)
  if [[ -s $uphase ]]; then printf 'end %s\n' "$(date +%s)" >"$uphase" || echo "kawa-snap: the update's phase could not be ended ($uphase)" >&2; fi
  btrfs filesystem sync "$top" >/dev/null 2>&1 || echo "kawa-snap: not confirmed on disk — wait a minute before restarting" >&2
}
# finish_cut — a leftover $T.new without the mark is the system that ran before a restore cut short
# after its exchange: the restored system is running — that restore is finished (its default, the
# moves, the names), never deleted. → 1 there was none
finish_cut() {
  [[ -d $new && ! -e $new/$mark ]] || return 1
  local k; k=$(newest "$top/$T"); if [[ -n $k ]] && whole "$k"; then default_to "$k"; fi
  finish
  restorecon -R /boot >/dev/null 2>&1 || true
  boot_list >/dev/null 2>&1 || true
  sync || echo "kawa-snap: not confirmed on disk — wait a minute before restarting" >&2
  echo "kawa-snap: a restore cut short after its exchange is finished — the system running now is the restored one, the one before it is $T.old (kawa-snap restore old goes back to it)."
}
if [[ $1 == finish ]]; then finish_cut || echo "kawa-snap: no restore to finish"; exit 0; fi
if finish_cut; then echo "kawa-snap: nothing else was done — for another restore, run it again."; exit 0; fi
# (a leftover copy that was never exchanged in has the mark: removed)
if [[ -d $new ]]; then gone "$new" || fail "a leftover copy $T.new could not be removed"; fi
# (a copy a run cut before marking it: never the system that ran — removed)
if [[ -d $copy ]]; then gone "$copy" || fail "a leftover copy $T.copy could not be removed"; fi
src=$S/$N/snapshot; [[ $N == old ]] && src=$top/$T.old
if [[ ! -d $src ]]; then
  [[ $N == old ]] && fail "no system before the last restore is kept — nothing changed"
  fail "there is no snapshot $N (kawa-snap list shows them)"
fi
btrfs subvolume snapshot "$src" "$copy" >/dev/null || fail "the writable copy of $N could not be made — nothing changed"
if ! { : >"$copy/$mark" && mv -T --no-copy "$copy" "$new"; }; then gone "$copy"; fail "the copy of $N could not be made ready — nothing changed"; fi
power_cut copied
undo() {   # undo WHY — before the exchange only: the kernels this run added out of /boot, the copy gone
  local v left=""
  for v in "${added[@]}"; do
    inside kernel-install remove "$v" >/dev/null 2>&1
    # (an entry kernel-install did not take — a name without its token: said; the system that runs
    # has no modules for v, so the next start's one-kernel rule takes it out)
    if [[ -e /boot/vmlinuz-$v ]] || compgen -G "/boot/loader/entries/*$v.conf" >/dev/null; then left+=" $v"; fi
  done
  [[ -n $skb ]] && printf '%s\n' "$skb" >"$sk"
  unbind; gone "$new"
  [[ -z $left ]] || echo "kawa-snap: kernel$left is still in /boot — unused; the next start takes it out" >&2
  fail "$* — nothing changed"
}
# the copy's first start must not relabel everything or run an old offline update (§3.1)
rm -f -- "$new/.autorelabel" "$new/system-update" "$new/etc/system-update"
# the disk's layout in the copy's fstab — a snapshot from before the split has none of it: your
# files, the logs, the updater's memory and the snapshots stay today's, mounted where they belong;
# and today's kawa-snap and fedokawaii-split in it (an older kawa-snap would look for the snapshots
# inside the system; the rest of the toolkit is that day's until the next update)
if ((flat)); then
  { mkdir -p "$new/home" "$new/var/log" "$new/var/lib/fedokawaii/update" "$new/.snapshots" \
    && /usr/local/sbin/fedokawaii-split fstab "$new/etc/fstab" "$top" \
    && cp -a /usr/local/sbin/kawa-snap /usr/local/sbin/fedokawaii-split "$new/usr/local/sbin/"; } \
    || undo "the copy could not be given the disk's layout (its fstab, kawa-snap)"
fi
# the kernels the copy has (each with its vmlinuz: Fedora keeps one beside its modules)
mapfile -t K < <(for m in "$new"/usr/lib/modules/*/vmlinuz; do [[ -f $m ]] && m=${m%/vmlinuz} && echo "${m##*/}"; done | sort -V)
((${#K[@]})) || undo "snapshot $N has no kernel in /usr/lib/modules"
# chroot into the copy, /boot and the kernel's file systems with it: its own kernel-install
# and dracut make what /boot lacks for it (a kernel removed since the snapshot was taken)
inside() {
  if ((!${#binds[@]})); then
    local m
    for m in /dev /proc /sys /run /boot /boot/efi; do
      mountpoint -q "$m" || continue
      mount --bind "$m" "$new$m" || { unbind; return 1; }
      binds+=("$new$m")
    done
  fi
  chroot "$new" "$@"
}
# …added without making any of them the default (the copy's UPDATEDEFAULT off for the run, and a
# promotion an interrupted kernel install left in grubenv dropped): a cut before the exchange
# then starts the system that runs now, with its own kernel
sk=$new/etc/sysconfig/kernel
[[ -f $sk ]] && skb=$(<"$sk") && sed -i 's/^UPDATEDEFAULT=.*/UPDATEDEFAULT=no/' "$sk"
grub2-editenv /boot/grub2/grubenv unset tmp_saved_entry >/dev/null 2>&1 || true
for v in "${K[@]}"; do
  whole "$v" && continue
  echo "kawa-snap: kernel $v back into /boot (its boot image is made: a minute or two)"
  added+=("$v")
  inside kernel-install add "$v" "/usr/lib/modules/$v/vmlinuz" >/dev/null 2>&1 || undo "kernel $v could not be put back into /boot"
done
[[ -n $skb ]] && printf '%s\n' "$skb" >"$sk"
unbind
# /boot and the ESP on disk before the exchange: the restored system's kernels are there whole
sync -f /boot || undo "/boot could not be written"
if mountpoint -q /boot/efi; then sync -f /boot/efi || undo "the EFI partition could not be written"; fi
power_cut kernels
btrfs filesystem sync "$top" >/dev/null 2>&1 || undo "the disk could not be synced"
# the exchange: the copy is the root subvolume from here; $new names the system that ran
exch "$top/$T" "$new" || undo "the exchange failed"
btrfs filesystem sync "$top" >/dev/null 2>&1 || echo "kawa-snap: the exchange not confirmed on disk — wait a minute before restarting" >&2
power_cut exchanged
# the default at once: the restored system's newest kernel (the ones it lacks stay until it has
# started — the one-kernel rule takes them then)
default_to "${K[-1]}"
power_cut defaulted
finish
restorecon -R /boot >/dev/null 2>&1 || true
boot_list >/dev/null 2>&1 || true
sync || echo "kawa-snap: not confirmed on disk — wait a minute before restarting" >&2
echo "kawa-snap: snapshot $N is the system from the next start — $start; install nothing before (it would land in the system being replaced). The one it replaced is kept as $T.old (kawa-snap restore old goes back to it)."
