#!/usr/bin/env bash
# /usr/local/sbin/kawa-snap pre|post [PID] — called by libdnf5-plugin-actions around every
# dnf transaction: a snapper "pre" snapshot before, the matching "post" after, both named by
# the dnf command that ran (from PID, dnf's own process: "dnf install htop"). It never
# stops dnf; a snapshot that could not be taken is written to the journal (journalctl -t
# kawa-snap), and `fedokawaii update` takes and checks its own before it starts.
# Inspect: sudo snapper -c root list · revert one transaction: sudo snapper -c root undochange PRE..POST
# Exit status: 0 always for pre and post (dnf goes on whatever happens) · 2 misuse.
set -u
export LC_ALL=C.UTF-8
state=/run/kawa-snap.pre
case ${1:-} in
  pre|post) ;;
  -h|--help) sed -n '2,8{s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
  *) echo "usage: kawa-snap pre|post [PID] — dnf runs it around each transaction" >&2; exit 2 ;;
esac
[[ $EUID -eq 0 ]] || { echo "kawa-snap: dnf runs it, as root, around each transaction — not by hand" >&2; exit 2; }
# (dnf's actions plugin reads this program's stdout as requests to it: nothing may reach it)
exec >/dev/null

# the command, as it was typed — its options left out (snapper's own list shows the date);
# whole letters of any script kept, anything that is no text left out, at most 72 of them
what() {
  local a=""
  if [[ ${1:-} =~ ^[0-9]+$ && -r /proc/$1/cmdline ]]; then
    a=$(tr '\0' '\n' <"/proc/$1/cmdline" | awk 'NR > 1 && !/^-/ { printf " %s", $0 }' \
        | iconv -c -f UTF-8 -t UTF-8 2>/dev/null | sed 's/[[:cntrl:]]//g')
    a=${a:0:72}
  fi
  if [[ -n $a ]]; then printf 'dnf%s' "$a"; else printf 'dnf %s' "$(date '+%F %H:%M')"; fi
}
note() {   # note WHAT ERR — to the journal (to stderr, should there be no journal to write to)
  local why=${2//$'\n'/ }
  command -v snapper >/dev/null || why="snapper is not installed"
  why="no snapshot $1 this dnf run: ${why:-snapper failed}"
  logger -t kawa-snap -p user.warning -- "${why:0:240}" 2>/dev/null || printf 'kawa-snap: %s\n' "$why" >&2
}
d=$(what "${2:-}")
case $1 in
  pre)  if ! err=$(snapper -c root create -t pre -p -c number -d "$d" 2>&1 >"$state") \
           || ! [[ $(<"$state") =~ ^[0-9]+$ ]]; then          # (only a number pairs with a post)
          rm -f "$state"; note before "${err:-snapper gave no snapshot number}"
        fi ;;
  post) [[ -s $state ]] || exit 0
        n=$(<"$state"); rm -f "$state"
        if [[ ! $n =~ ^[0-9]+$ ]]; then note after "no number from the pre snapshot"
        elif ! err=$(snapper -c root create -t post --pre-number "$n" -c number -d "$d" 2>&1 >/dev/null); then
          note after "$err"
        fi ;;
esac
exit 0
