#!/bin/sh
# /usr/local/bin/start-dwl — the session the login (agreety) starts (installed by setup.sh).
# Works with or without theme.sh: without it, dwl runs with upstream defaults and no autostart.

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=dwl
export XDG_CURRENT_DESKTOP=wlroots

# keyboard (from fedokawaii.conf, filled in by setup.sh)
export XKB_DEFAULT_LAYOUT="@KB_LAYOUTS@"
export XKB_DEFAULT_OPTIONS="@KB_TOGGLE@"

# toolkits: Wayland first, XWayland when an app has no Wayland support
export QT_QPA_PLATFORM="wayland;xcb"
export QT_QPA_PLATFORMTHEME=qt6ct
export GDK_BACKEND="wayland,x11"
# file dialogs through the portal, so they are the desktop's (yazi, see wlroots-portals.conf):
# GTK 3 programs only with this (it also sends their print dialog through the portal — the
# same GTK dialog); GTK 4 (4.22) and Brave use the portal by themselves whenever it runs
export GTK_USE_PORTAL=1
# SDL_VIDEODRIVER is deliberately not set: games bundling an older SDL2 fail to start
# when it is, and SDL3 already picks Wayland by itself.
export _JAVA_AWT_WM_NONREPARENTING=1

export EDITOR=nvim VISUAL=nvim TERMINAL=foot BROWSER=brave-origin
# the pointers: "default" is ~/.local/share/icons/default, a link to the Sumi pointers of the
# theme in use (kawa-theme re-points it), so programs reading this follow the theme too
export XCURSOR_THEME=default XCURSOR_SIZE=24
export PATH="$HOME/.local/bin:$PATH"

mkdir -p "$HOME/.cache"
LOG="$HOME/.cache/dwl.log"

# one desktop at a time: a second dwl (start-dwl typed in a terminal, or on another console)
# would share this one's runtime folder — the bar's files, the session's services — and
# stop them when it ends
pid=$(pgrep -xu "$(id -u)" 'dwl(\.prev)?' 2>/dev/null | head -n1)
if [ -n "$pid" ]; then
  printf 'start-dwl: the desktop is already running (dwl, process %s): one at a time.\n' "$pid" >&2
  exit 1
fi
# Fedora 45 draws its text consoles (Ctrl+Alt+F2…) with kmscon, a program that holds the
# screen itself: started from one, the session asks kmscon to hand the screen over, and to
# take it back afterwards — through the helper kmscon names in KMS_START_SCRIPT
# (kmscon-launch-gui). The session starts again without kmscon's two marks, knowing it was
# handed over (KAWA_KMSCON, for the rescue screen below).
if [ -n "${KMS_START_SCRIPT:-}" ] && command -v "$KMS_START_SCRIPT" >/dev/null 2>&1; then
  exec "$KMS_START_SCRIPT" env -u KMS_START_SCRIPT -u TERM_SESSION_TYPE KAWA_KMSCON=1 "$0"
fi
from_kmscon=${KAWA_KMSCON:-}; unset KAWA_KMSCON
# the session before keeps its log beside the new one: what dwl said before a crash
[ -s "$LOG" ] && mv -f "$LOG" "$LOG.old"
: >"$LOG"

# the compositor: dwl — or, should it be unable to start (missing, a library missing, or it
# stops at once), a rescue screen on this console instead of a login that only loops back:
# fedokawaii repair builds it again
rescue() {
  printf 'start-dwl: the desktop could not start: %s\n' "$1" >>"$LOG"
  # a dwl that ran for a moment may have started the graphical session for systemd (its
  # autostart): end it, so no portal waits for a display that is gone
  systemctl --user stop dwl-session.target 2>/dev/null
  systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null
  printf '\n  The desktop could not start: %s.\n\n' "$1"
  printf '  This console works as usual. To put things right:\n\n'
  printf '      fedokawaii repair      finds what broke and fixes it (or: fedokawaii, the menu)\n\n'
  printf '  What dwl said: %s · Ctrl+D logs out.\n\n' "$LOG"
  # (handed over by kmscon: back to the shell you started from, once kmscon shows it again —
  # a new one now would wait unseen, while kmscon still keeps the screen dark)
  [ -n "$from_kmscon" ] && exit 1
  exec bash -l
}
runs() { [ -x "$1" ] && ! ldd "$1" 2>/dev/null | grep -q 'not found'; }
DWL=/usr/local/bin/dwl
if ! runs "$DWL"; then
  if [ ! -x "$DWL" ]; then rescue "dwl is not installed ($DWL)"
  else rescue "dwl is missing a library ($(ldd "$DWL" 2>/dev/null | awk '/not found/ { print $1; exit }'))"; fi
fi
AUTOSTART="$HOME/.config/dwl/autostart.sh"
# dwl runs its startup command through sh -c: a home folder with a space or a quote in its
# name is quoted for it
case $AUTOSTART in
  *[!A-Za-z0-9/._-]*) STARTUP="'$(printf '%s' "$AUTOSTART" | sed "s/'/'\\\\''/g")'" ;;
  *)                  STARTUP=$AUTOSTART ;;
esac
# at_once BINARY — run the session; true when it never really started (gone within five
# seconds, with an error; its status in rc). Timed by the uptime, not the clock: chrony may
# set the clock back hours meanwhile (dual boot: Windows keeps the hardware clock in local
# time), and a crash an hour later would look like one at once.
at_once() {
  read -r t0 _ </proc/uptime 2>/dev/null || t0=0
  if [ -x "$AUTOSTART" ]; then "$1" -s "$STARTUP" >>"$LOG" 2>&1; else "$1" >>"$LOG" 2>&1; fi
  rc=$?
  read -r t1 _ </proc/uptime 2>/dev/null || t1=0
  [ "$rc" -ne 0 ] && [ $(( ${t1%.*} - ${t0%.*} )) -lt 5 ]
}
# (a build that starts and stops at once — a change to config.h, say — is a rescue too)
if at_once "$DWL"; then rescue "dwl stopped at once (exit $rc)"; fi

# logged out: end the graphical session for systemd (the portals stop with it) and take
# this session's display out of the environment of what systemd --user starts later
systemctl --user stop dwl-session.target 2>/dev/null
systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP \
  XDG_SESSION_DESKTOP XDG_SESSION_TYPE 2>/dev/null
exit 0
