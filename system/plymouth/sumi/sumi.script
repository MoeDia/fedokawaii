# /usr/share/plymouth/themes/sumi/sumi.script — the boot splash, after the boot menu: the
# same sumi ink and the same vermilion torii, "起動中 · starting Fedora" under it, and three
# small squares lighting in turn while the system starts. At a power-off or a restart the
# same splash comes back with its own words: "終了中 · shutting down", "再起動中 · restarting"
# (Plymouth.GetMode: plymouth-poweroff/-reboot.service start plymouthd in those modes).
# A disk that asks for its password gets the lock screen's box: パスワード, and a vermilion ◆ for each character typed.
# Everything sits on whole pixels around the screen's middle (Math.Int: no half pixels).

Window.SetBackgroundTopColor(0.059, 0.055, 0.047);      # #0f0e0c, the ground of the dark theme
Window.SetBackgroundBottomColor(0.059, 0.055, 0.047);

cx = Math.Int(Window.GetWidth() / 2);
cy = Math.Int(Window.GetHeight() / 2);

torii.image = Image("torii.png");                        # 88 × 88
torii.sprite = Sprite(torii.image);
torii.sprite.SetPosition(cx - Math.Int(torii.image.GetWidth() / 2), cy - torii.image.GetHeight() - 20, 1);

mode = Plymouth.GetMode();
if (mode == "shutdown") words.image = Image("stopping.png");
else if (mode == "reboot") words.image = Image("restarting.png");
else words.image = Image("starting.png");
words.sprite = Sprite(words.image);
words.sprite.SetPosition(cx - Math.Int(words.image.GetWidth() / 2), cy + 8, 1);

# the three squares: 6 px, 12 px apart (centre to centre 18), the middle one on the centre line
dot_on = Image("dot-on.png");
dot_off = Image("dot-off.png");
for (i = 0; i < 3; i++) {
  dots[i] = Sprite(dot_off);
  dots[i].SetPosition(cx - 3 + (i - 1) * 18, cy + 52, 1);
}
frame = 0;
fun refresh_callback () {
  frame++;
  lit = Math.Int(frame / 15) % 3;                      # (50 frames a second: a step every 0.3 s)
  for (i = 0; i < 3; i++) {
    if (i == lit) dots[i].SetImage(dot_on);
    else dots[i].SetImage(dot_off);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# ── a disk's password (an encrypted disk): the lock screen's box ────────────────────
ask.image = Image("password.png");
ask.sprite = Sprite(ask.image);
ask.sprite.SetPosition(cx - Math.Int(ask.image.GetWidth() / 2), cy + 52, 2);
ask.sprite.SetOpacity(0);
box.image = Image("box.png");                            # 288 × 44
box.sprite = Sprite(box.image);
box.sprite.SetPosition(cx - 144, cy + 88, 2);
box.sprite.SetOpacity(0);
diamond = Image("diamond.png");                          # 22 × 22, set 24 apart as the lock's are
for (i = 0; i < 10; i++) {
  marks[i] = Sprite(diamond);
  marks[i].SetOpacity(0);
}

fun display_password_callback (prompt, bullets) {
  for (i = 0; i < 3; i++) dots[i].SetOpacity(0);
  ask.sprite.SetOpacity(1);
  box.sprite.SetOpacity(1);
  shown = bullets;
  if (shown > 10) shown = 10;                            # (the box holds ten; more still count)
  left = cx - Math.Int((shown * 24 - 2) / 2);
  for (i = 0; i < 10; i++) {
    if (i < shown) {
      marks[i].SetPosition(left + i * 24, cy + 99, 3);    # (the box's middle: 88 + 22 − 11)
      marks[i].SetOpacity(1);
    }
    else marks[i].SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
  ask.sprite.SetOpacity(0);
  box.sprite.SetOpacity(0);
  for (i = 0; i < 10; i++) marks[i].SetOpacity(0);
  for (i = 0; i < 3; i++) dots[i].SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);
