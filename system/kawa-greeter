#!/usr/bin/env bash
# /usr/local/bin/kawa-greeter — the login screen: greetd runs this on tty1.
# agreety ships with greetd: it prints /etc/issue, then asks for the user name and
# password, exactly like a text console login. Nothing else to install or theme;
# the console's colours come from the kernel palette that the theme sets.
printf '\e[H\e[2J\e[3J'                 # start from an empty screen (boot messages gone)
# The session launcher gone (a half-finished repair, a removed file): every login would end
# at once and come straight back here. Say so, and let a login give a text console instead,
# where repair puts the launcher back.
if [[ ! -x /usr/local/bin/start-dwl ]]; then
  printf '\n  The desktop cannot start: /usr/local/bin/start-dwl is missing.\n'
  printf '  Log in for a text console, then run:  fedokawaii repair\n\n'
  exec agreety --cmd "/bin/bash -l"
fi
exec agreety --cmd /usr/local/bin/start-dwl
