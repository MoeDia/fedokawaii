#!/usr/bin/env bash
# /usr/local/bin/fedokawaii — the system's own control: how it stands, and all its upkeep.
#
#   fedokawaii             the menu (Super+U opens it in a window of its own, and a job
#                          started there — an update, a backup — in a window that stays open
#                          until it ends; on a text console, or with no working fzf, a plain
#                          numbered menu)
#   fedokawaii status      how it stands, as text — instant, from what is known
#   fedokawaii update      the season's update: packages, the desktop's own tools, checks
#   fedokawaii pull        fedokawaii itself from GitHub: your clone (~/repos/fedokawaii)
#                          brought to GitHub's newest, then the update from it, and repair if
#                          anything is left (asks once for the token of the private repository)
#   fedokawaii upgrade     move to the next Fedora release, once it has settled
#   fedokawaii upgrade --now   the same, without waiting for it to settle
#   fedokawaii verify      prove everything is installed right (changes nothing)
#   fedokawaii repair      find what broke and put it right (offline too, as far as it can)
#   fedokawaii theme       every config back as the toolkit has it (dwl rebuilt if needed)
#   fedokawaii drift       the configs that differ from the toolkit's (changes nothing)
#   fedokawaii snapshots   the system's snapshots, newest last
#   fedokawaii backup      your files to the backup drive, now (kawa-backup; chapter 37)
#   fedokawaii log         the last run's log
#   fedokawaii settings    fedokawaii.conf (keyboard, refresh rate, city…), applied by update
#   fedokawaii remind [every DAYS | wait DAYS | on | off | check]
#                          the reminder of the update season (default: every 90 days) — and
#                          of a backup older than BACKUP_REMIND_DAYS (fedokawaii.conf)
#   fedokawaii guide       the learning guide (the PDF; on a text console, its text)
#   fedokawaii freesync    whether FreeSync works, now: a line a screen, from the card itself
#   fedokawaii report [--quick | --perf]   the health report: ~/fedokawaii-report.txt, one
#                          file to hand on (--perf: every interaction timed, again and again)
#   fedokawaii selftest [--sandbox]   the installer checked here, changing nothing: the
#                          settings, the scripts, setup's records, the last run's log, packages a
#                          second run would change, configs (--sandbox: its torture suite too, in a
#                          fake machine of its own, from your clone's tests)
#   fedokawaii trial       the package steps for real in a throw-away Fedora container, attacked
#                          (a kill mid-install, a 404 mirror, stale metadata, a held rpm lock,
#                          refused downloads): ~/fedokawaii-trial.txt, one file to send (podman)
#
# Changing the desktop itself (handbook, chapter 42) — in your working copy, never the toolkit:
#   fedokawaii copy        make it, once: ~/repos/fedokawaii — the clone pull keeps current
#   fedokawaii keep FILE…  a config you changed in place (~/.config/…), copied into the copy
#   fedokawaii diff        what the copy would change in the toolkit (changes nothing)
#   fedokawaii apply       the copy checked, made the toolkit, applied (sudo)
#   fedokawaii change      the same as a menu, part by part (Super+Shift+U)
#   (another place for the copy: FEDOKAWAII_COPY=/path/to/it in your environment)
#   fedokawaii help        this text
#
# Exit status: 0 done · 1 it could not (the lines above say why) · 2 misuse — and what a run
# as root ended with: 3 it ran, and something still needs you (verify, repair, apply, drift),
# 4 drift: in sync but for the boot menu and console, 130 stopped (Ctrl+C).
#
# What changes the system runs as root, through sudo (it asks for your password, here):
# the toolkit root runs is the copy setup installed in /usr/local/lib/fedokawaii — root's,
# so nothing running as you can change what root runs. This file is installed from it.
# Only bash, coreutils, util-linux and sudo are needed; fzf and foot make the menu.
# Nothing here goes on the network by itself: the reminders read only what is known. The
# one look outside — whether the next Fedora is out, one request to Fedora's own servers,
# at most once a day — happens when you open the menu, and an update makes it too.
set -u
export LC_ALL=C.UTF-8
TK=/usr/local/lib/fedokawaii
STATE=/var/lib/fedokawaii                  # the toolkit's records (root writes, all read)
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/fedokawaii/upkeep.conf
CACHE=${XDG_CACHE_HOME:-$HOME/.cache}/fedokawaii
NOTICE=$CACHE/reminded                     # the day the last reminder was shown
BACKUP_REC=${XDG_STATE_HOME:-$HOME/.local/state}/fedokawaii/last-backup   # kawa-backup's record: "EPOCH<tab>…"
BACKUP_TOLD=$CACHE/reminded-backup         # the day the last backup reminder was shown
DAY=86400
# the backup settings (none: no backups set up), from the toolkit's fedokawaii.conf as settings
# saved it — they count at once — by lib/common.sh's parser (data, never run): their one place.
# (No toolkit: none — what needs it says so, need_toolkit.)
BACKUP_TARGET="" BACKUP_REMIND_DAYS=7
if [[ -f $TK/fedokawaii.sh ]]; then
  l=$(LOG_FILE=/dev/null; . "$TK/lib/common.sh" >/dev/null && read_conf "$TK/fedokawaii.conf" \
      && printf '%s\037%s' "$BACKUP_TARGET" "$BACKUP_REMIND_DAYS")
  IFS=$'\037' read -r BACKUP_TARGET BACKUP_REMIND_DAYS <<<"$l"
  unset l
fi
[[ $BACKUP_REMIND_DAYS =~ ^[0-9]{1,3}$ ]] || BACKUP_REMIND_DAYS=7   # (fedokawaii.conf edited by hand into no number)

# ── settings: how often, and how long to let a new Fedora settle ───────────────────────
EVERY=90 WAIT=60 REMIND=yes
load_conf() {
  local k v
  [[ -r $CONF ]] || return 0
  # (a last line without its newline counts too: the file may have been edited by hand)
  while IFS='=' read -r k v || [[ -n $k ]]; do
    k=${k//[[:space:]]/}; v=${v%%#*}; v=${v//[!0-9a-z]/}
    # (10#: "08" is eight, not octal; a number too long for that is no setting)
    if [[ $v =~ ^[0-9]+$ ]]; then if ((${#v} <= 9)); then v=$((10#$v)); else v=""; fi; fi
    case $k in
      EVERY)  [[ $v =~ ^[0-9]+$ ]] && ((v >= 7 && v <= 365)) && EVERY=$v ;;
      WAIT)   [[ $v =~ ^[0-9]+$ ]] && ((v <= 180)) && WAIT=$v ;;
      REMIND) [[ $v == yes || $v == no ]] && REMIND=$v ;;
    esac
  done <"$CONF"
}
save_conf() {
  mkdir -p "${CONF%/*}" && printf '%s\n' \
    "# ~/.config/fedokawaii/upkeep.conf — the update season (fedokawaii remind; Super+U → reminders)" \
    "EVERY=$EVERY     # days between updates: a reminder once they have passed (7–365)" \
    "WAIT=$WAIT       # days a new Fedora release settles before the move to it is offered (0–180)" \
    "REMIND=$REMIND   # yes | no" >"$CONF.$$" && mv -f "$CONF.$$" "$CONF"
}
load_conf

# ── what is known ───────────────────────────────────────────────────────────────────────
now=$(date +%s)
OS_RELEASE=${FEDOKAWAII_OS_RELEASE:-/etc/os-release}
osr() {   # osr KEY → its value in os-release ("" if none)
  # shellcheck source=/dev/null
  (. "$OS_RELEASE" 2>/dev/null; printf '%s' "${!1:-}")
}
ver() {   # the Fedora release, a whole number (0 if it cannot be read)
  local v; v=$(osr VERSION_ID); v=${v%%.*}
  if [[ $v =~ ^[0-9]+$ ]]; then printf '%s' "$v"; else printf 0; fi
}
day() { date -d "@$1" '+%-d %b %Y' 2>/dev/null; }                                # 3 Oct 2026
ago() {   # ago EPOCH → today · yesterday · 12 days ago
  local d=$(( (now - $1) / DAY ))
  if ((d <= 0)); then echo today; elif ((d == 1)); then echo yesterday; else echo "$d days ago"; fi
}
inn() {   # inn EPOCH → now · tomorrow · in 12 days
  local d=$(( ($1 - now + DAY - 1) / DAY ))
  if ((d <= 0)); then echo now; elif ((d == 1)); then echo tomorrow; else echo "in $d days"; fi
}
epoch() { date -d "$1" +%s 2>/dev/null; }
num() { [[ ${1:-} =~ ^[0-9]+$ ]]; }

# the toolkit's records: one line each, written by root when it ran (all can read them)
read_rec() { local f=$STATE/$1; [[ -r $f ]] && head -n1 "$f"; }
last_update() { local l; l=$(read_rec last-update) || return 1; [[ $l =~ ^([0-9]+)\ ([a-z]+) ]] || return 1; echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"; }
busy() {   # a toolkit run (update, repair, …) holds its lock right now
  [[ -r $STATE/lock ]] || return 1
  ( exec 8<"$STATE/lock" && ! flock -n 8 ) 2>/dev/null
}

# Fedora's releases. Yours: its end of support is in os-release (SUPPORT_END, kept current
# by Fedora's own updates). The next: out once its release tree is published — the day
# that tree was made is its release day, as an update, an upgrade or this menu last found
# it. Neither known: Fedora's rhythm — a release every six months (Fedora 40 on 23 Apr
# 2024), each supported until four weeks after the one two later. Marked "about" then.
est_release() { echo $(( $(epoch 2024-04-23) + ($1 - 40) * 15778800 )); }       # 182.6 days
eol_of() {   # eol_of N → "EOL exact|about" (exact only for the release running)
  local e
  if (($1 == $(ver))); then
    e=$(osr SUPPORT_END)     # (YYYY-MM-DD; an empty one would read as today)
    [[ $e =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && e=$(epoch "$e") && num "$e" && { echo "$e exact"; return; }
  fi
  echo "$(( $(est_release $(($1 + 2))) + 28 * DAY )) about"
}
out_since() {   # out_since N → the release day of Fedora N, if it is known to be out
  local f r
  for f in "$STATE/release-$1" "$CACHE/release-$1"; do
    r=$(head -n1 "$f" 2>/dev/null) && num "$r" && { echo "$r"; return 0; }
  done
  (($1 <= $(ver))) && { est_release "$1"; return 0; }
  return 1
}
release_check() {   # whether the next Fedora is out: Fedora's own release tree, once a day
  local n=$(( $(ver) + 1 )) h lm url
  [[ -s $STATE/release-$n || -s $CACHE/release-$n ]] && return 0
  [[ -e $CACHE/checked && $(( now - $(stat -c %Y "$CACHE/checked") )) -lt $DAY ]] && return 0
  command -v curl >/dev/null || return 1
  mkdir -p "$CACHE" && : >"$CACHE/checked"
  url="https://dl.fedoraproject.org/pub/fedora/linux/releases/$n/Everything/x86_64/os/repodata/repomd.xml"
  h=$(curl -fsSI --proto '=https' --max-time 10 "$url" 2>/dev/null) || return 0   # (not out yet, or offline)
  lm=$(sed -n 's/^[Ll]ast-[Mm]odified: *//p' <<<"$h" | tr -d '\r')
  lm=$(epoch "$lm") && lm=$((lm + 7 * DAY)) || lm=$now   # (the final compose: a week before the day)
  ((lm <= now)) || lm=$now
  printf '%s\n' "$lm" >"$CACHE/release-$n.$$" && mv -f "$CACHE/release-$n.$$" "$CACHE/release-$n"
}

# the state, as KEY<US>VALUE lines (US: the unit separator, \037; a key left empty continues
# the line above), each from records alone. The keys are at most 8 characters and every
# value at most 35: a line of the menu's pane is 44.
gb() { numfmt --to=si --round=nearest "$1" 2>/dev/null | sed 's/\([kKMGTP]\)$/ \1B/'; }   # 641 GB
v_support() {   # how long your release is supported
  local e how
  read -r e how < <(eol_of "$(ver)")
  if ((e < now)); then printf 'ended %s — move on' "$(day "$e")"
  elif [[ $how == about ]]; then printf 'until about %s' "$(date -d "@$e" '+%b %Y')"
  else printf 'until %s · %s' "$(day "$e")" "$(inn "$e")"; fi
}
next_state() {   # → "soon|unknown|settling|ready NEXT RELEASED READY-FROM"
  local n=$(( $(ver) + 1 )) r
  if r=$(out_since "$n"); then
    if ((now < r + WAIT * DAY)); then echo "settling $n $r $(( r + WAIT * DAY ))"
    else echo "ready $n $r $(( r + WAIT * DAY ))"; fi
  else
    r=$(est_release "$n")
    if ((r > now)); then echo "soon $n $r $(( r + WAIT * DAY ))"; else echo "unknown $n $r $(( r + WAIT * DAY ))"; fi
  fi
}
v_next() {
  local st n r from
  read -r st n r from < <(next_state)
  case $st in
    soon)     printf 'Fedora %s · due about %s' "$n" "$(date -d "@$r" '+%b %Y')" ;;
    unknown)  printf 'Fedora %s · may be out by now' "$n" ;;
    settling) printf 'Fedora %s · offered %s' "$n" "$(inn "$from")" ;;
    ready)    printf 'Fedora %s · ready to move to' "$n" ;;
  esac
}
last_done() {   # the last update that reached its end — a run that stopped (a power cut, a
                # failure) is no update: until it ends, the one before stays the last
  local t res
  t=$(read_rec last-update-done) || t=""
  num "$t" && { echo "$t"; return 0; }
  read -r t res < <(last_update) && [[ $res != stopped ]] && { echo "$t"; return 0; }
  return 1
}
last_backup() {   # the epoch of the last backup that ended (1: none yet)
  local t _
  IFS=$'\t' read -r t _ 2>/dev/null <"$BACKUP_REC" && num "$t" && { echo "$t"; return 0; }
  return 1
}
backup_late() {   # the last backup is older than BACKUP_REMIND_DAYS (or there is none); 0 days: never late
  local t
  ((BACKUP_REMIND_DAYS > 0)) || return 1
  t=$(last_backup) || return 0
  ((now - t >= BACKUP_REMIND_DAYS * DAY))
}
due_at() {   # the next update: EVERY days after the last one, or after setup
  local t
  t=$(last_done) || t=$(stat -c %Y "$STATE/phase" 2>/dev/null) || t=$now
  ((t <= now)) || t=$now      # (a record written while the clock ran ahead never puts the season off)
  echo $(( t + EVERY * DAY ))
}
status_kv() {
  local t res from to d e l p f w run new free size n
  busy && printf 'running\037%s\n' 'an update or a repair, now'
  if (($(ver))); then
    printf 'release\037Fedora %s\n' "$(ver)"
    printf 'support\037%s\n' "$(v_support)"
    printf 'next\037%s\n' "$(v_next)"
  else printf 'release\037%s\n' 'unknown: /etc/os-release unreadable'; fi
  # the last move between releases, for the two months after it
  if read -r t from to res < <(read_rec last-upgrade) && num "$t" && ((now - t < 60 * DAY)); then
    case $res in
      failed) printf 'moved\037to Fedora %s failed · %s\n' "$to" "$(day "$t")" ;;
      ok)     printf 'moved\037Fedora %s → %s · %s\n' "$from" "$to" "$(day "$t")" ;;
      *)      printf 'moved\037%s → %s · %s · repair\n' "$from" "$to" "$(day "$t")" ;;
    esac
  fi
  if t=$(last_done); then printf 'updated\037%s · %s\n' "$(day "$t")" "$(ago "$t")"
  else printf 'updated\037none since setup\n'; fi
  if read -r t res < <(last_update); then
    case $res in
      ok)      ;;
      partial) printf '\037some parts left for the next one\n' ;;
      checks)  printf '\037verify found problems: repair\n' ;;
      *)       printf '\037tried %s, stopped: see the log\n' "$(date -d "@$t" '+%-d %b' 2>/dev/null)" ;;
    esac
  fi
  d=$(due_at)
  if ((d <= now)); then printf 'due\037now · every %d days\n' "$EVERY"
  else printf 'due\037%s · %s\n' "$(day "$d")" "$(inn "$d")"; fi
  if l=$(read_rec last-verify); then
    read -r t p f w <<<"$l"
    if num "$t" && num "$f" && ((f == 0)); then
      if num "${w:-}" && ((w)); then printf 'verified\037passed, %s warning%s · %s\n' "$w" "$( ((w == 1)) || echo s)" "$(ago "$t")"
      else printf 'verified\037%s checks passed · %s\n' "$p" "$(ago "$t")"; fi
    elif num "$t" && num "$f"; then printf 'verified\037%s to fix · %s (repair)\n' "$f" "$(ago "$t")"; fi
  else printf 'verified\037not yet\n'; fi
  # the checks after a dnf transaction of yours (the guard's unit, lib/guard.sh): only when
  # one waits or the last left something
  if [[ -e $STATE/after-dnf ]]; then printf 'dnf\037checks after it waiting\n'
  elif read -r t res < <(read_rec last-after-dnf) && num "$t" && [[ $res != ok ]]; then
    printf 'dnf\037%s left something · repair\n' "$(ago "$t")"
  fi
  run=$(uname -r); new=$(rpm -q --last kernel-core 2>/dev/null | head -n1); new=${new%% *}; new=${new#kernel-core-}
  if [[ -n $new && $new != "$run" ]]; then printf 'kernel\037%s · restart for it\n' "${new%.x86_64}"
  else printf 'kernel\037%s\n' "$run"; fi
  # the last backup to another disk (kawa-backup): its day — none yet, or none set up, in red
  if [[ -z $BACKUP_TARGET ]]; then printf 'backup\037not set up (BACKUP_TARGET)\n'
  elif t=$(last_backup); then printf 'backup\037%s · %s\n' "$(day "$t")" "$(ago "$t")"
  else printf 'backup\037none yet · quick settings → backup\n'; fi
  if read -r size free < <(df -B1 --output=size,avail / 2>/dev/null | tail -n1) && num "$free" && num "$size"; then
    if ((free < 20 * 1000 ** 3)); then printf 'disk\037%s free of %s · low\n' "$(gb "$free")" "$(gb "$size")"
    else printf 'disk\037%s free of %s\n' "$(gb "$free")" "$(gb "$size")"; fi
  fi
  # left for you to look at, never changed by itself
  if [[ -s $STATE/unavailable ]]; then
    l=$(tr '\n' ' ' <"$STATE/unavailable"); l=${l% }
    ((${#l} > 34)) && l="${l:0:33}…"             # (with its key's column: 44 at most)
    printf 'retired\037%s\n' "$l"
  fi
  n=$(grep -c . "$STATE/rpmnew" 2>/dev/null) && ((n)) && printf 'compare\037%d config file(s) after the move\n' "$n"
  return 0
}
status() {   # the status as text: the keys in a column of their own, two columns clear of the
  local k v   # longest (verified), as the menu's pane sets them
  status_kv | while IFS=$'\037' read -r k v; do printf '%-10s%s\n' "$k" "$v"; done
  [[ -s $STATE/rpmnew ]] && printf '%-10s%s\n' '' "(the list: $STATE/rpmnew)"
  return 0
}
status_rows() {   # the same as a screen's rows (a terminal on the desktop): two columns in, the
  local k v       # keys muted — under status's heading (job_head), as the menu's pane has them
  if on_console || [[ ! -t 1 ]]; then status | sed 's/^/  /'; return 0; fi
  status_kv | while IFS=$'\037' read -r k v; do printf '  %s%-8s%s  %s\n' "$INK_MUTED" "$k" "$INK_OFF" "$v"; done
  [[ -s $STATE/rpmnew ]] && printf '  %-8s  %s\n' '' "(the list: $STATE/rpmnew)"
  return 0
}

# ── running what changes the system: root, through sudo, from the toolkit ──────────────
need_toolkit() {
  [[ -f $TK/fedokawaii.sh ]] && return 0
  # (an update cut off between the toolkit's two renames: the old copy, whole, goes back)
  if [[ ! -e $TK && -f $TK.old/fedokawaii.sh ]] && root mv -T -- "$TK.old" "$TK"; then
    echo "  the toolkit was put back from $TK.old (an update had been cut off as it replaced it)" >&2; return 0
  fi
  echo "the toolkit is missing: $TK — run setup from your copy of the repository" >&2; return 1
}
root() {   # root CMD… — CMD as root, through sudo; a refusal is said as what it is
  # (asked first, on its own: a wrong password or a user who is no administrator is then
  # told apart from the command's own failure)
  sudo -v || { echo "  this needs root: sudo refused (a wrong password, or not an administrator)" >&2; return 1; }
  sudo "$@"
}
held() {   # a run that takes root's lock (update, upgrade, repair, apply) while one goes on:
  # said at once — no password asked, no wait for the lock
  busy || return 1
  echo "  an update or a repair is running now — wait for it to finish (fedokawaii status)" >&2
}
as_root() {
  need_toolkit || return 1
  case $1 in update|upgrade|repair) ! held || return 1 ;; esac
  root bash "$TK/fedokawaii.sh" "$@"
}

# ── your working copy: where the desktop is changed (handbook, chapter 42) ──────────────────────
COPY=${FEDOKAWAII_COPY:-$HOME/repos/fedokawaii}
need_copy() { [[ -f $COPY/setup.sh && -f $COPY/fedokawaii.sh ]] || { echo "no working copy at $COPY — fedokawaii copy makes one" >&2; return 1; }; }
copy_make() {   # the toolkit, copied once into a folder of yours, as a git repository
  local n
  need_toolkit || return 1
  if [[ -e $COPY ]]; then
    need_copy || { echo "  ($COPY is something else: move it, or set FEDOKAWAII_COPY)" >&2; return 1; }
    n=$(git -C "$COPY" status --porcelain 2>/dev/null | wc -l)
    if ! git -C "$COPY" rev-parse -q --verify HEAD >/dev/null 2>&1; then
      echo "  your working copy: $COPY — nothing committed yet (lazygit there: commit it as it is)"
    elif ((n)); then echo "  your working copy: $COPY — $n file(s) changed since its last commit"
    else echo "  your working copy: $COPY"; fi
    return 0
  fi
  # (git first: a copy without its history would pass for one later, and apply needs it)
  command -v git >/dev/null || { echo "  git is missing — fedokawaii repair puts it back" >&2; return 1; }
  mkdir -p -- "${COPY%/*}" && cp -r -- "$TK" "$COPY" && chmod -R u+w -- "$COPY" || return 1
  git -C "$COPY" init -q -b main || { rm -rf -- "$COPY"; return 1; }
  # the settings as the toolkit has them now: apply measures the copy's against these, so a
  # setting you change later through the menu is never undone by this older copy
  cp -- "$TK/fedokawaii.conf" "$COPY/.git/fedokawaii-conf-base" 2>/dev/null || true
  if [[ -n $(git -C "$COPY" config user.name) && -n $(git -C "$COPY" config user.email) ]]; then
    git -C "$COPY" add -A && git -C "$COPY" commit -q -m "fedokawaii as installed ($(date +%F))"
  else
    echo "  (git does not know your name yet — handbook §41.2: git config --global user.name …;"
    echo "   then commit the copy as it is: lazygit in $COPY)"
  fi
  echo "  your working copy: $COPY — change it there (fedokawaii change), then: fedokawaii apply"
}
# conf_untouched — the copy's fedokawaii.conf is as it was when made or last applied: apply
# then keeps the toolkit's settings (yours, from the menu), so it is no change of the copy's
# (setup.sh's conf_base: the newer of the two records)
conf_untouched() {
  local a=$STATE/conf-from-copy.conf b=$COPY/.git/fedokawaii-conf-base
  [[ -f $b && ! ( -f $a && $a -nt $b ) ]] || b=$a
  [[ -f $b ]] && cmp -s -- "$COPY/fedokawaii.conf" "$b"
}
copy_diff() {   # what apply would change in the toolkit, in a pager
  local out x=()
  need_copy && need_toolkit || return 1
  conf_untouched && x=(--exclude=fedokawaii.conf)
  out=$(diff -ruN --exclude=.git "${x[@]}" --color=always -- "$TK" "$COPY" 2>/dev/null)
  if [[ -z $out ]]; then echo "  the copy and the toolkit are the same — nothing to apply"; return 0; fi
  less -R <<<"$out"
}
# keep FILE… — a config you changed in place, so the desktop keeps it: copied into the
# working copy at the place it came from (configs/home/…, or bin/ for ~/.local/bin). What a
# tool draws (colours, icons, pointers) or a setting fills in is not copied: its source is
# named instead — the change belongs there.
keep_file() {
  local f abs rel src home unkept=0
  need_copy || return 1
  # (your home as the files resolve: it may itself be reached through a link)
  home=$(realpath -e -- "$HOME" 2>/dev/null) || home=$HOME
  for f; do
    unkept=$((unkept + 1))                                 # (until it is kept, or found the same)
    abs=$(realpath -e -- "$f" 2>/dev/null) || { echo "  $f: no such file" >&2; continue; }
    [[ $abs == "$home"/* ]] || { echo "  $f: not in your home" >&2; continue; }
    rel=${abs#"$home"/}
    case $rel in
      .config/fedokawaii/themes/*|.config/gtk-4.0/gtk.css|.local/share/themes/*|.config/nvim/lua/plugins/colorscheme.lua)
        echo "  $f: drawn from the palettes — change tools/build-themes.py in the copy, then run it there (fedokawaii change → colours)" >&2; continue ;;
      .config/fedokawaii/icons.sh|.local/share/fonts/SumiIcons*)
        echo "  $f: drawn from art/icons.txt by tools/build-icons.py (fedokawaii change → icons)" >&2; continue ;;
      .config/fedokawaii/env)
        echo "  $f: written from fedokawaii.conf — change that (fedokawaii settings)" >&2; continue ;;
      .local/bin/*) src=bin/${rel#.local/bin/} ;;
      *) src=configs/home/$rel ;;
    esac
    [[ -f $COPY/$src ]] || { echo "  $f: not one of the toolkit's files — yours already: the theme never replaces it" >&2; continue; }
    # (theme.sh's tokens only: @DEFAULT_AUDIO_SINK@ and the like are wpctl's own names)
    if grep -qE '@(HOME|MONITOR_HZ|WEATHER_CITY|NIGHT_LIGHT|MPV_SCALING|ICON_CHEVRON_RIGHT|UID)@' -- "$COPY/$src"; then
      echo "  $f: filled in from fedokawaii.conf when applied (@HOME@ and the like) — make the same change in $COPY/$src by hand" >&2; continue
    fi
    if cmp -s -- "$abs" "$COPY/$src"; then echo "  $src: already the same in the copy"; unkept=$((unkept - 1)); continue; fi
    cp -- "$abs" "$COPY/$src" && echo "  kept: $src — fedokawaii apply makes it the desktop's" && unkept=$((unkept - 1))
  done
  ((unkept == 0))                                       # (1: something named was not kept — said above)
}
copy_apply() {   # the copy applied: ShellCheck's advice on the scripts you changed, then root's part
  local f sh=()
  need_copy && need_toolkit || return 1
  if command -v shellcheck >/dev/null; then
    # the scripts you changed, and the ones you added (a new folder: every file in it)
    while IFS= read -r f; do
      case $f in
        "Files $TK/"*) f=${f#"Files $TK/"}; f=${f% and "$COPY"/*} ;;   # (a name may hold " and ")
        "Only in $COPY"*) f=${f#"Only in $COPY"}; f=${f#/}; f=${f/: //}; f=${f#/} ;;
        *) continue ;;
      esac
      if [[ -d $COPY/$f ]]; then
        while IFS= read -r -d '' g; do
          g=${g#"$COPY/"}
          if [[ $g == *.sh ]] || head -n1 -- "$COPY/$g" | grep -qE '^#!.*[/ ](ba)?sh( |$)'; then sh+=("$g"); fi
        done < <(find "$COPY/$f" -type f -print0)
        continue
      fi
      [[ -f $COPY/$f ]] || continue
      if [[ $f == *.sh ]] || head -n1 -- "$COPY/$f" | grep -qE '^#!.*[/ ](ba)?sh( |$)'; then sh+=("$f"); fi
    done < <(diff -rq --exclude=.git -- "$TK" "$COPY" 2>/dev/null)
    if ((${#sh[@]})) && ! (cd "$COPY" && shellcheck -x -S warning -- "${sh[@]}"); then
      echo "  ↑ ShellCheck's notes on the scripts you changed (each SC number explained: shellcheck.net/wiki) — apply goes on"
    fi
  fi
  ! held || return 1
  root bash "$COPY/fedokawaii.sh" apply
}

# ── the clone: the toolkit's source, kept in one place, updated from GitHub ─────────────────
# ~/repos/fedokawaii (COPY) is a git clone of the project's repository (ORIGIN, private:
# a GitHub token in secrets.sh, or your SSH key for a git@ address). fedokawaii pull brings
# it up to GitHub's newest, then runs the update from it (the clone becomes the toolkit) and,
# when verify still finds something, repair — one run, root's part through sudo; what it did
# is logged (PULL_LOG, and root's log) and said in a notice. The clone is also the working
# copy every change of yours goes through (fedokawaii change · apply), so it is never removed.
# The token is never in .git/config: git reads it from secrets.sh through a credential helper
# given on the command line (GIT_TERMINAL_PROMPT=0: git itself never asks).
ORIGIN=${FEDOKAWAII_ORIGIN:-https://github.com/MoeDia/fedokawaii.git}
SECRETS=${XDG_CONFIG_HOME:-$HOME/.config}/fedokawaii/secrets.sh
PULL_LOG=${XDG_STATE_HOME:-$HOME/.local/state}/fedokawaii/pull.log
PULL_REC=${XDG_STATE_HOME:-$HOME/.local/state}/fedokawaii/last-pull   # "EPOCH RESULT FROM TO"
secret() {   # secret NAME → its value in secrets.sh — only while the file is yours alone (600)
  [[ -f $SECRETS && -O $SECRETS && $(stat -c %a "$SECRETS") == 600 ]] || return 1
  # shellcheck disable=SC2016  # (expanded by the inner bash, after sourcing the file)
  bash -c '. "$1" >/dev/null 2>&1; printf %s "${!2:-}"' _ "$SECRETS" "$1"
}
secret_set() {   # secret_set NAME VALUE — one line NAME=VALUE in secrets.sh (made, 600), replacing any
  local d=${SECRETS%/*} t
  install -d -m 700 "$d" && { [[ -e $SECRETS ]] || install -m 600 /dev/null "$SECRETS"; } || return 1
  chmod 600 "$SECRETS" || return 1
  t=$(mktemp "$d/.secrets.XXXXXX") || return 1
  { grep -vE "^[[:space:]]*(export[[:space:]]+)?$1=" "$SECRETS"
    printf "%s='%s'\n" "$1" "$2"; } >"$t" && chmod 600 "$t" && mv -f -- "$t" "$SECRETS"
}
fgit() {   # fgit ARG… — git as you, with the token from secrets.sh when there is one
  local tok
  tok=$(secret FEDOKAWAII_GITHUB_TOKEN) || tok=""
  if [[ -n $tok ]]; then
    # shellcheck disable=SC2016  # (the helper's own shell expands it, from its environment)
    FK_TOKEN=$tok GIT_TERMINAL_PROMPT=0 git -c credential.helper= \
      -c 'credential.helper=!f() { [ "$1" = get ] && printf "username=x-access-token\npassword=%s\n" "$FK_TOKEN"; }; f' "$@"
  else GIT_TERMINAL_PROMPT=0 git "$@"; fi
}
reachable() { fgit ls-remote --quiet --exit-code "${1:-$ORIGIN}" HEAD >/dev/null 2>&1; }
token_ask() {   # token_ask [URL] — the repository answers, or (on a terminal) its token asked once
  local tok url=${1:-$ORIGIN}
  reachable "$url" && return 0
  [[ $url == https://* ]] || { echo "  $url does not answer — is your SSH key added to GitHub (ssh -T git@github.com)?" >&2; return 1; }
  [[ -t 0 ]] || { echo "  GitHub refused $url — run fedokawaii pull in a terminal once: it asks for the token" >&2; return 1; }
  echo "  $url is private: a GitHub token reads it (github.com → Settings → Developer settings →"
  echo "  fine-grained token, this repository, Contents: read-only). Kept in ${SECRETS/#$HOME/\~} (600)."
  read -rsp "  token: " tok </dev/tty; echo
  [[ $tok =~ ^[A-Za-z0-9_]{20,255}$ ]] || { echo "  that is no GitHub token — nothing saved" >&2; return 1; }
  secret_set FEDOKAWAII_GITHUB_TOKEN "$tok" || { echo "  could not write ${SECRETS/#$HOME/\~}" >&2; return 1; }
  reachable "$url" && { echo "  saved — GitHub takes it"; return 0; }
  echo "  saved, but GitHub refuses it (no access to this repository, or expired)" >&2; return 1
}
same_as_toolkit() {   # same_as_toolkit DIR — its files are the toolkit's (settings aside)
  [[ -z $(diff -rq --exclude=.git --exclude=fedokawaii.conf -- "$TK" "$1" 2>&1) ]]
}
pack_aside() {   # pack_aside DIR WHY — the whole folder kept, packed, before it is replaced
  local p
  p=${XDG_STATE_HOME:-$HOME/.local/state}/fedokawaii/clone-before-$(date +%Y%m%d-%H%M%S).tar.gz
  mkdir -p "${p%/*}" && tar -czf "$p" -C "${1%/*}" -- "${1##*/}" \
    && echo "  ${1/#$HOME/\~}: $2 — kept, packed, in ${p/#$HOME/\~}"
}
clean_origin() {   # a token written into the clone's address (https://TOKEN@github.com/…): into secrets.sh
  local d=$1 url cred
  url=$(git -C "$d" remote get-url origin 2>/dev/null) || return 0
  [[ $url =~ ^https://([^@/]+)@(.*)$ ]] || return 0
  cred=${BASH_REMATCH[1]}; cred=${cred#*:}
  secret_set FEDOKAWAII_GITHUB_TOKEN "$cred" && git -C "$d" remote set-url origin "https://${BASH_REMATCH[2]}" \
    && echo "  the token in ${d/#$HOME/\~}'s address moved to ${SECRETS/#$HOME/\~}"
}
# has_origin DIR — a git clone that knows its origin: read from its .git/config itself, never by
# asking git (which refuses a folder it does not trust, and would then pass for "no clone")
has_origin() { [[ -f $1/.git/config && ! -L $1/.git ]] && grep -q '^\[remote "origin"\]' "$1/.git/config"; }
# clone_ready — COPY is a clone of ORIGIN with its history: made when missing; one made by
# fedokawaii copy (the toolkit's files, no origin) turned into one — packed first unless its
# files are just the toolkit's and it has no commit of yours
clone_ready() {
  local why=""
  command -v git >/dev/null || { echo "  git is missing — fedokawaii repair puts it back" >&2; return 1; }
  if has_origin "$COPY"; then clean_origin "$COPY"; return 0; fi
  token_ask || return 1
  if [[ ! -e $COPY ]]; then
    mkdir -p -- "${COPY%/*}" && fgit clone --quiet "$ORIGIN" "$COPY" || { echo "  could not clone $ORIGIN" >&2; return 1; }
    echo "  cloned: ${COPY/#$HOME/\~} — fedokawaii pull keeps it current"; return 0
  fi
  need_copy || { echo "  ($COPY is something else: move it, or set FEDOKAWAII_COPY)" >&2; return 1; }
  if git -C "$COPY" rev-parse -q --verify HEAD >/dev/null 2>&1; then why="commits of yours, no GitHub"
  elif ! same_as_toolkit "$COPY"; then why="files changed, never committed"; fi
  if [[ -n $why ]]; then pack_aside "$COPY" "$why" || return 1; fi
  git -C "$COPY" init -q 2>/dev/null; git -C "$COPY" remote remove origin 2>/dev/null
  git -C "$COPY" remote add origin "$ORIGIN" && fgit -C "$COPY" fetch --quiet origin \
    && git -C "$COPY" checkout -q -f -B main --track origin/main && git -C "$COPY" clean -q -fd \
    || { echo "  could not turn ${COPY/#$HOME/\~} into a clone of $ORIGIN" >&2; return 1; }
  rm -f -- "$COPY/.git/fedokawaii-conf-base"
  echo "  ${COPY/#$HOME/\~} is now a clone of GitHub's repository"
}
# adopt DIR — setup's, update's or repair's last step (as you): the clone they were run from
# becomes ~/repos/fedokawaii, unless that is a clone already (0: moved; 1: left to setup)
adopt() {
  local d=$1
  [[ $d != "$COPY" ]] && has_origin "$d" || return 1
  has_origin "$COPY" && return 1
  if [[ -e $COPY ]]; then
    need_copy || return 1
    if git -C "$COPY" rev-parse -q --verify HEAD >/dev/null 2>&1 || ! same_as_toolkit "$COPY"; then
      pack_aside "$COPY" "your old working copy" || return 1
    fi
    rm -rf --one-file-system -- "$COPY" || return 1
  fi
  mkdir -p -- "${COPY%/*}" && mv -T -- "$d" "$COPY" || return 1
  echo "  ${d/#$HOME/\~} moved to ${COPY/#$HOME/\~}: the one clone — fedokawaii pull (Super+U → update fedokawaii) updates it from GitHub"
  clean_origin "$COPY"
  [[ -t 0 ]] && { token_ask "$(git -C "$COPY" remote get-url origin)" || true; }
  return 0
}
pull() {   # git pull, then the update from the clone, repair if verify still finds something
  local from to rc=0 res=ok f
  need_toolkit && ! held || return 1
  mkdir -p -- "${PULL_LOG%/*}"
  {
    printf '── fedokawaii pull · %s\n' "$(date '+%F %T')"
    clone_ready || exit 1
    [[ -z $(git -C "$COPY" status --porcelain --untracked-files=no 2>/dev/null | grep -v ' fedokawaii.conf$') ]] \
      || echo "  (your changes in the clone are kept: GitHub's are added beside them)"
    from=$(git -C "$COPY" rev-parse --short HEAD)
    token_ask "$(git -C "$COPY" remote get-url origin)" || exit 1
    fgit -C "$COPY" fetch --quiet origin || { echo "  GitHub does not answer — is the network up?" >&2; exit 1; }
    git -C "$COPY" merge --ff-only --quiet '@{u}' || { echo "  your commits and GitHub's went apart — lazygit in ${COPY/#$HOME/\~} (rebase), then pull again" >&2; exit 1; }
    to=$(git -C "$COPY" rev-parse --short HEAD)
    if [[ $from == "$to" ]]; then echo "  the clone is GitHub's newest already ($to)"
    else echo "  $from → $to:"; git -C "$COPY" log --format='    %h %s' "$from..$to" | head -n 30; fi
    root bash "$COPY/fedokawaii.sh" update || rc=$?
    read -r _ _ f _ < <(read_rec last-verify)
    if ((rc == 1)) || { num "${f:-}" && ((f > 0)); }; then
      echo; echo "  the update left something to fix — repair follows"
      rc=0; root bash "$TK/fedokawaii.sh" repair || rc=$?
    fi
    exit "$rc"
  } 2>&1 | tee "$PULL_LOG"
  rc=${PIPESTATUS[0]}
  case $rc in 0) res=ok ;; 3) res=checks ;; *) res=failed ;; esac
  printf '%s %s %s\n' "$(date +%s)" "$res" "$(git -C "$COPY" rev-parse --short HEAD 2>/dev/null)" >"$PULL_REC"
  f=normal; ((rc == 0)) || f=critical
  notify-send -a desktop -u "$f" -- "${ICON_TORII:-·}  fedokawaii pull" \
    "$(case $res in ok) echo "up to date with GitHub — every check passed" ;; checks) echo "updated; something still needs you — fedokawaii verify" ;;
       *) echo "stopped — the log: ${PULL_LOG/#$HOME/\~}" ;; esac)" 2>/dev/null || true
  return "$rc"
}

told_move() {   # the outcome of a move to a new Fedora, told once (at the first login after it)
  local t from to res told
  read -r t from to res < <(read_rec last-upgrade) || return 0
  num "$t" || return 0
  ((now - t < 60 * DAY)) || return 0               # (a lost cache never re-tells an old move)
  told=$(cat "$CACHE/move-told" 2>/dev/null)
  [[ $told == "$t" ]] && return 0
  case $res in
    failed) notify-send -a desktop -u critical -- "${ICON_RESTART:-·}  upkeep" "the move to Fedora $to did not complete — Fedora $from is as it was (what happened: sudo dnf system-upgrade log)" ;;
    ok)     notify-send -a desktop -- "${ICON_RESTART:-·}  upkeep" "Fedora $to is in place — the move finished" ;;
    *)      notify-send -a desktop -- "${ICON_RESTART:-·}  upkeep" "Fedora $to is in place — some parts need a look: Super+U → status" ;;
  esac 2>/dev/null && { mkdir -p "$CACHE"; printf '%s\n' "$t" >"$CACHE/move-told"; }
  return 0
}
remind() {   # remind [check] — once a day at most: an update due, a release ready or ending
  local d st n r from e how msg="" seen
  # (one look at a time: the session's timer and the look at login may meet — one notice)
  if [[ ${1:-} != check ]] && mkdir -p "$CACHE" 2>/dev/null && exec 7>>"$CACHE/remind.lock"; then
    flock -n 7 || return 0
  fi
  [[ ${1:-} == check ]] || told_move
  [[ $REMIND == yes || ${1:-} == check ]] || return 0
  seen=$(cat "$NOTICE" 2>/dev/null)
  if [[ ${1:-} == check || $seen != "$(date +%F)" ]]; then   # (the backup's reminder below keeps its own day)
    d=$(due_at); read -r st n r from < <(next_state); read -r e how < <(eol_of "$(ver)")
    if [[ $how == exact ]] && ((e < now + 30 * DAY)); then msg="Fedora $(ver)'s support ends $(day "$e") — move to Fedora $n (Super+U)"
    elif [[ $st == ready ]]; then msg="Fedora $n has settled — the move to it is ready (Super+U)"
    elif ((d <= now)); then msg="the update season is here: $(( (now - d) / DAY + EVERY )) days since the last update (Super+U)"
    fi
    if [[ -n $msg ]]; then
      if [[ ${1:-} == check ]]; then echo "$msg"
      elif notify-send -a desktop -- "${ICON_DOWNLOAD:-·}  upkeep" "$msg" 2>/dev/null; then mkdir -p "$CACHE"; date +%F >"$NOTICE"; fi
    elif [[ ${1:-} == check ]]; then echo "nothing due — the next update $(inn "$d") ($(day "$d"))"; fi
  fi
  remind_backup "${1:-}"
  return 0
}
remind_backup() {   # remind_backup [check] — a notice of its own, once a day: no backup for BACKUP_REMIND_DAYS days
  local t msg
  [[ -n $BACKUP_TARGET ]] && backup_late || return 0
  [[ $1 == check || $(cat "$BACKUP_TOLD" 2>/dev/null) != "$(date +%F)" ]] || return 0
  if t=$(last_backup); then msg="the last backup was $(ago "$t") — plug in $BACKUP_TARGET, then quick settings → backup"
  else msg="no backup yet — plug in $BACKUP_TARGET, then quick settings → backup"; fi
  if [[ $1 == check ]]; then echo "$msg"
  elif notify-send -a backup -- "${ICON_ARCHIVE:-·}  backup" "$msg" 2>/dev/null; then mkdir -p "$CACHE"; date +%F >"$BACKUP_TOLD"; fi
  return 0
}

# ── the menu ────────────────────────────────────────────────────────────────────────────
# a text console: no icon font, maybe no · — … either. The kernel's (TERM=linux), or Fedora
# 45's kmscon, which marks the terminals it draws (TERM=kmscon, TERM_SESSION_TYPE=kms or fb)
on_console() {
  [[ ${TERM:-} == linux || ${TERM:-} == kmscon* || ${TERM_SESSION_TYPE:-} == kms || ${TERM_SESSION_TYPE:-} == fb ]]
}
if ! on_console && [[ -r $HOME/.config/fedokawaii/icons.sh ]]; then
  # shellcheck source=/dev/null
  . "$HOME/.config/fedokawaii/icons.sh"
fi
# the letters the desktop's font draws two columns wide where a terminal gives them one
# (— … → and the like: FUSION_WIDE): in the pane each is given the space after it as well,
# so it never runs into the next word
if ! on_console && [[ -r $HOME/.config/fedokawaii/width.sh ]]; then
  # shellcheck source=/dev/null
  . "$HOME/.config/fedokawaii/width.sh"
fi
# the text screens' grammar (docs/design-system.md §7): headings, rows, footers and their inks
if ! on_console && [[ -r $HOME/.config/fedokawaii/screen.sh ]]; then
  # shellcheck source=/dev/null
  . "$HOME/.config/fedokawaii/screen.sh"
fi
# every entry: ACTION<TAB>ICON<TAB>NAME<TAB>VALUE (the value at the right, muted — or in the
# kanji's vermilion when it needs you: due, ready, to fix, no backup), in three parts — the
# system's upkeep, the desktop, help — each under a heading of its own: -<TAB>KANJI<TAB>NAME
# (守 keep, 卓 the desk, 案 the guide), which the cursor never stops on
rows() {
  local d st n r from l t p f w R=${INK_KANJI:-} O=${INK_OFF:-} upd up ver_ snap bk nxt
  d=$(due_at); read -r st n r from < <(next_state)
  if ((d <= now)); then upd="${R}due$O"; else upd=$(inn "$d"); fi
  case $st in
    ready)    up="${R}ready$O" ;;
    settling) up=$(inn "$from") ;;
    soon)     up=$(date -d "@$r" '+%b %Y') ;;
    *)        up=check ;;
  esac
  ver_=""
  if l=$(read_rec last-verify); then
    read -r t p f w <<<"$l"
    if num "$f" && ((f == 0)); then ver_=passed; elif num "$f"; then ver_="$R$f to fix$O"; fi
  fi
  snap=$(read_rec snapshots) && num "$snap" || snap=""
  # the backup: its age, in vermilion once the reminder's days have passed (none set up too)
  if [[ -z $BACKUP_TARGET ]]; then bk="${R}none$O"
  elif t=$(last_backup); then bk=$(ago "$t"); backup_late && bk="$R$(ago "$t")$O"
  else bk="${R}never$O"; fi
  busy && upd="${R}running$O"
  # (fedokawaii itself: when the clone was last pulled from GitHub)
  local pl="" pt pr
  if read -r pt pr _ 2>/dev/null <"$PULL_REC" && num "$pt"; then pl=$(ago "$pt"); [[ $pr == ok ]] || pl="$R$pl$O"; fi
  # (a release that cannot be read is not guessed at: no Fedora 0, no move to Fedora 1)
  if (($(ver))); then nxt="upgrade to Fedora $n"; else nxt="upgrade to the next Fedora"; fi
  # (change and keybindings open screens of their own: only on the desktop, not on a text console)
  local desk=(); [[ -n ${WAYLAND_DISPLAY:-} ]] && desk=(1)
  printf '%s\t%s\t%s\t%s\n' \
    -         守                        upkeep                ""  \
    status    "${ICON_CPU:-·}"          status                ""  \
    update    "${ICON_DOWNLOAD:-·}"     update                "$upd" \
    pull      "${ICON_CLOUD:-·}"        "update fedokawaii"   "$pl" \
    upgrade   "${ICON_RESTART:-·}"      "$nxt"                "$up" \
    verify    "${ICON_CHECK:-·}"        verify                "$ver_" \
    repair    "${ICON_SLIDERS:-·}"      repair                "" \
    drift     "${ICON_BRANCH:-·}"       drift                 "" \
    snapshots "${ICON_HOURGLASS:-·}"    snapshots             "$snap" \
    backup    "${ICON_ARCHIVE:-·}"      backup                "$bk" \
    -         卓                        desktop               ""  \
    ${desk:+change    "${ICON_CODE:-·}" "change the desktop"  ""} \
    theme     "${ICON_THEME:-·}"        "theme, applied again" "" \
    settings  "${ICON_FILE:-·}"         settings              "" \
    remind    "${ICON_BELL:-·}"         reminders             "$([[ $REMIND == yes ]] && echo "every $EVERY days" || echo off)" \
    -         案                        help                  ""  \
    ${desk:+keys      "${ICON_KEYBOARD:-·}" keybindings       ""} \
    guide     "${ICON_BOOK:-·}"         learn                 "" \
    log       "${ICON_NOTE:-·}"         log                   ""
}
# the part each entry is in: its kanji heads the pane beside the list
part_of() {
  case $1 in
    status|update|pull|upgrade|verify|repair|drift|snapshots|backup) echo 守 ;;
    change|theme|settings|remind) echo 卓 ;;
    *) echo 案 ;;
  esac
}
# The list and the pane, in a window W columns wide inside fzf's margins (FZF_COLUMNS, which
# fzf tells every command it runs): the pane takes PANE columns at the right, the list the
# rest — its text two columns less (the cursor's fill reaches one column past the text each
# side), 46 in the 100-column window: room to spare beside the widest entry with its value
# ("upgrade to Fedora 45  in 40 days"). Each row is screen.sh's: two spaces, the glyph, two
# spaces, the name, the value right-aligned at the list's last column; each heading its
# kanji, its name and the stitch to that column. The menu asks for its rows again once fzf
# is up and whenever the window changes size, so the column is right however late the
# window gets its final size.
PANE=50
fit_rows() {
  local W=38 a g l m c=${FZF_COLUMNS:-}
  # (fzf's width; before fzf has drawn it says 0, so then the terminal's, less the margins)
  num "$c" && ((c > 0)) || { c=$(stty size </dev/tty 2>/dev/null) && c=$((${c#* } - 2)); } 2>/dev/null
  num "$c" && ((c > PANE + 40)) && W=$((c - PANE - 2))
  while IFS=$'\t' read -r a g l m; do
    if [[ $a == - ]]; then printf -- '-\t%s\t\n' "$(screen_heading "$g" "$l" "$W")"
    else printf '%s\t%s\t%s\n' "$a" "$(screen_row "$g" "$l" "$m" "$W")" "$l"; fi
  done < <(rows)
}
# fzf's items: ACTION<TAB>ROW<TAB>NAME, each ended by a NUL, a heading after the first with an
# empty line above it (an item of two lines: the gap between the parts is the heading's own)
fit_items() {
  local a l m n=0
  while IFS=$'\t' read -r a l m; do
    if [[ $a == - ]] && ((n++)); then printf -- '-\t\n%s\t\0' "$l"; else printf '%s\t%s\t%s\0' "$a" "$l" "$m"; fi
  done < <(fit_rows)
}

# the right pane, a part of its own: the entry's heading (its part's kanji, its name, the
# stitch — level with the list's first heading), how things stand for it (its lines of the
# status: the key muted, a column clear of the longest) and what it does — at most 45
# characters a line, two columns in from the heading (as rows are), and 15 lines: nothing ever wraps or scrolls away
explain() {
  local a=$1 O=$INK_OFF G=$INK_MUTED kv pw=${FZF_PREVIEW_COLUMNS:-$PANE}
  # (a heading, nothing or something unknown: nothing to explain)
  [[ $a == @(status|update|pull|upgrade|verify|repair|snapshots|backup|theme|drift|change|settings|remind|log|keys|guide) ]] || return 0
  printf '  %s\n' "$(screen_heading "$(part_of "$a")" "${2:-$a}" $((pw - 3)))"
  # (the whole status only for the entries that show more than whether a run is going on:
  # the pane follows the cursor, so the others stay instant)
  case $a in
    status|update|upgrade|verify|repair|remind) kv=$(status_kv) ;;
    *) kv=$(busy && printf 'running\037%s\n' 'an update or a repair, now') ;;
  esac
  pick() {   # pick 'KEY|KEY…' → those lines of the status (with their continuations), less what
    local k v on=0 any=0   # the list beside it says already (next: the upgrade's row; due's "in N days": update's)
    while IFS=$'\037' read -r k v; do
      if [[ -n $k ]]; then if [[ "|$1|" == *"|$k|"* ]]; then on=1; else on=0; fi; fi
      [[ $k == due ]] && v=${v% · in *}
      ((on)) && { printf '    %s%-8s%s  %s\n' "$G" "$k" "$O" "$v"; any=1; }
    done <<<"$kv"
    ((any)) && printf '\n'
    return 0
  }
  say() {   # (two columns in from the heading, as rows are)
    local l t i c LC_ALL=C.UTF-8
    for l; do
      if [[ -n ${FUSION_WIDE:-} ]]; then
        t=""; for ((i = 0; i < ${#l}; i++)); do
          c=${l:i:1}; t+=$c
          # shellcheck disable=SC2053  # (FUSION_WIDE is a pattern)
          [[ $c == $FUSION_WIDE && ${l:i+1:1} == " " ]] && t+=" "
        done; l=$t
      fi
      printf '    %s\n' "$l"
    done
  }
  case $a in
    status)    pick 'running|release|support|moved|updated|due|verified|dnf|backup|kernel|disk|retired|compare' ;;
    update)    pick 'running|updated|due'
               say "everything in one go: a snapshot first," \
                   "then Fedora's packages, the desktop's own" \
                   "tools at their pinned versions, torrra," \
                   "Prowlarr's image and neovim's plugins (your" \
                   "versions kept), and the checks. a part that" \
                   "fails is reported; the rest goes on. once a" \
                   "season is enough: nothing updates by itself." ;;
    pull)      pick 'running'
               say "fedokawaii itself, from GitHub: your clone" \
                   "(~/repos/fedokawaii) brought to the newest," \
                   "then the update runs from it, and repair if" \
                   "anything is left. your changes in the clone" \
                   "are kept. the first time it asks for the" \
                   "repository's token (kept in secrets.sh)." ;;
    upgrade)   pick 'running|release|support|moved'
               say "a new Fedora comes every six months, each" \
                   "supported for about thirteen. the move is" \
                   "offered once it has settled ($WAIT days) and" \
                   "its extra repositories and libraries are" \
                   "ready. it takes a snapshot, downloads" \
                   "everything and restarts to install it —" \
                   "20 to 40 minutes — and the desktop comes" \
                   "back as it was." ;;
    verify)    pick 'running|verified'
               say "every package, service, file and setting" \
                   "checked against the toolkit. changes" \
                   "nothing." ;;
    repair)    pick 'running|verified'
               say "verify, then put right what it found —" \
                   "missing packages and drivers, anything" \
                   "doubled or fighting, services, the login," \
                   "dwl, the session, the desktop's tools," \
                   "the configs — and verify again. your" \
                   "own files are never touched. offline, it" \
                   "does what needs no network." ;;
    snapshots) pick 'running'
               say "the system as it was before each change: a" \
                   "pair around every dnf run, one before each" \
                   "update, repair and move, hourly ones for a" \
                   "while, and setup's baseline. the newest ten" \
                   "\"before\" ones are in the boot menu too." \
                   "enter: the list — and one restored, from" \
                   "the next start, if you say so (§37.5)." ;;
    backup)    pick 'running|backup'
               say "your home — minus ~/Downloads, caches and" \
                   "what can be downloaded again — to the" \
                   "drive named in BACKUP_TARGET, with restic." \
                   "plug it in first. the first backup copies" \
                   "everything; the next ones only what" \
                   "changed. snapshots live on this disk; this" \
                   "survives it. a file back: handbook §37.6." ;;
    theme)     pick 'running'
               # shellcheck disable=SC2088  # (a path to read, not to expand)
               say "every config the toolkit manages, back as" \
                   "it has it; yours are kept first, in" \
                   "~/.local/state/fedokawaii/backup." ;;
    drift)     pick 'running'
               say "the configs that differ from the toolkit's." \
                   "changes nothing." ;;
    settings)  pick 'running'
               say "fedokawaii.conf — keyboard layouts, refresh" \
                   "rate, city, time zone, SSH… — a copy, in" \
                   "neovim. when you close it, every value is" \
                   "checked; only a valid file is saved (as" \
                   "root). the next update applies it; the" \
                   "backup's two settings count at once." ;;
    change)    pick 'running'
               say "the menu of the desktop's own parts — keys," \
                   "bar, colours, terminal, shell, launcher…" \
                   "— each opened in your working copy, then" \
                   "applied if you say so (chapter 42). also" \
                   "super+shift+u. this window closes for it." ;;
    keys)      pick 'running'
               say "every keybinding, grouped, to read or to" \
                   "search: type a word to keep only its lines." \
                   "also super+/. this window closes for it." ;;
    remind)    pick 'running|due'
               say "a notice when the update season comes round," \
                   "when a new Fedora has settled, and a month" \
                   "before yours ends — read from what is known," \
                   "never from the network." \
                   "" \
                   "enter: every 60 · 90 · 120 days · off." ;;
    log)       pick 'running'
               say "the last run's log, at its end (root's: you" \
                   "are asked for your password)." ;;
    guide)     pick 'running'
               say "the learning guide, in zathura: every" \
                   "key and program, then Python and Rust" \
                   "from zero to AI. (The full handbook:" \
                   "docs/ on GitHub.)" ;;
  esac
}

edit_settings() {   # a copy edited, checked by the toolkit, and only then made the settings
  local t rc ed=() a
  need_toolkit || return 1
  # the editor as you named it, options and all (VISUAL="code --wait")
  read -ra ed <<<"${VISUAL:-${EDITOR:-nvim}}"
  command -v "${ed[0]:-}" >/dev/null || { echo "  no editor: ${ed[0]:-(none)} — set VISUAL (or EDITOR) to one" >&2; return 1; }
  t=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/fedokawaii.conf.XXXXXX") || return 1
  cp -- "$TK/fedokawaii.conf" "$t"
  while :; do
    "${ed[@]}" "$t"
    if cmp -s -- "$t" "$TK/fedokawaii.conf"; then echo "  unchanged"; rc=0; break; fi
    root bash "$TK/fedokawaii.sh" conf "$t"; rc=$?
    ((rc == 0)) && break
    # (a slip need not cost the rest of the edit: it is still there, to put right)
    printf '\n  edit it again? y/n '; read -rsn1 a </dev/tty || a=n; echo
    [[ $a == [yY] ]] || { echo "  not saved — fedokawaii.conf is as it was"; break; }
  done
  rm -f -- "$t"
  return "$rc"
}
BACK="goes back to the menu"   # (a job's own window: "closes this window")
pause() {   # pause RC [ACTION] — the outcome as a row (its glyph: done, or needs you), then the
  # key back to the menu as a footer, a blank line between them
  local g=${ICON_CHECK:-·} t=finished K=${INK_MUTED:-} N=${INK_KANJI:-} O=${INK_OFF:-}
  if (($1 == 0)); then :
  elif [[ ${2:-} == @(verify|drift|repair|apply) && $1 == 3 ]] \
       || [[ ${2:-} == drift && $1 == 4 ]]; then   # (3: it ran; things remain · drift 4: in sync but a part)
    g=$N${ICON_BELL:-!}$O t="done · some things still need you: the lines above"
  elif [[ ${2:-} == backup && $1 == 4 ]]; then     # (4: nothing to back up to, or none picked)
    g=${ICON_BOX_OFF:-·} t="nothing done"
  else g=$N${ICON_CROSS:-x}$O t="it ended with an error ($1): the lines above say why"; fi
  [[ $g == "$N"* ]] || g=$K$g$O
  printf '\n  %s  %s\n\n  %sany key %s%s ' "$g" "$t" "$K" "$BACK" "$O"
  read -rsn1 _ </dev/tty || true
}
# job_head ACTION — a job's own heading at the top of its window (its part's kanji, its name),
# a blank line under it; none on a text console
job_head() {
  local w n=$1
  on_console && return 0
  w=$(screen_width) || return 0
  case $1 in remind) n=reminders ;; guide) n=learn ;; keys) n=keybindings ;; esac
  printf '\n  %s\n\n' "$(screen_heading "$(part_of "$1")" "$n" "$w")"
}
# the entries that run a job — dnf, a backup, an edit, or root's password asked: in Super+U's
# popup they are handed to a window of their own (hand), which a click elsewhere, another
# window or Super+U again never closes
JOBS='update|pull|upgrade|verify|repair|theme|drift|snapshots|backup|settings|log'
hand() {   # hand ACTION — the job in a dialog window, on its own: the popup closes behind it
  setsid -f "$0" --job "$1" >/dev/null 2>&1 </dev/null
}
job_window() {   # job_window ACTION — the dialog (one at a time), or a notice of why there is none
  local rc
  kawa-term --float --once system-job --dialog "system · $1" 100x27 -- "$0" --job-run "$1"; rc=$?
  case $rc in
    0) ;;
    3) notify-send -a desktop -- "${ICON_TORII:-·}  upkeep" "a job of the system menu is running in its window — it stays open until it ends" ;;
    1) notify-send -a desktop -u critical -- "${ICON_TORII:-·}  upkeep" "the terminal server is not running — fedokawaii repair puts it back" ;;
    *) notify-send -a desktop -u critical -- "${ICON_TORII:-·}  upkeep" "the job's window could not open (kawa-term --float: $rc) — fedokawaii repair puts it back" ;;
  esac
  return "$rc"
}
log_view() {   # root's log at its end — less as you: a pager run as root would give a root shell (!)
  # (the password asked first, alone: it never fights less for the keys)
  root true || return 1
  root cat -- /var/log/fedokawaii.log | less +G
}
run() {   # run ACTION — in the menu's window: the work, its outcome, a key back to the menu
  local a=$1 rc=0
  # (Super+U's popup: a job goes to a window of its own, and the menu ends — dwl would close
  # the popup, and the job with it, at a click outside it)
  if [[ ${FEDOKAWAII_POPUP:-} == yes && $a == @($JOBS) ]]; then hand "$a"; exit 0; fi
  printf '\e[H\e[2J\e[3J'                       # (the screen cleared: no ncurses needed)
  [[ $a == @($JOBS|status) ]] && job_head "$a"
  case $a in
    status)    status_rows; rc=0 ;;
    update)    as_root update; rc=$? ;;
    pull)      pull; rc=$? ;;
    upgrade)   as_root upgrade; rc=$? ;;
    verify)    as_root verify; rc=$? ;;
    repair)    as_root repair; rc=$? ;;
    snapshots) snapshots; rc=$? ;;
    backup)    backup_now; rc=$? ;;
    theme)     as_root theme; rc=$? ;;
    drift)     as_root drift; rc=$? ;;
    settings)  edit_settings; rc=$? ;;
    remind)    case $REMIND:$EVERY in yes:60) EVERY=90 ;; yes:90) EVERY=120 ;; yes:120) REMIND=no ;; *) REMIND=yes EVERY=60 ;; esac
               save_conf; return 0 ;;
    log)       log_view; return 0 ;;   # (as `fedokawaii log`)
    change)    setsid -f kawa-config >/dev/null 2>&1 </dev/null; return 0 ;;   # (its own menu, by the bar)
    keys)      setsid -f kawa-help >/dev/null 2>&1 </dev/null; return 0 ;;     # (the sheet, by the bar)
    guide)     guide && return 0; rc=1 ;;   # (a handbook that cannot open says why, and waits)
    *)         return 0 ;;
  esac
  pause "$rc" "$a"
}

backup_now() {   # kawa-backup, as you (the backup is yours, never root's)
  command -v kawa-backup >/dev/null || { echo "  kawa-backup is missing — fedokawaii repair puts it back" >&2; return 1; }
  # (what it says is wrong comes in by the two columns every line of this window keeps;
  # restic's progress, on the terminal itself, is left as it draws it)
  { kawa-backup 2>&1 1>&3 3>&- | sed -u 's/^/  /' >&2; return "${PIPESTATUS[0]}"; } 3>&1
}
freesync() {   # FreeSync as the card has it this moment (kawa-display --vrr: DRM's vrr_capable
  # and VRR_ENABLED, not dwl's word), the setting beside it, and where the monitor shows it
  local s l name cap now say
  s=$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/fedokawaii/vrr" 2>/dev/null)
  case $s in always) say="always on" ;; off) say="off" ;; *) say="in games (on while a window is full screen)" ;; esac
  l=$(kawa-display --vrr) || { echo "FreeSync: the graphics card could not be asked (the line above says why)"; return 1; }
  while IFS=$'\t' read -r name cap now; do
    if [[ $cap != yes ]]; then
      echo "FreeSync: $name — the screen does not offer it: switch it on in the monitor's own menu (an LG UltraGear: the joystick → Game Adjust → Adaptive-Sync, or FreeSync, On — Extended for the widest range), or use a cable and port that carry it"
    elif [[ $now == on ]]; then
      echo "FreeSync: $name — ON now: the refresh follows the frames · setting: $say"
    else
      echo "FreeSync: $name — offered, off this moment · setting: $say"
    fi
  done <<<"$l"
  echo "(the card's own state, this moment. In a game, full screen: Super+X — quick settings' 滑 tile reads \"games · on\" — and a monitor whose menu shows the refresh rate shows the game's frame rate there, not 144: FreeSync at work)"
  grep -q $'\tyes\t' <<<"$l" || [[ $s == off ]]
}
snapshots() {   # the snapshots of / — read from the disk by kawa-snap, as root, so the list is
  # there in a snapshot started from the boot menu too — then one restored, if you say so
  local fs l n ty d de b v w=0 nums=() ans c
  command -v snapper >/dev/null || { echo "  snapper is not installed — fedokawaii repair puts it back" >&2; return 1; }
  fs=$(findmnt -no FSTYPE / 2>/dev/null)
  [[ $fs == btrfs ]] || { echo "  no snapshots here: / is ${fs:-of an unknown kind}, and snapshots need Btrfs" >&2; return 1; }
  l=$(root kawa-snap list) || return 1
  [[ -n $l ]] || { echo "  no snapshots yet"; return 0; }
  declare -F screen_row >/dev/null && w=$(screen_width 2>/dev/null) || w=0
  # fit TEXT N — TEXT in N letters at most, cut at a word's end (never mid-word, never an "…")
  fit() {
    local t=$1
    ((${#t} <= $2)) && { printf '%s' "$t"; return; }
    t=${t:0:$2+1}; [[ $t == *' '* ]] && t=${t% *}
    printf '%s' "${t:0:$2}"
  }
  while IFS=$'\t' read -r n ty d de b; do
    [[ $ty == post ]] && continue                       # (a dnf pair is its pre: "before" it)
    v=$(date -d "$d UTC" '+%-d %b %H:%M' 2>/dev/null) || v=$d
    [[ $b == booted ]] && v="running now · $v"
    if ((w)); then screen_row "${ICON_HOURGLASS:-·}" "$(printf '%-4s %s' "$n" "$(fit "$de" $((w - 5 - 5 - ${#v} - 2)))")" "$v" "$w"
    else printf '  %-4s  %-46s  %s\n' "$n" "$(fit "$de" 46)" "$v"; fi
    nums+=("$n")
  done <<<"$l"
  printf '\n  restore one — the whole system as it was then, from the next start (your\n'
  printf '  home stays as it is; the system now is kept, "old" brings it back):\n'
  printf '  (or at power-on: hold Shift (Esc/F8) for the boot menu → snapshots)\n'
  printf '  its number, or enter for none: '
  read -r ans </dev/tty 2>/dev/null || ans=""
  [[ -n $ans ]] || return 0
  grep -qxF -- "$ans" < <(printf '%s\n' "${nums[@]}") || { echo "  no snapshot $ans in the list — nothing changed" >&2; return 1; }
  printf '  type yes to restore %s (or at power-on: hold Shift (Esc/F8) for the boot menu → snapshots): ' "$ans"
  read -r c </dev/tty 2>/dev/null || c=""
  [[ $c == yes ]] || { echo "  nothing changed"; return 0; }
  root kawa-snap restore "$ans" || return 1
  printf '  restart now? y/n '
  read -rsn1 c </dev/tty 2>/dev/null || c=n; echo
  [[ $c == [yY] ]] && systemctl reboot
  return 0
}
guide() {   # the learning guide: the PDF in zathura on the desktop; on a text console, its text
  # (the full handbook, docs/Fedokawaii-Guide.pdf, is the repository's reference: never opened here)
  local pdf=$TK/docs/Fedokawaii-Learn.pdf md=$TK/docs/fedokawaii-learn.md
  if [[ -z ${WAYLAND_DISPLAY:-} && -r $md ]]; then less -- "$md"; return 0; fi
  [[ -r $pdf ]] || { echo "  the learning guide is missing: $pdf — fedokawaii repair puts it back" >&2; return 1; }
  command -v zathura >/dev/null || { echo "  zathura is not installed (fedokawaii repair puts it back) — the learning guide: $pdf" >&2; return 1; }
  setsid -f zathura "$pdf" >/dev/null 2>&1 </dev/null
}

menu_fzf() {   # → fzf's exit status (2: it could not run — the plain menu takes over)
  local self pop=""
  self=$(printf '%q' "$0")
  # (in Super+U's popup a job, too, ends the menu: it is handed to a window of its own)
  [[ ${FEDOKAWAII_POPUP:-} == yes ]] && pop="|$JOBS"
  export FZF_DEFAULT_OPTS_FILE=$HOME/.config/fedokawaii/fzf.opts; unset FZF_DEFAULT_OPTS
  [[ -r $FZF_DEFAULT_OPTS_FILE ]] || unset FZF_DEFAULT_OPTS_FILE
  ( release_check >/dev/null 2>&1 & )               # (for the next look: the menu never waits on it)
  # Three parts, each under its heading, and the pane beside them: a part of its own, headed
  # by the entry under the cursor. Sixteen entries need no search: no input line — the first
  # heading stands a row under the window's top, level with the pane's. The headings stay in
  # the list but never match the fixed query (fzf's raw mode shows them in place, in their
  # own inks): up and down step from entry to entry, and the cursor starts on the first entry
  # and comes back to one after every reload. (change and keybindings open screens of their
  # own: this one closes for them)
  fit_items | fzf --read0 --ansi --no-sort --no-input --raw --query='!守 !卓 !案' --gutter-raw=' ' \
    --height=100% --delimiter=$'\t' --with-nth=2 --color=nomatch:-1:regular --tiebreak=index \
    --preview="$self --explain {1} {3}" --preview-window="right,$PANE,border-none,noinfo,nowrap" \
    --footer=$'\n'"$(screen_footer 'enter run' 'esc close')" \
    --bind="start:reload-sync($self --items)" --bind="resize:reload-sync($self --items)" \
    --bind="result:transform:[[ \$FZF_RAW == 0 ]] && echo down-match" \
    --bind="down:down-match,up:up-match,j:down-match,k:up-match,q:abort" \
    --bind="enter:transform:case {1} in -) ;; change|keys${pop}) echo 'become($self --run {1})' ;; *) echo 'execute($self --run {1})+reload-sync($self --items)' ;; esac" >/dev/null
}

ascii() {   # for a text console whose font may lack them: plain stand-ins
  if on_console; then sed 's/·/-/g; s/—/-/g; s/…/.../g; s/→/->/g; s/§/s./g'; else cat; fi
}
menu_plain() {   # no fzf, or a text console: numbered, nothing but bash
  local acts=() names=() a g l m i c
  while IFS=$'\t' read -r a g l m; do
    [[ $a == - ]] && continue                     # (the headings: a plain list needs none)
    acts+=("$a"); names+=("$l")
  done < <(rows | sed 's/\x1b\[[0-9;]*m//g')
  while :; do
    { printf '\n  FEDOKAWAII\n\n'; status | sed 's/^/  /'; echo
      for i in "${!acts[@]}"; do printf '  %2d  %s\n' "$((i + 1))" "${names[i]}"; done; } | ascii
    printf '\n  number (q quits): '; read -r c || exit 0
    [[ $c == [qQ] || -z $c ]] && exit 0
    if num "$c" && ((10#$c >= 1 && 10#$c <= ${#acts[@]})); then run "${acts[10#$c - 1]}"; now=$(date +%s)
    else printf '  1–%d, or q\n' "${#acts[@]}" | ascii; fi
  done
}

# ── commands ────────────────────────────────────────────────────────────────────────────
case ${1:-} in
  ""|--popup) [[ ${1:-} == --popup ]] && export FEDOKAWAII_POPUP=yes   # (Super+U's: jobs handed on)
              if [[ -t 0 && -t 1 ]] && ! on_console && command -v fzf >/dev/null; then
                menu_fzf; (($? == 2)) && menu_plain
              else menu_plain; fi
              exit 0 ;;
  --window)   exec kawa-term --float --once system system 100x27 -- "$0" --popup ;;   # (fzf's margin row above, 16 entries, 3 headings and the 2 gaps above them, two rows of paper more above the footer's two, fzf's margin row below: 27, odd, so the window centres to the pixel)
  --rows)     fit_rows ;;
  --items)    fit_items ;;
  --explain)  explain "${2:-}" "${3:-}" ;;
  --run)      run "${2:-}" ;;
  --job)      job_window "${2:-}" ;;                                # (hand's: the job's window)
  --job-run)  BACK="closes this window"; unset FEDOKAWAII_POPUP; run "${2:-}" ;;            # (inside it)
  # (a word more than a command takes is a slip, never ignored: `upgrade now` is no --now)
  status|update|pull|verify|repair|theme|drift|snapshots|backup|log|settings|guide|copy|diff|apply)
              (($# == 1)) || { echo "fedokawaii $1 takes nothing more (\"$2\") — fedokawaii help" >&2; exit 2; } ;;&
  upgrade)    [[ $# == 1 || ( $# == 2 && $2 == --now ) ]] || { echo "usage: fedokawaii upgrade [--now]" >&2; exit 2; }
              as_root upgrade ${2:+"$2"} ;;
  status)     ( release_check >/dev/null 2>&1 & )                      # (never waited on)
              # (a terminal on the desktop: a screen of its own — heading, rows; else plain lines)
              if [[ -t 1 ]] && ! on_console; then job_head status; status_rows; else status | ascii; fi ;;
  update|verify|repair|theme|drift) as_root "$1" ;;
  snapshots)  snapshots ;;
  backup)     backup_now ;;
  log)        log_view ;;
  settings)   run settings ;;
  remind)
    case ${2:-check} in
      check)    remind check ;;
      quiet)    remind ;;                                 # (the session's timer: silent unless due)
      on)       REMIND=yes; save_conf; echo "reminders on — every $EVERY days" ;;
      off)      REMIND=no; save_conf; echo "reminders off" ;;
      every)    if ! [[ ${3:-} =~ ^[0-9]{1,3}$ ]] || ((10#$3 < 7 || 10#$3 > 365)); then echo "every DAYS: 7–365" >&2; exit 2; fi
                EVERY=$((10#$3)); REMIND=yes; save_conf; echo "an update every $EVERY days" ;;
      wait)     if ! [[ ${3:-} =~ ^[0-9]{1,3}$ ]] || ((10#$3 > 180)); then echo "wait DAYS: 0–180" >&2; exit 2; fi
                WAIT=$((10#$3)); save_conf; echo "a new release is offered $WAIT days after it is out" ;;
      *)        echo "usage: fedokawaii remind [check | every DAYS | wait DAYS | on | off]" >&2; exit 2 ;;
    esac ;;
  guide)      guide ;;
  freesync)   (($# == 1)) || { echo "fedokawaii freesync takes nothing more — fedokawaii help" >&2; exit 2; }
              freesync ;;
  report)     [[ $# == 1 || ( $# == 2 && $2 == @(--quick|--perf) ) ]] || { echo "usage: fedokawaii report [--quick | --perf]" >&2; exit 2; }
              exec /usr/local/bin/fedokawaii-report ${2:+"$2"} ;;   # (it asks for root itself)
  copy)       copy_make ;;
  pull)       pull ;;
  --adopt)    (($# == 2)) || exit 2; adopt "$2" ;;          # (setup's last step, as you: the clone it ran from)
  diff)       copy_diff ;;
  keep)       shift; (($#)) || { echo "usage: fedokawaii keep FILE…" >&2; exit 2; }; keep_file "$@" ;;
  apply)      copy_apply ;;
  change)     exec kawa-config ;;
  selftest)   [[ $# == 1 || ( $# == 2 && $2 == --sandbox ) ]] || { echo "usage: fedokawaii selftest [--sandbox]" >&2; exit 2; }
              need_toolkit || exit 1; exec sudo bash "$TK/tools/selftest.sh" ${2:+"$2"} ;;
  trial)      shift; need_toolkit || exit 1; exec bash "$TK/tools/container-trial.sh" "$@" ;;   # (as you: rootless podman)
  -h|--help|help) sed -n '2,/^[^#]/{/^#/p}' "$0" | sed 's/^# \{0,1\}//' ;;
  *)          echo "fedokawaii: unknown command \"$1\" — fedokawaii help" >&2; exit 2 ;;
esac
