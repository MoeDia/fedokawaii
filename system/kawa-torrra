#!/usr/bin/env bash
# /usr/local/bin/kawa-torrra — torrra (torrent search + download) with the Prowlarr API key
# taken only from the environment: PROWLARR_API_KEY, kept in ~/.config/fedokawaii/secrets.sh
# (yours, mode 600). torrra itself reads the key only from its config file and writes it
# back there on every start; here it is handed to torrra in memory instead, so
# ~/.config/torrra/config.toml never holds it (one an older setup left there is taken out).
# Installed by setup.sh.
#
#   kawa-torrra [ARGS…]     torrra ARGS… — in a shell, `torrra` is this (/etc/profile.d)
#   kawa-torrra --open [X]  the launcher entry and magnet links / .torrent files: X is
#                           downloaded; without X the search opens. Trouble shows as a notice
#
# Before a search it asks Prowlarr and says plainly what is missing, instead of an empty
# result list (torrra itself exits 0 on every failure). One torrra at a time: downloads
# run only while its window is open, and a second one would share them.
# It opens at once: Prowlarr is woken as the window opens and starts while you type; the
# first search waits for it (torrra's own "Searching for …" turning meanwhile).
# Its look is the desktop's (the theme "fedokawaii", registered here): foot's own 16 colours,
# which change with dark and light — the ground the terminal's see-through one, vermilion for
# the cursor's row and a focused frame, the frames at rest in the quiet edge colour — and
# its first screen a text screen of ours: the download icon, torrents over the search line, no
# banner, no emoji. Any other theme you pick with Ctrl+T is kept.
set -uo pipefail
# shellcheck source=/dev/null
ICON=$(. "$HOME/.config/fedokawaii/icons.sh" && printf '%s' "$ICON_DOWNLOAD")   # (its notices' mark)
venv=${KAWA_TORRRA_VENV:-$HOME/.local/share/uv/tools/torrra}
py=$venv/bin/python
secrets=$HOME/.config/fedokawaii/secrets.sh
open=0
[[ ${1:-} == --open ]] && { open=1; shift; }

die() {
  printf 'torrra: %s\n' "$*" >&2
  # from the launcher or a link the window closes with us: say it as a notice too
  ((open)) && notify-send -a torrra -u critical -- "$ICON  torrra" "$*" 2>/dev/null
  exit 1
}

[[ -x $py ]] || die "not installed (no uv tool at $venv) — run: fedokawaii update"

# a magnet link, a URL or a .torrent file. xdg-open hands on a file:// URI just as it was
# given (`xdg-open file:///…/my%20file.torrent`), and torrra takes only a path: the URI
# becomes its path here. Anything torrra would turn away is said now — torrra itself
# prints it in red and exits, and the window would close before it could be read.
if ((open && $#)); then
  t=$1
  if [[ $t == file://* ]]; then
    t=${t#file://}; t=${t%%[?#]*}
    [[ $t == /* ]] || t=/${t#*/}                    # (file://localhost/… and file://HOST/…)
    t=${t//\\/\\\\}; printf -v t '%b' "${t//%/\\x}"   # %20 → a space, %C3%A9 → é
  fi
  if [[ $t != magnet:* && ! $t =~ ^https?:// ]]; then
    [[ -f $t ]] || die "no such file: $t"
    [[ $t == *.torrent ]] || die "not a magnet link or a .torrent file: $t"
  fi
  set -- download "$t"
fi

# what kind of run: the search needs Prowlarr; downloads, settings and help do not, and
# only the screens (ui) hold the one-at-a-time lock
first="" search=0 ui=1
for a in "$@"; do [[ $a == -* ]] || { first=$a; break; }; done
case $first in ""|search|prowlarr) search=1 ;; config) ui=0 ;; esac
for a in "$@"; do case $a in --help|-h|--version) ui=0 search=0 ;; esac; done

# the key: only a search uses it (Prowlarr), so a magnet link still downloads when
# secrets.sh is missing or not right
if ((search)); then
  if [[ -z ${PROWLARR_API_KEY:-} && ! -e $secrets ]]; then die "$secrets is missing — fedokawaii update makes it"; fi
  if [[ -z ${PROWLARR_API_KEY:-} && -r $secrets ]]; then
    # the shell's rule: only a file that is yours alone
    [[ $(stat -c %a "$secrets") == 600 && -O $secrets ]] || die "$secrets must be yours and private — chmod 600 it"
    # only the key is taken from it, read in a shell of its own (as setup and verify read
    # it): your other keys there stay out of torrra's environment, and a slip in the file
    # (a name that is not set) stops nothing here
    # shellcheck source=/dev/null
    PROWLARR_API_KEY=$(set +u; . "$secrets" >/dev/null 2>&1; printf %s "${PROWLARR_API_KEY:-}")
  fi
  [[ ${PROWLARR_API_KEY:-} =~ ^[0-9a-f]{32}$ ]] || die "no PROWLARR_API_KEY (32 hex characters) in $secrets — run: fedokawaii update"
fi

if ((ui)); then
  # (su, a cron job, a plain SSH command: no session of yours, so no runtime folder to lock in)
  [[ -n ${XDG_RUNTIME_DIR:-} && -d $XDG_RUNTIME_DIR ]] || die "run torrra inside your session (a terminal of the desktop, or an SSH login): there is no XDG_RUNTIME_DIR here"
  exec 8>"$XDG_RUNTIME_DIR/kawa-torrra.lock"
  if ! flock -n 8; then
    if [[ $first == download ]] && command -v wl-copy >/dev/null; then
      setsid -f wl-copy -- "${!#}" 2>/dev/null    # (its own session: outlives this window)
      die "torrra is already open in another window — close it, then open the link again (it is on your clipboard)"
    fi
    die "torrra is already open in another window"
  fi
fi

# torrra, started from here: its settings object answers the key from memory and never
# stores it. Every name used below is checked first, so a torrra that changed underneath
# stops with a message rather than writing the key to disk.
read -r -d '' BOOT <<'PY' || true
import atexit, copy, os, re, subprocess, sys, tomllib
key = os.environ.pop("KAWA_KEY")
search, notify = os.environ.pop("KAWA_SEARCH") == "1", os.environ.pop("KAWA_NOTIFY") == "1"
icon = os.environ.pop("KAWA_ICON", "")

def warn(msg, urgency="normal", printed=False):
    if not printed:
        print("torrra: " + msg, file=sys.__stderr__)
    if notify:
        subprocess.run(["notify-send", "-a", "torrra", "-u", urgency, "--", icon + "  torrra", msg],
                       stderr=subprocess.DEVNULL, check=False)

def fail(msg):
    warn(msg, "critical")
    sys.exit(1)

try:
    import httpx, libtorrent  # noqa: F401  (a broken libtorrent shows here, not mid-download)
    import torrra.core.config as c
    from torrra.__main__ import cli
    from torrra.core.constants import DEFAULT_MAX_RETRIES, DEFAULT_TIMEOUT
    get, set_, load, _ = c.Config.get, c.Config.set, c.Config._load_config, c.CONFIG_FILE
    from textual.theme import BUILTIN_THEMES, Theme
    import torrra.app as tapp
    import torrra.screens.home as home
    import torrra.screens.welcome as welcome
    import torrra.indexers.prowlarr as prowlarr
    from torrra.core.exceptions import IndexerError
    from textual.containers import Container, Grid
    from textual.widgets import Static
    from torrra.core.download import get_download_manager
    tick = home.HomeScreen._update_downloads_data
except (ImportError, AttributeError) as e:
    fail(f"cannot start ({e}) — run: fedokawaii update")
# the desktop's theme, built on Textual's ansi-dark (foot's 16 colours: right on the ink and
# the paper alike, the terminal's see-through ground kept) — vermilion (red) both the primary
# and the secondary (torrra frames what has the focus, and its dialogs, in the secondary): the
# cursor's row filled in it, its words the ground's ink (black); a list without the focus keeps
# its row in vermilion ink, unfilled; frames at rest in the quiet edge colour (bright black,
# torrra's "secondary-muted"), and words torrra sets apart (its "text-secondary") in the text's
BASE = BUILTIN_THEMES.get("ansi-dark")
if BASE is None:
    fail("cannot start (this Textual has no ansi-dark theme to build on) — run: fedokawaii update")
THEME = "fedokawaii"
BUILTIN_THEMES[THEME] = Theme(
    name=THEME, ansi=True, dark=True,
    primary="ansi_red", secondary="ansi_red", accent="ansi_bright_cyan",
    warning="ansi_yellow", error="ansi_bright_red", success="ansi_green",
    foreground="ansi_default", background="ansi_default", surface="ansi_default",
    panel="ansi_default", boost="ansi_default",
    variables={**BASE.variables,
               "block-cursor-background": "ansi_red", "block-cursor-foreground": "ansi_black",
               "block-cursor-text-style": "none",
               "block-cursor-blurred-background": "transparent",
               "block-cursor-blurred-foreground": "ansi_red",
               "secondary-muted": "ansi_bright_black", "text-secondary": "ansi_white",
               "input-cursor-background": "ansi_red", "input-cursor-foreground": "ansi_black",
               "input-selection-background": "ansi_red 40%",
               "footer-key-foreground": "ansi_red", "button-color-foreground": "ansi_black"})
# the first screen's layout (below), as text screens are set: left-aligned, 64 wide (each
# !important: torrra's own app.tcss, read after this, would win every tie)
tapp.TorrraApp.CSS = """
#welcome_container { max-width: 64 !important; }
#welcome_container #banner { text-align: left !important; color: ansi_white !important; }
#welcome_container #subtitle { text-align: left !important; color: ansi_bright_black !important; }
#welcome_container #version { text-align: left !important; color: ansi_bright_black !important; }
#welcome_container #commands_container { align-horizontal: left !important; }
#welcome_container #commands_container Grid { width: 100% !important; grid-columns: 14 1fr !important; }
#welcome_container #commands_container Grid Static { color: ansi_bright_black !important; }
#welcome_container #commands_container Grid Static.key { text-align: left !important; color: ansi_white !important; }
"""

# the first screen: a text screen of ours (docs/design-system.md §7) — the heading (the
# download icon in vermilion — Sumi Icons' U+FE042, as in icons.sh —, the name, the rule), a line saying what it is, the search line, then the keys
# as rows: no banner, no emoji. The same ids as torrra's own, so its layout holds
def kawa_welcome(self):
    with Container(id="welcome_container"):
        yield Static("[ansi_red]\U000fe042[/]  torrents [ansi_bright_black]" + "─" * 52 + "[/]", id="banner")
        yield Static("search the usual sites through Prowlarr —\ndownloads go on while this window is open",
                     id="subtitle")
        yield welcome.SearchInput(placeholder="what to find", id="search")
        yield Static(f"torrra {welcome.__version__} · {self.indexer.name if self.indexer else 'no search'}",
                     id="version")
        with Container(id="commands_container"), Grid():
            for words, key in (("quit", "ctrl+q"), ("colours", "ctrl+t"), ("downloads", "ctrl+d"), ("every key", "?")):
                yield Static(words, markup=False)
                yield Static(key, classes="key")
welcome.WelcomeScreen.compose = kawa_welcome

# Prowlarr, woken by kawa-torrra as the window opened, is waited for at the first search
# only — torrra's own check before its window (which would find it still starting) skipped (it is healthy in a few seconds; the search's spinner turns meanwhile) — then asked
# what would otherwise end in torrra's "Search failed": every reason said plainly, as a notice
first_search = prowlarr.ProwlarrIndexer.search
ready = []

async def kawa_ready():
    import asyncio
    proc = await asyncio.create_subprocess_exec("kawa-prowlarr", "--busy", stdin=asyncio.subprocess.DEVNULL,
                                                stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)
    if await proc.wait() != 0:
        return "Prowlarr did not start — journalctl --user -u prowlarr -e"
    try:
        async with httpx.AsyncClient(timeout=5) as client:
            r = await client.get("http://127.0.0.1:9696/api/v1/indexer", headers={"X-Api-Key": key})
    except httpx.HTTPError:
        return "Prowlarr is not answering on 127.0.0.1:9696 — systemctl --user status prowlarr"
    if r.status_code == 401:
        return "Prowlarr refused the key in secrets.sh — run: fedokawaii update (it hands Prowlarr the key again)"
    if r.status_code != 200:
        return f"Prowlarr answered HTTP {r.status_code} — journalctl --user -u prowlarr -e"
    if not any(i.get("enable") for i in r.json()):
        return "Prowlarr has no indexers switched on — fedokawaii repair adds the usual ones (or: prowlarr → Indexers)"
    return None

async def kawa_search(self, query, use_cache=True):
    if not ready:
        msg = await kawa_ready()
        if msg:
            warn(msg, "critical")
            raise IndexerError(msg)
        ready.append(True)
    return await first_search(self, query, use_cache)
async def kawa_healthcheck(self):
    return True                                       # (torrra's own, before the window: asked at the first search instead)
prowlarr.ProwlarrIndexer.search, prowlarr.ProwlarrIndexer.healthcheck = kawa_search, kawa_healthcheck

SECRET = "indexers.prowlarr.api_key"
SEARCH_WAIT = 60                                      # seconds: a search's answer from Prowlarr
THEMES = ("ansi-dark", "ansi-light", "textual-dark")     # what earlier setups chose: ours now

def kawa_load(self):
    load(self)
    readable = True                                   # a settings file with a slip in it: torrra
    try:                                              # runs on its defaults (with Prowlarr and the
        with open(c.CONFIG_FILE, "rb") as f:          # colours below, in memory only) and the file
            tomllib.load(f)                           # stays exactly as you left it
    except FileNotFoundError:
        pass
    except (OSError, tomllib.TOMLDecodeError) as e:
        readable = False
        warn(f"~/.config/torrra/config.toml does not read ({e}) — running on defaults; the file is left as it is")
    cfg, dirty = self.config, False
    idx = cfg.setdefault("indexers", {})
    p = idx.setdefault("prowlarr", {})
    if isinstance(p, dict) and p.pop("api_key", None) is not None:
        dirty = True                                  # left by an older setup: out it goes
    for d, k, v in ((p, "url", "http://127.0.0.1:9696"), (idx, "default", "prowlarr")):
        if k not in d:
            d[k], dirty = v, True
    g = cfg.setdefault("general", {})
    if g.get("theme", "textual-dark") in THEMES and g.get("theme") != THEME:
        g["theme"], dirty = THEME, True               # (an ansi-light an older setup chose too)
    # Prowlarr answers a search once the slowest of its eight sites has (one slow, or blocked
    # here, takes its time); torrra's own wait — 10 s, tried three times, each try a whole
    # new search — gave up first: "Search failed", "Nothing found". A minute, once. A wait
    # or a number of tries you set yourself stays
    for k, ours, theirs in (("timeout", SEARCH_WAIT, DEFAULT_TIMEOUT), ("max_retries", 1, DEFAULT_MAX_RETRIES)):
        if g.get(k, theirs) == theirs:
            g[k], dirty = ours, True
    if dirty and readable:
        self._save_config()

def kawa_get(self, key_path, *args, **kwargs):
    return key if key_path == SECRET else get(self, key_path, *args, **kwargs)

def kawa_set(self, key_path, value):
    if key_path != SECRET:                            # torrra stores the key at each start
        set_(self, key_path, value)

c.Config._load_config, c.Config.get, c.Config.set = kawa_load, kawa_get, kawa_set
if not callable(getattr(c.Config, "_save_config", None)):
    fail("cannot start (torrra changed how it saves settings) — kawa-torrra needs an update")

# the downloads centre (kawa-downloads: the bar's download mark): what this window downloads,
# every 2 s, in $XDG_RUNTIME_DIR/kawa-downloads/torrra.PID — NAME, DONE, TOTAL (bytes) and
# WHERE, a line each (gone with this window: its pid says whose) — and one notice as each
# finishes. Only what downloads: a paused or finished torrent is not listed
RUN = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""), "kawa-downloads")
STATUS = os.path.join(RUN, f"torrra.{os.getpid()}")
seen, told, last = set(), set(), [0.0]

def kawa_status():
    import time
    if not os.environ.get("XDG_RUNTIME_DIR") or time.monotonic() - last[0] < 2:
        return
    last[0] = time.monotonic()
    rows = []
    for uri, h in list(get_download_manager().torrents.items()):
        try:
            s = h.status()
        except RuntimeError:                          # (removed meanwhile)
            continue
        name = s.name or "a torrent"
        where = os.path.join(s.save_path, s.name) if s.name else s.save_path
        if s.is_finished or s.is_seeding:
            if uri in seen and uri not in told:       # (finished while this window watched it)
                told.add(uri)
                subprocess.Popen(["kawa-downloads", "notice", "torrent", name, str(s.total_wanted), where],
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            continue
        seen.add(uri)
        if s.flags & libtorrent.torrent_flags.paused:
            continue
        rows.append("\t".join((name.replace("\t", " ").replace("\n", " "), str(s.total_wanted_done),
                               str(s.total_wanted), where.replace("\t", " ").replace("\n", " "))) + "\n")
    try:
        if rows:
            os.makedirs(RUN, mode=0o700, exist_ok=True)
            with open(STATUS + ".new", "w", encoding="utf-8") as f:
                f.writelines(rows)
            os.replace(STATUS + ".new", STATUS)
        elif os.path.exists(STATUS):
            os.remove(STATUS)
    except OSError:
        pass

def kawa_tick(self):
    tick(self)
    kawa_status()

def kawa_gone():
    try:
        os.remove(STATUS)
    except OSError:
        pass

atexit.register(kawa_gone)
home.HomeScreen._update_downloads_data = kawa_tick

# torrra says what stops it on stderr, in red, and exits 0 all the same — from the launcher
# the window would close before it could be read: anything it says there (its own words
# only: Textual draws on the terminal's own stream) becomes the notice, and status 1
class Heard:
    def __init__(self, f):
        self.f, self.said = f, []
    def write(self, t):                               # (click hands it bytes, or words)
        self.said.append(t.decode("utf-8", "replace") if isinstance(t, bytes) else t)
        return self.f.write(t)
    def __getattr__(self, name):
        return getattr(self.f, name)

sys.stderr = heard = Heard(sys.stderr)
sys.argv[0] = "torrra"
try:
    rc = cli()
except SystemExit as e:
    rc = e.code
sys.stderr = heard.f
said = re.sub(r"\x1b\[[0-9;]*m", "", "".join(heard.said)).strip()
if said and rc in (0, None):
    warn(" ".join(said.split()), "critical", printed=True)   # (on the terminal it is there already)
    sys.exit(1)
sys.exit(rc)
PY

# Prowlarr runs on demand: woken here as the window opens (kawa-prowlarr --busy, in the
# background: the window does not wait — the first search does, inside torrra; the start
# returns once it is healthy, a few seconds; systemd gives up after 10 minutes, the unit's
# TimeoutStartSec), and left to sleep 30 minutes after this window closes (kawa-prowlarr
# --idle) — however torrra ends, the window closed during a search included (trap) — so a
# second search soon after finds it awake
if ((search)); then
  # what would only fail inside systemd, said plainly first: no unit at all (podman, or the
  # container file, missing: the quadlet generator made none), or Prowlarr's port taken
  [[ $(systemctl --user show -p LoadState --value prowlarr.service 2>/dev/null) != not-found ]] \
    || die "Prowlarr is not set up here (no prowlarr.service: podman or its container file is missing) — run: fedokawaii repair"
  if ! systemctl --user is-active --quiet prowlarr.service && [[ -n $(ss -Htln 'sport = :9696' 2>/dev/null) ]]; then
    die "port 9696, Prowlarr's, is taken by another program — ss -ltnp 'sport = :9696' shows which"
  fi
  # (set before the start: a window closed, or Ctrl+C, while Prowlarr is still starting
  # plans its sleep too — the start goes on in systemd after systemctl itself is gone)
  trap 'kawa-prowlarr --idle 2>/dev/null' EXIT
  trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
  kawa-prowlarr --busy >/dev/null 2>&1 8>&- &
fi
KAWA_KEY=${PROWLARR_API_KEY:-} KAWA_SEARCH=$search KAWA_NOTIFY=$open KAWA_ICON=$ICON \
  "$py" -I -c "$BOOT" "$@" 8>&-
exit $?
