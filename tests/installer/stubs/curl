#!/bin/bash
# curl of the fake Fedora: downloads come from $FKH/dl/<file name>; $FKH/net = off is offline;
# $FKH/partial-<file> cuts that download half-way; $FKH/fail-curl-<file> = N fails it N times
. /usr/local/bin/_lib.sh
fkh_log "$*"
out="" url="" code=0 cfg=0
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  case ${args[i]} in
    -o) out=${args[i+1]} ;; -w) code=1 ;; -K) [[ ${args[i+1]} == - ]] && cfg=1 ;;
    http*://*) url=${args[i]} ;;
  esac
done
((cfg)) && cat >/dev/null
# Brave's DevTools port (verify: "Brave Origin starts")
if [[ $url == http://127.0.0.1:9229/json/version ]]; then
  printf '{\n   "Browser": "Chrome/141.0.0.0",\n   "Protocol-Version": "1.3"\n}\n'; exit 0
fi
# Prowlarr: its indexers ($FKH/prowlarr-indexers), its authentication ($FKH/prowlarr-auth, else
# "external": no login) and its page (a login's redirect, 302, under any other)
if [[ $url == http://127.0.0.1:9696/* ]]; then
  r=$(rcfor prowlarr 0); ((r == 0)) || exit "$r"
  auth=$(cat "$FKH/prowlarr-auth" 2>/dev/null || echo external)
  [[ $url == */indexer ]] && { cat "$FKH/prowlarr-indexers" 2>/dev/null || echo '[]'; }
  [[ $url == */system/status ]] && printf '{"appName": "Prowlarr", "authentication": "%s"}\n' "$auth"
  [[ $url == http://127.0.0.1:9696/ ]] && ((code)) && { [[ $auth == external ]] && printf 200 || printf 302; }
  exit 0
fi
host=${url#https://}; host=${host%%/*}
if ! net_on || has unreachable "$host"; then
  ((code)) && printf '000'; echo "curl: (6) Could not resolve host: $host" >&2; exit 6
fi
# $FKH/clock = wrong: the machine's clock is years off — every https certificate is refused
if [[ $(cat "$FKH/clock" 2>/dev/null) == wrong ]]; then
  ((code)) && printf '000'; echo "curl: (60) SSL certificate problem: certificate is not yet valid" >&2; exit 60
fi
((code)) && { printf '200'; exit 0; }
case $url in
  https://mirrors.fedoraproject.org/) exit 0 ;;
  # a COPR project: built for Fedora 44–46 and Rawhide, less "OWNER/PROJECT CHROOT" lines in $FKH/copr-without
  https://copr.fedorainfracloud.org/api_3/project\?*)
     o=${url#*ownername=}; o=${o%%&*}; pn=${url#*projectname=}; pn=${pn%%&*}; js=""
     for chr in fedora-44-x86_64 fedora-45-x86_64 fedora-46-x86_64 fedora-rawhide-x86_64; do
       has copr-without "$o/$pn $chr" || js+="${js:+, }\"$chr\": \"https://download.copr.fedorainfracloud.org/results/$o/$pn/$chr/\""
     done
     printf '{"full_name": "%s/%s", "chroot_repos": {%s}}\n' "$o" "$pn" "$js"; exit 0 ;;
  https://api.github.com/repos/GloriousEggroll/*) countdown curl-ge-api && { echo "curl: (22) The requested URL returned error: 403" >&2; exit 22; }
     cat "$FKH/ge.json" 2>/dev/null || { echo "curl: (22) 404" >&2; exit 22; }; exit 0 ;;
esac
f=${url##*/}
countdown "curl-$f" && { echo "curl: (28) Operation timed out" >&2; exit 28; }
# RPM Fusion's release packages, for any Fedora: a file with an RPM's lead ($FKH/dl may hold
# another one: a sign-in page, say)
if [[ $f == rpmfusion-*-release-*.noarch.rpm && ! -f $FKH/dl/$f ]]; then
  printf '\xed\xab\xee\xdb fake %s\n' "$f" >"${out:-/dev/stdout}"; exit 0
fi
[[ -f $FKH/dl/$f ]] || { echo "curl: (22) The requested URL returned error: 404 ($url)" >&2; exit 22; }
if [[ -f $FKH/partial-$f ]]; then
  s=$(stat -c %s "$FKH/dl/$f"); head -c $((s / 2)) "$FKH/dl/$f" >"${out:-/dev/stdout}"
  echo "curl: (18) transfer closed with outstanding read data remaining" >&2; exit 18
fi
if [[ -n $out ]]; then cat "$FKH/dl/$f" >"$out"; else cat "$FKH/dl/$f"; fi
