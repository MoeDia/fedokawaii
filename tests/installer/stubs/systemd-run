#!/bin/bash
# systemd-run of the fake Fedora: dnf's unit (setup.sh dnf_detached) — the program run here to
# its end; systemd-run itself says only that it started (0), as without --wait. The unit's end
# is kept for systemctl show (RemainAfterExit): "ended UNIT RC" in $FKH/units (RC 128+N: killed
# by signal N); $FKH/dnf-killed = N — dnf killed by signal N instead of running; $FKH/crash-on =
# a regex: the dnf whose arguments match it ends with systemd itself crashed (a reload while a
# scriptlet's reload reply is pending) — every `show` unanswered from then on, its journal saying it
# froze; $FKH/run-fail: systemd-run itself gets no answer (PID 1 gone: "Connection timed out"), exit 1
. /usr/local/bin/_lib.sh
fkh_log "$*"
# (--user --scope … -- CMD: theme.sh's live step — CMD run here, as the scope runs it)
if [[ ${1:-} == --user ]]; then while (($#)) && [[ $1 != -- ]]; do shift; done; shift; exec "$@"; fi
[[ -f $FKH/run-fail ]] && { echo "Failed to start transient service unit: Connection timed out" >&2; exit 1; }
unit=""
for a; do case $a in --unit=*) unit=${a#--unit=}.service ;; esac; done
while (($#)) && [[ $1 != /usr/bin/dnf ]]; do shift; done
shift
# ($FKH/run-hangs: the replay's dnf still starting — no history row yet, the unit running — when a
# stop from outside comes: cut-on '^systemd-run\] running …'; the unit ends after two asks of is-active)
if [[ -f $FKH/run-hangs && -n $unit && " $* " == *" replay "* ]]; then
  rm -f "$FKH/run-hangs"; echo "active $unit" >>"$FKH/units"; echo 2 >"$FKH/fail-busy-$unit"; chmod 666 "$FKH/fail-busy-$unit"
  fkh_cut "systemd-run] running $*"; exit 0
fi
if [[ -s $FKH/dnf-killed ]]; then rc=$((128 + $(cat "$FKH/dnf-killed"))); else /usr/local/bin/dnf "$@"; rc=$?; fi
[[ -n $unit ]] && echo "ended $unit $rc" >>"$FKH/units"
fkh_cut "systemd-run] ended $*"   # (a stop from outside the moment the unit has ended, before its end is read: cut-on '^systemd-run\] ended …')
if [[ -f $FKH/crash-on && $* =~ $(cat "$FKH/crash-on") ]]; then
  echo show >>"$FKH/systemctl-fail"; printf '%s\n' 'Caught <ABRT>, from our own process.' 'Freezing execution.' >>"$FKH/journal-pid1"
  chmod 666 "$FKH/systemctl-fail" "$FKH/journal-pid1"
fi
exit 0
