#!/bin/bash
# python3 of the fake Fedora: the machine's own. Fedora reads /usr/local's site folder
# (lib/pythonX.Y/site-packages) only while the user site is on, and -I turns both off — so a
# leading -I is -E -P here (the environment still ignored, no script folder first): the
# fake machine's own /usr/local is read, where fake_pylibs puts its stand-in libraries
[[ ${1-} == -I ]] && { shift; set -- -E -P "$@"; }
exec /usr/bin/python3 "$@"
