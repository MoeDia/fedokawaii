#!/bin/bash
shopt -s extglob
# python3 of the fake Fedora: the machine's own, except tools/build-term-font.py (fontTools'
# work on a real face; the fake machine's Fusion Pixel faces are stand-ins): it writes a stand-in
# Sumi Term where it was asked to (test_upstream covers the call itself)
if [[ $1 == -I && ${2##*/} == build-@(term|ui)-font.py ]]; then printf 'stand-in face\n' >"${@: -1}"; exit 0; fi
exec /usr/bin/python3 "$@"
