#!/bin/bash
# rpm2archive of the fake Fedora: an RPM Fusion release package read from stdin ("-") comes out
# as its tar.gz — what setup reads of it: its key file (RPM Fusion's 2020 key, and a link to it
# for the release), as the real package carries them. gpg's stand-in names the key's fingerprint
. /usr/local/bin/_lib.sh
fkh_log "$*"
in=$(cat); r=free; [[ $in == *nonfree* ]] && r=nonfree
d=$(mktemp -d) || exit 1
mkdir -p "$d/etc/pki/rpm-gpg"
printf -- '-----BEGIN PGP PUBLIC KEY BLOCK-----\nrpmfusion-%s\n-----END PGP PUBLIC KEY BLOCK-----\n' "$r" >"$d/etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-$r-fedora-2020"
ln -s "RPM-GPG-KEY-rpmfusion-$r-fedora-2020" "$d/etc/pki/rpm-gpg/RPM-GPG-KEY-rpmfusion-$r-fedora-44"
tar -czf - -C "$d" ./etc; rc=$?
rm -rf "$d"; exit "$rc"
