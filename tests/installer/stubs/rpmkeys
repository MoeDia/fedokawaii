#!/bin/bash
# rpmkeys of the fake Fedora: -K FILE — a package's digests and signature, as rpm says them
# ($FKH/rpm-badsig: a package not signed with the key imported — a mirror's own file)
. /usr/local/bin/_lib.sh
fkh_log "$*"
rc=0
for f; do
  [[ $f == -* ]] && continue
  if [[ -f $FKH/rpm-badsig ]]; then echo "$f: digests SIGNATURES NOT OK"; rc=1; else echo "$f: digests signatures OK"; fi
done
exit "$rc"
