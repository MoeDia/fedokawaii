#!/bin/bash
# grubby of the fake Fedora — present only once installed (a BIOS install has none at first);
# the boot entries' arguments are $FKH/grub-args (one entry per line)
. /usr/local/bin/_lib.sh
has installed grubby || { echo "bash: grubby: command not found" >&2; exit 127; }
fkh_log "$*"
[[ -f $FKH/grub-args ]] || printf '%s\n' "ro rootflags=subvol=root rhgb quiet" "ro rootflags=subvol=root rhgb quiet" >"$FKH/grub-args"
case " $* " in
  # ($FKH/menu: the boot menu's kernels in GRUB's order, one a line — else one 6.19.N per entry)
  *" --info=ALL "*) if [[ -f $FKH/menu ]]; then
                      n=0; while IFS= read -r k; do printf 'index=%d\nkernel="/boot/vmlinuz-%s"\nargs="%s"\n' "$n" "$k" "$(sed -n 1p "$FKH/grub-args")"; n=$((n + 1)); done <"$FKH/menu"; exit 0
                    fi
                    n=0; while IFS= read -r l; do n=$((n + 1)); printf 'index=%d\nkernel="/boot/vmlinuz-6.19.%d"\nargs="%s"\n' "$n" "$n" "$l"; done <"$FKH/grub-args"; exit 0 ;;
  *" --update-kernel=ALL "*)
     for x in "$@"; do
       case $x in --args=*) for w in ${x#--args=}; do
                               k=${w%%=*}; sed -i -E "s/(^| )${k//./\\.}=[^ ]*//g; s/\$/ $w/" "$FKH/grub-args"; done ;;
                    --remove-args=*) for w in ${x#--remove-args=}; do
                               sed -i -E "s/(^| )${w//./\\.}(=[^ ]*)?( |\$)/\\1\\3/g; s/  +/ /g; s/ \$//" "$FKH/grub-args"; done ;;
       esac
     done; exit "$(rcfor grubby 0)" ;;
esac
exit 0
