#!/bin/bash
# resolvectl of the fake Fedora: a card's routing domains in $FKH/resolv-domains ("domain DEV" lists them as the real one does)
. /usr/local/bin/_lib.sh
fkh_log "$*"
if [[ ${1:-} == domain && $# -ge 2 ]]; then
  if (($# == 2)); then printf 'Link 2 (%s): %s\n' "$2" "$(cat "$FKH/resolv-domains" 2>/dev/null)"
  else d=$2; shift 2; printf '%s\n' "$*" | sed 's/ *$//' >"$FKH/resolv-domains"; fi
fi
exit 0
