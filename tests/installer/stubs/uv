#!/bin/bash
# uv python install|upgrade|find: a CPython in your home (unless $FKH/rc-uv says otherwise)
. /usr/local/bin/_lib.sh
fkh_log "$*"
r=$(rcfor uv 0); ((r == 0)) || exit "$r"
case "$1 $2" in
  "python install") mkdir -p "$HOME/.local/share/uv/python/cpython-3.14.0-linux-x86_64-gnu/bin" ;;
  "python find") d=$(ls -d "$HOME"/.local/share/uv/python/cpython-*/bin 2>/dev/null | head -n1); [[ -n $d ]] || exit 2; echo "$d/python3.14" ;;
esac
exit 0
