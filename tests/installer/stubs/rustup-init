#!/bin/bash
# rustup-init -y …: rustup and the stable toolchain's proxies in $CARGO_HOME/bin (setup's as_user
# sets it: ~/.local/share/cargo)
. /usr/local/bin/_lib.sh
fkh_log "$*"
r=$(rcfor rustup-init 0); ((r == 0)) || exit "$r"
mkdir -p "${CARGO_HOME:?}/bin" "${RUSTUP_HOME:?}/toolchains/stable-x86_64-unknown-linux-gnu"
for b in cargo rustc rust-analyzer cargo-clippy rustfmt; do printf '#!/bin/bash\nexit 0\n' >"$CARGO_HOME/bin/$b"; chmod 755 "$CARGO_HOME/bin/$b"; done
# (rustup itself says what it was asked: update's `rustup update`)
printf '#!/bin/bash\n. /usr/local/bin/_lib.sh\nfkh_log "$*"\nexit 0\n' >"$CARGO_HOME/bin/rustup"; chmod 755 "$CARGO_HOME/bin/rustup"
exit 0
