#!/bin/bash
# lpf-pkgbuild of the fake Fedora (lpf-spotify-client's hook in the fake dnf puts it in
# /usr/share/lpf/scripts): lpf's own steps as far as setup.sh takes them — scan, set-state,
# build, clear-results — on /var/lib/lpf as the real one keeps it, and only as pkg-build with
# its own home (the real one refuses other users, and builds in $HOME/rpmbuild).
#   $FKH/lpf-newer        the recipe is newer than the package installed (a Spotify release)
#   $FKH/lpf-build-fail   the build fails (Spotify's server down, say)
. /usr/local/bin/_lib.sh
fkh_log "$* (as $(id -un), HOME=$HOME)"
[[ $(id -un) == pkg-build && $HOME == /var/lib/lpf ]] || { echo "lpf-pkgbuild: run as $(id -un), HOME=$HOME" >&2; exit 1; }
V=/var/lib/lpf
st() { echo "$2" >"$V/packages/$1/state"; }
case $1 in
  scan)
    cur=$(cat "$V/packages/spotify-client/state" 2>/dev/null || echo untriaged)
    if ! has installed spotify-client || [[ -f $FKH/lpf-newer ]]; then
      case $cur in OK | untriaged) st spotify-client approve-wait ;; esac
    else st spotify-client OK; fi ;;
  set-state) st "$2" "$3" ;;
  build)
    if [[ -f $FKH/lpf-build-fail ]]; then st "$2" failed
    else mkdir -p "$V/rpms/$2"; : >"$V/rpms/$2/$2-1.3.4.258-1.fc44.x86_64.rpm"; st "$2" install-wait; fi ;;
  clear-results) rm -rf "${V:?}/rpms/$2" ;;
  *) echo 'What!?' >&2; exit 1 ;;
esac
