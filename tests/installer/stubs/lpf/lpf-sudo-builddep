#!/bin/bash
# lpf-sudo-builddep of the fake Fedora: root's step, installing what the recipe needs to build
# ($FKH/rc-builddep: its exit status)
. /usr/local/bin/_lib.sh
fkh_log "$* (as $(id -un))"
[[ $(id -u) == 0 ]] || exit 1
r=$(rcfor builddep 0); ((r == 0)) || exit "$r"
# (dnf builddep installs the recipe's BuildRequires as the user's: lsb_release, say)
grep -qx lsb_release "$FKH/installed" 2>/dev/null || { echo lsb_release >>"$FKH/installed"; echo "lsb_release User" >>"$FKH/userinstalled"; }
exit 0
