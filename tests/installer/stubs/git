#!/bin/bash
# git of the fake Fedora: clone makes a source folder (Syncplay's: fake_syncplay_source); tags
# resolve to the pinned commits
# ($FKH/tag-TAG overrides); $FKH/fail-git-fetch = N fails the fetch N times. A commit fetched
# into a new repository whose origin is ble.sh's is checked out as fake_blesh_source;
# $FKH/fail-git-submodule = N fails its submodule update N times
. /usr/local/bin/_lib.sh
fkh_log "$*"
[[ -f $FKH/real-git ]] && exec /usr/bin/git "$@"
dir=. ; [[ $1 == -C ]] && { dir=$2; shift 2; }
while [[ $1 == -c ]]; do shift 2; done
case $1 in
  init)  d=${*: -1}; [[ $d == /* ]] && { mkdir -p "$d/.git"; echo "ref: refs/heads/main" >"$d/.git/HEAD"; }; exit 0 ;;
  remote) [[ $2 == add ]] && printf '%s\n' "$4" >"$dir/.git/fk-origin"; exit 0 ;;
  checkout) [[ $(cat "$dir/.git/fk-origin" 2>/dev/null) == */ble.sh.git ]] && fake_blesh_source "$dir"; exit 0 ;;
  submodule) net_on || { echo "fatal: unable to access 'https://github.com/akinomyoga/blesh-contrib.git/'" >&2; exit 128; }
         countdown git-submodule && { echo "fatal: unable to access: timed out" >&2; exit 128; }
         mkdir -p "$dir/contrib"; exit 0 ;;
  ls-remote)   # (fedokawaii's release tags, newest first: $FKH/release-tags, a tag a line)
         net_on || { echo "fatal: unable to access" >&2; exit 128; }
         [[ -f $FKH/fail-git-ls-remote ]] && exit 128
         while read -r t; do printf '%040d\trefs/tags/%s\n' 1 "$t"; done < <(cat "$FKH/release-tags" 2>/dev/null); exit 0 ;;
  clone) net_on || { echo "fatal: unable to access" >&2; exit 128; }
         countdown git-clone && { echo "fatal: unable to access: timed out" >&2; exit 128; }
         d=${*: -1}; mkdir -p "$d/.git"; echo "ref: refs/heads/main" >"$d/.git/HEAD"
         if [[ " $* " == *MoeDia/fedokawaii* ]]; then   # (the release: the toolkit as it is, marked; its checks' stand-in)
           cp -a /usr/local/lib/fedokawaii/. "$d/"; mkdir -p "$d/.git"; echo "ref: refs/heads/main" >"$d/.git/HEAD"; echo "$*" >"$d/FROM-RELEASE"
           mkdir -p "$d/tests/installer"
           printf '%s\n' '#!/bin/bash' '. /usr/local/bin/_lib.sh; fkh_log "torture $*"; [[ ! -e $FKH/toolkit-red ]]' >"$d/tests/installer/test_torture.sh"
           [[ -e $FKH/toolkit-syntax ]] && echo 'if' >>"$d/lib/update.sh"
           exit 0
         fi
         if [[ " $* " == *Syncplay/syncplay* ]]; then fake_syncplay_source "$d"
         else printf 'static const unsigned int gappx = 5;\nstatic float bordercolor[3][4];\n' >"$d/config.def.h"; fi
         exit 0 ;;
  fetch) net_on || { echo "fatal: unable to access 'https://codeberg.org/dwl/dwl.git/'" >&2; exit 128; }
         countdown git-fetch && { echo "fatal: unable to access 'https://codeberg.org/dwl/dwl.git/': Operation timed out" >&2; exit 128; }
         exit 0 ;;
  rev-parse)
         # (a .git with no HEAD in it is no repository: a clone cut off at its first moment)
         [[ -f $dir/.git/HEAD ]] || { echo "fatal: not a git repository: '$dir/.git'" >&2; exit 128; }
         case $2 in
           --git-dir) echo .git ;;
           "v0.9^{commit}") cat "$FKH/tag-v0.9" 2>/dev/null || echo 98bea2c27f99c549023fb394bfd983a439d8ccb9 ;;
           "1.28.0^{commit}") cat "$FKH/tag-1.28.0" 2>/dev/null || echo ab33c9a19d626f8d0ac0bd1adfdba21946ada948 ;;
           "v1.4.3^{commit}") cat "$FKH/tag-v1.4.3" 2>/dev/null || echo cb8cec0b30aa6e2cc36b1b5cb34d6dc9a1face29 ;;
           "v1.7.6^{commit}") cat "$FKH/tag-v1.7.6" 2>/dev/null || echo 993232ab095bb810593459bc705b3e6fc64ad161 ;;
           "v1.11.0^{commit}") cat "$FKH/tag-v1.11.0" 2>/dev/null || echo 91c6b799855762ad1eb8b4498967c270a339be0c ;;
           "v26.9.1^{commit}") cat "$FKH/tag-v26.9.1" 2>/dev/null || echo 8dd895c695a5950330c2623eb43debf323b60654 ;;
           HEAD) if [[ -f $dir/.git/fk-commit ]]; then cat "$dir/.git/fk-commit"   # (a neovim plugin's: the stub nvim's)
                 else cat "$FKH/dwl-head" 2>/dev/null || echo 98bea2c27f99c549023fb394bfd983a439d8ccb9; fi ;;
           *) echo "$2" ;;
         esac; exit 0 ;;
  branch) [[ " $* " == *" -r --contains "* ]] && echo "  origin/main"; exit 0 ;;
  apply) in=""; [[ " $* " == *" --check "* || " $* " == *" - "* ]] && in=$(cat)
         [[ " $* " == *" --reverse "* ]] && exit "$(rcfor git-reverse 0)"
         r=$(rcfor git-apply 0); ((r == 0)) || { echo "error: patch failed: dwl.c:1" >&2; exit "$r"; }
         if [[ -d $dir/syncplay ]]; then   # (Syncplay's clone: the file the patch changes names it)
           f=$dir/syncplay/vendor/python_mpv_jsonipc/python_mpv_jsonipc.py
           [[ " $* " == *" --check "* ]] || { mkdir -p "${f%/*}"; printf '# applied: %s\n' "${in%%$'\n'*}" >>"$f"; }
           exit 0
         fi
         exit 0 ;;
esac
exit 0
