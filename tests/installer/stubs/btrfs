#!/bin/bash
. /usr/local/bin/_lib.sh
fkh_log "$*"
case " $* " in
  *" filesystem usage "*) printf 'Overall:\n    Device unallocated:\t\t  %s\n    Free (estimated):\t\t  %s\t(min: 1)\n' \
       "$(cat "$FKH/btrfs-unalloc" 2>/dev/null || echo 999999999999)" "$(cat "$FKH/btrfs-free" 2>/dev/null || echo 999999999999)";;   # ($FKH/btrfs-free, -unalloc: bytes)
  *" subvolume snapshot "*) mkdir -p "${*: -1}"; add subvolumes "${*: -1}";;   # (the update's candidate: an empty folder will do)
  *" subvolume delete "*) rm -rf -- "${*: -1}"; del subvolumes "${*: -1}";;
  *" subvolume show "*) has subvolumes "${*: -1}" || exit 1;;
  *" subvolume create "*) mkdir -p "${*: -1}"; add subvolumes "${*: -1}";;
  *" scrub status "*) [[ -f $FKH/scrub-status ]] || exit 1; cat "$FKH/scrub-status";;
esac; exit 0
