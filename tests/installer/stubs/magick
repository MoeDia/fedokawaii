#!/bin/bash
# ImageMagick of the fake Fedora: the output file is made (the same bytes for the same picture,
# so a second theme run finds it in sync); $FKH/real-magick: the real one, when there is one
if [[ -f /var/lib/fkh/real-magick ]]; then for m in /usr/bin/magick /usr/bin/convert; do [[ -x $m ]] && exec "$m" "$@"; done; fi
for x; do o=$x; done
[[ $o == info: ]] && { echo "sig-$(printf '%s' "${*:1:1}" | sha1sum | cut -c1-8)"; exit 0; }
[[ $o == sixel:- ]] && { printf '\eP'; exit 0; }
o=${o#PNG24:}; o=${o#PNG32:}
printf 'picture:' >"$o"; for x in "${@:1:$#-1}"; do printf ' %s' "${x##*/}"; done >>"$o"; echo >>"$o"
