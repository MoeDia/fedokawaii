#!/bin/bash
# nvim --headless '+Lazy! restore': the plugins of the lock appear, each at its commit (unless
# $FKH/rc-nvim says otherwise)
. /usr/local/bin/_lib.sh
fkh_log "$*"
r=$(rcfor nvim 0); ((r == 0)) || exit "$r"
# ($FKH/fail-nvim-plugins = N: the first N runs end well, but GitHub let the clones fail)
if [[ " $* " == *"Lazy! restore"* ]] && ! countdown nvim-plugins; then
  while IFS=' ' read -r name commit; do
    d=$HOME/.local/share/nvim/lazy/$name
    mkdir -p "$d/.git"; echo "ref: refs/heads/main" >"$d/.git/HEAD"; echo "$commit" >"$d/.git/fk-commit"   # (the stub git's HEAD)
  done < <(sed -n 's/^ *"\([^"]*\)": *{.*"commit": *"\([0-9a-f]*\)".*/\1 \2/p' "$HOME/.config/nvim/lazy-lock.json" 2>/dev/null)
fi
[[ " $* " == *colors_name* ]] && printf kawa
# (+MasonInstall NAME…: each tool's command in Mason's bin, as Mason links them)
if [[ " $* " == *MasonInstall* ]]; then
  m=$HOME/.local/share/nvim/mason/bin; mkdir -p "$m"
  for t in $(sed -n 's/.*+MasonInstall \([^+]*\).*/\1/p' <<<"$*"); do printf '#!/bin/sh\nexit 0\n' >"$m/$t"; chmod 755 "$m/$t"; done
fi
exit 0
