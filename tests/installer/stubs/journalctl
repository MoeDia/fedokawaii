#!/bin/bash
# journalctl of the fake Fedora: the kernel log is $FKH/kmsg (written in 4 KB blocks, as
# journalctl's stdio does); -f follows nothing until killed
# journals a test wrote (fkh): journal-kawa-greet (-t kawa-greet), journal-err (-p err, this
# boot), journal-unix and journal-unix.prev (-o short-unix, this boot and the one before),
# journal-pid1 (_PID=1 -g PATTERN: its lines that match — systemd's own words, as a crash leaves them)
if [[ " $* " == *" _PID=1 -g "* ]]; then
  a="$*"; p=${a##* -g }   # (on the joined line: ${*##…} would strip each word on its own)
  [[ -f /var/lib/fkh/journal-pid1 ]] && grep -E -- "$p" /var/lib/fkh/journal-pid1; exit 0
fi
f=""
case " $* " in
  *" -t kawa-greet "*) f=journal-kawa-greet ;;
  *" -b -1 "*" -o short-unix "*) f=journal-unix.prev ;;
  *" -o short-unix "*) f=journal-unix ;;
  *" -b -1 "*|*" -k "*) ;;
  *" -p err "*) f=journal-err ;;
esac
[[ -n $f && -f /var/lib/fkh/$f ]] && exec cat "/var/lib/fkh/$f"
case " $* " in
  *" -f "*) exec /bin/sleep 1000 ;;
  *" -k "*) [[ -f /var/lib/fkh/kmsg ]] && exec dd if=/var/lib/fkh/kmsg bs=4096 status=none; exit 0 ;;
esac
echo "JOURNAL-COPY $*"; exit 0
