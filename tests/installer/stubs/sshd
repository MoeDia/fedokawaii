#!/bin/bash
# sshd of the fake Fedora: -t checks the configuration ($FKH/rc-sshd-t: its status); -T prints
# what is in force — keys only once fedokawaii's drop-in is there, Fedora's defaults without it
. /usr/local/bin/_lib.sh
fkh_log "$*"
case " $* " in
  *" -t "*) r=$(rcfor sshd-t 0); ((r == 0)) || echo "sshd: bad configuration option" >&2; exit "$r" ;;
  # ($FKH/sshd-camel: OpenSSH 10.5's way — Fedora 45 — the keywords as written)
  *" -T "*) if [[ -f /etc/ssh/sshd_config.d/40-fedokawaii.conf ]]; then
              o=$(printf '%s\n' "passwordauthentication no" "kbdinteractiveauthentication no" "permitrootlogin no")
            else o=$(printf '%s\n' "passwordauthentication yes" "kbdinteractiveauthentication no" "permitrootlogin prohibit-password"); fi
            if [[ -f $FKH/sshd-camel ]]; then sed 's/^passwordauthentication/PasswordAuthentication/; s/^kbdinteractiveauthentication/KbdInteractiveAuthentication/; s/^permitrootlogin/PermitRootLogin/' <<<"$o"
            else printf '%s\n' "$o"; fi ;;
esac
exit 0
