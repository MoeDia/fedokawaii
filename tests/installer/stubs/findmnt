#!/bin/bash
# findmnt of the fake Fedora: Btrfs with Fedora's subvolumes, /boot on ext4 ($FKH/fstype-PATH overrides)
p=${*: -1}; p=${p//\//_}
# --verify --tab-file F: as util-linux's, F must be a file it can open by name (a pipe it cannot)
if [[ " $* " == *" --verify "* ]]; then
  f=""; a=("$@"); for ((i = 0; i < ${#a[@]}; i++)); do [[ ${a[i]} == --tab-file ]] && f=${a[i+1]}; done
  [[ -z $f || -f $f ]] || { echo "findmnt: can't read $f: No such file or directory" >&2; exit 1; }
  exit 0
fi
case " $* " in
  # (SOURCE: / the root subvolume; the flat layout's four mounted from theirs — unless $FKH/nested)
  *" SOURCE "*) case $p in
                  _) echo "/dev/vda3[/root]" ;;
                  _home|_var_log|_var_lib_fedokawaii_update|_.snapshots)
                    [[ -f /var/lib/fkh/nested ]] || { n=${p#_}; case $n in var_log) n=log ;; var_lib_fedokawaii_update) n=fk ;; .snapshots) n=snapshots ;; esac; echo "/dev/vda3[/$n]"; } ;;
                esac ;;
  # (FSROOT: the subvolume a path is mounted from — / the root subvolume; $FKH/fsroot-PATH overrides)
  *" FSROOT "*) cat "/var/lib/fkh/fsroot-$p" 2>/dev/null || { [[ $p == _ ]] && echo /root; } ;;
  *" OPTIONS "*) cat "/var/lib/fkh/mountopts-$p" 2>/dev/null || cat /var/lib/fkh/mountopts 2>/dev/null \
                  || { [[ $p == _ ]] && echo "rw,relatime,seclabel,compress=zstd:1,ssd,space_cache=v2,subvolid=257,subvol=/root"; } ;;
  *) cat "/var/lib/fkh/fstype-$p" 2>/dev/null || { [[ $p == _boot ]] && echo ext4 || echo btrfs; } ;;
esac
