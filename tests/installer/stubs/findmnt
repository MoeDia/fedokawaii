#!/bin/bash
# findmnt of the fake Fedora: Btrfs with Fedora's subvolumes, /boot on ext4 ($FKH/fstype-PATH overrides)
p=${*: -1}; p=${p//\//_}
case " $* " in
  *" OPTIONS "*) cat /var/lib/fkh/mountopts 2>/dev/null || echo "rw,relatime,seclabel,compress=zstd:1,ssd,space_cache=v2,subvolid=257,subvol=/root" ;;
  *) cat "/var/lib/fkh/fstype-$p" 2>/dev/null || { [[ $p == _boot ]] && echo ext4 || echo btrfs; } ;;
esac
