#!/bin/bash
# mount of the fake Fedora: the file system's top level (subvolid=5: fedokawaii-split, kawa-snap)
# is an empty folder here — nothing mounted; a remount (setup's noatime pass) only recorded:
# the mounts it would switch are this machine's; every other mount is the real one
. /usr/local/bin/_lib.sh
case " $* " in
  *subvolid=5*|*remount*) fkh_log "$*"; exit 0 ;;
esac
exec /usr/bin/mount "$@"
