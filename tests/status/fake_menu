#!/usr/bin/env bash
# fake kawa-menu: keeps what each opening showed — $MENU/rows.N, $MENU/args.N (one argument a
# line) — runs $MENU/hook.N if there is one (something happening while the menu is open), then
# answers with the next line of $MENU/answers: a row number, "~TEXT" (the first row holding
# TEXT), or "esc" / nothing left (dismissed: status 1, as Esc).
d=$MENU n=$(($(cat "$MENU/n" 2>/dev/null || echo 0) + 1))
echo "$n" >"$d/n"
cat >"$d/rows.$n"; printf '%s\n' "$@" >"$d/args.$n"
[[ -f $d/hook.$n ]] && bash "$d/hook.$n"
a=$(sed -n 1p "$d/answers" 2>/dev/null); sed -i 1d "$d/answers" 2>/dev/null
[[ -n $a && $a != esc ]] || exit 1
if [[ $a == "~"* ]]; then
  a=$(grep -n -F -- "${a#"~"}" "$d/rows.$n" | head -n 1 | cut -d: -f1)
  [[ -n $a ]] || exit 1
  a=$((a - 1))
fi
for x; do [[ $x == --index ]] && { echo "$a"; exit 0; }; done
sed -n "$((a + 1))p" "$d/rows.$n"
